    def self_check(grid, *, difficulty=None, meta=None) -> list[str]:
        """Generator-specific invariants for bbox-intersection sizing.
    
        The canonical rule takes the intersection of the red(2) bbox and green(3)
        bbox and emits a solid color-8 rectangle of that size.  Training examples
        should therefore contain at least one red and one green cell and the two
        bboxes must overlap on both axes; otherwise the example teaches an
        undefined/no-op branch instead of the core rule.
        """
        if not grid or not grid[0]:
            return ["empty grid"]
        h, w = len(grid), len(grid[0])
        if any(len(row) != w for row in grid):
            return ["ragged grid"]
