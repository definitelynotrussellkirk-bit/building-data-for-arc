 g bg))\n     (define (colors-of o)\n       (unique (map (lambda (p) (at g (first p) (second p)))\n                    (obj-cells o))))\n     (define blank (find (lambda (o) (= 1 (length (colors-of o)))) objs))\n     (define blank-color (first (colors-of blank)))\n     (define eh (obj-h blank))\n     (define ew (obj-w blank))\n     (define source\n       (pick-max (filter (lambda (o) (> (length (colors-of o)) 1)) objs)\n                 obj-w))\n     (define rect-color  ;; the source's majority (frame) color\n       (pick-max (colors-of source)\n                 (lambda (c) (count-if (lambda (p)\n                                         (= (at g (first p) (second p))\n                                            c))\n                                       (obj-cells source)))))\n     (define marker-color\n       (find-first (lambda (c) (not (= c rect-color)))\n                   (colors-of source)))\n     (define markers  ;; marker positions relative to the source bbox\n       (map (lambda (p) (list (- (first p) (obj-r1 source))\n                              (- (second p) (obj-c1 source))))\n            (filter (lambda (p) (= (at g (first p) (second p))\n                                   marker-color))\n                    (obj-cells source))))\n     (define (anchors mr mc)  ;; landing spots in the empty rectangle\n       (let* ((bot (- (obj-h source) 1 mr))\n              (right (- (obj-w source) 1 mc))\n              (rrs (cond ((< mr bot) (list mr))\n                         ((> mr bot) (list (- eh 1 bot)))\n                         (else (list (- eh 1 bot)))))\n              (ccs (cond ((< mc right) (list mc))\n                         ((> mc right) (list (- ew 1 right)))\n                         (else (list mc)))))\n         (filter (lambda (rc) (in-bounds? (first rc) (second rc) eh ew))\n                 (for*/list ((r rrs) (c ccs)) (list r c)))))\n     (paint-cells (empty-grid eh ew blank-color)\n                  (flatmap (lambda (m) (anchors (first m) (second m)))\n                           markers)\n                  marker-color))))","program_sha256":"3a5f964dc7188c83aec006efed668784b7a54e85ed7078b62709a51a85a6e9ba","public_sha256":"7cba417be5d1a14694a14e52a41d44165258ca8df674c73f627c42bd07e909b9","rejections":[],"rivals":{"rows-both_columns-both":{"demo_matches":[false,false,true,false,true],"first_refuting_demo":0,"first_refuting_output":[[6,6,6,6,6,6,6],[6,4,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,4,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,4,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,4,6,6,6,6,6],[6,6,6,6,6,6,6]],"output_sha256":["ab1854124825956189b225e2744b1236ae36bb04b9572e30903df787fd9aa2bf","dc1c731ef6dc9471245b492ea71ca078d202c5e0df5f6eb38476d8b698cbc909","676c2c0f70761f82dfbb022031925ba934e2bea8fdb9bcc6cf14147cd83e0981","414a886262b42c45c7cc18298265a3810c8a945a5c9107b0f2a617745445ac91","8445db398e5b1b9bdf3328020a1d41d840ddcceca924bbf9bc6830cc062cfe6d","c9dfb9b67e0b8dab0a54623ceb9ceae68c1edbdcae3f0e1e786bc62947d0b051"],"parameters":{"column_ties":"both","row_ties":"both"},"program_sha256":"a85716c73ec0707204db97aa851d949370e884e0e78763e446fb0bfb568684ef","query_matches":[false],"status":"eliminated"},"rows-both_columns-high":{"demo_matches":[false,false,true,false,true],"first_refuting_demo":0,"first_refuting_output":[[6,6,6,6,6,6,6],[6,4,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,4,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,6,6,6,6,4,6],[6,6,6,6,6,6,6],[6,6,6,6,6,6,6],[6,4,6,6,6,6,6],[6,6,6,6,6,6,6]],"output_sha256":["ab1854124825956189b225e2744b1236ae36bb04b9572e30903df787fd9aa2bf","c9964622f9673d684c58139f825342ff5bbf792921f9152658bd26f7418267bf","676c2c0f70761f82dfbb022031925ba934e2bea8fdb9bcc6cf14147cd83e0981","cdeb363e0c45412794a59b6d39283fa1b31ecd85f523970683c380c4922a48d0","8445db398e5b1b9bdf3328020a1d41d840ddcceca924bbf9bc6830cc062cfe6d","26546fa4c6451952962117d320cbe24167dc8d392d8