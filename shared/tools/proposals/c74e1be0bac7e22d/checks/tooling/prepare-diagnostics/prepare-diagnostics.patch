+def _public_preparation_diagnostics(value: dict) -> dict:
+    """Allow process status and fixed infrastructure observations, never logs."""
+    types = {"worker_exit_code": int, "worker_timed_out": bool,
+             "worker_interrupted": bool, "environment_probe": str,
+             "python_executable": str, "python_version": str,
+             "numpy_discoverable": bool, "pillow_discoverable": bool,
+             "racket_discoverable": bool}
+    return {key: value[key] for key, expected in types.items()
+            if key in value and type(value[key]) is expected}
+
+
+def _preparation_diagnostics(exc: Exception) -> dict:
+    """Inspect the isolated worker environment without loading task code.
+
+    Discoverability is a post-failure observation, not a diagnosis or import test.
+    Do not classify or echo worker error text: it may contain private rule/labels.
+    """
+    diagnostic = {"environment_probe": "failed"}
+    if isinstance(exc, GenerationFailure):
+        diagnostic.update(_public_preparation_diagnostics({
+            key: exc.run.get(key.removeprefix("worker_"), False)
+            for key in ("worker_exit_code", "worker_timed_out", "worker_interrupted")}))
+    probe = """import importlib.util, json, os, shutil, sys
+print(json.dumps({
+    "python_executable": sys.executable,
+    "python_version": ".".join(map(str, sys.version_info[:3])),
+    "numpy_discoverable": importlib.util.find_spec("numpy") is not None,
+    "pillow_discoverable": importlib.util.find_spec("PIL") is not None,
+    "racket_discoverable": shutil.which(os.environ.get("RACKET_PATH", "racket")) is not None,
+}))
+"""
+    try:
+        with tempfile.TemporaryDirectory(prefix="arc-solve-environment-") as directory:
+            run = run_process([sys.executable, "-E", "-s", "-c", probe], Path(directory), timeout=10)
+        if not run["timed_out"] and run["exit_code"] == 0:
+            observed = json.loads(run["stdout"])
+            if isinstance(observed, dict):
+                diagnostic.update(_public_preparation_diagnostics(observed))
+                diagnostic["environment_probe"] = "completed"
+    except Exception:
+        pass  # A failed diagnostic must not replace the original blocked result.
+    return diagnostic
 
 
