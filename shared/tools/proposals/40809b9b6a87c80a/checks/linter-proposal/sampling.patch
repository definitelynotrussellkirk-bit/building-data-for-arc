+def _sample_requests(samples_per_band):
+    """Probe consecutive indices at one seed, without coupling the two controls.
+
+    The former (seed, index) == (n, n) schedule can visit only one phase of
+    a valid generator, for example (seed + index) % 2. This bounded probe
+    covers sample-index residues at seed 1; it does not exhaust other seeds.
+    """
+    return [(1, index) for index in range(samples_per_band)]
+
+
+def _sampling_record(module, requests, samples_per_band, bands):
+    period = getattr(module, "LESSON_SCHEDULE_PERIOD", None)
+    period = period if type(period) is int and period > 0 else None
+    coverage = {}
+    if period is not None:
+        for band in bands:
+            residues = sorted({request["sample_index"] % period
+                               for request in requests
+                               if request["difficulty"] == band
+                               and request["status"] == "generated"})
+            coverage[str(band)] = {"residues": residues,
+                                   "complete_at_fixed_seed": len(residues) == period}
+    return {"policy": "fixed_seed_consecutive_indices", "fixed_seed": 1,
+            "samples_per_band": samples_per_band, "requests": requests,
+            "declared_schedule_period": period,
+            "generated_index_coverage": coverage,
+            "scope": "Finite sampling at one fixed seed; index coverage is not semantic certification."}
+
+
