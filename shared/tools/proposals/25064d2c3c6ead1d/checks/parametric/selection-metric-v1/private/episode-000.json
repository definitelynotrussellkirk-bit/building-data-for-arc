  "racket_source": "(rule!\n  ;; alt: filter `(objects g 0)` by LR symmetry, sort by `obj-size`, then crop the winner's bbox.\n  (lambda (g)\n    (define objs (objects g 0))\n    (define (bbox-lr-symmetric? bb)\n      (let* ((r0 (first bb))\n             (c0 (second bb))\n             (r1 (third bb))\n             (c1 (fourth bb))\n             (w (+ 1 (- c1 c0))))\n        (and (> w 1)\n             (for*/and ((r (in-range r0 (+ r1 1)))\n                        (c (in-range c0 (+ c1 1))))\n               (= (at g r c)\n                  (at g r (- (+ c0 c1) c)))))))\n    (define symmetric-objs\n      (filter (lambda (o) (bbox-lr-symmetric? (obj-bbox o))) objs))\n    (define chosen\n      (if (empty? symmetric-objs)\n          (first objs)\n          (first (sort symmetric-objs\n                       (lambda (a b)\n                         (> (* (+ 1 (- (third (obj-bbox a)) (first (obj-bbox a))))\n                               (+ 1 (- (fourth (obj-bbox a)) (second (obj-bbox a)))))\n                            (* (+ 1 (- (third (obj-bbox b)) (first (obj-bbox b))))\n                               (+ 1 (- (fourth (obj-bbox b)) (second (obj-bbox b)))))))))))\n    (let* ((bb (obj-bbox chosen))\n           (r0 (first bb))\n           (c0 (second bb))\n           (r1 (third bb))\n           (c1 (fourth bb)))\n      (subgrid g r0 c0 r1 c1))))",
