      "text": "(rule! (lambda (g)\n         (let* ((four (first (find-color g 4)))\n                (fr (first four))\n                (fc (second four))\n                (src-r1 (* (quotient fr 4) 4))\n                (src-c1 (* (quotient fc 4) 4))\n                (dst-r1 (* (- fr src-r1) 4))\n                (dst-c1 (* (- fc src-c1) 4))\n                (src-cells (filter (lambda (rc)\n                                     (let ((v (at g (first rc) (second rc))))\n                                       (and (!= v 0) (!= v 5))))\n                                   (positions-in-rect src-r1\n                                                      src-c1\n                                                      (+ src-r1 2)\n                                                      (+ src-c1 2))))\n                (out-g (cellmap g (r c v) (if (= v 5) 5 0))))\n           (reduce (lambda (gg p)\n                     (let* ((r (first p))\n                            (c (second p))\n                            (nr (+ dst-r1 (- r src-r1)))\n                            (nc (+ dst-c1 (- c src-c1))))\n                       (set-cell gg nr nc (at g r c))))\n                   out-g\n                   src-cells))))"
    },
