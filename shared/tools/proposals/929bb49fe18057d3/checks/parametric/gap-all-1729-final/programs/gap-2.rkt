(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((groups (objects-multicolor g 0)))
             (for/fold ((out g))
               ((grp groups))
               (let* ((cells (obj-cells grp))
                      (cell-colors (map (lambda (cell)
                                          (list (first cell)
                                                (second cell)
                                                (at g (first cell) (second cell))))
                                        cells))
                      (colors (remove-duplicates (map third cell-colors)))
                      (color-counts (map (lambda (col)
                                           (list col
                                                 (count-if (lambda (cc)
                                                             (= (third cc) col))
                                                           cell-colors)))
                                         colors))
                      (sorted (sort color-counts
                                    (lambda (a b) (> (second a) (second b)))))
                      (main-color (first (first sorted)))
                      (main-cells (filter (lambda (cc) (= (third cc) main-color))
                                          cell-colors))
                      (mrs (map first main-cells))
                      (mcs (map second main-cells))
                      (mr1 (min-list mrs))
                      (mr2 (max-list mrs))
                      (mc1 (min-list mcs))
                      (mc2 (max-list mcs))
                      (seeds (filter (lambda (cc) (!= (third cc) main-color))
                                     cell-colors)))
                 (for/fold ((gg out))
                   ((seed seeds))
                   (let* ((sr (first seed))
                          (sc (second seed))
                          (scolor (third seed))
                          (dir-r (cond
                                   ((< sr mr1) 'above)
                                   ((> sr mr2) 'below)
                                   (else 'mid)))
                          (dir-c (cond
                                   ((< sc mc1) 'left)
                                   ((> sc mc2) 'right)
                                   (else 'mid))))
                     (for/fold ((ggg gg))
                       ((mc main-cells))
                       (let* ((mr (first mc))
                              (mcl (second mc))
                              (nr (cond
                                    ((eq? dir-r 'above) (- (- (- (* 2 mr1) 1) mr) 2))
                                    ((eq? dir-r 'below) (+ (- (+ (* 2 mr2) 1) mr) 2))
                                    (else mr)))
                              (nc (cond
                                    ((eq? dir-c 'left) (- (- (- (* 2 mc1) 1) mcl) 2))
                                    ((eq? dir-c 'right) (+ (- (+ (* 2 mc2) 1) mcl) 2))
                                    (else mcl))))
                         (cond
                           ((or (< nr 0) (>= nr h) (< nc 0) (>= nc w)) ggg)
                           (else (set-cell ggg nr nc scolor)))))))))))))