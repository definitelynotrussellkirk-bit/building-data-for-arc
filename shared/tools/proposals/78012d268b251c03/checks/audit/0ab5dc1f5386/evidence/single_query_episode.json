  "program": "(rule!\n  (let ((dummy 0))\n    (define (nonzero-components grid)\n      (let loop ([remaining (filter-cells grid (lambda (r c v) (not (= v 0))))] [acc (list)])\n        (if (empty? remaining)\n            (reverse acc)\n            (let* ((start (first remaining))\n                   (cells (connected-region grid (first start) (second start)\n                            (lambda (r c v) (not (= v 0))) 4)))\n              (loop (filter (lambda (p) (not (member? p cells))) remaining)\n                    (cons cells acc))))))\n    (define (rect-frame? obj)\n      (= (obj-size obj) (- (* 2 (+ (obj-h obj) (obj-w obj))) 4)))\n    (define (crop-cells cells)\n      (let ((bb (bbox-of-cells cells)))\n        (subgrid g (first bb) (second bb) (third bb) (fourth bb))))\n    (let* ((frames (sort (map obj-bbox (filter (lambda (obj)\n                                                 (and (= (obj-color obj) 8) (rect-frame? obj)))\n                                               (objects g 0)))\n                         (lambda (a b)\n                           (if (= (first a) (first b))\n                               (< (second a) (second b))\n                               (< (first a) (first b))))))\n           (shapes (filter (lambda (cells)\n                             (not (= (at g (first (first cells)) (second (first cells))) 8)))\n                           (nonzero-components g)))\n           (shape-info (map (lambda (cells)\n                              (let ((block (crop-cells cells)))\n                                (list (rows block) (cols block) block)))\n                            shapes)))\n      (let loop-frames ([out g] [remaining frames] [used (list)])\n        (if (empty? remaining)\n            out\n            (let* ((fr (first remaining))\n                   (ih (- (third fr) (first fr) 1))\n                   (iw (- (fourth fr) (second fr) 1))\n                   (match (find-first\n                            (lambda (item)\n                              (and (= (first item) ih) (= (second item) iw)\n                                   (not (member? item used))))\n                            shape-info)))\n              (if (eq? match #f)\n                  (loop-frames out (rest remaining) used)\n                  (let ((block (third match)))\n                    (loop-frames\n                      (for*/fold ([acc out])\n                                 ([r (in-range (rows block))]\n                                  [c (in-range (cols block))]\n                                  #:when (not (= (at block r c) 0)))\n                        (set-cell acc (+ (first fr) 1 r) (+ (second fr) 1 c) (at block r c)))\n                      (rest remaining)\n                      (cons match used))))))))))",
