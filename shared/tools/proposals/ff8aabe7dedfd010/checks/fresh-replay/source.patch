+def _mirror_side_column(col: int, half: int) -> int:
+    """Reflect a column within its own half, preserving its side of the bar."""
+    if col < half:
+        return half - 1 - col
+    if col > half:
+        local = col - (half + 1)
+        return half + 1 + (half - 1 - local)
+    return col
+
