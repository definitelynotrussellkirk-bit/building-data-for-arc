+    assert random.getstate() == state
+    second = GEN.generate(17, 3, difficulty="hard")
+    assert first == second
+    assert first is not second
+    assert all(a is not b for a, b in zip(first, second))
+    first[0][0] = (first[0][0] + 1) % 10
