(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((nines (find-color g 9))
                  (sixes (find-color g 6)))
             (if (or (null? nines) (null? sixes))
                 g
                 (let* ((p9 (first nines))
                        (p6 (first sixes))
                        (r9 (first p9))
                        (c9 (second p9))
                        (r6 (first p6))
                        (c6 (second p6))
                        (dr (- r6 r9))
                        (dc (- c6 c9))
                        (sr (if (<= (abs dr) 2) 0 (if (> dr 0) 1 -1)))
                        (sc (if (<= (abs dc) 2) 0 (if (> dc 0) 1 -1)))
                        (nr (+ r9 sr))
                        (nc (+ c9 sc)))
                   (paint-cells g (list (list r9 c9 5) (list nr nc 9) (list r6 c6 9)))))))))