(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((cyan (first (find-color g 8)))
                  (cr (first cyan))
                  (cc (second cyan))
                  (non-bg (flatmap (lambda (r)
                                     (flatmap (lambda (c)
                                                (let ((v (at g r c)))
                                                  (if (and (!= v 0) (!= v 8))
                                                      (list (list r c v))
                                                      (list))))
                                              (range 0 w)))
                                   (range 0 h)))
                  (rs (map first non-bg))
                  (cs (map second non-bg))
                  (r1 (min-list rs))
                  (r2 (max-list rs))
                  (c1 (min-list cs))
                  (c2 (max-list cs))
                  (frame-col (at g r1 c1))
                  (inner-col (let loop
                                  ((cells non-bg))
                                  (if (null? cells)
                                      frame-col
                                      (if (!= (third (first cells)) frame-col)
                                          (third (first cells))
                                          (loop (rest cells))))))
                  (new-r1 (if (< cr r1) cr r1))
                  (new-r2 (if (> cr r2) cr r2))
                  (new-c1 (if (< cc c1) cc c1))
                  (new-c2 (if (> cc c2) cc c2)))
             (cellmap g
                      (r c v)
                      (cond
                        ((and (>= r new-r1) (<= r new-r2) (>= c new-c1) (<= c new-c2)) (if (or (= r new-r1) (= r new-r2) (= c new-c1) (= c new-c2))
                              frame-col
                              inner-col))
                        (else 0)))))))
