(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((cyan (first (find-color g 8)))
                  (cr (first cyan))
                  (cc (second cyan))
                  (non-bg (flatmap (lambda (r)
                                     (flatmap (lambda (c)
                                                (let ((v (at g r c)))
                                                  (if (and (!= v 0) (!= v 8))
                                                      (list (list r c v))
                                                      (list))))
                                              (range 0 w)))
                                   (range 0 h)))
                  (rs (map first non-bg))
                  (cs (map second non-bg))
                  (r1 (min-list rs))
                  (r2 (max-list rs))
                  (c1 (min-list cs))
                  (c2 (max-list cs))
                  (frame-col (at g r1 c1)))
             (cellmap g
                      (r c v)
                      (cond
                        ((and (>= r r1) (<= r r2) (>= c c1) (<= c c2)) v)
                        ((and (= r cr)
                              (or (and (< cc c1) (>= c cc) (< c c1))
                                  (and (> cc c2) (> c c2) (<= c cc))))
                         frame-col)
                        ((and (= c cc)
                              (or (and (< cr r1) (>= r cr) (< r r1))
                                  (and (> cr r2) (> r r2) (<= r cr))))
                         frame-col)
                        (else 0)))))))
