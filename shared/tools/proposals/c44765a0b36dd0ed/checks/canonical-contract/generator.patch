+def _witness_local_seed_color_roles(grid):
+    if self_check(grid):
+        return False
+    counts = {}
+    for row in grid:
+        for color in row:
+            counts[color] = counts.get(color, 0) + 1
+    return any(
+        counts[grid[r][c]] > 1
+        for cells in _groups8(grid)
+        for r, c in _group_parts(grid, cells)[2]
+    )
