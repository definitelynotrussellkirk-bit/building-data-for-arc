+def _rival_translate_copies(grid):
+    """Plausible rival: copy into the indicated bbox without reflecting it."""
+    h, w = len(grid), len(grid[0])
+    result = [row[:] for row in grid]
+    for cells in _groups8(grid):
+        _, mcells, seeds = _group_parts(grid, cells)
+        mr1 = min(r for r, _ in mcells); mr2 = max(r for r, _ in mcells)
+        mc1 = min(c for _, c in mcells); mc2 = max(c for _, c in mcells)
+        bh, bw = mr2 - mr1 + 1, mc2 - mc1 + 1
+        for sr, sc in seeds:
+            dr = -bh if sr < mr1 else bh if sr > mr2 else 0
+            dc = -bw if sc < mc1 else bw if sc > mc2 else 0
+            for r, c in mcells:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    result[nr][nc] = grid[sr][sc]
+    return result
+
+
+def _rival_globally_unique_seeds(grid):
+    """Plausible rival: only globally singleton colors can act as seeds.
+
+    The true rule decides color roles separately in each 8-connected group;
+    this rival misses a seed if its color also appears in another group.
+    """
+    h, w = len(grid), len(grid[0])
+    result = [row[:] for row in grid]
+    counts = {}
+    for row in grid:
+        for color in row:
+            counts[color] = counts.get(color, 0) + 1
+    for cells in _groups8(grid):
+        _, mcells, seeds = _group_parts(grid, cells)
+        bbox = (min(r for r, _ in mcells), max(r for r, _ in mcells),
+                min(c for _, c in mcells), max(c for _, c in mcells))
+        for sr, sc in seeds:
+            color = grid[sr][sc]
+            if counts[color] != 1:
+                continue
+            for nr, nc in _targets_for_seeds(mcells, [(sr, sc)], bbox):
+                if 0 <= nr < h and 0 <= nc < w:
+                    result[nr][nc] = color
+    return result
+
+
+def _witness_reflection_not_translation(grid):
