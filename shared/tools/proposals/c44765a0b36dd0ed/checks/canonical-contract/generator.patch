+def _validate_call(seed, sample_index, difficulty, overrides):
+    """Validate public values before GenCtx's permissive legacy coercions."""
+    if type(seed) is not int:
+        raise TypeError("seed must be an integer (not bool)")
+    if type(sample_index) is not int:
+        raise TypeError("sample_index must be an integer (not bool)")
+    if sample_index < 0:
+        raise ValueError("sample_index must be nonnegative")
+    if difficulty is not None:
+        if type(difficulty) is not str:
+            raise TypeError("difficulty must be None, easy, medium, or hard")
+        if difficulty not in _ARCH_PRIOR:
+            raise ValueError("difficulty must be None, easy, medium, or hard")
+    unknown = sorted(set(overrides) - set(AXES))
+    if unknown:
+        raise TypeError(f"unknown override key(s): {', '.join(unknown)}")
+    for name, (lo, hi) in (
+        ("grid_h", _VALID_H), ("grid_w", _VALID_W),
+        ("n_groups", _VALID_G), ("seeds_per_group", _VALID_SEEDS),
+    ):
+        value = overrides.get(name)
