+def _compact_layout(rng, h, w, mains, n_seeds, *, solid):
+    """Bounded whole-layout fallback for every declared grid/count choice.
+
+    A 3x2 main shape and all three top-left reflections occupy a 6x4 block.
+    Assign each group its own four-column strip. Its input uses only the last
+    three columns, leaving a gap before the next group's input; all reflected
+    cells stay in the strip. Thus input components remain separate and no
+    inter-group paint targets overlap. At most three strips fit even at 12x12.
+    Row/column jitter and palette draws keep the result seed-deterministic.
+    """
+    g = full_grid(h, w, 0)
+    rel = ([(r, c) for r in range(3) for c in range(2)] if solid
+           else [(0, 0), (1, 0), (2, 0), (2, 1)])
+    left = rng.randint(0, w - 4 * len(mains))
+    for gi, main in enumerate(mains):
