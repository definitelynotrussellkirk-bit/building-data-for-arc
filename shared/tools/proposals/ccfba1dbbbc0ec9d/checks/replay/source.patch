+"""Behavioral regressions for the yellow-frame audit.
+
+Run through the packet wrapper or the portable task_tests stage. The helpers
+below inspect grid cells directly and never call the production frame parser.
+"""
+
+from itertools import combinations
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+
+TASK_ID = "926c6bd137d3"
+ROOT = find_root(__file__)
+GENERATOR, GENERATOR_PATH, GENERATOR_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+MARKER_COLORS = {1, 2, 3, 5, 6, 7, 8, 9}
+BANDS = ("easy", "medium", "hard")
+
+
+def yellow_components(grid):
+    """Return separate yellow objects using four-neighbor connectivity."""
+    remaining = {
+        (r, c)
+        for r, row in enumerate(grid)
+        for c, value in enumerate(row)
+        if value == 4
+    }
+    components = []
+    while remaining:
+        start = min(remaining)
+        remaining.remove(start)
+        component = {start}
+        stack = [start]
+        while stack:
+            r, c = stack.pop()
+            for neighbor in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if neighbor in remaining:
+                    remaining.remove(neighbor)
+                    component.add(neighbor)
+                    stack.append(neighbor)
+        components.append(component)
+    return components
+
+
+def inspect_frames(grid):
+    """Assert the task's ordinary input domain; return boxes and markers."""
+    assert grid and grid[0], "empty input"
+    assert len({len(row) for row in grid}) == 1, "ragged input"
+    assert all(type(value) is int and 0 <= value <= 9 for row in grid for value in row)
+    frames = []
+    for component in yellow_components(grid):
+        top = min(r for r, _ in component)
+        bottom = max(r for r, _ in component)
+        left = min(c for _, c in component)
+        right = max(c for _, c in component)
+        assert bottom - top >= 3 and right - left >= 3, "frame must be at least 4x4"
+        perimeter = {
+            (r, c)
+            for r in range(top, bottom + 1)
+            for c in range(left, right + 1)
+            if r in (top, bottom) or c in (left, right)
+        }
+        assert component == perimeter, "yellow component is not a complete rectangular outline"
+        markers = [
+            (r, c, grid[r][c])
+            for r in range(top + 1, bottom)
+            for c in range(left + 1, right)
+            if grid[r][c] not in (0, 4)
+        ]
+        assert len(markers) == 1, "each frame needs exactly one interior marker cell"
+        frames.append({"box": (top, left, bottom, right), "marker": markers[0]})
+    assert frames, "no frames"
+    for first, second in combinations(frames, 2):
+        a, b, c, d = first["box"]
+        e, f, g, h = second["box"]
+        assert c < e or g < a or d < f or h < b, "frame boxes overlap or nest"
+    return frames
+
+
+def exterior_cells(grid, frames):
+    return [
+        (r, c, value)
+        for r, row in enumerate(grid)
+        for c, value in enumerate(row)
+        if value not in (0, 4)
+        and not any(top <= r <= bottom and left <= c <= right
+                    for top, left, bottom, right in (frame["box"] for frame in frames))
+    ]
+
+
+def fill_interiors(grid):
+    """Independent control: preserve all cells except each frame's blank interior."""
+    output = [row[:] for row in grid]
+    for frame in inspect_frames(grid):
+        top, left, bottom, right = frame["box"]
+        color = frame["marker"][2]
+        for r in range(top + 1, bottom):
+            for c in range(left + 1, right):
+                if output[r][c] == 0:
+                    output[r][c] = color
+    return output
+
+
+def draw_frame(grid, box, marker, color):
+    """Build readable hand-made inputs without importing generator helpers."""
+    top, left, bottom, right = box
+    for r in range(top, bottom + 1):
+        for c in range(left, right + 1):
+            if r in (top, bottom) or c in (left, right):
+                grid[r][c] = 4
+    grid[marker[0]][marker[1]] = color
+
+
+def single_frame_scene():
+    grid = [[0] * 10 for _ in range(9)]
+    draw_frame(grid, (1, 2, 5, 7), (3, 4), 6)
+    grid[4][8] = 5  # A legal exterior object touching the yellow perimeter.
+    grid[5][8] = 5
+    grid[0][0] = 9
+    return grid
+
+
