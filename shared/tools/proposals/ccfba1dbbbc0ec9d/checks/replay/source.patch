+"""Synthetic CLI tests; these grids and labels are not historical/Racket evidence."""
+
+from copy import deepcopy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+from reviewer_support import find_root
+
+
+ROOT = find_root(__file__)
+# Public task_tests snapshots mirror the whole selected task home, including
+# workspace/, here; the generator's execution-layout parent is a different path.
+PROBE = ROOT / "generators/926c6bd137d3/workspace/probe_canonical_support.py"
+RIVAL = "SYNTHETIC:erase_exterior_like"
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def synthetic_census(status="survived_all"):
+    """Hand-authored erase-exterior-shaped evidence, explicitly synthetic."""
+    grid = [[0] * 6 for _ in range(6)]
+    for r in range(1, 5):
+        for c in range(1, 5):
+            if r in (1, 4) or c in (1, 4):
+                grid[r][c] = 4
+    grid[2][2] = 6
+    output = deepcopy(grid)
+    for r in (2, 3):
+        for c in (2, 3):
+            output[r][c] = 6
+    pair = {"input": grid, "output": output}
+    train, query = deepcopy(pair), deepcopy(pair)
+    if status == "refuted":
+        train["input"][0][0] = train["output"][0][0] = 5
+    if status in ("refuted", "ambiguous"):
+        query["input"][0][0] = query["output"][0][0] = 5
+    task = "synthetic_support_test"
+    source = hashlib.sha256(b"synthetic generator identity; no executable source claimed").hexdigest()
+    manifest = {"schema": "arcpuzzles-runtime-v1", "task_id": task, "files": [
+        {"library_path": f"generators/{task}/generator.py", "sha256": source},
+    ]}
+    instance = {"task_id": task, "rule_task_id": task, "rule_file": "synthetic-rule",
+                "train": [train], "test": [query]}
+    lesson = {"band": "synthetic", "index": 0, "seed": 0, "sample_index": 0,
+              "instance": instance, "instance_sha256": digest(instance),
+              "rivals": {RIVAL: status}, "errors": [], "rotations": []}
+    return {
+        "schema": "arcpuzzles-lesson-census-v1", "task_id": task,
+        "evidence_kind": "synthetic_self_test",
+        "limits": ["Synthetic grids, labels and source identities; no baseline or Racket execution."],
+        "generator_sha256": source, "rule_source_sha256": hashlib.sha256(b"synthetic rule").hexdigest(),
+        "rule_task_id": task, "rule_file": "synthetic-rule",
+        "runtime_manifest": manifest,
+        "runtime_manifest_sha256": hashlib.sha256((json.dumps(manifest, indent=2) + "\n").encode()).hexdigest(),
+        "status": "ambiguous" if status == "ambiguous" else "no_ambiguity_found",
+        "execution": {"exit_code": 1 if status == "ambiguous" else 0, "timed_out": False},
+        "rivals": [RIVAL], "canonical_pairs": 1,
+        "canonical_rival_fit": {RIVAL: {"pairs": 1, "fits": 0, "errors": [], "status": "refuted"}},
+        "lessons": [lesson], "errors": [], "unique_inputs": len({digest(train["input"]), digest(query["input"])}),
+        "summary": {"requested": 1, "materialized": 1, "pairs": 2,
+                    "materialization_errors": 0, "scoring_errors": 0, "rotation_scoring_errors": 0},
+        "sampler": {"authority": "synthetic hand-authored labels; no Racket execution"},
+    }
+
+
+def run_probe(tmp_path, report, *, compressed=False, corrupt=False):
+    raw = json.dumps(report).encode()
+    path = tmp_path / "census.json"
+    if compressed:
+        path = tmp_path / "census.json.gz"
+        packed = gzip.compress(raw, mtime=0)
+        path.write_bytes(packed + (b"corrupt" if corrupt else b""))
+        manifest = {"schema": "arcpuzzles-evidence-gzip-v1", "compression": "gzip", "files": [{
+            "path": "census.json", "compressed_path": path.name,
+            "raw_size": len(raw), "compressed_size": len(packed),
+            "raw_sha256": hashlib.sha256(raw).hexdigest(),
+            "compressed_sha256": hashlib.sha256(packed).hexdigest(),
+        }]}
+        (tmp_path / "census.compression.json").write_text(json.dumps(manifest))
+    else:
+        path.write_bytes(raw)
+    result = subprocess.run([sys.executable, str(PROBE), str(path)], text=True, capture_output=True)
+    assert result.stdout.strip(), result.stderr
+    return result.returncode, json.loads(result.stdout)
