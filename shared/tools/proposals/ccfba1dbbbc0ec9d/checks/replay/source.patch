+#!/usr/bin/env python3
+"""Audit declared rivals in a saved, source-bound lesson census; execute no rules.
+
+From the outer packet:
+  python3 review.py run python3 generators/926c6bd137d3/workspace/probe_canonical_support.py \
+    ../checks/lesson-census.json.gz --out ../checks/support-gate/lesson_support.json
+
+Accepts full JSON or native hash/size-verified gzip receipts. Exit 0 means an
+advisory analysis completed (including a measured gap); exit 2 means the evidence
+was unusable or insufficient. This prototype is not a universal approval gate.
+"""
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import re
+
+from arcpuzzles.receipt_input import read_receipt
+
+
+SCHEMA = "arcpuzzles-canonical-support-probe-v1"
+SCORED = {"refuted", "ambiguous", "survived_all"}
+# Completed outcomes documented by the saved lesson-census v1 evidence guard.
+COMPLETE_STATUSES = {"no_ambiguity_found", "no_declared_ambiguity", "no_contract",
+                     "warning", "hook_only", "ambiguous"}
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def grid_ok(value):
+    return (isinstance(value, list) and bool(value) and isinstance(value[0], list)
+            and bool(value[0]) and all(isinstance(row, list) and len(row) == len(value[0])
+            and all(type(cell) is int and 0 <= cell <= 9 for cell in row) for row in value))
+
+
+def audit(report):
+    """Interpret saved scorer outcomes, with conservative checks on report state."""
+    if not isinstance(report, dict) or report.get("schema") != "arcpuzzles-lesson-census-v1":
+        raise ValueError("Expected the full arcpuzzles-lesson-census-v1 report, not its summary.")
+    issues = []
+    if report.get("status") not in COMPLETE_STATUSES:
+        issues.append("Census status is missing, unsupported, unfinished, or errored")
+    names, lessons, summary = report.get("rivals", []), report.get("lessons", []), report.get("summary", {})
+    if (not isinstance(names, list) or not all(isinstance(n, str) for n in names)
+            or len(names) != len(set(names)) or not isinstance(lessons, list) or not isinstance(summary, dict)):
+        raise ValueError("Malformed declaration inventory, lesson list, or summary.")
+    for key in ("generator_sha256", "rule_source_sha256", "runtime_manifest_sha256"):
+        if not isinstance(report.get(key), str) or not re.fullmatch("[0-9a-f]{64}", report[key]):
+            issues.append(f"Missing or malformed {key}")
+    manifest = report.get("runtime_manifest", {})
+    if not isinstance(manifest, dict):
+        manifest = {}
+    manifest_hash = hashlib.sha256((json.dumps(manifest, indent=2) + "\n").encode()).hexdigest()
+    if manifest_hash != report.get("runtime_manifest_sha256"):
+        issues.append("Runtime manifest hash mismatch")
+    generator_rows = [r for r in manifest.get("files", []) if isinstance(r, dict)
+                      and r.get("library_path") == f"generators/{report.get('task_id')}/generator.py"]
+    if (manifest.get("task_id") != report.get("task_id") or len(generator_rows) != 1
+            or generator_rows[0].get("sha256") != report.get("generator_sha256")):
+        issues.append("Runtime manifest does not bind the stated task and generator")
+    execution = report.get("execution", {})
+    if (report.get("errors") or not isinstance(execution, dict) or execution.get("timed_out")
+            or type(execution.get("exit_code")) is not int
+            or execution.get("exit_code") != (1 if report.get("status") == "ambiguous" else 0)):
+        issues.append("Census execution is missing, errored, or incomplete")
+    for key in ("materialization_errors", "scoring_errors", "rotation_scoring_errors"):
+        if summary.get(key, 0) != 0:
+            issues.append(f"Reported {key}: {summary[key]}")
+    if any(summary.get(k) != len(lessons) for k in ("requested", "materialized")):
+        issues.append("Requested, materialized, and retained lesson counts do not agree")
+
+    pair_counts, inputs, rotations = [], {}, 0
+    for index, lesson in enumerate(lessons):
+        if not isinstance(lesson, dict):
+            raise ValueError(f"Malformed lesson row {index}")
+        instance, count = lesson.get("instance", {}), 0
+        if not isinstance(instance, dict):
+            instance = {}
+        if digest(instance) != lesson.get("instance_sha256"):
+            issues.append(f"Lesson {index}: instance hash mismatch")
+        if any(instance.get(k) != report.get(k) for k in ("task_id", "rule_task_id", "rule_file")):
+            issues.append(f"Lesson {index}: task/rule identity mismatch")
+        if lesson.get("errors"):
+            issues.append(f"Lesson {index}: scorer errors")
+        rotations += len(lesson.get("rotations", []))
+        for split in ("train", "test"):
+            pairs = instance.get(split, [])
+            if isinstance(pairs, dict) and split == "test":
+                pairs = [pairs]
+            if not isinstance(pairs, list) or not pairs:
+                issues.append(f"Lesson {index}: missing {split} pairs")
+                continue
+            for pair in pairs:
+                if not isinstance(pair, dict) or not all(grid_ok(pair.get(k)) for k in ("input", "output")):
+                    issues.append(f"Lesson {index}: malformed or unlabeled {split} pair")
+                    continue
+                count += 1
+                key, label = digest(pair["input"]), digest(pair["output"])
+                if key in inputs and inputs[key] != label:
+                    issues.append("Identical saved inputs have conflicting labels")
+                inputs[key] = label
+        pair_counts.append(count)
+    if summary.get("pairs") != sum(pair_counts):
+        issues.append("Reported pair count differs from retained labeled pairs")
+    if report.get("unique_inputs", len(inputs)) != len(inputs):
+        issues.append("Reported unique-input count differs from retained inputs")
+
+    canonical = report.get("canonical_rival_fit", {})
+    if not isinstance(canonical, dict):
+        canonical = {}
+        issues.append("Malformed canonical rival results")
+    rows = []
+    for name in names:
+        statuses = [lesson.get("rivals", {}).get(name) for lesson in lessons]
+        counts = Counter(s if isinstance(s, str) else "missing" for s in statuses)
+        fit = canonical.get(name)
+        problems = list(issues)
+        if any(s is not None and s not in SCORED for s in statuses):
+            problems.append("Generated rival scoring contains an error or unknown result")
+        if counts["missing"] and counts["missing"] != len(lessons):
+            problems.append("Generated rival results cover only part of the saved population")
+        if fit is not None and (not isinstance(fit, dict) or fit.get("errors")
+                or type(fit.get("pairs")) is not int or type(fit.get("fits")) is not int
+                or not 0 <= fit["fits"] <= fit["pairs"]
+                or fit["pairs"] != report.get("canonical_pairs")
+                or fit.get("status") != ("fits_all" if fit["fits"] == fit["pairs"] else "refuted")):
+            problems.append("Canonical rival results are malformed, incomplete, or errored")
+        if problems:
+            status = "insufficient_evidence"
+        elif fit is None or not fit["pairs"]:
+            status = "untested"
+        elif fit["fits"] == fit["pairs"]:
+            status = "canonical_not_refuted"
+        elif not lessons or counts["missing"] == len(lessons):
+            status = "untested"
+        elif counts["refuted"] or counts["ambiguous"]:
+            status = "distinction_observed"
+        else:
+            status = "coverage_gap"
+        witness = next(({k: lesson.get(k) for k in
+                         ("band", "index", "seed", "sample_index", "instance_sha256")}
+                        | {"status": outcome} for lesson, outcome in zip(lessons, statuses)
+                        if outcome in ("refuted", "ambiguous")), None)
+        rows.append({"name": name, "status": status, "canonical": fit,
+                     "generated": {"lesson_rows": len(lessons), "statuses": dict(counts),
+                                   "labeled_pair_occurrences": sum(pair_counts),
+                                   "pair_occurrences_in_fully_fitted_lessons": sum(
+                                       n for n, s in zip(pair_counts, statuses) if s == "survived_all"),
+                                   "exact_mismatching_pairs": None},
+                     "first_distinction": witness, "issues": problems})
+    row_counts = Counter(row["status"] for row in rows)
+    overall = next((s for s in ("insufficient_evidence", "coverage_gap", "untested") if row_counts[s]),
+                   "no_gap_observed" if rows else "untested")
+    if issues:
+        overall = "insufficient_evidence"
+    return {"schema": SCHEMA, "status": overall,
+            "saved_census_status": report.get("status"),
+            "evidence_kind": report.get("evidence_kind", "saved_census"), "task_id": report.get("task_id"),
+            "source_binding": {k: v for k, v in report.items() if k.endswith("_sha256")
+                               or k in ("rule_task_id", "rule_file", "declared_rule_hash")},
+            "declared_rival_identities": report.get("rival_identities"),
+            "saved_authority": report.get("sampler", {}).get("authority"),
+            "summary": {"declared_bindings": len(names), "reported_unique_rivals": report.get("unique_rivals"),
+                        "binding_statuses": dict(row_counts)},
+            "population": {"lesson_rows": len(lessons), "labeled_pair_occurrences": sum(pair_counts),
+                           "unique_inputs": len(inputs), "rotations_not_new_support": rotations,
+                           "reported_summary": summary},
+            "rivals": rows, "issues": issues,
+            "limits": list(report.get("limits", [])) + [
+                "Read-only analysis of saved declared-rival results; no generator, rule, Python control, or Racket execution.",
+                "Internal source/instance hashes are checked; source identities and canonical aggregate scores are retained claims, not independently rerun results.",
+                "Refuted means a demo disagreement; ambiguous means a query disagreement after demo agreement. Both distinguish a rival somewhere in generated support.",
+                "Exact pair mismatch counts are unavailable from lesson statuses; repeated inputs and rotations are not additional distinct support.",
+                "Coverage gaps are finite missing-teaching-distinction warnings, not a universal rejection policy. No undeclared rivals are assessed.",
+            ]}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("report", type=Path)
+    parser.add_argument("--out", type=Path, help="Write JSON to a new file (stdout also contains JSON).")
+    args = parser.parse_args()
+    try:
+        receipt = read_receipt(args.report)
+        result = audit(json.loads(receipt["raw"]))
+        result["input"] = {"path": str(args.report), "raw_sha256": hashlib.sha256(receipt["raw"]).hexdigest(),
+                           "raw_bytes": len(receipt["raw"]), "transport": receipt["transport"]}
+    except (OSError, ValueError, TypeError, KeyError, AttributeError) as exc:
+        result = {"schema": SCHEMA, "status": "input_error", "issues": [str(exc)],
+                  "input": {"path": str(args.report)}}
+    output = json.dumps(result, indent=2) + "\n"
+    if args.out:
+        with args.out.open("x") as stream:
+            stream.write(output)
+    print(output, end="")
+    return 2 if result["status"] in ("input_error", "insufficient_evidence") else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
