  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Headers as axes: cell (i,j) lights with the shared color when the i-th\n ;; LEFT header equals the j-th TOP header (headers dropped from the output).\n (let ((top (rest (first g)))\n       (left (map first (rest g))))\n   (grid-from-fn (length left) (length top) (lambda (r c)\n     (let ((lv (list-ref left r)) (tv (list-ref top c)))\n       (if (and (!= lv 0) (= lv tv)) lv 0))))))",
  "solution_language": "racket",
  "target_code": "(rule!\n ;; Headers as axes: cell (i,j) lights with the shared color when the i-th\n ;; LEFT header equals the j-th TOP header (headers dropped from the output).\n (let ((top (rest (first g)))\n       (left (map first (rest g))))\n   (grid-from-fn (length left) (length top) (lambda (r c)\n     (let ((lv (list-ref left r)) (tv (list-ref top c)))\n       (if (and (!= lv 0) (= lv tv)) lv 0))))))",
