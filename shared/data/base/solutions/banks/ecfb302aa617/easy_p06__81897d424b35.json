    "raw_code": "(rule!\n  (let ((dummy 0))\n\n    (define (cell< a b)\n      (if (= (first a) (first b)) (< (second a) (second b)) (< (first a) (first b))))\n    (define (nonzero-cells grid)\n      (filter (lambda (cell) (not (= (third cell) 0))) (grid-cells grid)))\n    (define (normalize-cell-list cells)\n      (if (empty? cells)\n          (list)\n          (let* ((bb (bbox-of-cells cells))\n                 (r0 (first bb))\n                 (c0 (second bb)))\n            (sort (map (lambda (p) (list (- (first p) r0) (- (second p) c0))) cells) cell<))))\n    (define (cells->grid cells color)\n      (if (empty? cells)\n          (grid (list 0))\n          (let* ((norm (normalize-cell-list cells))\n                 (h (+ 1 (apply max (map first norm))))\n                 (w (+ 1 (apply max (map second norm)))))\n            (paint-cells (empty-grid h w 0) norm color))))\n    (define (mask-grid cells h w color)\n      (paint-cells (empty-grid h w 0) cells color))\n    (define (object-grid obj)\n      (cells->grid (obj-cells obj) (obj-color obj)))\n    (define (place-grid out grid top left)\n      (for*/fold ([acc out])\n                 ([r (in-range (rows grid))]\n                  [c (in-range (cols grid))])\n        (let ((v (at grid r c)))\n          (if (= v 0) acc (set-cell acc (+ top r) (+ left c) v)))))\n    (define (rect-frame? obj)\n      (and (>= (obj-h obj) 3)\n           (>= (obj-w obj) 3)\n           (= (obj-size obj) (- (* 2 (+ (obj-h obj) (obj-w obj))) 4))\n           (all? (lambda (p)\n                   (or (= (first p) (obj-r1 obj))\n                       (= (first p) (obj-r2 obj))\n                       (= (second p) (obj-c1 obj))\n                       (= (second p) (obj-c2 obj))))\n                 (obj-cells obj))))\n    (define (apply-transform-code grid code)\n      (cond [(= code 1) (rotate-cw grid)]\n            [(= code 2) (rotate-180 grid)]\n            [(= code 3) (flip-lr grid)]\n            [(= code 4) (transpose grid)]\n            [else grid]))\n    (define (rotate-ccw grid)\n      (rotate-cw (rotate-180 grid)))\n    (define (gallery grids)\n      (if (empty? grids)\n          (grid (list 0))\n          (let* ((out-h (apply max (map rows grids)))\n                 (out-w (+ (apply + (map cols grids)) (max 0 (- (length grids) 1)))))\n            (let loop ([remaining grids] [left 0] [out (empty-grid out-h out-w 0)])\n              (if (empty? remaining)\n                  out\n                  (let* ((piece (first remaining))\n                         (top (quotient (- out-h (rows piece)) 2))\n                         (next (place-grid out piece top left)))\n                    (loop (rest remaining) (+ left (cols piece) 1) next)))))))\n    (define (corner-positions grid)\n      (list (list 0 0)\n            (list 0 (- (cols grid) 1))\n            (list (- (rows grid) 1) 0)\n            (list (- (rows grid) 1) (- (cols grid) 1))))\n    (define (corner-key-color grid)\n      (let ((p (find-first (lambda (pos) (not (= (at grid (first pos) (second pos)) 0)))\n                           (corner-positions grid))))\n        (if (eq? p #f) 0 (at grid (first p) (second p)))))\n    (define (same-color-points grid color)\n      (sort (find-color grid color) cell<))\n    (define (neighbor-positions r c)\n      (map (lambda (d) (list (+ r (first d)) (+ c (second d)))) cardinal-deltas))\n    (define (floor-half n)\n      (if (>= n 0)\n          (quotient n 2)\n          (- (quotient (+ (- n) 1) 2))))\n\n    (for/fold ([out (empty-grid (rows g) (cols g) 0)]) ([c (in-range (cols g))])\n      (let* ((vals (filter (lambda (v) (not (= v 0))) (col g c)))\n             (start (- (rows g) (length vals))))\n        (for/fold ([acc out]) ([v (in-list vals)] [i (in-naturals)])\n          (set-cell acc (+ start i) c v))))\n  ))",
