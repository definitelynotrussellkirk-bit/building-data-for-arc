  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Slide the whole scene RIGIDLY down until its lowest cell touches the\n ;; bottom edge (one translation for everything, not per-column gravity).\n (let* ((cells (filter (lambda (p) (!= (at g (first p) (second p)) 0))\n                       (grid-positions g)))\n        (shift (- (- h 1) (apply max (map first cells)))))\n   (paint-cells (empty-grid h w 0)\n                (map (lambda (p) (list (+ (first p) shift) (second p)\n                                       (at g (first p) (second p))))\n                     cells))))",
  "solution_language": "racket",
