    "raw_code": "(rule!\n  (let ((dummy 0))\n    (define (pos< a b)\n      (if (= (first a) (first b)) (< (second a) (second b)) (< (first a) (first b))))\n    (define (canon obj) (sort (normalize-cells (obj-cells obj)) pos<))\n    (define objs\n      (sort (objects g 0)\n            (lambda (a b)\n              (if (= (obj-r1 a) (obj-r1 b))\n                  (< (obj-c1 a) (obj-c1 b))\n                  (< (obj-r1 a) (obj-r1 b))))))\n    (define norms (map canon objs))\n    (define n (length objs))\n    (grid-from-fn n n\n      (lambda (r c) (if (equal? (list-ref norms r) (list-ref norms c)) 8 0)))))",
    "solution_language": "racket",
    "target_code": "(rule!\n  (let ((dummy 0))\n    (define (pos< a b)\n      (if (= (first a) (first b)) (< (second a) (second b)) (< (first a) (first b))))\n    (define (canon obj) (sort (normalize-cells (obj-cells obj)) pos<))\n    ;; Objects sorted by bbox position\n    (define objs\n      (sort (objects g 0)\n            (lambda (a b)\n              (if (= (obj-r1 a) (obj-r1 b))\n                  (< (obj-c1 a) (obj-c1 b))\n                  (< (obj-r1 a) (obj-r1 b))))))\n    (define norms (map canon objs))\n    ;; Number of objects\n    (define n (length objs))\n    (grid-from-fn n n\n      (lambda (r c) (if (equal? (list-ref norms r) (list-ref norms c)) 8 0)))))",
