  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Two header rows spell a query: count of 1s in row 0 = the SYMMETRY\n ;; class (1 -> left-right, 2 -> up-down, 3 -> both, else none), count\n ;; of 2s in row 1 = the RANK k. Among the body objects (rows 2+) with\n ;; that symmetry, ranked biggest-first (ties top-left), answer with\n ;; the k-th — its shape mask painted cyan(8).\n (lambda (g)\n   (let ()\n     (define (norm-cells obj)\n       (map (lambda (p) (list (- (first p) (obj-r1 obj))\n                              (- (second p) (obj-c1 obj))))\n            (obj-cells obj)))\n     (define (mask-of obj color)\n       (paint-cells (empty-grid (obj-h obj) (obj-w obj) 0)\n                    (norm-cells obj) color))\n     (define (sym-class obj)  ;; up-down adds 1, left-right adds 2\n       (let ((cells (norm-cells obj)))\n         (+ (if (all? (lambda (p)\n                        (member (list (- (obj-h obj) 1 (first p))\n                                      (second p))\n                                cells))\n                      cells)\n                1 0)\n            (if (all? (lambda (p)\n                        (member (list (first p)\n                                      (- (obj-w obj) 1 (second p)))\n                                cells))\n                      cells)\n                2 0))))\n     (define sym-target\n       (let ((code (count-if (lambda (v) (= v 1)) (row g 0))))\n         (cond ((= code 1) 2) ((= code 2) 1) ((= code 3) 3) (else 0))))\n     (define k (count-if (lambda (v) (= v 2)) (row g 1)))\n     (define candidates  ;; matching symmetry, biggest first\n       (sort (filter (lambda (o) (= (sym-class o) sym-target))\n                     (objects (subgrid g 2 0 (- h 1) (- w 1)) 0))\n             (lambda (a b)\n               (if (= (obj-size a) (obj-size b))\n                   (if (= (obj-r1 a) (obj-r1 b))\n                       (< (obj-c1 a) (obj-c1 b))\n                       (< (obj-r1 a) (obj-r1 b)))\n                   (> (obj-size a) (obj-size b))))))\n     (mask-of (nth candidates (- k 1)) 8))))",
  "solution_language": "racket",
