  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Corner triads define local coordinate FRAMES: a 2 with orthogonal\n ;; 3/4 neighbors is the SOURCE, a 5 with 6/7 the TARGET. Read the\n ;; source's motif of 8s in local coordinates and draw its bounding\n ;; box OUTLINE in 8s through the target frame.\n (lambda (g)\n   (let ()\n     (define (point< a b)\n       (cond ((not (= (first a) (first b))) (< (first a) (first b)))\n             ((not (= (second a) (second b))) (< (second a) (second b)))\n             (else (< (third a) (third b)))))\n     (define (gpos f u v)\n       (list (+ (first (first f)) (* u (first (second f)))\n                (* v (first (third f))))\n             (+ (second (first f)) (* u (second (second f)))\n                (* v (second (third f))))))\n     (define (lpos f p)\n       (let ((dr (- (first p) (first (first f))))\n             (dc (- (second p) (second (first f)))))\n         (list (+ (* dr (first (second f))) (* dc (second (second f))))\n               (+ (* dr (first (third f))) (* dc (second (third f)))))))\n     (define (frame< a b)\n       (let loop ((xs (append (first a) (second a) (third a)))\n                  (ys (append (first b) (second b) (third b))))\n         (cond ((null? xs) #f)\n               ((< (first xs) (first ys)) #t)\n               ((> (first xs) (first ys)) #f)\n               (else (loop (rest xs) (rest ys))))))\n     (define (find-frames a b c)\n       (sort (remove-duplicates\n              (filter (lambda (x) x)\n                      (for*/list ((r (in-range h)) (col (in-range w))\n                                  (dx (in-list cardinal-deltas))\n                                  (dy (in-list cardinal-deltas)))\n                        (and (= (at g r col) a)\n                             (in-bounds? (+ r (first dx))\n                                         (+ col (second dx)) h w)\n                             (in-bounds? (+ r (first dy))\n                                         (+ col (second dy)) h w)\n                             (= (at g (+ r (first dx))\n                                    (+ col (second dx)))\n                                b)\n                             (= (at g (+ r (first dy))\n                                    (+ col (second dy)))\n                                c)\n                             (zero? (+ (* (first dx) (first dy))\n                                       (* (second dx) (second dy))))\n                             (list (list r col) dx dy)))))\n             frame<))\n     (define (motif-uvs f)  ;; the 8-cells in local coords, radius 3\n       (sort (filter (lambda (x) x)\n                     (for*/list ((r (in-range h)) (c (in-range w)))\n                       (and (= (at g r c) 8)\n                            (let ((uv (lpos f (list r c))))\n                              (and (<= (max (abs (first uv))\n                                            (abs (second uv)))\n                                       3)\n                                   (list (first uv) (second uv) 8))))))\n             point<))\n     (define sf (first (find-frames 2 3 4)))\n     (define tf (first (find-frames 5 6 7)))\n     (define uvs (map (lambda (p) (list (first p) (second p)))\n                      (motif-uvs sf)))\n     (define u0 (min-of first uvs))\n     (define v0 (min-of second uvs))\n     (define u1 (max-of first uvs))\n     (define v1 (max-of second uvs))\n     (for*/fold ((out g)) ((u (in-range u0 (+ u1 1)))\n                           (v (in-range v0 (+ v1 1))))\n       (if (or (= u u0) (= u u1) (= v v0) (= v v1))\n           (let ((rc (gpos tf u v)))\n             (set-cell out (first rc) (second rc) 8))\n           out)))))",
