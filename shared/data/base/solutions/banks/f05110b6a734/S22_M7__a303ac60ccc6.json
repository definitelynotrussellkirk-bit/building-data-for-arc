    "needs_conversion": false,
    "raw_code": "(rule!\n ;; Two orthogonal color tripods act as coordinate frames. The SOURCE frame\n ;; is a 2-cell whose 3-neighbor gives the x axis and 4-neighbor the y axis;\n ;; the TARGET frame is a 5-cell with 6 and 7 likewise. Of the 8-marker\n ;; cells within Chebyshev radius 3 of the source origin (in source-local\n ;; coordinates), only those at MAXIMUM Manhattan distance are copied to\n ;; the same local positions in the target frame. Rest of grid unchanged.\n (lambda (g)\n   (let ()\n     (define (lex< a b)  ;; lexicographic over equal-length number lists\n       (cond ((null? a) #f)\n             ((not (= (first a) (first b))) (< (first a) (first b)))\n             (else (lex< (rest a) (rest b)))))\n     (define (find-frame a b c)  ;; -> (origin vx vy), lex-first candidate\n       (first\n        (sort (remove-duplicates\n               (filter values\n                       (for*/list ((r (range h)) (col (range w))\n                                   (dx cardinal-deltas) (dy cardinal-deltas))\n                         (and (= (at g r col) a)\n                              (in-bounds? (+ r (first dx)) (+ col (second dx)) h w)\n                              (in-bounds? (+ r (first dy)) (+ col (second dy)) h w)\n                              (= (at g (+ r (first dx)) (+ col (second dx))) b)\n                              (= (at g (+ r (first dy)) (+ col (second dy))) c)\n                              (zero? (+ (* (first dx) (first dy))\n                                        (* (second dx) (second dy))))\n                              (list (list r col) dx dy)))))\n              (lambda (fa fb)\n                (lex< (append (first fa) (second fa) (third fa))\n                      (append (first fb) (second fb) (third fb)))))))\n     (define (lpos f r c)  ;; grid position -> frame-local (u v)\n       (let ((dr (- r (first (first f))))\n             (dc (- c (second (first f)))))\n         (list (+ (* dr (first (second f))) (* dc (second (second f))))\n               (+ (* dr (first (third f))) (* dc (second (third f)))))))\n     (define (gpos f u v)  ;; frame-local (u v) -> grid position\n       (list (+ (first (first f))\n                (* u (first (second f))) (* v (first (third f))))\n             (+ (second (first f))\n                (* u (second (second f))) (* v (second (third f))))))\n     (define src (find-frame 2 3 4))\n     (define tgt (find-frame 5 6 7))\n     (define pts  ;; (u v color) 8-markers near the source origin, sorted\n       (sort (filter values\n                     (for*/list ((r (range h)) (c (range w)))\n                       (and (= (at g r c) 8)\n                            (let ((uv (lpos src r c)))\n                              (and (<= (max (abs (first uv)) (abs (second uv))) 3)\n                                   (list (first uv) (second uv) 8))))))\n             lex<))\n     (define far  ;; the markers at maximum Manhattan distance from origin\n       (let ((maxrad (max-of (lambda (p) (+ (abs (first p)) (abs (second p))))\n                             pts)))\n         (filter (lambda (p) (= (+ (abs (first p)) (abs (second p))) maxrad))\n                 pts)))\n     (for/fold ((out g)) ((p far))\n       (let ((rc (gpos tgt (first p) (second p))))\n         (set-cell out (first rc) (second rc) (third p)))))))",
    "solution_language": "racket",
