    "raw_code": "(rule!\n  (let ((dummy 0))\n    (define (rect-frame? obj)\n      (and (= (obj-color obj) 1)\n           (>= (obj-h obj) 3)\n           (>= (obj-w obj) 3)\n           (= (obj-size obj) (- (* (obj-h obj) (obj-w obj))\n                                (* (- (obj-h obj) 2) (- (obj-w obj) 2))))\n           (all? (lambda (p)\n                   (or (= (first p) (obj-r1 obj))\n                       (= (first p) (obj-r2 obj))\n                       (= (second p) (obj-c1 obj))\n                       (= (second p) (obj-c2 obj))))\n                 (obj-cells obj))))\n    (define (transform-code grid code)\n      (cond [(= code 1) grid]\n            [(= code 2) (rotate-cw grid)]\n            [(= code 3) (rotate-180 grid)]\n            [(= code 4) (transpose grid)]\n            [(= code 5) (flip-lr grid)]\n            [else (flip-ud grid)]))\n    (define frames\n      (sort (filter rect-frame? (objects g 0))\n            (lambda (a b)\n              (if (= (obj-r1 a) (obj-r1 b))\n                  (< (obj-c1 a) (obj-c1 b))\n                  (< (obj-r1 a) (obj-r1 b))))))\n    (define (inner-crop obj)\n      (crop-to-content\n        (subgrid g (+ (obj-r1 obj) 1) (+ (obj-c1 obj) 1)\n                 (- (obj-r2 obj) 1) (- (obj-c2 obj) 1))))\n    (if (< (length frames) 3)\n        (list (list 0))\n        (let* ((A (inner-crop (first frames)))\n               (B (inner-crop (second frames)))\n               (C (inner-crop (third frames)))\n               (code (let ((hit (find-first (lambda (t) (equal? (transform-code A t) B))\n                                            (list 1 2 3 4 5 6))))\n                       (if hit hit 1))))\n          (transform-code C code)))))",
