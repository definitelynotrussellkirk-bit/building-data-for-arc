  "description_target": {
    "target_text": "Find hollow blue (1) rectangular frames and sort them by top-left row, then column. Tightly crop the first three frame interiors as A, B, and C. Choose the first transform in identity, clockwise rotation, 180-degree rotation, transpose, left-right reflection, up-down reflection order that maps A to B, then apply it to C.",
    "target_status": "verified_semantic_rule",
    "source": "canonical written solution and executable program",
    "solution_steps": [
      "Find color-1 objects whose cells form exactly the border of a rectangular bounding box at least 3 by 3.",
      "Sort qualifying frames by top-left row and then top-left column.",
      "If fewer than three frames exist, return a single black cell.",
      "For each of the first three frames, remove its border and crop the remaining subgrid tightly to nonzero content.",
      "Call the cropped panels A, B, and C.",
      "Test identity, clockwise rotation, 180-degree rotation, transpose, left-right reflection, and up-down reflection in that exact order.",
      "Select the first tested transform whose result on A equals B; use identity if none matches.",
      "Apply the selected transform to C and return the transformed tight crop."
    ],
    "puzzle_concepts": [
      "A:B::C visual analogy",
      "hollow rectangular frame detection",
      "row-major object ordering",
      "tight content cropping",
      "ordered dihedral transform inference",
      "transformation transfer"
    ],
    "semantic_primitives": [
      "objects",
