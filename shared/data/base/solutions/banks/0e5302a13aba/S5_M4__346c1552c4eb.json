  "raw_code": "(rule!\n ;; Output one row of the object COLORS, sorted by size then color.\n (let ((sorted (sort (objects g 0)\n                     (lambda (a b) (if (= (obj-size a) (obj-size b))\n                                       (< (obj-color a) (obj-color b))\n                                       (< (obj-size a) (obj-size b)))))))\n   (list (map obj-color sorted))))",
