  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Each maroon(9) rectangular FRAME holds a few components. The key dot row\n ;; ABOVE the frame picks which one (2 = smallest, else largest); the key dot\n ;; column LEFT of it picks a transform (4 = rotate-cw, 5 = flip-lr,\n ;; 6 = rotate-180, else identity). The chosen, transformed parts line up\n ;; horizontally (vertically centered, 1-col gaps), frames in top-left order.\n (lambda (g)\n   (let ()\n     (define (crop-nonzero grid)\n       (let ((cells (filter (lambda (p) (!= (at grid (first p) (second p)) 0))\n                            (grid-positions grid))))\n         (if (empty? cells)\n             (list (list 0))\n             (let ((bb (bbox-of-cells cells)))\n               (subgrid grid (first bb) (second bb) (third bb) (fourth bb))))))\n     (define (rect-frame? obj)\n       ;; exactly the border of a >=3x3 bbox: every cell on the border AND\n       ;; the cell count equals the perimeter\n       (let* ((bb (obj-bbox obj))\n              (hh (+ 1 (- (third bb) (first bb))))\n              (ww (+ 1 (- (fourth bb) (second bb)))))\n         (and (>= hh 3) (>= ww 3)\n              (= (obj-size obj) (- (* 2 (+ hh ww)) 4))\n              (all? (lambda (p) (or (= (first p) (first bb))\n                                    (= (first p) (third bb))\n                                    (= (second p) (second bb))\n                                    (= (second p) (fourth bb))))\n                    (obj-cells obj)))))\n     (define frames\n       (sort (filter (lambda (o) (and (= (obj-color o) 9) (rect-frame? o)))\n                     (objects g 0))\n             (lambda (a b)\n               (let ((ba (obj-bbox a)) (bb (obj-bbox b)))\n                 (or (< (first ba) (first bb))\n                     (and (= (first ba) (first bb))\n                          (< (second ba) (second bb))))))))\n     (define (first-key vals)\n       (first (filter (lambda (v) (not (member? v (list 0 9)))) vals)))\n     (define (key-above fr)\n       (let ((bb (obj-bbox fr)))\n         (first-key (if (>= (- (first bb) 1) 0)\n                        (map (lambda (c) (at g (- (first bb) 1) c))\n                             (range (second bb) (+ (fourth bb) 1)))\n                        (list)))))\n     (define (key-left fr)\n       (let ((bb (obj-bbox fr)))\n         (first-key (if (>= (- (second bb) 1) 0)\n                        (map (lambda (r) (at g r (- (second bb) 1)))\n                             (range (first bb) (+ (third bb) 1)))\n                        (list)))))\n     (define (part-of fr)\n       (let* ((bb (obj-bbox fr))\n              (sub (subgrid g (+ (first bb) 1) (+ (second bb) 1)\n                            (- (third bb) 1) (- (fourth bb) 1)))\n              (comps (sort (objects sub 0)\n                           (lambda (a b) (< (obj-size a) (obj-size b)))))\n              (chosen (if (= (key-above fr) 2) (first comps) (last comps)))\n              (part (crop-nonzero\n                     (paint-cells (empty-grid (rows sub) (cols sub) 0)\n                                  (obj-cells chosen) (obj-color chosen)))))\n         (cond ((= (key-left fr) 4) (rotate-cw part))\n               ((= (key-left fr) 5) (flip-lr part))\n               ((= (key-left fr) 6) (rotate-180 part))\n               (else part))))\n     (define (hstack-center pieces)\n       (if (empty? pieces)\n           (list (list))\n           (let* ((hh (apply max (map rows pieces)))\n                  (ww (+ (apply + (map cols pieces)) (- (length pieces) 1))))\n             (let loop ((xs pieces) (left 0) (out (empty-grid hh ww 0)))\n               (if (empty? xs)\n                   out\n                   (let ((piece (first xs)))\n                     (loop (rest xs) (+ left (cols piece) 1)\n                           (paste out piece\n                                  (quotient (- hh (rows piece)) 2)\n                                  left))))))))\n     (hstack-center (map part-of frames)))))",
  "solution_language": "racket",
