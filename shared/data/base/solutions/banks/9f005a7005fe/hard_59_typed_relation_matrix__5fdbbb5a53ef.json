  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Maroon(9) frames form a top header row and a left header column of\n ;; small colored shapes. Output the relation matrix (left headers x\n ;; top headers): cyan(8) = same shape (up to rotation) AND same color,\n ;; magenta(6) = shape only, green(3) = color only, 0 = neither.\n (lambda (g)\n   (let ()\n     (define (crop-nonzero grid)\n       (let ((cells (filter (lambda (p) (> (at grid (first p) (second p)) 0))\n                            (grid-positions grid))))\n         (if (empty? cells)\n             (list (list 0))\n             (let ((bb (bbox-of-cells cells)))\n               (subgrid grid (first bb) (second bb)\n                        (third bb) (fourth bb))))))\n     (define (shape-of grid)  ;; binary silhouette cropped to content\n       (crop-nonzero (grid-from-fn (rows grid) (cols grid)\n                                   (lambda (r c)\n                                     (if (= (at grid r c) 0) 0 1)))))\n     (define (same-shape? a b)  ;; equal silhouettes up to 90-degree turns\n       (member? (shape-of b)\n                (let loop ((cur (shape-of a)) (n 0) (acc (list)))\n                  (if (= n 4) acc\n                      (loop (rotate-cw cur) (+ n 1) (cons cur acc))))))\n     (define (color-of grid)\n       (first (filter (lambda (v) (> v 0)) (apply append grid))))\n     (define (frame? o)  ;; hollow rectangle outline, at least 3x3\n       (and (>= (obj-h o) 3) (>= (obj-w o) 3)\n            (= (obj-size o) (- (* 2 (+ (obj-h o) (obj-w o))) 4))\n            (all? (lambda (p) (or (= (first p) (obj-r1 o))\n                                  (= (first p) (obj-r2 o))\n                                  (= (second p) (obj-c1 o))\n                                  (= (second p) (obj-c2 o))))\n                  (obj-cells o))))\n     (define (interior fr)\n       (crop-nonzero (subgrid g (+ (obj-r1 fr) 1) (+ (obj-c1 fr) 1)\n                              (- (obj-r2 fr) 1) (- (obj-c2 fr) 1))))\n     (define frames\n       (filter (lambda (o) (and (= (obj-color o) 9) (frame? o)))\n               (objects g 0)))\n     (define top (apply min (map obj-r1 frames)))\n     (define tops\n       (map interior (sort (filter (lambda (f) (= (obj-r1 f) top)) frames)\n                           (lambda (a b) (< (obj-c1 a) (obj-c1 b))))))\n     (define lefts\n       (map interior\n            (sort (filter (lambda (f)\n                            (and (= (obj-c1 f)\n                                    (apply min (map obj-c1 frames)))\n                                 (> (obj-r1 f) top)))\n                          frames)\n                  (lambda (a b) (< (obj-r1 a) (obj-r1 b))))))\n     (grid-from-fn (length lefts) (length tops)\n                   (lambda (r c)\n                     (let* ((a (list-ref lefts r))\n                            (b (list-ref tops c))\n                            (shape-hit (same-shape? a b))\n                            (color-hit (= (color-of a) (color-of b))))\n                       (cond ((and shape-hit color-hit) 8)\n                             (shape-hit 6)\n                             (color-hit 3)\n                             (else 0))))))))",
  "solution_language": "racket",
