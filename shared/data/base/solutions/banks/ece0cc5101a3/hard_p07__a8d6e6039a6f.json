  "needs_conversion": false,
  "raw_code": "(rule!\n  (let ()\n    (define (frame? obj)\n      (and (= (obj-color obj) 5) (hollow-frame? obj)))\n    (define (frame< a b)\n      (cell< (list (obj-r1 a) (obj-c1 a))\n             (list (obj-r1 b) (obj-c1 b))))\n    (define (key-of frame)\n      (let* ((top (obj-r1 frame))\n             (bottom (obj-r2 frame))\n             (left (obj-c1 frame))\n             (right (obj-c2 frame))\n             (positions\n              (list (list (- top 1) left) (list (- top 1) right)\n                    (list (+ bottom 1) left) (list (+ bottom 1) right)\n                    (list top (- left 1)) (list top (+ right 1))\n                    (list bottom (- left 1)) (list bottom (+ right 1))))\n             (values\n              (filter (lambda (value) (and (>= value 1) (<= value 4)))\n                      (map (lambda (position)\n                             (if (in-bounds? (first position) (second position)\n                                             (rows g) (cols g))\n                                 (at g (first position) (second position))\n                                 0))\n                           positions))))\n        (if (empty? values) 1 (first (sort values <)))))\n    (define (transform piece key)\n      (cond ((= key 2) (rotate-cw piece))\n            ((= key 3) (flip-lr piece))\n            ((= key 4) (flip-ud piece))\n            (else piece)))\n    (define (stamp out frame template)\n      (let* ((piece (transform template (key-of frame)))\n             (interior-h (- (obj-h frame) 2))\n             (interior-w (- (obj-w frame) 2))\n             (top (+ (obj-r1 frame) 1\n                     (max 0 (quotient (- interior-h (rows piece)) 2))))\n             (left (+ (obj-c1 frame) 1\n                      (max 0 (quotient (- interior-w (cols piece)) 2)))))\n        (paste-crop out piece top left)))\n    (let* ((frames (sort (filter frame? (objects g 0)) frame<))\n           (template-cells\n            (filter (lambda (position)\n                      (> (at g (first position) (second position)) 5))\n                    (grid-positions g))))\n      (if (empty? template-cells)\n          g\n          (let* ((template (crop-cells g template-cells))\n                 (base\n                  (for/fold ((out (empty-grid (rows g) (cols g) 0)))\n                            ((frame (in-list frames)))\n                    (paint-cells out (obj-cells frame) 5))))\n            (for/fold ((out base)) ((frame (in-list frames)))\n              (stamp out frame template)))))))",
