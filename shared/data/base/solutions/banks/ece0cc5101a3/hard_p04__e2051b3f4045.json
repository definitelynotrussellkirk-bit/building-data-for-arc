  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Gray(5) frames of assorted sizes and loose objects pair up by RANK:\n ;; the smallest object goes centered into the smallest-interior frame,\n ;; the next into the next, and so on — all drawn on a blank canvas.\n (lambda (g)\n   (let ()\n     (define (frame? o)  ;; hollow gray rectangle outline, 3x3+\n       (and (= (obj-color o) 5)\n            (>= (obj-h o) 3) (>= (obj-w o) 3)\n            (= (obj-size o) (- (* 2 (+ (obj-h o) (obj-w o))) 4))\n            (all? (lambda (p) (or (= (first p) (obj-r1 o))\n                                  (= (first p) (obj-r2 o))\n                                  (= (second p) (obj-c1 o))\n                                  (= (second p) (obj-c2 o))))\n                  (obj-cells o))))\n     (define (bb< a b)\n       (let loop ((xs (list (obj-r1 a) (obj-r2 a) (obj-c1 a)\n                            (obj-c2 a)))\n                  (ys (list (obj-r1 b) (obj-r2 b) (obj-c1 b)\n                            (obj-c2 b))))\n         (cond ((null? xs) #f)\n               ((< (first xs) (first ys)) #t)\n               ((> (first xs) (first ys)) #f)\n               (else (loop (rest xs) (rest ys))))))\n     (define frames  ;; smallest interior first\n       (sort (filter frame? (objects g 0))\n             (lambda (a b)\n               (let ((ia (* (- (obj-h a) 2) (- (obj-w a) 2)))\n                     (ib (* (- (obj-h b) 2) (- (obj-w b) 2))))\n                 (if (= ia ib) (bb< a b) (< ia ib))))))\n     (define movers  ;; smallest object first\n       (sort (filter (lambda (o) (not (= (obj-color o) 5)))\n                     (objects g 0))\n             (lambda (a b) (if (= (obj-size a) (obj-size b))\n                               (bb< a b)\n                               (< (obj-size a) (obj-size b))))))\n     (define (stamp out obj fr)  ;; object centered in the frame\n       (let* ((cells (normalize-cells (obj-cells obj)))\n              (ch (+ 1 (max-of first cells)))\n              (cw (+ 1 (max-of second cells)))\n              (sr (+ (obj-r1 fr) 1\n                     (max 0 (quotient (- (obj-h fr) 2 ch) 2))))\n              (sc (+ (obj-c1 fr) 1\n                     (max 0 (quotient (- (obj-w fr) 2 cw) 2)))))\n         (paint-cells out\n                      (filter (lambda (p) (in-bounds? (first p)\n                                                      (second p) h w))\n                              (map (lambda (p)\n                                     (list (+ sr (first p))\n                                           (+ sc (second p))))\n                                   cells))\n                      (obj-color obj))))\n     (let loop ((objs movers) (frs frames)\n                (out (for/fold ((o (empty-grid h w 0)))\n                               ((f (in-list frames)))\n                       (paint-cells o (obj-cells f) 5))))\n       (if (or (empty? objs) (empty? frs))\n           out\n           (loop (rest objs) (rest frs)\n                 (stamp out (first objs) (first frs))))))))",
