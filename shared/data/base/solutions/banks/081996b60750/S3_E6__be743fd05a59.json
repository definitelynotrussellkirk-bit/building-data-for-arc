  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Paint a gray(5) diagonally DOWN-LEFT of every maroon(9) — checked against\n ;; the ACCUMULATING grid, so earlier paints block later ones.\n (for/fold ((out g)) ((p (in-list (find-color g 9))))\n   (let ((rr (+ (first p) 1)) (cc (- (second p) 1)))\n     (if (and (in-bounds? rr cc h w) (= (at out rr cc) 0))\n         (set-cell out rr cc 5)\n         out))))",
  "solution_language": "racket",
  "target_code": "(rule!\n ;; Paint a gray(5) diagonally DOWN-LEFT of every maroon(9) — checked against\n ;; the ACCUMULATING grid, so earlier paints block later ones.\n (for/fold ((out g)) ((p (in-list (find-color g 9))))\n   (let ((rr (+ (first p) 1)) (cc (- (second p) 1)))\n     (if (and (in-bounds? rr cc h w) (= (at out rr cc) 0))\n         (set-cell out rr cc 5)\n         out))))",
