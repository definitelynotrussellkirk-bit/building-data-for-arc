  "raw_code": "(rule!\n ;; Keep only the TOP cell of every vertical same-color run.\n (fold-cells g (empty-grid h w 0)\n             (lambda (out r c v)\n               (if (and (!= v 0) (or (= r 0) (!= (at g (- r 1) c) v)))\n                   (set-cell out r c v)\n                   out))))",
