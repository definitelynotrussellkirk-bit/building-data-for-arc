  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Quadrant histogram: for each bottom-left-quadrant row, count its\n ;; green(3)s and draw a left-aligned cyan(8) bar of that length.\n (let ((h2 (quotient h 2)) (w2 (quotient w 2)))\n   (grid-from-fn h2 w2 (lambda (r c)\n     (let ((len (count-where (lambda (cc) (= (at g (+ h2 r) cc) 3))\n                             (range 0 w2))))\n       (if (< c len) 8 0))))))",
  "solution_language": "racket",
  "target_code": "(rule!\n ;; Quadrant histogram: for each bottom-left-quadrant row, count its\n ;; green(3)s and draw a left-aligned cyan(8) bar of that length.\n (let ((h2 (quotient h 2)) (w2 (quotient w 2)))\n   (grid-from-fn h2 w2 (lambda (r c)\n     (let ((len (count-where (lambda (cc) (= (at g (+ h2 r) cc) 3))\n                             (range 0 w2))))\n       (if (< c len) 8 0))))))",
