  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Hollow cyan(8) frames and loose objects share the canvas. Each\n ;; object belongs in the frame whose interior AREA equals the object's\n ;; cell count. Redraw the frames on a blank canvas and paste each\n ;; object centered inside its matching frame (frames claim objects in\n ;; ascending area order; ties by position).\n (lambda (g)\n   (let ()\n     (define (frame? o)  ;; hollow rectangle outline, at least 3x3\n       (and (>= (obj-h o) 3) (>= (obj-w o) 3)\n            (= (obj-size o) (- (* 2 (+ (obj-h o) (obj-w o))) 4))\n            (all? (lambda (p) (or (= (first p) (obj-r1 o))\n                                  (= (first p) (obj-r2 o))\n                                  (= (second p) (obj-c1 o))\n                                  (= (second p) (obj-c2 o))))\n                  (obj-cells o))))\n     (define (area-of fr) (* (- (obj-h fr) 2) (- (obj-w fr) 2)))\n     (define (bbox< a b)\n       (let loop ((xs (list (obj-r1 a) (obj-c1 a) (obj-r2 a) (obj-c2 a)))\n                  (ys (list (obj-r1 b) (obj-c1 b) (obj-r2 b) (obj-c2 b))))\n         (cond ((empty? xs) #f)\n               ((< (first xs) (first ys)) #t)\n               ((> (first xs) (first ys)) #f)\n               (else (loop (rest xs) (rest ys))))))\n     (define frames\n       (sort (filter (lambda (o) (and (= (obj-color o) 8) (frame? o)))\n                     (objects g 0))\n             (lambda (a b)\n               (if (= (area-of a) (area-of b))\n                   (bbox< a b)\n                   (< (area-of a) (area-of b))))))\n     (define scene (erase-cells g (flatmap obj-cells frames) 0))\n     (define objs\n       (sort (filter (lambda (o) (not (= (obj-color o) 8)))\n                     (objects scene 0))\n             (lambda (a b)\n               (if (= (obj-size a) (obj-size b))\n                   (bbox< a b)\n                   (< (obj-size a) (obj-size b))))))\n     (define (paste-centered out o fr)\n       (let* ((sub (subgrid scene (obj-r1 o) (obj-c1 o)\n                            (obj-r2 o) (obj-c2 o)))\n              (sr (+ (obj-r1 fr) 1\n                     (max 0 (quotient (- (obj-h fr) 2 (rows sub)) 2))))\n              (sc (+ (obj-c1 fr) 1\n                     (max 0 (quotient (- (obj-w fr) 2 (cols sub)) 2)))))\n         (for*/fold ((acc out)) ((r (in-range (rows sub)))\n                                 (c (in-range (cols sub))))\n           (let ((v (at sub r c)))\n             (if (and (> v 0)\n                      (< (+ sr r) (obj-r2 fr))\n                      (< (+ sc c) (obj-c2 fr)))\n                 (set-cell acc (+ sr r) (+ sc c) v)\n                 acc)))))\n     (let loop ((frs frames) (avail objs)\n                (out (paint-cells (empty-grid h w 0)\n                                  (flatmap obj-cells frames) 8)))\n       (if (empty? frs)\n           out\n           (let* ((fr (first frs))\n                  (cand (find-first (lambda (o)\n                                      (= (obj-size o) (area-of fr)))\n                                    avail)))\n             (if cand\n                 (loop (rest frs)\n                       (filter (lambda (o) (not (equal? o cand))) avail)\n                       (paste-centered out cand fr))\n                 (loop (rest frs) avail out))))))))",
