    "needs_conversion": false,
    "raw_code": "(rule!\n  (let ((dummy 0))\n    (define (rotate-by cells code)\n      (cond\n        [(= code 2) (normalize-cells (rotate-cells-cw cells))]\n        [(= code 3) (normalize-cells (rotate-cells-cw (rotate-cells-cw cells)))]\n        [(= code 4) (normalize-cells (rotate-cells-cw (rotate-cells-cw (rotate-cells-cw cells))))]\n        [else (normalize-cells cells)]))\n    (let* (;; The first top-row value in 1..4 is the rotation code.\n           (control-hit (find-first (lambda (v) (member? v (list 1 2 3 4))) (row-at g 0)))\n           (control (if control-hit control-hit 1))\n           ;; The first cyan cell is the top-left anchor of the output stamp.\n           (anchor (first (find-color g 8)))\n           ;; Select the first red object in row-major object order.  When the\n           ;; control is red(2), its top-row singleton is deliberately first.\n           (template (first (filter (lambda (obj) (= (obj-color obj) 2)) (objects g 0))))\n           (shape (rotate-by (normalize-cells (obj-cells template)) control)))\n      ;; Stamp only the rotated template in green; every other cell is blank.\n      (grid-from-fn h w\n        (lambda (r c)\n          (let ((hit\n                  (find-first\n                    (lambda (p)\n                      (and (= r (+ (fst anchor) (fst p)))\n                           (= c (+ (snd anchor) (snd p)))))\n                    shape)))\n            (if hit 3 0)))))))",
    "solution_language": "racket",
    "target_code": "(rule!\n  (let ((dummy 0))\n    (define (rotate-by cells code)\n      (cond\n        [(= code 2) (normalize-cells (rotate-cells-cw cells))]\n        [(= code 3) (normalize-cells (rotate-cells-cw (rotate-cells-cw cells)))]\n        [(= code 4) (normalize-cells (rotate-cells-cw (rotate-cells-cw (rotate-cells-cw cells))))]\n        [else (normalize-cells cells)]))\n    (let* (;; The first top-row value in 1..4 is the rotation code.\n           (control-hit (find-first (lambda (v) (member? v (list 1 2 3 4))) (row-at g 0)))\n           (control (if control-hit control-hit 1))\n           ;; The first cyan cell is the top-left anchor of the output stamp.\n           (anchor (first (find-color g 8)))\n           ;; Select the first red object in row-major object order.  When the\n           ;; control is red(2), its top-row singleton is deliberately first.\n           (template (first (filter (lambda (obj) (= (obj-color obj) 2)) (objects g 0))))\n           (shape (rotate-by (normalize-cells (obj-cells template)) control)))\n      ;; Stamp only the rotated template in green; every other cell is blank.\n      (grid-from-fn h w\n        (lambda (r c)\n          (let ((hit\n                  (find-first\n                    (lambda (p)\n                      (and (= r (+ (fst anchor) (fst p)))\n                           (= c (+ (snd anchor) (snd p)))))\n                    shape)))\n            (if hit 3 0)))))))",
