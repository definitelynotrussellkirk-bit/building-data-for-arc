  "needs_conversion": false,
  "raw_code": "(rule!\n ;; The corner KEY at (0,0) picks the transform for the remaining shape\n ;; (cropped to content): 1 -> flip-lr, 2 -> flip-ud, else unchanged.\n (let* ((key (at g 0 0))\n        (obj (crop-to-content (set-cell g 0 0 0))))\n   (cond ((= key 1) (flip-lr obj))\n         ((= key 2) (flip-ud obj))\n         (else obj))))",
