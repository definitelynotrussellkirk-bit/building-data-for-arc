  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Recolor each object by its bbox SHAPE: wider -> red(2), taller ->\n ;; green(3), square -> yellow(4).\n (for/fold ((out (empty-grid h w 0))) ((obj (in-list (objects g 0))))\n   (paint-cells out (obj-cells obj)\n                (cond ((> (obj-w obj) (obj-h obj)) 2)\n                      ((> (obj-h obj) (obj-w obj)) 3)\n                      (else 4)))))",
