  "raw_code": "(rule!\n ;; Keep only the colors with an EVEN cell count; everything else clears.\n (let ((keep (filter (lambda (color) (= (modulo (length (find-color g color)) 2) 0))\n                     (grid-colors g 0))))\n   (grid-from-fn h w (lambda (r c)\n     (let ((v (at g r c))) (if (member? v keep) v 0))))))",
