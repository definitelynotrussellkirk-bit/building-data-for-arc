  "raw_code": "(rule!\n ;; Cyan(8) and maroon(9) frames each hold small objects plus a KEY\n ;; dot: blue(1) keeps the frame's SMALLEST object, red(2) its LARGEST.\n ;; Redraw every frame with only the chosen object centered inside —\n ;; rotated 180 degrees inside maroon frames.\n (lambda (g)\n   (let ()\n     (define (frame? o color)  ;; hollow rectangle outline, 3x3+\n       (and (= (obj-color o) color)\n            (>= (obj-h o) 3) (>= (obj-w o) 3)\n            (= (obj-size o) (- (* 2 (+ (obj-h o) (obj-w o))) 4))\n            (all? (lambda (p) (or (= (first p) (obj-r1 o))\n                                  (= (first p) (obj-r2 o))\n                                  (= (second p) (obj-c1 o))\n                                  (= (second p) (obj-c2 o))))\n                  (obj-cells o))))\n     (define (stamp out pat top left)  ;; nonzero cells, clipped\n       (for*/fold ((acc out)) ((r (range 0 (rows pat)))\n                               (c (range 0 (cols pat))))\n         (let ((v (at pat r c)))\n           (if (and (> v 0) (in-bounds? (+ top r) (+ left c) h w))\n               (set-cell acc (+ top r) (+ left c) v)\n               acc))))\n     (define (process out frame color)\n       (let* ((r1 (obj-r1 frame)) (c1 (obj-c1 frame))\n              (r2 (obj-r2 frame)) (c2 (obj-c2 frame))\n              (key (find-first\n                    (lambda (v) (member? v (list 1 2)))\n                    (map (lambda (p) (at g (first p) (second p)))\n                         (positions-in-rect (+ r1 1) (+ c1 1)\n                                            (- r2 1) (- c2 1)))))\n              (interior  ;; frame contents with key dots scrubbed\n               (grid-from-fn (- r2 r1 1) (- c2 c1 1)\n                             (lambda (rr cc)\n                               (let ((v (at g (+ r1 1 rr)\n                                            (+ c1 1 cc))))\n                                 (if (or (= v 0)\n                                         (member? v (list 1 2)))\n                                     0 v)))))\n              (objs (sort (objects interior 0)\n                          (lambda (a b)\n                            (let loop ((xs (list (obj-size a)\n                                                 (obj-r1 a)\n                                                 (obj-c1 a)))\n                                       (ys (list (obj-size b)\n                                                 (obj-r1 b)\n                                                 (obj-c1 b))))\n                              (cond ((null? xs) #f)\n                                    ((< (first xs) (first ys)) #t)\n                                    ((> (first xs) (first ys)) #f)\n                                    (else (loop (rest xs)\n                                                (rest ys))))))))\n              (chosen (if (= key 1) (first objs) (last objs)))\n              (crop (subgrid interior (obj-r1 chosen) (obj-c1 chosen)\n                             (obj-r2 chosen) (obj-c2 chosen)))\n              (oriented (if (= color 9) (rotate-180 crop) crop)))\n         (stamp (paint-cells out (obj-cells frame) color)\n                oriented\n                (+ r1 1 (quotient (- (rows interior)\n                                     (rows oriented)) 2))\n                (+ c1 1 (quotient (- (cols interior)\n                                     (cols oriented)) 2)))))\n     (for/fold ((out (empty-grid h w 0)))\n               ((color (in-list (list 8 9))))\n       (for/fold ((o2 out))\n                 ((frame (sort (filter (lambda (o) (frame? o color))\n                                       (objects g 0))\n                               (lambda (a b)\n                                 (or (< (obj-r1 a) (obj-r1 b))\n                                     (and (= (obj-r1 a) (obj-r1 b))\n                                          (< (obj-c1 a)\n                                             (obj-c1 b))))))))\n         (process o2 frame color))))))",
