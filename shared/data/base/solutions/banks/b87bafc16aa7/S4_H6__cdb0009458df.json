    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  ;; each hollow 5-rectangle FRAME holds one colored marker in its interior: erase the marker\n  ;; and stamp the color-1 TEMPLATE shape into the frame interior, in the marker's color.\n  (define (objs-color color) (filter (lambda (o) (= (obj-color o) color)) (objects g 0)))\n  (define (rect-outline? o)                       ;; >=3x3 and every cell ON its bbox ring, ring full\n    (let* ((r1 (obj-r1 o)) (c1 (obj-c1 o)) (r2 (obj-r2 o)) (c2 (obj-c2 o))\n           (ring-n (- (* 2 (+ (- r2 r1) (- c2 c1) 2)) 4)))\n      (and (>= (- r2 r1) 2) (>= (- c2 c1) 2)\n           (= (obj-size o) ring-n)\n           (all? (lambda (p) (or (= (first p) r1) (= (first p) r2)\n                                 (= (second p) c1) (= (second p) c2)))\n                 (obj-cells o)))))\n  (define (bbox< a b)                             ;; deterministic template pick: topmost-leftmost\n    (cond ((!= (obj-r1 a) (obj-r1 b)) (< (obj-r1 a) (obj-r1 b)))\n          ((!= (obj-c1 a) (obj-c1 b)) (< (obj-c1 a) (obj-c1 b)))\n          ((!= (obj-r2 a) (obj-r2 b)) (< (obj-r2 a) (obj-r2 b)))\n          (else (< (obj-c2 a) (obj-c2 b)))))\n  (define (frame-marker f)                        ;; LAST interior cell that is neither bg nor frame\n    (let* ((hits (for*/list ((r (range (+ (obj-r1 f) 1) (obj-r2 f)))\n                             (c (range (+ (obj-c1 f) 1) (obj-c2 f)))\n                             #:when (not (member? (at g r c) (list 0 5))))\n                   (list r c (at g r c)))))\n      (if (empty? hits) #f (last hits))))\n  (let* ((template (first (sort (objs-color 1) bbox<)))\n         (shape (normalize-cells (obj-cells template))))\n    (for/fold ((out g)) ((f (filter rect-outline? (objs-color 5))))\n      (let* ((m (frame-marker f)))\n        (if (not m) out\n            (recolor-cells (set-cell out (first m) (second m) 0)\n                           (map (lambda (p) (list (+ (obj-r1 f) 1 (first p))\n                                                  (+ (obj-c1 f) 1 (second p))))\n                                shape)\n                           (third m))))))))",
    "solution_language": "racket",
