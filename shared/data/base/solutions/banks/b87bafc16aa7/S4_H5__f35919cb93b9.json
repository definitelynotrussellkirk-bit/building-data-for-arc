  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Copy every colored cell (not the maroon-9 pivot) onto its 4-fold ROTATION\n ;; orbit around the pivot (identity + 90/180/270 images, clipped to bounds).\n (let* ((pivot (first (find-color g 9)))\n        (pr (first pivot))\n        (pc (second pivot))\n        (sources (filter (lambda (p) (not (member? (at g (first p) (second p))\n                                                   (list 0 9))))\n                         (grid-positions g))))\n   (for/fold ((out g)) ((p (in-list sources)))\n     (let ((dr (- (first p) pr))\n           (dc (- (second p) pc)))\n       (paint-cells out\n                    (filter (lambda (q) (in-bounds? (first q) (second q) h w))\n                            (list (list (+ pr dr) (+ pc dc))\n                                  (list (+ pr dc) (- pc dr))\n                                  (list (- pr dr) (- pc dc))\n                                  (list (- pr dc) (+ pc dr))))\n                    (at g (first p) (second p)))))))",
  "solution_language": "racket",
  "target_code": "(rule!\n ;; Copy every colored cell (not the maroon-9 pivot) onto its 4-fold ROTATION\n ;; orbit around the pivot (identity + 90/180/270 images, clipped to bounds).\n (let* ((pivot (first (find-color g 9)))\n        (pr (first pivot))\n        (pc (second pivot))\n        (sources (filter (lambda (p) (not (member? (at g (first p) (second p))\n                                                   (list 0 9))))\n                         (grid-positions g))))\n   (for/fold ((out g)) ((p (in-list sources)))\n     (let ((dr (- (first p) pr))\n           (dc (- (second p) pc)))\n       (paint-cells out\n                    (filter (lambda (q) (in-bounds? (first q) (second q) h w))\n                            (list (list (+ pr dr) (+ pc dc))\n                                  (list (+ pr dc) (- pc dr))\n                                  (list (- pr dr) (- pc dc))\n                                  (list (- pr dc) (+ pc dr))))\n                    (at g (first p) (second p)))))))",
