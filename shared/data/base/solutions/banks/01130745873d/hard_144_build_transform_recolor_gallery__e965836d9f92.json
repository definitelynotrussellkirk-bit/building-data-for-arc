  "needs_conversion": false,
  "raw_code": "(rule!\n ;; The top header row lists transform CODES and the left header column\n ;; lists COLORS; the body holds one prototype shape. Print the whole\n ;; gallery — a row per color, a column per code — each panel the\n ;; prototype transformed (1 id / 2 flip-lr / 3 flip-ud / 4 cw / 5 180\n ;; / 6 ccw) and recolored, with 1-cell gaps between panels.\n (lambda (g)\n   (let ()\n     (define codes\n       (map (lambda (c) (at g 0 c))\n            (filter (lambda (c) (> (at g 0 c) 0)) (range 1 w))))\n     (define colors\n       (map (lambda (r) (at g r 0))\n            (filter (lambda (r) (> (at g r 0) 0)) (range 1 h))))\n     (define body  ;; the grid with both header lines blanked\n       (cellmap g (r c v)\n                (if (or (and (zero? r) (> c 0)) (and (zero? c) (> r 0)))\n                    0 v)))\n     (define proto  ;; largest 4-connected nonzero blob, as a 0/1 mask\n       (let ((cells (normalize-cells\n                     (obj-cells\n                      (pick-max (objects (cellmap body (r c v)\n                                                  (if (zero? v) 0 1))\n                                         0)\n                                obj-size)))))\n         (paint-cells (empty-grid (+ 1 (max-of first cells))\n                                  (+ 1 (max-of second cells))\n                                  0)\n                      cells 1)))\n     (define (xform grid code)\n       (cond ((= code 2) (flip-lr grid))\n             ((= code 3) (flip-ud grid))\n             ((= code 4) (rotate-cw grid))\n             ((= code 5) (rotate-180 grid))\n             ((= code 6) (rotate-ccw grid))\n             (else grid)))\n     (define panels\n       (map (lambda (color)\n              (map (lambda (code)\n                     (cellmap (xform proto code) (r c v)\n                              (if (zero? v) 0 color)))\n                   codes))\n            colors))\n     (let ((ph (rows (first (first panels))))\n           (pw (cols (first (first panels))))\n           (nr (length panels))\n           (nc (length (first panels))))\n       (for*/fold ((out (empty-grid (+ (* nr ph) (max 0 (- nr 1)))\n                                    (+ (* nc pw) (max 0 (- nc 1)))\n                                    0)))\n                  ((ri (range 0 nr)) (ci (range 0 nc)))\n         (let ((panel (nth (nth panels ri) ci)))\n           (for*/fold ((acc out)) ((r (range 0 (rows panel)))\n                                   (c (range 0 (cols panel))))\n             (let ((v (at panel r c))\n                   (rr (+ (* ri (+ ph 1)) r))\n                   (cc (+ (* ci (+ pw 1)) c)))\n               (if (and (> v 0) (in-bounds? rr cc (rows acc) (cols acc)))\n                   (set-cell acc rr cc v)\n                   acc)))))))))",
