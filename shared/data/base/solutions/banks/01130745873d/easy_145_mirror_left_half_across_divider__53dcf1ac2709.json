  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Copy every LEFT-half cell that is neither 0 nor 8 to its horizontally\n ;; mirrored position (one-directional; the 8-divider stays put).\n (let ((mid (quotient w 2)))\n   (for*/fold ((out g)) ((r (in-range h)) (c (in-range mid)))\n     (let ((v (at g r c)))\n       (if (member? v (list 0 8)) out (set-cell out r (- w 1 c) v))))))",
  "solution_language": "racket",
