  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Three control cells at the top-left spell (prototype-color,\n ;; transform-code, output-color). A cyan(8) wall frames the answer\n ;; area. Take the prototype shape — the largest blob of the prototype\n ;; color — transform it (1 id / 2 flip-lr / 3 flip-ud / 4 cw / 5 180 /\n ;; 6 ccw), recolor it, and stamp it centered inside the frame crop.\n (lambda (g)\n   (let ()\n     (define proto-color (at g 0 0))\n     (define code (at g 0 1))\n     (define out-color (at g 0 2))\n     (define controls (list (list 0 0) (list 0 1) (list 0 2)))\n     (define wall-cells\n       (flatmap obj-cells\n                (filter (lambda (o) (= (obj-color o) 8))\n                        (objects (erase-cells g controls 0) 0))))\n     (define scene (erase-cells g (append controls wall-cells) 0))\n     (define proto-cells  ;; largest 4-conn nonzero blob of proto color\n       (pick-max\n        (filter (lambda (cells)\n                  (= (at g (first (first cells)) (second (first cells)))\n                     proto-color))\n                (map (lambda (o) (sort (obj-cells o) cell<))\n                     (objects (cellmap scene (r c v)\n                                       (if (zero? v) 0 1))\n                              0)))\n        length))\n     (define proto  ;; its binary silhouette\n       (let ((bb (bbox-of-cells proto-cells)))\n         (paint-cells (empty-grid (+ 1 (- (third bb) (first bb)))\n                                  (+ 1 (- (fourth bb) (second bb)))\n                                  0)\n                      (map (lambda (p) (list (- (first p) (first bb))\n                                             (- (second p) (second bb))))\n                           proto-cells)\n                      1)))\n     (define tile\n       (cellmap (cond ((= code 2) (flip-lr proto))\n                      ((= code 3) (flip-ud proto))\n                      ((= code 4) (rotate-cw proto))\n                      ((= code 5) (rotate-180 proto))\n                      ((= code 6) (rotate-ccw proto))\n                      (else proto))\n                (r c v) (if (zero? v) 0 out-color)))\n     (define frame-crop\n       (let ((bb (bbox-of-cells wall-cells)))\n         (subgrid g (first bb) (second bb) (third bb) (fourth bb))))\n     (let ((top (quotient (- (rows frame-crop) (rows tile)) 2))\n           (left (quotient (- (cols frame-crop) (cols tile)) 2)))\n       (for*/fold ((out frame-crop)) ((r (range 0 (rows tile)))\n                                      (c (range 0 (cols tile))))\n         (let ((v (at tile r c)))\n           (if (and (> v 0)\n                    (in-bounds? (+ top r) (+ left c)\n                                (rows out) (cols out)))\n               (set-cell out (+ top r) (+ left c) v)\n               out)))))))",
  "solution_language": "racket",
  "target_code": "(rule!\n ;; Three control cells at the top-left spell (prototype-color,\n ;; transform-code, output-color). A cyan(8) wall frames the answer\n ;; area. Take the prototype shape — the largest blob of the prototype\n ;; color — transform it (1 id / 2 flip-lr / 3 flip-ud / 4 cw / 5 180 /\n ;; 6 ccw), recolor it, and stamp it centered inside the frame crop.\n (lambda (g)\n   (let ()\n     (define proto-color (at g 0 0))\n     (define code (at g 0 1))\n     (define out-color (at g 0 2))\n     (define controls (list (list 0 0) (list 0 1) (list 0 2)))\n     (define wall-cells\n       (flatmap obj-cells\n                (filter (lambda (o) (= (obj-color o) 8))\n                        (objects (erase-cells g controls 0) 0))))\n     (define scene (erase-cells g (append controls wall-cells) 0))\n     (define proto-cells  ;; largest 4-conn nonzero blob of proto color\n       (pick-max\n        (filter (lambda (cells)\n                  (= (at g (first (first cells)) (second (first cells)))\n                     proto-color))\n                (map (lambda (o) (sort (obj-cells o) cell<))\n                     (objects (cellmap scene (r c v)\n                                       (if (zero? v) 0 1))\n                              0)))\n        length))\n     (define proto  ;; its binary silhouette\n       (let ((bb (bbox-of-cells proto-cells)))\n         (paint-cells (empty-grid (+ 1 (- (third bb) (first bb)))\n                                  (+ 1 (- (fourth bb) (second bb)))\n                                  0)\n                      (map (lambda (p) (list (- (first p) (first bb))\n                                             (- (second p) (second bb))))\n                           proto-cells)\n                      1)))\n     (define tile\n       (cellmap (cond ((= code 2) (flip-lr proto))\n                      ((= code 3) (flip-ud proto))\n                      ((= code 4) (rotate-cw proto))\n                      ((= code 5) (rotate-180 proto))\n                      ((= code 6) (rotate-ccw proto))\n                      (else proto))\n                (r c v) (if (zero? v) 0 out-color)))\n     (define frame-crop\n       (let ((bb (bbox-of-cells wall-cells)))\n         (subgrid g (first bb) (second bb) (third bb) (fourth bb))))\n     (let ((top (quotient (- (rows frame-crop) (rows tile)) 2))\n           (left (quotient (- (cols frame-crop) (cols tile)) 2)))\n       (for*/fold ((out frame-crop)) ((r (range 0 (rows tile)))\n                                      (c (range 0 (cols tile))))\n         (let ((v (at tile r c)))\n           (if (and (> v 0)\n                    (in-bounds? (+ top r) (+ left c)\n                                (rows out) (cols out)))\n               (set-cell out (+ top r) (+ left c) v)\n               out)))))))",
