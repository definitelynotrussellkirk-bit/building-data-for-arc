  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Each row collapses to a left-packed run of its FIRST non-zero color,\n ;; one cell per original non-zero.\n (grid-from-fn h w (lambda (r c)\n   (let ((vals (filter (lambda (v) (!= v 0)) (row g r))))\n     (if (and (not (empty? vals)) (< c (length vals))) (first vals) 0)))))",
