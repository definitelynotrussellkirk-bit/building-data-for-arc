  "needs_conversion": false,
  "raw_code": "(rule!\n ;; An orange(7) TEMPLATE floats outside the frames. Each hollow frame\n ;; carries a marker dot (1-4) just outside a corner: 1 = rotate cw,\n ;; 2 = rotate 180, 3 = flip-lr, otherwise as-is — and the marker\n ;; value is also the stamp color. Erase the template and markers,\n ;; then stamp each frame's transformed template centered inside it.\n (lambda (g)\n   (let ()\n     (define frames  ;; every rect with a uniform nonzero border,\n                     ;; exactly as the original brute scan found them\n       (filter (lambda (x) x)\n               (for*/list ((r0 (in-range 0 (- h 2)))\n                           (c0 (in-range 0 (- w 2)))\n                           (r1 (in-range (+ r0 2) h))\n                           (c1 (in-range (+ c0 2) w)))\n                 (let ((col (at g r0 c0)))\n                   (and (not (= col 0))\n                        (all? (lambda (c) (and (= (at g r0 c) col)\n                                               (= (at g r1 c) col)))\n                              (range c0 (+ c1 1)))\n                        (all? (lambda (r) (and (= (at g r c0) col)\n                                               (= (at g r c1) col)))\n                              (range r0 (+ r1 1)))\n                        (list r0 c0 r1 c1))))))\n     (define (fr-r1 fr) (first fr))\n     (define (fr-c1 fr) (second fr))\n     (define (fr-r2 fr) (third fr))\n     (define (fr-c2 fr) (fourth fr))\n     (define (inside-frame? p)\n       (any? (lambda (fr) (and (<= (fr-r1 fr) (first p))\n                               (<= (first p) (fr-r2 fr))\n                               (<= (fr-c1 fr) (second p))\n                               (<= (second p) (fr-c2 fr))))\n             frames))\n     (define template-cells\n       (filter (lambda (p) (and (= (at g (first p) (second p)) 7)\n                                (not (inside-frame? p))))\n               (grid-positions g)))\n     (define template\n       (let ((bb (bbox-of-cells template-cells)))\n         (subgrid g (first bb) (second bb) (third bb) (fourth bb))))\n     (define (oriented code)\n       (crop-to-content (cond ((= code 1) (rotate-cw template))\n                              ((= code 2) (rotate-180 template))\n                              ((= code 3) (flip-lr template))\n                              (else template))\n                        0))\n     (for/fold ((out (paint-cells g template-cells 0)))\n               ((fr (in-list frames)))\n       (let* ((marker\n               (find-first (lambda (p)\n                             (and (in-bounds? (first p) (second p)\n                                              h w)\n                                  (member? (at g (first p) (second p))\n                                           (list 1 2 3 4))))\n                           (list (list (- (fr-r1 fr) 1) (fr-c1 fr))\n                                 (list (fr-r1 fr) (- (fr-c1 fr) 1))\n                                 (list (- (fr-r1 fr) 1) (fr-c2 fr))\n                                 (list (fr-r2 fr)\n                                       (- (fr-c1 fr) 1)))))\n              (code (if marker\n                        (at g (first marker) (second marker))\n                        4))\n              (sub (oriented code))\n              (out2 (if marker\n                        (set-cell out (first marker) (second marker) 0)\n                        out))\n              (sr (+ (fr-r1 fr) 1\n                     (quotient (- (- (fr-r2 fr) (fr-r1 fr) 1) (rows sub)) 2)))\n              (sc (+ (fr-c1 fr) 1\n                     (quotient (- (- (fr-c2 fr) (fr-c1 fr) 1) (cols sub)) 2))))\n         (for*/fold ((acc out2)) ((r (range 0 (rows sub)))\n                                  (c (range 0 (cols sub))))\n           (if (zero? (at sub r c))\n               acc\n               (set-cell acc (+ sr r) (+ sc c) code))))))))",
  "solution_language": "racket",
