  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Keep only the ODD-sized objects; repaint them on a fresh canvas.\n (for/fold ((out (empty-grid h w 0))) ((obj (in-list (objects g 0))))\n   (if (= (modulo (obj-size obj) 2) 1)\n       (paint-cells out (obj-cells obj) (obj-color obj))\n       out)))",
