  "raw_code": "(rule!\n ;; Every non-zero cell takes its ROW's first non-zero color.\n (grid-from-fn h w (lambda (r c)\n   (let ((nz (filter (lambda (cc) (!= (at g r cc) 0)) (range 0 w))))\n     (if (and (not (empty? nz)) (!= (at g r c) 0)) (at g r (first nz)) 0)))))",
