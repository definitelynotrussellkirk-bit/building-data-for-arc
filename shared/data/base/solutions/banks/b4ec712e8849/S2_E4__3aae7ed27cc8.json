  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Paint a yellow(4) diagonally DOWN-RIGHT of every red(2) (empty cells only).\n (for/fold ((out g)) ((cell (in-list (find-color g 2))))\n   (let ((r (+ (first cell) 1)) (c (+ (second cell) 1)))\n     (if (and (in-bounds? r c h w) (= (at g r c) 0))\n         (set-cell out r c 4)\n         out))))",
