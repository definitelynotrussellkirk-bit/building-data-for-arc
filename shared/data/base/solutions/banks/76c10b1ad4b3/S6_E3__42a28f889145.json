  "raw_code": "(rule!\n ;; SWAP the colors of the two objects (left object <-> right object).\n (let* ((comps (sort (objects g 0) (lambda (a b) (< (obj-c1 a) (obj-c1 b)))))\n        (a (first comps))\n        (b (second comps)))\n   (paint-cells (paint-cells g (obj-cells a) (obj-color b))\n                (obj-cells b) (obj-color a))))",
