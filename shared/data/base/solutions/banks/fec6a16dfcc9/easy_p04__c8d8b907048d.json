  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Copy every TOP-half non-zero to its vertically mirrored position\n ;; (one-directional: bottom-half content is never copied back).\n (for*/fold ((out g)) ((r (in-range 0 (quotient h 2))) (c (in-range w)))\n   (let ((v (at g r c)))\n     (if (= v 0) out (set-cell out (- h 1 r) c v)))))",
