  "needs_conversion": false,
  "raw_code": "(rule!\n ;; N components (sorted by bbox, row-major) -> an N x N CONTACT matrix:\n ;; 1 on the diagonal, 2 at (i,j) and (j,i) where components i and j touch\n ;; cardinally.\n (let ()\n   (define (bbox< a b)\n     (cond ((!= (first a) (first b)) (< (first a) (first b)))\n           ((!= (third a) (third b)) (< (third a) (third b)))\n           ((!= (second a) (second b)) (< (second a) (second b)))\n           (else (< (fourth a) (fourth b)))))\n   (define comps\n     (sort (objects g 0) (lambda (a b) (bbox< (obj-bbox a) (obj-bbox b)))))\n   (define n (length comps))\n   (for*/fold ((out (grid-from-fn n n (lambda (r c) (if (= r c) 1 0)))))\n              ((i (in-range n)) (j (in-range (+ i 1) n)))\n     (if (objects-touching? (list-ref comps i) (list-ref comps j))\n         (set-cell (set-cell out i j 2) j i 2)\n         out))))",
  "solution_language": "racket",
