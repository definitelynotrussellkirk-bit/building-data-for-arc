  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Two gray(5) frames hold binary masks — red(2) cells form A, green\n ;; (3) cells form B. The top-row key colors pick boolean ops: 2 = OR,\n ;; 3 = AND, anything else = XOR. Emit one cyan(8) result panel per\n ;; key, side by side with 1-column gaps.\n (lambda (g)\n   (let ()\n     (define (frame? o)  ;; hollow gray rectangle outline, 3x3+\n       (and (= (obj-color o) 5)\n            (>= (obj-h o) 3) (>= (obj-w o) 3)\n            (= (obj-size o) (- (* 2 (+ (obj-h o) (obj-w o))) 4))\n            (all? (lambda (p) (or (= (first p) (obj-r1 o))\n                                  (= (first p) (obj-r2 o))\n                                  (= (second p) (obj-c1 o))\n                                  (= (second p) (obj-c2 o))))\n                  (obj-cells o))))\n     (define frames\n       (sort (filter frame? (objects g 0))\n             (lambda (a b) (< (obj-c1 a) (obj-c1 b)))))\n     (define (mask-of fr color)\n       (grid-from-fn (- (obj-h fr) 2) (- (obj-w fr) 2)\n                     (lambda (r c)\n                       (if (= (at g (+ (obj-r1 fr) 1 r)\n                               (+ (obj-c1 fr) 1 c))\n                              color)\n                           1 0))))\n     (define a (mask-of (first frames) 2))\n     (define b (mask-of (second frames) 3))\n     (define parts\n       (map (lambda (key)\n              (grid-from-fn (rows a) (cols a)\n                            (lambda (r c)\n                              (let ((aa (not (zero? (at a r c))))\n                                    (bb (not (zero? (at b r c)))))\n                                (if (cond ((= key 2) (or aa bb))\n                                          ((= key 3) (and aa bb))\n                                          (else (not (equal? aa bb))))\n                                    8 0)))))\n            (filter (lambda (v) (not (= v 0))) (first g))))\n     (let ((gh (apply max (map rows parts)))\n           (gw (+ (apply + (map cols parts)) (- (length parts) 1))))\n       (let loop ((xs parts) (left 0) (out (empty-grid gh gw 0)))\n         (if (empty? xs)\n             out\n             (loop (rest xs) (+ left (cols (first xs)) 1)\n                   (for*/fold ((acc out))\n                              ((r (range 0 (rows (first xs))))\n                               (c (range 0 (cols (first xs)))))\n                     (let ((v (at (first xs) r c)))\n                       (if (> v 0)\n                           (set-cell acc r (+ left c) v)\n                           acc))))))))))",
  "solution_language": "racket",
