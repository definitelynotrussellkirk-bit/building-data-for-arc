gth parts) 1))))\n       (let loop ((xs parts) (left 0) (out (empty-grid gh gw 0)))\n         (if (empty? xs)\n             out\n             (loop (rest xs) (+ left (cols (first xs)) 1)\n                   (for*/fold ((acc out))\n                              ((r (range 0 (rows (first xs))))\n                               (c (range 0 (cols (first xs)))))\n                     (let ((v (at (first xs) r c)))\n                       (if (> v 0)\n                           (set-cell acc r (+ left c) v)\n                           acc))))))))))",
