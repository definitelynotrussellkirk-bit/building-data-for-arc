  "description_target": {
    "ambiguity_notes": "A frame is a complete 4-connected yellow hollow rectangle. The condition is exactly one distinct interior marker color, not exactly one marker cell: repeated cells of the same color still license filling. Empty and multicolor frames remain unchanged.",
    "generator_parameters": [
      "scene_profile"
    ],
    "input_modalities": [
      "task_image",
      "samples"
    ],
    "negative_constraints": [
      "Do not treat incomplete or nonrectangular yellow components as frames.",
      "Do not fill a frame whose interior is empty or contains multiple distinct marker colors.",
      "Do not overwrite marker cells, yellow cells, frame borders, or content outside frames.",
      "Do not couple the decision for one frame to the contents of another frame."
    ],
    "puzzle_concepts": [
      "object detection",
      "hollow rectangle",
      "bounding-box interior",
      "per-object conditional fill",
      "color uniqueness"
    ],
    "semantic_primitives": [
      "objects",
      "obj-bbox",
      "obj-cells",
      "bbox-interior-cells",
      "at",
      "set-cell"
    ],
    "solution_steps": [
      "Find each 4-connected yellow component that exactly equals the border of a rectangle at least three cells tall and wide.",
      "Inspect the original cells strictly inside each qualifying frame and collect distinct colors other than 0 and 4.",
      "If that set contains exactly one color, replace every zero interior cell with that color while preserving all other cells.",
      "Evaluate all qualifying frames independently and leave every nonqualifying object unchanged."
    ],
    "source": "canonical.program_solution and canonical.written_solution",
    "target_status": "canonical_rule_expanded",
    "target_text": "For each complete 4-connected yellow (4) hollow rectangular frame, independently inspect its interior. If the interior contains exactly one distinct color other than background (0) and yellow, fill only its zero-valued interior cells with that color. Repeated markers of that one color are allowed; empty frames, multicolor frames, incomplete yellow shapes, existing nonzero cells, and outside distractors remain unchanged."
  },
