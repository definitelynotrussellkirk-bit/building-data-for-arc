    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  ;; A color-5 rectangular frame carries paired markers ON its border: a color sitting at BOTH\n  ;; ends of an interior row (its left AND right border cell) fills that row inside the frame;\n  ;; likewise a color at both top AND bottom of a column fills that column. Colors paint in\n  ;; ASCENDING order (columns then rows within each color), so crossings resolve to the highest\n  ;; color deterministically.\n  (let* ((b (bbox-of-cells (find-color g 5)))\n         (r1 (first b)) (c1 (second b)) (r2 (third b)) (c2 (fourth b))\n         (border (append (map (lambda (r) (at g r c1)) (range r1 (+ r2 1)))\n                         (map (lambda (r) (at g r c2)) (range r1 (+ r2 1)))\n                         (map (lambda (c) (at g r1 c)) (range c1 (+ c2 1)))\n                         (map (lambda (c) (at g r2 c)) (range c1 (+ c2 1)))))\n         (colors (sort (filter (lambda (v) (and (!= v 0) (!= v 5))) (unique border)) <)))\n    (for/fold ((out g)) ((color colors))\n      (let* ((after-cols\n              (for/fold ((acc out)) ((c (range (+ c1 1) c2)))\n                (if (and (= (at g r1 c) color) (= (at g r2 c) color))\n                    (recolor-cells acc (map (lambda (r) (list r c)) (range (+ r1 1) r2)) color)\n                    acc))))\n        (for/fold ((acc after-cols)) ((r (range (+ r1 1) r2)))\n          (if (and (= (at g r c1) color) (= (at g r c2) color))\n              (recolor-cells acc (map (lambda (c) (list r c)) (range (+ c1 1) c2)) color)\n              acc)))))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n  ;; A color-5 rectangular frame carries paired markers ON its border: a color sitting at BOTH\n  ;; ends of an interior row (its left AND right border cell) fills that row inside the frame;\n  ;; likewise a color at both top AND bottom of a column fills that column. Colors paint in\n  ;; ASCENDING order (columns then rows within each color), so crossings resolve to the highest\n  ;; color deterministically.\n  (let* ((b (bbox-of-cells (find-color g 5)))\n         (r1 (first b)) (c1 (second b)) (r2 (third b)) (c2 (fourth b))\n         (border (append (map (lambda (r) (at g r c1)) (range r1 (+ r2 1)))\n                         (map (lambda (r) (at g r c2)) (range r1 (+ r2 1)))\n                         (map (lambda (c) (at g r1 c)) (range c1 (+ c2 1)))\n                         (map (lambda (c) (at g r2 c)) (range c1 (+ c2 1)))))\n         (colors (sort (filter (lambda (v) (and (!= v 0) (!= v 5))) (unique border)) <)))\n    (for/fold ((out g)) ((color colors))\n      (let* ((after-cols\n              (for/fold ((acc out)) ((c (range (+ c1 1) c2)))\n                (if (and (= (at g r1 c) color) (= (at g r2 c) color))\n                    (recolor-cells acc (map (lambda (r) (list r c)) (range (+ r1 1) r2)) color)\n                    acc))))\n        (for/fold ((acc after-cols)) ((r (range (+ r1 1) r2)))\n          (if (and (= (at g r c1) color) (= (at g r c2) color))\n              (recolor-cells acc (map (lambda (c) (list r c)) (range (+ c1 1) c2)) color)\n              acc)))))))",
