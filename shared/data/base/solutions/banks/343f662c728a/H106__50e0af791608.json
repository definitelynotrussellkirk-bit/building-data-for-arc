    "solution_steps": [
      "Locate the unique red start and green goal.",
      "Run cardinal breadth-first search from red while treating gray cells as blocked.",
      "Run the same distance search from green.",
      "Select every zero cell whose two distances sum to the optimal red-to-green distance.",
      "Recolor exactly those cells cyan and preserve markers, walls, and longer-detour zeros."
    ],
    "source": "canonical written solution and executable program",
    "target_status": "verified_semantic_rule",
    "target_text": "Treat gray(5) cells as walls. Between the start marker red(2) and the goal marker green(3), mark every empty cell that belongs to at least one shortest path with cyan(8)."
  },
