    "needs_conversion": false,
    "raw_code": "(rule!\n  (let* ((pivot (first (find-color g 8)))\n         (cells (filter-cells g (lambda (r c v) (and (not (= v 0)) (not (= v 8))))))\n         (color (at g (first (first cells)) (second (first cells)))))\n    (define (rotate-one p)\n      (let ((dr (- (first p) (first pivot)))\n            (dc (- (second p) (second pivot))))\n        (list (+ (first pivot) dc) (- (second pivot) dr))))\n    (paint-cells\n      (paint-cells (empty-grid (rows g) (cols g) 0) (list pivot) 8)\n      (map rotate-one cells)\n      color)))",
    "solution_language": "racket",
    "target_code": "(rule!\n  ;; The unique 8 cell is the fixed pivot; the task grammar has one other color.\n  (let* ((pivot (first (find-color g 8)))\n         (cells (filter-cells g\n                  (lambda (r c v) (and (not (= v 0)) (not (= v 8))))))\n         (color (at g (first (first cells)) (second (first cells)))))\n    ;; A clockwise quarter-turn maps the pivot-relative vector (dr, dc) to (dc, -dr).\n    (define (rotate-one p)\n      (let ((dr (- (first p) (first pivot)))\n            (dc (- (second p) (second pivot))))\n        (list (+ (first pivot) dc) (- (second pivot) dr))))\n    ;; Rebuild the scene from background so the old foreground positions are cleared.\n    (paint-cells\n      (paint-cells (empty-grid (rows g) (cols g) 0) (list pivot) 8)\n      (map rotate-one cells)\n      color)))",
    "target_status": "verified_racket_available",
