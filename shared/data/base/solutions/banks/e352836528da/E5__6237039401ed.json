    "needs_conversion": false,
    "raw_code": "(rule!\n  (let* ()\n    (define (solid-2x2-at? r0 c0)\n      (and (>= r0 0) (< r0 (- h 1))\n           (>= c0 0) (< c0 (- w 1))\n           (= (at g r0 c0) 5)\n           (= (at g (+ r0 1) c0) 5)\n           (= (at g r0 (+ c0 1)) 5)\n           (= (at g (+ r0 1) (+ c0 1)) 5)))\n    (define (inside-solid-square? r c)\n      (any? (lambda (p) (solid-2x2-at? (first p) (second p)))\n            (list (list r c)\n                  (list (- r 1) c)\n                  (list r (- c 1))\n                  (list (- r 1) (- c 1)))))\n    (cellmap g (r c v)\n      (if (and (= v 5) (inside-solid-square? r c)) 1 v))))",
    "solution_language": "racket",
