    "raw_code": "(rule!\n  (let ((dummy 0))\n\n    (define (cell< a b)\n      (if (= (first a) (first b)) (< (second a) (second b)) (< (first a) (first b))))\n    (define (nonzero-cells grid)\n      (filter (lambda (cell) (not (= (third cell) 0))) (grid-cells grid)))\n    (define (obj-grid obj)\n      (let* ((r0 (obj-r1 obj)) (c0 (obj-c1 obj)))\n        (paint-cells (empty-grid (obj-h obj) (obj-w obj) 0)\n                     (map (lambda (p) (list (- (first p) r0) (- (second p) c0))) (obj-cells obj))\n                     (obj-color obj))))\n    (define (mask-grid obj)\n      (map-grid (obj-grid obj) (lambda (r c v) (if (= v 0) 0 1))))\n    (define (rot270 grid) (rotate-cw (rotate-180 grid)))\n    (define (transform-key grid key)\n      (cond [(= key 1) (rotate-cw grid)]\n            [(= key 2) (rotate-180 grid)]\n            [(= key 3) (rot270 grid)]\n            [(= key 4) (flip-lr grid)]\n            [else grid]))\n    (define (place-transparent out sub top left)\n      (for*/fold ([acc out])\n                 ([r (in-range (rows sub))]\n                  [c (in-range (cols sub))])\n        (let ((v (at sub r c)) (rr (+ top r)) (cc (+ left c)))\n          (if (and (not (= v 0)) (in-bounds? rr cc (rows out) (cols out)))\n              (set-cell acc rr cc v)\n              acc))))\n    (define (gallery-top grids)\n      (let* ((h (if (empty? grids) 1 (apply max (map rows grids))))\n             (w (if (empty? grids) 1 (+ (apply + (map cols grids)) (max 0 (- (length grids) 1))))))\n        (let loop ([remaining grids] [left 0] [out (empty-grid h w 0)])\n          (if (empty? remaining)\n              out\n              (let ((piece (first remaining)))\n                (loop (rest remaining) (+ left (cols piece) 1) (place-transparent out piece 0 left)))))))\n    (define (bbox-perimeter obj)\n      (* 2 (+ (obj-h obj) (obj-w obj))))\n    (define (rect-frame? obj)\n      (and (>= (obj-h obj) 3)\n           (>= (obj-w obj) 3)\n           (= (obj-size obj) (- (* 2 (+ (obj-h obj) (obj-w obj))) 4))\n           (all? (lambda (p)\n                   (or (= (first p) (obj-r1 obj))\n                       (= (first p) (obj-r2 obj))\n                       (= (second p) (obj-c1 obj))\n                       (= (second p) (obj-c2 obj))))\n                 (obj-cells obj))))\n    (define (grid-hsym? grid) (equal? grid (flip-lr grid)))\n    (define (grid-vsym? grid) (equal? grid (flip-ud grid)))\n    (define (mask-crop cells)\n      (if (empty? cells)\n          (grid (list 0))\n          (let* ((bb (bbox-of-cells cells))\n                 (r0 (first bb)) (c0 (second bb))\n                 (h (+ 1 (- (third bb) r0)))\n                 (w (+ 1 (- (fourth bb) c0))))\n            (paint-cells (empty-grid h w 0)\n                         (map (lambda (p) (list (- (first p) r0) (- (second p) c0))) cells)\n                         1))))\n    (define (touching? a b)\n      (any? (lambda (p)\n              (any? (lambda (d) (member? (list (+ (first p) (first d)) (+ (second p) (second d))) (obj-cells b)))\n                    cardinal-deltas))\n            (obj-cells a)))\n\n    (for/fold ([out g]) ([r (in-range (rows g))])\n      (for/fold ([acc out]) ([color (in-list (grid-colors g 0))])\n        (let ((cols-hit (filter (lambda (c) (= (at g r c) color)) (range 0 (cols g)))))\n          (if (and (= (length cols-hit) 2)\n                   (all? (lambda (c) (= (at g r c) 0)) (range (+ (first cols-hit) 1) (second cols-hit))))\n              (paint-cells acc (for/list ([c (in-range (first cols-hit) (+ (second cols-hit) 1))]) (list r c)) color)\n              acc))))\n  ))",
