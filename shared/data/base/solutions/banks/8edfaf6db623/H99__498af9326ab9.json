    "solution_steps": [
      "Locate the unique blue start and red goal.",
      "Run cardinal breadth-first search from the start while treating gray cells as blocked.",
      "Run the same distance search from the goal.",
      "For each zero cell, test whether its two distances sum to the optimal start-to-goal distance.",
      "Recolor exactly those zero cells cyan and preserve every other input cell."
    ],
    "source": "canonical written solution and executable program",
    "target_status": "verified_semantic_rule",
    "target_text": "Treat gray(5) as walls, blue(1) as the start, and red(2) as the goal. Mark every empty cell that lies on at least one shortest path from start to goal with cyan(8)."
  },
