    "needs_conversion": false,
    "raw_code": "(rule!\n  (let* ((start (first (find-color g 1)))\n         (goal (first (find-color g 2))))\n    (define (dist-from start)\n      (define dist (make-hash))\n      (define queue (list (cons (first start) (second start))))\n      (hash-set! dist (first queue) 0)\n      (let bfs ([fuel 0])\n        (unless (empty? queue)\n          (let ((cur (first queue)))\n            (set! queue (rest queue))\n            (for ([d (in-list cardinal-deltas)])\n              (let ((nr (+ (car cur) (first d))) (nc (+ (cdr cur) (second d))))\n                (when (and (in-bounds? nr nc (rows g) (cols g))\n                           (not (= (at g nr nc) 5))\n                           (not (hash-has-key? dist (cons nr nc))))\n                  (hash-set! dist (cons nr nc) (+ (hash-ref dist cur) 1))\n                  (set! queue (append queue (list (cons nr nc))))))))\n          (bfs (+ fuel 1))))\n      dist)\n    (define ds (dist-from start))\n    (define dg (dist-from goal))\n    (define D (hash-ref ds (cons (first goal) (second goal)) 999999))\n    (grid-from-fn (rows g) (cols g)\n      (lambda (r c)\n        (if (and (= (at g r c) 0)\n                 (< D 999999)\n                 (hash-has-key? ds (cons r c))\n                 (hash-has-key? dg (cons r c))\n                 (= (+ (hash-ref ds (cons r c)) (hash-ref dg (cons r c))) D))\n            8\n            (at g r c))))))",
    "solution_language": "racket",
    "target_code": "(rule!\n  (let* ((start (first (find-color g 1)))\n         (goal (first (find-color g 2))))\n    (define (dist-from start)\n      (define dist (make-hash))\n      (define queue (list (cons (first start) (second start))))\n      (hash-set! dist (first queue) 0)\n      (let bfs ([fuel 0])\n        (unless (empty? queue)\n          (let ((cur (first queue)))\n            (set! queue (rest queue))\n            (for ([d (in-list cardinal-deltas)])\n              (let ((nr (+ (car cur) (first d))) (nc (+ (cdr cur) (second d))))\n                (when (and (in-bounds? nr nc (rows g) (cols g))\n                           (not (= (at g nr nc) 5))\n                           (not (hash-has-key? dist (cons nr nc))))\n                  (hash-set! dist (cons nr nc) (+ (hash-ref dist cur) 1))\n                  (set! queue (append queue (list (cons nr nc))))))))\n          (bfs (+ fuel 1))))\n      dist)\n    (define ds (dist-from start))\n    (define dg (dist-from goal))\n    (define D (hash-ref ds (cons (first goal) (second goal)) 999999))\n    (grid-from-fn (rows g) (cols g)\n      (lambda (r c)\n        (if (and (= (at g r c) 0)\n                 (< D 999999)\n                 (hash-has-key? ds (cons r c))\n                 (hash-has-key? dg (cons r c))\n                 (= (+ (hash-ref ds (cons r c)) (hash-ref dg (cons r c))) D))\n            8\n            (at g r c))))))",
