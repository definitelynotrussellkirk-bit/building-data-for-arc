    "raw_code": "(rule!\n  (reduce (lambda (out obj)\n    (if (not (= (obj-color obj) 7)) out\n      (let* ((cells (obj-cells obj))\n             (touch-top (any? (lambda (p) (= (fst p) 0)) cells))\n             (touch-left (any? (lambda (p) (= (snd p) 0)) cells)))\n        (if (and touch-top touch-left)\n          (recolor-cells out cells 8)\n          out))))\n    g (objects g 0)))",
