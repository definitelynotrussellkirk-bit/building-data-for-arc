  "description_target": {
    "ambiguity_notes": "Objects are monochrome four-connected components over background zero. The qualifying orange component need not contain the upper-left cell: a connected path may touch the top and left borders at different cells. Every qualifying color-7 component is recolored, while top-only, left-only, interior orange components and non-orange distractors are preserved.",
    "generator_parameters": [
      "scene_profile"
    ],
    "input_modalities": [
      "task_image",
      "samples"
    ],
    "negative_constraints": [
      "do not recolor every orange component",
      "do not select a component that touches only the top or only the left border",
      "do not use component size, distance, or the upper-left cell alone as the criterion",
      "do not recolor non-orange distractors",
      "do not merge diagonally adjacent orange cells into one four-connected component"
    ],
    "puzzle_concepts": [
      "four-connected monochrome components",
      "conjunctive border contact",
      "component selection",
      "selective recoloring",
      "distractor preservation"
    ],
    "semantic_primitives": [
      "objects",
      "obj-color",
      "obj-cells",
      "any?",
      "recolor-cells"
    ],
    "solution_steps": [
      "extract all non-background four-connected monochrome components",
      "ignore every component whose color is not orange 7",
      "test whether an orange component contains at least one top-row cell and at least one left-column cell",
      "recolor every orange component satisfying both border tests to cyan 8",
      "preserve every other orange component, non-orange distractor, and background cell"
    ],
