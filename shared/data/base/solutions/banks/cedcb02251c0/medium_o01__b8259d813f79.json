  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Collapse each object to a single cell of its color at its bbox CENTER.\n (for/fold ((out (empty-grid h w 0))) ((obj (in-list (objects g 0))))\n   (set-cell out\n             (quotient (+ (obj-r1 obj) (obj-r2 obj)) 2)\n             (quotient (+ (obj-c1 obj) (obj-c2 obj)) 2)\n             (obj-color obj))))",
