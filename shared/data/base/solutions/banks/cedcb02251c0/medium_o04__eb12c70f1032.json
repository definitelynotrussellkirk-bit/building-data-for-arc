  "description_target": {
    "ambiguity_notes": "All official scenes have distinct left edges, but the executable comparator resolves equal left edges by top row and exact origin ties by numeric color. The generated tie profiles test those explicit branches without changing the official area-to-bar convention.",
    "generator_parameters": [
      "object count",
