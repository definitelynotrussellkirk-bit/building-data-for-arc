    "needs_conversion": false,
    "raw_code": "(rule!\n  (let* ((objs (sort (objects g 0)\n                     (lambda (a b)\n                       (cond [(< (obj-c1 a) (obj-c1 b)) #t]\n                             [(> (obj-c1 a) (obj-c1 b)) #f]\n                             [(< (obj-r1 a) (obj-r1 b)) #t]\n                             [(> (obj-r1 a) (obj-r1 b)) #f]\n                             [else (< (obj-color a) (obj-color b))]))))\n         (height (apply max (map obj-size objs)))\n         (width (- (* 2 (length objs)) 1)))\n    (for/fold ([out (empty-grid height width 0)])\n              ([obj (in-list objs)]\n               [i (in-naturals 0)])\n      (paint-cells out\n                   (for/list ([r (in-range (- height (obj-size obj)) height)])\n                     (list r (* 2 i)))\n                   (obj-color obj)))))",
    "solution_language": "racket",
