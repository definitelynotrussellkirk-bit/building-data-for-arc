    ],
    "negative_constraints": [
      "Do not merge cardinally touching objects of different colors; object extraction is same-color.",
      "Do not use bounding-box area, perimeter, or height in place of the object cell count.",
      "Do not sort primarily by area or color; color is only the final tie-breaker after left and top edges.",
      "Do not top-align or center bars; every bar touches the bottom output row.",
      "Do not paint the odd separator columns."
    ],
    "puzzle_concepts": [
