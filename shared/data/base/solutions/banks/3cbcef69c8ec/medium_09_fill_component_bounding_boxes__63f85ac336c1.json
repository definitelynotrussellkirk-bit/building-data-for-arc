  "raw_code": "(rule!\n ;; Fill each yellow(4) object's bbox solid yellow.\n (for/fold ((out g)) ((obj (in-list (filter (lambda (o) (= (obj-color o) 4))\n                                            (objects g 0)))))\n   (let ((bb (obj-bbox obj)))\n     (paint-cells out\n                  (positions-in-rect (first bb) (second bb)\n                                     (third bb) (fourth bb))\n                  4))))",
