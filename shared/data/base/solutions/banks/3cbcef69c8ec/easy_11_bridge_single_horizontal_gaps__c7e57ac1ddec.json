  "raw_code": "(rule!\n ;; Fill each single-cell GAP between two horizontal red(2)s with orange(7).\n (for*/fold ((out g)) ((r (in-range h)) (c (in-range (- w 2))))\n   (if (and (= (at g r c) 2) (= (at g r (+ c 1)) 0) (= (at g r (+ c 2)) 2))\n       (set-cell out r (+ c 1) 7)\n       out)))",
