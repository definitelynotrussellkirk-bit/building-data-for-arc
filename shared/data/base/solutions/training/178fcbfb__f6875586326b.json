    "needs_conversion": false,
    "raw_code": "(rule!\n ;; alt: first paint marked rows, then overlay color-2 columns only where row-color is absent.\n (lambda (g)\n   (let* ((h (rows g))\n          (w (cols g)))\n     (define (row-color r)\n       (find-first (lambda (v) (or (= v 1) (= v 3)))\n                   (map (lambda (c) (at g r c)) (range 0 w))))\n     (define (col-has-2? c)\n       (any? (lambda (r) (= 2 (at g r c))) (range 0 h)))\n     (cellmap g (r c _)\n       (or (row-color r)\n           (and (col-has-2? c) 2)\n           0)))))",
    "solution_language": "racket",
