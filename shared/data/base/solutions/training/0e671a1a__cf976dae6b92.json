    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  ;; Preserve the canonical cellmap structure so the selected task rule and\n  ;; canonical program execute the same source-level operation. This archival\n  ;; copy keeps explanatory comments rather than stripping them for sync.\n  (let* ((h (rows g))\n         (w (cols g)))\n    (let* (;; Locate the ordered marker sequence 2 -> 4 -> 3.\n           (p2 (first (find-color g 2)))\n           (p4 (first (find-color g 4)))\n           (p3 (first (find-color g 3)))\n           (r2 (fst p2)) (c2 (snd p2))\n           (r4 (fst p4)) (c4 (snd p4))\n           (r3 (fst p3)) (c3 (snd p3)))\n      ;; For each connection, route horizontally from its source marker and\n      ;; then vertically into its destination marker. Marker clauses come\n      ;; first so the path never overwrites colors 2, 4, or 3.\n      (cellmap g (r c v)\n        (cond\n          ((and (= r r2) (= c c2)) 2)\n          ((and (= r r4) (= c c4)) 4)\n          ((and (= r r3) (= c c3)) 3)\n          ((and (= r r2) (>= c (min c2 c4)) (<= c (max c2 c4))) 5)\n          ((and (= c c4) (>= r (min r2 r4)) (<= r (max r2 r4))) 5)\n          ((and (= r r4) (>= c (min c4 c3)) (<= c (max c4 c3))) 5)\n          ((and (= c c3) (>= r (min r4 r3)) (<= r (max r4 r3))) 5)\n          (else 0)))))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g) (let* ((h (rows g)) (w (cols g))) (let* ((p2 (first (find-color g 2))) (p4 (first (find-color g 4))) (p3 (first (find-color g 3))) (r2 (fst p2)) (c2 (snd p2)) (r4 (fst p4)) (c4 (snd p4)) (r3 (fst p3)) (c3 (snd p3))) (cellmap g (r c v) (cond ((and (= r r2) (= c c2)) 2) ((and (= r r4) (= c c4)) 4) ((and (= r r3) (= c c3)) 3) ((and (= r r2) (>= c (min c2 c4)) (<= c (max c2 c4))) 5) ((and (= c c4) (>= r (min r2 r4)) (<= r (max r2 r4))) 5) ((and (= r r4) (>= c (min c4 c3)) (<= c (max c4 c3))) 5) ((and (= c c3) (>= r (min r4 r3)) (<= r (max r4 r3))) 5) (else 0)))))))",
