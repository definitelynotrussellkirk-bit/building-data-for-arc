  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Cyan(8) marks on the top row drop as pipes down the grid. A red(2)\n ;; bar row interrupts them: inside each red segment, every pipe keeps\n ;; the red cell it crosses and clears everything below it; walls rise\n ;; one column outside a pierced segment's ends, joined to the\n ;; outermost pipes by cap runs one row above the bar.\n (lambda (g)\n   (let ()\n     (define eight-cols\n       (filter (lambda (c) (= (at g 0 c) 8)) (range 0 w)))\n     (define two-row\n       (find-first (lambda (r) (any? (lambda (c) (= (at g r c) 2))\n                                     (range 0 w)))\n                   (range 0 h)))\n     (define bar-row (- two-row 1))\n     (define segments  ;; maximal red runs on the bar row: (start end)\n       (let loop ((c 0) (acc (list)))\n         (cond ((>= c w) (reverse acc))\n               ((not (= (at g two-row c) 2)) (loop (+ c 1) acc))\n               (else (let scan ((cc c))\n                       (if (or (>= cc w) (not (= (at g two-row cc) 2)))\n                           (loop cc (cons (list c (- cc 1)) acc))\n                           (scan (+ cc 1))))))))\n     (define (vline out c r0)  ;; cyan column from r0 to the floor\n       (recolor-cells out (map (lambda (r) (list r c)) (range r0 h))\n                      8))\n     (define (do-segment out seg)\n       (let* ((l2 (first seg)) (r2 (second seg))\n              (seg8 (filter (lambda (c) (and (>= c l2) (<= c r2)))\n                            eight-cols))\n              (has-left (and (not (null? seg8))\n                             (= (min-list seg8) l2)))\n              (has-right (and (not (null? seg8))\n                              (any? (lambda (c) (> c l2)) seg8)))\n              (out1 (if has-left  ;; left wall + cap to first pipe\n                        (recolor-cells\n                         (vline out (- l2 1) bar-row)\n                         (map (lambda (c) (list bar-row c))\n                              (range (- l2 1) (+ (min-list seg8) 1)))\n                         8)\n                        out))\n              (out2 (if has-right  ;; right wall + cap from last pipe\n                        (recolor-cells\n                         (vline out1 (+ r2 1) bar-row)\n                         (map (lambda (c) (list bar-row c))\n                              (range (max-list seg8) (+ r2 2)))\n                         8)\n                        out1))\n              (out3 (for/fold ((o out2)) ((c seg8))  ;; pierce the bar\n                      (recolor-cells (set-cell o two-row c 2)\n                                     (map (lambda (r) (list r c))\n                                          (range (+ two-row 1) h))\n                                     0))))\n         (for/fold ((o out3)) ((c (range l2 (+ r2 1))))\n           (if (= (at g two-row c) 2)\n               (set-cell o two-row c 2)\n               o))))\n     (for/fold ((out (for/fold ((o g)) ((c eight-cols))\n                       (vline o c bar-row))))\n               ((seg segments))\n       (do-segment out seg)))))",
