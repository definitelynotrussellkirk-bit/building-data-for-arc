    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (define h (rows g))\n  (define w (cols g))\n  (define r-pos (first (find-color g 2)))\n  (define g-pos (first (find-color g 3)))\n  (define rr (first r-pos)) (define rc (second r-pos))\n  (define gr (first g-pos)) (define gc (second g-pos))\n  ;; Horizontal from (rr, rc) to (rr, gc), exclusive of both endpoints\n  ;; Vertical from (rr, gc) to (gr, gc), exclusive of (gr, gc) but including (rr, gc)\n  (define cmin (min rc gc))\n  (define cmax (max rc gc))\n  (define rmin (min rr gr))\n  (define rmax (max rr gr))\n  (define gg\n    (reduce (lambda (gx c)\n              (if (= c rc) gx (set-cell gx rr c 8)))\n            g (range cmin (+ cmax 1))))\n  (reduce (lambda (gx r)\n            (if (= r gr) gx (set-cell gx r gc 8)))\n          gg (range rmin (+ rmax 1)))))",
    "solution_language": "racket",
    "target_code": "(rule!\n (lambda (g)\n   ;; Red is the start and green is the destination.  The elbow belongs on\n   ;; red's row and green's column, so the horizontal arm is drawn first.\n   (define red (first (find-color g 2)))\n   (define green (first (find-color g 3)))\n   (define rr (first red))\n   (define rc (second red))\n   (define gr (first green))\n   (define gc (second green))\n   (define cmin (min rc gc))\n   (define cmax (max rc gc))\n   (define rmin (min rr gr))\n   (define rmax (max rr gr))\n   ;; Paint the horizontal arm while preserving the red endpoint.\n   (define with-row\n     (reduce (lambda (out c)\n               (if (= c rc) out (set-cell out rr c 8)))\n             g\n             (range cmin (+ cmax 1))))\n   ;; Paint the vertical arm while preserving the green endpoint.\n   (reduce (lambda (out r)\n             (if (= r gr) out (set-cell out r gc 8)))\n           with-row\n           (range rmin (+ rmax 1)))))",
    "target_status": "verified_racket_available"
  },
