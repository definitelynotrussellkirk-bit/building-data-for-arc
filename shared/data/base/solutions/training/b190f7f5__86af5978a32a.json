    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         (horizontal (>= w h))\n         (half-h (if horizontal h (quotient h 2)))\n         (half-w (if horizontal (quotient w 2) w))\n         (first-cells\n          (for*/list ((r (range 0 half-h))\n                      (c (range 0 half-w))\n                      #:when (not (= (cell-at g r c) 0)))\n            (list r c (cell-at g r c))))\n         (second-r1 (if horizontal 0 half-h))\n         (second-c1 (if horizontal half-w 0))\n         (second-cells\n          (for*/list ((r (range second-r1 h))\n                      (c (range second-c1 w))\n                      #:when (not (= (cell-at g r c) 0)))\n            (list (- r second-r1) (- c second-c1) (cell-at g r c))))\n         (first-colors (remove-duplicates (map third first-cells)))\n         (second-colors (remove-duplicates (map third second-cells)))\n         ;; Layout has more colors; block-shape has fewer\n         (layout-first (> (length first-colors) (length second-colors)))\n         (layout-cells (if layout-first first-cells second-cells))\n         (shape-cells (if layout-first second-cells first-cells))\n         ;; Normalize shape cells (remove color, keep positions)\n         (shape-positions (map (lambda (c) (list (first c) (second c))) shape-cells))\n         (out-h (* half-h half-h))\n         (out-w (* half-w half-w))\n         (base (grid-from-fn out-h out-w (lambda (r c) 0))))\n    (for/fold ((out base)) ((m layout-cells))\n      (let ((mr (first m))\n            (mc (second m))\n            (col (third m)))\n        (for/fold ((o out)) ((sp shape-positions))\n          (set-cell o (+ (* mr half-h) (first sp)) (+ (* mc half-w) (second sp)) col)))))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (let* ((horizontal (>= w h))\n                  (half-h (if horizontal h (quotient h 2)))\n                  (half-w (if horizontal (quotient w 2) w))\n                  (first-cells (for*/list ((r (range 0 half-h)) (c (range 0 half-w))\n                                   #:when\n                                   (!= (at g r c) 0))\n                                 (list r c (at g r c))))\n                  (second-r1 (if horizontal 0 half-h))\n                  (second-c1 (if horizontal half-w 0))\n                  (second-cells (for*/list ((r (range second-r1 h)) (c (range second-c1 w))\n                                    #:when\n                                    (!= (at g r c) 0))\n                                  (list (- r second-r1) (- c second-c1) (at g r c))))\n                  (first-colors (remove-duplicates (map third first-cells)))\n                  (second-colors (remove-duplicates (map third second-cells)))\n                  (layout-first (> (length first-colors) (length second-colors)))\n                  (layout-cells (if layout-first first-cells second-cells))\n                  (shape-cells (if layout-first second-cells first-cells))\n                  (shape-positions (map (lambda (c) (list (first c) (second c)))\n                                        shape-cells))\n                  (out-h (* half-h half-h))\n                  (out-w (* half-w half-w))\n                  (base (build-grid out-h out-w (r c) 0)))\n             (for/fold ((out base))\n               ((m layout-cells))\n               (let ((mr (first m))\n                     (mc (second m))\n                     (col (third m)))\n                 (for/fold ((o out))\n                   ((sp shape-positions))\n                   (set-cell o\n                             (+ (* mr half-h) (first sp))\n                             (+ (* mc half-w) (second sp))\n   