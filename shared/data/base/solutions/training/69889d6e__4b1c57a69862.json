    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((hh (rows g)) (ww (cols g))\n         (red-r #f) (red-c #f)\n         (blue-map (make-hash))\n         (dummy-find (for* ((r (range 0 hh)) (c (range 0 ww)))\n           (cond ((= (cell-at g r c) 2) (set! red-r r) (set! red-c c))\n                 ((= (cell-at g r c) 1)\n                  (hash-set! blue-map r\n                    (cons c (hash-ref blue-map r (list))))))))\n         (result (make-hash))\n         (dummy-init (for* ((r (range 0 hh)) (c (range 0 ww)))\n           (hash-set! result (list r c) (cell-at g r c))))\n         ;; Determine left col at each row, shifting past blues\n         (left-cols (make-hash))\n         (cl red-c)\n         (min-row (let process ((row (- red-r 1)))\n           (if (or (< row 0) (>= cl ww))\n             (+ row 1)\n             (begin\n               (let ((blues (hash-ref blue-map row (list))))\n                 (let shift-loop ((dummy #t))\n                   (when (or (member cl blues) (member (+ cl 1) blues))\n                     (set! cl (+ 1 (apply max (filter (lambda (bc) (or (= bc cl) (= bc (+ cl 1)))) blues))))\n                     (shift-loop #f))))\n               (hash-set! left-cols row cl)\n               (set! cl (+ cl 1))\n               (process (- row 1))))))\n         ;; Place cells with bridges at shift points\n         (prev-cl red-c)\n         (dummy-place (let place-rows ((row (- red-r 1)))\n           (when (and (>= row 0) (hash-has-key? left-cols row))\n             (let ((cl-here (hash-ref left-cols row)))\n               (when (> cl-here (+ prev-cl 1))\n                 (let ((bridge-row (+ row 1)))\n                   (for ((c (range (+ prev-cl 1) (+ cl-here 1))))\n                     (when (and (>= c 0) (< c ww)\n                                (= (hash-ref result (list bridge-row c) 0) 0))\n                       (hash-set! result (list bridge-row c) 2)))))\n               (when (< cl-here ww)\n                 (hash-set! result (list row cl-here) 2))\n               (when (< (+ cl-here 1) ww)\n                 (hash-set! result (list row (+ cl-here 1)) 2))\n               (set! prev-cl cl-here)\n               (place-rows (- row 1)))))))\n    (grid-from-fn hh ww (lambda (r c) (hash-ref result (list r c) 0))))))",
    "solution_language": "racket",
    "target_code": "(rule!\n ;; A bottom-row red seed grows a two-cell-wide staircase up and right.\n ;; Blue cells matter only when they occupy either prospective step cell:\n ;; skip to the first column beyond that blocker run, then bridge the shift\n ;; horizontally on the row below. Off-path blue cells remain unchanged.\n (lambda (g)\n   (let* ((hh (rows g))\n          (ww (cols g))\n          (red-r #f)\n          (red-c #f)\n          (blue-map (make-hash))\n          (scan-input\n           (for* ((r (range 0 hh)) (c (range 0 ww)))\n             (cond\n               ((= (at g r c) 2)\n                (set! red-r r)\n                (set! red-c c))\n               ((= (at g r c) 1)\n                (hash-set! blue-map r\n                  (cons c (hash-ref blue-map r (list))))))))\n          (result (make-hash))\n          (copy-input\n           (for* ((r (range 0 hh)) (c (range 0 ww)))\n             (hash-set! result (list r c) (at g r c))))\n          (left-cols (make-hash))\n          (cl red-c)\n          ;; First determine the left column of every reachable step.\n          (trace-path\n           (let process ((row (- red-r 1)))\n             (if (or (< row 0) (>= cl ww))\n                 (+ row 1)\n                 (begin\n                   (let ((blues (hash-ref blue-map row (list))))\n                     (let shift-past-run ((again #t))\n                       (when (or (member cl blues) (member (+ cl 1) blues))\n                         (set! cl\n                           (+ 1\n                              (max-list\n                               (filter\n                                (lambda (bc)\n                                  (or (= bc cl) (= bc (+ cl 1))))\n                                blues))))\n                         (shift-past-run #f))))\n                   (hash-set! left-cols row cl)\n                   (set! cl (+ cl 1))\n                   (process (- row 1))))))\n          (prev-cl red-c)\n          ;; Paint each two-cell step, adding a bridge only after a deflection.\n          (paint-path\n           (let paint-row ((row (- red-r 1)))\n             (when (and (>= row 0) (hash-has-key? left-cols row))\n               (let ((cl-here (hash-ref left-cols row)))\n                 (when (> cl-here (+ prev-cl 1))\n                   (let ((bridge-row (+ row 1)))\n                     (for ((c (range (+ prev-cl 1) (+ cl-here 1))))\n                       (when (and (>= c 0)\n                                  (< c ww)\n                                  (zero? (hash-ref result\n                                                   (list bridge-row c)\n                                                   0)))\n                         (hash-set! result (list bridge-row c) 2)))))\n                 (when (< cl-here ww)\n                   (hash-set! result (list row cl-here) 2))\n                 (when (< (+ cl-here 1) ww)\n                   (hash-set! result (list row (+ cl-here 1)) 2))\n                 (set! prev-cl cl-here)\n                 (paint-row (- row 1)))))))\n     (build-grid hh ww (r c)\n       (hash-ref result (list r c) 0)))))",
