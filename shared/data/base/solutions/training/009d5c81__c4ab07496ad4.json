  "raw_code": "(rule! (lambda (g)\n  (let* ((objs (objects-8 g 0))\n         (sorted (sort-by objs (lambda (o) (obj-size o))))\n         (small (first sorted))\n         (big (nth sorted (- (length sorted) 1))))\n    (with-bbox small (sr1 sc1 sr2 sc2)\n      (let* ((is-plus (= (obj-size small) 5))\n             (bot-full (and (member (list sr2 sc1) (obj-cells small))\n                            (member (list sr2 sc2) (obj-cells small))))\n             (new-color (cond (is-plus 2) (bot-full 3) (else 7))))\n        (cellmap g (r c v)\n          (if (member (list r c) (obj-cells big)) new-color 0)))))))",
