    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (cellmap g\n                    (r c v)\n                    (if (!= 5 v)\n                        v\n                        (let* ((l (if (and (> c 0) (= 5 (at g r (- c 1)))) 1 0))\n                               (ri (if (and (< c (- (cols g) 1)) (= 5 (at g r (+ c 1))))\n                                       1\n                                       0))\n                               (u (if (and (> r 0) (= 5 (at g (- r 1) c))) 1 0))\n                               (d (if (and (< r (- (rows g) 1)) (= 5 (at g (+ r 1) c)))\n                                      1\n                                      0))\n                               (h-both (and (= 1 l) (= 1 ri)))\n                               (v-both (and (= 1 u) (= 1 d))))\n                          (cond\n                            ((and h-both v-both) 2)\n                            ((and (not h-both) (not v-both)) 1)\n                            (else 4))))))))",
