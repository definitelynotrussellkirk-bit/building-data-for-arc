    ],
    "negative_constraints": [
      "Do not alter non-5 cells.",
      "Do not infer a bounding box and recolor it wholesale.",
      "Do not count diagonal neighbors."
    ],
    "puzzle_concepts": [
      "local neighborhood classification",
      "rectangle corners edges and interiors",
      "cardinal adjacency"
    ],
    "semantic_primitives": [
      "cellmap",
      "at",
      "rows",
      "cols"
    ],
    "solution_steps": [
      "Visit every input cell and preserve it unless its value is 5.",
      "For each 5, test whether both horizontal neighbors are 5 and whether both vertical neighbors are 5, respecting grid boundaries.",
      "Write 2 when both opposing pairs exist, 1 when neither exists, and 4 otherwise."
    ],
    "source": "solvers/grounded_rules.py comment",
    "target_status": "grounded_rule_comment",
    "target_text": "Classify every color-5 cell using cardinal neighbors: write 2 when both its left/right and up/down neighbors are 5, write 1 when neither opposing pair exists, and write 4 when exactly one opposing pair exists. Preserve every non-5 cell. On solid rectangles this yields corners 1, edges 4, and interiors 2."
  },
