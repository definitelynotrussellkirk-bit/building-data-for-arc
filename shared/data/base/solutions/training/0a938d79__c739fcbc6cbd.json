    "needs_conversion": false,
    "raw_code": "(rule!\n  ;; alt: infer whether the two colored dots define alternating row bands or\n  ;;      column bands; then repeat their two phases with period 2*distance.\n  (let* ((dots (for*/list ((color (in-list (range 1 10)))\n                           (p (in-list (find-color g color))))\n                 (list (first p) (second p) color)))\n         (a (first dots))\n         (b (second dots))\n         (r1 (first a)) (c1 (second a)) (color1 (third a))\n         (r2 (first b)) (c2 (second b)) (color2 (third b))\n         (dr (abs (- r2 r1)))\n         (dc (abs (- c2 c1))))\n    (define (phase x x1 x2 period)\n      (cond ((zero? (mod (- x x1) period)) color1)\n            ((zero? (mod (- x x2) period)) color2)\n            (else 0)))\n    (if (or (zero? dc) (and (> dr 0) (< dr dc)))\n        (cellmap g (r c v)\n          (if (< r (min r1 r2)) 0 (phase r r1 r2 (* 2 dr))))\n        (cellmap g (r c v)\n          (if (< c (min c1 c2)) 0 (phase c c1 c2 (* 2 dc)))))))",
    "solution_language": "racket",
    "target_code": "(rule!\n  ;; alt: infer whether the two colored dots define alternating row bands or\n  ;;      column bands; then repeat their two phases with period 2*distance.\n  (let* ((dots (for*/list ((color (in-list (range 1 10)))\n                           (p (in-list (find-color g color))))\n                 (list (first p) (second p) color)))\n         (a (first dots))\n         (b (second dots))\n         (r1 (first a)) (c1 (second a)) (color1 (third a))\n         (r2 (first b)) (c2 (second b)) (color2 (third b))\n         (dr (abs (- r2 r1)))\n         (dc (abs (- c2 c1))))\n    (define (phase x x1 x2 period)\n      (cond ((zero? (mod (- x x1) period)) color1)\n            ((zero? (mod (- x x2) period)) color2)\n            (else 0)))\n    (if (or (zero? dc) (and (> dr 0) (< dr dc)))\n        (cellmap g (r c v)\n          (if (< r (min r1 r2)) 0 (phase r r1 r2 (* 2 dr))))\n        (cellmap g (r c v)\n          (if (< c (min c1 c2)) 0 (phase c c1 c2 (* 2 dc)))))))",
