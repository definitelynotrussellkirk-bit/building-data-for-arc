  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Hollow frames FLOAT to the top and the solid shapes SINK to the\n ;; bottom, each keeping its columns and taking the first collision-\n ;; free slot (frames placed in top-down input order, sinkers\n ;; bottom-up). Everything lands on a blank canvas.\n (lambda (g)\n   (let ()\n     (define (frame? o)\n       (let ((rim (filter (lambda (p) (or (= (first p) (obj-r1 o))\n                                          (= (first p) (obj-r2 o))\n                                          (= (second p) (obj-c1 o))\n                                          (= (second p) (obj-c2 o))))\n                          (positions-in-rect (obj-r1 o) (obj-c1 o)\n                                             (obj-r2 o) (obj-c2 o)))))\n         (and (= (obj-size o) (length rim))\n              (all? (lambda (p) (member p (obj-cells o))) rim))))\n     (define objs (objects g 0))\n     (define floaters\n       (sort (filter frame? objs)\n             (lambda (a b) (< (obj-r1 a) (obj-r1 b)))))\n     (define sinkers\n       (sort (filter (lambda (o) (not (frame? o))) objs)\n             (lambda (a b) (> (obj-r1 a) (obj-r1 b)))))\n     (define (drop state shape from step)\n       ;; state = (out occupancy); slide the shape's rows to offset t\n       (let* ((cells (obj-cells shape))\n              (r1 (obj-r1 shape))\n              (fits? (lambda (t)\n                       (all? (lambda (p)\n                               (zero? (at (second state)\n                                          (+ t (- (first p) r1))\n                                          (second p))))\n                             cells))))\n         (let loop ((t from))\n           (cond ((or (< t 0) (> t (- h (obj-h shape)))) state)\n                 ((fits? t)\n                  (let ((placed (map (lambda (p)\n                                       (list (+ t (- (first p) r1))\n                                             (second p)))\n                                     cells)))\n                    (list (paint-cells (first state) placed\n                                       (obj-color shape))\n                          (paint-cells (second state) placed 1))))\n                 (else (loop (+ t step)))))))\n     (first\n      (for/fold ((st (for/fold ((st (list (empty-grid h w 0)\n                                          (empty-grid h w 0))))\n                               ((f floaters))\n                       (drop st f 0 1))))\n                ((p sinkers))\n        (drop st p (- h (obj-h p)) -1))))))",
