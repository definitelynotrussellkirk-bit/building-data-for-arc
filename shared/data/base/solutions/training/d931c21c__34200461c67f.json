  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Every blue(1) blob that ENCLOSES a background pocket gets outlined:\n ;; the background ring around it (8-adjacent, inside its bbox+1)\n ;; turns red(2) — with bbox corners patched in when both their edge\n ;; neighbors made the ring — and the enclosed pocket cells touching\n ;; the blob turn green(3). Blobs without pockets stay bare.\n (lambda (g)\n   (let ()\n     (define bg 0)\n     (define (near? p cells)\n       (any? (lambda (d) (member? (list (+ (first p) (first d))\n                                        (+ (second p) (second d)))\n                                  cells))\n             all-8-deltas))\n     (define (add-corner edge outside p p1 p2 clipped?)\n       (if (and (not clipped?)\n                (member? p outside)\n                (member? p1 edge) (member? p2 edge)\n                (not (member? p edge)))\n           (cons p edge)\n           edge))\n     (define (process acc obj)\n       (let* ((cells (obj-cells obj))\n              (raw-r0 (- (obj-r1 obj) 1)) (raw-c0 (- (obj-c1 obj) 1))\n              (raw-r1 (+ (obj-r2 obj) 1)) (raw-c1 (+ (obj-c2 obj) 1))\n              (r0 (max 0 raw-r0)) (c0 (max 0 raw-c0))\n              (r1 (min (- h 1) raw-r1)) (c1 (min (- w 1) raw-c1))\n              (bg-cells (filter (lambda (p) (= (at g (first p)\n                                                  (second p))\n                                               bg))\n                                (positions-in-rect r0 c0 r1 c1)))\n              (outside  ;; bg reachable from the box rim, boxed flood\n               (for/fold ((seen (list)))\n                         ((seed (filter (lambda (p)\n                                          (or (= (first p) r0)\n                                              (= (first p) r1)\n                                              (= (second p) c0)\n                                              (= (second p) c1)))\n                                        bg-cells)))\n                 (if (member? seed seen)\n                     seen\n                     (for/fold ((a seen))\n                               ((p (connected-region\n                                    g (first seed) (second seed)\n                                    (lambda (r c v)\n                                      (and (= v bg)\n                                           (>= r r0) (<= r r1)\n                                           (>= c c0) (<= c c1)))\n                                    4)))\n                       (if (member? p a) a (cons p a))))))\n              (ring (filter (lambda (p) (near? p cells)) outside))\n              (ring+corners\n               (add-corner\n                (add-corner\n                 (add-corner\n                  (add-corner ring outside (list r0 c0)\n                              (list r0 (+ c0 1)) (list (+ r0 1) c0)\n                              (or (< raw-r0 0) (< raw-c0 0)))\n                  outside (list r0 c1) (list r0 (- c1 1))\n                  (list (+ r0 1) c1)\n                  (or (< raw-r0 0) (>= raw-c1 w)))\n                 outside (list r1 c0) (list r1 (+ c0 1))\n                 (list (- r1 1) c0)\n                 (or (>= raw-r1 h) (< raw-c0 0)))\n                outside (list r1 c1) (list r1 (- c1 1))\n                (list (- r1 1) c1)\n                (or (>= raw-r1 h) (>= raw-c1 w))))\n              (pocket (filter (lambda (p) (and (not (member? p outside))\n                                               (near? p cells)))\n                              bg-cells)))\n         (if (empty? pocket)\n             acc\n             (paint-cells (paint-cells acc ring+corners 2) pocket 3))))\n     (reduce process g\n             (filter (lambda (o) (= (obj-color o) 1)) (objects g bg))))))",
