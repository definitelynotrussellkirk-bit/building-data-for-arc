    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         (fours (find-color g 4))\n         (f-rs (map first fours)) (f-cs (map second fours))\n         (fr1 (apply min f-rs)) (fc1 (apply min f-cs))\n         (fr2 (apply max f-rs)) (fc2 (apply max f-cs))\n         (frame-h (+ 1 (- fr2 fr1)))\n         (frame-w (+ 1 (- fc2 fc1)))\n         ;; Find colored blocks inside frame\n         (blocks\n          (for*/list ((r (range fr1 (+ fr2 1)))\n                      (c (range fc1 (+ fc2 1)))\n                      #:when (let ((v (cell-at g r c)))\n                               (and (not (= v 0)) (not (= v 4)))))\n            (list (- r fr1) (- c fc1) (cell-at g r c))))\n         (block-colors (remove-duplicates (map third blocks)))\n         (first-color (first block-colors))\n         (fc-cells (filter (lambda (b) (= (third b) first-color)) blocks))\n         (block-size (+ 1 (- (apply max (map first fc-cells))\n                              (apply min (map first fc-cells)))))\n         ;; Find key pattern outside frame\n         (key-cells\n          (for*/list ((r (range 0 h)) (c (range 0 w))\n                      #:when (and (not (= (cell-at g r c) 0))\n                                  (not (= (cell-at g r c) 4))\n                                  (or (< r fr1) (> r fr2)\n                                      (< c fc1) (> c fc2))))\n            (list r c (cell-at g r c))))\n         (kr1 (apply min (map first key-cells)))\n         (kc1 (apply min (map second key-cells)))\n         (key-rel (for/list ((k key-cells))\n                    (list (- (first k) kr1) (- (second k) kc1) (third k))))\n         ;; Align: find first-color cell in key\n         (key-first (for/first ((k key-rel) #:when (= (third k) first-color)) k))\n         (block-first-r (apply min (map first fc-cells)))\n         (block-first-c (apply min (map second fc-cells)))\n         (off-r (- block-first-r (* (first key-first) block-size)))\n         (off-c (- block-first-c (* (second key-first) block-size)))\n         (result (make-hash)))\n    (for* ((r (range 0 frame-h)) (c (range 0 frame-w)))\n      (hash-set! result (list r c) 0))\n    (for ((f fours))\n      (hash-set! result (list (- (first f) fr1) (- (second f) fc1)) 4))\n    (for ((k key-rel))\n      (let ((clr (third k))\n            (base-r (+ off-r (* (first k) block-size)))\n            (base-c (+ off-c (* (second k) block-size))))\n        (for* ((dr (range 0 block-size)) (dc (range 0 block-size)))\n          (let ((rr (+ base-r dr)) (cc (+ base-c dc)))\n            (when (and (>= rr 0) (< rr frame-h) (>= cc 0) (< cc frame-w))\n              (hash-set! result (list rr cc) clr))))))\n    (grid-from-fn frame-h frame-w\n      (lambda (r c)\n        (hash-ref result (list r c) 0))))))",
