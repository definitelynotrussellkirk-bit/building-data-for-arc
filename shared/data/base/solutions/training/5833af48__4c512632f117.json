  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Three pieces: a STAMP (bbox of the red-2 markers, extended downward through\n ;; non-empty rows), a TEMPLATE of 8s+bg right of the first 0-gap in the\n ;; stamp's top row, and a solid bg TARGET RECT below the template. The rect is\n ;; a fund grid of stamp-sized cells; the (possibly upscaled) template says\n ;; which cells receive the stamp (red prints as bg, everything else as-is).\n ;; bg = the first non-{0,2,8} cell in row-major order.\n (lambda (g)\n   (let ()\n     (define h (rows g))\n     (define w (cols g))\n     (define (bbox pts)\n       (list (apply min (map first pts)) (apply min (map second pts))\n             (apply max (map first pts)) (apply max (map second pts))))\n     (define bg\n       (let ((p (find-first (lambda (p) (not (member (at g (first p) (second p))\n                                                     '(0 2 8))))\n                            (grid-positions g))))\n         (at g (first p) (second p))))\n     (define red-bb (bbox (find-color g 2)))\n     (define sr1 (first red-bb))\n     (define sc1 (second red-bb))\n     (define sc2 (fourth red-bb))\n     (define (row-nonempty? r)\n       (ormap (lambda (c) (not (= (at g r c) 0))) (range sc1 (+ sc2 1))))\n     (define sr2                      ; extend below the red bbox; a scan that\n       (let loop ((r (+ (third red-bb) 1)))   ; falls off the grid reverts to it\n         (cond ((>= r h) (third red-bb))\n               ((row-nonempty? r) (loop (+ r 1)))\n               (else (- r 1)))))\n     (define sh (+ 1 (- sr2 sr1)))\n     (define sw (+ 1 (- sc2 sc1)))\n     (define stamp (subgrid g sr1 sc1 sr2 sc2))\n     (define sep-c\n       (let loop ((c (+ sc2 1)))\n         (cond ((>= c w) sc2)\n               ((= (at g sr1 c) 0) c)\n               (else (loop (+ c 1))))))\n     (define tile-8 (filter (lambda (p) (>= (second p) sep-c)) (find-color g 8)))\n     (define t8-bb (bbox tile-8))\n     (define tile-bg\n       (filter (lambda (p) (and (<= (first t8-bb) (first p) (third t8-bb))\n                                (<= (second t8-bb) (second p) (fourth t8-bb))))\n               (find-color g bg)))\n     (define tile-bb (bbox (append tile-8 tile-bg)))\n     (define rect-bb\n       (bbox (filter (lambda (p) (> (first p) (third tile-bb))) (find-color g bg))))\n     (define rect-h (+ 1 (- (third rect-bb) (first rect-bb))))\n     (define rect-w (+ 1 (- (fourth rect-bb) (second rect-bb))))\n     (define cell-h (quotient (+ 1 (- (third tile-bb) (first tile-bb)))\n                              (quotient rect-h sh)))\n     (define cell-w (quotient (+ 1 (- (fourth tile-bb) (second tile-bb)))\n                              (quotient rect-w sw)))\n     (grid-from-fn rect-h rect-w\n       (lambda (r c)\n         (let ((tile-val (at g (+ (first tile-bb) (* (quotient r sh) cell-h))\n                             (+ (second tile-bb) (* (quotient c sw) cell-w)))))\n           (if (= tile-val 8)\n               (let ((sv (at stamp (modulo r sh) (modulo c sw))))\n                 (if (= sv 2) bg sv))\n               bg)))))))",
  "solution_language": "racket",
  "target_code": "(rule!\n ;; Three pieces: a STAMP (bbox of the red-2 markers, extended downward through\n ;; non-empty rows), a TEMPLATE of 8s+bg right of the first 0-gap in the\n ;; stamp's top row, and a solid bg TARGET RECT below the template. The rect is\n ;; a fund grid of stamp-sized cells; the (possibly upscaled) template says\n ;; which cells receive the stamp (red prints as bg, everything else as-is).\n ;; bg = the first non-{0,2,8} cell in row-major order.\n (lambda (g)\n   (let ()\n     (define h (rows g))\n     (define w (cols g))\n     (define (bbox pts)\n       (list (apply min (map first pts)) (apply min (map second pts))\n             (apply max (map first pts)) (apply max (map second pts))))\n     (define bg\n       (let ((p (find-first (lambda (p) (not (member (at g (first p) (second p))\n                                                     '(0 2 8))))\n                            (grid-positions g))))\n         (at g (first p) (second p))))\n     (define red-bb (bbox (find-color g 2)))\n     (define sr1 (first red-bb))\n     (define sc1 (second red-bb))\n     (define sc2 (fourth red-bb))\n     (define (row-nonempty? r)\n       (ormap (lambda (c) (not (= (at g r c) 0))) (range sc1 (+ sc2 1))))\n     (define sr2                      ; extend below the red bbox; a scan that\n       (let loop ((r (+ (third red-bb) 1)))   ; falls off the grid reverts to it\n         (cond ((>= r h) (third red-bb))\n               ((row-nonempty? r) (loop (+ r 1)))\n               (else (- r 1)))))\n     (define sh (+ 1 (- sr2 sr1)))\n     (define sw (+ 1 (- sc2 sc1)))\n     (define stamp (subgrid g sr1 sc1 sr2 sc2))\n     (define sep-c\n       (let loop ((c (+ sc2 1)))\n         (cond ((>= c w) sc2)\n               ((= (at g sr1 c) 0) c)\n               (else (loop (+ c 1))))))\n     (define tile-8 (filter (lambda (p) (>= (second p) sep-c)) (find-color g 8)))\n     (define t8-bb (bbox tile-8))\n     (define tile-bg\n       (filter (lambda (p) (and (<= (first t8-bb) (first p) (third t8-bb))\n                                (<= (second t8-bb) (second p) (fourth t8-bb))))\n               (find-color g bg)))\n     (define tile-bb (bbox (append tile-8 tile-bg)))\n     (define rect-bb\n       (bbox (filter (lambda (p) (> (first p) (third tile-bb))) (find-color g bg))))\n     (define rect-h (+ 1 (- (third rect-bb) (first rect-bb))))\n     (define rect-w (+ 1 (- (fourth rect-bb) (second rect-bb))))\n     (define cell-h (quotient (+ 1 (- (third tile-bb) (first tile-bb)))\n                              (quotient rect-h sh)))\n     (define cell-w (quotient (+ 1 (- (fourth tile-bb) (second tile-bb)))\n                              (quotient rect-w sw)))\n     (grid-from-fn rect-h rect-w\n       (lambda (r c)\n         (let ((tile-val (at g (+ (first tile-bb) (* (quotient r sh) cell-h))\n                             (+ (second tile-bb) (* (quotient c sw) cell-w)))))\n           (if (= tile-val 8)\n               (let ((sv (at stamp (modulo r sh) (modulo c sw))))\n                 (if (= sv 2) bg sv))\n               bg)))))))",
