  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Each gray(5) line has a decorated pattern hugging one side. The\n ;; pattern (its 4-connected non-gray region) tiles periodically along\n ;; the line's full span, repeating its own bbox as the unit cell.\n (lambda (g)\n   (let ()\n     (define (pattern? r c)\n       (and (in-bounds? r c h w)\n            (let ((v (at g r c)))\n              (and (> v 0) (not (= v 5))))))\n     (define (tile-line out line)\n       (let* ((r1 (obj-r1 line)) (c1 (obj-c1 line))\n              (r2 (obj-r2 line)) (c2 (obj-c2 line))\n              (horiz (= r1 r2))\n              (seeds  ;; pattern cells on the side the pattern hugs\n               (if horiz\n                   (let ((sr (find-first\n                              (lambda (sr)\n                                (any? (lambda (c) (pattern? sr c))\n                                      (range c1 (+ c2 1))))\n                              (list (+ r1 1) (- r1 1)))))\n                     (filter (lambda (p) (pattern? (first p) (second p)))\n                             (map (lambda (c) (list sr c))\n                                  (range c1 (+ c2 1)))))\n                   (let ((sc (find-first\n                              (lambda (sc)\n                                (any? (lambda (r) (pattern? r sc))\n                                      (range r1 (+ r2 1))))\n                              (list (+ c1 1) (- c1 1)))))\n                     (filter (lambda (p) (pattern? (first p) (second p)))\n                             (map (lambda (r) (list r sc))\n                                  (range r1 (+ r2 1)))))))\n              (region (remove-duplicates\n                       (flatmap (lambda (p)\n                                  (connected-region\n                                   g (first p) (second p)\n                                   (lambda (r c v)\n                                     (and (> v 0) (not (= v 5))))\n                                   4))\n                                seeds)))\n              (sb (bbox-of-cells region))\n              (sh (+ 1 (- (third sb) (first sb))))\n              (sw (+ 1 (- (fourth sb) (second sb))))\n              (rect (if horiz\n                        (list (first sb) c1 (third sb) c2)\n                        (list r1 (second sb) r2 (fourth sb)))))\n         (paint-cells\n          out\n          (map (lambda (p)\n                 (list (first p) (second p)\n                       (at g\n                           (+ (first sb)\n                              (mod (- (first p) (first sb)) sh))\n                           (+ (second sb)\n                              (mod (- (second p) (second sb)) sw)))))\n               (positions-in-rect (first rect) (second rect)\n                                  (third rect) (fourth rect))))))\n     (reduce tile-line g\n             (filter (lambda (o) (= 5 (obj-color o))) (objects g 0))))))",
  "solution_language": "racket",
