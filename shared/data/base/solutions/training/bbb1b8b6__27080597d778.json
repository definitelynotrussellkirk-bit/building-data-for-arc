  "needs_conversion": false,
  "raw_code": "(rule! (lambda (g)\n  ;; alt: crop the left panel, then overlay the right panel only where the left has zero and the panels are zero-complements.\n  (let* ((h (rows g))\n         (left-w 4)\n         (zero-complements?\n          (for*/and ((r (in-range h))\n                     (c (in-range left-w)))\n            (not (equal? (zero? (at g r c))\n                         (zero? (at g r (+ c 5))))))))\n    (grid-from-fn h left-w\n      (lambda (r c)\n        (let ((left (at g r c))\n              (right (at g r (+ c 5))))\n          (if (and zero-complements? (zero? left)) right left)))))))",
  "solution_language": "racket",
  "target_code": "(rule! (lambda (g)\n  ;; alt: crop the left panel, then overlay the right panel only where the left has zero and the panels are zero-complements.\n  (let* ((h (rows g))\n         (left-w 4)\n         (zero-complements?\n          (for*/and ((r (in-range h))\n                     (c (in-range left-w)))\n            (not (equal? (zero? (at g r c))\n                         (zero? (at g r (+ c 5))))))))\n    (grid-from-fn h left-w\n      (lambda (r c)\n        (let ((left (at g r c))\n              (right (at g r (+ c 5))))\n          (if (and zero-complements? (zero? left)) right left)))))))",
