    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         ;; The unique vertical key column contains only cyan 8 and blue 1.\n         (vc (find (lambda (c)\n                     (not (find (lambda (r)\n                                  (let ((v (at g r c)))\n                                    (not (or (= v 8) (= v 1)))))\n                                (range 0 h))))\n                   (range 0 w)))\n         ;; Any non-key column exposes each horizontal stripe's source color.\n         (sc (if (zero? vc) 1 0))\n         (stripes\n          (filter (lambda (p) p)\n                  (for/list ((r (range 0 h)))\n                    (let ((v (at g r sc)))\n                      (and (!= v 7) (!= v 8) (!= v 1)\n                           (list r v))))))\n         ;; Stripe rows become blue. Other rows inherit the nearest stripe\n         ;; colors; an odd gap between different colors gets a blue midpoint.\n         (row-info\n          (for/list ((r (range 0 h)))\n            (let ((sm (find (lambda (s) (= r (first s))) stripes)))\n              (if sm\n                  (list 1 #t)\n                  (let ((above (filter (lambda (s) (< (first s) r)) stripes))\n                        (below (filter (lambda (s) (> (first s) r)) stripes)))\n                    (list\n                     (cond\n                       ((empty? above) (second (first below)))\n                       ((empty? below) (second (last above)))\n                       (else\n                        (let* ((sa (last above))\n                               (sb (first below))\n                               (ra (first sa))\n                               (ca (second sa))\n                               (rb (first sb))\n                               (cb (second sb))\n                               (gap (- rb ra 1))\n                               (pos (- r ra 1)))\n                          (if (= ca cb)\n                              ca\n                              (if (zero? (remainder gap 2))\n                                  (if (< pos (quotient gap 2)) ca cb)\n                                  (let ((mid (quotient gap 2)))\n                                    (cond ((< pos mid) ca)\n                                          ((= pos mid) 1)\n                                          (else cb))))))))\n                     #f)))))))\n    ;; Swap the key-column roles: stripe rows show 8, all other rows show 1.\n    (cellmap g (r c v)\n      (let* ((info (nth row-info r))\n             (fill (first info))\n             (stripe-row? (second info)))\n        (if (= c vc)\n            (if stripe-row? 8 1)\n            fill))))))",
    "solution_language": "racket",
