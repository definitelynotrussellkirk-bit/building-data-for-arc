 "description_target": {
  "ambiguity_notes": "The legend is the inclusive bounding box of every gray-5 cell, not necessarily an outlined frame. Source-color frequency is counted only outside that box; ties keep the lower numeric color because the scan updates only on a strict increase. Both dots and external source objects are independently ordered row-major, and only the shorter paired prefix is recolored.",
  "generator_parameters": [
   "scene_profile"
  ],
  "input_modalities": [
   "task_image",
   "samples"
  ],
  "negative_constraints": [
   "do not treat the gray cells as a hollow-frame requirement or discard the legend",
   "do not choose the source color by its legend presence or total whole-grid count",
   "do not use 4-connectivity for source objects or merge distinct 8-connected objects by color",
   "do not include zero, gray 5, or source-colored legend cells in the ordered dot list",
   "do not pair by shape size, nearest distance, color identity, or arbitrary object discovery order",
   "do not recolor unpaired excess source objects, legend cells, background, or non-source distractors"
  ],
  "puzzle_concepts": [
   "gray legend bounding rectangle",
   "outside color-frequency selection",
   "stable lower-color tie breaking",
   "same-color 8-connected objects",
   "independent row-major ordering",
   "shorter-prefix dot/object pairing",
   "selective object recoloring"
  ],
  "semantic_primitives": [
   "find-color",
   "objects-8",
   "sort-by",
   "obj-cells",
   "set-cell"
  ],
  "solution_steps": [
   "take the inclusive row and column extrema of every gray-5 cell as the legend rectangle",
   "count each color 1 through 9 outside that rectangle and choose the first strict maximum as the source color",
   "scan the legend rectangle row-major for cells that are neither zero, gray 5, nor the source color",
   "extract same-color 8-connected source objects wholly outside the legend and sort them by their top-left cell",
   "pair dots and source objects in order up to the shorter list and recolor every cell of each paired object to its dot color",
   "return the otherwise unchanged input grid"
  ],
  "source": "canonical program and reviewed semantic audit",
  "target_status": "reviewed_semantic_description",
  "target_text": "Use all gray cells to bound a legend; choose the outside-dominant source color, then recolor its ordered external 8-connected objects using the independently ordered non-source legend-dot colors, stopping at the shorter count."
 },
