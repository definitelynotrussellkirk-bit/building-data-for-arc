  "needs_conversion": false,
  "raw_code": "(rule!\n ;; 3x3 ICONS (uniform ring around a distinct center) and 3x3\n ;; checkerboard decoys float among scattered dots. The most common\n ;; dot color VOTES: output the icon that such a dot touches, rebuilt\n ;; as its clean 3x3.\n (lambda (g)\n   (let ()\n     (define flat (apply append g))\n     (define bg\n       (pick-max (remove-duplicates flat)\n                 (lambda (c) (count-if (lambda (x) (= x c)) flat))))\n     (define icons  ;; (r c ring-color center-color)\n       (filter (lambda (x) x)\n               (for*/list ((r (range 0 (- h 2))) (c (range 0 (- w 2))))\n                 (let ((ring (map (lambda (d) (at g (+ r (first d))\n                                                  (+ c (second d))))\n                                  (list (list 0 0) (list 0 1)\n                                        (list 0 2) (list 1 0)\n                                        (list 1 2) (list 2 0)\n                                        (list 2 1) (list 2 2))))\n                       (ctr (at g (+ r 1) (+ c 1))))\n                   (and (not (= (first ring) bg))\n                        (not (= ctr bg))\n                        (not (= ctr (first ring)))\n                        (all? (lambda (v) (= v (first ring))) ring)\n                        (list r c (first ring) ctr))))))\n     (define checkers\n       (filter (lambda (x) x)\n               (for*/list ((r (range 0 (- h 2))) (c (range 0 (- w 2))))\n                 (let ((a (at g r c)) (b (at g r (+ c 1))))\n                   (and (not (= a bg)) (not (= b bg)) (not (= a b))\n                        (= (at g r (+ c 2)) a)\n                        (= (at g (+ r 1) c) b)\n                        (= (at g (+ r 1) (+ c 1)) a)\n                        (= (at g (+ r 1) (+ c 2)) b)\n                        (= (at g (+ r 2) c) a)\n                        (= (at g (+ r 2) (+ c 1)) b)\n                        (= (at g (+ r 2) (+ c 2)) a)\n                        (list r c))))))\n     (define special  ;; every cell inside a detected 3x3 block\n       (flatmap (lambda (blk)\n                  (for*/list ((dr (range 0 3)) (dc (range 0 3)))\n                    (list (+ (first blk) dr) (+ (second blk) dc))))\n                (append icons checkers)))\n     (define dots\n       (filter (lambda (p)\n                 (and (not (= (at g (first p) (second p)) bg))\n                      (not (member p special))))\n               (grid-positions g)))\n     (define mc  ;; the majority dot color\n       (pick-max (remove-duplicates\n                  (map (lambda (p) (at g (first p) (second p))) dots))\n                 (lambda (v) (count-if (lambda (p)\n                                         (= (at g (first p) (second p))\n                                            v))\n                                       dots))))\n     (define hit\n       (find (lambda (ic)\n               (any? (lambda (p)\n                       (any? (lambda (d)\n                               (let ((nr (+ (first p) (first d)))\n                                     (nc (+ (second p) (second d))))\n                                 (and (in-bounds? nr nc h w)\n                                      (not (member (list nr nc)\n                                                   special))\n                                      (= (at g nr nc) mc))))\n                             cardinal-deltas))\n                     (for*/list ((dr (range 0 3)) (dc (range 0 3)))\n                       (list (+ (first ic) dr) (+ (second ic) dc)))))\n             icons))\n     (let ((b (third hit)) (ctr (fourth hit)))\n       (list (list b b b) (list b ctr b) (list b b b))))))",
