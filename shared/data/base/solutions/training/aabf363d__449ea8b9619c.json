    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g)) (w (cols g))\n         (marker (cell-at g (- h 1) 0))\n         (shape-color (first (filter (lambda (v) (and (!= v 0) (!= v marker)))\n           (reduce append (list) (map (lambda (r) (map (lambda (c) (cell-at g r c)) (range 0 w))) (range 0 h)))))))\n    (grid-from-fn h w (lambda (r c)\n      (if (= (cell-at g r c) shape-color) marker 0))))))",
    "solution_language": "racket",
    "target_code": "(rule!\n ;; The bottom-left singleton supplies the replacement color. The only other\n ;; nonzero color is one irregular shape; preserve its cells, erase everything\n ;; else (including the marker), and recolor the whole shape.\n (lambda (g)\n   (let* ((marker (at g (- h 1) 0))\n          (shape-color\n           (find-first (lambda (v) (and (!= v 0) (!= v marker)))\n                       (grid-colors g))))\n     (cellmap g (r c v)\n       (if (= v shape-color) marker 0)))))",
    "target_status": "verified_racket_available"
  },
