  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Dashed horizontal lines fill solid across their span. Then every\n ;; special column — a dash GAP, or one holding a stray vertical mark —\n ;; floods vertically: each nonzero anchor in the column paints\n ;; everything above it (down to the previous anchor) in its color.\n (lambda (g)\n   (let ()\n     (define h-lines  ;; (color row cols) where the color runs 2+ long\n       (flatmap\n        (lambda (r)\n          (map (lambda (v)\n                 (list v r (filter (lambda (c) (= (at g r c) v))\n                                   (range 0 w))))\n               (filter (lambda (v)\n                         (let ((cols (filter (lambda (c)\n                                               (= (at g r c) v))\n                                             (range 0 w))))\n                           (any? (lambda (i) (= (+ (nth cols i) 1)\n                                                (nth cols (+ i 1))))\n                                 (range 0 (- (length cols) 1)))))\n                       (remove-duplicates\n                        (filter (lambda (v) (> v 0)) (row g r))))))\n        (range 0 h)))\n     (define (in-h-line? r c)\n       (any? (lambda (line) (and (= (second line) r)\n                                 (member? c (third line))))\n             h-lines))\n     (define phase1  ;; dashes solidified (reverse order: leftmost wins)\n       (for/fold ((out g)) ((line (reverse h-lines)))\n         (paint-cells out\n                      (positions-in-rect (second line)\n                                         (min-list (third line))\n                                         (second line)\n                                         (max-list (third line)))\n                      (first line))))\n     (define gap-cols  ;; in-span columns each dash skipped\n       (remove-duplicates\n        (flatmap (lambda (line)\n                   (filter (lambda (c) (not (member? c (third line))))\n                           (range (min-list (third line))\n                                  (+ (max-list (third line)) 1))))\n                 h-lines)))\n     (define stray-cols  ;; columns of nonzero cells outside all dashes\n       (remove-duplicates\n        (map second\n             (filter (lambda (p)\n                       (and (> (at g (first p) (second p)) 0)\n                            (not (in-h-line? (first p) (second p)))))\n                     (grid-positions g)))))\n     (for/fold ((out phase1))\n               ((col (remove-duplicates (append gap-cols stray-cols))))\n       (let loop ((anchors (filter (lambda (rv) (> (second rv) 0))\n                                   (map (lambda (r)\n                                          (list r (at phase1 r col)))\n                                        (range 0 h))))\n                  (prev -1) (grid out))\n         (if (null? anchors)\n             grid\n             (loop (rest anchors) (first (first anchors))\n                   (paint-cells grid\n                                (positions-in-rect\n                                 (+ prev 1) col\n                                 (- (first (first anchors)) 1) col)\n                                (second (first anchors))))))))))",
