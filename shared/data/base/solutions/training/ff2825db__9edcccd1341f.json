    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         ;; Border color from input (row 1, col 0)\n         (bdr (cell-at g 1 0))\n         ;; Collect interior non-zero, non-border cells by color\n         (interior (for*/list ((r (range 2 (- h 1))) (c (range 1 (- w 1)))\n                     #:when (let ((v (cell-at g r c)))\n                              (and (not (= v 0)) (not (= v bdr)))))\n                     (list r c (cell-at g r c))))\n         ;; Find distinct interior colors\n         (colors (unique (map third interior)))\n         ;; Count per color, pick max\n         (counts (map (lambda (clr)\n                        (list clr (length (filter (lambda (x) (= (third x) clr)) interior))))\n                      colors))\n         (winner (first (first (sort counts (lambda (a b) (> (second a) (second b)))))))\n         ;; Bbox of winner cells\n         (win-cells (filter (lambda (x) (= (third x) winner)) interior))\n         (r1 (apply min (map first win-cells)))\n         (r2 (apply max (map first win-cells)))\n         (c1 (apply min (map second win-cells)))\n         (c2 (apply max (map second win-cells))))\n    (grid-from-fn h w\n      (lambda (r c)\n        (cond\n          ;; Row 0: keep color key\n          ((= r 0) (cell-at g r c))\n          ;; Outer hollow rect border (rows 1 to h-1, cols 0 to w-1)\n          ((or (= r 1) (= r (- h 1)) (= c 0) (= c (- w 1))) winner)\n          ;; Inner hollow rect border at bbox\n          ((or (and (or (= r r1) (= r r2)) (>= c c1) (<= c c2))\n               (and (or (= c c1) (= c c2)) (>= r r1) (<= r r2)))\n           winner)\n          (else 0)))))))",
    "solution_language": "racket",
    "target_code": "(rule!\n ;; Keep the color key unchanged. Inside the old frame, the unique most-common\n ;; nonzero color other than the frame color selects both the replacement color\n ;; and the cells whose bounding box becomes the inner hollow rectangle.\n (lambda (g)\n   (let* ((h (rows g))\n          (w (cols g))\n          ;; The uniform outer frame begins at row 1; row 0 is the preserved key.\n          (bdr (at g 1 0))\n          ;; Each entry is (row column color) for a non-background, non-frame\n          ;; interior cell.\n          (interior\n           (for*/list ((r (range 2 (- h 1)))\n                       (c (range 1 (- w 1)))\n                       #:when (let ((v (at g r c)))\n                                (and (!= v 0) (!= v bdr))))\n             (list r c (at g r c))))\n          (colors (unique (map third interior)))\n          (counts\n           (map (lambda (clr)\n                  (list clr\n                        (count-if (lambda (cell) (= (third cell) clr))\n                                  interior)))\n                colors))\n          ;; The task grammar guarantees one strict frequency maximum.\n          (winner (first (pick-max counts second)))\n          (win-cells (filter (lambda (cell) (= (third cell) winner))\n                             interior))\n          (r1 (min-of first win-cells))\n          (r2 (max-of first win-cells))\n          (c1 (min-of second win-cells))\n          (c2 (max-of second win-cells)))\n     (cellmap g (r c v)\n       (cond\n         ;; Preserve the key row verbatim.\n         ((zero? r) v)\n         ;; Recolor the full old outer frame with the winner.\n         ((or (= r 1) (= r (- h 1)) (zero? c) (= c (- w 1))) winner)\n         ;; Draw the winner bounding box as a hollow rectangle.\n         ((or (and (or (= r r1) (= r r2)) (>= c c1) (<= c c2))\n              (and (or (= c c1) (= c c2)) (>= r r1) (<= r r2)))\n          winner)\n         ;; Drop every original interior cell not on that hollow rectangle.\n         (else 0))))))",
