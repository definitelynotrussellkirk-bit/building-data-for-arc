  "raw_code": "(rule!\n ;; A full one-color LINE mirrors the board. Every solid rectangle (4+\n ;; cells, not line-colored) reflects across it, and line-colored beams\n ;; connect BOTH the rectangle and its mirror image to the line (rows\n ;; strictly between, per rectangle row). Normalize so the line is\n ;; vertical — transpose in and out when it is horizontal.\n (lambda (g)\n   (let ()\n     (define (line-col grid)  ;; first full uniform non-bg column\n       (let ((bg (mode grid -1)))\n         (find-first (lambda (c)\n                       (and (not (= (at grid 0 c) bg))\n                            (all? (lambda (r) (= (at grid r c)\n                                                 (at grid 0 c)))\n                                  (range 0 (rows grid)))))\n                     (range 0 (cols grid)))))\n     (define (solve grid)\n       (let* ((ww (cols grid))\n              (bg (mode grid -1))\n              (pos (line-col grid))\n              (line-color (at grid 0 pos))\n              (mirror (lambda (c) (- (* 2 pos) c)))\n              (rects (filter (lambda (o)\n                               (and (not (= (obj-color o) line-color))\n                                    (>= (obj-size o) 4)\n                                    (= (obj-size o)\n                                       (* (obj-h o) (obj-w o)))))\n                             (objects grid bg)))\n              (mirrored\n               (for/fold ((out grid)) ((o rects))\n                 (for*/fold ((acc out))\n                            ((r (range (obj-r1 o) (+ (obj-r2 o) 1)))\n                             (c (range (obj-c1 o) (+ (obj-c2 o) 1))))\n                   (if (and (>= (mirror c) 0) (< (mirror c) ww))\n                       (set-cell acc r (mirror c) (obj-color o))\n                       acc)))))\n         (for/fold ((out mirrored)) ((o rects))\n           (for/fold ((acc out))\n                     ((r (range (obj-r1 o) (+ (obj-r2 o) 1))))\n             (let ((own (if (< (obj-c2 o) pos)\n                            (range (+ (obj-c2 o) 1) pos)\n                            (range (+ pos 1) (obj-c1 o))))\n                   (refl (if (> (mirror (obj-c2 o)) pos)\n                             (range (+ pos 1) (mirror (obj-c2 o)))\n                             (range (+ (mirror (obj-c1 o)) 1) pos))))\n               (for/fold ((a2 acc)) ((c (append own refl)))\n                 (set-cell a2 r c line-color)))))))\n     (if (line-col g)\n         (solve g)\n         (transpose (solve (transpose g)))))))",
