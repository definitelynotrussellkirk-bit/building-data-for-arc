  "needs_conversion": false,
  "raw_code": "(rule!\n ;; A separator lattice holds tiles. In every 2x2 block of tiles where\n ;; exactly ONE is empty and the other three share a single color, the\n ;; empty tile receives the mirror of its neighbor — flipped\n ;; up-down across the horizontal axis, left-right across the vertical.\n (lambda (g)\n   (let ()\n     (define sep-rows\n       (filter (lambda (r) (and (> (at g r 0) 0) (row-uniform? g r)))\n               (range 0 h)))\n     (define sep-cols\n       (filter (lambda (c) (and (> (at g 0 c) 0) (col-uniform? g c)))\n               (range 0 w)))\n     (define rb (append (list -1) sep-rows (list h)))\n     (define cb (append (list -1) sep-cols (list w)))\n     (define (tr0 ri) (+ (nth rb ri) 1))\n     (define (tr1 ri) (- (nth rb (+ ri 1)) 1))\n     (define (tc0 ci) (+ (nth cb ci) 1))\n     (define (tc1 ci) (- (nth cb (+ ci 1)) 1))\n     (define (tile ri ci)\n       (subgrid g (tr0 ri) (tc0 ci) (tr1 ri) (tc1 ci)))\n     (define (tile-vals ri ci)\n       (for*/list ((r (range (tr0 ri) (+ (tr1 ri) 1)))\n                   (c (range (tc0 ci) (+ (tc1 ci) 1))))\n         (at g r c)))\n     (define (empty-tile? ri ci)\n       (all? (lambda (v) (zero? v)) (tile-vals ri ci)))\n     (define (tile-color ri ci)\n       (let ((vals (filter (lambda (v) (> v 0)) (tile-vals ri ci))))\n         (if (empty? vals) 0 (first vals))))\n     (define (paste out ri ci patch)\n       (if (and (= (rows patch) (+ 1 (- (tr1 ri) (tr0 ri))))\n                (= (cols patch) (+ 1 (- (tc1 ci) (tc0 ci)))))\n           (for/fold ((a out)) ((p (grid-positions patch)))\n             (set-cell a (+ (tr0 ri) (first p))\n                       (+ (tc0 ci) (second p))\n                       (at patch (first p) (second p))))\n           out))\n     (for*/fold ((out g)) ((ri (range 0 (- (length rb) 2)))\n                           (ci (range 0 (- (length cb) 2))))\n       (let* ((quads (list (list ri ci) (list ri (+ ci 1))\n                           (list (+ ri 1) ci)\n                           (list (+ ri 1) (+ ci 1))))\n              (empties (filter (lambda (q) (empty-tile? (first q)\n                                                        (second q)))\n                               quads))\n              (fills (filter (lambda (q) (not (empty-tile? (first q)\n                                                           (second q))))\n                             quads))\n              (colors (remove-duplicates\n                       (map (lambda (q) (tile-color (first q)\n                                                    (second q)))\n                            fills))))\n         (if (and (= (length empties) 1) (= (length fills) 3)\n                  (= (length colors) 1) (> (first colors) 0))\n             (let ((er (first (first empties)))\n                   (ec (second (first empties))))\n               (paste out er ec\n                      (cond ((and (= er ri) (= ec ci))\n                             (flip-ud (tile (+ ri 1) ci)))\n                            ((and (= er ri) (= ec (+ ci 1)))\n                             (flip-lr (tile ri ci)))\n                            ((and (= er (+ ri 1)) (= ec ci))\n                             (flip-ud (tile ri ci)))\n                            (else (flip-ud (tile ri (+ ci 1)))))))\n             out))))))",
