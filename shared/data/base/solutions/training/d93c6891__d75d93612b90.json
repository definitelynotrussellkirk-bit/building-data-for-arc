  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Gray(5) blobs press into orange(7) blocks. Base recolor: gray -> 4\n ;; ghost, orange -> 5 shadow. Each orange block then reappears in 7,\n ;; ERODED from the side its gray neighbors touch by depth =\n ;; total-gray-size / block-side-length; untouched blocks reappear\n ;; whole. (Side priority when several touch: right > bottom > left >\n ;; top; the last touching blob decides.)\n (lambda (g)\n   (let ()\n     (define oblocks\n       (filter (lambda (o) (= (obj-color o) 7)) (objects g 0)))\n     (define gblocks\n       (filter (lambda (o) (= (obj-color o) 5)) (objects g 0)))\n     (define (touch-flags ob gb)  ;; (top left bottom right) of ob's bbox\n       (let ((r1 (obj-r1 ob)) (c1 (obj-c1 ob))\n             (r2 (obj-r2 ob)) (c2 (obj-c2 ob)))\n         (for*/fold ((top #f) (left #f) (bottom #f) (right #f)\n                     #:result (list top left bottom right))\n                    ((gc (obj-cells gb)) (d cardinal-deltas))\n           (let ((gr (first gc)) (gcc (second gc))\n                 (nr (+ (first gc) (first d)))\n                 (nc (+ (second gc) (second d))))\n             (if (and (>= nr r1) (<= nr r2) (>= nc c1) (<= nc c2)\n                      (= (at g nr nc) 7))\n                 (cond ((< gr r1)\n                        (cond ((= nc c2) (values top left bottom #t))\n                              ((= nc c1) (values top #t bottom right))\n                              (else (values #t left bottom right))))\n                       ((> gr r2)\n                        (cond ((= nc c2) (values top left bottom #t))\n                              ((= nc c1) (values top #t bottom right))\n                              (else (values top left #t right))))\n                       ((< gcc c1)\n                        (cond ((= nr r2) (values top left #t right))\n                              ((= nr r1) (values #t left bottom right))\n                              (else (values top #t bottom right))))\n                       ((> gcc c2)\n                        (cond ((= nr r2) (values top left #t right))\n                              ((= nr r1) (values #t left bottom right))\n                              (else (values top left bottom #t))))\n                       (else (values #t left bottom right)))\n                 (values top left bottom right))))))\n     (define (repaint out ob)\n       (let* ((info  ;; (total-gray-size side)\n               (for/fold ((size 0) (dir 0) #:result (list size dir))\n                         ((gb gblocks))\n                 (let ((fl (touch-flags ob gb)))\n                   (if (or (first fl) (second fl) (third fl) (fourth fl))\n                       (values (+ size (obj-size gb))\n                               (cond ((fourth fl) 4) ((third fl) 3)\n                                     ((second fl) 2) (else 1)))\n                       (values size dir)))))\n              (size (first info))\n              (dir (second info))\n              (keep? (lambda (cell)\n                       (cond ((zero? size) #t)\n                             ((= dir 1)\n                              (>= (- (first cell) (obj-r1 ob))\n                                  (quotient size (obj-w ob))))\n                             ((= dir 2)\n                              (>= (- (second cell) (obj-c1 ob))\n                                  (quotient size (obj-h ob))))\n                             ((= dir 3)\n                              (>= (- (obj-r2 ob) (first cell))\n                                  (quotient size (obj-w ob))))\n                             (else\n                              (>= (- (obj-c2 ob) (second cell))\n                                  (quotient size (obj-h ob))))))))\n         (recolor-cells out (filter keep? (obj-cells ob)) 7)))\n     (for/fold ((out (cellmap g (r c v) (casev v (hash 5 4 7 5) v))))\n               ((ob (in-list oblocks)))\n       (repaint out ob)))))",
