    "raw_code": "(rule!\n  ;; alt: the stripe height is the count of 8s in the top header; keep only data-row colors whose frequency equals that height.\n  (lambda (g)\n    (let* ((h (rows g))\n           (w (cols g))\n           (stripe-h (count-if (lambda (c) (= 8 (at g 0 c))) (range 0 w)))\n           (separator-r (find-first\n                          (lambda (r) (all? (lambda (c) (= 5 (at g r c))) (range 0 w)))\n                          (range 0 h)))\n           (data-r (find-first\n                     (lambda (r)\n                       (and (> r separator-r)\n                            (not (all? (lambda (c) (zero? (at g r c))) (range 0 w)))))\n                     (range 0 h)))\n           (data (map (lambda (c) (at g data-r c)) (range 0 w)))\n           (kept (map (lambda (v)\n                        (if (and (!= v 0)\n                                 (= stripe-h (count-if (lambda (x) (= x v)) data)))\n                            v\n                            0))\n                      data)))\n      (cellmap g (r c v)\n        (if (and (>= r (- separator-r stripe-h)) (< r separator-r))\n            (nth kept c)\n            v)))))",
