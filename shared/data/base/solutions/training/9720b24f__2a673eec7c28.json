  "needs_conversion": false,
  "raw_code": "(rule!\n ;; Every color's 8-connected shapes (3+ cells) claim their CONVEX\n ;; territory: cells of any OTHER color lying inside a shape's convex\n ;; hull (built on cell corners, so whole cells count) are erased to 0.\n (lambda (g)\n   (let ()\n     (define (erase-inside out obj)\n       (let ((hull (convex-hull\n                    (remove-duplicates\n                     (flatmap (lambda (p)\n                                (list (list (- (first p) 0.5)\n                                            (- (second p) 0.5))\n                                      (list (- (first p) 0.5)\n                                            (+ (second p) 0.5))\n                                      (list (+ (first p) 0.5)\n                                            (- (second p) 0.5))\n                                      (list (+ (first p) 0.5)\n                                            (+ (second p) 0.5))))\n                              (obj-cells obj)))))\n             (color (obj-color obj)))\n         (if (< (length hull) 3)\n             out\n             (for*/fold ((acc out))\n                        ((r (range (obj-r1 obj) (+ (obj-r2 obj) 1)))\n                         (c (range (obj-c1 obj) (+ (obj-c2 obj) 1))))\n               (let ((v (at g r c)))\n                 (if (and (> v 0) (not (= v color))\n                          (point-in-hull? (+ 0.0 r) (+ 0.0 c) hull))\n                     (set-cell acc r c 0)\n                     acc))))))\n     (for/fold ((out g)) ((obj (in-list (filter (lambda (o)\n                                                  (>= (obj-size o) 3))\n                                                (objects-8 g 0)))))\n       (erase-inside out obj)))))",
  "solution_language": "racket",
  "target_code": "(rule!\n ;; Every color's 8-connected shapes (3+ cells) claim their CONVEX\n ;; territory: cells of any OTHER color lying inside a shape's convex\n ;; hull (built on cell corners, so whole cells count) are erased to 0.\n (lambda (g)\n   (let ()\n     (define (erase-inside out obj)\n       (let ((hull (convex-hull\n                    (remove-duplicates\n                     (flatmap (lambda (p)\n                                (list (list (- (first p) 0.5)\n                                            (- (second p) 0.5))\n                                      (list (- (first p) 0.5)\n                                            (+ (second p) 0.5))\n                                      (list (+ (first p) 0.5)\n                                            (- (second p) 0.5))\n                                      (list (+ (first p) 0.5)\n                                            (+ (second p) 0.5))))\n                              (obj-cells obj)))))\n             (color (obj-color obj)))\n         (if (< (length hull) 3)\n             out\n             (for*/fold ((acc out))\n                        ((r (range (obj-r1 obj) (+ (obj-r2 obj) 1)))\n                         (c (range (obj-c1 obj) (+ (obj-c2 obj) 1))))\n               (let ((v (at g r c)))\n                 (if (and (> v 0) (not (= v color))\n                          (point-in-hull? (+ 0.0 r) (+ 0.0 c) hull))\n                     (set-cell acc r c 0)\n                     acc))))))\n     (for/fold ((out g)) ((obj (in-list (filter (lambda (o)\n                                                  (>= (obj-size o) 3))\n                                                (objects-8 g 0)))))\n       (erase-inside out obj)))))",
