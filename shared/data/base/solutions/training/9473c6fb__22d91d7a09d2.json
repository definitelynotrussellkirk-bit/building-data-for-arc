    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  ;; Scattered single-cell markers on orange (7). Their input colors are IRRELEVANT: the output\n  ;; recolors them by cycling 2 -> 8 -> 5 along the markers' SPREAD axis \u2014 scanned row-major when\n  ;; they span at least as many distinct rows as columns, else column-major.\n  (let* ((ms (positions-of g (lambda (v) (!= v 7))))\n         (nrows (length (unique (map first ms))))\n         (ncols (length (unique (map second ms))))\n         (row-major< (lambda (a b) (or (< (first a) (first b))\n                                       (and (= (first a) (first b)) (< (second a) (second b))))))\n         (col-major< (lambda (a b) (or (< (second a) (second b))\n                                       (and (= (second a) (second b)) (< (first a) (first b))))))\n         (order (sort ms (if (>= nrows ncols) row-major< col-major<)))\n         (cycle (list 2 8 5)))\n    (for/fold ((out g)) (((p i) (in-indexed order)))\n      (set-cell out (first p) (second p) (list-ref cycle (modulo i 3)))))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n  ;; Scattered single-cell markers on orange (7). Their input colors are IRRELEVANT: the output\n  ;; recolors them by cycling 2 -> 8 -> 5 along the markers' SPREAD axis \u2014 scanned row-major when\n  ;; they span at least as many distinct rows as columns, else column-major.\n  (let* ((ms (positions-of g (lambda (v) (!= v 7))))\n         (nrows (length (unique (map first ms))))\n         (ncols (length (unique (map second ms))))\n         (row-major< (lambda (a b) (or (< (first a) (first b))\n                                       (and (= (first a) (first b)) (< (second a) (second b))))))\n         (col-major< (lambda (a b) (or (< (second a) (second b))\n                                       (and (= (second a) (second b)) (< (first a) (first b))))))\n         (order (sort ms (if (>= nrows ncols) row-major< col-major<)))\n         (cycle (list 2 8 5)))\n    (for/fold ((out g)) (((p i) (in-indexed order)))\n      (set-cell out (first p) (second p) (list-ref cycle (modulo i 3)))))))",
