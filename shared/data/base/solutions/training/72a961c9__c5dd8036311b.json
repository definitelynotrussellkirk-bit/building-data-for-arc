  "description_target": {
    "ambiguity_notes": "The first row containing color 1 is the bar. Every nonzero/non-1 value in that row is a marker. A color-8 marker creates exactly three cells above the bar and every other marker creates four; the marker color is used only at the new column's top, with color 1 below it. The bar and unrelated cells are preserved.",
    "generator_parameters": [
      "scene_profile"
    ],
    "input_modalities": [
      "task_image",
      "samples"
    ],
    "negative_constraints": [
      "do not count the marker's bar cell as one of the newly added cells",
      "do not fill the whole added column with the marker color",
      "do not give color-8 and color-2 markers the same height",
      "do not grow columns downward or overwrite the marked bar",
      "do not alter cells outside marker columns"
    ],
    "puzzle_concepts": [
      "marked horizontal bar",
      "color-conditioned column height",
      "upward projection",
      "marker-tipped fill"
    ],
    "semantic_primitives": [
      "find-first",
      "filter",
      "range",
      "reduce",
      "set-cell"
    ],
    "solution_steps": [
      "find the first row containing color 1",
      "collect every column in that row whose value is neither zero nor one",
      "assign height three to a color-8 marker and height four to every other marker",
      "write the marker color at the top of that many cells immediately above the bar",
      "fill the remaining added cells down to the bar with color 1 while preserving the input elsewhere"
    ],
    "source": "canonical program and reviewed semantic audit",
    "target_status": "reviewed_semantic_description",
    "target_text": "From the first color-1 bar, grow a column upward at every marker: add three cells for color 8 and four for color 2, placing the marker color at the top and color 1 beneath it while preserving the bar and all unrelated cells."
  },
