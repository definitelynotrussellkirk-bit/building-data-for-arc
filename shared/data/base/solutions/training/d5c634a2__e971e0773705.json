    ],
    "negative_constraints": [
      "Do not merge cardinally adjacent red objects into separate counts.",
      "Do not classify by an object's bottom row; the executable discriminator is the top row.",
      "Do not place more than four marks for either orientation.",
      "Do not swap the green bottom-bar tally with the blue top-bar tally."
    ],
    "puzzle_concepts": [
      "object counting",
      "T-tetromino orientation",
      "capped tally encoding"
    ],
    "semantic_primitives": [
      "four_connected_components",
      "normalize_shape",
      "count_by_orientation",
      "cap_at_four",
      "fixed_position_encoding"
    ],
    "solution_steps": [
      "Extract every red 4-connected component.",
      "Classify a component as a top-bar T when at least three cells occupy its topmost row; otherwise classify it as bottom-bar.",
      "Count both classes and cap each count at four.",
      "Place the bottom-bar count in green at (0,0), (2,0), (0,2), (2,2).",
      "Place the top-bar count in blue at (0,3), (2,3), (0,5), (2,5) and leave all other output cells black."
    ],
    "source": "solvers/grounded_rules.py comment",
    "target_status": "grounded_rule_comment",
    "target_text": "Count red T-tetrominoes by vertical orientation. Each top-bar T contributes one blue mark and each bottom-bar T contributes one green mark in a fixed 3x6 emblem. The marks use reading order within their four reserved corner positions and each tally saturates at four."
  },
