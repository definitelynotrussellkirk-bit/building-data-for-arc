  "needs_conversion": false,
  "raw_code": "(rule!\n ;; A rectangular frame of four colored lines holds scattered dots\n ;; whose color matches ONE side. Crop to the frame; inside, every\n ;; occupied scan line smears solid toward the matching wall: dots\n ;; colored like the top wall fill from the wall down to their last\n ;; dot, like the bottom wall from their first dot to the wall, and\n ;; the left/right walls likewise along rows.\n (lambda (g)\n   (let ()\n     (define (line? vals total)\n       (let* ((colors (filter (lambda (v) (> v 0)) vals))\n              (m (mode-list colors)))\n         (and (>= (length colors) (- total 2))\n              (not (eq? m #f))\n              (>= (count-if (lambda (v) (= v m)) colors) (- total 2)))))\n     (define line-rows\n       (filter (lambda (r) (line? (row g r) w)) (range 0 h)))\n     (define line-cols\n       (filter (lambda (c) (line? (col g c) h)) (range 0 w)))\n     (define top-r (first line-rows))\n     (define bot-r (second line-rows))\n     (define left-c (first line-cols))\n     (define right-c (second line-cols))\n     (define (line-mode vals)\n       (mode-list (filter (lambda (v) (> v 0)) vals)))\n     (define scatter-color\n       (mode-list (map (lambda (p) (at g (first p) (second p)))\n                       (filter (lambda (p)\n                                 (and (> (first p) top-r)\n                                      (< (first p) bot-r)\n                                      (> (second p) left-c)\n                                      (< (second p) right-c)\n                                      (> (at g (first p) (second p)) 0)))\n                               (grid-positions g)))))\n     (define dir  ;; matched wall, checked in the original priority\n       (cond ((= scatter-color (line-mode (row g top-r))) 'top)\n             ((= scatter-color (line-mode (row g bot-r))) 'bot)\n             ((= scatter-color (line-mode (col g left-c))) 'left)\n             ((= scatter-color (line-mode (col g right-c))) 'right)\n             (else #f)))\n     (define vert? (member? dir (list 'top 'bot)))\n     (define from-wall? (member? dir (list 'top 'left)))\n     (build-grid (+ 1 (- bot-r top-r)) (+ 1 (- right-c left-c)) (orr oc)\n                 (cond ((zero? orr) (at g top-r (+ left-c oc)))\n                       ((= orr (- bot-r top-r)) (at g bot-r (+ left-c oc)))\n                       ((zero? oc) (at g (+ top-r orr) left-c))\n                       ((= oc (- right-c left-c))\n                        (at g (+ top-r orr) right-c))\n                       ((not dir) 0)\n                       (else\n                        (let* ((ir (+ top-r orr))\n                               (ic (+ left-c oc))\n                               (occ (if vert?\n                                        (filter (lambda (r)\n                                                  (> (at g r ic) 0))\n                                                (range (+ top-r 1) bot-r))\n                                        (filter (lambda (c)\n                                                  (> (at g ir c) 0))\n                                                (range (+ left-c 1)\n                                                       right-c))))\n                               (pos (if vert? ir ic)))\n                          (if (and (not (null? occ))\n                                   (if from-wall?\n                                       (<= pos (max-list occ))\n                                       (>= pos (min-list occ))))\n                              scatter-color\n                              0))))))))",
