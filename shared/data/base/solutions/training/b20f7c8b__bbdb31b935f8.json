  "needs_conversion": false,
  "raw_code": "(rule!\n ;; A key panel (cornered by cyan 8s) lists one GLYPH per color. The\n ;; 5x5 tiles elsewhere flip between two encodings: a tile showing a\n ;; blue(1) glyph on a base color becomes SOLID in the glyph's key\n ;; color (matched up to rotation/flip); a solid key-colored tile\n ;; becomes patterned — filled with the shared pattern base, its key\n ;; glyph drawn in blue at the tile interior.\n (lambda (g)\n   (let ()\n     (define (sorted-cells cells) (sort cells cell<))\n     (define (norm cells)\n       (if (empty? cells)\n           (list)\n           (sorted-cells\n            (map (lambda (p)\n                   (list (- (first p) (min-of first cells))\n                         (- (second p) (min-of second cells))))\n                 cells))))\n     (define (spin p idx)  ;; the 8 dihedral images of a cell\n       (let ((r (first p)) (c (second p)))\n         (cond ((zero? idx) (list r c))\n               ((= idx 1) (list c (- r)))\n               ((= idx 2) (list (- r) (- c)))\n               ((= idx 3) (list (- c) r))\n               ((= idx 4) (list r (- c)))\n               ((= idx 5) (list (- c) (- r)))\n               ((= idx 6) (list (- r) c))\n               (else (list c r)))))\n     (define (dihedral cells)\n       (map (lambda (idx) (norm (map (lambda (p) (spin p idx)) cells)))\n            (range 0 8)))\n     (define kb (bbox-of-cells (find-color g 8)))\n     (define key-entries  ;; (color glyph glyph-orientations)\n       (filter (lambda (x) x)\n               (map (lambda (color)\n                      (let ((cells\n                             (filter (lambda (p)\n                                       (and (>= (first p)\n                                                (max 0 (- (first kb) 1)))\n                                            (< (first p)\n                                               (min h (+ (third kb) 2)))\n                                            (>= (second p)\n                                                (max 0 (- (second kb) 1)))\n                                            (< (second p)\n                                               (min w (+ (fourth kb) 2)))))\n                                     (find-color g color))))\n                        (and (not (empty? cells))\n                             (let ((rels (norm cells)))\n                               (list color rels (dihedral rels))))))\n                    (filter (lambda (v) (and (not (= v 0)) (not (= v 8))))\n                            (remove-duplicates\n                             (map third (grid-cells g)))))))\n     (define tiles  ;; (obj base blue-glyph solid?) per clean 5x5 tile\n       (map (lambda (obj)\n              (let* ((vals (map (lambda (p) (at g (first p) (second p)))\n                                (obj-cells obj)))\n                     (solid? (= 1 (length (remove-duplicates vals)))))\n                (list obj\n                      (if solid?\n                          (first vals)\n                          (mode-list (filter (lambda (v) (not (= v 1)))\n                                             vals)))\n                      (if solid?\n                          (list)\n                          (sorted-cells\n                           (map (lambda (p)\n                                  (list (- (first p) (+ (obj-r1 obj) 1))\n                                        (- (second p)\n                                           (+ (obj-c1 obj) 1))))\n                                (filter (lambda (p)\n                                          (= (at g (first p) (second p))\n                                             1))\n                                        (obj-cells obj)))))\n                      solid?)))\n            (filter (lambda (o)\n                      (and (= (obj-h o) 5) (= (obj-w o) 5)\n                           (= (obj-size o) 25)\n                           (not (any? (lambda (p)\n                                        (= (at g (first p) (second p)) 8))\n                                      (obj-cells o)))))\n                    (objects-multicolor g 0))))\n     (define pattern-base\n       (let ((bases (map second\n                         (filter (lambda (t) (not (empty? (third t))))\n                                 tiles))))\n         (if (empty? bases) 2 (mode-list bases))))\n     (define (fill-tile out obj color)\n       (for*/fold ((acc out)) ((r (range (obj-r1 obj)\n                                         (+ (obj-r1 obj) 5)))\n                               (c (range (obj-c1 obj)\n                                         (+ (obj-c1 obj) 5))))\n         (set-cell acc r c color)))\n     (for/fold ((out g)) ((t (in-list tiles)))\n       (let ((obj (first t)))\n         (if (fourth t)  ;; solid tile -> draw its color's glyph\n             (let ((entry (find-first (lambda (e) (= (first e)\n                                                     (second t)))\n                                      key-entries)))\n               (if entry\n                   (paint-cells (fill-tile out obj pattern-base)\n                                (map (lambda (p)\n                                       (list (+ (obj-r1 obj) 1 (first p))\n                                             (+ (obj-c1 obj) 1\n                                                (second p))))\n                                     (second entry))\n                                1)\n                   out))\n             (let ((entry (find-first  ;; glyph tile -> solid key color\n                           (lambda (e) (member (third t) (third e)))\n                           key-entries)))\n               (if entry (fill-tile out obj (first entry)) out))))))))",
