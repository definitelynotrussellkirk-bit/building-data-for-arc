    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g)))\n    ;; Every non-zero input cell contributes one complete doubled NW-SE\n    ;; diagonal. The authoritative selected source is the exact canonical\n    ;; program below; this formatted copy is preserved for human/model context.\n    (let* ((colored\n             (filter\n               (lambda (p)\n                 (!= (at g (first p) (second p)) 0))\n               (grid-positions g))))\n      (build-grid (* 2 h) (* 2 w) (r c)\n        (let* ((sr (quotient r 2))\n               (sc (quotient c 2))\n               (v (at g sr sc)))\n          (cond\n            ;; Preserve every doubled source block before painting trails.\n            ((!= v 0) v)\n            ;; Paint color 1 on the full diagonal through each doubled anchor.\n            ((any?\n               (lambda (p)\n                 (= (- r c) (* 2 (- (first p) (second p)))))\n               colored)\n             1)\n            (else 0))))))))",
