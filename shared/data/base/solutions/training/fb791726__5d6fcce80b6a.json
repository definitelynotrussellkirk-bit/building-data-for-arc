    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g)) (w (cols g)) (oh (* h 2)) (ow (* w 2))\n         (has-color? (lambda (r)\n           (find (lambda (c) (not (= (cell-at g r c) 0))) (range 0 w))))\n         (colored-rows (filter has-color? (range 0 h)))\n         (max-colored (if (empty? colored-rows) 0 (max-list colored-rows)))\n         (is-sep? (lambda (r) (and (not (has-color? r)) (<= r max-colored)))))\n    (grid-from-fn oh ow (lambda (r c)\n      (let ((tr (remainder r h)) (br (quotient r h))\n            (tc (remainder c w)) (bc (quotient c w)))\n        (cond ((is-sep? tr) 3)\n              ((= br bc) (cell-at g tr tc))\n              (else 0))))))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (let* ((oh (* h 2))\n                  (ow (* w 2))\n                  (has-color? (lambda (r)\n                                (find (lambda (c) (!= (at g r c) 0)) (range 0 w))))\n                  (colored-rows (filter has-color? (range 0 h)))\n                  (max-colored (if (empty? colored-rows) 0 (max-list colored-rows)))\n                  (is-sep? (lambda (r) (and (not (has-color? r)) (<= r max-colored)))))\n             (build-grid oh\n                         ow\n                         (r c)\n                         (let ((tr (remainder r h))\n                               (br (quotient r h))\n                               (tc (remainder c w))\n                               (bc (quotient c w)))\n                           (cond ((is-sep? tr) 3) ((= br bc) (at g tr tc)) (else 0))))))))",
