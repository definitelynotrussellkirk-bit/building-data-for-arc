    "raw_code": "(rule! (lambda (g)\n  (let ((h (rows g)) (w (cols g))\n        (color (first (filter (lambda (v) (!= v 0)) (grid-colors g)))))\n    (grid-from-fn h w (lambda (r c)\n      (if (or (= r 0) (= r (- h 1)) (= c 0) (= c (- w 1))) color 0))))))",
    "solution_language": "racket",
