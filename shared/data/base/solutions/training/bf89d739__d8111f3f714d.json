    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         (reds (for*/list ((r (range 0 h)) (c (range 0 w))\n                  #:when (= (cell-at g r c) 2))\n                  (list r c)))\n         ;; Find trunk: pair of reds sharing row or col\n         (pairs (for*/list ((i (range 0 (length reds)))\n                            (j (range (+ i 1) (length reds)))\n                            #:when (let ((a (list-ref reds i)) (bb (list-ref reds j)))\n                                     (or (= (first a) (first bb))\n                                         (= (second a) (second bb)))))\n                  (list (list-ref reds i) (list-ref reds j))))\n         (trunk-pair (first pairs))\n         (t1 (first trunk-pair))\n         (t2 (second trunk-pair))\n         (result (make-hash)))\n    (for* ((r (range 0 h)) (c (range 0 w)))\n      (hash-set! result (list r c) (cell-at g r c)))\n    (if (= (second t1) (second t2))\n        ;; Vertical trunk at shared col\n        (let ((tc (second t1))\n              (r1 (min (first t1) (first t2)))\n              (r2 (max (first t1) (first t2))))\n          (for ((r (range (+ r1 1) r2)))\n            (hash-set! result (list r tc) 3))\n          (for ((red reds))\n            (when (and (not (equal? red t1)) (not (equal? red t2)))\n              (let ((rr (first red)) (rc (second red)))\n                (if (< rc tc)\n                    (for ((cc (range (+ rc 1) tc)))\n                      (hash-set! result (list rr cc) 3))\n                    (for ((cc (range (+ tc 1) rc)))\n                      (hash-set! result (list rr cc) 3)))))))\n        ;; Horizontal trunk at shared row\n        (let ((tr (first t1))\n              (c1 (min (second t1) (second t2)))\n              (c2 (max (second t1) (second t2))))\n          (for ((cc (range (+ c1 1) c2)))\n            (hash-set! result (list tr cc) 3))\n          (for ((red reds))\n            (when (and (not (equal? red t1)) (not (equal? red t2)))\n              (let ((rr (first red)) (rc (second red)))\n                (if (< rr tr)\n                    (for ((r (range (+ rr 1) tr)))\n                      (hash-set! result (list r rc) 3))\n                    (for ((r (range (+ tr 1) rr)))\n                      (hash-set! result (list r rc) 3))))))))\n    (grid-from-fn h w\n      (lambda (r c)\n        (hash-ref result (list r c) 0))))))",
