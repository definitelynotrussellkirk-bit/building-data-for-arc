    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  ;; The single colored cell in the 3x3 input anchors a 9x9 CLOCKWISE SQUARE SPIRAL: marker at\n  ;; (r,c) -> spiral anchor (4r,4c). The turtle starts NORTH and walks segments of 2,2,4,4,6,6,...\n  ;; cells, turning clockwise after each; cells outside the canvas are clipped. Drawn in the\n  ;; marker's color on a blank 9x9.\n  (let* ((mk (first (positions-of g (lambda (v) (!= v 0)))))\n         (color (at g (first mk) (second mk)))\n         (dirs (list (list -1 0) (list 0 1) (list 1 0) (list 0 -1)))\n         (ar (* 4 (first mk))) (ac (* 4 (second mk)))\n         (cells\n          (let walk ((k 1) (r ar) (c ac) (d 0) (acc (list (list ar ac))))\n            (if (> k 30) acc\n                (let* ((dr (first (list-ref dirs d))) (dc (second (list-ref dirs d))))\n                  (let seg ((i 0) (rr r) (cc c) (a acc))\n                    (if (= i (* 2 (quotient (+ k 1) 2)))\n                        (walk (+ k 1) rr cc (modulo (+ d 1) 4) a)\n                        (seg (+ i 1) (+ rr dr) (+ cc dc)\n                             (cons (list (+ rr dr) (+ cc dc)) a)))))))))\n    (recolor-cells (empty-grid 9 9)\n                   (filter (lambda (p) (in-bounds? (first p) (second p) 9 9)) cells)\n                   color))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n  ;; The single colored cell in the 3x3 input anchors a 9x9 CLOCKWISE SQUARE SPIRAL: marker at\n  ;; (r,c) -> spiral anchor (4r,4c). The turtle starts NORTH and walks segments of 2,2,4,4,6,6,...\n  ;; cells, turning clockwise after each; cells outside the canvas are clipped. Drawn in the\n  ;; marker's color on a blank 9x9.\n  (let* ((mk (first (positions-of g (lambda (v) (!= v 0)))))\n         (color (at g (first mk) (second mk)))\n         (dirs (list (list -1 0) (list 0 1) (list 1 0) (list 0 -1)))\n         (ar (* 4 (first mk))) (ac (* 4 (second mk)))\n         (cells\n          (let walk ((k 1) (r ar) (c ac) (d 0) (acc (list (list ar ac))))\n            (if (> k 30) acc\n                (let* ((dr (first (list-ref dirs d))) (dc (second (list-ref dirs d))))\n                  (let seg ((i 0) (rr r) (cc c) (a acc))\n                    (if (= i (* 2 (quotient (+ k 1) 2)))\n                        (walk (+ k 1) rr cc (modulo (+ d 1) 4) a)\n                        (seg (+ i 1) (+ rr dr) (+ cc dc)\n                             (cons (list (+ rr dr) (+ cc dc)) a)))))))))\n    (recolor-cells (empty-grid 9 9)\n                   (filter (lambda (p) (in-bounds? (first p) (second p) 9 9)) cells)\n                   color))))",
