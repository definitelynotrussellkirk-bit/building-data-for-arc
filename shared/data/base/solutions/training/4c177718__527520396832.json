  "needs_conversion": false,
  "raw_code": "(rule!\n ;; A gray(5) divider row splits the board. Above it sit a red(2)\n ;; ARROW (its solid bar row marks the direction it points) and a\n ;; colored ATTACHMENT shape; below sits the BASE shape. Output the\n ;; bottom half with the attachment glued to the base — beneath it\n ;; when the arrow points down (bar on top), above when up — aligned\n ;; to the base's left edge.\n (lambda (g)\n   (let ()\n     (define divider\n       (find-first (lambda (r) (all? (lambda (c) (= (at g r c) 5))\n                                     (range 0 w)))\n                   (range 0 h)))\n     (define (cells-in r1 r2 color)\n       (filter (lambda (p) (and (>= (first p) r1) (< (first p) r2)))\n               (find-color g color)))\n     (define (region-colors r1 r2)\n       (remove-duplicates\n        (filter (lambda (v) (and (> v 0) (not (= v 5))))\n                (flatmap (lambda (r) (row g r)) (range r1 r2)))))\n     (define bottom-color (first (region-colors (+ divider 1) h)))\n     (define other-color\n       (find-first (lambda (c) (and (not (= c 2))\n                                    (not (= c bottom-color))))\n                   (region-colors 0 divider)))\n     (define t-cells (cells-in 0 divider 2))\n     (define bar-row  ;; the arrow's solid bar = its most crowded row\n       (pick-max (remove-duplicates (map first t-cells))\n                 (lambda (r) (count-if (lambda (p) (= (first p) r))\n                                       t-cells))))\n     (define t-down (= bar-row (min-of first t-cells)))\n     (define b-cells (cells-in (+ divider 1) h bottom-color))\n     (define o-cells (cells-in 0 divider other-color))\n     (define o-r1 (min-of first o-cells))\n     (define o-c1 (min-of second o-cells))\n     (define o-h (+ 1 (- (max-of first o-cells) o-r1)))\n     (define new-b-r1 (- (min-of first b-cells) divider 1))\n     (define new-o-r1\n       (if t-down\n           (+ new-b-r1 (+ 1 (- (max-of first b-cells)\n                               (min-of first b-cells))))\n           (- new-b-r1 o-h)))\n     (define new-o-c1 (min-of second b-cells))\n     (define out-h (- h divider 1))\n     (for/fold ((out (subgrid g (+ divider 1) 0 (- h 1) (- w 1))))\n               ((p (in-list o-cells)))\n       (let ((nr (+ (- (first p) o-r1) new-o-r1))\n             (nc (+ (- (second p) o-c1) new-o-c1)))\n         (if (in-bounds? nr nc out-h w)\n             (set-cell out nr nc other-color)\n             out))))))",
