    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         ;; Find bbox of 5-cells\n         (fives (for*/list ((r (range 0 h)) (c (range 0 w))\n                   #:when (= (cell-at g r c) 5)) (list r c)))\n         (r1 (apply min (map first fives)))\n         (c1 (apply min (map second fives)))\n         ;; Build 3x3 meta grid from 3x3 blocks\n         (meta (grid-from-fn 3 3\n                 (lambda (br bc)\n                   (if (= (cell-at g (+ r1 (* br 3)) (+ c1 (* bc 3))) 5) 5 0)))))\n    ;; Self-tile: output cell is 5 if both meta[block] and meta[sub] are 5\n    (grid-from-fn 9 9\n      (lambda (r c)\n        (if (and (= (cell-at meta (quotient r 3) (quotient c 3)) 5)\n                 (= (cell-at meta (remainder r 3) (remainder c 3)) 5))\n            5 0))))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (let* ((fives (for*/list ((r (range 0 h)) (c (range 0 w)) #:when (= (at g r c) 5))\n                           (list r c)))\n                  (r1 (min-of first fives))\n                  (c1 (min-of second fives))\n                  (meta (build-grid 3\n                                    3\n                                    (br bc)\n                                    (if (= (at g (+ r1 (* br 3)) (+ c1 (* bc 3))) 5)\n                                        5\n                                        0))))\n             (self-tile meta (lambda (v) (= v 5)))))))",
    "target_status": "verified_racket_available"
  },
