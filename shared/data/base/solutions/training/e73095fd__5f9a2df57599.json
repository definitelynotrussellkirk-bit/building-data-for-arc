 "description_target": {
  "target_text": "Treat gray (5) as walls and find each orthogonally connected black zero region. Paint a region yellow (4) only when the complete rows just above and below its bounding box are gray and the complete columns just left and right are gray. The left and right canvas edges count as walls, but the top and bottom edges do not; exclude any multi-row region confined to column zero.",
  "target_status": "verified_semantic_rule",
  "source": "canonical executable program",
  "solution_steps": [
   "Find connected objects while treating gray (5) as background, yielding the black zero regions separated by gray walls.",
   "For each zero region, compute its top, left, bottom, and right bounding-box coordinates.",
   "Require an in-bounds row of gray cells immediately above the full bounding-box width.",
   "Require an in-bounds row of gray cells immediately below the full bounding-box width.",
   "Require a gray column immediately left of the full bounding-box height, unless the region already touches the left canvas edge.",
   "Require a gray column immediately right of the full bounding-box height, unless the region already touches the right canvas edge.",
   "Reject a region spanning multiple rows when its bounding box is only column zero, even if every wall condition passes.",
   "Paint every cell of each qualifying zero object yellow (4), leaving rejected zero regions and all gray walls unchanged."
  ],
  "puzzle_concepts": [
   "connected zero-region segmentation",
   "bounding-box wall testing",
   "complete-side quantification",
   "asymmetric canvas-edge semantics",
   "special left-edge exclusion",
   "selective object recoloring"
  ],
  "semantic_primitives": [
   "objects",
   "paint-objects-by",
   "with-bbox",
   "for/and",
   "range",
   "at",
   "obj-color",
   "zero?"
  ],
  "generator_parameters": [
   "scene_profile"
  ],
  "negative_constraints": [
   "Do not identify gray rectangles first; the selected objects are connected zero regions.",
   "Do not require the selected zero region itself to be rectangular; test walls around its bounding box and recolor only object cells.",
   "Do not accept a partial side: every cell along each required bounding-box side must be gray.",
   "Do not treat top or bottom canvas boundaries as walls; both horizontal walls must be in bounds.",
   "Do not reject all side-edge regions; left and right canvas boundaries normally satisfy their corresponding wall condition.",
   "Do not fill a multi-row one-column region at column zero because the canonical rule explicitly excludes it.",
   "Do not recolor gray walls or rejected parts of the surrounding zero field."
  ],
  "ambiguity_notes": "The rule is an object/bounding-box predicate, not a rectangular-frame detector. The left and right edge clauses are intentionally asymmetric with top and bottom. The final column-zero vertical exclusion is independently observable in the fourth public scene and in hard generalized lessons.",
