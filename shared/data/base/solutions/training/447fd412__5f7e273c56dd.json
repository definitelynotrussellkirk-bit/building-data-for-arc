  "needs_conversion": false,
  "raw_code": "(rule!\n ;; A TEMPLATE shape (blue 1 body with red 2 marker cells stuck to it)\n ;; plus scattered solid red squares. Each red square is one marker of\n ;; a scaled-up phantom copy (square side = scale): find the marker\n ;; whose implied origin puts EVERY template marker on a red square,\n ;; then stamp the whole template there at that scale. Keep the\n ;; template and squares; everything else clears.\n (lambda (g)\n   (let ()\n     (define one-cells (find-color g 1))\n     (define two-cells (find-color g 2))\n     (define template-twos  ;; red cells touching the blue body\n       (filter (lambda (tc)\n                 (any? (lambda (d) (member (list (+ (first tc) (first d))\n                                                 (+ (second tc)\n                                                    (second d)))\n                                           one-cells))\n                       cardinal-deltas))\n               two-cells))\n     (define standalone-twos\n       (filter (lambda (c) (not (member c template-twos))) two-cells))\n     (define tmpl-box (bbox-of-cells (append one-cells template-twos)))\n     (define tmpl  ;; normalized template: 1 body / 2 marker / 0 empty\n       (grid-from-fn (+ 1 (- (third tmpl-box) (first tmpl-box)))\n                     (+ 1 (- (fourth tmpl-box) (second tmpl-box)))\n                     (lambda (r c)\n                       (let ((gr (+ (first tmpl-box) r))\n                             (gc (+ (second tmpl-box) c)))\n                         (cond ((= (at g gr gc) 1) 1)\n                               ((member (list gr gc) template-twos) 2)\n                               (else 0))))))\n     (define markers\n       (filter (lambda (p) (= (at tmpl (first p) (second p)) 2))\n               (grid-positions tmpl)))\n     (define blocks  ;; 4-connected components of the standalone reds\n       (map obj-cells\n            (objects (paint-cells (empty-grid h w 0) standalone-twos 1)\n                     0)))\n     (define (stamp out origin-r origin-c scale)\n       (for*/fold ((acc out)) ((p (grid-positions tmpl))\n                               (dr (range 0 scale)) (dc (range 0 scale)))\n         (let ((tv (at tmpl (first p) (second p)))\n               (pr (+ origin-r (* (first p) scale) dr))\n               (pc (+ origin-c (* (second p) scale) dc)))\n           (if (and (> tv 0) (in-bounds? pr pc h w))\n               (set-cell acc pr pc tv)\n               acc))))\n     (define base\n       (paint-cells (paint-cells (empty-grid h w 0) one-cells 1)\n                    (append template-twos standalone-twos) 2))\n     (let loop ((bs blocks) (placed (list)) (out base))\n       (if (null? bs)\n           out\n           (let* ((bb (bbox-of-cells (first bs)))\n                  (scale (+ 1 (- (third bb) (first bb))))\n                  (hit  ;; (key stamp?) for the first origin already\n                        ;; placed or fully landing on red squares\n                   (let try ((ms markers))\n                     (if (null? ms)\n                         #f\n                         (let ((key (list (- (first bb)\n                                             (* (first (first ms)) scale))\n                                          (- (second bb)\n                                             (* (second (first ms)) scale))\n                                     scale)))\n                           (cond ((member key placed) (list key #f))\n                                 ((all? (lambda (m)\n                                          (member\n                                           (list (+ (first key)\n                                                    (* (first m) scale))\n                                                 (+ (second key)\n                                                    (* (second m) scale)))\n                                           standalone-twos))\n                                        markers)\n                                  (list key #t))\n                                 (else (try (rest ms)))))))))\n             (if (and hit (second hit))\n                 (loop (rest bs) (cons (first hit) placed)\n                       (stamp out (first (first hit)) (second (first hit))\n                              scale))\n                 (loop (rest bs) placed out))))))))",
  "solution_language": "racket",
