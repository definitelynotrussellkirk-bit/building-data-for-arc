    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g)) (w (cols g))\n         (cells (filter (lambda (p) (not (= (cell-at g (fst p) (snd p)) 0))) (grid-positions g)))\n         (seed (fst cells))\n         (color (cell-at g (fst seed) (snd seed)))\n         (sc (snd seed))\n         (base (reduce (lambda (acc c)\n                 (reduce (lambda (a r) (set-cell a r c color)) acc (range 0 h)))\n                 (grid-from-fn h w (lambda (r c) 0))\n                 (filter (lambda (c) (= (remainder (- c sc) 2) 0)) (range sc w)))))\n    (reduce (lambda (acc i)\n      (let ((gc (+ sc 1 (* 2 i))))\n        (if (>= gc w) acc\n          (set-cell acc (if (= (remainder i 2) 0) 0 (- h 1)) gc 5))))\n      base (range 0 w)))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g)))\n    ;; Read the unique nonzero seed that anchors the periodic pattern.\n    (let* ((cells (filter\n                    (lambda (p) (!= (at g (fst p) (snd p)) 0))\n                    (grid-positions g)))\n           (seed (fst cells))\n           (color (at g (fst seed) (snd seed)))\n           (sc (snd seed))\n           ;; Paint seed-colored vertical stripes every two columns rightward.\n           (base (reduce\n                   (lambda (acc c)\n                     (reduce\n                       (lambda (a r) (set-cell a r c color))\n                       acc\n                       (range 0 h)))\n                   (cellmap g (r c v) 0)\n                   (filter\n                     (lambda (c) (zero? (remainder (- c sc) 2)))\n                     (range sc w)))))\n      ;; Fill intervening columns with gray markers, alternating top/bottom.\n      (reduce\n        (lambda (acc i)\n          (let ((gc (+ sc 1 (* 2 i))))\n            (if (>= gc w)\n                acc\n                (set-cell\n                  acc\n                  (if (zero? (remainder i 2)) 0 (- h 1))\n                  gc\n                  5))))\n        base\n        (range 0 w))))))",
