    "raw_code": "(rule! (lambda (g)\n  (define h (rows g))\n  (define w (cols g))\n  (define marks (find-color g 3))\n  (define max-d (max h w))\n  (define (near-mark? a b)\n    (let ((dr (abs (- (first a) (first b))))\n          (dc (abs (- (second a) (second b)))))\n      (and (<= (max dr dc) 2)\n           (or (= dr dc) (= dr 0) (= dc 0)))))\n  (define (mark-groups ms)\n    (define seen (make-hash))\n    (define groups (list))\n    (for ([m ms])\n      (when (not (hash-has-key? seen m))\n        (define comp (list))\n        (define queue (list m))\n        (hash-set! seen m #t)\n        (define (bfs)\n          (when (not (empty? queue))\n            (define cur (first queue))\n            (set! queue (rest queue))\n            (set! comp (cons cur comp))\n            (for ([n ms])\n              (when (and (not (hash-has-key? seen n)) (near-mark? cur n))\n                (hash-set! seen n #t)\n                (set! queue (append queue (list n)))))\n            (bfs)))\n        (bfs)\n        (set! groups (cons comp groups))))\n    groups)\n  (define groups (mark-groups marks))\n  (define (in-bounds-cell? p)\n    (and (>= (first p) 0) (< (first p) h)\n         (>= (second p) 0) (< (second p) w)))\n  (define (arm-cell orient ar ac k side)\n    (cond [(= orient 0)\n           (list (+ ar k) (+ ac (if (= side 0) (- k) k)))]\n          [(= orient 1)\n           (list (- ar k) (+ ac (if (= side 0) (- k) k)))]\n          [(= orient 2)\n           (list (+ ar (if (= side 0) (- k) k)) (+ ac k))]\n          [else\n           (list (+ ar (if (= side 0) (- k) k)) (- ac k))]))\n  (define (arm-count orient ar ac d side grp)\n    (for/sum ([k (range 1 (+ d 1))])\n      (let ((p (arm-cell orient ar ac k side)))\n        (if (and (in-bounds-cell? p) (member? p grp)) 1 0))))\n  (define (far-supported? orient ar ac d grp)\n    (for/or ([side (range 0 2)])\n      (let ((p (arm-cell orient ar ac d side)))\n        (and (in-bounds-cell? p) (member? p grp)))))\n  (define (valid-trian