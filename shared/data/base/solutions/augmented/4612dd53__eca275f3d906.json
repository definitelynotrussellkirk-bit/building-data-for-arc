    "raw_code": "(rule! (lambda (g)\n  (let* ((bb (bbox-of-cells (find-color g 1)))\n         (r1 (first bb)) (c1 (second bb)) (r2 (third bb)) (c2 (fourth bb))\n         (row-blues (map (lambda (r) (row-count g r 1)) (range 0 h)))\n         (col-blues (map (lambda (c) (col-count g c 1)) (range 0 w))))\n    (cellmap g (r c v)\n      (if (= 1 v) 1\n        (if (and (>= r r1) (<= r r2) (>= c c1) (<= c c2) (zero? v))\n          (if (or (>= (nth row-blues r) 4) (>= (nth col-blues c) 4)) 2 0)\n          0))))))",
