    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (define h (rows g))\n  (define w (cols g))\n  (define bg 8)\n\t  (define centers\n\t    (filter (lambda (rc) (= (at g (nth rc 0) (nth rc 1)) 4))\n\t            (grid-positions g)))\n  (define (collect-tail seed)\n    (define (bfs queue acc)\n      (if (null? queue) acc\n          (let* ((p (first queue))\n                 (rq (cdr queue)))\n            (if (any? (lambda (a) (= a p)) acc)\n                (bfs rq acc)\n                (let* ((r (nth p 0)) (c (nth p 1))\n                       (new-acc (cons p acc))\n\t                       (cands (map (lambda (d) (list (+ r (first d)) (+ c (second d)))) all-8-deltas))\n\t                       (good (filter (lambda (nb)\n\t                                       (let ((nr (nth nb 0)) (nc (nth nb 1)))\n\t                                         (and (in-bounds? nr nc h w)\n\t                                              (= (at g nr nc) 1))))\n\t                                     cands)))\n                  (bfs (append rq good) new-acc))))))\n    (bfs (list seed) (list)))\n\t  (define (process-creature center)\n\t    (let* ((cr (nth center 0)) (cc (nth center 1))\n\t           (top (cell-up g cr cc))\n\t           (bot (cell-down g cr cc))\n\t           (lft (cell-left g cr cc))\n\t           (rgt (cell-right g cr cc))\n\t           (tail-dir\n\t             (cond\n\t               ((and (in-bounds? (- cr 2) cc h w) (= (at g (- cr 2) cc) 1)) 'up)\n\t               ((and (in-bounds? (+ cr 2) cc h w) (= (at g (+ cr 2) cc) 1)) 'down)\n\t               ((and (in-bounds? cr (- cc 2) h w) (= (at g cr (- cc 2)) 1)) 'left)\n\t               ((and (in-bounds? cr (+ cc 2) h w) (= (at g cr (+ cc 2)) 1)) 'right)\n\t               (else 'none)))\n           (tail-seed\n             (cond ((= tail-dir 'up) (list (- cr 2) cc))\n                   ((= tail-dir 'down) (list (+ cr 2) cc))\n                   ((= tail-dir 'left) (list cr (- cc 2)))\n                   ((= tail-dir 'right) (list cr (+ cc 2)))\n                   (else (list cr cc))))\n           (tail-cells (collect-tail tail-seed))\n\t           (body-cells (list (list cr cc) (list (- cr 1) cc) (list (+ cr 1) cc)\n\t                             (list cr (- cc 1)) (list cr (+ cc 1))))\n\t           (all-cells (append body-cells tail-cells))\n\t           (bb (bbox-of-cells all-cells))\n\t           (r1 (first bb)) (c1 (second bb))\n\t           (r2 (third bb)) (c2 (fourth bb))\n           (shift\n             (cond ((= tail-dir 'down) (list (- 0 r1) 0))\n                   ((= tail-dir 'up) (list (- (- h 1) r2) 0))\n                   ((= tail-dir 'right) (list 0 (- 0 c1)))\n                   ((= tail-dir 'left) (list 0 (- (- w 1) c2)))\n                   (else (list 0 0))))\n           (dr (nth shift 0)) (dc (nth shift 1))\n           (new-tail (map (lambda (p) (list (+ (nth p 0) dr) (+ (nth p 1) dc))) tail-cells))\n           (new-cr (+ cr dr)) (new-cc (+ cc dc))\n           (new-body\n             (list (list (list new-cr new-cc) 4)\n                   (list (list (- new-cr 1) new-cc) bot)\n                   (list (list (+ new-cr 1) new-cc) top)\n                   (list (list new-cr (- new-cc 1)) rgt)\n                   (list (list new-cr (+ new-cc 1)) lft))))\n      (list all-cells new-body new-tail)))\n\t  (define creatures (map process-creature centers))\n\t  (define erased (erase-cells g (apply append (map first creatures)) bg))\n\t  (reduce (lambda (gg c)\n\t            (let* ((nb (nth c 1)) (nt (nth c 2))\n\t                   (g1 (paint-cells gg nt 1))\n\t                   (body-paints\n\t                    (map (lambda (pair)\n\t                           (list (first (first pair)) (second (first pair)) (second pair)))\n\t                         nb)))\n\t              (paint-cells g1 body-paints)))\n\t          erased creatures)))",
    "solution_language": "racket",
    "target_code": "(rule!\n ;; Creatures: a yellow(4) heart with four colored petals and a blue(1)\n ;; tail rooted two cells out. Each creature flies flush to the wall\n ;; OPPOSITE its tail direction and turns around — petals swap across\n ;; the heart (up<->down, left<->right) — with the tail riding along.\n ;; Vacated cells refill with the cyan(8) background.\n (lambda (g)\n   (let ()\n     (define bg 8)\n     (define (creature center)\n       (let* ((cr (first center)) (cc (second center))\n              (dir (cond ((and (in-bounds? (- cr 2) cc h w)\n                               (= (at g (- cr 2) cc) 1)) 'up)\n                         ((and (in-bounds? (+ cr 2) cc h w)\n                               (= (at g (+ cr 2) cc) 1)) 'down)\n                         ((and (in-bounds? cr (- cc 2) h w)\n                               (= (at g cr (- cc 2)) 1)) 'left)\n                         ((and (in-bounds? cr (+ cc 2) h w)\n                               (= (at g cr (+ cc 2)) 1)) 'right)\n                         (else 'none)))\n              (seed (cond ((eq? dir 'up) (list (- cr 2) cc))\n                          ((eq? dir 'down) (list (+ cr 2) cc))\n                          ((eq? dir 'left) (list cr (- cc 2)))\n                          ((eq? dir 'right) (list cr (+ cc 2)))\n                          (else (list cr cc))))\n              (tail (connected-region g (first seed) (second seed)\n                                      (lambda (r c v) (= v 1)) 8))\n              (body (list (list cr cc) (list (- cr 1) cc)\n                          (list (+ cr 1) cc) (list cr (- cc 1))\n                          (list cr (+ cc 1))))\n              (bb (bbox-of-cells (append body tail)))\n              (dr (cond ((eq? dir 'down) (- 0 (first bb)))\n                        ((eq? dir 'up) (- (- h 1) (third bb)))\n                        (else 0)))\n              (dc (cond ((eq? dir 'right) (- 0 (second bb)))\n                        ((eq? dir 'left) (- (- w 1) (fourth bb)))\n                        (else 0))))\n         (list (append body tail)\n               ;; petals mirror across the heart: the creature turns\n               (list (list (+ cr dr) (+ cc dc) 4)\n                     (list (+ cr dr -1) (+ cc dc) (cell-down g cr cc))\n                     (list (+ cr dr 1) (+ cc dc) (cell-up g cr cc))\n                     (list (+ cr dr) (+ cc dc -1) (cell-right g cr cc))\n                     (list (+ cr dr) (+ cc dc 1) (cell-left g cr cc)))\n               (map (lambda (p) (list (+ (first p) dr)\n                                      (+ (second p) dc)))\n                    tail))))\n     (define creatures\n       (map creature\n            (filter (lambda (p) (= (at g (first p) (second p)) 4))\n                    (grid-positions g))))\n     (for/fold ((out (erase-cells g (flatmap first creatures) bg)))\n               ((c (in-list creatures)))\n       (paint-cells (paint-cells out (third c) 1) (second c))))))",
