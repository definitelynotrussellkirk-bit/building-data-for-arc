    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  ;; Preserve the zero header and skyline, then add two vertical guides.\n  (let* ((h (rows g))\n         (w (cols g)))\n    (let* ((hh (rows g))\n           (ww (cols g))\n           ;; The first color outside {0,1} is the one skyline bar color.\n           (sc #f)\n           (dummy\n             (for* ((r (range 0 hh)) (c (range 0 ww)))\n               (when (and (not sc)\n                          (!= (at g r c) 0)\n                          (!= (at g r c) 1))\n                 (set! sc (at g r c)))))\n           ;; Count each bottom-contiguous bar upward from the last row.\n           (heights\n             (for/list ((c (range 0 ww)))\n               (let loop ((r (- hh 1)) (height 0))\n                 (if (and (>= r 0) (= (at g r c) sc))\n                     (loop (- r 1) (+ height 1))\n                     height))))\n           (max-h (max-list heights))\n           ;; Empty columns are not candidates for the shortest live bar.\n           (min-h (min-list (filter (lambda (x) (> x 0)) heights)))\n           ;; Scan from the right for the tallest tie and from the left for\n           ;; the shortest tie; these directions are answer-bearing.\n           (max-col\n             (let loop ((c (- ww 1)))\n               (if (= (list-ref heights c) max-h)\n                   c\n                   (loop (- c 1)))))\n           (min-col\n             (let loop ((c 0))\n               (if (and (> (list-ref heights c) 0)\n                        (= (list-ref heights c) min-h))\n                   c\n                   (loop (+ c 1)))))\n           (first-row 1)\n           (result (make-hash)))\n      ;; Copy the input before adding guides so evaluation is observationally pure.\n      (for* ((r (range 0 hh)) (c (range 0 ww)))\n        (hash-set! result (list r c) (at g r c)))\n      (for ((r (range first-row (- hh max-h))))\n        (hash-set! result (list r max-col) 4))\n      (for ((r (range first-row (- hh min-h))))\n        (hash-set! result (list r min-col) 9))\n      (build-grid hh ww (r c) (hash-ref result (list r c) 0))))))",
