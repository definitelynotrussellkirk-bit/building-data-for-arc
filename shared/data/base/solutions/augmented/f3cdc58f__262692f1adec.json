    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         ;; Count each color 1-4\n         (counts (make-hash))\n         (dummy (for* ((r (range 0 h)) (c (range 0 w)))\n                  (let ((v (cell-at g r c)))\n                    (when (> v 0)\n                      (hash-set! counts v (+ 1 (hash-ref counts v 0))))))))\n    (grid-from-fn h w\n      (lambda (r c)\n        (let ((color (+ c 1))\n              (cnt (hash-ref counts (+ c 1) 0)))\n          (if (and (<= color 4) (>= r (- h cnt)))\n              color\n              0)))))))",
    "solution_language": "racket",
