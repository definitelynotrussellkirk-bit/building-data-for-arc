    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         (all-objs (objects g 0))\n         (is-rect? (lambda (obj)\n                     (let* ((cells (obj-cells obj))\n                            (bb (obj-bbox obj))\n                            (r1 (nth bb 0)) (c1 (nth bb 1))\n                            (r2 (nth bb 2)) (c2 (nth bb 3))\n                            (expected (* (+ 1 (- r2 r1)) (+ 1 (- c2 c1)))))\n                       (= (length cells) expected))))\n         (rect-obj (first (filter is-rect? all-objs)))\n         (tail-obj (first (filter (lambda (o) (not (is-rect? o))) all-objs)))\n         (tail-cells (obj-cells tail-obj))\n         (tail-color (obj-color tail-obj))\n         (tb (obj-bbox tail-obj))\n         (tr1 (nth tb 0)) (tc1 (nth tb 1))\n         (tr2 (nth tb 2)) (tc2 (nth tb 3))\n         (in-tail? (lambda (r c)\n                     (ormap (lambda (cell)\n                              (and (= (first cell) r) (= (second cell) c)))\n                            tail-cells)))\n         ;; Find all valid rects and pick largest\n         (all-rects\n           (flatmap (lambda (ar1)\n                      (flatmap (lambda (ar2)\n                                 (flatmap (lambda (ac1)\n                                            (flatmap (lambda (ac2)\n                                                       (if (and (<= ar1 ar2) (<= ac1 ac2)\n                                                                (andmap (lambda (r)\n                                                                          (andmap (lambda (c) (in-tail? r c))\n                                                                                  (range ac1 (+ ac2 1))))\n                                                                        (range ar1 (+ ar2 1))))\n                                                           (list (list ar1 ar2 ac1 ac2 \n                                                                       (* (+ 1 (- ar2 ar1)) (+ 1 (- ac2 ac1)))))\n                                                           (list)))\n                                                     (range tc1 (+ tc2 1))))\n                                          (range tc1 (+ tc2 1))))\n                               (range tr1 (+ tr2 1))))\n                    (range tr1 (+ tr2 1))))\n         (sorted-rects (sort-by all-rects (lambda (r) (- 0 (nth r 4)))))\n         (best-rect (first sorted-rects))\n         (body-r1 (nth best-rect 0)) (body-r2 (nth best-rect 1))\n         (body-c1 (nth best-rect 2)) (body-c2 (nth best-rect 3))\n         (non-body-cells (filter (lambda (cell)\n                                   (let ((r (first cell)) (c (second cell)))\n                                     (not (and (>= r body-r1) (<= r body-r2)\n                                               (>= c body-c1) (<= c body-c2)))))\n                                 tail-cells))\n         (above (ormap (lambda (cell) (< (first cell) body-r1)) non-body-cells))\n         (below (ormap (lambda (cell) (> (first cell) body-r2)) non-body-cells))\n         (leftt (ormap (lambda (cell) (< (second cell) body-c1)) non-body-cells))\n         (rightt (ormap (lambda (cell) (> (second cell) body-c2)) non-body-cells))\n         (dr (cond (above -1) (below 1) (else 0)))\n         (dc (cond (leftt -1) (rightt 1) (else 0)))\n         (rb (obj-bbox rect-obj))\n         (rr1 (nth rb 0)) (rc1 (nth rb 1))\n         (rr2 (nth rb 2)) (rc2 (nth rb 3))\n         (steps (cond\n                  ((> dc 0) (- (- rc1 1) body-c2))\n                  ((< dc 0) (- body-c1 (+ rc2 1)))\n                  ((> dr 0) (- (- rr1 1) body-r2))\n                  ((< dr 0) (- body-r1 (+ rr2 1)))\n                  (else 0)))\n\t         (new-r1 (+ body-r1 (* dr steps)))\n\t         (new-r2 (+ body-r2 (* dr steps)))\n\t         (new-c1 (+ body-c1 (* dc steps)))\n\t         (new-c2 (+ body-c2 (* dc steps)))\n\t         (g1 (erase-cells g tail-cells 0))\n\t         (g2 (paint-cells g1 (positions-in-rect new-r1 new-c1 new-r2 new-c2) tail-color)))\n\t    g2)))",
    "solution_language": "racket",
    "target_code": "\n(rule!\n ;; Two objects: a solid rectangle WALL and a creature made of a solid\n ;; BODY with a tail sticking out one side. The tail points AWAY from\n ;; travel: the body slides toward the wall until flush against it, and\n ;; the tail is consumed. Background elsewhere unchanged.\n (lambda (g)\n   (let ()\n     (define objs (objects g 0))\n     (define wall (find-first solid-rect? objs))\n     (define creature\n       (find-first (lambda (o) (not (solid-rect? o))) objs))\n     (define cells (obj-cells creature))\n     (define body  ;; largest solid rectangle inside the creature\n       (rest\n        (for*/fold ((best (list 0 0 0 0 0)))\n                   ((r1 (range (obj-r1 creature)\n                               (+ (obj-r2 creature) 1)))\n                    (r2 (range (obj-r1 creature)\n                               (+ (obj-r2 creature) 1)))\n                    (c1 (range (obj-c1 creature)\n                               (+ (obj-c2 creature) 1)))\n                    (c2 (range (obj-c1 creature)\n                               (+ (obj-c2 creature) 1))))\n          (if (and (<= r1 r2) (<= c1 c2)\n                   (> (* (+ 1 (- r2 r1)) (+ 1 (- c2 c1))) (first best))\n                   (all? (lambda (p) (member p cells))\n                         (positions-in-rect r1 c1 r2 c2)))\n              (list (* (+ 1 (- r2 r1)) (+ 1 (- c2 c1))) r1 r2 c1 c2)\n              best))))\n     (define br1 (first body))\n     (define br2 (second body))\n     (define bc1 (third body))\n     (define bc2 (fourth body))\n     (define tail  ;; creature cells outside the body rect\n       (filter (lambda (p) (not (and (>= (first p) br1)\n                                     (<= (first p) br2)\n                                     (>= (second p) bc1)\n                                     (<= (second p) bc2))))\n               cells))\n     (define dr (cond ((any? (lambda (p) (< (first p) br1)) tail) -1)\n                      ((any? (lambda (p) (> (first p) br2)) tail) 1)\n                      (else 0)))\n     (define dc (cond ((any? (lambda (p) (< (second p) bc1)) tail) -1)\n                      ((any? (lambda (p) (> (second p) bc2)) tail) 1)\n                      (else 0)))\n     (define steps  ;; distance until flush against the wall\n       (cond ((> dc 0) (- (obj-c1 wall) 1 bc2))\n             ((< dc 0) (- bc1 (+ (obj-c2 wall) 1)))\n             ((> dr 0) (- (obj-r1 wall) 1 br2))\n             ((< dr 0) (- br1 (+ (obj-r2 wall) 1)))\n             (else 0)))\n     (paint-cells (erase-cells g cells 0)\n                  (positions-in-rect (+ br1 (* dr steps))\n                                     (+ bc1 (* dc steps))\n                                     (+ br2 (* dr steps))\n                                     (+ bc2 (* dc steps)))\n                  (obj-color creature)))))\n",
