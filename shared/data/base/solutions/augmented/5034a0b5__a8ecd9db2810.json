    "raw_code": ";; The interior mode is background; side midpoint colors define directions.\n;; Preserve the border and clear the interior before moving original cells.\n;; Matching side colors step once inward; blocked or unmatched cells stay put.\n(rule! (lambda (g)\n  (let ((h (rows g)) (w (cols g)))\n    (let ((bg (first (sort-by (unique (reduce append (list)\n                (map (lambda (r) (map (lambda (c) (at g r c)) (range 1 (- w 1)))) (range 1 (- h 1)))))\n              (lambda (v) (- 0 (for/sum ((r (range 1 (- h 1))))\n                                  (for/sum ((c (range 1 (- w 1))))\n                                    (if (= (at g r c) v) 1 0)))))))))\n      (let ((top-c (at g 0 (/ w 2)))\n            (bot-c (at g (- h 1) (/ w 2)))\n            (left-c (at g (/ h 2) 0))\n            (right-c (at g (/ h 2) (- w 1))))\n        (let ((base (grid-from-fn h w (lambda (r c)\n                (if (or (zero? r) (= r (- h 1)) (zero? c) (= c (- w 1)))\n                  (at g r c) bg)))))\n          (reduce (lambda (acc r)\n            (reduce (lambda (acc2 c)\n              (let ((v (at g r c)))\n                (if (= v bg) acc2\n                  (let ((dr (if (= v top-c) -1 (if (= v bot-c) 1 (if (= v left-c) 0 (if (= v right-c) 0 0)))))\n                        (dc (if (= v left-c) -1 (if (= v right-c) 1 (if (= v top-c) 0 (if (= v bot-c) 0 0))))))\n                    (let ((nr (+ r dr)) (nc (+ c dc)))\n                      (if (and (>= nr 1) (<= nr (- h 2)) (>= nc 1) (<= nc (- w 2)))\n                        (set-cell acc2 nr nc v)\n                        (if (or (not (zero? dr)) (not (zero? dc)))\n                          (set-cell acc2 r c v)\n                          (set-cell acc2 r c v))))))))\n              acc (range 1 (- w 1))))\n            base (range 1 (- h 1)))))))))",
