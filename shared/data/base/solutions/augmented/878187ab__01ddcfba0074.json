    "raw_code": "(rule! (lambda (g)\n  (define bg (mode-list (map third (grid-cells g))))\n  (define counts\n    (map (lambda (color)\n      (length (filter (lambda (cell) (= (third cell) color)) (grid-cells g))))\n      (filter (lambda (color) (not (= color bg))) (remove-duplicates (map third (grid-cells g))))))\n  (define H (apply min counts))\n  (define W (apply max counts))\n  (define N 16)\n  (define top (- N H))\n  (define blank (empty-grid N N bg))\n  (for/fold ([out blank]) ([i (range 0 H)])\n    (define idx (+ (- W H) i))\n    (define left (min idx (- W 1 idx)))\n    (define right (- W 1 left))\n    (define row-filled\n      (for/fold ([gg out]) ([c (range 0 W)])\n        (set-cell gg (+ top i) c 2)))\n    (set-cell (set-cell row-filled (+ top i) left 4) (+ top i) right 4))))",
