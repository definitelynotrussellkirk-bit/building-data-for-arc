    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         (cells\n          (for*/list ((r (range 0 h)) (c (range 0 w))\n                      #:when (not (= (cell-at g r c) 0)))\n            (list r c (cell-at g r c))))\n         (sorted-cells\n          (sort cells\n                (lambda (a b)\n                  (if (= (second a) (second b))\n                      (< (first a) (first b))\n                      (< (second a) (second b))))))\n         (colors (map third sorted-cells)))\n    (grid-from-fn 3 3\n      (lambda (r c)\n        (let* ((idx (if (= (remainder r 2) 0)\n                        (+ (* r 3) c)\n                        (+ (* r 3) (- 2 c)))))\n          (if (< idx (length colors))\n              (list-ref colors idx)\n              0)))))))",
    "solution_language": "racket",
    "target_code": "(rule!\n  (lambda (g)\n    (let* ((h (rows g))\n           (w (cols g))\n           ;; Keep each colored cell as an independent (row, column, color)\n           ;; record, then order records by column and break ties by row.\n           (cells\n            (for*/list ((r (range 0 h))\n                        (c (range 0 w))\n                        #:when (!= (at g r c) 0))\n              (list r c (at g r c))))\n           (sorted-cells\n            (sort cells\n                  (lambda (a b)\n                    (if (= (second a) (second b))\n                        (< (first a) (first b))\n                        (< (second a) (second b))))))\n           (colors (map third sorted-cells)))\n      ;; Pack the ordered colors into a 3x3 snake: even rows run left-to-right\n      ;; and the middle row runs right-to-left; unused cells stay black.\n      (build-grid 3 3 (r c)\n        (let* ((idx\n                (if (zero? (remainder r 2))\n                    (+ (* r 3) c)\n                    (+ (* r 3) (- 2 c)))))\n          (if (< idx (length colors))\n              (list-ref colors idx)\n              0))))))",
    "raw_code_role": "archival_executable_source",
    "target_code_role": "selected_task_rule",
    "target_status": "verified_racket_available"
  },
