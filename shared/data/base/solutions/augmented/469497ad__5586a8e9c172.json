 "content_hash": "5586a8e9c172",
 "description_target": {
  "target_text": "Let N be the number of distinct nonzero input colors and replace every input cell with an N by N block. Nonzero cells become solid same-color blocks. For each zero cell, inspect diagonal neighbours in NW, NE, SW, SE order; the first nonzero diagonal neighbour whose two intervening orthogonal cells are zero draws a red main or anti diagonal in that block.",
  "target_status": "verified_semantic_rule",
  "source": "canonical written solution and executable program",
  "solution_steps": [
   "Collect the distinct nonzero input colors and call their count N.",
   "Create an output with N times the input height and N times the input width.",
   "Map each output cell back to its input cell using quotient and to its local block coordinate using modulo.",
   "Fill every block belonging to a nonzero input cell with that input color.",
   "For a zero input cell, inspect NW, NE, SW, SE diagonal neighbours in that exact order.",
   "A diagonal neighbour qualifies only when it is in bounds and nonzero while both intervening orthogonal neighbours are zero.",
   "Use the first qualifying neighbour: NW or SE draws red on the main block diagonal; NE or SW draws red on the anti diagonal.",
   "Leave the rest of every zero block black."
  ],
  "puzzle_concepts": [
   "input-derived scale factor",
   "cellwise block expansion",
   "concave-corner detection",
   "ordered diagonal-neighbour precedence",
   "red diagonal annotation"
  ],
  "semantic_primitives": [
   "grid-colors",
   "filter",
   "length",
   "build-grid",
   "quotient",
   "modulo",
   "at",
   "in-bounds?",
   "diagonal-deltas",
   "map",
   "first"
  ],
  "generator_parameters": [
   "scene_profile"
  ],
  "negative_constraints": [
   "Do not use total foreground-cell count as the scale factor; count distinct nonzero colors.",
   "Do not merely upscale the input; eligible zero cells receive red diagonal annotations.",
   "Do not treat a diagonal nonzero neighbour as a corner unless both intervening orthogonal neighbours are zero.",
   "Do not combine all eligible directions; the first eligible direction in NW, NE, SW, SE order controls the block.",
   "Do not use red (2) as an ordinary input color in generated lessons.",
   "Do not recolor or outline nonzero blocks."
  ],
  "ambiguity_notes": "The direction order is semantic when a zero cell has multiple eligible diagonal neighbours. In Racket, numeric zero is truthy, so the filtered candidate list retains both red (2) and zero local-pixel results; selecting its first element makes one direction control the entire block. The block-level formulation used by the generator is exactly equivalent.",
  "input_modalities": [
   "task_image",
   "samples"
  ]
 },
