    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((hh (rows g)) (ww (cols g)) (noise 6)\n         (found #f) (tile-pr 1) (tile-pc 1) (tile (make-hash)))\n    (for ((pr (range 1 (+ 1 (quotient hh 2)))))\n      (when (not found)\n        (for ((pc (range 1 (+ 1 (quotient ww 2)))))\n          (when (not found)\n            (let ((t (make-hash)) (ok #t) (complete #t))\n              (for* ((r (range 0 hh)) (c (range 0 ww)))\n                (when ok\n                  (let ((v (cell-at g r c)))\n                    (when (not (= v noise))\n                      (let ((tr (remainder r pr)) (tc (remainder c pc)))\n                        (cond\n                          ((not (hash-has-key? t (list tr tc)))\n                           (hash-set! t (list tr tc) v))\n                          ((not (= (hash-ref t (list tr tc) 0) v))\n                           (set! ok #f))))))))\n              (when ok\n                (for* ((tr (range 0 pr)) (tc (range 0 pc)))\n                  (when (not (hash-has-key? t (list tr tc)))\n                    (set! complete #f))))\n              (when (and ok complete)\n                (set! found #t) (set! tile-pr pr) (set! tile-pc pc) (set! tile t)))))))\n    (grid-from-fn hh ww\n      (lambda (r c) (hash-ref tile (list (remainder r tile-pr) (remainder c tile-pc)) 0))))))",
    "solution_language": "racket",
