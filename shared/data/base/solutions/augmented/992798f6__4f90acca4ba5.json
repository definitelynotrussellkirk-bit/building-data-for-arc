    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         (red-pos\n          (let loop ((r 0) (c 0))\n            (cond\n              ((>= r h) #f)\n              ((>= c w) (loop (+ r 1) 0))\n              ((= (cell-at g r c) 2) (list r c))\n              (else (loop r (+ c 1))))))\n         (blue-pos\n          (let loop ((r 0) (c 0))\n            (cond\n              ((>= r h) #f)\n              ((>= c w) (loop (+ r 1) 0))\n              ((= (cell-at g r c) 1) (list r c))\n              (else (loop r (+ c 1))))))\n         (rr (first red-pos))\n         (rc (second red-pos))\n         (br (first blue-pos))\n         (bc (second blue-pos))\n         (drow (if (> br rr) 1 -1))\n         (dcol (if (> bc rc) 1 -1))\n         (dr-abs (abs (- br rr)))\n         (dc-abs (abs (- bc rc)))\n         (max-d (if (> dr-abs dc-abs) dr-abs dc-abs))\n         (straights (- max-d (if (> dr-abs dc-abs) dc-abs dr-abs)))\n         (is-vert (> dr-abs dc-abs))\n         ;; Compute path cells (for each step 1 to max-d-1, compute (r, c))\n         (path-cells\n          (let loop ((step 1) (cur-r rr) (cur-c rc) (acc (list)))\n            (cond\n              ((>= step max-d) (reverse acc))\n              (else\n               (let* ((new-r-c\n                       (cond\n                         ((= step 1) (list (+ cur-r drow) (+ cur-c dcol)))\n                         ((<= step (+ 1 straights))\n                          (if is-vert\n                              (list (+ cur-r drow) cur-c)\n                              (list cur-r (+ cur-c dcol))))\n                         (else (list (+ cur-r drow) (+ cur-c dcol)))))\n                      (nr (first new-r-c))\n                      (nc (second new-r-c)))\n                 (loop (+ step 1) nr nc (cons (list nr nc) acc))))))))\n    (for/fold ((out g)) ((cell path-cells))\n      (set-cell out (first cell) (second cell) 3)))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         ;; Locate the unique red source endpoint.\n         (red-pos\n          (let loop ((r 0) (c 0))\n            (cond\n              ((>= r h) #f)\n              ((>= c w) (loop (+ r 1) 0))\n              ((= (at g r c) 2) (list r c))\n              (else (loop r (+ c 1))))))\n         ;; Locate the unique blue destination endpoint.\n         (blue-pos\n          (let loop ((r 0) (c 0))\n            (cond\n              ((>= r h) #f)\n              ((>= c w) (loop (+ r 1) 0))\n              ((= (at g r c) 1) (list r c))\n              (else (loop r (+ c 1))))))\n         (rr (first red-pos))\n         (rc (second red-pos))\n         (br (first blue-pos))\n         (bc (second blue-pos))\n         ;; Unit signs point from red toward blue.\n         (drow (if (> br rr) 1 -1))\n         (dcol (if (> bc rc) 1 -1))\n         (dr-abs (abs (- br rr)))\n         (dc-abs (abs (- bc rc)))\n         (max-d (if (> dr-abs dc-abs) dr-abs dc-abs))\n         ;; The gap difference is the dominant-axis middle phase length.\n         (straights (- max-d (if (> dr-abs dc-abs) dc-abs dr-abs)))\n         (is-vert (> dr-abs dc-abs))\n         ;; Build interior cells in order: one diagonal, dominant-axis\n         ;; straights, then the remaining diagonals into blue.\n         (path-cells\n          (let loop ((step 1) (cur-r rr) (cur-c rc) (acc (list)))\n            (cond\n              ((>= step max-d) (reverse acc))\n              (else\n               (let* ((new-r-c\n                       (cond\n                         ;; Phase 1: the mandatory first diagonal.\n                         ((= step 1) (list (+ cur-r drow) (+ cur-c dcol)))\n                         ;; Phase 2: contiguous dominant-axis steps.\n                         ((<= step (+ 1 straights))\n                          (if is-vert\n                              (list (+ cur-r drow) cur-c)\n                              (list cur-r (+ cur-c dcol))))\n                         ;; Phase 3: trailing diagonals.\n                         (else (list (+ cur-r drow) (+ cur-c dcol)))))\n                      (nr (first new-r-c))\n                      (nc (second new-r-c)))\n                 (loop (+ step 1) nr nc (cons (list nr nc) acc))))))))\n    ;; Paint only path interiors green; keep both endpoint colors unchanged.\n    (for/fold ((out g)) ((cell path-cells))\n      (set-cell out (first cell) (second cell) 3)))))",
