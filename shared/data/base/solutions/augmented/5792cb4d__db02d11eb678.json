    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g)) (w (cols g)) (bg 8)\n         (cells (for*/list ((r (range 0 h)) (c (range 0 w))\n                  #:when (not (= (cell-at g r c) bg)))\n                 (list r c)))\n         (cell-set (make-hash))\n         (dummy (for ((c cells)) (hash-set! cell-set c #t)))\n         (start #f)\n         (dummy2 (for ((cell cells))\n           (let ((nbrs (length (filter (lambda (n) (hash-has-key? cell-set n))\n                    (list (list (- (first cell) 1) (second cell))\n                          (list (+ (first cell) 1) (second cell))\n                          (list (first cell) (- (second cell) 1))\n                          (list (first cell) (+ (second cell) 1)))))))\n             (when (and (not start) (= nbrs 1))\n               (set! start cell)))))\n         (path (list))\n         (visited (make-hash))\n         (dummy3\n          (let trace ((cur start))\n            (when (and cur (hash-has-key? cell-set cur) (not (hash-has-key? visited cur)))\n              (hash-set! visited cur #t)\n              (set! path (append path (list cur)))\n              (let ((next (find (lambda (n) (and (hash-has-key? cell-set n) (not (hash-has-key? visited n))))\n                           (list (list (- (first cur) 1) (second cur))\n                                 (list (+ (first cur) 1) (second cur))\n                                 (list (first cur) (- (second cur) 1))\n                                 (list (first cur) (+ (second cur) 1))))))\n                (trace next)))))\n         (values (map (lambda (p) (cell-at g (first p) (second p))) path))\n         (rev-values (reverse values))\n         (result (make-hash)))\n    (for* ((r (range 0 h)) (c (range 0 w)))\n      (hash-set! result (list r c) bg))\n    (for ((i (range 0 (length path))))\n      (let ((pos (list-ref path i))\n            (val (list-ref rev-values i)))\n        (hash-set! result pos val)))\n    (grid-from-fn h w (lambda (r c) (hash-ref result (list r c) 0))))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         (bg 8)\n         ;; The non-cyan cells are one unbranched path. Find its cells and\n         ;; choose either degree-one endpoint as the traversal start.\n         (cells\n          (for*/list ((r (range 0 h))\n                      (c (range 0 w))\n                      #:when (not (= (cell-at g r c) bg)))\n            (list r c)))\n         (cell-set (make-hash))\n         (seed-cell-set\n          (for ((cell cells))\n            (hash-set! cell-set cell #t)))\n         (start #f)\n         (find-endpoint\n          (for ((cell cells))\n            (let ((degree\n                   (count-if\n                    (lambda (neighbor) (hash-has-key? cell-set neighbor))\n                    (list (list (- (first cell) 1) (second cell))\n                          (list (+ (first cell) 1) (second cell))\n                          (list (first cell) (- (second cell) 1))\n                          (list (first cell) (+ (second cell) 1))))))\n              (when (and (not start) (= degree 1))\n                (set! start cell)))))\n         ;; Trace the unique path and collect its positions in endpoint order.\n         (path (list))\n         (visited (make-hash))\n         (trace-path\n          (let trace ((current start))\n            (when (and current\n                       (hash-has-key? cell-set current)\n                       (not (hash-has-key? visited current)))\n              (hash-set! visited current #t)\n              (set! path (append path (list current)))\n              (let ((next\n                     (find\n                      (lambda (neighbor)\n                        (and (hash-has-key? cell-set neighbor)\n                             (not (hash-has-key? visited neighbor))))\n                      (list (list (- (first current) 1) (second current))\n                            (list (+ (first current) 1) (second current))\n                            (list (first current) (- (second current) 1))\n                            (list (first current) (+ (second current) 1))))))\n                (trace next)))))\n         ;; Reverse only the color sequence; every path coordinate is retained.\n         (path-colors\n          (map (lambda (position)\n                 (cell-at g (first position) (second position)))\n               path))\n         (reversed-colors (reverse path-colors))\n         (result (make-hash)))\n    (for* ((r (range 0 h)) (c (range 0 w)))\n      (hash-set! result (list r c) bg))\n    (for ((i (range 0 (length path))))\n      (hash-set! result (list-ref path i) (list-ref reversed-colors i)))\n    (grid-from-fn h w\n                  (lambda (r c) (hash-ref result (list r c) bg))))))",
