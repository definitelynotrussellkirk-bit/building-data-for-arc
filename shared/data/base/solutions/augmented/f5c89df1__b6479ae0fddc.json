    "needs_conversion": false,
    "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g)))\n    (begin\n      ;; Find the single green anchor, every red destination, and the cyan template.\n      (define greens (find-color g 3))\n      (define reds (find-color g 2))\n      (define eights (find-color g 8))\n      (define gr (first (first greens)))\n      (define gc (second (first greens)))\n      ;; Preserve every cyan cell as an exact offset from the green anchor.\n      (define offsets\n        (map (lambda (p)\n               (list (- (first p) gr) (- (second p) gc)))\n             eights))\n      ;; Clear the source scene, then stamp the exact offset set at each red marker.\n      (define empty (cellmap g (r c v) 0))\n      (reduce\n        (lambda (gg red)\n          (let ((rr (first red))\n                (rc (second red)))\n            (reduce\n              (lambda (gx off)\n                (let ((nr (+ rr (first off)))\n                      (nc (+ rc (second off))))\n                  (if (and (>= nr 0) (< nr h) (>= nc 0) (< nc w))\n                      (set-cell gx nr nc 8)\n                      gx)))\n              gg\n              offsets)))\n        empty\n        reds)))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (begin\n             (define greens (find-color g 3))\n             (define reds (find-color g 2))\n             (define eights (find-color g 8))\n             (define gr (first (first greens)))\n             (define gc (second (first greens)))\n             (define offsets\n               (map (lambda (p) (list (- (first p) gr) (- (second p) gc))) eights))\n             (define empty (cellmap g (r c v) 0))\n             (reduce (lambda (gg red)\n                       (let ((rr (first red))\n                             (rc (second red)))\n                         (reduce (lambda (gx off)\n                                   (let ((nr (+ rr (first off)))\n                                         (nc (+ rc (second off))))\n                                     (if (and (>= nr 0) (< nr h) (>= nc 0) (< nc w))\n                                         (set-cell gx nr nc 8)\n                                         gx)))\n                                 gg\n                                 offsets)))\n                     empty\n                     reds)))))",
