  "description_target": {
    "target_text": "Ignore zero and gray (5), collect the remaining line colors, and detect orientation: if every color occupies one row, sort colors by row and output solid ordered rows; otherwise sort by first-cell column and repeat the ordered color list as output rows. The output is N by N for N line colors.",
    "target_status": "verified_semantic_rule",
    "source": "canonical written solution and executable program",
    "solution_steps": [
      "Collect every distinct input color except background zero and gray (5).",
      "For each collected color, find all of its cells and its first row-major cell.",
      "Classify the scene as horizontal only when every collected color occupies exactly one row.",
      "For a horizontal scene, sort colors by first-cell row and make each output row one sorted color.",
      "Otherwise, sort colors by first-cell column and repeat that ordered list across every output row.",
      "Use the number of collected colors as both output dimensions; the gray square is ignored even when it occludes lines."
    ],
    "puzzle_concepts": [
      "orientation detection",
      "line-color ordering",
      "ignored gray occluder",
      "position-to-stripe encoding",
      "input-derived output size"
    ],
    "semantic_primitives": [
      "grid-colors",
      "filter",
      "find-color",
      "andmap",
      "unique",
      "sort-by",
      "build-grid"
    ],
    "generator_parameters": [
      "scene_profile"
    ],
    "negative_constraints": [
      "Do not include zero or gray (5) in the ordered output colors.",
      "Do not assume every scene is horizontal; the canonical set includes a vertical case.",
      "Do not require a line color to be contiguous, because the gray square and its moat can split it.",
      "Do not order colors by numeric value, segment length, or gray-square position.",
      "Do not copy the input geometry; output dimensions are the number of relevant colors squared."
    ],
    "ambiguity_notes": "Horizontal is the canonical program's exact predicate: every relevant color has cells in one unique row. Any failure of that predicate selects column ordering. Canonical generated lessons make the alternative branch visibly vertical and use an N by N gray square as an ignored occluder.",
