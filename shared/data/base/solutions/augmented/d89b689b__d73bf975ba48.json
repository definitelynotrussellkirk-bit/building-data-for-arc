    "raw_code": "(rule! (lambda (g)\n  (let* ((cyan (find-color g 8))\n         (cr1 (min-of first cyan))\n         (cc1 (min-of second cyan))\n         (colors (filter (lambda (v) (and (!= v 0) (!= v 8))) (grid-colors g)))\n         (mapping (map (lambda (v)\n           (let ((pos (first (find-color g v))))\n             (list (if (< (first pos) cr1) 0 1) (if (< (second pos) cc1) 0 1) v)))\n           colors)))\n    (reduce (lambda (out m)\n      (let ((rr (+ cr1 (first m))) (cc (+ cc1 (second m))))\n        (if (zero? (at out rr cc)) (set-cell out rr cc (third m)) out)))\n      (empty-grid h w 0) mapping))))",
