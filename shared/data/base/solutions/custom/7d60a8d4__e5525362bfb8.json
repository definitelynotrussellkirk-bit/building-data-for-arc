    "needs_conversion": false,
    "raw_code": "(rule!\n  (let ((centers\n         (filter (lambda (p)\n                   (and (= (at g (first p) (second p)) 3)\n                        (all? (lambda (d)\n                                (let ((nr (+ (first p) (first d)))\n                                      (nc (+ (second p) (second d))))\n                                  (and (in-bounds? nr nc (rows g) (cols g))\n                                       (= (at g nr nc) 3))))\n                              cardinal-deltas)))\n                 (find-color g 3))))\n    (define (sign n) (cond [(< n 0) -1] [(> n 0) 1] [else 0]))\n    (for*/fold ([out g]) ([a (in-list centers)] [b (in-list centers)])\n      (let ((dr (- (first b) (first a)))\n            (dc (- (second b) (second a))))\n        (if (and (< (first a) (first b)) (= (abs dr) (abs dc)) (> (abs dr) 1))\n            (let ((sr (sign dr)) (sc (sign dc)))\n              (for/fold ([cur out]) ([i (in-range 1 (abs dr))])\n                (let ((r (+ (first a) (* i sr)))\n                      (c (+ (second a) (* i sc))))\n                  (if (= (at cur r c) 0) (set-cell cur r c 2) cur))))\n            out)))))",
    "solution_language": "racket",
    "target_code": "(rule! (lambda (g)\n  (let* ((centers (filter\n                    (lambda (rc)\n                      (let* ((r (fst rc)) (c (snd rc)) (h (rows g)) (w (cols g)))\n                        (and (in-bounds? (- r 1) c h w)\n                             (in-bounds? (+ r 1) c h w)\n                             (in-bounds? r (- c 1) h w)\n                             (in-bounds? r (+ c 1) h w)\n                             (= 3 (at g (- r 1) c))\n                             (= 3 (at g (+ r 1) c))\n                             (= 3 (at g r (- c 1)))\n                             (= 3 (at g r (+ c 1))))))\n                    (find-color g 3)))\n         (n (length centers))\n         (pairs (flatmap\n                  (lambda (i)\n                    (map (lambda (j) (list (nth centers i) (nth centers j)))\n                         (range (+ i 1) n)))\n                  (range 0 n))))\n    (foldl\n      (lambda (pr acc)\n        (let* ((a (first pr)) (b (second pr))\n               (ar (fst a)) (ac (snd a))\n               (br (fst b)) (bc (snd b))\n               (dr (- br ar)) (dc (- bc ac)))\n          (if (and (!= dr 0) (= (abs dr) (abs dc)))\n              (let ((sr (if (> dr 0) 1 -1))\n                    (sc (if (> dc 0) 1 -1)))\n                (foldl\n                  (lambda (k a2)\n                    (let ((r (+ ar (* k sr))) (c (+ ac (* k sc))))\n                      (if (zero? (at a2 r c)) (set-cell a2 r c 2) a2)))\n                  acc\n                  (range 1 (abs dr))))\n              acc)))\n      g\n      pairs))))",
