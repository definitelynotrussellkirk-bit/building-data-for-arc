(rule! (lambda (g)
  (let* ((colors (filter (lambda (c) (!= c 0)) (grid-colors g)))
         (counts (map (lambda (c) (list c (length (find-color g c)))) colors))
         (sorted-c (reverse (sort-by counts (lambda (x) (second x)))))
         (dot (first (second sorted-c)))
         (dots (find-color g dot))
         (dr1 (apply min (map first dots)))
         (dr2 (apply max (map first dots)))
         (dc1 (apply min (map second dots)))
         (dc2 (apply max (map second dots)))
         (oh (- (- dr2 dr1) 1))
         (ow (- (- dc2 dc1) 1)))
    (grid-from-fn oh ow (lambda (r c)
      (if (= (cell-at g (+ dr1 2 r) (+ dc1 2 c)) 0) dot 0))))))
