(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((colors (filter (lambda (c) (!= c 0)) (grid-colors g)))
                  (counts (map (lambda (c) (list c (length (find-color g c)))) colors))
                  (sorted-c (reverse (sort-by counts (lambda (x) (second x)))))
                  (big (first (first sorted-c)))
                  (dot (first (second sorted-c)))
                  (dots (find-color g dot))
                  (dr1 (min-of first dots))
                  (dr2 (max-of first dots))
                  (dc1 (min-of second dots))
                  (dc2 (max-of second dots))
                  (oh (- (- dr2 dr1) 1))
                  (ow (- (- dc2 dc1) 1)))
             (build-grid oh ow (r c) (if (= (at g (+ dr1 1 r) (+ dc1 1 c)) big) dot 0))))))