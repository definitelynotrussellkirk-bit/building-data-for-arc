+def _recolor_components(grid, choose_color):
+    components = MOD._components(grid)
+    output = [row[:] for row in grid]
+    for index, component in enumerate(components):
+        color = choose_color(components, index)
+        for row, col in component.cells:
+            output[row][col] = color
+    return output
+
+
+def _nearest_parent_rival(grid):
+    def choose(components, index):
+        parents = [
+            outer
+            for outer in range(len(components))
+            if MOD._strictly_contains(components[outer], components[index])
+        ]
+        if not parents:
+            return components[index].color
+        nearest = min(parents, key=lambda outer: components[outer].area)
+        return components[nearest].color
+
+    return _recolor_components(grid, choose)
+
+
+def _frames_only_rival(grid):
+    def choose(components, index):
+        if MOD._rect_frame_bbox(components[index]) is None:
+            return components[index].color
+        parents = [
+            outer
+            for outer in range(len(components))
+            if MOD._strictly_contains(components[outer], components[index])
+        ]
+        if not parents:
+            return components[index].color
+        outermost = max(parents, key=lambda outer: components[outer].area)
+        return components[outermost].color
+
+    return _recolor_components(grid, choose)
+
+
+def _first_group_only_rival(grid):
+    components = MOD._components(grid)
+    _, roots, descendants = MOD._relations(components)
+    group_roots = [
+        index
+        for index in roots
+        if MOD._rect_frame_bbox(components[index]) is not None and descendants[index]
+    ]
+    if not group_roots:
+        return [row[:] for row in grid]
+    root = group_roots[0]
+
+    def choose(all_components, index):
+        if index == root or MOD._strictly_contains(all_components[root], all_components[index]):
+            return all_components[root].color
+        return all_components[index].color
+
+    return _recolor_components(grid, choose)
+
