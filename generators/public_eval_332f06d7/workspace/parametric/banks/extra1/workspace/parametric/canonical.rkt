(rule!
 (lambda (g)
  (let ()
   (define finish 'move)
   (define h (rows g))
   (define w (cols g))
   (define walls (filter (lambda (x) (not (member x '(0 1 2)))) (grid-colors g)))
   (when (not (= (length walls) 1))
    (error 'boat-navigation "expected exactly one wall color"))
   (define wall (first walls))
   (define zero-cells (find-color g 0))
   (define goal-cells (find-color g 2))
   (when (or (empty? zero-cells) (empty? goal-cells))
    (error 'boat-navigation "missing boat or destination"))
   (define zero-box (bbox-of-cells zero-cells))
   (define goal-box (bbox-of-cells goal-cells))
   (define bh (+ 1 (- (third zero-box) (first zero-box))))
   (define bw (+ 1 (- (fourth zero-box) (second zero-box))))
   (define gh (+ 1 (- (third goal-box) (first goal-box))))
   (define gw (+ 1 (- (fourth goal-box) (second goal-box))))
   (when (or (not (= bh gh)) (not (= bw gw)))
    (error 'boat-navigation "boat and destination sizes differ"))
   (define start (list (first zero-box) (second zero-box)))
   (define goal (list (first goal-box) (second goal-box)))
   (define (window-cells p ph pw)
    (positions-in-rect (first p) (second p)
                       (+ (first p) ph -1) (+ (second p) pw -1)))
   (define (valid-window? p ph pw)
    (and (<= 0 (first p)) (<= 0 (second p))
         (< (+ (first p) ph -1) h) (< (+ (second p) pw -1) w)
         (andmap (lambda (q) (not (= (at g (first q) (second q)) wall)))
                 (window-cells p ph pw))))
   (define valid
    (for*/list ((r (in-range (+ 1 (- h bh))))
                (c (in-range (+ 1 (- w bw))))
                #:when (valid-window? (list r c) bh bw))
     (list r c)))
   (define deltas '((-1 0) (0 -1) (0 1) (1 0)))
   (define (neighbors p allowed)
    (filter
     (lambda (q) (member q allowed))
     (map (lambda (d) (list (+ (first p) (first d))
                            (+ (second p) (second d)))) deltas)))
   (define parent (make-hash))
   (hash-set! parent start #f)
   (define reachable
    (let bfs ((queue (list start)) (seen (list start)) (acc '()))
     (if (empty? queue)
         (reverse acc)
         (let* ((cur (first queue))
                (fresh (filter (lambda (p) (not (member p seen)))
                               (neighbors cur valid))))
          (for ((p (in-list fresh))) (hash-set! parent p cur))
          (bfs (append (rest queue) fresh)
               (append seen fresh)
               (cons cur acc))))))
   (define dead
    (filter (lambda (p)
             (and (not (equal? p start))
                  (<= (length (neighbors p reachable)) 1)))
            reachable))
   (define candidates (if (empty? dead) (list start) dead))
   (define (distance p) (+ (abs (- (first p) (first goal)))
                            (abs (- (second p) (second goal)))))
   (define selected
    (first
     (sort candidates
      (lambda (a b)
       (let ((da (distance a)) (db (distance b)))
        (or (< da db)
            (and (= da db)
                 (or (< (first a) (first b))
                     (and (= (first a) (first b))
                          (< (second a) (second b)))))))))))
   (define route
    (let loop ((p selected) (acc '()))
     (if p (loop (hash-ref parent p #f) (cons p acc)) acc)))
   (define restored (recolor-cells g (window-cells start bh bw) 1))
   (define moved (recolor-cells restored (window-cells selected bh bw) 0))
   (define (mark-swept positions)
    (let* ((before-end (filter (lambda (p) (not (equal? p selected))) positions))
           (swept (remove-duplicates
                   (if (empty? before-end) '()
                       (apply append (map (lambda (p) (window-cells p bh bw)) before-end))))))
     (grid-from-fn h w
      (lambda (r c)
       (if (and (= (at moved r c) 1) (member (list r c) swept))
           9
           (at moved r c))))))
   (cond
    ((eq? finish 'move) moved)
    ((eq? finish 'trace) (mark-swept route))
    ((eq? finish 'all-reachable) (mark-swept reachable))
    (else (error 'boat-navigation "unknown finish mode")))))))
