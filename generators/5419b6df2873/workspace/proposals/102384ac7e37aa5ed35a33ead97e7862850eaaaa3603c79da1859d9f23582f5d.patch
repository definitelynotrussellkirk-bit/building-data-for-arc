@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""Source-bound learnability probe for the always-smallest-frame shortcut.
+
+Given a baseline generator source and this task's current generator, generate the
+five-profile lesson at seed 0/easy, execute all ten labels through protected
+Racket, and compare the canonical selector rule with the plausible shortcut
+"return the strict interior of the smallest frame, breaking ties left-to-right".
+The current source also receives a bounded 300-lesson/1,500-rotation Python
+census over every declared competitor.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parent
+REPO = TASK_HOME.parents[1]
+RUNTIME = REPO / "shared/runtime"
+if str(RUNTIME) not in sys.path:
+    sys.path.insert(0, str(RUNTIME))
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+TASK_ID = "6027a830c96e"
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load(path: Path, label: str):
+    body = path.read_bytes()
+    name = f"_arc_{TASK_ID}_{label}_{hashlib.sha256(body).hexdigest()}"
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    exec(compile(body, str(path), "exec"), module.__dict__)
+    return module
+
+
+def _canonical_program() -> str:
+    ledger = REPO / "shared/data/canonical/puzzles.jsonl"
+    for line in ledger.open(encoding="utf-8"):
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            return row["program_solution"]
+    raise KeyError(TASK_ID)
+
+
+def _area(frame: dict[str, Any]) -> int:
+    top, left, bottom, right = frame["bbox"]
+    return (bottom - top + 1) * (right - left + 1)
+
+
+def _smallest_output(module, grid: list[list[int]]) -> list[list[int]]:
+    facts = module._analyze(grid)
+    if facts["errors"]:
+        raise ValueError(facts["errors"])
+    index = min(range(len(facts["frames"])), key=lambda i: (_area(facts["frames"][i]), i))
+    return module._interior(grid, facts["frames"][index])
+
+
+def _window(module, seed: int = 0, band: str = "easy") -> list[list[list[int]]]:
+    return [module.generate(seed, index, difficulty=band) for index in range(5)]
+
+
+def _racket_labels(program: str, grids: list[list[list[int]]]) -> tuple[list[list[list[int]]], dict[str, Any]]:
+    with RacketBridge(timeout=20.0, startup_timeout=45.0) as bridge:
+        bridge.eval_text(f"(define __probe_rule {wrap_rule(program)})")
+        outputs = []
+        for index, grid in enumerate(grids):
+            symbol = f"__probe_grid_{index}"
+            bridge.define_grid(symbol, grid)
+            outputs.append(bridge.eval_text(f"(__probe_rule {symbol})"))
+        return outputs, bridge.runtime_identity
+
+
+def _lesson_report(module, grids, labels) -> dict[str, Any]:
+    rows = []
+    for index, (grid, label) in enumerate(zip(grids, labels)):
+        facts = module._analyze(grid)
+        rival = _smallest_output(module, grid)
+        rows.append(
+            {
+                "profile_index": index,
+                "input": grid,
+                "racket_output": label,
+                "always_smallest_output": rival,
+                "selected_index": facts["selected_index"],
+                "frame_areas": [_area(frame) for frame in facts["frames"]],
+                "rival_matches": rival == label,
+                "difference_cells": (
+                    None
+                    if len(rival) != len(label) or (rival and label and len(rival[0]) != len(label[0]))
+                    else sum(a != b for ra, rb in zip(rival, label) for a, b in zip(ra, rb))
+                ),
+            }
+        )
+    return {
+        "rows": rows,
+        "demos_0_through_3_all_fit": all(row["rival_matches"] for row in rows[:4]),
+        "query_4_disagrees": not rows[4]["rival_matches"],
+        "every_held_out_rotation_has_demo_refutation": all(
+            any(not rows[index]["rival_matches"] for index in range(5) if index != held)
+            for held in range(5)
+        ),
+    }
+
+
+def _census(module, seeds: int) -> dict[str, Any]:
+    failures = []
+    rotations = 0
+    for band in ("easy", "medium", "hard"):
+        for seed in range(seeds):
+            grids = _window(module, seed, band)
+            truth = [module.rule_mirror(grid) for grid in grids]
+            for held in range(5):
+                demos = [index for index in range(5) if index != held]
+                errors = module.lesson_identifiable(
+                    [{"input": grids[i], "output": truth[i]} for i in demos],
+                    {"input": grids[held], "output": truth[held]},
+                )
+                if errors:
+                    failures.append({"band": band, "seed": seed, "held": held, "errors": errors})
+                for name, rival in module.LESSON_COMPETITORS.items():
+                    if not any(rival(grids[i]) != truth[i] for i in demos):
+                        failures.append({"band": band, "seed": seed, "held": held, "rival": name})
+                rotations += 1
+    return {
+        "status": "failed" if failures else "passed",
+        "seeds_per_band": seeds,
+        "lessons": seeds * 3,
+        "held_out_rotations": rotations,
+        "declared_rivals": sorted(module.LESSON_COMPETITORS),
+        "failures": failures,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline-generator", type=Path, required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seeds", type=int, default=100)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    if not args.baseline_generator.is_file():
+        raise FileNotFoundError(args.baseline_generator)
+    if args.seeds < 1:
+        raise ValueError("--seeds must be positive")
+
+    current_path = TASK_HOME / "generator.py"
+    baseline = _load(args.baseline_generator.resolve(), "baseline")
+    current = _load(current_path, "current")
+    program = _canonical_program()
+    baseline_grids = _window(baseline)
+    current_grids = _window(current)
+    labels, racket = _racket_labels(program, baseline_grids + current_grids)
+    report = {
+        "schema": "arcpuzzles-always-smallest-probe-v1",
+        "task_id": TASK_ID,
+        "baseline_generator_sha256": _sha(args.baseline_generator),
+        "current_generator_sha256": _sha(current_path),
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "racket": racket,
+        "protected_racket_evaluations": 10,
+        "baseline_lesson": _lesson_report(baseline, baseline_grids, labels[:5]),
+        "current_lesson": _lesson_report(current, current_grids, labels[5:]),
+        "current_census": _census(current, args.seeds),
+        "limits": (
+            "Exact seed-0/easy protected-Racket lesson plus a finite Python-mirror census. "
+            "No universal learnability or training-admission claim."
+        ),
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    summary = {
+        "baseline_ambiguity": report["baseline_lesson"]["demos_0_through_3_all_fit"]
+        and report["baseline_lesson"]["query_4_disagrees"],
+        "current_all_rotations_refuted": report["current_lesson"]["every_held_out_rotation_has_demo_refutation"],
+        "census_status": report["current_census"]["status"],
+        "racket_evaluations": 10,
+    }
+    print(json.dumps(summary, sort_keys=True))
+    return 0 if all((summary["baseline_ambiguity"], summary["current_all_rotations_refuted"], summary["census_status"] == "passed")) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
