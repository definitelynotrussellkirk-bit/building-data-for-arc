(rule!
 (let ((dummy 0))
   (define dirs8
     (list (list -1 -1) (list -1 0) (list -1 1)
           (list 0 -1)                (list 0 1)
           (list 1 -1)  (list 1 0)  (list 1 1)))
   (define (components8 grid)
     (let loop-pos ((positions (grid-positions grid)) (seen (list)) (acc (list)))
       (cond
         ((empty? positions) (reverse acc))
         ((or (member? (first positions) seen)
              (= (at grid (first (first positions)) (second (first positions))) 0))
          (loop-pos (rest positions) seen acc))
         (else
          (let ((color (at grid (first (first positions)) (second (first positions)))))
            (let bfs ((queue (list (first positions)))
                      (seen2 (cons (first positions) seen))
                      (cells (list)))
              (if (empty? queue)
                  (loop-pos (rest positions) seen2 (cons (sort cells cell<) acc))
                  (let* ((cur (first queue))
                         (nbrs
                          (filter
                           (lambda (p)
                             (and (in-bounds? (first p) (second p) (rows grid) (cols grid))
                                  (not (member? p seen2))
                                  (= (at grid (first p) (second p)) color)))
                           (map (lambda (d)
                                  (list (+ (first cur) (first d))
                                        (+ (second cur) (second d))))
                                dirs8))))
                    (bfs (append (rest queue) nbrs)
                         (append seen2 nbrs)
                         (cons cur cells))))))))))
   (for/fold ((out (empty-grid (rows g) (cols g) 0)))
             ((cells (in-list (components8 g))))
     (if (any? (lambda (p)
                 (or (= (first p) 0)
                     (= (first p) (- (rows g) 1))
                     (= (second p) 0)
                     (= (second p) (- (cols g) 1))))
               cells)
         (paint-cells out cells (at g (first (first cells)) (second (first cells))))
         out))))
