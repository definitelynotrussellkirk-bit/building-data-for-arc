+++ b/repo/generators/42fb6b33deea/workspace/probe_three_corners.py
@@ -0,0 +1,157 @@
+"""Bounded protected-Racket ambiguity probe; fresh output directory required."""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+TASK = "42fb6b33deea"
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator, public_challenge_bytes, public_challenge_id
+
+RIVAL = """(rule!
+  (for/fold ([out (empty-grid (rows g) (cols g) 0)]) ([color (in-list (grid-colors g 0))])
+    (let* ([cells (find-color g color)] [bb (bbox-of-cells cells)]
+           [corners (list (list (first bb) (second bb)) (list (first bb) (fourth bb))
+                          (list (third bb) (second bb)) (list (third bb) (fourth bb)))])
+      (if (and (= (length cells) 4)
+               (>= (length (filter (lambda (p) (member p corners)) cells)) 3))
+          (paint-cells out (positions-in-rect (first bb) (second bb) (third bb) (fourth bb)) color)
+          out))))
+"""
+
+
+def sha(body):
+    return hashlib.sha256(body).hexdigest()
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args()
+    out = Path(args.out).absolute()
+    if os.path.lexists(out):
+        raise FileExistsError(f"Refusing existing output file, directory, or symlink: {out}")
+    out.mkdir(parents=True, exist_ok=False)
+    private = out / "private"
+    private.mkdir()
+    gen, source, source_hash = load_selected_generator(TASK, root=ROOT)
+    catalog = Catalog(ROOT)
+    rule_task = catalog.describe(TASK).get("rule_task_id", TASK)
+    programs = {row["program_solution"] for row in catalog._variants()[rule_task]}
+    if len(programs) != 1:
+        raise ValueError("Expected exactly one byte-exact canonical program")
+    authority = programs.pop()
+    seed = 424203
+    grids = [gen.generate(seed, i, difficulty="medium") for i in range(4)]
+    for grid in grids:
+        errors = gen.self_check(grid)
+        if errors:
+            raise AssertionError(errors)
+
+    # Preserve the original generated lesson, then construct one lawful stress
+    # query inside the same bbox. Role 0 has no distractors, so no other count
+    # can change when the first target's four cells move.
+    original = grids[3]
+    stress = copy.deepcopy(original)
+    analysis = gen._analysis(original)
+    assert not analysis["distractors"]
+    changed_color = analysis["count_witnesses"][0]
+    box = dict(analysis["targets"])[changed_color]
+    top, left, bottom, right = box
+    noncorners = sorted(gen._bbox_cells(box) - set(gen._corners(box)))
+    replacement = {(top, left), (bottom, right), noncorners[0], noncorners[-1]}
+    assert len(replacement) == 4 and gen._bbox(replacement) == box
+    assert len(replacement & set(gen._corners(box))) == 2
+    for row in stress:
+        for col, value in enumerate(row):
+            if value == changed_color:
+                row[col] = 0
+    for row, col in replacement:
+        assert stress[row][col] == 0
+        stress[row][col] = changed_color
+    assert gen.self_check(stress) == []
+
+    bridge = None
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        try:
+            apply, runtime, bridge = _real_evaluator(ROOT / "shared/runtime")
+            demos = []
+            for grid in grids[:3]:
+                expected = apply(authority, grid)
+                assert expected == gen.rule_mirror(grid)
+                demos.append({"input": grid, "output": expected})
+            # Every rival must execute and fit every visible demo before query
+            # execution. Exceptions abort; they never count as refutations.
+            for demo in demos:
+                actual = apply(RIVAL, demo["input"])
+                assert actual == demo["output"], "Rival failed a visible demonstration"
+            original_answers = {"authority": apply(authority, original), "rival": apply(RIVAL, original)}
+            stress_answers = {"authority": apply(authority, stress), "rival": apply(RIVAL, stress)}
+        finally:
+            if bridge is not None:
+                bridge.close()
+    assert original_answers["authority"] == original_answers["rival"]
+    assert stress_answers["authority"] != stress_answers["rival"]
+    assert stress_answers["authority"] == gen.rule_mirror(stress)
+    original_lesson = {"train": demos, "test": [{"input": original}]}
+    stress_lesson = {"train": demos, "test": [{"input": stress}]}
+    assert gen.lesson_identifiable(demos, {"input": stress, "output": stress_answers["authority"]}) == []
+    for name, lesson in (("original", original_lesson), ("stress", stress_lesson)):
+        body = public_challenge_bytes(lesson)
+        assert sha(body) == public_challenge_id(lesson)
+        (out / f"{name}.public.json").write_bytes(body)
+    (private / "authority.rkt").write_text(authority)
+    (private / "three_corners_rival.rkt").write_text(RIVAL)
+    write_json(private / "answers.json", {"original": original_answers, "stress": stress_answers})
