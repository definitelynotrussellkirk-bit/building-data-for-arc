+#!/usr/bin/env python3
+"""One bounded direct-sampler ambiguity witness; no native export/admission.
+
+Both real protected-Racket programs must fit every visible demonstration before
+either is evaluated on the production-sampled query. Runtime errors fail the run.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+TASK = 'e971e0773705'
+sys.path.insert(0, str(ROOT / 'src'))
+sys.path.insert(0, str(ROOT / 'shared/runtime'))
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator, public_challenge_bytes, public_challenge_id
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n', encoding='utf-8')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', required=True, type=Path)
+    args = parser.parse_args()
+    out = args.out.absolute()
+    if os.path.lexists(out):
+        raise FileExistsError(f'--out must be a new path, including no symlink: {out}')
+    if any(p.is_symlink() for p in out.parents):
+        raise ValueError('Output ancestors must not be symlinks')
+    out.mkdir(parents=True, exist_ok=False)
+    private = out / 'private'
+    private.mkdir()
+    catalog = Catalog(ROOT)
+    selected = catalog.describe(TASK)
+    rule_task = selected.get('rule_task_id', TASK)
+    programs = {v['program_solution'] for v in catalog._variants()[rule_task]}
+    if len(programs) != 1:
+        raise ValueError('Expected one exact canonical program for this selected rule task')
+    canonical = programs.pop()
+    rival = canonical
+    for name in ('type-a', 'type-b'):
+        old = f'(min {name} 4)'
+        if rival.count(old) != 1:
+            raise ValueError(f'Expected exactly one canonical cap expression: {old}')
+        rival = rival.replace(old, f'(min {name} 3)')
+    (private / 'canonical.rkt').write_text(canonical, encoding='utf-8')
+    (private / 'rival_cap_three.rkt').write_text(rival, encoding='utf-8')
+    with _local_imports(ROOT / 'shared/runtime', HERE):
+        gen, source, source_sha = load_selected_generator(TASK, root=ROOT)
+        (private / 'selected_generator.py').write_bytes(source.read_bytes())
+        apply, runtime, bridge = _real_evaluator(ROOT / 'shared/runtime')
+        try:
+            calls = [dict(seed=1, sample_index=i, difficulty=None, overrides={}) for i in range(4)]
+            demos = []
+            demo_checks = []
+            for call in calls[:3]:
+                grid = gen.generate(call['seed'], call['sample_index'])
+                errors = gen.self_check(grid)
+                if errors:
+                    raise AssertionError(f'Demonstration outside generator domain: {errors}')
+                expected = apply(canonical, grid)
+                actual = apply(rival, grid)
+                if actual != expected:
+                    raise AssertionError('Rival does not fit all visible demonstrations')
+                demos.append(dict(input=grid, output=expected))
+                facts = gen._facts(grid)
+                demo_checks.append(dict(call=call, profile=gen._analysis(grid)['scene_profile'],
+                    top_count=facts['top_count'], bottom_count=facts['bottom_count'],
+                    canonical_fits=True, rival_fits=True))
+            # Query generation/execution deliberately follows complete demo fitting.
+            call = calls[3]
+            query = gen.generate(call['seed'], call['sample_index'])
+            errors = gen.self_check(query)
+            if errors:
+                raise AssertionError(f'Query outside generator domain: {errors}')
+            expected = apply(canonical, query)
+            alternative = apply(rival, query)
+            if expected == alternative:
+                raise AssertionError('Expected production-query disagreement was not reproduced')
+            public = dict(train=demos, test=[dict(input=query)])
+            public_bytes = public_challenge_bytes(public)
+            public_id = public_challenge_id(public)
+            (out / 'public.json').write_bytes(public_bytes)
+            write_json(private / 'original_lesson.json', dict(train=demos,
+                test=[dict(input=query, output=expected)], generation_calls=calls))
+            write_json(private / 'alternative_answer_candidate.json', dict(
+                public_challenge_id=public_id, program_file='rival_cap_three.rkt',
+                answers=[alternative], fitting_demo_count=len(demos), training_admitted=False))
+            write_json(private / 'query_answers.json', dict(canonical=expected, rival=alternative))
+            facts = gen._facts(query)
+            report = dict(schema='e971e0773705-cap-ambiguity-v1', task_id=TASK,
+                outcome='visible_demo_ambiguity_reproduced', scope='one bounded direct-generate lesson',
+                seed=1, demonstrations=demo_checks, demo_count=3, rival_count=1,
+                protected_program_count=2, racket_application_count=8,
+                query_count=1, production_sampled_query=True, constructed_stress_query=False,
+                native_lesson_export=False, query_call=call,
+                query_profile=gen._analysis(query)['scene_profile'],
+                query_top_count=facts['top_count'], query_bottom_count=facts['bottom_count'],
+                query_lawful=True, query_disagreement=True, public_challenge_id=public_id,
+                generator_sha256=source_sha, rule_task_id=rule_task,
+                canonical_program_sha256=digest(canonical.encode()),
+                rival_program_sha256=digest(rival.encode()),
+                probe_sha256=digest(Path(__file__).read_bytes()), runtime_identity=runtime,
+                reviewer_support_sha256=digest((ROOT/'shared/runtime/reviewer_support.py').read_bytes()),
+                owner_acceptance='pending/not performed', training_admitted=False,
+                production_modified=False,
+                limit='One chosen three-demo lesson, not a universal ambiguity or native export failure.',
+                proposed_repair='Include an informative demonstration at count four or above before a capped-count query, or validate lesson identification against this cap-three rival.')
+            write_json(out / 'report.json', report)
+            print(json.dumps(dict(out=str(out), outcome=report['outcome'],
+                public_challenge_id=public_id, generator_sha256=source_sha,
+                demo_count=3, query_count=1, protected_program_count=2,
+                owner_acceptance=report['owner_acceptance'], training_admitted=False), sort_keys=True))
+        finally:
+            bridge.close()
+
+
+if __name__ == '__main__':
+    main()
