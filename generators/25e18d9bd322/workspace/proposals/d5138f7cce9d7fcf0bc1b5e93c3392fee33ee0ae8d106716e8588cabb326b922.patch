+    top_count = 0
+    bottom_count = 0
+    for component in _components4(grid):
+        top_row = min(row for row, _ in component)
+        cells_on_top = sum(row == top_row for row, _ in component)
+        if cells_on_top >= 3:
+            top_count += 1
+        else:
