+"""Native matched-input nearest-object lessons with two distance metrics."""
+import copy
+import hashlib
+import math
+from pathlib import Path
+import random
+
+
+HERE = Path(__file__).resolve().parent
+METRICS = ("manhattan", "chebyshev")
+CARDINAL = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _integer(value, low, high, name):
+    if type(value) is not int or not low <= value <= high:
+        raise ValueError(f"{name} must be an exact integer in {low}..{high}")
+
+
+def _metric(settings):
+    if (type(settings) is not dict or set(settings) != {"metric"}
+            or type(settings["metric"]) is not str or settings["metric"] not in METRICS):
+        raise ValueError("settings must contain only metric='manhattan' or 'chebyshev'")
+    return settings["metric"]
+
+
+def program(settings):
+    return (HERE / (_metric(settings) + ".rkt")).read_text()
+
+
+def components(grid):
+    unseen = {(r, c) for r, row in enumerate(grid) for c, v in enumerate(row) if v not in (0, 9)}
+    result = []
+    while unseen:
+        origin = min(unseen)
+        unseen.remove(origin)
+        color = grid[origin[0]][origin[1]]
+        cells, stack = {origin}, [origin]
+        while stack:
+            r, c = stack.pop()
+            for dr, dc in CARDINAL:
+                p = r + dr, c + dc
+                if p in unseen and grid[p[0]][p[1]] == color:
+                    unseen.remove(p)
+                    cells.add(p)
+                    stack.append(p)
+        result.append({"color": color, "cells": cells,
+                       "bbox": (min(r for r, c in cells), min(c for r, c in cells),
+                                max(r for r, c in cells), max(c for r, c in cells))})
+    return result  # Same row-major discovery order as the Racket objects primitive.
+
+
+def analyze(grid):
+    if (type(grid) is not list or not 5 <= len(grid) <= 30 or type(grid[0]) is not list
+            or not 5 <= len(grid[0]) <= 30 or any(type(row) is not list or len(row) != len(grid[0])
+            or any(type(v) is not int or not 0 <= v <= 9 for v in row) for row in grid)):
+        raise ValueError("expected a rectangular 5..30 grid of exact integer colors")
+    markers = [(r, c) for r, row in enumerate(grid) for c, v in enumerate(row) if v == 9]
+    if len(markers) != 1:
+        raise ValueError("expected exactly one marker of color 9")
+    objs = components(grid)
+    if not 2 <= len(objs) <= 8:
+        raise ValueError("expected 2..8 monochrome cardinal components after removing marker")
+    return markers[0], objs
+
+
+def distance(marker, cells, metric):
+    if metric == "manhattan":
+        return min(abs(r - marker[0]) + abs(c - marker[1]) for r, c in cells)
+    if metric == "chebyshev":
+        return min(max(abs(r - marker[0]), abs(c - marker[1])) for r, c in cells)
+    raise ValueError("unknown distance metric")
+
+
+def crop(obj):
+    top, left, bottom, right = obj["bbox"]
+    result = [[0] * (right - left + 1) for _ in range(bottom - top + 1)]
+    for r, c in obj["cells"]:
+        result[r - top][c - left] = obj["color"]
+    return result
+
+
+def solve(grid, metric="manhattan"):
+    if type(metric) is not str or metric not in METRICS:
+        raise ValueError("unknown distance metric")
+    marker, objs = analyze(grid)
+    # min is stable: a complete distance/top/left tie retains discovery order.
+    chosen = min(objs, key=lambda o: (distance(marker, o["cells"], metric), *o["bbox"][:2]))
+    return crop(chosen)
+
+
+def _rng(seed, split, index, attempt=0):
+    data = f"25e18d9bd322-input-v1:{seed}:{split}:{index}:{attempt}".encode()
+    return random.Random(int.from_bytes(hashlib.sha256(data).digest(), "big"))
+
+
+def _paint(grid, cells, color, dr=0, dc=0):
+    for r, c in cells:
+        if grid[r + dr][c + dc] != 0:
+            raise ValueError("constructed objects overlap")
+        grid[r + dr][c + dc] = color
+
+
+def _teaching(index, rng):
+    low, middle_a, middle_b, high = sorted(rng.sample(range(1, 9), 4))
+    if index == 0:
+        grid, marker = [[0] * 25 for _ in range(18)], (10, 10)
+        a = {(r, 3) for r in range(2, 11)} | {(2, 4), (2, 5)}
+        b = {(r, 22) for r in range(2, 15)} | {(15, c) for c in range(15, 23)}
+        shapes = [(a, middle_a), ({(0, 2), (1, 2)}, middle_a),
+                  (b, middle_b), ({(0, 21), (1, 21)}, middle_b),
+                  ({(5, 4), (6, 4)}, low),
+                  ({(13, 16), (13, 17), (14, 17)}, high)]
+        # Manhattan selects A, Chebyshev selects B, Euclidean selects E.
+        # Diagonal same-color satellites and edge-touching different-color
+        # intruders expose connectivity, grouping and raw-crop shortcuts.
+    else:
+        grid, marker = [[0] * 18 for _ in range(22)], (10, 10)
+        w = ({(4, c) for c in range(5, 14)} | {(r, 5) for r in range(5, 11)}
+             | {(r, 13) for r in range(5, 15)} | {(14, c) for c in range(8, 13)})
+        b = ({(r, 11) for r in range(5, 13)} | {(12, c) for c in range(3, 12)}
+             | {(r, c) for r in range(12, 17) for c in range(3, 8)
+                if r in (12, 16) or c in (3, 7)})
+        d = ({(11, c) for c in range(1, 11)} | {(r, 1) for r in range(12, 20)}
+             | {(r, c) for r in range(17, 20) for c in range(1, 9)})
+        shapes = [(w, high), (b, low), ({(r, 10) for r in range(5, 10)}, middle_a),
+                  (d, middle_b), ({(14, 5)}, low), ({(2, 4), (3, 4)}, high)]
+        # B/C/D tie at distance one under both metrics. B wins by bbox top,
+        # then left, despite C being discovered earlier. B has a real hole;
+        # its crop must erase the marker and a disconnected same-color cell.
+    dr, dc = rng.randrange(2), rng.randrange(2)
+    for cells, color in shapes:
+        _paint(grid, cells, color, dr, dc)
+    grid[marker[0] + dr][marker[1] + dc] = 9
+    return grid
+
+
+def _bands(total, count, start):
+    usable = total - count + 1
+    if usable < 2 * count:
+        raise ValueError("canvas too small for separated slots")
+    result = []
+    for i in range(count):
+        size = usable // count + int(i < usable % count)
+        result.append((start, size))
+        start += size + 1
+    return result
+
+
+def _shape(height, width, kind):
+    if kind == "solid":
+        return {(r, c) for r in range(height) for c in range(width)}
+    if kind == "frame":
+        return {(r, c) for r in range(height) for c in range(width) if r in (0, height - 1) or c in (0, width - 1)}
+    if kind == "comb":
+        return {(r, c) for r in range(height) for c in range(width) if c == 0 or r % 2 == 0}
+    if kind == "elbow":
+        return {(r, c) for r in range(height) for c in range(width) if r == 0 or c == 0}
+    if kind == "notched":
+        return {(r, c) for r in range(height) for c in range(width) if not (r < height // 2 and c >= width // 2)}
+    raise ValueError("unknown shape")
+
+
+def scene(height, width, count, rng, *, full=False, contact=False):
+    _integer(height, 10, 30, "height"); _integer(width, 10, 30, "width"); _integer(count, 3, 8, "count")
+    grid = [[0] * width for _ in range(height)]
+    palette = [rng.randrange(1, 9)] * count if rng.randrange(2) else rng.sample(range(1, 9), count)
+    _paint(grid, {(r, c) for r in range(height) for c in range(width)
+                  if r in (0, height - 1) or c in (0, width - 1)}, palette[0])
+    inner = count - 1
+    nr = 2 if inner <= 4 else 3
+    nc = math.ceil(inner / nr)
+    slots = [(r, c, h, w) for r, h in _bands(height - 4, nr, 2)
+             for c, w in _bands(width - 4, nc, 2)]
+    kinds = ["solid", "frame", "comb", "elbow", "notched"]
+    rng.shuffle(kinds)
+    for i, (r, c, h, w) in enumerate(slots[:inner]):
+        sh, sw = (h, w) if full else (rng.randint(2, h), rng.randint(2, w))
+        cells = _shape(sh, sw, kinds[i % len(kinds)])
+        if rng.randrange(2): cells = {(sh - 1 - a, b) for a, b in cells}
+        if rng.randrange(2): cells = {(a, sw - 1 - b) for a, b in cells}
+        _paint(grid, cells, palette[i + 1], r + rng.randint(0, h - sh), c + rng.randint(0, w - sw))
+    free = [(r, c) for r in range(2, height - 2) for c in range(2, width - 2) if grid[r][c] == 0]
+    adjacent = [p for p in free if any(grid[p[0] + dr][p[1] + dc] for dr, dc in CARDINAL)]
+    separated = [p for p in free if p not in adjacent]
+    marker = rng.choice((adjacent if contact else separated) or free)
+    grid[marker[0]][marker[1]] = 9
+    return grid
+
+
+def _input(seed, split, index, attempt):
+    rng = _rng(seed, split, index, attempt)
+    if split == "train" and index < 2:
+        return _teaching(index, rng)
+    if split == "train":
+        return scene(15 + index, 18 + index, 4 + index % 4, rng)
+    h, w, n = ((12, 15, 4), (20, 24, 6), (30, 30, 8), (25, 29, 7))[index]
+    return scene(h, w, n, rng, full=index >= 1, contact=index == 0)
+
+
+def generate(seed, settings, demos, queries):
+    metric = _metric(settings)
+    _integer(seed, 0, 2**63 - 1, "seed")
+    _integer(demos, 2, 6, "demos"); _integer(queries, 1, 4, "queries")
+    seen, result = set(), {}
+    for split, count in (("train", demos), ("test", queries)):
+        pairs = []
+        for index in range(count):
+            for attempt in range(16):
+                grid = _input(seed, split, index, attempt)
+                identity = tuple(map(tuple, grid))
+                if identity not in seen:
+                    seen.add(identity)
+                    pairs.append({"input": grid, "output": solve(grid, metric)})
+                    break
+            else:
+                raise ValueError("distinct-input generation budget exhausted")
+        result[split] = pairs
+    return {**result, "program_solution": program(settings), "seed": seed, "settings": copy.deepcopy(settings)}
+
+
+def public_turn(episode, query_index):
+    _integer(query_index, 0, len(episode["test"]) - 1, "query_index")
+    return {"train": [{"input": copy.deepcopy(p["input"]), "output": copy.deepcopy(p["output"])}
+                      for p in episode["train"]],
+            "test": [{"input": copy.deepcopy(episode["test"][query_index]["input"])}]}
diff --git a/repo/generators/25e18d9bd322/workspace/parametric/audit.py b/repo/generators/25e18d9bd322/workspace/parametric/audit.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/25e18d9bd322/workspace/parametric/audit.py
@@ -0,0 +1,160 @@
+"""Bounded teaching, protected-label and public-projection audit for this family.
+
+Run through review.py run with --out pointing to a new directory. The audit
+never changes production, accepts a family, or admits examples to training.
+"""
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import evaluate_contract, _local_imports, _real_evaluator
+from reviewer_support import public_challenge_bytes, public_challenge_id
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[3]
+TASK = "25e18d9bd322"
+
+
+def local_module(name):
+    spec = importlib.util.spec_from_file_location("nearest_audit_" + name, HERE / (name + ".py"))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+
+
+def coverage(grid, adapter):
+    marker, objs = adapter.analyze(grid)
+    return {"height": len(grid), "width": len(grid[0]), "components": len(objs),
+            "candidate_cells": sum(len(o["cells"]) for o in objs),
+            "interior_candidate_cells": sum(v not in (0, 9) for row in grid[1:-1] for v in row[1:-1]),
+            "marker": marker,
+            "largest_component": max(len(o["cells"]) for o in objs),
+            "selected_bbox": {metric: [len(adapter.solve(grid, metric)), len(adapter.solve(grid, metric)[0])]
+                              for metric in adapter.METRICS}}
+
+
+def run(out):
+    if out.exists() or out.is_symlink():
+        raise ValueError("Choose a new output directory; existing evidence is never overwritten")
+    out = out.resolve()
+    adapter, rivals = local_module("adapter"), local_module("rivals")
+    seeds = (0, 17, 29, 2**63 - 1)
+    checked = []
+    for seed in seeds:
+        for demos in (2, 3, 6):
+            inputs = []
+            for metric in adapter.METRICS:
+                episode = adapter.generate(seed, {"metric": metric}, demos, 4)
+                rows = rivals.check_episode(episode)
+                if any(row["survives_demos"] for row in rows):
+                    raise AssertionError({"seed": seed, "demos": demos, "metric": metric,
+                                          "survivors": [r for r in rows if r["survives_demos"]]})
+                one = adapter.generate(seed, {"metric": metric}, demos, 1)
+                if adapter.public_turn(episode, 0) != adapter.public_turn(one, 0):
+                    raise AssertionError("first visible turn depends on hidden future queries")
+                altered = copy.deepcopy(episode)
+                altered.update(seed=-1, settings={"private": True}, program_solution="private")
+                for pair in altered["train"]:
+                    pair.update(seed=-1, settings={"private": True}, program_solution="private")
+                for pair in altered["test"]:
+                    pair["output"] = [[9]]
+                if (public_challenge_bytes(episode) != public_challenge_bytes(altered)
+                        or public_challenge_id(episode) != public_challenge_id(altered)
+                        or adapter.public_turn(episode, 0) != adapter.public_turn(altered, 0)):
+                    raise AssertionError("private metadata leaked to public bytes, IDs or single-query turns")
+                inputs.append([p["input"] for split in ("train", "test") for p in episode[split]])
+                checked.append({"seed": seed, "settings": episode["settings"], "demos": demos,
+                                "queries": 4, "rivals": rows,
+                                "query_coverage": [coverage(p["input"], adapter) for p in episode["test"]]})
+            if inputs[0] != inputs[1]:
+                raise AssertionError("input distribution depends on selected setting")
+
+    contract = json.loads((HERE / "promotion.json").read_text())
+    jobs = [{"seed": 29, "settings": {"metric": metric}, "demos": demos, "queries": 4}
+            for metric in adapter.METRICS for demos in (2, 6)]
+    execution = evaluate_contract(ROOT, TASK, contract, jobs)
+    minimum = [[9, 3, 0, 0, 0], [0, 3, 0, 0, 0], [0] * 5, [0] * 5, [0, 0, 0, 0, 4]]
+    tied = [[0] * 12 for _ in range(7)]
+    tied[0][9] = 9
+    a = {(1, c) for c in range(2, 9)} | {(2, 8)} | {(3, c) for c in range(4, 9)}
+    b = {(r, 10) for r in range(1, 5)} | {(5, c) for c in range(2, 11)}
+    for cells, color in ((a, 7), (b, 2)):
+        for r, c in cells:
+            tied[r][c] = color
+    literal_checks = []
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            for name, grid in (("minimum_5x5_marker_contact", minimum), ("complete_key_tie", tied)):
+                for metric in adapter.METRICS:
+                    actual = apply(adapter.program({"metric": metric}), grid)
+                    if actual != adapter.solve(grid, metric):
+                        raise AssertionError(name + " differs from protected Racket")
+                    literal_checks.append({"case": name, "settings": {"metric": metric},
+                                           "input": grid, "output": actual})
+        finally:
+            bridge.close()
+    if identity != execution["racket"]:
+        raise AssertionError("protected runtime changed during audit")
+
+    public, turns, private = {}, {}, []
+    for episode in (e for e in execution["episodes"] if len(e["train"]) == 2):
+        public_id = public_challenge_id(episode)
+        if public_id in public:
+            raise AssertionError("duplicate visible challenge")
+        public[public_id] = public_challenge_bytes(episode)
+        turn_ids = []
+        for index in range(4):
+            turn = adapter.public_turn(episode, index)
+            turn_id = public_challenge_id(turn)
+            if turn_id in turns:
+                raise AssertionError("duplicate visible turn")
+            turns[turn_id] = public_challenge_bytes(turn)
+            turn_ids.append(turn_id)
+        private.append({"public_id": public_id, "turn_ids": turn_ids, "seed": episode["seed"],
+                        "settings": episode["settings"], "program": episode["program"],
+                        "program_sha256": episode["program_sha256"],
+                        "query_answers": [p["output"] for p in episode["test"]],
+                        "teaching": rivals.check_episode(episode), "reference": "qualified_prototype",
+                        "owner_acceptance": "pending", "training_admitted": False})
+    source = {p.relative_to(ROOT).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
+              for p in sorted(HERE.iterdir()) if p.suffix in (".py", ".rkt", ".json")}
+    report = {"schema": "nearest-object-metric-audit-v1", "task_id": TASK, "passed": True,
+              "source_sha256": source, "attempted_episodes": len(checked),
+              "successful_episodes": len(checked), "failed_episodes": 0,
+              "seeds": list(seeds), "demos_exercised": [2, 3, 6], "queries": 4,
+              "rivals": list(rivals.RIVALS), "rival_survivors": 0,
+              "finite_rival_evaluations": len(checked) * len(rivals.RIVALS),
+              "checked_episodes": checked, "protected_jobs": jobs,
+              "racket": identity, "racket_evaluations": execution["racket_evaluations"] + len(literal_checks),
+              "literal_checks": literal_checks, "public_examples": len(public),
+              "single_query_turns": len(turns), "owner_acceptance": "pending", "training_admitted": False,
+              "limits": ["Twenty-two declared Python rivals and the listed seeds/counts; no universal uniqueness claim.",
+                         "Protected Racket executes both declared metric programs and all labels on the four audit jobs plus literal boundaries; extra rivals are Python hypotheses.",
+                         "Four-query public files are private controller storage; reveal only one public_turns file to an actor per user turn.",
+                         "The native worker's generic reference string does not grant owner acceptance or training admission."]}
+    out.mkdir(parents=True, exist_ok=False)
+    write_json(out / "report.json", report)
+    write_json(out / "execution.json", execution)
+    write_json(out / "private.json", sorted(private, key=lambda row: row["public_id"]))
+    for folder, files in (("public", public), ("public_turns", turns)):
+        (out / folder).mkdir()
+        for public_id, data in sorted(files.items()):
+            (out / folder / (public_id + ".json")).write_bytes(data)
+    return {k: report[k] for k in ("passed", "attempted_episodes", "successful_episodes",
+            "failed_episodes", "rival_survivors", "finite_rival_evaluations",
+            "racket_evaluations", "public_examples", "single_query_turns")}
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    print(json.dumps(run(parser.parse_args().out), indent=2))
