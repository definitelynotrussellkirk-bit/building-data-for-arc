+#!/usr/bin/env python3
+"""Find an object-count shortcut in the b6ba2d176fe8 sort-order lesson.
+
+The native prototype samples object counts 3, 4, 5 for its three
+representations, then count 6 for its first query.  This probe constructs a
+source-bound rival that follows the selected sort order except when there are
+exactly six objects, where it uses the opposite order.  The rival therefore
+fits every demonstration and fails the first query for either declared
+setting.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from typing import Any
+
+
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parents[1]
+REPO = TASK_HOME.parents[1]
+PROTOTYPE_PATH = HERE / "prototype.py"
+GENERATOR_PATH = TASK_HOME / "generator.py"
+TEST_PATH = TASK_HOME / "tests/test_count_gate_probe.py"
+
+
+def _load_prototype():
+    spec = importlib.util.spec_from_file_location(
+        "b6ba2d176fe8_count_gate_probe_prototype", PROTOTYPE_PATH
+    )
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load prototype from {PROTOTYPE_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+proto = _load_prototype()
+_SORT_BODY = "(sort-by objs (lambda (o) (second (obj-bbox o))))"
+
+
+def _file_digest(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _validate_seed(seed: Any) -> int:
+    if type(seed) is not int or not 0 <= seed < 2**63:
+        raise ValueError("seed must be a literal integer in 0..2**63-1")
+    return seed
+
+
+def _validate_sort_order(sort_order: Any) -> str:
+    if type(sort_order) is not str or sort_order not in {
+        "left_to_right",
+        "right_to_left",
+    }:
+        raise ValueError("sort_order must be left_to_right or right_to_left")
+    return sort_order
+
+
+def materialize_count_gate_rival(sort_order: str) -> str:
+    """Return a guarded Racket rival bound to the selected source program."""
+    sort_order = _validate_sort_order(sort_order)
+    settings = proto.Settings(sort_order)
+    source = proto.program(settings)
+    if sort_order == "left_to_right":
+        fragment = proto._SORT_FRAGMENT
+        replacement = (
+            "(sorted (let* ((sorted "
+            + _SORT_BODY
+            + ") (opposite (reverse sorted))) "
+            + "(if (= (length objs) 6) opposite sorted)))"
+        )
+    else:
+        fragment = proto._REVERSE_SORT_FRAGMENT
+        replacement = (
+            "(sorted (let* ((sorted (reverse "
+            + _SORT_BODY
+            + ")) (opposite (reverse sorted))) "
+            + "(if (= (length objs) 6) opposite sorted)))"
+        )
+    if source.count(fragment) != 1:
+        raise ValueError(
+            f"expected exactly one guarded sort fragment for {sort_order}; "
+            f"found {source.count(fragment)}"
+        )
+    rival = source.replace(fragment, replacement)
+    if rival == source or rival.count("(= (length objs) 6)") != 1:
+        raise ValueError(f"failed to materialize count-gated rival for {sort_order}")
+    return rival
+
+
+def _render(rectangles: list[dict], grid: list[list[int]]) -> list[list[int]]:
+    output = [[0 for _ in row] for row in grid]
+    row = column = 0
+    for rectangle in rectangles:
+        top, left, bottom, right = rectangle["bbox"]
+        height = bottom - top + 1
+        width = right - left + 1
+        for rr in range(row, row + height):
+            for cc in range(column, column + width):
+                output[rr][cc] = rectangle["color"]
+        row += height - 1
+        column += width - 1
+    return output
+
+
+def count_gate_transform(grid, sort_order: str):
+    """Python parity model for the rival; labels are verified in Racket."""
+    sort_order = _validate_sort_order(sort_order)
+    source = proto.validate_grid(grid)
+    rectangles = proto._load_generator()._ordered_rectangles(source)
+    if not rectangles:
+        raise ValueError("no rectangular objects found")
+    rectangles = list(rectangles)
+    if sort_order == "right_to_left":
+        rectangles.reverse()
+    if len(rectangles) == 6:
+        rectangles.reverse()
+    return _render(rectangles, source)
+
+
+def _racket_outputs(source: str, grids: list[list[list[int]]]) -> tuple[list, dict]:
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    callable_source = wrap_rule(source)
+    outputs = []
+    with RacketBridge(timeout=20.0, startup_timeout=45.0) as bridge:
+        runtime_identity = dict(bridge.runtime_identity)
+        if not runtime_identity.get("protected"):
+            raise RuntimeError("protected Racket runtime required")
+        for grid in grids:
+            outputs.append(
+                bridge.eval_text(f"({callable_source} {proto._grid_literal(grid)})")
+            )
+    return outputs, runtime_identity
+
+
+def build_report(seed: int = 20261023, *, verify_racket: bool = True) -> dict:
+    seed = _validate_seed(seed)
+    if type(verify_racket) is not bool:
+        raise ValueError("verify_racket must be a literal boolean")
+    records = proto._sample_input_records(seed, count=7)
+    grids = [copy.deepcopy(record["input"]) for record in records]
+    object_counts = [record["profile"]["n_objects"] for record in records]
+    witnesses = []
+    runtime_identities = []
+    evaluations = 0
+
+    for sort_order in ("left_to_right", "right_to_left"):
+        settings = proto.Settings(sort_order)
+        target_source = proto.program(settings)
+        rival_source = materialize_count_gate_rival(sort_order)
+        target_outputs = [proto.transform(grid, settings) for grid in grids]
+        rival_outputs = [count_gate_transform(grid, sort_order) for grid in grids]
+
+        if verify_racket:
+            racket_target, target_runtime = _racket_outputs(target_source, grids)
+            racket_rival, rival_runtime = _racket_outputs(rival_source, grids)
+            runtime_identities.extend((target_runtime, rival_runtime))
+            evaluations += 2 * len(grids)
+            if racket_target != target_outputs:
+                raise ValueError(f"target Racket/Python mismatch for {sort_order}")
+            if racket_rival != rival_outputs:
+                raise ValueError(f"rival Racket/Python mismatch for {sort_order}")
+
+        matches = [
+            rival == target
+            for rival, target in zip(rival_outputs, target_outputs, strict=True)
+        ]
+        witnesses.append(
+            {
+                "sort_order": sort_order,
+                "target_program": target_source,
+                "target_program_sha256": proto.text_digest(target_source),
+                "rival_program": rival_source,
+                "rival_program_sha256": proto.text_digest(rival_source),
+                "input_sha256": [record["input_sha256"] for record in records],
+                "target_output_sha256": [proto.digest(value) for value in target_outputs],
+                "rival_output_sha256": [proto.digest(value) for value in rival_outputs],
+                "demo_matches": matches[:3],
+                "query_matches": matches[3:],
+                "first_failing_query": next(
+                    (index for index, match in enumerate(matches[3:]) if not match),
+                    None,
+                ),
+            }
+        )
+
+    found = all(
+        witness["demo_matches"] == [True, True, True]
+        and witness["query_matches"] == [False, True, True, True]
+        for witness in witnesses
+    )
+    return {
+        "schema": "b6ba2d176fe8-count-gate-probe-v1",
+        "task_id": proto.TASK_ID,
+        "status": "counterexample_found" if found else "no_counterexample",
+        "seed": seed,
+        "lesson_shape": {"demonstrations": 3, "queries": 4},
+        "object_counts": object_counts,
+        "witnesses": witnesses,
+        "protected_racket": {
+            "requested": verify_racket,
+            "evaluations": evaluations,
+            "runtime_identity": runtime_identities[0] if runtime_identities else None,
+            "all_runtime_identities_equal": (
+                all(value == runtime_identities[0] for value in runtime_identities)
+                if runtime_identities
+                else None
+            ),
+        },
+        "source_binding": {
+            path.relative_to(REPO).as_posix(): _file_digest(path)
+            for path in (PROTOTYPE_PATH, GENERATOR_PATH, TEST_PATH)
+        },
+        "recommendation": (
+            "Ensure every three-demonstration lesson that may query six objects "
+            "contains a six-object demonstration, or add count-gated order rivals "
+            "to the lesson-identifiability gate."
+        ),
+        "limits": [
+            "This is a bounded counterexample for the prototype's deterministic seven-input profile at the recorded seed.",
+            "It tests the two declared sort-order settings and one simple object-count gate, not every lawful rival.",
+            "The probe is advisory and does not modify production generation, selected authority, approval, or training admission.",
+        ],
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed", type=int, default=20261023)
+    parser.add_argument("--out", type=Path)
+    parser.add_argument("--no-racket", action="store_true")
+    args = parser.parse_args(argv)
+    report = build_report(args.seed, verify_racket=not args.no_racket)
+    payload = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(payload)
+    print(payload, end="")
+    return 0 if report["status"] == "counterexample_found" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
