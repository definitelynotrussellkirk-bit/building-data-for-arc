+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+PROBE = HOME / "workspace/color_gate_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("bfa_color_gate_probe", PROBE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_guarded_rival_materialization_and_known_two_demo_counterexample():
+    probe = load_probe()
+    canonical = probe.canonical_program()
+    rival = probe.materialize_rival(canonical, "even_only")
+    assert canonical != rival
+    assert canonical.count(probe.CANONICAL_CONDITION) == 1
+    assert rival.count("(= (remainder v 2) 0)") == 1
+
+    report = probe.scan(seed_limit=22, bands=("easy",), verify_racket=False)
+    witness = next(row for row in report["witnesses"] if row["rival"] == "even_only")
+    assert witness["seed"] == 21
+    assert witness["demo_colors"] == [[2, 4], [2, 4]]
+    assert witness["query_colors"] == [7, 3]
+    assert witness["demo_matches"] == [True, True]
+    assert witness["query_matches"] == [False]
+
+
+def test_probe_rejects_invalid_scan_limits_before_generation():
+    probe = load_probe()
+    with pytest.raises(ValueError, match="seed_limit"):
+        probe.scan(seed_limit=True, bands=("easy",), verify_racket=False)
+    with pytest.raises(ValueError, match="bands"):
+        probe.scan(seed_limit=1, bands=(), verify_racket=False)
+
+
+def test_body_form_canonical_rule_is_wrapped_for_bare_racket_bridge():
+    probe = load_probe()
+    callable_text = probe._rule_callable(probe.canonical_program())
+    assert callable_text.startswith("(lambda (g)")
+    assert "(let* ((h (rows g)) (w (cols g)))" in callable_text
