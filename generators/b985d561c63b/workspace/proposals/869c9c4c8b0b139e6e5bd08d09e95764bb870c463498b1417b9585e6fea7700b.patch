+#!/usr/bin/env python3
+"""Bounded source-bound audit for color-gated plus-expansion shortcuts.
+
+The production rule expands every isolated colored singleton.  This probe asks
+whether a two-demonstration lesson can instead be explained by a simple color
+predicate (for example, "expand even colors only") and then fail on the query.
+It retains the first counterexample for each predicate and can replay both the
+canonical and rival programs through the protected Racket bridge.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any, Callable
+
+from arc_repl.racket_bridge import RacketBridge
+from reviewer_support import canonical_path, find_root, normalize_grid
+from puzzle_generators.rule_wrap import wrap_rule
+
+TASK_ID = "bfa4f83b9dbd"
+HERE = Path(__file__).resolve().parent
+GENERATOR_PATH = HERE.parent / "generator.py"
+CANONICAL_CONDITION = (
+    "(and (not (= v 0)) "
+    "(all? (lambda (d) (= (at g (+ r (first d)) (+ c (second d))) 0)) dirs4)"
+)
+RIVAL_PREDICATES = {
+    "even_only": "(= (remainder v 2) 0)",
+    "odd_only": "(= (remainder v 2) 1)",
+    "low_1_4_only": "(<= v 4)",
+    "high_5_9_only": "(>= v 5)",
+}
+PYTHON_PREDICATES: dict[str, Callable[[int], bool]] = {
+    "even_only": lambda value: value % 2 == 0,
+    "odd_only": lambda value: value % 2 == 1,
+    "low_1_4_only": lambda value: value <= 4,
+    "high_5_9_only": lambda value: value >= 5,
+}
+VALID_BANDS = ("easy", "medium", "hard")
+
+
+def _sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _sha_text(text: str) -> str:
+    return _sha_bytes(text.encode("utf-8"))
+
+
+def _grid_sha(grid: Any) -> str:
+    return _sha_text(json.dumps(grid, separators=(",", ":"), sort_keys=False))
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location("bfa4f83b9dbd_color_probe_generator", GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {GENERATOR_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def canonical_program() -> str:
+    root = find_root(__file__)
+    rows: set[str] = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                source = row.get("program_solution")
+                if type(source) is not str:
+                    raise ValueError("canonical row has no exact program_solution")
+                rows.add(source)
+    if len(rows) != 1:
+        raise ValueError(f"expected one canonical program for {TASK_ID}, found {len(rows)}")
+    source = next(iter(rows))
+    if source.count(CANONICAL_CONDITION) != 1:
+        raise ValueError("canonical program has an unexpected singleton condition")
+    return source
+
+
+def materialize_rival(source: str, rival: str) -> str:
+    if type(source) is not str or source.count(CANONICAL_CONDITION) != 1:
+        raise ValueError("source must contain the exact canonical singleton condition once")
+    if rival not in RIVAL_PREDICATES:
+        raise ValueError(f"unknown rival {rival!r}")
+    predicate = RIVAL_PREDICATES[rival]
+    replacement = CANONICAL_CONDITION.replace(
+        "(and (not (= v 0)) ", f"(and (not (= v 0)) {predicate} ", 1
+    )
+    result = source.replace(CANONICAL_CONDITION, replacement, 1)
+    if result == source or result.count(predicate) != 1:
+        raise AssertionError("rival source edit did not apply exactly once")
+    return result
+
+
+def _rule_callable(source: str) -> str:
+    if type(source) is not str:
+        raise ValueError("expected one complete rule! source")
+    return wrap_rule(source)
+
+
+def _execute(source: str, grid: Any, bridge: RacketBridge) -> list[list[int]]:
+    normalized = normalize_grid(grid)
+    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in normalized) + ")"
+    expression = f"({_rule_callable(source)} {literal})"
+    return normalize_grid(bridge.eval_text(expression))
+
+
+def _prediction(generator: Any, grid: Any, rival: str) -> list[list[int]]:
+    if rival not in PYTHON_PREDICATES:
+        raise ValueError(f"unknown rival {rival!r}")
+    analysis = generator._analyze(grid)
+    if analysis["errors"]:
+        raise ValueError("; ".join(analysis["errors"]))
+    predicate = PYTHON_PREDICATES[rival]
+    out = [row[:] for row in analysis["grid"]]
+    for row, col, color in analysis["markers"]:
+        if not predicate(color):
+            continue
+        for delta_row, delta_col in generator._DIRS4:
+            out[row + delta_row][col + delta_col] = color
+    return out
+
+
+def _colors(generator: Any, grid: Any) -> list[int]:
+    analysis = generator._analyze(grid)
+    if analysis["errors"]:
+        raise ValueError("; ".join(analysis["errors"]))
+    return list(analysis["colors"])
+
+
+def scan(
+    *,
+    seed_limit: int = 256,
+    bands: tuple[str, ...] = VALID_BANDS,
+    verify_racket: bool = True,
+) -> dict[str, Any]:
+    if type(seed_limit) is not int or not 1 <= seed_limit <= 100_000:
+        raise ValueError("seed_limit must be an exact integer in 1..100000")
+    if (
+        type(bands) is not tuple
+        or not bands
+        or len(set(bands)) != len(bands)
+        or any(type(band) is not str or band not in VALID_BANDS for band in bands)
+    ):
+        raise ValueError(f"bands must be a nonempty distinct tuple from {VALID_BANDS}")
+    if type(verify_racket) is not bool:
+        raise ValueError("verify_racket must be boolean")
+
+    generator = _load_generator()
+    canonical = canonical_program()
+    witnesses: dict[str, dict[str, Any]] = {}
+    survivor_counts = {name: 0 for name in RIVAL_PREDICATES}
+    lesson_count = 0
+
+    for band in bands:
+        for seed in range(seed_limit):
+            grids = [generator.generate(seed, index, difficulty=band) for index in range(3)]
+            expected = [generator._expected_output(grid) for grid in grids]
+            lesson_count += 1
+            for rival in RIVAL_PREDICATES:
+                predictions = [_prediction(generator, grid, rival) for grid in grids]
+                demo_matches = [predictions[index] == expected[index] for index in range(2)]
+                query_matches = [predictions[2] == expected[2]]
+                if all(demo_matches):
+                    survivor_counts[rival] += 1
+                if all(demo_matches) and not all(query_matches) and rival not in witnesses:
+                    witnesses[rival] = {
+                        "rival": rival,
+                        "band": band,
+                        "seed": seed,
+                        "sample_indices": [0, 1, 2],
+                        "demo_colors": [_colors(generator, grid) for grid in grids[:2]],
+                        "query_colors": _colors(generator, grids[2]),
+                        "inputs": grids,
+                        "canonical_outputs": expected,
+                        "rival_outputs": predictions,
+                        "input_sha256": [_grid_sha(grid) for grid in grids],
+                        "canonical_output_sha256": [_grid_sha(grid) for grid in expected],
+                        "rival_output_sha256": [_grid_sha(grid) for grid in predictions],
+                        "demo_matches": demo_matches,
+                        "query_matches": query_matches,
+                    }
+
+    runtime_identity = None
+    racket_evaluations = 0
+    if verify_racket and witnesses:
+        with RacketBridge(max_calls_before_restart=128) as bridge:
+            runtime_identity = bridge.runtime_identity
+            if runtime_identity.get("backend") != "racket" or runtime_identity.get("protected") is not True:
+                raise ValueError("probe requires the protected Racket backend")
+            for rival, witness in witnesses.items():
+                rival_source = materialize_rival(canonical, rival)
+                canonical_racket = [_execute(canonical, grid, bridge) for grid in witness["inputs"]]
+                rival_racket = [_execute(rival_source, grid, bridge) for grid in witness["inputs"]]
+                racket_evaluations += 6
+                if canonical_racket != witness["canonical_outputs"]:
+                    raise AssertionError("canonical Python evidence differs from protected Racket")
+                if rival_racket != witness["rival_outputs"]:
+                    raise AssertionError("rival Python evidence differs from protected Racket")
+                witness["canonical_program_sha256"] = _sha_text(canonical)
+                witness["rival_program"] = rival_source
+                witness["rival_program_sha256"] = _sha_text(rival_source)
+                witness["protected_racket_replayed"] = True
+
+    ordered = [witnesses[name] for name in RIVAL_PREDICATES if name in witnesses]
+    return {
+        "schema": "bfa4f83b9dbd-color-gate-probe-v1",
+        "status": "counterexample_found" if ordered else "no_finding",
+        "task_id": TASK_ID,
+        "generator_sha256": _sha_bytes(GENERATOR_PATH.read_bytes()),
+        "canonical_program_sha256": _sha_text(canonical),
+        "scan": {
+            "seed_range": [0, seed_limit - 1],
+            "bands": list(bands),
+            "lessons": lesson_count,
+            "lesson_shape": "same seed, sample indexes 0 and 1 as demos, 2 as query",
+            "demonstrations": 2,
+            "queries": 1,
+        },
+        "rival_survival_counts": survivor_counts,
+        "witnesses": ordered,
+        "protected_racket": {
+            "requested": verify_racket,
+            "evaluations": racket_evaluations,
+            "runtime_identity": runtime_identity,
+        },
+        "recommendation": (
+            "Add a color-diversity lesson guard or include simple palette-gated rivals in "
+            "lesson_identifiable; seed 21/easy is a minimal even-only counterexample."
+            if ordered
+            else "No palette-gated survivor found in this finite scan."
+        ),
+        "limits": [
+            "Finite seed/band scan; does not prove universal lesson uniqueness.",
+            "The rival bank is limited to four simple color predicates.",
+            "Peer evidence is advisory and requires owner review before integration.",
+        ],
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed-limit", type=int, default=256)
+    parser.add_argument("--bands", default=",".join(VALID_BANDS))
+    parser.add_argument("--python-only", action="store_true")
+    parser.add_argument("--out", type=Path, required=True)
+    options = parser.parse_args(argv)
+    bands = tuple(part.strip() for part in options.bands.split(",") if part.strip())
+    report = scan(
+        seed_limit=options.seed_limit,
+        bands=bands,
+        verify_racket=not options.python_only,
+    )
+    options.out.parent.mkdir(parents=True, exist_ok=True)
+    options.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"],
+        "lessons": report["scan"]["lessons"],
+        "witnesses": len(report["witnesses"]),
+        "out": str(options.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
