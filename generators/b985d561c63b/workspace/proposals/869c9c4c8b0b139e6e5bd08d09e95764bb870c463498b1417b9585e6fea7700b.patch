+"""Regression tests for the b6ba2d176fe8 object-count lesson probe."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+
+TASK_HOME = Path(__file__).resolve().parents[1]
+PROBE_PATH = TASK_HOME / "workspace/parametric/count_gate_probe.py"
+
+
+def load_probe():
+    assert PROBE_PATH.is_file(), f"required peer audit tool is missing: {PROBE_PATH}"
+    spec = importlib.util.spec_from_file_location("b6ba2d176fe8_count_gate_probe", PROBE_PATH)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_count_gate_rival_fits_all_three_demos_but_fails_six_object_query():
+    probe = load_probe()
+    report = probe.build_report(seed=20261023, verify_racket=False)
+
+    assert report["status"] == "counterexample_found"
+    assert report["object_counts"] == [3, 4, 5, 6, 3, 4, 5]
+    assert len(report["witnesses"]) == 2
+    for witness in report["witnesses"]:
+        assert witness["demo_matches"] == [True, True, True]
+        assert witness["query_matches"] == [False, True, True, True]
+        assert witness["first_failing_query"] == 0
+        assert witness["rival_program_sha256"] != witness["target_program_sha256"]
+        assert witness["rival_program"].count("(length objs)") == 1
+
+
+def test_count_gate_rival_materialization_is_guarded_and_setting_specific():
+    probe = load_probe()
+    left = probe.materialize_count_gate_rival("left_to_right")
+    right = probe.materialize_count_gate_rival("right_to_left")
+
+    assert left != right
+    assert "(= (length objs) 6)" in left
+    assert "(= (length objs) 6)" in right
+    assert left.count(probe.proto._SORT_FRAGMENT) == 1
+    assert right.count(probe.proto._REVERSE_SORT_FRAGMENT) == 1
+    with pytest.raises(ValueError, match="sort_order"):
+        probe.materialize_count_gate_rival("sideways")
+
+
+def test_count_gate_probe_rejects_nonliteral_seed_before_generation():
+    probe = load_probe()
+    for bad_seed in (True, False, -1, 1.0, "1"):
+        with pytest.raises(ValueError, match="seed"):
+            probe.build_report(seed=bad_seed, verify_racket=False)
