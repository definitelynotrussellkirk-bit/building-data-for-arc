    },
    {
      "name": "float_sample_index",
      "seed": 991,
      "sample_index": 0.0,
      "difficulty": "medium",
      "overrides": {},
      "expected_exception": "TypeError",
      "message_pattern": "sample_index"
    },
    {
      "name": "negative_sample_index",
      "seed": 991,
      "sample_index": -1,
      "difficulty": "hard",
      "overrides": {},
      "expected_exception": "ValueError",
      "message_pattern": "nonnegative"
    }
  ]
