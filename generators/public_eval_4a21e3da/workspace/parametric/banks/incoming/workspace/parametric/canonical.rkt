(rule!
 ;; Boundary markers cut orange artwork along their rows or columns.
 ;; Keep orange cut pixels; extend each red ray to its furthest orange hit.
 ;; Group all remaining cells by cut sector, not by connected component.
 ;; Only sectors adjacent to a marked boundary survive; dock each at its corner.
 (lambda (g)
  (let ()
   (define selection-mode 0)
   (define geometry-mode 0)
   (define ray-mode 0)
   (define include-unmarked #f)
   (define fg (filter (lambda (p) (= (at g (first p) (second p)) 7)) (grid-positions g)))
   (define marks (filter (lambda (p) (= (at g (first p) (second p)) 2)) (grid-positions g)))
   (define vm (find-first (lambda (p) (or (= (first p) 0) (= (first p) (- h 1)))) marks))
   (define hm (find-first (lambda (p) (or (= (second p) 0) (= (second p) (- w 1)))) marks))
   (define vc (if vm (second vm) -1))
   (define hr (if hm (first hm) -1))
   (define fixed (filter (lambda (p) (or (= (first p) hr) (= (second p) vc))) fg))
   (define free (filter (lambda (p) (not (member p fixed))) fg))
   (define ys (if hm '(0 1) (list (if (= (first vm) 0) 0 1))))
   (define xs (if vm '(0 1) (list (if (= (second hm) 0) 0 1))))
   (define raw-sectors
     (for*/list ((y ys) (x xs))
       (list y x
         (if (or include-unmarked
                 (and vm (= y (if (= (first vm) 0) 0 1)))
                 (and hm (= x (if (= (second hm) 0) 0 1))))
           (filter (lambda (p)
             (and (or (not hm) (if (= y 0) (< (first p) hr) (> (first p) hr)))
                  (or (not vm) (if (= x 0) (< (second p) vc) (> (second p) vc))))) free)
           '()))))
   (define nonempty (filter (lambda (s) (not (null? (third s)))) raw-sectors))
   (define sectors
     (if (= geometry-mode 1)
       (apply append (map (lambda (s)
         (map (lambda (o) (list (first s) (second s) (obj-cells o)))
           (objects (recolor-cells (grid-from-fn h w (lambda (r c) 1)) (third s) 7) 1))) nonempty))
       nonempty))
   (define (size s) (length (third s)))
   (define (area s)
     (let ((b (bbox-of-cells (third s))))
       (* (+ 1 (- (third b) (first b))) (+ 1 (- (fourth b) (second b))))))
   (define chosen
     (cond ((null? sectors) '())
           ((= selection-mode 0) sectors)
           ((= selection-mode 1) (list (pick-max sectors size)))
           ((= selection-mode 2) (list (pick-min sectors size)))
           ((= selection-mode 3) (list (first sectors)))
           ((= selection-mode 4) (list (last sectors)))
           (else (list (pick-max sectors area)))))
   (define ray-grid
     (for/fold ((out (grid-from-fn h w (lambda (r c) 1)))) ((m marks))
       (let* ((vertical (or (= (first m) 0) (= (first m) (- h 1))))
              (start (if vertical (first m) (second m)))
              (forward (= start 0))
              (hits (map (lambda (p) (if vertical (first p) (second p)))
                 (filter (lambda (p) (if vertical (= (second p) (second m)) (= (first p) (first m)))) fg)))
              (stop (cond ((= ray-mode 1) start)
                          ((= ray-mode 2) (if forward (- (if vertical h w) 1) 0))
                          ((= ray-mode 3) (if forward (apply min hits) (apply max hits)))
                          (else (if forward (apply max hits) (apply min hits))))))
         (for/fold ((painted out)) ((k (range (min start stop) (+ 1 (max start stop)))))
           (set-cell painted (if vertical k (first m)) (if vertical (second m) k) 2)))))
   (for/fold ((out (recolor-cells ray-grid fixed 7))) ((s chosen))
     (let* ((cells (third s))
            (b (bbox-of-cells (if (= geometry-mode 2) fg cells)))
            (dr (if (= geometry-mode 3) 0 (if (= (first s) 0) (- (first b)) (- h 1 (third b)))))
            (dc (if (= geometry-mode 3) 0 (if (= (second s) 0) (- (second b)) (- w 1 (fourth b))))))
       (recolor-cells out (map (lambda (p) (list (+ dr (first p)) (+ dc (second p)))) cells) 7))))))
