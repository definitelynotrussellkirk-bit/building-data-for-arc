+"""Bounded source-bound reflection teaching audit; production is untouched."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "src"))
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+TASK = "c8d8b907048d"
+SOURCE_SHA = "4b9c54dab9598576bce6f4b62439dd23581b7e7ca865ca7f1ee403f75d12a186"
+RULE_HASH = "30f91a42c7e5"
+
+
+def sha(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def axis_rival(axis):
+    return f"""(rule!
+ (let ((axis {axis}))
+  (for*/fold ((out g)) ((r (in-range (quotient h 2))) (c (in-range w)))
+   (let* ((v (at g r c)) (target (- axis r)))
+    (if (or (= v 0) (< target 0) (>= target h)) out
+        (set-cell out target c v))))))"""
+
+
+RIVALS = {
+    "compress_empty_source_rows": """(rule!
+ (let* ((used (for/list ((rr (in-range (quotient h 2)))
+                       #:when (for/or ((cc (in-range w))) (> (at g rr cc) 0))) rr))
+        (n (length used)))
+  (build-grid h w (r c)
+   (if (>= r (- h n)) (at g (list-ref used (- h 1 r)) c) (at g r c)))))""",
+    "always_no_center_gap": axis_rival("(- (* 2 (quotient h 2)) 1)"),
+    "always_one_center_gap_clipped": axis_rival("(* 2 (quotient h 2))"),
+    "only_topmost_source_in_column": """(rule!
+ (for*/fold ((out g)) ((r (in-range (quotient h 2))) (c (in-range w)))
+  (let ((v (at g r c)))
+   (if (and (> v 0) (for/and ((above (in-range r))) (= (at g above c) 0)))
+       (set-cell out (- h 1 r) c v) out))))""",
+}
+
+
+def demo_only_survivors(demos, apply_program):
+    """Finite proposed guard; exceptions propagate, and no query is inspected."""
+    return [name for name, program in RIVALS.items()
+            if all(_grid(apply_program(program, pair["input"])) == pair["output"]
+                   for pair in demos)]
+
+
+def first_difference(left, right):
+    for r, row in enumerate(left):
+        for c, value in enumerate(row):
+            if value != right[r][c]:
+                return {"row": r, "col": c, "intended": value, "rival": right[r][c]}
+    return None
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    ledger = ROOT / "shared/data/canonical/puzzles.jsonl"
+    rows = [json.loads(line) for line in ledger.read_text().splitlines()]
+    selected = [row for row in rows if row.get("task_id") == TASK]
+    assert len(selected) == 1
+    selected = selected[0]
+    program = selected["program_solution"]
+    assert sha(" ".join(program.split()).encode())[:12] == RULE_HASH
+    report = {
+        "schema": "arcpuzzles-bounded-peer-adversarial-probe-v1",
+        "task_id": TASK, "status": "running", "execution_errors": [],
+        "source_binding": {"generator_sha256": SOURCE_SHA, "rule_hash": RULE_HASH,
+                           "canonical_program_sha256": sha(program.encode()),
+                           "canonical_ledger_path": str(ledger.relative_to(ROOT)),
+                           "probe_sha256": sha(Path(__file__).read_bytes())},
+        "programs": {"intended": program, **RIVALS},
+        "sampling": {"seeds": [0, 1], "difficulty": None, "overrides": {},
+                     "generated_inputs": 16, "indices_per_seed": 8,
+                     "demo_indices": [0, 1, 2], "query_indices": [3, 4, 5, 6],
+                     "additional_candidate_index": 7},
+        "limits": ["Four finite rivals only; no universal uniqueness claim.",
+                   "Generated inputs use no overrides; saved canonical lessons are reported separately.",
+                   "The always-one-gap rival clips destinations outside the existing canvas.",
+                   "No production or canonical edits, approval, qualification or admission.",
+                   "The existing two-depth-anchor/fixed-offset audit is not repeated."]}
+    runtime = ROOT / "shared/runtime"
+    try:
+        with _local_imports(runtime, Path(__file__).resolve().parent):
+            from reviewer_support import load_selected_generator
+            gen, source, source_hash = load_selected_generator(TASK, root=ROOT)
+            assert source_hash == SOURCE_SHA
+            report["source_binding"]["generator_path"] = str(source.relative_to(ROOT))
+            apply, report["racket"], bridge = _real_evaluator(runtime)
+            cache = {}
+
+            def execute(text, grid):
+                key = (text, json.dumps(grid, separators=(",", ":")))
+                if key not in cache:
+                    cache[key] = _grid(apply(text, grid))
+                return cache[key]
+
+            def label(grid, origin):
+                errors = gen.self_check(grid)
+                assert not errors, errors
+                return {"origin": origin, "input": grid, "self_check": errors,
+                        "height": len(grid), "width": len(grid[0]),
+                        "occupied_source_rows": [r for r in range(len(grid)//2) if any(grid[r])],
+                        "output": execute(program, grid),
+                        "rival_outputs": {name: execute(text, grid) for name, text in RIVALS.items()}}
+
+            def lesson(name, demos, queries):
+                surviving = demo_only_survivors(demos, execute)
+                return {"name": name, "demos": demos, "queries": queries,
+                        "survivors_from_demos_only": surviving,
+                        "query_disagreements": [
+                            {"origin": query["origin"], "rival": rival,
+                             "first_difference": first_difference(query["output"], query["rival_outputs"][rival])}
+                            for query in queries for rival in surviving
+                            if query["output"] != query["rival_outputs"][rival]]}
+
+            try:
+                saved_demos = [label(pair["input"], {"kind": "saved_canonical_demo", "index": i})
+                               for i, pair in enumerate(selected["train"])]
+                saved_queries = [label(pair["input"], {"kind": "saved_canonical_query", "index": i})
+                                 for i, pair in enumerate(selected["test"])]
+                for saved, actual in zip(selected["train"] + selected["test"], saved_demos + saved_queries):
+                    assert saved["output"] == actual["output"]
+                report["saved_canonical_lesson"] = lesson("saved_canonical", saved_demos, saved_queries)
+                report["generated_lessons"] = []
+                samples = []
+                for seed in (0, 1):
+                    drawn = [label(gen.generate(seed, index),
+                                   {"kind": "ordinary_generated", "seed": seed, "sample_index": index})
+                             for index in range(8)]
+                    samples.extend(drawn)
+                    current = lesson(f"generated_seed_{seed}", drawn[:3], drawn[3:7])
+                    current["additional_candidate"] = drawn[7]
+                    report["generated_lessons"].append(current)
+                report["repair_proposals"] = []
+                for current in [report["saved_canonical_lesson"], *report["generated_lessons"]]:
+                    survivors = current["survivors_from_demos_only"]
+                    if not current["query_disagreements"]:
+                        continue
+                    used = {json.dumps(row["input"]) for row in current["demos"] + current["queries"]}
+                    extra = next((row for row in samples if json.dumps(row["input"]) not in used
+                                  and all(row["output"] != row["rival_outputs"][rival]
+                                          for rival in survivors)), None)
+                    report["repair_proposals"].append({
+                        "lesson": current["name"],
+                        "selection": "already sampled input selected by demo disagreement only; excludes original demos and queries",
+                        "extra_demo": extra,
+                        "survivors_after": demo_only_survivors(current["demos"] + [extra], execute) if extra else None,
+                        "limit": None if extra else "no single distinguishing extra demo found within sampled budget"})
+                report["protected_evaluations"] = len(cache)
+                report["status"] = ("bounded_ambiguity_confirmed" if any(
+                    lesson["query_disagreements"] for lesson in [report["saved_canonical_lesson"], *report["generated_lessons"]]
+                ) else "bounded_no_query_ambiguity_found")
+            finally:
+                bridge.close()
+            assert sha(source.read_bytes()) == SOURCE_SHA
+    except Exception as error:
+        report["status"] = "execution_error_not_refutation"
+        report["execution_errors"].append({"type": type(error).__name__, "message": str(error)})
+        (args.out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+        raise
+    (args.out / "report.json").write_text(json.dumps(report, separators=(",", ":")) + "\n")
+    summary = {key: report[key] for key in ("schema", "task_id", "status", "source_binding", "racket", "sampling", "execution_errors", "protected_evaluations", "limits")}
+    summary["lessons"] = [{"name": row["name"], "survivors": row["survivors_from_demos_only"],
+                           "query_disagreements": row["query_disagreements"]}
+                          for row in [report["saved_canonical_lesson"], *report["generated_lessons"]]]
+    summary["repair_proposals"] = [{"lesson": row["lesson"],
+                                    "extra_demo_origin": row["extra_demo"]["origin"] if row["extra_demo"] else None,
+                                    "survivors_after": row["survivors_after"], "limit": row["limit"]}
+                                   for row in report["repair_proposals"]]
+    (args.out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
