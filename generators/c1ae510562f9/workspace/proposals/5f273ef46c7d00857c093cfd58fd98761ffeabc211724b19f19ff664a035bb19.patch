+"""Bounded, source-pinned lesson audit of boundary intersection coloring.
+
+The alternate rule completes both colored lines, but marks their meeting point
+yellow only for an interior crossing; at a boundary it uses red. Both programs
+are replayed through protected Racket. Production source is not changed.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import load_selected_generator
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = "c99f630b7541"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+SOURCE_PIN = "31fec815826e1c811faa689168d33194cf12e385e47dc728912cd1f3cea07c71"
+RULE_PIN = "b446902efab5"
+
+
+def sha(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def boundary_intersection(grid):
+    columns = {c for row in grid for c, value in enumerate(row) if value == 8}
+    rows = {r for r, row in enumerate(grid) for value in row if value == 2}
+    assert len(columns) == len(rows) == 1
+    column, row = next(iter(columns)), next(iter(rows))
+    return row in (0, len(grid) - 1) or column in (0, len(grid[0]) - 1)
+
+
+def needs_boundary_demo(demos, query):
+    """Focused proposed teaching guard; covers this rival only."""
+    return boundary_intersection(query) and not any(boundary_intersection(g) for g in demos)
+
+
+def rival_program(program):
+    old = "((and (= r row2) (= c col8)) 4)"
+    new = "((and (= r row2) (= c col8)) (if (and (> r 0) (< r (- h 1)) (> c 0) (< c (- w 1))) 4 2))"
+    assert program.count(old) == 1
+    return program.replace(old, new, 1)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    gen, source, digest = load_selected_generator(TASK, root=ROOT)
+    assert digest == SOURCE_PIN, "Source changed; review this pinned audit"
+    rows = [json.loads(line) for line in
+            (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()]
+    selected = [row for row in rows if row.get("task_id") == TASK]
+    assert len({row["program_solution"] for row in selected}) == 1
+    canonical = next(row for row in selected if row.get("source") == "training")
+    program = canonical["program_solution"]
+    assert sha(" ".join(program.split()))[:12] == RULE_PIN
+    rival = rival_program(program)
+    samples = []
+    for seed in (0, 17):
+        for index in range(8):
+            grid = gen.generate(seed, index, difficulty="easy")
+            assert gen.self_check(grid) == []
+            samples.append({"input": grid, "generation": {"seed": seed,
+                "sample_index": index, "difficulty": "easy", "overrides": {}},
+                "boundary": boundary_intersection(grid)})
+    demos = query = None
+    scope = None
+    for start in range(len(samples) - 2):
+        a, b, q = samples[start:start + 3]
+        if (a["generation"]["seed"] == q["generation"]["seed"]
+                and not a["boundary"] and not b["boundary"] and q["boundary"]):
+            demos, query = [a, b], q
+            scope = "two consecutive ordinary generated demos and next generated query"
+            break
+    if query is None:
+        interior = [s for s in samples if not s["boundary"]]
+        boundary = [s for s in samples if s["boundary"]]
+        if len(interior) >= 2 and boundary:
+            demos, query = interior[:2], boundary[0]
+            scope = "assembled lesson from ordinary generated inputs"
+    report = {"schema": "arc-bounded-boundary-review-v1", "task_id": TASK,
+              "source_sha256": digest, "rule_hash": RULE_PIN,
+              "canonical_program_sha256": sha(program), "rival_program_sha256": sha(rival),
+              "rival_program": rival,
+              "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "rival": "yellow for interior intersections only; red wins at a boundary",
+              "sampled_inputs": [{"generation": s["generation"], "boundary": s["boundary"]} for s in samples],
+              "status": "finding" if query else "finite_no_counterexample",
+              "scope": scope, "prior_dead_control_domain_findings": "remain unresolved; not rerun or duplicated",
+              "limits": "One rival, two seeds,16 ordinary inputs,easy band; no prevalence claim, battery, source repair, or approval."}
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            report["runtime_identity"] = identity
+            evaluations = 0
+            fits = []
+            for pair in canonical["train"] + canonical["test"]:
+                out, alternative = apply(program, pair["input"]), apply(rival, pair["input"])
+                evaluations += 2
+                assert out == pair["output"]
+                fits.append(out == alternative)
+            report["canonical_rival_fit"] = fits
+            assert all(fits)
+            if query:
+                repair = next(s for s in samples if s["boundary"] and s["input"] != query["input"])
+                for pair in demos + [query, repair]:
+                    pair["output"] = apply(program, pair["input"])
+                    pair["rival_output"] = apply(rival, pair["input"])
+                    pair["self_check_errors"] = gen.self_check(pair["input"])
+                    evaluations += 2
+                assert all(p["output"] == p["rival_output"] for p in demos)
+                assert query["output"] != query["rival_output"]
+                assert repair["output"] != repair["rival_output"]
+                assert needs_boundary_demo([p["input"] for p in demos], query["input"])
+                assert not needs_boundary_demo([p["input"] for p in demos] + [repair["input"]], query["input"])
+                report.update(train=demos, test=[query], distinguishing_demo=repair,
+                    rival_fits_all_demos=True, rival_changes_query=True,
+                    guard_rejects_original=True, guard_accepts_augmented=True,
+                    adding_distinct_boundary_demo_rejects_rival=True,
+                    differing_query_cells=[[r, c, a, b]
+                        for r, (a_row, b_row) in enumerate(zip(query["output"], query["rival_output"]))
+                        for c, (a, b) in enumerate(zip(a_row, b_row)) if a != b])
+            report["racket_evaluations"] = evaluations
+        finally:
+            bridge.close()
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == digest
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    summary = {k: report[k] for k in ("status", "scope", "source_sha256", "canonical_rival_fit", "racket_evaluations")}
+    if query:
+        summary.update(demos=[p["generation"] for p in demos], query=query["generation"],
+                       repair=repair["generation"], differing_query_cells=report["differing_query_cells"])
+    print(json.dumps(summary))
+
+
+if __name__ == "__main__":
+    main()
