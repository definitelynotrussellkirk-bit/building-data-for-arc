(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g))
                (objs (objects g 0))
                (sorted (reverse (sort-by objs (lambda (o) (second (obj-bbox o))))))
                (infos (map (lambda (o)
                              (let ((bb (obj-bbox o)))
                                (list (obj-color o)
                                      (+ 1 (- (nth bb 2) (nth bb 0)))
                                      (+ 1 (- (nth bb 3) (nth bb 1))))))
                            sorted))
                (blank (cellmap g (r c v) 0))
                (result (reduce (lambda (state info)
                                  (let* ((grid (first state))
                                         (cr (second state))
                                         (cc (third state))
                                         (color (first info))
                                         (oh (second info))
                                         (ow (third info)))
                                    (list (recolor-cells grid
                                                         (flatmap (lambda (dr)
                                                                    (map (lambda (dc)
                                                                           (cons (+ cr
                                                                                    dr)
                                                                                 (+ cc
                                                                                    dc)))
                                                                         (range 0 ow)))
                                                                  (range 0 oh))
                                                         color)
                                          (+ cr (- oh 1))
                                          (+ cc (- ow 1)))))
                                (list blank 0 0)
                                infos)))
           (first result))))