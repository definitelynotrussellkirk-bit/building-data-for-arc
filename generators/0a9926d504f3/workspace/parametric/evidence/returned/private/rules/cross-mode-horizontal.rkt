(rule! (lambda (g)
         (let* ((pixels (filter (lambda (p) (!= 0 (at g (fst p) (snd p))))
                                (grid-positions g)))
                (center-p (first (find-color g 2)))
                (cr (fst center-p))
                (cc (snd center-p))
                (others (filter (lambda (p) (!= 2 (at g (fst p) (snd p)))) pixels))
                (min-r-marker (pick-min others fst))
                (max-r-marker (pick-max others fst))
                (min-c-marker (pick-min others snd))
                (max-c-marker (pick-max others snd))
                (top-r (fst min-r-marker))
                (top-color (at g top-r (snd min-r-marker)))
                (bot-r (fst max-r-marker))
                (bot-color (at g bot-r (snd max-r-marker)))
                (lft-c (snd min-c-marker))
                (lft-color (at g (fst min-c-marker) lft-c))
                (rgt-c (snd max-c-marker))
                (rgt-color (at g (fst max-c-marker) rgt-c)))
           (cellmap g
                    (r c v)
                    (cond
                      ((and (= r top-r) (>= c lft-c) (<= c rgt-c)) top-color)
                      ((and (= r bot-r) (>= c lft-c) (<= c rgt-c)) bot-color)
                      ((and (= c lft-c) (>= r top-r) (<= r bot-r)) lft-color)
                      ((and (= c rgt-c) (>= r top-r) (<= r bot-r)) rgt-color)
                      ((and (= r cr) (= c cc)) 2)
                      ((and (= r cr) (> c lft-c) (< c rgt-c)) 5)
                      ((and (= c cc) (> r top-r) (< r bot-r)) 0)
                      (else 0))))))