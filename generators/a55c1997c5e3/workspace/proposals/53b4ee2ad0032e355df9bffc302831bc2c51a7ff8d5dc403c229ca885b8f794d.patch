+  "program_solution": "(rule!\n ;; 2x2 blocks are nodes: the red(2) one is the start, cyan(8) the\n ;; rest. Two nodes connect when axis-aligned with no node between.\n ;; Walk the LONGEST simple path from the start (ties broken by\n ;; direction priority right, down, left, up) and pave orange(7)\n ;; corridors between consecutive nodes.\n (lambda (g)\n   (let ()\n     (define (block? r c)  ;; top-left corner of a 2x2 block\n       (let ((v (at g r c)))\n         (and (or (= v 2) (= v 8))\n              (= (at g r (+ c 1)) v)\n              (= (at g (+ r 1) c) v)\n              (= (at g (+ r 1) (+ c 1)) v)\n              (or (zero? r)\n                  (not (and (= (at g (- r 1) c) v)\n                            (= (at g (- r 1) (+ c 1)) v))))\n              (or (zero? c)\n                  (not (and (= (at g r (- c 1)) v)\n                            (= (at g (+ r 1) (- c 1)) v)))))))\n     (define nodes\n       (for*/list ((r (range 0 (- h 1))) (c (range 0 (- w 1)))\n                   #:when (block? r c))\n         (list r c (at g r c))))\n     (define start (find-first (lambda (n) (= (third n) 2)) nodes))\n     (define (between? x a b) (and (> x (min a b)) (< x (max a b))))\n     (define (adjacent? a b)  ;; same line of sight, nothing between\n       (or (and (= (first a) (first b))\n                (not (any? (lambda (n)\n                             (and (not (equal? n a)) (not (equal? n b))\n                                  (= (first n) (first a))\n                                  (between? (second n) (second a)\n                                            (second b))))\n                           nodes)))\n           (and (= (second a) (second b))\n                (not (any? (lambda (n)\n                             (and (not (equal? n a)) (not (equal? n b))\n                                  (= (second n) (second a))\n                                  (between? (first n) (first a)\n                                            (first b))))\n                           nodes)))))\n     (define (dir-priority a b)  ;; up 0, left 1, down 2, right 3\n       (cond ((= (first a) (first b))\n              (if (< (second a) (second b)) 3 1))\n             ((< (first a) (first b)) 2)\n             (else 0)))\n     (define (dir-list path)\n       (if (or (empty? path) (empty? (rest path)))\n           (list)\n           (cons (dir-priority (first path) (second path))\n                 (dir-list (rest path)))))\n     (define (lex-less? xs ys)\n       (cond ((empty? xs) #f)\n             ((< (first xs) (first ys)) #t)\n             ((> (first xs) (first ys)) #f)\n             (else (lex-less? (rest xs) (rest ys)))))\n     (define (better-path? a b)\n       (cond ((> (length a) (length b)) #t)\n             ((< (length a) (length b)) #f)\n             (else (lex-less? (dir-list a) (dir-list b)))))\n     (define (best-path-from current visited)  ;; exhaustive DFS\n       (let ((candidates\n              (map (lambda (n)\n                     (cons current\n                           (best-path-from n (cons n visited))))\n                   (filter (lambda (n)\n                             (and (not (member n visited))\n                                  (adjacent? current n)\n                                  (not (equal? n current))))\n                           nodes))))\n         (if (empty? candidates)\n             (list current)\n             (first (sort candidates better-path?)))))\n     (define (corridor out a b)  ;; orange fill between two blocks\n       (cond ((= (first a) (first b))\n              (for*/fold ((acc out))\n                         ((rr (range (first a) (+ (first a) 2)))\n                          (cc (range (+ (min (second a) (second b)) 2)\n                                     (max (second a) (second b)))))\n                (set-cell acc rr cc 7)))\n             ((= (second a) (second b))\n              (for*/fold ((acc out))\n                         ((rr (range (+ (min (first a) (first b)) 2)\n                                     (max (first a) (first b))))\n                          (cc (range (second a) (+ (second a) 2))))\n                (set-cell acc rr cc 7)))\n             (else out)))\n     (let loop ((path (best-path-from start (list start))) (out g))\n       (if (or (empty? path) (empty? (rest path)))\n           out\n           (loop (rest path)\n                 (corridor out (first path) (second path))))))))",
