@@ -0,0 +1,76 @@
+from __future__ import annotations
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "feaa89c467a0"
+PANEL_STARTS = (0, 6, 12, 18)
+ROOT = find_root(__file__)
+GEN, _SOURCE, _SOURCE_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _norm(cells):
+    cells = tuple(cells)
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return tuple(sorted((r - r0, c - c0) for r, c in cells))
+
+
+def _transform(cells, transform):
+    out = []
+    for r, c in cells:
+        if transform == 0:
+            out.append((r, c))
+        elif transform == 1:
+            out.append((c, -r))
+        elif transform == 2:
+            out.append((-r, -c))
+        elif transform == 3:
+            out.append((-c, r))
+        elif transform == 4:
+            out.append((r, -c))
+        elif transform == 5:
+            out.append((-c, -r))
+        elif transform == 6:
+            out.append((-r, c))
+        else:
+            out.append((c, r))
+    return _norm(out)
+
+
+def _free_dihedral_key(cells):
+    return min(_transform(cells, transform) for transform in range(8))
+
+
+def _panel_cells(grid, start):
+    return _norm(
+        (r, c - start)
+        for r, row in enumerate(grid)
+        for c in range(start, start + 5)
+        if row[c] != 0
+    )
+
+
+def test_exact_class_count_override_produces_distinct_asymmetric_classes():
+    """Changing motif fallback/ranges must not merge an advertised class."""
+    for difficulty in ("easy", None, "hard"):
+        for n_classes in range(1, 5):
+            for seed in range(16):
+                grid = GEN.generate(
+                    seed,
+                    0,
+                    difficulty=difficulty,
+                    n_classes=n_classes,
+                )
+                panels = [_panel_cells(grid, start) for start in PANEL_STARTS]
+                keys = [_free_dihedral_key(panel) for panel in panels]
+
+                assert len(set(keys)) == n_classes, (
+                    difficulty,
+                    n_classes,
+                    seed,
+                    [len(panel) for panel in panels],
+                )
+                assert all(
+                    len({_transform(panel, transform) for transform in range(8)}) == 8
+                    for panel in panels
+                )
