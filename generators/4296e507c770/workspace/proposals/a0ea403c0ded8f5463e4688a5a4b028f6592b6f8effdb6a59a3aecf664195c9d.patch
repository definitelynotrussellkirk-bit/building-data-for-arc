--- /dev/null
+++ b/repo/generators/595eebab5aea/workspace/probe_left_before_top.py
@@ -0,0 +1,303 @@
+"""Source-bound probe for an undeclared top/left tie-precedence ambiguity.
+
+The intended rule breaks equal occupied-area ties by bounding-box top and then
+left.  This probe tests the plausible shortcut that reverses those two keys.  A
+specific ordinary five-demo window admits that shortcut while its held-out query
+requires the intended precedence.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any, Callable
+
+from arc_repl.racket_bridge import RacketBridge
+from arcpuzzles import Catalog
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import find_root
+
+TASK_ID = "595eebab5aea"
+HOME = Path(__file__).resolve().parents[1]
+GENERATOR_PATH = HOME / "generator.py"
+EXPECTED_SOURCE_SHA256 = "92d329fc0fca6d59485820dc8fb544600fc521065f4b38dafe6894f85f1cb837"
+LESSON_SEED = 0
+LESSON_INDICES = tuple(range(4, 10))
+QUERY_INDEX = 9
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha256_value(value: Any) -> str:
+    return sha256_bytes(json.dumps(value, sort_keys=True, separators=(",", ":")).encode())
+
+
+def load_generator():
+    source_hash = sha256_bytes(GENERATOR_PATH.read_bytes())
+    if source_hash != EXPECTED_SOURCE_SHA256:
+        raise ValueError("generator source drifted from the reviewed probe binding")
+    spec = importlib.util.spec_from_file_location("probe_595eebab5aea_subject", GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise ValueError("could not import explicit generator source")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    if module.TASK_ID != TASK_ID:
+        raise ValueError("generator task id mismatch")
+    if sha256_bytes(GENERATOR_PATH.read_bytes()) != source_hash:
+        raise ValueError("generator changed during import")
+    return module, source_hash
+
+
+def selected_program() -> tuple[str, dict[str, Any]]:
+    root = find_root(__file__)
+    record = Catalog(root).get(TASK_ID)
+    programs = {
+        variant["program_solution"]
+        for variant in record["variants"]
+        if isinstance(variant.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise ValueError("expected one exact selected Racket program")
+    program = next(iter(programs))
+    return program, {
+        "rule_hash": record["rule_hash"],
+        "program_sha256": sha256_bytes(program.encode()),
+        "catalog_generator_sha256": record["generator_sha256"],
+    }
+
+
+def body_components(grid: list[list[int]]) -> list[dict[str, Any]]:
+    """Independently extract same-color four-neighbor bodies below row 1."""
+    height, width = len(grid), len(grid[0])
+    seen: set[tuple[int, int]] = set()
+    result = []
+    for row in range(2, height):
+        for col in range(width):
+            color = grid[row][col]
+            if color == 0 or (row, col) in seen:
+                continue
+            stack = [(row, col)]
+            seen.add((row, col))
+            cells = []
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    neighbor = (r + dr, c + dc)
+                    if (
+                        2 <= neighbor[0] < height
+                        and 0 <= neighbor[1] < width
+                        and neighbor not in seen
+                        and grid[neighbor[0]][neighbor[1]] == color
+                    ):
+                        seen.add(neighbor)
+                        stack.append(neighbor)
+            if len(cells) <= 1:
+                continue
+            top = min(r for r, _ in cells)
+            left = min(c for _, c in cells)
+            bottom = max(r for r, _ in cells)
+            right = max(c for _, c in cells)
+            result.append({
+                "color": color,
+                "cells": sorted(cells),
+                "area": len(cells),
+                "top": top,
+                "left": left,
+                "bottom": bottom,
+                "right": right,
+                "height": bottom - top + 1,
+                "width": right - left + 1,
+            })
+    return result
+
+
+def stack_prediction(
+    grid: list[list[int]],
+    order_key: Callable[[dict[str, Any]], tuple[int, ...]],
+) -> list[list[int]]:
+    bodies = sorted(body_components(grid), key=order_key)
+    ranks = [value for value in grid[0] if value != 0]
+    if len(bodies) != 3 or len(ranks) != 3:
+        raise ValueError("probe expects three bodies and three rank colors")
+    width = max(body["width"] for body in bodies)
+    height = sum(body["height"] for body in bodies) + 2
+    output = [[0 for _ in range(width)] for _ in range(height)]
+    top = 0
+    for body, color in zip(bodies, ranks):
+        left = (width - body["width"]) // 2
+        for row, col in body["cells"]:
+            output[top + row - body["top"]][left + col - body["left"]] = color
+        top += body["height"] + 1
+    return output
+
+
+def left_before_top_output(grid: list[list[int]]) -> list[list[int]]:
+    return stack_prediction(grid, lambda body: (-body["area"], body["left"], body["top"]))
+
+
+def canonical_key_output(grid: list[list[int]]) -> list[list[int]]:
+    return stack_prediction(grid, lambda body: (-body["area"], body["top"], body["left"]))
+
+
+def portable_runtime_identity(identity: dict[str, Any]) -> dict[str, Any]:
+    """Retain content hashes/security facts without checkout-specific paths."""
+    result = dict(identity)
+    result["binary_path"] = Path(result["binary_path"]).name
+    logical_paths = {
+        "bridge_path": "shared/runtime/arc_repl/racket_bridge.py",
+        "prelude_path": "shared/runtime/arc_repl/racket_prelude/arc-prelude.rkt",
+    }
+    for key, logical in logical_paths.items():
+        actual = Path(result[key]).as_posix()
+        suffix = logical.removeprefix("shared/runtime/")
+        if not actual.endswith(suffix):
+            raise ValueError(f"unexpected protected-Racket {key}: {actual}")
+        result[key] = logical
+    result["path_projection"] = "repo-relative-or-basename-v1"
+    return result
+
+
+def racket_outputs(
+    program: str,
+    grids: list[list[list[int]]],
+) -> tuple[list[list[list[int]]], dict[str, Any]]:
+    with RacketBridge() as bridge:
+        bridge.eval_text(f"(define __left_before_top_rule {wrap_rule(program)})")
+        outputs = []
+        for index, grid in enumerate(grids):
+            symbol = f"__left_before_top_input_{index}"
+            bridge.define_grid(symbol, grid)
+            outputs.append(bridge.eval_text(f"(__left_before_top_rule {symbol})"))
+        return outputs, portable_runtime_identity(dict(bridge.runtime_identity))
+
+
+def differences(reference: list[list[int]], shortcut: list[list[int]]) -> list[dict[str, int]]:
+    rows = max(len(reference), len(shortcut))
+    cols = max(len(reference[0]), len(shortcut[0]))
+    result = []
+    for row in range(rows):
+        for col in range(cols):
+            actual = reference[row][col] if row < len(reference) and col < len(reference[0]) else None
+            other = shortcut[row][col] if row < len(shortcut) and col < len(shortcut[0]) else None
+            if actual != other:
+                result.append({"row": row, "column": col, "reference": actual, "shortcut": other})
+    return result
+
+
+def run_probe() -> dict[str, Any]:
+    generator, source_hash = load_generator()
+    program, authority = selected_program()
+    grids = [generator.generate(LESSON_SEED, index) for index in LESSON_INDICES]
+    checks = [list(generator.self_check(grid) or []) for grid in grids]
+    if any(checks):
+        raise ValueError(f"lesson contains generator-domain failures: {checks}")
+
+    references, runtime = racket_outputs(program, grids)
+    canonical_mirror = [canonical_key_output(grid) for grid in grids]
+    if references != canonical_mirror:
+        raise ValueError("independent canonical mirror disagrees with selected Racket rule")
+    shortcuts = [left_before_top_output(grid) for grid in grids]
+    matches = [reference == shortcut for reference, shortcut in zip(references, shortcuts)]
+    if matches != [True, True, True, True, True, False]:
+        raise ValueError(f"retained lesson no longer has the expected ambiguity: {matches}")
+
+    query_position = LESSON_INDICES.index(QUERY_INDEX)
+    query_grid = grids[query_position]
+    query_reference = references[query_position]
+    query_shortcut = shortcuts[query_position]
+    changed = differences(query_reference, query_shortcut)
+    tied = sorted(
+        [body for body in body_components(query_grid) if body["area"] == 5],
+        key=lambda body: (body["top"], body["left"]),
+    )
+    canonical_order = [[body["top"], body["left"]] for body in tied]
+    shortcut_order = [
+        [body["top"], body["left"]]
+        for body in sorted(tied, key=lambda body: (body["left"], body["top"]))
+    ]
+
+    return {
+        "schema": "arcpuzzles-left-before-top-ambiguity-v1",
+        "status": "verified_left_before_top_ambiguity",
+        "task_id": TASK_ID,
+        "source_binding": {
+            "generator_path": str(GENERATOR_PATH.relative_to(find_root(__file__))),
+            "generator_sha256": source_hash,
+            "probe_sha256": sha256_bytes(Path(__file__).read_bytes()),
+            **authority,
+        },
+        "lesson": {
+            "seed": LESSON_SEED,
+            "indices": list(LESSON_INDICES),
+            "demo_indices": list(LESSON_INDICES[:-1]),
+            "query_index": QUERY_INDEX,
+        },
+        "racket": {
+            "backend": "racket",
+            "runtime": runtime,
+            "executed_evaluations": len(references),
+            "selected_program_sha256": authority["program_sha256"],
+        },
+        "demonstrations": {
+            "profiles": [generator.schedule_profile(LESSON_SEED, index, None) for index in LESSON_INDICES[:-1]],
+            "shortcut_matches": matches[:-1],
+            "input_sha256": [sha256_value(grid) for grid in grids[:-1]],
+            "output_sha256": [sha256_value(output) for output in references[:-1]],
+        },
+        "query": {
+            "profile": generator.schedule_profile(LESSON_SEED, QUERY_INDEX, None),
+            "input": query_grid,
+            "input_sha256": sha256_value(query_grid),
+            "reference_output": query_reference,
+            "reference_output_sha256": sha256_value(query_reference),
+            "shortcut_output": query_shortcut,
+            "shortcut_output_sha256": sha256_value(query_shortcut),
+            "shortcut_matches": False,
+            "differing_cell_count": len(changed),
+            "differences": changed,
+            "equal_area_order": {
+                "canonical_top_then_left": canonical_order,
+                "shortcut_left_then_top": shortcut_order,
+            },
+        },
+        "declared_competitor_present": "left_before_top" in getattr(generator, "LESSON_COMPETITORS", {}),
+        "finding": (
+            "The five visible demonstrations do not establish that bounding-box top precedes "
+            "left for equal occupied-area bodies. The ordinary held-out query contains an "
+            "above-right versus below-left tie and separates the plausible reversed precedence."
+        ),
+        "next_repair": (
+            "Add a constructive equal-area demonstration whose top order conflicts with left "
+            "order, then register left_before_top as a lesson competitor and recheck all rotations."
+        ),
+        "limits": "One exact ordinary lesson rotation; no production source change or universal hypothesis search.",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run_probe()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": report["status"],
+        "demo_matches": sum(report["demonstrations"]["shortcut_matches"]),
+        "query_differences": report["query"]["differing_cell_count"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
