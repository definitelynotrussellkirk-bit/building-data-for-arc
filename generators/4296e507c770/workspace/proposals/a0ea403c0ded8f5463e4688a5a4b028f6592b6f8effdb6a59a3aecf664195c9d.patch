+"""Bounded learnability probe for the aligned separator-lane shortcut.
+
+The current sampler always emits two aligned length-two bars.  A learner can
+therefore fill the entire lane between the bars' bounding boxes without learning
+the canonical one-step-plus-growth intersection.  This probe executes the exact
+selected Racket rule on generated examples and on one lawful offset-bar input.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from arcpuzzles import Catalog
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import find_root
+
+TASK_ID = "58785b2db07e"
+HOME = Path(__file__).resolve().parents[1]
+GENERATOR_PATH = HOME / "generator.py"
+EXPECTED_SOURCE_SHA256 = "aecfd2ad38c2cecde0e2d0df412fc058243342f7343bf109b2c6a496c54c86ca"
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha256_value(value: Any) -> str:
+    return sha256_bytes(json.dumps(value, sort_keys=True, separators=(",", ":")).encode())
+
+
+def load_generator():
+    source_hash = sha256_bytes(GENERATOR_PATH.read_bytes())
+    if source_hash != EXPECTED_SOURCE_SHA256:
+        raise ValueError("generator source drifted from the reviewed probe binding")
+    spec = importlib.util.spec_from_file_location("probe_58785b2db07e_subject", GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise ValueError("could not import explicit generator source")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    if module.TASK_ID != TASK_ID:
+        raise ValueError("generator task id mismatch")
+    if sha256_bytes(GENERATOR_PATH.read_bytes()) != source_hash:
+        raise ValueError("generator changed during import")
+    return module, source_hash
+
+
+def selected_program() -> tuple[str, dict[str, Any]]:
+    root = find_root(__file__)
+    record = Catalog(root).get(TASK_ID)
+    programs = {
+        variant["program_solution"]
+        for variant in record["variants"]
+        if isinstance(variant.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise ValueError("expected one exact selected Racket program")
+    program = next(iter(programs))
+    return program, {
+        "rule_hash": record["rule_hash"],
+        "program_sha256": sha256_bytes(program.encode()),
+        "catalog_generator_sha256": record["generator_sha256"],
+    }
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    return (
+        min(row for row, _ in cells),
+        min(col for _, col in cells),
+        max(row for row, _ in cells),
+        max(col for _, col in cells),
+    )
+
+
+def bbox_lane_output(grid: list[list[int]]) -> list[list[int]]:
+    """Plausible wrong rule: paint the full union-span separator lane."""
+    if not grid or not grid[0] or any(len(row) != len(grid[0]) for row in grid):
+        raise ValueError("expected a nonempty rectangle")
+    groups = {
+        color: [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == color]
+        for color in (2, 3)
+    }
+    if any(not cells for cells in groups.values()):
+        raise ValueError("both color groups are required")
+    a, b = _bbox(groups[2]), _bbox(groups[3])
+    output = [[0 for _ in row] for row in grid]
+
+    # Side-by-side boxes with exactly one intervening column.
+    left, right = (a, b) if a[1] <= b[1] else (b, a)
+    if right[1] - left[3] == 2:
+        col = left[3] + 1
+        for row in range(min(a[0], b[0]), max(a[2], b[2]) + 1):
+            output[row][col] = 8
+        return output
+
+    # Vertically separated boxes with exactly one intervening row.
+    top, bottom = (a, b) if a[0] <= b[0] else (b, a)
+    if bottom[0] - top[2] == 2:
+        row = top[2] + 1
+        for col in range(min(a[1], b[1]), max(a[3], b[3]) + 1):
+            output[row][col] = 8
+        return output
+    raise ValueError("groups do not have a one-cell bounding-box lane")
+
+
+def diagnostic_grid() -> list[list[int]]:
+    grid = [[0 for _ in range(8)] for _ in range(8)]
+    for row in (1, 2, 3):
+        grid[row][1] = 2
+    for row in (2, 3, 4):
+        grid[row][3] = 3
+    return grid
+
+
+def _cells(grid: list[list[int]], color: int = 8) -> list[list[int]]:
+    return [[r, c] for r, row in enumerate(grid) for c, value in enumerate(row) if value == color]
+
+
+def _differences(left: list[list[int]], right: list[list[int]]) -> list[dict[str, int]]:
+    result = []
+    for r in range(len(left)):
+        for c in range(len(left[0])):
+            if left[r][c] != right[r][c]:
+                result.append({"row": r, "column": c, "reference": left[r][c], "shortcut": right[r][c]})
+    return result
+
+
+def portable_runtime_identity(identity: dict[str, Any]) -> dict[str, Any]:
+    """Retain content hashes/security facts without checkout-specific paths."""
+    result = dict(identity)
+    result["binary_path"] = Path(result["binary_path"]).name
+    logical_paths = {
+        "bridge_path": "shared/runtime/arc_repl/racket_bridge.py",
+        "prelude_path": "shared/runtime/arc_repl/racket_prelude/arc-prelude.rkt",
+    }
+    for key, logical in logical_paths.items():
+        actual = Path(result[key]).as_posix()
+        suffix = logical.removeprefix("shared/runtime/")
+        if not actual.endswith(suffix):
+            raise ValueError(f"unexpected protected-Racket {key}: {actual}")
+        result[key] = logical
+    result["path_projection"] = "repo-relative-or-basename-v1"
+    return result
+
+
+def racket_outputs(
+    program: str,
+    grids: list[list[list[int]]],
+) -> tuple[list[list[list[int]]], dict[str, Any]]:
+    with RacketBridge() as bridge:
+        bridge.eval_text(f"(define __bbox_lane_rule {wrap_rule(program)})")
+        outputs = []
+        for index, grid in enumerate(grids):
+            symbol = f"__bbox_lane_input_{index}"
+            bridge.define_grid(symbol, grid)
+            outputs.append(bridge.eval_text(f"(__bbox_lane_rule {symbol})"))
+        return outputs, portable_runtime_identity(dict(bridge.runtime_identity))
+
+
+def run_probe(*, seed_count: int = 16, samples_per_seed: int = 4) -> dict[str, Any]:
+    if type(seed_count) is not int or seed_count < 1:
+        raise ValueError("seed_count must be a positive integer")
+    if type(samples_per_seed) is not int or samples_per_seed < 1:
+        raise ValueError("samples_per_seed must be a positive integer")
+    generator, source_hash = load_generator()
+    program, authority = selected_program()
+
+    generated = []
+    orientations = {"horizontal": 0, "vertical": 0}
+    for seed in range(seed_count):
+        for sample_index in range(samples_per_seed):
+            orientation = "horizontal" if (seed * samples_per_seed + sample_index) % 2 == 0 else "vertical"
+            grid = generator.generate(seed, sample_index, orientation=orientation)
+            errors = list(generator.self_check(grid) or [])
+            if errors:
+                raise ValueError(f"generated input failed self_check: {errors}")
+            generated.append(grid)
+            orientations[orientation] += 1
+
+    diagnostic = diagnostic_grid()
+    diagnostic_errors = list(generator.self_check(diagnostic) or [])
+    references, runtime = racket_outputs(program, [*generated, diagnostic])
+    generated_references, diagnostic_reference = references[:-1], references[-1]
+    generated_shortcuts = [bbox_lane_output(grid) for grid in generated]
+    shortcut_matches = sum(
+        reference == shortcut
+        for reference, shortcut in zip(generated_references, generated_shortcuts)
+    )
+    diagnostic_shortcut = bbox_lane_output(diagnostic)
+    changed = _differences(diagnostic_reference, diagnostic_shortcut)
+
+    if shortcut_matches != len(generated):
+        raise ValueError("bounded generated sample already distinguishes the shortcut")
+    if not changed:
+        raise ValueError("diagnostic input does not distinguish the shortcut")
+
+    return {
+        "schema": "arcpuzzles-bbox-lane-shortcut-probe-v1",
+        "status": "verified_bbox_lane_shortcut",
+        "task_id": TASK_ID,
+        "source_binding": {
+            "generator_path": str(GENERATOR_PATH.relative_to(find_root(__file__))),
+            "generator_sha256": source_hash,
+            "probe_sha256": sha256_bytes(Path(__file__).read_bytes()),
+            **authority,
+        },
+        "racket": {
+            "backend": "racket",
+            "runtime": runtime,
+            "executed_evaluations": len(references),
+            "selected_program_sha256": authority["program_sha256"],
+        },
+        "generated": {
+            "seed_count": seed_count,
+            "samples_per_seed": samples_per_seed,
+            "evaluated": len(generated),
+            "shortcut_matches": shortcut_matches,
+            "orientations": orientations,
+            "input_sha256": [sha256_value(grid) for grid in generated],
+        },
+        "diagnostic": {
+            "input": diagnostic,
+            "input_sha256": sha256_value(diagnostic),
+            "self_check_errors": diagnostic_errors,
+            "reference_output": diagnostic_reference,
+            "reference_cells": _cells(diagnostic_reference),
+            "shortcut_output": diagnostic_shortcut,
+            "shortcut_cells": _cells(diagnostic_shortcut),
+            "shortcut_matches": diagnostic_reference == diagnostic_shortcut,
+            "differing_cell_count": len(changed),
+            "differences": changed,
+        },
+        "finding": (
+            "The current sampler's aligned equal-length bars make full bounding-box-lane "
+            "painting indistinguishable from one-step plus-growth intersection. Offset or "
+            "unequal extents are needed to teach the canonical contact-cell rule."
+        ),
+        "limits": "Finite generated sample and one source-bound diagnostic; no source repair or universal hypothesis search.",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seed-count", type=int, default=16)
+    parser.add_argument("--samples-per-seed", type=int, default=4)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run_probe(seed_count=args.seed_count, samples_per_seed=args.samples_per_seed)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": report["status"],
+        "generated": report["generated"]["evaluated"],
+        "shortcut_matches": report["generated"]["shortcut_matches"],
+        "diagnostic_differences": report["diagnostic"]["differing_cell_count"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
