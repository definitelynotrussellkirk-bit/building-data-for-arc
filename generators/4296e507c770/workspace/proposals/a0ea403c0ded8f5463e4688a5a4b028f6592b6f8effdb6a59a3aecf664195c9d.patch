+"""Regression for the current generator's aligned-bounding-box shortcut."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+HOME = Path(__file__).resolve().parents[1]
+PROBE = HOME / "workspace" / "probe_bbox_lane_shortcut.py"
+
+
+def load_probe():
+    assert PROBE.is_file(), "missing reusable bounded shortcut probe"
+    spec = importlib.util.spec_from_file_location("probe_58785b2db07e_bbox_lane", PROBE)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_generated_aligned_bars_fit_bbox_lane_but_offset_bars_do_not():
+    probe = load_probe()
+    report = probe.run_probe(seed_count=4, samples_per_seed=4)
+    assert report["status"] == "verified_bbox_lane_shortcut"
+    assert report["racket"]["runtime"]["schema"] == "arc-protected-racket-runtime-v1"
+    assert report["racket"]["runtime"]["protected"] is True
+    assert report["racket"]["runtime"]["path_projection"] == "repo-relative-or-basename-v1"
+    assert report["racket"]["runtime"]["binary_path"] == "racket"
+    assert report["racket"]["runtime"]["bridge_path"] == "shared/runtime/arc_repl/racket_bridge.py"
+    assert report["racket"]["runtime"]["prelude_path"] == "shared/runtime/arc_repl/racket_prelude/arc-prelude.rkt"
+    assert report["generated"]["evaluated"] == 16
+    assert report["generated"]["shortcut_matches"] == 16
+    assert report["generated"]["orientations"] == {"horizontal": 8, "vertical": 8}
+    assert report["diagnostic"]["self_check_errors"] == []
+    assert report["diagnostic"]["shortcut_matches"] is False
+    assert report["diagnostic"]["reference_cells"] == [[2, 2], [3, 2]]
+    assert report["diagnostic"]["shortcut_cells"] == [[1, 2], [2, 2], [3, 2], [4, 2]]
+    assert report["diagnostic"]["differing_cell_count"] == 2
