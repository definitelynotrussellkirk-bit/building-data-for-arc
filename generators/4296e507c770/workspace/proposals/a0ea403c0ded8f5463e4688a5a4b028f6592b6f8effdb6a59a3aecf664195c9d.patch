+"""Regression for an undeclared tie-break precedence shortcut."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+HOME = Path(__file__).resolve().parents[1]
+PROBE = HOME / "workspace" / "probe_left_before_top.py"
+
+
+def load_probe():
+    assert PROBE.is_file(), "missing reusable tie-precedence probe"
+    spec = importlib.util.spec_from_file_location("probe_595eebab5aea_left_before_top", PROBE)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_five_demo_window_allows_left_before_top_but_query_separates():
+    report = load_probe().run_probe()
+    assert report["status"] == "verified_left_before_top_ambiguity"
+    assert report["lesson"] == {
+        "seed": 0,
+        "indices": [4, 5, 6, 7, 8, 9],
+        "demo_indices": [4, 5, 6, 7, 8],
+        "query_index": 9,
+    }
+    assert report["racket"]["runtime"]["schema"] == "arc-protected-racket-runtime-v1"
+    assert report["racket"]["runtime"]["protected"] is True
+    assert report["racket"]["runtime"]["path_projection"] == "repo-relative-or-basename-v1"
+    assert report["racket"]["runtime"]["binary_path"] == "racket"
+    assert report["racket"]["runtime"]["bridge_path"] == "shared/runtime/arc_repl/racket_bridge.py"
+    assert report["racket"]["runtime"]["prelude_path"] == "shared/runtime/arc_repl/racket_prelude/arc-prelude.rkt"
+    assert report["racket"]["executed_evaluations"] == 6
+    assert report["demonstrations"]["shortcut_matches"] == [True] * 5
+    assert report["query"]["shortcut_matches"] is False
+    assert report["query"]["differing_cell_count"] == 7
+    assert report["query"]["equal_area_order"] == {
+        "canonical_top_then_left": [[6, 4], [8, 1]],
+        "shortcut_left_then_top": [[8, 1], [6, 4]],
+    }
diff --git a/repo/generators/595eebab5aea/workspace/probe_left_before_top.py b/repo/generators/595eebab5aea/workspace/probe_left_before_top.py
