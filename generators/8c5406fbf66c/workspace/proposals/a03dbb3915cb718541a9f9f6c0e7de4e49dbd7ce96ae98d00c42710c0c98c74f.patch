+"""Focused repair tests for canonical singleton-row semantics."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root
+
+TASK = "89dfcff52ee8"
+ROOT = find_root(__file__)
+HOME = ROOT / "generators" / TASK
+
+
+def load_generator():
+    path = HOME / "generator.py"
+    name = "_test_89dfcff52ee8_generator"
+    sys.modules.pop(name, None)
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+
+
+def canonical_program():
+    sources = {
+        json.loads(line)["program_solution"]
+        for line in canonical_path(ROOT).read_text().splitlines()
+        if json.loads(line).get("task_id") == TASK
+    }
+    assert len(sources) == 1
+    return next(iter(sources))
+
+
+def canonical_pairs():
+    rows = [
+        json.loads(line)
+        for line in canonical_path(ROOT).read_text().splitlines()
+        if json.loads(line).get("task_id") == TASK
+    ]
+    assert rows
+    result = []
+    for row in rows:
+        result.extend(row["train"])
+        test = row["test"]
+        result.extend(test if isinstance(test, list) else [test])
+    return result
+
+
+
+
+import pytest
+
+
+@pytest.fixture
+def racket_bridge():
+    from arc_repl.racket_bridge import RacketBridge
+
+    bridge = RacketBridge()
+    try:
+        yield bridge
+    finally:
+        bridge.close()
+
+
+def test_canonical_singleton_rows_are_accepted_and_mirrored():
+    generator = load_generator()
+    singleton_pairs = []
+    for pair in canonical_pairs():
+        if any(sum(value != 0 for value in row) == 1 for row in pair["input"]):
+            singleton_pairs.append(pair)
+            assert generator.self_check(pair["input"]) == []
+            assert generator.rule_mirror(pair["input"]) == pair["output"]
+    assert singleton_pairs, "canonical task must retain a singleton-row witness"
+
+
+def test_singleton_mixed_profile_is_generated_and_racket_labeled(racket_bridge):
+    generator = load_generator()
+    grid = generator.generate(11, 7, row_profile="singleton_mixed")
+    active_counts = [sum(value != 0 for value in row) for row in grid if any(row)]
+    assert active_counts.count(1) == 1
+    assert any(count >= 2 for count in active_counts)
+    assert generator.self_check(grid) == []
+
+    expected = generator.rule_mirror(grid)
+    ignore_singletons = [[0 for _ in row] for row in grid]
+    for row_index, row in enumerate(grid):
+        columns = [column for column, value in enumerate(row) if value != 0]
+        if len(columns) >= 2:
+            for column in range(min(columns), max(columns) + 1):
+                ignore_singletons[row_index][column] = 8
+    assert ignore_singletons != expected
+
+    racket_bridge.define_grid("singleton_probe", grid)
+    actual = racket_bridge.eval_text(
+        f"({wrap_rule(canonical_program())} singleton_probe)"
+    )
+    assert actual == expected
+
+
+def test_self_check_rejects_bool_and_non_arc_cells():
+    generator = load_generator()
+    assert generator.self_check([[True], [True]], difficulty="easy")
+    assert generator.self_check([[10], [10]], difficulty="easy")
+    assert generator.self_check([[1.0], [1.0]], difficulty="easy")
