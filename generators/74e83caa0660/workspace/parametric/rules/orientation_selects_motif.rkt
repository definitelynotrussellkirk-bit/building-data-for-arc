(rule!
  (let ((dummy 0))
    (define (colors-reading grid)
      (remove-duplicates
       (filter (lambda (v) (not (= v 0)))
               (map (lambda (p) (at grid (first p) (second p)))
                    (grid-positions grid)))))
    (define (paint-x grid r0 c0 r1 c1 color)
      (for/fold ([out grid]) ([i (in-range (+ 1 (- r1 r0)))])
        (set-cell (set-cell out (+ r0 i) (+ c0 i) color)
                  (+ r0 i) (- c1 i) color)))
    (define (paint-plus grid r0 c0 r1 c1 color)
      (let ((middle-r (quotient (+ r0 r1) 2))
            (middle-c (quotient (+ c0 c1) 2)))
        (for/fold ([out grid]) ([i (in-range (+ 1 (- r1 r0)))])
          (set-cell (set-cell out middle-r (+ c0 i) color)
                    (+ r0 i) middle-c color))))
    (for/fold ([out (empty-grid (rows g) (cols g) 0)])
              ([color (in-list (colors-reading g))])
      (let ((cells (find-color g color)))
        (if (= (length cells) 2)
            (let* ((bb (bbox-of-cells cells))
                   (r0 (first bb))
                   (c0 (second bb))
                   (r1 (third bb))
                   (c1 (fourth bb))
                   (main? (= (at g r0 c0) color)))
              (if main?
                  (paint-x out r0 c0 r1 c1 color)
                  (paint-plus out r0 c0 r1 c1 color)))
            out)))))
