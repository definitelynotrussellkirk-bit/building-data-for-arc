+#!/usr/bin/env python3
+"""Read-only, hash-bound audits for the two immutable reviewer audit targets.
+
+Python census is diagnostic; small counterexamples and canonical pairs are
+independently executed in Racket and stored with full inputs and outputs.
+"""
+from __future__ import annotations
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from review_probe import locate_root, load_generator
+
+TARGETS = ("97e4de6b44f4", "0beba7b7e706")
+BANDS = ("easy", "medium", "hard")
+
+
+def dispatch_analysis(grid):
+    markers = [(r, c, v) for r, row in enumerate(grid) for c, v in enumerate(row) if v in (8, 9)]
+    cells = [(r, c) for r, row in enumerate(grid) for c, v in enumerate(row) if v not in (0, 8, 9)]
+    if len(markers) != 1 or not cells:
+        raise ValueError("Expected one marker and a nonempty shape")
+    r0, r1 = min(r for r, _ in cells), max(r for r, _ in cells)
+    c0, c1 = min(c for _, c in cells), max(c for _, c in cells)
+    shape = [row[c0:c1 + 1] for row in grid[r0:r1 + 1]]
+    cw = [list(row) for row in zip(*shape[::-1])]
+    flip = [row[::-1] for row in shape]
+    return {"marker": markers[0][2], "blob_size": len(cells), "shape": shape,
+            "nonrectangular": len(cells) != (r1 - r0 + 1) * (c1 - c0 + 1),
+            "clockwise": cw, "flipped": flip,
+            "output": cw if markers[0][2] == 8 else flip}
+
+
+def transform(mask, code):
+    if code == 2:
+        return [list(row) for row in zip(*mask[::-1])]
+    if code == 3:
+        return [row[::-1] for row in mask]
+    if code == 4:
+        return mask[::-1]
+    return [row[:] for row in mask]
+
+
+def stamp_analysis(grid):
+    h, w = len(grid), len(grid[0])
+    proto = [row[:3] for row in grid[:3]]
+    output, clamped = [[0] * w for _ in range(h)], [[0] * w for _ in range(h)]
+    markers, lost = [], 0
+    for r, row in enumerate(grid):
+        for c, code in enumerate(row):
+            if code not in (1, 2, 3, 4) or (r < 3 and c < 3):
+                continue
+            markers.append([r, c, code])
+            mask = transform(proto, code)
+            clamp_r, clamp_c = max(1, min(h - 2, r)), max(1, min(w - 2, c))
+            for dr, mask_row in enumerate(mask):
+                for dc, v in enumerate(mask_row):
+                    if v == 0:
+                        continue
+                    rr, cc = r - 1 + dr, c - 1 + dc
+                    if 0 <= rr < h and 0 <= cc < w:
+                        output[rr][cc] += 1
+                    else:
+                        lost += 1
+                    clamped[clamp_r - 1 + dr][clamp_c - 1 + dc] += 1
+    return {"output": output, "clamped_rival": clamped, "markers": markers,
+            "lost_foreground_cells": lost,
+            "edge_markers": sum(r in (0, h - 1) or c in (0, w - 1) for r, c, _ in markers)}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--baseline-census", type=Path, default=Path("../checks/census-before.json"))
+    args = parser.parse_args(argv)
+    root, canonical_path, _ = locate_root()
+    if not (root / "generators").is_dir():
+        parser.error("Audit target generation needs the full source checkout")
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+    canonical = {row["task_id"]: row for line in canonical_path.open() if (row := json.loads(line)).get("task_id") in TARGETS + ("d70726fd510f",)}
+    modules = {task: load_generator(root / "generators" / task / "generator.py") for task in TARGETS}
+    identities = {}
+    for task in TARGETS:
+        identities[task] = {"task_id": task,
+            "generator_sha256": hashlib.sha256((root / "generators" / task / "generator.py").read_bytes()).hexdigest(),
+            "rule_sha256": hashlib.sha256(canonical[task]["program_solution"].encode()).hexdigest()}
+    invocation = {"cwd": "packet_root", "argv": ["python3", "run_with_racket.py", "python3",
+        "generators/d70726fd510f/workspace/audit_probe.py", "--output-dir", str(args.output_dir),
+        "--baseline-census", str(args.baseline_census)]}
+    result = {"schema": "two-target-readonly-audit-v1", "identities": identities,
+              "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "command": invocation, "census_labels": "diagnostic independent Python, not oracle-scored census",
+              "summaries": {}, "counterexample_files": [], "oracle_cases": [], "errors": []}
+    pending = []
+    a = TARGETS[0]
+    counts = Counter()
+    ambiguous, contrasting = [], None
+    for band in BANDS:
+        for seed in range(10):
+            for index in range(20):
+                grid = modules[a].generate(seed, index, difficulty=band)
+                obs = dispatch_analysis(grid)
+                counts["draws"] += 1
+                counts["validator_rejects"] += bool(modules[a].self_check(grid))
+                counts["nonrectangular"] += obs["nonrectangular"]
+                counts["cw_equals_flip"] += obs["clockwise"] == obs["flipped"]
+                rec = {"seed": seed, "sample_index": index, "difficulty": band, "overrides": {},
+                       "input": grid, "analysis": obs}
+                if obs["clockwise"] == obs["flipped"] and not any(r["analysis"]["marker"] == obs["marker"] for r in ambiguous):
+                    ambiguous.append(rec)
+                if obs["marker"] == 9 and obs["clockwise"] != obs["flipped"] and contrasting is None:
+                    contrasting = rec
+    result["summaries"][a] = {"counts": dict(counts), "bands": BANDS, "seed_range": [0, 9], "sample_index_range": [0, 19]}
+    for number, rec in enumerate(ambiguous):
+        pending.append((a, f"nonrectangular_equal_transforms_{number}", rec, "clockwise"))
+    if contrasting:
+        pending.append((a, "marker_conditioning_required", contrasting, "clockwise"))
+    overrides = {"blob_size": 6}
+    grid = modules[a].generate(0, 0, difficulty="easy", **overrides)
+    obs = dispatch_analysis(grid)
+    counts["blob_size_override_mismatch"] = int(obs["blob_size"] != 6)
+    assert obs["blob_size"] != 6
+    pending.append((a, "ignored_blob_size_override", {"seed": 0, "sample_index": 0, "difficulty": "easy",
+                    "overrides": overrides, "input": grid, "analysis": obs,
+                    "comparison_same_seed_blob_size_2_is_identical": grid == modules[a].generate(0, 0, difficulty="easy", blob_size=2)}, "clockwise"))
+    b = TARGETS[1]
+    counts = Counter()
+    nonclip, clip = None, None
+    for band in BANDS:
+        for seed in range(10):
+            for index in range(10):
+                grid = modules[b].generate(seed, index, difficulty=band, texture="clip")
+                obs = stamp_analysis(grid)
+                counts["draws"] += 1
+                counts["validator_rejects"] += bool(modules[b].self_check(grid))
+                counts["no_foreground_clipped"] += obs["lost_foreground_cells"] == 0
+                counts["no_edge_marker"] += obs["edge_markers"] == 0
+                counts["clamped_rival_matches"] += obs["output"] == obs["clamped_rival"]
+                rec = {"seed": seed, "sample_index": index, "difficulty": band,
+                       "overrides": {"texture": "clip"}, "input": grid, "analysis": obs}
+                if nonclip is None and obs["edge_markers"] == 0 and obs["lost_foreground_cells"] == 0:
+                    nonclip = rec
+                if clip is None and obs["output"] != obs["clamped_rival"]:
+                    clip = rec
+    result["summaries"][b] = {"counts": dict(counts), "bands": BANDS, "seed_range": [0, 9], "sample_index_range": [0, 9], "overrides": {"texture": "clip"}}
+    assert nonclip is not None and clip is not None
+    pending.extend([(b, "clip_texture_without_clipping", nonclip, "clamped_rival"), (b, "real_clipping_contrast", clip, "clamped_rival")])
+    with RacketBridge(max_calls_before_restart=96) as bridge:
+        wrapped = {task: wrap_rule(row["program_solution"]) for task, row in canonical.items()}
+        def evaluate(task, grid):
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            return bridge.eval_text(f"({wrapped[task]} {literal})")
+        for task, name, rec, rival in pending:
+            record = {**identities[task], **rec, "finding": name, "command": invocation,
+                      "validator_issues": modules[task].self_check(rec["input"]),
+                      "domain": "Generated through the public API; input lies in documented nondegenerate domain. Override conformance is recorded separately.",
+                      "rival_name": "always_rotate_cw" if rival == "clockwise" else "clamp_stamp_center_instead_of_clipping",
+                      "rival_output": rec["analysis"][rival]}
+            record["actual_racket_output"] = evaluate(task, rec["input"])
+            record["python_matches_racket"] = record["actual_racket_output"] == rec["analysis"]["output"]
+            record["rival_matches_racket"] = record["actual_racket_output"] == record["rival_output"]
+            path = args.output_dir / f"{task}_{name}.json"
+            path.write_text(json.dumps(record, indent=2) + "\n")
+            result["counterexample_files"].append(str(path))
+            if not record["python_matches_racket"]:
+                result["errors"].append({"counterexample": str(path), "problem": "independent mirror mismatch"})
+        for task in TARGETS:
+            for split in ("train", "test"):
+                pairs = canonical[task].get(split, [])
+                if isinstance(pairs, dict):
+                    pairs = [pairs]
+                for index, pair in enumerate(pairs):
+                    got = evaluate(task, pair["input"])
+                    rec = {"task_id": task, "kind": "canonical", "split": split, "index": index,
+                           "input": pair["input"], "expected": pair["output"], "actual_racket_output": got,
+                           "passed": got == pair["output"]}
+                    result["oracle_cases"].append(rec)
+                    if not rec["passed"]:
+                        result["errors"].append(rec)
+        if args.baseline_census.exists():
+            before = json.loads(args.baseline_census.read_text())
+            lesson = before["lesson_counterexamples"][0]
+            verified = []
+            for pair in lesson["demos"] + [lesson["query"]]:
+                got = evaluate("d70726fd510f", pair["input"])
+                verified.append({**pair, "actual_racket_output": got, "passed": got == pair["output"]})
+            witness = {"source": before["source"], "command": invocation, "lesson": lesson,
+                       "oracle_verification": verified, "all_passed": all(r["passed"] for r in verified)}
+            (args.output_dir / "baseline_boolean_ambiguity_racket.json").write_text(json.dumps(witness, indent=2) + "\n")
+            if not witness["all_passed"]:
+                result["errors"].append({"problem": "baseline Boolean witness mirror mismatch"})
+    (args.output_dir / "summary.json").write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps({"summaries": result["summaries"], "counterexamples": len(pending),
+                      "canonical_oracle_cases": len(result["oracle_cases"]), "errors": result["errors"]}, indent=2))
+    return bool(result["errors"])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
