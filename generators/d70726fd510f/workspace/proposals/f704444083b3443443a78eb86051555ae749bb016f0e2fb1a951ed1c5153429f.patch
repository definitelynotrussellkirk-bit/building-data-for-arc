+#!/usr/bin/env python3
+"""Reproducible occupancy-XOR census and independent Racket parity probe.
+
+The Boolean lesson gate itself consumes visible pairs, not a reference program.
+Census labels are diagnostic Python calculations, explicitly distinct from the
+oracle command's actual Racket outputs. Neither command reads solve/ artifacts.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import types
+
+TASK = "d70726fd510f"
+BANDS = ("easy", "medium", "hard")
+PATTERNS = ("random", "blob", "stripes", "checker", "border", "diagonal", "scatter")
+
+
+def panel_states(grid):
+    if not isinstance(grid, list) or not grid or not all(isinstance(row, list) and row for row in grid):
+        raise ValueError("input must be a nonempty row-list grid")
+    w = len(grid[0])
+    if w < 3 or w % 2 != 1 or any(len(row) != w for row in grid):
+        raise ValueError("input must be rectangular with two equal panels")
+    if any(type(v) is not int or not 0 <= v <= 9 for row in grid for v in row):
+        raise ValueError("input cells must be integer ARC colors")
+    pw = w // 2
+    if any(row[pw] != 4 for row in grid) or any(v == 4 for row in grid for c, v in enumerate(row) if c != pw):
+        raise ValueError("input must have only the full middle color-4 separator")
+    return [2 * int(row[c] != 0) + int(row[pw + 1 + c] != 0) for row in grid for c in range(pw)]
+
+
+def boolean_output(grid, table):
+    pw = len(grid[0]) // 2
+    values = [2 * ((table >> state) & 1) for state in panel_states(grid)]
+    return [values[r * pw:(r + 1) * pw] for r in range(len(grid))]
+
+
+def assess_boolean_lesson(demos, query_grid):
+    """Exact version space of all 16 pointwise Boolean occupancy functions.
+
+    A missing branch is only a query-ambiguity failure if surviving functions
+    actually disagree on this query. This avoids rejecting a lawful restricted
+    subtask merely because its demonstrations do not exercise all four states.
+    """
+    constraints = []
+    seen = set()
+    for pair in demos:
+        grid, output = pair["input"], pair["output"]
+        states = panel_states(grid)
+        pw = len(grid[0]) // 2
+        if not isinstance(output, list) or len(output) != len(grid) or any(not isinstance(row, list) or len(row) != pw for row in output):
+            raise ValueError("label shape does not match the panel")
+        values = [v for row in output for v in row]
+        if any(type(v) is not int or v not in (0, 2) for v in values):
+            raise ValueError("Boolean occupancy labels must use only 0 and 2")
+        constraints.extend((s, v // 2) for s, v in zip(states, values))
+        seen.update(states)
+    tables = [table for table in range(16) if all(((table >> state) & 1) == label for state, label in constraints)]
+    query_states = panel_states(query_grid)
+    predictions = {tuple((table >> state) & 1 for state in query_states) for table in tables}
+    status = "inconsistent_labels" if not tables else ("query_determined" if len(predictions) == 1 else "ambiguous_query")
+    return {"status": status, "surviving_tables": tables,
+            "observed_states": sorted(seen), "query_states": sorted(set(query_states)),
+            "distinct_query_predictions": len(predictions)}
+
+
+def locate_root():
+    for root in Path(__file__).resolve().parents:
+        if (root / "shared/runtime/puzzle_generators/base.py").exists():
+            sys.path.insert(0, str(root / "shared/runtime"))
+            # The portable runtime maps shared/tools to scripts/. In a source
+            # checkout expose that same namespace without copying or changing
+            # upstream tooling. Do not shadow a real scripts package.
+            if "scripts" not in sys.modules and importlib.util.find_spec("scripts") is None:
+                scripts = types.ModuleType("scripts")
+                scripts.__path__ = [str(root / "shared/tools")]
+                scripts.__package__ = "scripts"
+                scripts.__spec__ = importlib.machinery.ModuleSpec("scripts", None, is_package=True)
+                sys.modules["scripts"] = scripts
+            return root, root / "shared/data/canonical/puzzles.jsonl", root / "generators" / TASK / "generator.py"
+        if (root / "puzzle_generators/base.py").exists():
+            sys.path.insert(0, str(root))
+            return root, root / "data/canonical/puzzles.jsonl", root / "puzzle_generators/per_puzzle" / TASK / "generator.py"
+    raise RuntimeError("Cannot find an independent source checkout or staged runtime")
+
+
+def load_generator(path):
+    spec = importlib.util.spec_from_file_location("review_probe_subject", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def source_identity(path, canonical):
+    return {
+        "task_id": TASK, "generator_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+        "canonical_rule_sha256": hashlib.sha256(canonical["program_solution"].encode()).hexdigest(),
+        "normalized_rule_hash": hashlib.sha256(" ".join(canonical["program_solution"].split()).encode()).hexdigest()[:12],
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+    }
+
+
+def census(module, seeds, samples):
+    result = {"label_source": "diagnostic Python Boolean table 6; see separate oracle report for Racket validation",
+              "seed_range": [0, seeds - 1], "sample_index_range": [0, samples - 1],
+              "lesson_layout": "nonoverlapping groups: three demonstrations then one query; incomplete final group excluded",
+              "bands": {}, "textures": {}, "failures": [], "lesson_counterexamples": []}
+    all_inputs, all_outputs = set(), set()
+    for band in BANDS:
+        counts, state_counts = Counter(), Counter()
+        inputs, outputs = set(), set()
+        for seed in range(seeds):
+            pairs = []
+            for index in range(samples):
+                try:
+                    grid = module.generate(seed, index, difficulty=band)
+                    label = boolean_output(grid, 6)
+                    present = set(panel_states(grid))
+                    counts["draws"] += 1
+                    counts["all_four_states"] += present == {0, 1, 2, 3}
+                    counts["validator_rejects"] += bool(module.self_check(grid))
+                    counts["left_minus_right_matches"] += 1 not in present
+                    counts["canonical_shape_and_palette"] += (len(grid), len(grid[0]), {v for row in grid for v in row}) == (5, 9, {0, 4, 5, 8})
+                    for state in present:
+                        state_counts[f"{state:02b}"] += 1
+                    inputs.add(digest(grid)); outputs.add(digest(label))
+                    pairs.append({"input": grid, "output": label})
+                except Exception as exc:
+                    result["failures"].append({"band": band, "seed": seed, "sample_index": index, "error": repr(exc)})
+                    pairs.append(None)
+            for offset in range(0, samples - 3, 4):
+                group = pairs[offset:offset + 4]
+                if any(pair is None for pair in group):
+                    continue
+                lesson = assess_boolean_lesson(group[:3], group[3]["input"])
+                counts["lessons"] += 1
+                counts[lesson["status"]] += 1
+                if lesson["status"] != "query_determined" and len(result["lesson_counterexamples"]) < 12:
+                    result["lesson_counterexamples"].append({"band": band, "seed": seed, "sample_indexes": list(range(offset, offset + 4)),
+                                                             "assessment": lesson, "demos": group[:3], "query": group[3]})
+        result["bands"][band] = {"counts": dict(counts), "state_coverage_draw_counts": dict(state_counts),
+                                  "unique_inputs": len(inputs), "unique_outputs": len(outputs)}
+        all_inputs.update(inputs); all_outputs.update(outputs)
+    result["default_totals"] = {key: sum(v["counts"].get(key, 0) for v in result["bands"].values())
+                                for key in sorted({k for v in result["bands"].values() for k in v["counts"]})}
+    result["default_totals"].update(unique_inputs=len(all_inputs), unique_outputs=len(all_outputs))
+    for pattern in PATTERNS:
+        counts = Counter()
+        for index in range(samples):
+            grid = module.generate(0, index, panel_pattern=pattern)
+            present = set(panel_states(grid))
+            counts["draws"] += 1
+            counts["all_four_states"] += present == {0, 1, 2, 3}
+            counts["left_minus_right_matches"] += 1 not in present
+            counts["validator_rejects"] += bool(module.self_check(grid))
+        result["textures"][pattern] = {"seed": 0, "difficulty": None, "sample_index_range": [0, samples - 1], "counts": dict(counts)}
+    return result
+
+
+def oracle_cases(module, canonical):
+    for split in ("train", "test"):
+        for index, pair in enumerate(canonical[split]):
+            yield {"kind": "canonical", "split": split, "index": index, "input": pair["input"], "expected": pair["output"]}
+    for band in BANDS:
+        for seed in range(5):
+            for index in range(12):
+                yield {"kind": "default", "difficulty": band, "seed": seed, "sample_index": index,
+                       "overrides": {}, "input": module.generate(seed, index, difficulty=band)}
+        for pattern in PATTERNS:
+            for index in range(2):
+                overrides = {"panel_pattern": pattern}
+                yield {"kind": "texture", "difficulty": band, "seed": 19, "sample_index": index,
+                       "overrides": overrides, "input": module.generate(19, index, difficulty=band, **overrides)}
+    for h, pw in ((1, 1), (1, 14), (18, 1), (18, 14), (5, 4)):
+        for target in sorted({0, 1, h * pw // 2, h * pw - 1, h * pw}):
+            overrides = {"grid_h": h, "panel_w": pw, "xor_target": target}
+            yield {"kind": "boundary", "seed": 23, "sample_index": 2, "overrides": overrides,
+                   "input": module.generate(23, 2, **overrides)}
+    for left in module.COLORS:
+        for right in module.COLORS:
+            overrides = {"left_color": left, "right_color": right}
+            yield {"kind": "palette", "seed": 23, "sample_index": 2, "overrides": overrides,
+                   "input": module.generate(23, 2, **overrides)}
+    for name in module.DEGENERATE_TEXTURES:
+        overrides = {"texture": name}
+        yield {"kind": "lawful_edge", "seed": 23, "sample_index": 2, "overrides": overrides,
+               "input": module.generate(23, 2, **overrides)}
+
+
+def oracle(module, canonical):
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+    wrapped = wrap_rule(canonical["program_solution"])
+    result = {"label_source": "actual canonical Racket execution", "cases": [], "failures": []}
+    counts = Counter()
+    with RacketBridge(max_calls_before_restart=96) as bridge:
+        for record in oracle_cases(module, canonical):
+            grid = record["input"]
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            try:
+                actual = bridge.eval_text(f"({wrapped} {literal})")
+                expected = record.get("expected", boolean_output(grid, 6))
+                record.update(actual_racket_output=actual, expected=expected,
+                              validator_issues=module.self_check(grid), passed=(actual == expected and not module.self_check(grid)))
+            except Exception as exc:
+                record.update(passed=False, error=repr(exc))
+            counts[record["kind"]] += 1
+            if not record["passed"]:
+                result["failures"].append(record)
+            result["cases"].append(record)
+    result.update(counts=dict(counts), checked=sum(counts.values()), passed=sum(r["passed"] for r in result["cases"]))
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("mode", choices=("census", "oracle"))
+    parser.add_argument("--generator", type=Path)
+    parser.add_argument("--seeds", type=int, default=8)
+    parser.add_argument("--samples", type=int, default=100)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.seeds <= 0 or args.samples < 4:
+        parser.error("--seeds must be positive and --samples at least four")
+    _, canonical_path, default_path = locate_root()
+    path = (args.generator or default_path).resolve()
+    canonical = next(row for line in canonical_path.open() if (row := json.loads(line)).get("task_id") == TASK)
+    module = load_generator(path)
+    result = census(module, args.seeds, args.samples) if args.mode == "census" else oracle(module, canonical)
+    result.update(schema="occupancy-xor-review-probe-v1", mode=args.mode, source=source_identity(path, canonical))
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"output": str(args.output), "source": result["source"],
+                      "totals": result.get("default_totals", {"checked": result.get("checked"), "passed": result.get("passed")}),
+                      "failures": len(result["failures"])}, indent=2))
+    return int(bool(result["failures"]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
