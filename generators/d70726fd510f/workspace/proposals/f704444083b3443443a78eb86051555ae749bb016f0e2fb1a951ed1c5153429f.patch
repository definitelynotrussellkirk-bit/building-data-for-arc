+#!/usr/bin/env python3
+"""Validate a return ZIP and apply its delta to an isolated immutable baseline.
+
+Requires the original assigned packet checkout and git. Does not mutate reviewed
+sources, execute returned programs, or open private solve labels. Also verifies
+losslessly compressed evidence without trusting an embedded restoration script.
+"""
+from __future__ import annotations
+import argparse
+import gzip
+import hashlib
+import io
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import zipfile
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('archive', type=Path)
+    args = parser.parse_args(argv)
+    root = next((p for p in Path(__file__).resolve().parents if
+                 (p/'ASSIGNMENT.json').is_file() and (p/'repo/src/arcpuzzles/review_full_return.py').is_file()), None)
+    if root is None:
+        parser.error('Run this task-local tool inside the original assigned packet')
+    sys.path.insert(0, str(root/'repo/src'))
+    from arcpuzzles.review_full_return import validate_full_return
+    manifest = json.loads((root/'PACKET-MANIFEST.json').read_text())
+    report = {'archive':str(args.archive), 'passed':False, 'commands':[]}
+    try:
+        with zipfile.ZipFile(args.archive) as archive:
+            validated = validate_full_return(archive, manifest)
+            if archive.testzip() is not None:
+                raise ValueError('ZIP CRC failure')
+            report.update(members=len(archive.infolist()),
+                          expanded_bytes=sum(i.file_size for i in archive.infolist()),
+                          archive_sha256=hashlib.sha256(args.archive.read_bytes()).hexdigest())
+            with tempfile.TemporaryDirectory(prefix='return-patch-', dir=root/'.review') as temporary:
+                stage = Path(temporary)
+                for name in validated['patch_paths']:
+                    source = root/'.review/baseline'/name
+                    if source.is_file():
+                        target = stage/name
+                        target.parent.mkdir(parents=True, exist_ok=True)
+                        shutil.copy2(source, target)
+                patch = stage/'source.patch'
+                patch.write_bytes(archive.read('patches/source.patch'))
+                for command in (['git','apply','--check','source.patch'], ['git','apply','source.patch']):
+                    result = subprocess.run(command, cwd=stage, text=True, capture_output=True, timeout=30)
+                    report['commands'].append({'argv':command,'cwd':str(stage), 'exit_code':result.returncode,
+                                               'stdout':result.stdout,'stderr':result.stderr})
+                    if result.returncode:
+                        raise ValueError('Delta does not apply cleanly to the immutable baseline')
+                mismatches = [name for name in validated['patch_paths'] if (stage/name).read_bytes() != (root/name).read_bytes()]
+                if mismatches:
+                    raise ValueError('Applied files differ from current reviewed source: '+repr(mismatches))
+                report['patched_paths'] = validated['patch_paths']
+            restored = 0
+            if 'checks/COMPRESSED_EVIDENCE.json' in archive.namelist():
+                mapping = json.loads(archive.read('checks/COMPRESSED_EVIDENCE.json'))
+                for obj in mapping['objects']:
+                    size = obj['uncompressed_bytes']
+                    if type(size) is not int or not 0 <= size <= 100*1024*1024:
+                        raise ValueError('Unexpected compressed evidence expansion budget')
+                    blob = archive.read(obj['compressed_path'])
+                    if hashlib.sha256(blob).hexdigest() != obj['compressed_sha256']:
+                        raise ValueError('Compressed evidence hash mismatch')
+                    with gzip.GzipFile(fileobj=io.BytesIO(blob)) as stream:
+                        raw = stream.read(size+1)
+                    if len(raw) != size or hashlib.sha256(raw).hexdigest() != obj['uncompressed_sha256']:
+                        raise ValueError('Restored evidence hash/size mismatch')
+                    restored += len(obj['original_paths'])
+                report['compressed_original_paths_verified'] = restored
+            report['passed'] = True
+    except (OSError, ValueError, KeyError, subprocess.SubprocessError, zipfile.BadZipFile) as exc:
+        report['error'] = str(exc)
+    print(json.dumps(report, indent=2))
+    return 0 if report['passed'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
