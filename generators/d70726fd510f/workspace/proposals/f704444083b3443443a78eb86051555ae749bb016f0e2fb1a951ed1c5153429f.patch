+#!/usr/bin/env python3
+"""Diagnose timeout-before-first-output without editing the repository harness."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+
+root = next(p for p in Path(__file__).resolve().parents if (p / "src/arcpuzzles/runtime.py").exists())
+sys.path.insert(0, str(root / "src"))
+from arcpuzzles.runtime import run_process
+
+rows = []
+with tempfile.TemporaryDirectory() as tmp:
+    for flags in ([], ["-S"]):
+        startup = []
+        for _ in range(3):
+            t = time.monotonic()
+            subprocess.run([sys.executable, *flags, "-c", "print('ready',flush=True)"], capture_output=True, check=True)
+            startup.append(time.monotonic() - t)
+        chunks = []
+        command = [sys.executable, *flags, "-c", "import time; print('RUN unfinished',flush=True); time.sleep(30)"]
+        outcome = run_process(command, Path(tmp), timeout=.2, on_output=chunks.append)
+        rows.append({"flags": flags, "startup_seconds": startup, "timeout_test": outcome, "chunks": chunks})
+result = {"scope": "diagnostic only, no harness or test changes", "rows": rows,
+          "runtime_sha256": hashlib.sha256((root / "src/arcpuzzles/runtime.py").read_bytes()).hexdigest(),
+          "test_sha256": hashlib.sha256((root / "tests/test_review_runtime.py").read_bytes()).hexdigest()}
+print(json.dumps(result, indent=2))
