(rule!
  (let* ()
    (define (solid-2x2-at? r0 c0)
      (and (>= r0 0) (< r0 (- h 1))
           (>= c0 0) (< c0 (- w 1))
           (= (at g r0 c0) 5)
           (= (at g (+ r0 1) c0) 5)
           (= (at g r0 (+ c0 1)) 5)
           (= (at g (+ r0 1) (+ c0 1)) 5)))
    (define (inside-solid-square? r c)
      (any? (lambda (p) (solid-2x2-at? (first p) (second p)))
            (list (list r c)
                  (list (- r 1) c)
                  (list r (- c 1))
                  (list (- r 1) (- c 1)))))
    (cellmap g (r c v)
      (if (and (= v 5) (inside-solid-square? r c)) 1 v))))