(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((reds (find-color g 2))
                  (grays (find-color g 5))
                  (r-rs (map first reds))
                  (r-cs (map second reds))
                  (top (min-list r-rs))
                  (bot (max-list r-rs))
                  (left (min-list r-cs))
                  (right (max-list r-cs))
                  (top-solid (for/and ((c (range left (+ right 1)))) (= (at g top c) 2)))
                  (vertical top-solid)
                  (center-r (/ (+ 0.0 top bot) 2.0))
                  (center-c (/ (+ 0.0 left right) 2.0))
                  (result (make-hash)))
             (for* ((r (range 0 h)) (c (range 0 w)))
                   (let ((v (at g r c))) (hash-set! result (list r c) (if (= v 5) 0 v))))
             (for ((gc grays))
               (let ((gr (first gc))
                     (gcc (second gc)))
                 (cond
                   (vertical (let ((new-r (if (< (+ 0.0 gr) center-r)
                                              (- (* 2 top) gr)
                                              (- (* 2 bot) gr))))
                               (when
                                 (and (>= new-r 0) (< new-r h))
                                 (hash-set! result (list new-r gcc) 5))))
                   (else (let ((new-c (if (< (+ 0.0 gcc) center-c)
                                          (- (* 2 left) gcc)
                                          (- (* 2 right) gcc))))
                           (when
                             (and (>= new-c 0) (< new-c w))
                             (hash-set! result (list gr new-c) 5)))))))
             (cellmap g (r c v) (hash-ref result (list r c) 0))))))