(rule!
 (let ((dirs4 (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1))))
   (define base
     (grid-from-fn
      4 (cols g)
      (lambda (r c)
        (if (!= (zero? (at g r c)) (zero? (at g (+ r 5) c))) 3 0))))
   (define (green-neighbors grid r c)
     (filter (lambda (d)
               (let ((rr (+ r (first d))) (cc (+ c (second d))))
                 (and (in-bounds? rr cc (rows grid) (cols grid))
                      (= (at grid rr cc) 3))))
             dirs4))
   (define (exact-pair-cell? grid r c)
     (let ((neighbors (green-neighbors grid r c)))
       (and (= (length neighbors) 1)
            (let* ((d (first neighbors))
                   (rr (+ r (first d)))
                   (cc (+ c (second d))))
              (= (length (green-neighbors grid rr cc)) 1)))))
   (define (exact-trimer-cell? grid r c)
     (let ((neighbors (green-neighbors grid r c)))
       (or
        (and (= (length neighbors) 2)
             (all? (lambda (d)
                     (= (length (green-neighbors grid
                                                 (+ r (first d))
                                                 (+ c (second d))))
                        1))
                   neighbors))
        (and (= (length neighbors) 1)
             (let* ((d (first neighbors))
                    (rr (+ r (first d)))
                    (cc (+ c (second d)))
                    (partner-neighbors (green-neighbors grid rr cc))
                    (others
                     (filter
                      (lambda (pd)
                        (let ((pr (+ rr (first pd))) (pc (+ cc (second pd))))
                          (or (!= pr r) (!= pc c))))
                      partner-neighbors)))
               (and (= (length partner-neighbors) 2)
                    (= (length others) 1)
                    (let* ((other (first others))
                           (orow (+ rr (first other)))
                           (ocol (+ cc (second other))))
                      (= (length (green-neighbors grid orow ocol)) 1))))))))
   (grid-from-fn
    (rows base) (cols base)
    (lambda (r c)
      (let ((v (at base r c)))
        (if (and (= v 3)
                 (or (exact-pair-cell? base r c)
                     (exact-trimer-cell? base r c)))
            8
            v))))))
