(rule! (lambda (g)
         (let ((n (rows g)))
           (build-grid (* 2 n)
                       (* 2 n)
                       (r c)
                       (let ((qr (quotient r n))
                             (qc (quotient c n))
                             (lr (remainder r n))
                             (lc (remainder c n)))
                         (cond
                           ((and (zero? qr) (zero? qc)) (at g (- n 1 lr) (- n 1 lc)))
                           ((zero? qr) (at g (- n 1 lr) lc))
                           ((zero? qc) (at g lr (- n 1 lc)))
                           (else (at g lr lc))))))))
