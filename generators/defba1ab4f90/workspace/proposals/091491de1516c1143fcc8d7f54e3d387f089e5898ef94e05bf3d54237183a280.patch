+"""Every scan-order teaching slot must separate row-first from column-first."""
+import importlib.util
+import json
+from pathlib import Path
+import pytest
+from reviewer_support import load_selected_generator, find_root
+from arcpuzzles.worker import lesson_check
+
+HOME=Path(__file__).resolve().parents[1]
+ORACLE=HOME/'counterexamples/review-42cefc0accf372cd-v0001/retained/checks/audit/0ab5dc1f5386/probe.py'
+spec=importlib.util.spec_from_file_location('independent_column_oracle',ORACLE)
+independent=importlib.util.module_from_spec(spec);spec.loader.exec_module(independent)
+
+
+def module():
+    return load_selected_generator('0ab5dc1f5386',root=find_root(__file__))[0]
+
+
+def test_retained_underidentified_lesson_is_rejected_by_actual_worker():
+    gen=module(); old=json.loads((HOME/'counterexamples/column-order-lesson.json').read_text())
+    episode=old['episode']
+    assert all(independent.solve(p['input'],columns_first=True)==p['output'] for p in episode['train'])
+    assert independent.solve(episode['test'][0]['input'],columns_first=True)!=episode['test'][0]['output']
+    verdict=lesson_check(gen,episode,{'demonstration_policy':{'automatic':False,'declared_minimum':4}})
+    assert verdict['status']=='diagnostic_unsupported'
+    assert any('column_first' in reason for reason in verdict['reasons'])
+    with pytest.raises(ValueError,match='Automatic lesson unsupported'):
+        lesson_check(gen,episode,{'demonstration_policy':{'automatic':True,'declared_minimum':4}})
+
+
+@pytest.mark.parametrize('band',[None,'easy','medium','hard'])
+def test_every_scan_order_case_decisively_separates_source_orders(band):
+    gen=module()
+    for seed in range(12):
+        for height,width in [(12,16),(18,22)]:
+            grid=gen.generate(seed,1,difficulty=band,texture='scan_order',grid_h=height,grid_w=width)
+            assert gen.self_check(grid)==[]
+            expected=independent.solve(grid)
+            rival=independent.solve(grid,columns_first=True)
+            assert expected!=rival,(seed,band,height,width)
+            assert gen.LESSON_COMPETITORS['column_first'](grid)==rival
+
+
+def test_fixed_four_demo_windows_reject_column_first_in_all_rotations():
