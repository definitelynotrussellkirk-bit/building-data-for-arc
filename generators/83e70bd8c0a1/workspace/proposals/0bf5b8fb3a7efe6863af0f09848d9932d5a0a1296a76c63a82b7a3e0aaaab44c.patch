+#!/usr/bin/env python3
+"""Source-pinned probe for advertised controls and self-check coverage.
+
+This is reviewer evidence, not a production repair. The owner must decide
+whether to implement the inert axes or narrow the public contract, and what
+frame/gap invariant the validator should enforce.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK_ID = "78eb45ff43c2"
+EXPECTED_SOURCE_SHA256 = "fdd6dac0f31b6a5bc2ec2514027eeb6402a33ae27b72ecf719229f56df61dde1"
+
+
+def _bytes(grid: list[list[int]]) -> bytes:
+    return (json.dumps(grid, separators=(",", ":"), ensure_ascii=False) + "\n").encode()
+
+
+def _sha_grid(grid: list[list[int]]) -> str:
+    return hashlib.sha256(_bytes(grid)).hexdigest()
+
+
+def build_report(*, seed: int = 17, sample_index: int = 3) -> dict:
+    root = find_root(__file__)
+    generator, source, digest = load_selected_generator(TASK_ID, root=root)
+    if digest != EXPECTED_SOURCE_SHA256:
+        raise ValueError(f"source drift: expected {EXPECTED_SOURCE_SHA256}, got {digest}")
+
+    base = generator.generate(seed, sample_index)
+    controls = {
+        "palette_kind": {"palette_kind": "fixed"},
+        "anchor_corner": {"anchor_corner": True},
+        "asymmetry_force": {"asymmetry_force": True},
+        "palette_size": {"palette_size": 1},
+    }
+    control_cases = {}
+    for name, override in controls.items():
+        grid = generator.generate(seed, sample_index, **override)
+        control_cases[name] = {
+            "override": override,
+            "same_as_base": grid == base,
+            "grid_sha256": _sha_grid(grid),
+        }
+
+    unknown = {"definitely_unknown": 123}
+    try:
+        unknown_grid = generator.generate(seed, sample_index, **unknown)
+        unknown_result = {
+            "accepted": True,
+            "same_as_base": unknown_grid == base,
+            "grid_sha256": _sha_grid(unknown_grid),
+        }
+    except Exception as exc:  # pragma: no cover - retained if owner tightens controls
+        unknown_result = {"accepted": False, "error": f"{type(exc).__name__}: {exc}"}
+
+    h = w = 10
+    malformed = {
+        "lone_gray_cell": [[5] + [0] * (w - 1)] + [[0] * w for _ in range(h - 1)],
+        "two_gray_cells": [[5, 5] + [0] * (w - 2)] + [[0] * w for _ in range(h - 1)],
+        "all_gray": [[5] * w for _ in range(h)],
+    }
+    malformed_acceptance = {
+        name: generator.self_check(grid) for name, grid in malformed.items()
+    }
+
+    inert = sorted(name for name, row in control_cases.items() if row["same_as_base"])
+    findings = []
+    if inert:
+        findings.append(
+            "Advertised controls are accepted but do not change the generated grid at the retained source."
+        )
+    if any(not errors for errors in malformed_acceptance.values()):
+        findings.append(
+            "self_check accepts grids that do not contain one rectangular frame with exactly one perimeter gap."
+        )
+    if unknown_result.get("accepted"):
+        findings.append("Unknown override names are accepted and ignored.")
+
+    return {
+        "schema": "arcpuzzles-frame-gap-control-probe-v1",
+        "task_id": TASK_ID,
+        "status": "finding" if findings else "no_finding",
+        "generator_path": source.relative_to(root).as_posix(),
+        "generator_sha256": digest,
+        "seed": seed,
+        "sample_index": sample_index,
+        "base_grid_sha256": _sha_grid(base),
+        "base_shape": [len(base), len(base[0])],
+        "base_self_check": generator.self_check(base),
+        "control_cases": control_cases,
+        "inert_controls": inert,
+        "unknown_control": unknown_result,
+        "malformed_acceptance": malformed_acceptance,
+        "malformed_grid_sha256": {
+            name: _sha_grid(grid) for name, grid in malformed.items()
+        },
+        "findings": findings,
+        "owner_decision": (
+            "Choose whether to implement or remove/narrow each advertised axis, reject unknown controls, "
+            "and define the exact rectangular-frame/one-gap validator before changing production semantics."
+        ),
+        "limits": (
+            "One source-pinned matched draw and three minimal validator counterexamples; "
+            "this does not audit canonical Racket labels or every generation seed."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=17)
+    parser.add_argument("--sample-index", type=int, default=3)
+    args = parser.parse_args()
+    if args.out.exists():
+        parser.error(f"output already exists: {args.out}")
+    report = build_report(seed=args.seed, sample_index=args.sample_index)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"],
+        "inert_controls": report["inert_controls"],
+        "malformed_acceptance": report["malformed_acceptance"],
+        "unknown_control": report["unknown_control"],
+    }, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
