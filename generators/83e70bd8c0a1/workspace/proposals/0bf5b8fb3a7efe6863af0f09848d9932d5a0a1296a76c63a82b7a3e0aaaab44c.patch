+#!/usr/bin/env python3
+"""Protected-Racket probe for a first-selected-row shortcut.
+
+The retained direction-scope prototype teaches union mode with anchored-row
+counts 1, 0, and 1, then asks a query with two anchored rows. A plausible rule
+that transforms only the first selected row but all selected columns therefore
+fits every visible demonstration and disagrees on the query.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import random
+
+from arc_repl.racket_bridge import RacketBridge
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK_ID = "832404dc8a5c"
+HERE = Path(__file__).resolve().parent
+PROTOTYPE_PATH = HERE / "parametric/prototype.py"
+EXPECTED_GENERATOR_SHA256 = "d1b17ce79331a3490635b917a3c3d1d349d0865e9f7f1657ef84897de48d8634"
+EXPECTED_PROTOTYPE_SHA256 = "7c8e7fc57246a3ea8d3e3ceb2adbc73fd80ed789165ec84c8960af602a915f84"
+
+RIVAL_PROGRAM = r"""(rule! (lambda (g)
+  (let ((h (rows g)) (w (cols g)))
+    (let ((first-selected-row
+           (find-first
+             (lambda (rr)
+               (and (= 4 (at g rr 0)) (= 4 (at g rr (- w 1)))))
+             (range 0 h))))
+      (grid-from-fn h w
+        (lambda (r c)
+          (let ((v (at g r c))
+                (row-selected? (and first-selected-row (= r first-selected-row)))
+                (column-selected? (and (= 4 (at g 0 c)) (= 4 (at g (- h 1) c)))))
+            (if (or row-selected? column-selected?)
+                (cond ((zero? v) 8)
+                      ((= v 8) 0)
+                      ((= v 6) 7)
+                      ((= v 7) 6)
+                      (else v))
+                v))))))))
+"""
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load_prototype():
+    if _sha(PROTOTYPE_PATH) != EXPECTED_PROTOTYPE_SHA256:
+        raise ValueError("prototype source drifted; review the shortcut against the new lesson")
+    spec = importlib.util.spec_from_file_location("direction_scope_probe_source", PROTOTYPE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("could not load direction-scope prototype")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _selected_row_count(grid: list[list[int]]) -> int:
+    return sum(row[0] == row[-1] == 4 for row in grid)
+
+
+def _difference_cells(left: list[list[int]], right: list[list[int]]) -> list[list[int]]:
+    return [
+        [r, c]
+        for r, row in enumerate(left)
+        for c, value in enumerate(row)
+        if value != right[r][c]
+    ]
+
+
+def build_report(*, seed: int = 17) -> dict:
+    if type(seed) is not int or seed < 0:
+        raise ValueError("seed must be a nonnegative integer")
+    root = find_root(__file__)
+    selected, source, generator_sha = load_selected_generator(TASK_ID, root=root)
+    if generator_sha != EXPECTED_GENERATOR_SHA256:
+        raise ValueError("selected generator source drifted")
+    prototype = _load_prototype()
+
+    input_rng = random.Random(f"{TASK_ID}:inputs:{seed}")
+    schedule = ((1, 0, "swapped"), (0, 2, "base"), (1, 1, "swapped"), (2, 1, "base"))
+    inputs = []
+    draws = []
+    for index, (row_count, column_count, palette) in enumerate(schedule):
+        overrides = {
+            "grid_h": input_rng.randint(6, 13),
+            "grid_w": input_rng.randint(8, 12),
+            "n_anchored_rows": row_count,
+            "n_anchored_cols": column_count,
+            "lane_palette": palette,
+        }
+        grid = selected.generate(seed, index, difficulty="hard", **overrides)
+        errors = selected.self_check(grid)
+        if errors:
+            raise ValueError(f"selected generator rejected retained lesson input {index}: {errors}")
+        inputs.append(grid)
+        draws.append({"sample_index": index, "overrides": overrides})
+
+    canonical_program = prototype.materialize_program("union")
+    with RacketBridge() as bridge:
+        canonical_outputs = [
+            prototype.execute_program(canonical_program, grid, bridge) for grid in inputs
+        ]
+        rival_outputs = [
+            prototype.execute_program(RIVAL_PROGRAM, grid, bridge) for grid in inputs
+        ]
+        runtime = bridge.runtime_identity
+
+    demo_matches = [
+        rival_outputs[index] == canonical_outputs[index] for index in range(3)
+    ]
+    query_differences = _difference_cells(canonical_outputs[3], rival_outputs[3])
+    if not all(demo_matches) or not query_differences:
+        raise AssertionError("retained lesson no longer exhibits the row-cap shortcut")
+
+    return {
+        "schema": "arcpuzzles-direction-scope-row-cap-probe-v1",
+        "task_id": TASK_ID,
+        "status": "finding",
+        "setting": "union",
+        "seed": seed,
+        "generator_path": source.relative_to(root).as_posix(),
+        "generator_sha256": generator_sha,
+        "prototype_path": PROTOTYPE_PATH.relative_to(root).as_posix(),
+        "prototype_sha256": _sha(PROTOTYPE_PATH),
+        "canonical_program": canonical_program,
+        "canonical_program_sha256": hashlib.sha256(canonical_program.encode()).hexdigest(),
+        "rival_name": "first_selected_row_plus_all_columns",
+        "rival_program": RIVAL_PROGRAM,
+        "rival_program_sha256": hashlib.sha256(RIVAL_PROGRAM.encode()).hexdigest(),
+        "demonstration_row_counts": [_selected_row_count(grid) for grid in inputs[:3]],
+        "query_row_count": _selected_row_count(inputs[3]),
+        "rival_matches_demonstrations": demo_matches,
+        "rival_matches_all_demonstrations": all(demo_matches),
+        "query_difference_cells": len(query_differences),
+        "query_first_differences": query_differences[:16],
+        "racket_evaluations": 8,
+        "racket": runtime,
+        "draws": draws,
+        "demonstrations": [
+            {
+                "input": inputs[index],
+                "output": canonical_outputs[index],
+                "rival_output": rival_outputs[index],
+            }
+            for index in range(3)
+        ],
+        "query": {
+            "input": inputs[3],
+            "output": canonical_outputs[3],
+            "rival_output": rival_outputs[3],
+        },
+        "repair_option": (
+            "Replace one visible union demonstration with a lawful case containing at least two anchored rows, "
+            "or add this rival to the lesson audit and constructively reject it without increasing the demo count."
+        ),
+        "limits": (
+            "One exact source-pinned seed and one plausible shortcut; this does not prove broader ambiguity "
+            "or prescribe a production repair."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=17)
+    args = parser.parse_args()
+    if args.out.exists():
+        parser.error(f"output already exists: {args.out}")
+    report = build_report(seed=args.seed)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"],
+        "demonstration_row_counts": report["demonstration_row_counts"],
+        "query_row_count": report["query_row_count"],
+        "rival_matches_all_demonstrations": report["rival_matches_all_demonstrations"],
+        "query_difference_cells": report["query_difference_cells"],
+        "racket_evaluations": report["racket_evaluations"],
+    }, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
