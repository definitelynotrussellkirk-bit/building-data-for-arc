+            report["minimal_cases"].append({"rival": name, "input": small,
+                "authority_output": answer, "alternative_output": other, "self_check_errors": errors,
+                "minimality": "6x6 and two seeds are the declared lower bounds; no pixel-deletion minimality claimed."})
+
+        report["metrics"] = {
+            "ordinary_draws": len(report["draws"]), "canonical_pairs": len(report["canonical"]),
+            "windows": 8, "four_demo_query_rotations": len(report["windows"]),
+            "canonical_rival_fit_counts": {name: sum(row["rival_outputs"][name] == row["output"] for row in report["canonical"]) for name in rivals},
+            "demo_fit_query_conflicts": {name: sum(name in row["query_conflicts"] for row in report["windows"]) for name in rivals},
+            "protected_original_lessons": len(report["confirmed_original_lessons"]),
+            "errors": len(report["errors"]),
+        }
+        report["outcome"] = "new_finite_rival_ambiguity" if findings else "no_finding_within_finite_scope"
+    except Exception as error:
+        report["errors"].append({"type": type(error).__name__, "message": str(error), "traceback": traceback.format_exc()})
+        report["outcome"] = "probe_error_not_rival_refutation"
+    finally:
+        if bridge is not None:
+            bridge.close()
+        write_json("learnability.json", report)
+    print(json.dumps({key: report.get(key) for key in ("outcome", "metrics", "source_hashes", "errors")}, sort_keys=True))
+    return 1 if report["errors"] else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
