+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def save(name, value):
+    path = OUT / name
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+    return {"path": str(path.relative_to(ROOT.parent)), "sha256": sha(path.read_bytes())}
+
+
+def cw(g):
+    return [list(r) for r in zip(*g[::-1])]
+
+
+def gallery(grid, rival=None):
+    # Independent finite Python check; authoritative labels come from Racket.
+    coords = [(r, c) for r in range(2, len(grid)) for c, v in enumerate(grid[r]) if v]
+    if not coords:
+        raise ValueError("No base motif; no rival credit for exceptions")
+    r0, r1 = min(r for r, _ in coords), max(r for r, _ in coords)
+    c0, c1 = min(c for _, c in coords), max(c for _, c in coords)
+    base = [row[c0:c1 + 1] for row in grid[r0:r1 + 1]]
+    pieces = []
+    for code in grid[0]:
+        if not code:
+            continue
+        if code == 1:
+            piece = cw(base)
+        elif code == 2:
+            piece = cw(cw(base))
+        elif code == 3:
+            piece = cw(cw(cw(base)))
+        elif code == 4:
+            piece = [row[::-1] for row in base]
+        elif code == 5:
+            piece = base[::-1]
+        elif code == 6 and rival == "code6_main_diagonal":
+            piece = cw(base[::-1])
+        elif code == 7 and rival == "code7_anti_diagonal":
+            piece = cw([row[::-1] for row in base])
+        else:
+            piece = copy.deepcopy(base)
+        pieces.append(piece)
+    if not pieces:
+        raise ValueError("No codes; no rival credit for exceptions")
+    result = [[0] * (sum(len(p[0]) for p in pieces) + len(pieces) - 1)
+              for _ in range(max(len(p) for p in pieces))]
+    left = 0
+    for p in pieces:
+        for r, row in enumerate(p):
+            result[r][left:left + len(row)] = row
+        left += len(p[0]) + 1
+    return result
+
+
+def main():
+    OUT.mkdir(parents=True, exist_ok=True)
+    gen, source, source_sha = load_selected_generator(TASK, root=ROOT)
+    catalog = Catalog(ROOT)
+    info = catalog.get(TASK)
+    programs = {v["program_solution"] for v in info["variants"]}
+    assert len(programs) == 1, "Ambiguous canonical program"
+    program = programs.pop()
+    point = "((= code 5) (flip-ud grid)) (else grid)"
+    assert program.count(point) == 1
+    replacements = {
+        "code6_main_diagonal": "((= code 5) (flip-ud grid)) ((= code 6) (rotate-cw (flip-ud grid))) (else grid)",
+        "code7_anti_diagonal": "((= code 5) (flip-ud grid)) ((= code 7) (rotate-cw (flip-lr grid))) (else grid)",
+    }
+    rival_programs = {name: program.replace(point, text) for name, text in replacements.items()}
+    declared = {name: sorted(getattr(gen, name, {})) for name in
+                ("SEMANTIC_RIVALS", "LESSON_COMPETITORS", "CANONICAL_SHORTCUTS")}
+    declared_n = getattr(gen, "EXAMPLES_NEEDED", None)
+    demos = declared_n if type(declared_n) is int and 1 <= declared_n <= 32 else 3
+    pairs = canonical_pairs(TASK, root=ROOT)
+    draws = [{"seed": seed, "sample_index": index, "difficulty": None,
+              "input": gen.generate(seed, index, difficulty=None)}
+             for seed in (0, 17) for index in range(8)]
+    scope = {
+        "task_id": TASK, "generator_sha256": source_sha,
+        "probe_sha256": sha(Path(__file__).read_bytes()),
+        "generator_source": str(source.relative_to(ROOT)),
+        "canonical_program": program, "canonical_program_text_sha256": sha(program.encode()),
+        "catalog_rule_hash": info["rule_hash"], "catalog_approved": info["approved"],
+        "train_safety": info["train_safety"], "approval_reasons": info.get("approval_reasons"),
+        "declared_rivals": declared, "examples_needed_declared": declared_n,
+        "demo_count": demos, "demo_count_source": "EXAMPLES_NEEDED" if declared_n == demos else "semantic_gate_default_3",
+        "ordinary_draws": 16, "seeds": [0, 17], "sample_indices": list(range(8)),
+        "difficulty": None, "overrides": {},
+        "assembly": "Consecutive same-seed windows of demo_count+1 draws; authoring probe only, not production-worker assembly.",
+        "rival_programs": {name: {"program": p, "program_text_sha256": sha(p.encode())}
+                           for name, p in rival_programs.items()},
+        "canonical_callable": wrap_rule(program),
+        "canonical_callable_text_sha256": sha(wrap_rule(program).encode()),
+        "rival_callables": {name: {"program": wrap_rule(p),
+                                   "program_text_sha256": sha(wrap_rule(p).encode())}
+                            for name, p in rival_programs.items()},
+        "limitations": ["Finite rival set and sixteen default-difficulty draws only.",
+                        "No qualification, approval, owner acceptance, training admission, or production lesson coverage asserted.",
+                        "A rival exception is inconclusive and never counted as refutation.",
+                        "Selected witness is smallest by total input area among observed conflicts, not globally minimal."],
+    }
+    save("peer-inputs.json", {"scope": scope, "canonical_pairs": pairs, "ordinary_draws": draws})
+    receipt = catalog.apply(TASK, [p["input"] for p in pairs] + [d["input"] for d in draws],
+                            reference="canonical", timeout=120)
+    save("peer-reference-apply.json", receipt)
+    assert receipt["generator_sha256"] == source_sha
+    assert receipt["rule_hash_matches_catalog"] is True
+    assert all(r["error"] is None for r in receipt["results"]), "Reference errors retained; audit inconclusive"
+    for pair, label in zip(pairs, receipt["results"][:len(pairs)], strict=True):
+        assert pair["output"] == label["output"], "Canonical example/reference mismatch retained"
+    for draw, label in zip(draws, receipt["results"][len(pairs):], strict=True):
+        draw["output"] = label["output"]
+    all_pairs = pairs + draws
+    for pair in all_pairs:
+        assert gallery(pair["input"]) == pair["output"], "Python/reference mismatch; audit inconclusive"
+        pair["rival_outputs"] = {name: gallery(pair["input"], name) for name in rival_programs}
+    windows = []
+    for seed in (0, 17):
+        seed_draws = [d for d in draws if d["seed"] == seed]
+        for start in range(max(0, 8 - demos)):
+            lesson = seed_draws[start:start + demos + 1]
+            by_rival = {}
+            for name in rival_programs:
+                fit = all(p["rival_outputs"][name] == p["output"] for p in lesson[:-1])
+                differing_query = lesson[-1]["rival_outputs"][name] != lesson[-1]["output"]
+                by_rival[name] = {"fits_every_demo": fit, "query_disagrees": differing_query,
