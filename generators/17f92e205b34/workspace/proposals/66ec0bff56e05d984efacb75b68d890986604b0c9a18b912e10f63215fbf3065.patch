+                 and sha(row["program_solution"].encode()).startswith(module.RULE_HASH)}
+        assert len(rules) == 1, "Selected rule must have one exact program identity"
+        rule = rules.pop()
+        report["source_hashes"] = {
+            "generator": source_hash, "authority_program": sha(rule.encode()),
+            "probe": sha(Path(__file__).read_bytes()),
+            "reviewer_support": sha((ROOT / "shared/runtime/reviewer_support.py").read_bytes()),
+            "racket_bridge": sha((ROOT / "shared/runtime/arc_repl/racket_bridge.py").read_bytes()),
+            "review_index": sha((source.parent / "evidence/review_index.json").read_bytes()),
+        }
+        report["source_paths"] = {"generator": source.relative_to(ROOT).as_posix(),
+                                  "probe": Path(__file__).relative_to(ROOT).as_posix()}
+        report["programs"] = {"authority": rule}
+        added = ("ignore_corner_seeds", "xor_overlaps")
+        report["programs"].update({name: rival_program(name) for name in added})
+        report["program_sha256"] = {name: sha(program.encode())
+                                    for name, program in report["programs"].items()}
+        report["rival_descriptions"] = {
+            "ignore_corner_seeds": "Paint clipped cyan X unions for every nonzero seed except a corner seed, whose stencil would retain only two cells.",
+            "xor_overlaps": "Paint cyan where an odd number of nonzero seed X stencils cover a cell, cancelling even overlaps.",
+        }
+        index = json.loads((source.parent / "evidence/review_index.json").read_text())
+        report["inherited_holds_preserved"] = [
+            {key: row.get(key) for key in ("return_id", "source_sha256", "resolution", "triage", "verification_status")}
+            for row in index.get("audits", [])]
+        report["examples_needed"] = module.EXAMPLES_NEEDED
