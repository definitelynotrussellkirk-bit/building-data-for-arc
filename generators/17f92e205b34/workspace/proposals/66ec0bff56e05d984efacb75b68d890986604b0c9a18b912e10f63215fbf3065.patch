+            {"command": "rg read including ../reviewer_support*", "cwd": "WORK/repo", "exit_code": 2,
+             "output": "rg: ../reviewer_support*: No such file or directory (os error 2)",
+             "resolution": "Located shared/runtime/reviewer_support.py using rg --files; read it successfully."}],
+        "errors": [], "draws": [], "canonical": [], "windows": [],
+        "minimal_cases": [], "confirmed_original_lessons": [],
+    }
+    bridge = None
+    try:
