+consecutive windows exercise each held-out slot; this is an illustrative local
+assembly, not a claim about production lessons. Errors are never refutations.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+import traceback
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
