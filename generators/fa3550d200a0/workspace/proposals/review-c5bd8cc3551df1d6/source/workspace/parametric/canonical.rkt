(rule! (lambda (g)
         (let* ((rc (mode g 0))
                (bb (bbox-of-cells (find-color g rc)))
                (r1 (first bb))
                (c1 (second bb))
                (r2 (third bb))
                (c2 (fourth bb))
                (oh (+ 1 (- r2 r1)))
                (ow (+ 1 (- c2 c1)))
                (all-pos (grid-positions g))
                (canvas (subgrid g r1 c1 r2 c2))
                (objs (objects-multicolor g))
                (outside-objs (filter (lambda (obj)
                                        (for/or ((cell (obj-cells obj)))
                                                (let ((r (fst cell))
                                                      (c (snd cell)))
                                                  (or
                                                    (< r r1)
                                                    (> r r2)
                                                    (< c c1)
                                                    (> c c2)))))
                                      objs)))
           (reduce (lambda (can obj)
                     (let* ((cells (obj-cells obj))
                            (special-cell (find (lambda (cell)
                                                  (let ((v (at g (fst cell) (snd cell))))
                                                    (and (!= v 2) (!= v 0) (!= v rc))))
                                                cells)))
                       (if special-cell
                           (let* ((sc (at g (fst special-cell) (snd special-cell)))
                                  (sr (fst special-cell))
                                  (scc2 (snd special-cell))
                                  (im (find (lambda (p)
                                              (and
                                                (= sc (at g (fst p) (snd p)))
                                                (>= (fst p) r1)
                                                (<= (fst p) r2)
                                                (>= (snd p) c1)
                                                (<= (snd p) c2)))
                                            all-pos)))
                             (if im
                                 (let ((mr (- (fst im) r1))
                                       (mc (- (snd im) c1)))
                                   (reduce (lambda (c2 cell)
                                             (let ((nr (+ mr (- (fst cell) sr)))
                                                   (nc (+ mc (- (snd cell) scc2))))
                                               (if (and
                                                     (>= nr 0)
                                                     (< nr oh)
                                                     (>= nc 0)
                                                     (< nc ow))
                                                   (set-cell c2
                                                             nr
                                                             nc
                                                             (at g
                                                                 (fst cell)
                                                                 (snd cell)))
                                                   c2)))
                                           can
                                           cells))
                                 can))
                           can)))
                   canvas
                   outside-objs))))