    {
      "name": "column_count",
      "description": "Count every blue cell in each column and draw that many blue cells against the bottom edge.",
      "program": "(rule!\n ;; Per-column HISTOGRAM: count the blue(1) cells in each column and redraw\n ;; them as a bottom-aligned bar of that height.\n (grid-from-fn h w (lambda (r c)\n   (let ((cnt (count-where (lambda (rr) (= (at g rr c) 1)) (range h))))\n     (if (>= r (- h cnt)) 1 0)))))"
    },
    {
      "name": "column_count_capped_at_two",
      "description": "Count blue cells in each column, cap the count at two, and draw a bottom-aligned bar of that height.",
      "program": "(rule!\n ;; Per-column HISTOGRAM: count the blue(1) cells in each column and redraw\n ;; them as a bottom-aligned bar of that height.\n (grid-from-fn h w (lambda (r c)\n   (let ((cnt (count-where (lambda (rr) (= (at g rr c) 1)) (range h))))\n     (if (>= r (- h (min 2 cnt))) 1 0)))))"
    }
