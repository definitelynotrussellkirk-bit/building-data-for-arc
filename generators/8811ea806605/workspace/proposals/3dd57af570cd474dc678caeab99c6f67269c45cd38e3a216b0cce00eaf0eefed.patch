+"""Regress the Racket-confirmed marker-anchor teaching gap."""
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+
+PATH = Path(__file__).resolve().parents[1] / "generator.py"
+SPEC = importlib.util.spec_from_file_location("marker_anchor_review_generator", PATH)
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
+
+
+def pair(index, difficulty):
+    grid = GEN.generate(0, index, difficulty=difficulty)
+    return {"input": grid, "output": GEN.rule_mirror(grid)}
+
+
+@pytest.mark.parametrize("difficulty", ["easy", "medium", "hard", None])
+def test_block_boundary_rejects_marker_corner_shortcut(difficulty):
+    demos = [pair(index, difficulty) for index in (1, 2, 3)]
+    query = pair(4, difficulty)
+    reasons = GEN.lesson_identifiable(demos, query)
+    assert any("marker_as_" in reason for reason in reasons)
+
+
+@pytest.mark.parametrize("difficulty", ["easy", "medium", "hard", None])
+def test_equivalent_marker_corner_shortcut_does_not_reject_query(difficulty):
+    demos = [pair(index, difficulty) for index in (0, 1, 2)]
+    assert GEN.lesson_identifiable(demos, pair(3, difficulty)) == []
