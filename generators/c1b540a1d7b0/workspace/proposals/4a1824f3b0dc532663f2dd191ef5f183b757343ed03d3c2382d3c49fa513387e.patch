@@ -0,0 +1,139 @@
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+from arcpuzzles.catalog import Catalog
+from reviewer_support import find_root, public_challenge_bytes
+
+TASK_ID = "c1b540a1d7b0"
+ROOT = find_root(__file__)
+PARAMETRIC = ROOT / "generators" / TASK_ID / "workspace" / "parametric"
+
+
+def _load(name: str):
+    path = PARAMETRIC / f"{name}.py"
+    spec = importlib.util.spec_from_file_location(f"_{TASK_ID}_{name}_test", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical() -> str:
+    catalog = Catalog(ROOT)
+    row = catalog.describe(TASK_ID)
+    programs = {
+        item["program_solution"]
+        for item in catalog._variants()[row.get("rule_task_id", TASK_ID)]
+        if isinstance(item.get("program_solution"), str)
+    }
+    assert len(programs) == 1
+    return next(iter(programs))
+
+
+def _settings(value: str) -> dict[str, str]:
+    return {"finish_rule": value}
+
+
+def test_default_is_exact_canonical_and_alternative_is_distinct() -> None:
+    p = _load("prototype")
+    assert p.program(_settings("classify_only")) == _canonical()
+    assert (PARAMETRIC / "canonical.rkt").read_text() == _canonical()
+    assert p.program(_settings("classify_then_highlight_armiest")) != _canonical()
+
+
+def test_all_counts_are_supported_matched_distinct_and_prefix_stable() -> None:
+    p = _load("prototype")
+    for demos in range(2, 7):
+        for queries in range(1, 5):
+            a = p.generate(1000 + demos * 10 + queries, _settings("classify_only"), demos, queries)
+            b = p.generate(1000 + demos * 10 + queries, _settings("classify_then_highlight_armiest"), demos, queries)
+            assert len(a["train"]) == len(b["train"]) == demos
+            assert len(a["test"]) == len(b["test"]) == queries
+            assert [x["input"] for x in a["train"] + a["test"]] == [x["input"] for x in b["train"] + b["test"]]
+            assert len({json.dumps(x["input"]) for x in a["train"] + a["test"]}) == demos + queries
+            assert p.teaching_check(a)["ok"] is True
+            assert p.teaching_check(b)["ok"] is True
+    full = p.generate(77, _settings("classify_then_highlight_armiest"), 6, 4)
+    short = p.generate(77, _settings("classify_then_highlight_armiest"), 2, 1)
+    assert short["train"] == full["train"][:2]
+    assert short["test"] == full["test"][:1]
+
+
+def test_python_labels_and_causal_intermediate_are_real() -> None:
+    p = _load("prototype")
+    for seed in (0, 17, 91):
+        plain = p.generate(seed, _settings("classify_only"), 2, 4)
+        composed = p.generate(seed, _settings("classify_then_highlight_armiest"), 2, 4)
+        for a, b in zip(plain["train"] + plain["test"], composed["train"] + composed["test"]):
+            assert a["input"] == b["input"]
+            stage = p.classify(a["input"])
+            assert a["output"] == stage
+            assert b["output"] == p.finish_python(a["input"], _settings("classify_then_highlight_armiest"))
+            facts = p.analyze_input(a["input"])
+            assert facts["red_counts"][0] != facts["red_counts"][1]
+            assert b["output"] != a["output"]
+
+
+def test_minimum_lesson_refutes_size_cyan_and_raw_tip_shortcuts() -> None:
+    p = _load("prototype")
+    for seed in (0, 17, 91):
+        episode = p.generate(seed, _settings("classify_then_highlight_armiest"), 2, 4)
+        facts = [p.analyze_input(pair["input"]) for pair in episode["train"]]
+        assert any(row["armiest_index"] != row["largest_total_index"] for row in facts)
+        assert any(row["armiest_index"] != row["smallest_total_index"] for row in facts)
+        assert any(row["armiest_index"] != row["largest_cyan_index"] for row in facts)
+        assert any(row["armiest_index"] != row["most_raw_tips_index"] for row in facts)
+        for selector in ("largest_total", "smallest_total", "largest_cyan"):
+            assert any(
+                pair["output"] != p.highlight_by(p.classify(pair["input"]), selector)
+                for pair in episode["train"]
+            )
+
+
+def test_fourth_query_is_substantive_30x30_touching_every_boundary() -> None:
+    p = _load("prototype")
+    episode = p.generate(0, _settings("classify_then_highlight_armiest"), 3, 4)
+    grid = episode["test"][3]["input"]
+    out = episode["test"][3]["output"]
+    assert (len(grid), len(grid[0])) == (30, 30)
+    assert any(v == 5 for v in grid[0])
+    assert any(v == 5 for v in grid[-1])
+    assert any(row[0] == 5 for row in grid)
+    assert any(row[-1] == 5 for row in grid)
+    assert sum(v == 5 for row in grid for v in row) >= 30
+    assert sum(v == 4 for row in out for v in row) >= 4
+
+
+def test_public_turn_hides_private_state_and_future_queries() -> None:
+    p = _load("prototype")
+    episode = p.generate(314, _settings("classify_then_highlight_armiest"), 3, 4)
+    first = p.public_turn(episode, 0)
+    last = p.public_turn(episode, 3)
+    assert first["train"] == last["train"] == episode["train"]
+    assert first["test"] == [{"input": episode["test"][0]["input"]}]
+    assert last["test"] == [{"input": episode["test"][3]["input"]}]
+    payload = public_challenge_bytes(first)
+    for secret in (b"finish_rule", b"classify_only", b"highlight_armiest", b"settings", b"program_solution", b"metadata"):
+        assert secret not in payload
+
+
+def test_generation_is_fresh_and_typed_requests_are_strict() -> None:
+    p = _load("prototype")
+    a = p.generate(4, _settings("classify_only"), 2, 4)
+    b = p.generate(4, _settings("classify_only"), 2, 4)
