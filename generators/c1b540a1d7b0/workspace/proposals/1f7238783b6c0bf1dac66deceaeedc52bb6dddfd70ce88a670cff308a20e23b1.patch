+"""Behavioral regressions for the task-local residual-room family."""
+from __future__ import annotations
+import importlib.util
+from pathlib import Path
+import pytest
+from reviewer_support import find_root
+
+HOME = Path(__file__).resolve().parents[1]
+
+def load():
+    path = HOME / 'workspace/parametric/adapter.py'
+    assert path.is_file(), 'native residual-room adapter is not implemented'
+    spec = importlib.util.spec_from_file_location('residual_room_adapter', path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+@pytest.fixture(scope='module')
+def a():
+    return load()
+
+def fixture():
+    # Four-cell room + a three-cell dangling arm; six-cell room loses
+    # both exterior columns to two one-cell tips, leaving a two-cell room.
+    grid = [[0] * 12 for _ in range(7)]
+    for r,c in [(1,1),(1,2),(2,1),(2,2),(3,1),(4,1),(5,1),
+                (0,7),(0,9),(1,7),(1,8),(1,9),(2,7),(2,8),(2,9)]:
+        grid[r][c] = 5
+    expected = [row[:] for row in grid]
+    for r,row in enumerate(expected):
+        for c,v in enumerate(row):
+            if v == 5:
+                row[c] = (3 if (r,c) in {(1,1),(1,2),(2,1),(2,2)} else
+                          8 if c == 8 else 2)
+    return grid, expected
+
+def test_native_adapter_is_present():
+    load()
+
+def test_rank_is_measured_after_arm_removal(a):
+    grid, expected = fixture()
+    assert a.transform(grid, 'largest_room') == expected
+    assert a.transform(grid, 'pre_arm_largest') != expected
+    assert grid[1][1] == 5  # The transformer cannot mutate its input.
+
+def test_exact_canonical_preserved(a):
+    from arcpuzzles import Catalog
+    selected = Catalog(find_root(__file__)).get('c1b540a1d7b0')
+    programs = {v['program_solution'] for v in selected['variants']}
+    assert programs == {a.program({'room_policy':'all_rooms'})}
+
+def test_independent_count_prefix_and_matching_settings(a):
+    full = a.generate(17, {'room_policy':'largest_room'}, 6, 4)
+    assert len({str(p['input']) for p in full['train'] + full['test']}) == 10
+    for demos in range(2,7):
+        for queries in range(1,5):
+            ep = a.generate(17, {'room_policy':'largest_room'}, demos, queries)
+            other = a.generate(17, {'room_policy':'all_rooms'}, demos, queries)
+            assert ep['train'] == full['train'][:demos]
+            assert ep['test'] == full['test'][:queries]
+            assert [p['input'] for p in ep['train']+ep['test']] == [p['input'] for p in other['train']+other['test']]
+            assert a.public_turn(ep, 0) == a.public_turn(a.generate(17, {'room_policy':'largest_room'}, demos, 1),0)
+            for index in range(queries):
+                view = a.public_turn(ep,index)
+                assert set(view) == {'train','test'}
+                assert view['test'] == [{'input':ep['test'][index]['input']}]
+                assert all(set(p) == {'input','output'} for p in view['train'])
+    # A consumer mutation must not corrupt cached inputs or later draws.
+    full['test'][0]['input'][0][0] = 9
+    assert a.generate(17, {'room_policy':'largest_room'},6,4)['test'][0]['input'][0][0] != 9
+
+@pytest.mark.parametrize('d,q', [(1,4),(7,4),(2,0),(2,5),(True,4),(2,True),(2.0,4)])
+def test_invalid_count_requests_rejected(a,d,q):
+    with pytest.raises(ValueError):
+        a.generate(0, {'room_policy':'largest_room'},d,q)
+
+@pytest.mark.parametrize('settings', [{}, {'room_policy':'unknown'}, {'room_policy':True}, {'room_policy':'all_rooms','extra':1}, None])
+def test_invalid_settings_rejected(a,settings):
+    with pytest.raises(ValueError):
+        a.program(settings)
+
+def test_public_query_index_validation(a):
+    ep = a.generate(0,{'room_policy':'all_rooms'},2,4)
+    for index in (-1,4,True,1.5):
+        with pytest.raises(ValueError): a.public_turn(ep,index)
+
+def test_teaching_and_substantive_stress(a):
+    for seed in (0,1,17,41):
+        ep = a.generate(seed, {'room_policy':'largest_room'},2,4)
+        for rival in a.RIVALS:
+            assert any(a.transform(p['input'],rival) != p['output'] for p in ep['train']), (seed,rival)
+        grid = ep['test'][3]['input']
+        stats = a.describe(grid)
+        assert stats['shape'] == [30,30]
+        assert stats['gray_cells'] >= 150
+        assert min(stats['span']) >= 26
+        assert min(stats['quadrants']) >= 15
+        assert len(stats['residual_sizes']) >= 20
+        assert stats['residual_sizes'].count(max(stats['residual_sizes'])) == 1
+
+def test_programs_execute_with_independent_predictions(a):
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+    with RacketBridge() as bridge:
+        assert bridge.runtime_identity['protected'] is True
+        grid, expected = fixture()
+        for policy in a.SETTINGS + a.RIVALS:
+            src = a.rule_for(policy)
+            literal = "'(" + ' '.join('('+' '.join(map(str,row))+')' for row in grid) + ')'
+            actual = bridge.eval_text(f'({wrap_rule(src)} {literal})')
+            assert actual == a.transform(grid,policy), policy
+        assert a.transform(grid, 'largest_room') == expected
+
+def test_reusable_audit_checks_real_outputs(tmp_path):
+    import json
+    import subprocess
+    import sys
+    script = HOME / 'workspace/parametric/audit.py'
+    result = subprocess.run([sys.executable,str(script),'--seeds','1','--racket-seeds','0',
+                             '--out',str(tmp_path/'audit')],capture_output=True,text=True)
+    assert result.returncode == 0, result.stdout + result.stderr
+    report = json.loads((tmp_path/'audit/report.json').read_text())
+    assert report['status'] == 'passed'
+    assert report['requests'] == 40
+    assert report['matched_inputs'] == 20
+    assert report['public_turns'] == 100
+    assert report['racket']['backend'] == 'racket'
+    assert report['racket']['protected'] is True
+    assert report['racket_evaluations'] > 0
+    assert report['rival_survivors'] == []
+
+def test_seed7_stress_construction_does_not_exhaust(a):
+    ep = a.generate(7, {'room_policy':'largest_room'}, 2, 4)
+    info = a.describe(ep['test'][3]['input'])
+    assert info['shape'] == [30,30]
+    assert info['gray_cells'] >= 150
+    assert min(info['span']) >= 26
+    assert min(info['quadrants']) >= 15
+    assert info['residual_sizes'].count(max(info['residual_sizes'])) == 1
