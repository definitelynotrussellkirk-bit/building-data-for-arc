@@ -0,0 +1,59 @@
+# Transfer the inferred D4 pose
+
+`response_policy=label_query` preserves the exact selected canonical program.
+`response_policy=transfer_pose` uses its matching label to recover the selected
+prototype, infers the unique rotation/reflection that maps that prototype to
+the query, then applies that same map to the **other** prototype. Render the
+transformed other shape at the query bounding-box origin, in the other
+prototype's label color, on the same output canvas as the canonical query panel.
+The rule is fixed within an episode; no parameter is supplied in public inputs.
+
+Every shape is newly grown as a connected polyomino around a random full-span
+cross. Both prototypes have the same occupied area and ordered bounding-box
+dimensions, but belong to different D4 orbits. Both have eight distinct D4 poses,
+so transformation transfer is unambiguous. The first two demos use opposite
+match sides, a quarter-turn, and a reflection. No extra demo is required to
+reject fixed-pose, inverse-pose, matched-color, recolor-only or first-prototype
+rules. Labels, geometry and placements vary by seed. This is a finite authored
+rival check, not a claim that no other program could fit the demonstrations.
+
+## Size and sequential-query contract
+Counts are independent: 2-6 demonstration prefixes, and 1-4 query prefixes from
+four private queries. Six demos/four queries are constructed from seed-only
+streams, so requesting a shorter prefix or changing settings cannot alter the
+first query or preceding demonstrations. `public_turn(episode,index)` exposes
+only demonstrations and one current query input. Do not give a model the full
+controller-side four-query file at its first turn.
+
+The input width is **3*panel_width+2**. The maximum legal equal-panel width below
+31 is 29, not 30. The substantive stress query is **30x29**, containing three
+27x9 asymmetric shapes of 145 cells each, plus full-height separators. This
+is not a padded small puzzle. Quarter-turns of these tall shapes do not fit a
+nine-column panel, so the stress query uses dimension-preserving transformations;
+all eight D4 operations occur on the smaller valid geometries and are executed
+through protected Racket. The minimum query is 5x14. Neither production sampler
+nor canonical program is modified or widened.
+
+## Reusable bounded audit
+From the outer packet directory:
+
+```sh
+python3 review.py run python3 generators/1ecf6add3fe7/workspace/parametric/audit.py --seeds 20 --racket-seeds 0 17 2 --out ../checks/1ecf6add3fe7/audit-new
+python3 review.py task-tests 1ecf6add3fe7 --phase after --out ../checks/1ecf6add3fe7/tests-new
+```
+
+Use a fresh output directory. `audit.py` is a self-contained copy of the
+contract-driven harness built during the first task, not an import from that
+task or another checkout. It checks count boundaries, input equality between
+settings, query-prefix identity, private/future-field noninterference, and
+public-byte-hashed exports. It independently executes every declared Racket
+hypothesis; a failed executable rival cannot count as elimination. Wrong fixed
+poses that do not fit are explicitly clipped, like the Racket paint primitive,
+not rejected as runtime errors.
+
+`evidence/current-v2` contains the final 20-seed sweep and protected runs at
+seeds 0,17,2, covering all eight orientation codes. `evidence/current` is the
+prior passing audit limited to seven protected orientation codes; no broader
+coverage was attributed to it. Python request checks and actual protected rule
+applications are reported separately. Native qualification, exact-source owner
+acceptance, and training admission are separate stages.
diff --git a/repo/generators/1ecf6add3fe7/workspace/parametric/adapter.py b/repo/generators/1ecf6add3fe7/workspace/parametric/adapter.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/1ecf6add3fe7/workspace/parametric/adapter.py
@@ -0,0 +1,231 @@
+"""Native D4 transform-transfer family, with exact canonical default source.
+
+All input shapes are newly constructed connected polyominoes. Prototype areas
+and ordered bounding boxes agree, but their D4 orbits differ. The inference
+intermediate is a uniquely recoverable prototype-to-query transformation.
+"""
+from __future__ import annotations
+from copy import deepcopy
+from functools import lru_cache
+import hashlib
+import importlib.util
+from pathlib import Path
+import random
+
+from puzzle_generators.rule_wrap import wrap_rule
+
+HOME = Path(__file__).resolve().parent
+_spec = importlib.util.spec_from_file_location(
+    '_transfer_pose_base_' + hashlib.sha256(str(HOME).encode()).hexdigest()[:12],
+    HOME.parents[1] / 'generator.py')
+_base = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_base)
+CANONICAL = (HOME/'canonical.rkt').read_text(encoding='utf-8')
+SETTINGS = ('label_query','transfer_pose')
+RIVALS = ('label_query','identity_other','inverse_pose','fixed_clockwise',
+          'fixed_mirror','matched_color','recolor_query','first_prototype')
+LABELS = (2,3,4,6,7,8,9)
+
+
+def _policy(settings: dict) -> str:
+    if (type(settings) is not dict or set(settings) != {'response_policy'}
+            or type(settings['response_policy']) is not str
+            or settings['response_policy'] not in SETTINGS):
+        raise ValueError('settings must contain exactly response_policy=label_query|transfer_pose')
+    return settings['response_policy']
+
+
+def _parse(grid):
+    info = _base.analyze_grid(grid)
+    if info['errors']:
+        raise ValueError('; '.join(info['errors']))
+    if len(info['transform_candidates']) != 1:
+        raise ValueError('the admitted family requires a unique D4 mapping')
+    return info
+
+
+def transform(grid: list[list[int]], policy: str) -> list[list[int]]:
+    """Python claim interpreter; protected Racket remains the label authority."""
+    if policy not in set(SETTINGS) | set(RIVALS):
+        raise ValueError('unknown response policy')
+    info = _parse(grid)
+    if policy == 'label_query':
+        return deepcopy(info['expected_output'])
+    winner = info['match_side']
+    other = 0 if policy == 'first_prototype' else 1-winner
+    code = info['transform_candidates'][0]
+    if policy == 'identity_other': code = 0
+    elif policy == 'inverse_pose': code = {1:3,3:1}.get(code,code)
+    elif policy == 'fixed_clockwise': code = 1
+    elif policy == 'fixed_mirror': code = 4
+    color = info['labels'][winner if policy == 'matched_color' else other]
+    query = info['shapes'][2]
+    top = min(r for r,c in query)
+    left = min(c for r,c in query)
+    cells = (query if policy == 'recolor_query' else
+             [(r+top,c+left) for r,c in _base._orient(info['normalized_shapes'][other],code)])
+    out = [[0]*info['panel_w'] for _ in range(info['grid_h'])]
+    for r,c in cells:
+        # Wrong fixed-pose rivals can be too wide; match Racket's explicit
+        # clipping rather than accepting a runtime error as their rejection.
+        if 0 <= r < len(out) and 0 <= c < len(out[0]): out[r][c] = color
+    return out
+
+
+@lru_cache(maxsize=None)
+def rule_for(policy: str) -> str:
+    if policy not in set(SETTINGS) | set(RIVALS):
+        raise ValueError('unknown response policy')
+    if policy == 'label_query': return CANONICAL
+    code_expr = {'identity_other':'0','inverse_pose':'(cond ((= actual 1) 3) ((= actual 3) 1) (else actual))',
+                 'fixed_clockwise':'1','fixed_mirror':'4'}.get(policy,'actual')
+    other_expr = '0' if policy == 'first_prototype' else '(- 1 winner)'
+    color_expr = 'matched-label' if policy == 'matched_color' else '(cell-at g 0 (* other (+ pw 1)))'
+    cells_expr = 'qcells' if policy == 'recolor_query' else '''(map (lambda (p)
+                    (list (+ top (first p)) (+ left (second p))))
+                  (orient (panel-cells other) chosen-code))'''
+    return f'''(rule! (lambda (g)
+      ;; A: canonical D4 matching supplies the selected label and query cells.
+      ;; Infer its unique prototype-to-query map; B transfers it to the other shape.
+      (let ()
+        (define stage ({wrap_rule(CANONICAL)} g))
+        (define pw (cols stage))
+        (define (cell< a b)
+          (or (< (first a) (first b))
+              (and (= (first a) (first b)) (< (second a) (second b)))))
+        (define (norm cells)
+          (if (null? cells) cells
+            (let ((r0 (apply min (map first cells))) (c0 (apply min (map second cells))))
+              (sort (map (lambda (p) (list (- (first p) r0) (- (second p) c0))) cells) cell<))))
+        (define (orient cells code)
+          (norm (map (lambda (p)
+            (let ((r (first p)) (c (second p)))
+              (cond ((= code 0) (list r c)) ((= code 1) (list c (- r)))
+                    ((= code 2) (list (- r) (- c))) ((= code 3) (list (- c) r))
+                    ((= code 4) (list r (- c))) ((= code 5) (list (- r) c))
+                    ((= code 6) (list c r)) (else (list (- c) (- r)))))) cells)))
+        (define (panel-cells k)
+          (for*/list ((r (range (rows g))) (c (range pw))
+                       #:when (= (cell-at g r (+ (* k (+ pw 1)) c)) 1)) (list r c)))
+        (define qcells (filter (lambda (p) (not (= (cell-at stage (first p) (second p)) 0))) (grid-positions stage)))
+        (define matched-label (if (null? qcells) 0 (cell-at stage (first (first qcells)) (second (first qcells)))))
+        (define winner (if (= matched-label (cell-at g 0 0)) 0 1))
+        (define qnorm (norm qcells))
+        (define codes (filter (lambda (code) (equal? (orient (panel-cells winner) code) qnorm)) (range 8)))
+        (define actual (if (null? codes) 0 (first codes)))
+        (define chosen-code {code_expr})
+        (define other {other_expr})
+        (define top (if (null? qcells) 0 (apply min (map first qcells))))
+        (define left (if (null? qcells) 0 (apply min (map second qcells))))
+        (recolor-cells (empty-grid (rows stage) pw 0) {cells_expr} {color_expr}))))'''
+
+
+def program(settings: dict) -> str:
+    return rule_for(_policy(settings))
+
+
+def _rng(seed: int, label: str) -> random.Random:
+    raw = hashlib.sha256(f'transfer-pose-v1:{seed}:{label}'.encode()).digest()
+    return random.Random(int.from_bytes(raw,'big'))
+
+
+def _shape(rng, height, width, size):
+    """Connected growth around a random full-span cross, not a stored bitmap."""
+    for _ in range(256):
+        row,col = rng.randrange(height),rng.randrange(width)
+        cells = {(r,col) for r in range(height)} | {(row,c) for c in range(width)}
+        while len(cells) < size:
+            frontier = {(r+dr,c+dc) for r,c in cells for dr,dc in _base._CARDINAL
+                        if 0 <= r+dr < height and 0 <= c+dc < width} - cells
+            cells.add(rng.choice(sorted(frontier)))
+        normalized = _base._normalize(cells)
+        if len(_base._d4_variants(normalized)) == 8:
+            return normalized
+    raise RuntimeError('bounded asymmetric connected-shape construction exhausted')
+
+
+def _scene(rng, height, panel_w, shape_h, shape_w, size, side, code):
+    reference = _shape(rng,shape_h,shape_w,size)
+    variants = _base._d4_variants(reference)
+    for _ in range(256):
+        other = _shape(rng,shape_h,shape_w,size)
+        if other not in variants: break
+    else: raise RuntimeError('bounded equal-statistic decoy construction exhausted')
+    query = _base._orient(reference,code)
+    shapes = (reference,other,query) if side == 0 else (other,reference,query)
+    grid = [[0]*(3*panel_w+2) for _ in range(height)]
+    for row in grid: row[panel_w] = row[2*panel_w+1] = 5
+    labels = rng.sample(LABELS,2)
+    grid[0][0],grid[0][panel_w+1] = labels
+    for k,shape in enumerate(shapes):
+        rh,cw = _base._bbox_shape(shape)
+        if rh >= height or cw > panel_w:
+            raise ValueError('shape does not fit its panel under the requested pose')
+        top,left = rng.randint(1,height-rh),rng.randint(0,panel_w-cw)
+        for r,c in shape: grid[top+r][k*(panel_w+1)+left+c] = 1
+    info = _parse(grid)
+    assert info['match_side'] == side and info['transform_candidates'] == (code,)
+    return grid
+
+
+@lru_cache(maxsize=64)
+def _inputs(seed: int) -> tuple:
+    teaching = _rng(seed,'teaching')
+    side = teaching.randrange(2)
+    # Fixed roles, fresh shapes: one invertible quarter-turn and one reflection
+    # are sufficient to reject the finite fixed/inverse/positional alternatives.
+    codes = (teaching.choice((1,3)),teaching.choice((4,5,6,7)))
+    demos = []
+    for slot in range(6):
+        rng = _rng(seed,f'demo-{slot}')
+        shape_h,shape_w = ((3,4),(4,4),(3,3),(4,5),(5,4),(5,5))[slot]
+        area = ((shape_h+shape_w-1) + shape_h*shape_w)//2
+        demos.append(_scene(rng, max(shape_h,shape_w)+rng.randint(3,5),
+                            max(shape_h,shape_w)+rng.randint(1,3),shape_h,shape_w,
+                            area,(side+slot)%2,codes[slot] if slot<2 else (seed+slot)%8))
+    queries = []
+    specs = ((5,4,3,3,6),(10,6,4,5,13),(15,9,6,8,31),(30,9,27,9,145))
+    for slot,spec in enumerate(specs):
+        rng = _rng(seed,f'query-{slot}')
+        code = (0,2,4,5)[seed%4] if slot == 3 else (seed+slot*2)%8
+        queries.append(_scene(rng,*spec,rng.randrange(2),code))
+    if len({tuple(map(tuple,g)) for g in demos+queries}) != 10:
+        raise RuntimeError('scene streams produced a duplicate input')
+    for name in RIVALS:
+        if all(transform(g,name) == transform(g,'transfer_pose') for g in demos[:2]):
+            raise RuntimeError('two-demo teaching contract failed for '+name)
+    return tuple(tuple(tuple(row) for row in g) for g in demos),tuple(tuple(tuple(row) for row in g) for g in queries)
+
+
+def generate(seed: int, settings: dict, demos: int, queries: int) -> dict:
+    policy = _policy(settings)
+    if type(seed) is not int: raise ValueError('seed must be an exact integer')
+    if type(demos) is not int or not 2 <= demos <= 6: raise ValueError('demos must be an exact integer in 2..6')
+    if type(queries) is not int or not 1 <= queries <= 4: raise ValueError('queries must be an exact integer in 1..4')
+    train,test = _inputs(seed)
+    def pair(raw):
+        grid = [list(row) for row in raw]
+        return {'input':grid,'output':transform(grid,policy)}
+    return {'train':[pair(g) for g in train[:demos]],'test':[pair(g) for g in test[:queries]],
+            'program_solution':program(settings)}
+
+
+def public_turn(episode: dict, query_index: int) -> dict:
+    if type(query_index) is not int or not 0 <= query_index < len(episode['test']):
+        raise ValueError('query_index must identify one stored query')
+    return {'train':deepcopy([{'input':p['input'],'output':p['output']} for p in episode['train']]),
+            'test':[{'input':deepcopy(episode['test'][query_index]['input'])}]}
+
+
+def describe(grid: list[list[int]]) -> dict:
+    info = _parse(grid)
+    h,w = len(grid),len(grid[0])
+    return {'shape':[h,w],'match_side':info['match_side'],
+            'transform_code':info['transform_candidates'][0],
+            'unique_orientation':len(info['transform_candidates']) == 1,
+            'prototype_sizes':[len(cells) for cells in info['shapes'][:2]],
+            'prototype_boxes':[list(_base._bbox_shape(s)) for s in info['normalized_shapes'][:2]],
+            'query_size':len(info['shapes'][2]),
+            'query_bbox_span':list(_base._bbox_shape(info['normalized_shapes'][2])),
+            'shape_quadrants':[sum((r>=h//2)*2+(c>=w//2)==q for r,row in enumerate(grid)
+                                   for c,v in enumerate(row) if v==1) for q in range(4)]}
diff --git a/repo/generators/1ecf6add3fe7/workspace/parametric/audit.py b/repo/generators/1ecf6add3fe7/workspace/parametric/audit.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/1ecf6add3fe7/workspace/parametric/audit.py
@@ -0,0 +1,192 @@
+"""Bounded native-family audit; standalone inside this task's own workspace.
+
+Run through review.py run, or with this checkout's src/shared/runtime on
+PYTHONPATH and the bundled RACKET_PATH. No prior checkout is imported. Reports
+separate repeated count requests from independently drawn scenes. The tool
+refuses to overwrite an output directory and returns nonzero on any failure.
+"""
+from __future__ import annotations
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import time
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import public_challenge_bytes
+
+HOME = Path(__file__).resolve().parent
+
+
+def load_adapter():
+    spec = importlib.util.spec_from_file_location(
+        '_bounded_audit_' + hashlib.sha256(str(HOME).encode()).hexdigest()[:12],
+        HOME / 'adapter.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value,sort_keys=True,indent=2)+'\n',encoding='utf-8')
+
+
+def grid_key(grid):
+    return tuple(map(tuple,grid))
+
+
+def run(out: Path, seeds: int, racket_seeds: list[int]) -> dict:
+    out.mkdir(parents=True,exist_ok=False)
+    start = time.monotonic()
+    a = load_adapter()
+    contract = json.loads((HOME/'promotion.json').read_text())
+    parameter = next(iter(contract['parameters']))
+    task = HOME.parents[1].name
+    report = {'schema':'arcpuzzles-task-parametric-audit-v1','task_id':task,
+              'status':'running','seeds':list(range(seeds)), 'requests':0,
+              'labelled_pairs_across_repeated_requests':0,'matched_inputs':0,
+              'public_turns':0,'query_prefix_checks':0,'rival_survivors':[],
+              'racket_evaluations':0,'errors':[],
+              'limits':'Finite seeds and declared rivals only; Python sweep labels are claims. '
+                       'Protected executions are counted separately. No owner acceptance or training admission.'}
+    try:
+        unique = set()
+        stats = []
+        for seed in range(seeds):
+            full = {s:a.generate(seed,{parameter:s},6,4) for s in a.SETTINGS}
+            stats.append({'seed':seed,'query4':a.describe(full[a.SETTINGS[0]]['test'][3]['input'])})
+            for ep in full.values():
+                inputs = ep['train']+ep['test']
+                assert len({grid_key(p['input']) for p in inputs}) == 10
+                unique.update(grid_key(p['input']) for p in inputs)
+            for demos in range(2,7):
+                for queries in range(1,5):
+                    previous = None
+                    for setting in a.SETTINGS:
+                        ep = a.generate(seed,{parameter:setting},demos,queries)
+                        assert ep['train'] == full[setting]['train'][:demos]
+                        assert ep['test'] == full[setting]['test'][:queries]
+                        assert ep['program_solution'] == a.program({parameter:setting})
+                        visible = [p['input'] for p in ep['train']+ep['test']]
+                        if previous is not None:
+                            assert visible == previous
+                            report['matched_inputs'] += 1
+                        previous = visible
+                        for i in range(queries):
+                            view = a.public_turn(ep,i)
+                            assert set(view) == {'train','test'}
+                            assert view['test'] == [{'input':ep['test'][i]['input']}]
+                            assert all(set(p) == {'input','output'} for p in view['train'])
+                            public_challenge_bytes(view)  # Strict exact-integer grid validation.
+                            private_changed = deepcopy(ep)
+                            private_changed['program_solution'] = 'PRIVATE SENTINEL'
+                            private_changed['settings'] = {'PRIVATE':'SENTINEL'}
+                            for p in private_changed['test']:
+                                p['output'] = [[9]]
+                            for j in range(i+1,len(private_changed['test'])):
+                                private_changed['test'][j]['input'] = [[9]]
+                            assert a.public_turn(private_changed,i) == view
+                            report['public_turns'] += 1
+                        assert a.public_turn(ep,0) == a.public_turn(a.generate(seed,{parameter:setting},demos,1),0)
+                        report['query_prefix_checks'] += 1
+                        report['requests'] += 1
+                        report['labelled_pairs_across_repeated_requests'] += demos+queries
+        report['distinct_scene_inputs'] = len(unique)
+        report['stress_queries'] = stats
+        programs = {name:a.rule_for(name) for name in dict.fromkeys(a.SETTINGS+a.RIVALS)}
+        episodes, teaching, cache = [], [], {}
+        public = out/'public'; public.mkdir()
+        turns = out/'turns'; turns.mkdir()
+        with RacketBridge() as bridge:
+            identity = bridge.runtime_identity
+            assert identity['backend'] == 'racket' and identity['protected'] is True
+            report['racket'] = identity
+            wrapped = {name:wrap_rule(src) for name,src in programs.items()}
+            def evaluate(name, grid):
+                key = (programs[name],grid_key(grid))
+                if key not in cache:
+                    literal = "'("+' '.join('('+' '.join(map(str,row))+')' for row in grid)+')'
+                    value = bridge.eval_text(f'({wrapped[name]} {literal})')
+                    assert value == a.transform(grid,name), f'Racket/Python disagreement for {name}'
+                    cache[key] = value
+                    report['racket_evaluations'] += 1
+                return deepcopy(cache[key])
+            for seed in racket_seeds:
+                for setting in a.SETTINGS:
+                    ep = a.generate(seed,{parameter:setting},3,4)
+                    for p in ep['train']+ep['test']:
+                        actual = evaluate(setting,p['input'])
+                        assert p['output'] == actual
+                        p['output'] = actual
+                    # Test rivals against only the minimum two demonstrations.
+                    lesson = {'seed':seed,'setting':setting,'demos_used':2,'rivals':[]}
+                    for name in programs:
+                        if name == setting:
+                            continue
+                        mismatch = []
+                        for index,p in enumerate(ep['train'][:2]):
+                            actual = evaluate(name,p['input'])
+                            if actual != p['output']:
+                                mismatch.append(index)
+                        if not mismatch:
+                            report['rival_survivors'].append({'seed':seed,'setting':setting,'rival':name})
+                        row = {'name':name,'program':programs[name],'mismatching_demo_indices':mismatch}
+                        if mismatch:
+                            p = ep['train'][mismatch[0]]
+                            row['counterexample'] = {'input':p['input'],'selected_output':p['output'],
+                                                     'rival_output':evaluate(name,p['input'])}
+                        lesson['rivals'].append(row)
+                    teaching.append(lesson)
+                    challenge = {'train':ep['train'],'test':[{'input':p['input']} for p in ep['test']]}
+                    raw = public_challenge_bytes(challenge)
+                    (public/(hashlib.sha256(raw).hexdigest()+'.json')).write_bytes(raw)
+                    for i in range(4):
+                        raw = public_challenge_bytes(a.public_turn(ep,i))
+                        (turns/(hashlib.sha256(raw).hexdigest()+'.json')).write_bytes(raw)
+                    episodes.append({'seed':seed,'settings':{parameter:setting},**ep})
+        assert not report['rival_survivors'], 'a declared rival survives the minimum lesson'
+        report['status'] = 'passed'
+        write_json(out/'episodes.private.json',episodes)
+        write_json(out/'teaching.private.json',teaching)
+        report['protected_episode_count'] = len(episodes)
+        report['protected_selected_labels'] = sum(len(e['train'])+len(e['test']) for e in episodes)
+        report['public_challenges'] = len(list(public.glob('*.json')))
+        report['saved_single_query_turns'] = len(list(turns.glob('*.json')))
+    except Exception as error:
+        report['status'] = 'failed'
+        report['errors'].append(f'{type(error).__name__}: {error}')
+    report['elapsed_seconds'] = round(time.monotonic()-start,3)
+    report['source_sha256'] = {name:hashlib.sha256((HOME/name).read_bytes()).hexdigest()
+                               for name in ('adapter.py','audit.py','promotion.json','canonical.rkt')}
+    write_json(out/'report.json',report)
+    return report
+
+
+def positive(value):
+    number = int(value)
+    if number < 1:
+        raise argparse.ArgumentTypeError('must be positive')
+    return number
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out',required=True,type=Path)
+    parser.add_argument('--seeds',type=positive,default=20)
+    parser.add_argument('--racket-seeds',type=int,nargs='+',default=[0,17])
+    args = parser.parse_args()
+    try:
+        report = run(args.out,args.seeds,list(dict.fromkeys(args.racket_seeds)))
+    except (OSError,ValueError) as error:
+        print(str(error),file=sys.stderr)
+        return 2
+    print(json.dumps({k:v for k,v in report.items() if k not in {'stress_queries','racket','source_sha256'}},indent=2))
+    return 0 if report['status'] == 'passed' else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
