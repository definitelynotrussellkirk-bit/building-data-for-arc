+"""Replay one current-source eight-plus-one sorting ambiguity.
+
+The discovery screen used exactly sixteen ordinary easy inputs: seeds 0 and 17,
+indices 0..7, and four natural rivals that each keep one corner block fixed.
+This reproducer redraws only the retained consecutive lesson and one guard.
+Execution failures abort; they are never counted as rival refutations.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+
+TASK = "3108da8bf9e8"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+SOURCE_SHA = "4c5d75752ec9c0899595a62b17076b1ed5e5240b3069e2d55b413477469730d3"
+RULE_HASH = "05977542b8d5"
+CANONICAL_SHA = "b1d2f204891bd86a73b84fa2b03897d13c3156781f3dbc4f514dffef8f275585"
+TARGETS = ((2, 0), (2, 1), (2, 2), (1, 0), (1, 1), (1, 2), (0, 0), (0, 1), (0, 2))
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def counts(grid):
+    return [sum(grid[br * 4 + dr][bc * 4 + dc] == 1 for dr in range(3) for dc in range(3))
+            for br in range(3) for bc in range(3)]
+
+
+def correctly_placed_corners(grid):
+    present = counts(grid)
+    expected = [None] * 9
+    for value, (br, bc) in zip(sorted(present), TARGETS):
+        expected[3 * br + bc] = value
+    return [index for index in (0, 2, 6, 8) if present[index] == expected[index]]
+
+
+def stationary_corner_guard(demos, query):
+    """Name the four fixed-corner rules that fit demos but can change query."""
+    return [index for index in (0, 2, 6, 8)
+            if all(index in correctly_placed_corners(pair["input"]) for pair in demos)
+            and index not in correctly_placed_corners(query["input"])]
+
+
+def fixed_corner_rule(br=0, bc=0):
+    """Complete alternative: keep this block, globally sort only the other eight."""
+    return f"""(rule! (lambda (g)
+      (let* ((locked-row {br}) (locked-col {bc})
+             (flat (for*/list ((br (range 0 3)) (bc (range 0 3)))
+               (list br bc (for/sum ((dr (range 0 3)))
+                 (for/sum ((dc (range 0 3)))
+                   (if (= 1 (at g (+ (* br 4) dr) (+ (* bc 4) dc))) 1 0))))))
+             (sorted (sort-by
+               (filter (lambda (x) (not (and (= (first x) locked-row)
+                                             (= (second x) locked-col)))) flat)
+               (lambda (x) (third x))))
+             (targets (filter (lambda (x) (not (and (= (first x) locked-row)
+                                                   (= (second x) locked-col))))
+               (list (list 2 0) (list 2 1) (list 2 2)
+                     (list 1 0) (list 1 1) (list 1 2)
+                     (list 0 0) (list 0 1) (list 0 2)))))
+        (grid-from-fn 11 11 (lambda (r c)
+          (cond
+            ((or (= (mod r 4) 3) (= (mod c 4) 3)) 0)
+            ((and (= (floor (/ r 4)) locked-row) (= (floor (/ c 4)) locked-col))
+              (at g r c))
+            (else
+              (let* ((target (list (floor (/ r 4)) (floor (/ c 4))))
+                     (idx (find-first (lambda (i) (equal? target (nth targets i))) (range 0 8)))
+                     (src (nth sorted idx)))
+                (at g (+ (* (first src) 4) (mod r 4))
+                      (+ (* (second src) 4) (mod c 4)))))))))))"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError("output must be new")
+    gen, source_path, source_hash = load_selected_generator(TASK, root=ROOT)
+    if source_hash != SOURCE_SHA:
+        raise ValueError("selected generator differs from the retained source")
+    rows = [row for line in (ROOT / "shared/data/canonical/puzzles.jsonl").open()
+            if (row := json.loads(line)).get("task_id") == TASK]
+    programs = {row["program_solution"] for row in rows}
+    if len(programs) != 1:
+        raise ValueError("ambiguous canonical program")
+    program = programs.pop()
+    if (sha(program.encode()) != CANONICAL_SHA
+            or sha(" ".join(program.split()).encode())[:12] != RULE_HASH):
+        raise ValueError("canonical program differs from the retained source")
+    grids = {index: gen.generate(0, index, difficulty="easy") for index in range(5)}
+    if any(gen.self_check(grid) for grid in grids.values()):
+        raise ValueError("a retained input fails the current self check")
+    rival = fixed_corner_rule()
+    evaluations = 0
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            bridge.close()
+            raise ValueError("real protected Racket is required")
+
+        def execute(source, grid):
+            nonlocal evaluations
+            value = apply(source, deepcopy(grid))
+            evaluations += 1
+            return value
+
+        try:
+            canonical_checks = []
+            for row in rows:
+                for split in ("train", "test"):
+                    for index, pair in enumerate(row[split]):
+                        actual = execute(program, pair["input"])
+                        if actual != pair["output"]:
+                            raise ValueError("canonical replay failed")
+                        canonical_checks.append({"source": row["source"], "split": split,
+                                                 "index": index, "matches": True})
+            expected = {index: execute(program, grids[index]) for index in range(5)}
+            alternatives = {index: execute(rival, grids[index]) for index in range(5)}
+        finally:
+            bridge.close()
+    demos = [{"input": grids[i], "output": expected[i]} for i in (1, 2, 3)]
+    query = {"input": grids[4], "output": expected[4]}
+    demo_fits = [expected[i] == alternatives[i] for i in (1, 2, 3)]
+    differences = [{"row": r, "column": c, "intended": expected[4][r][c],
+                    "alternative": alternatives[4][r][c]}
+                   for r in range(11) for c in range(11)
+                   if expected[4][r][c] != alternatives[4][r][c]]
+    if not all(demo_fits) or not differences or expected[0] == alternatives[0]:
+        raise ValueError("the retained ambiguity or guard claim failed execution")
+    if sha(Path(source_path).read_bytes()) != SOURCE_SHA:
+        raise ValueError("production source changed during replay")
+    supplementary = json.loads((HERE.parent / "evidence/supplementary-current.json").read_text())
+    report = {
+        "schema": "arc-protected-fixed-corner-counterexample-v1", "task_id": TASK,
+        "status": "finding", "source_path": f"generators/{TASK}/generator.py",
+        "source_sha256": SOURCE_SHA, "canonical_source_path": "shared/data/canonical/puzzles.jsonl",
+        "canonical_rule_hash": RULE_HASH, "canonical_program_sha256": CANONICAL_SHA,
+        "probe_sha256": sha(Path(__file__).read_bytes()), "evaluator": identity,
+        "protected_racket_evaluations": evaluations, "canonical_replays": canonical_checks,
+        "discovery_scope": {"unique_ordinary_inputs": 16, "seeds": [0, 17],
+                            "sample_indices_per_seed": list(range(8)), "difficulty": "easy",
+                            "overrides": {}, "rival_corner_indices": [0, 2, 6, 8],
+                            "evidence": "checks/3108da8bf9e8/finite-prefilter-command.json"},
+        "retained_scope": "three consecutive ordinary generator draws plus the next draw; "
+                          "native episode export was not invoked",
+        "case_provenance": {"seed": 0, "difficulty": "easy", "overrides": {},
+                            "demo_sample_indices": [1, 2, 3], "query_sample_index": 4},
+        "program": program, "rival_program": rival, "rival_program_sha256": sha(rival.encode()),
+        "rival_description": "keep the top-left 3x3 block fixed and sort the other eight whole "
+                             "blocks by color-1 count into the remaining bottom-first targets",
+        "original_lesson": {"train": demos, "test": [query]},
+        "alternative_demo_outputs": [alternatives[i] for i in (1, 2, 3)],
+        "alternative_query_output": alternatives[4], "demo_fits": demo_fits,
+        "query_differences": differences, "query_different_cell_count": len(differences),
+        "current_lesson_identifiable_reasons": gen.lesson_identifiable(demos, query),
+        "stationary_corner_guard": stationary_corner_guard(demos, query),
+        "guard_demonstration": {"seed": 0, "sample_index": 0, "difficulty": "easy",
+                                "overrides": {}, "input": grids[0], "output": expected[0],
+                                "alternative_output": alternatives[0],
+                                "rejects_selected_rival": True},
+        "sample_observations": [{"seed": 0, "sample_index": i, "counts_row_major": counts(grids[i]),
+                                 "correctly_placed_corners": correctly_placed_corners(grids[i]),
+                                 "self_check": gen.self_check(grids[i])} for i in range(5)],
+        "referenced_supplementary_assets": [{"path": item["path"],
+                                               "present_in_packet": (ROOT / item["path"]).exists()}
+                                              for item in supplementary["files"]],
+        "limits": ["This establishes one concrete instance of the eight-plus-one limitation "
+                   "already acknowledged in notes; it does not invalidate the repaired three-triple class.",
+                   "The discovery screen used four corner variants, two seeds and the easy band only.",
+                   "The added guard rejects the retained top-left rival; it does not alone certify "
+                   "all other corners or arbitrary larger decompositions.",
+                   "No production repair, audit disposition, approval or training admission is made."]}
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"status": "finding", "out": str(args.out), "sha256": sha(args.out.read_bytes()),
+                      "racket_evaluations": evaluations, "demo_fits": demo_fits,
+                      "query_different_cells": len(differences)}))
+
+
+if __name__ == "__main__":
+    main()
