+
+def episode():
+    return {"seed": 17, "settings": {"ranking_policy": "area"},
+            "program_solution": "(rule! g)",
+            "train": [{"input": [[i]], "output": [[i]]} for i in range(3)],
+            "test": [{"input": [[i]], "output": [[i]]} for i in range(3, 7)]}
+
+
+def execute_identity(_program, grid):
+    return deepcopy(grid)
