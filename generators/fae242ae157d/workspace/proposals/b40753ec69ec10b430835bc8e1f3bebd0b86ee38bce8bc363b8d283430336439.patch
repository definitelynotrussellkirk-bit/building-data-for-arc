+"""Bounded new span-ranking audit; retain the existing perimeter finding."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "src"))
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+TASK = "eb92fce9b549"
+SOURCE_SHA = "233751e50f0534ff225c8d74cc35ed1cb939755d6cc006f201269f6556a1dceb"
+RULE_HASH = "45c25a11961c"
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def rival_programs(canonical):
+    area_a = "(* (obj-h a) (obj-w a))"
+    area_b = "(* (obj-h b) (obj-w b))"
+    old = f"(> {area_a} {area_b})"
+    assert canonical.count(old) == 1
+    result = {}
+    for name, measure in (("horizontal_span", "(obj-w {obj})"),
+                          ("vertical_span", "(obj-h {obj})"),
+                          ("maximum_side", "(max (obj-h {obj}) (obj-w {obj}))")):
+        left, right = measure.format(obj="a"), measure.format(obj="b")
+        replacement = f"(let ((pa {left}) (pb {right})) (if (= pa pb) (> {area_a} {area_b}) (> pa pb)))"
+        result[name] = canonical.replace(old, replacement)
+    return result
+
+
+def demo_only_survivors(demos, rivals, execute):
+    """Finite proposed guard; query answers are unused and errors propagate."""
+    return [name for name, program in rivals.items()
+            if all(execute(program, pair["input"]) == pair["output"] for pair in demos)]
+
+
+def difference(left, right):
+    changed = [{"row": r, "col": c, "intended": value, "rival": right[r][c]}
+               for r, row in enumerate(left) for c, value in enumerate(row) if value != right[r][c]]
+    return {"count": len(changed), "first": changed[0] if changed else None}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    ledger = ROOT / "shared/data/canonical/puzzles.jsonl"
+    rows = [json.loads(line) for line in ledger.read_text().splitlines()]
+    selected = [row for row in rows if row.get("task_id") == TASK]
+    assert len(selected) == 1
+    selected = selected[0]
+    canonical = selected["program_solution"]
+    assert sha(" ".join(canonical.split()).encode())[:12] == RULE_HASH
+    rivals = rival_programs(canonical)
+    helper = Path(__file__).resolve().parent / "reference_probe.py"
+    report = {
+        "schema": "arcpuzzles-bounded-peer-adversarial-probe-v1", "task_id": TASK,
+        "status": "running", "execution_errors": [],
+        "source_binding": {"generator_sha256": SOURCE_SHA, "rule_hash": RULE_HASH,
+                           "canonical_program_sha256": sha(canonical.encode()),
+                           "canonical_ledger_path": str(ledger.relative_to(ROOT)),
+                           "probe_sha256": sha(Path(__file__).read_bytes()),
+                           "geometry_helper_path": str(helper.relative_to(ROOT)),
+                           "geometry_helper_sha256": sha(helper.read_bytes())},
+        "programs": {"intended": canonical, **rivals},
+        "sampling": {"seeds": [0, 1], "difficulty": None, "overrides": {},
+                     "generated_inputs": 16, "indices_per_seed": 8,
+                     "demo_indices": [0, 1, 2], "query_indices": [3, 4, 5, 6],
+                     "additional_candidate_index": 7},
+        "prior_open_audits": ["review-f0b8f410f702ade8:v0001"],
+        "limits": ["Three finite span rivals only; bbox area breaks each metric tie.",
+                   "Saved canonical and ordinary generated lesson scopes are separate.",
+                   "The existing perimeter shortcut audit remains needs_triage and is not repeated.",
+                   "No production/canonical edits, broad battery, qualification or admission."]}
+    try:
+        with _local_imports(ROOT / "shared/runtime", helper.parent):
+            from reviewer_support import load_selected_generator
+            from reference_probe import bbox, components, canonical_pairs
+            gen, source, source_hash = load_selected_generator(TASK, root=ROOT)
+            assert source_hash == SOURCE_SHA
+            report["source_binding"]["generator_path"] = str(source.relative_to(ROOT))
+            apply, report["racket"], bridge = _real_evaluator(ROOT / "shared/runtime")
+            cache = {}
+
+            def execute(program, grid):
+                key = (program, json.dumps(grid, separators=(",", ":")))
+                if key not in cache:
+                    cache[key] = _grid(apply(program, grid))
+                return cache[key]
+
+            def label(grid, origin):
+                errors = gen.self_check(grid)
+                assert not errors, errors
+                measurements = []
+                for _, cells in components(grid):
+                    r0, c0, r1, c1 = bbox(cells)
+                    measurements.append({"bbox": [r0, c0, r1, c1], "cells": len(cells),
+                                         "height": r1-r0+1, "width": c1-c0+1,
+                                         "area": (r1-r0+1)*(c1-c0+1)})
+                return {"origin": origin, "input": grid, "self_check": errors,
+                        "observed_axes": gen.observe_overrides(grid), "component_stats": measurements,
+                        "output": execute(canonical, grid),
+                        "rival_outputs": {name: execute(program, grid) for name, program in rivals.items()}}
+
+            def lesson(name, demos, queries):
+                alive = demo_only_survivors(demos, rivals, execute)
+                return {"name": name, "demos": demos, "queries": queries,
+                        "distinct_inputs": len({json.dumps(pair["input"]) for pair in demos + queries}),
+                        "survivors_from_demos_only": alive,
+                        "existing_lesson_hook": [gen.lesson_identifiable(demos, query) for query in queries],
+                        "query_disagreements": [{"origin": query["origin"], "rival": name,
+                                                 "difference": difference(query["output"], query["rival_outputs"][name])}
+                                                for query in queries for name in alive
+                                                if query["output"] != query["rival_outputs"][name]]}
+
+            try:
+                official = canonical_pairs()
+                saved = [label(pair["input"], {"kind": "saved_canonical", "index": i})
+                         for i, pair in enumerate(official)]
+                for actual, pair in zip(saved, official):
+                    assert actual["output"] == pair["output"]
+                n_train = len(selected["train"])
+                report["saved_canonical_lesson"] = lesson("saved_canonical", saved[:n_train], saved[n_train:])
+                report["generated_lessons"] = []
+                samples = []
+                for seed in (0, 1):
+                    drawn = [label(gen.generate(seed, index), {"kind": "ordinary_generated", "seed": seed, "sample_index": index})
+                             for index in range(8)]
+                    samples.extend(drawn)
+                    item = lesson(f"generated_seed_{seed}", drawn[:3], drawn[3:7])
+                    item["additional_candidate"] = drawn[7]
+                    report["generated_lessons"].append(item)
+                all_lessons = [report["saved_canonical_lesson"], *report["generated_lessons"]]
+                report["repair_proposals"] = []
+                for item in all_lessons:
+                    if not item["query_disagreements"]:
+                        continue
+                    used = {json.dumps(pair["input"]) for pair in item["demos"] + item["queries"]}
+                    demos, extras, alive = list(item["demos"]), [], list(item["survivors_from_demos_only"])
+                    for candidate in samples:
+                        fingerprint = json.dumps(candidate["input"])
+                        if fingerprint in used or len(demos) >= 6:
+                            continue
+                        if any(candidate["output"] != candidate["rival_outputs"][name] for name in alive):
+                            demos.append(candidate)
+                            extras.append(candidate)
+                            used.add(fingerprint)
+                            alive = demo_only_survivors(demos, rivals, execute)
+                        if not alive:
+                            break
+                    report["repair_proposals"].append({"lesson": item["name"], "extra_demos": extras,
+                        "survivors_after": alive,
+                        "selection": "already sampled inputs, excluding original lesson inputs; chosen using demonstration disagreement only",
+                        "limit": "finite proposed guard only; prior perimeter issue remains open"})
+                report["protected_evaluations"] = len(cache)
+                report["status"] = ("bounded_ambiguity_confirmed" if any(item["query_disagreements"] for item in all_lessons)
+                                    else "bounded_no_query_ambiguity_found")
+            finally:
+                bridge.close()
+            assert sha(source.read_bytes()) == SOURCE_SHA
+    except Exception as error:
+        report["status"] = "execution_error_not_refutation"
+        report["execution_errors"].append({"type": type(error).__name__, "message": str(error)})
+        (args.out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+        raise
+    (args.out / "report.json").write_text(json.dumps(report, separators=(",", ":")) + "\n")
+    summary = {key: report[key] for key in ("schema", "task_id", "status", "source_binding", "racket", "sampling", "execution_errors", "protected_evaluations", "prior_open_audits", "limits")}
+    summary["lessons"] = [{"name": item["name"], "distinct_inputs": item["distinct_inputs"],
+                           "survivors": item["survivors_from_demos_only"], "query_disagreements": item["query_disagreements"],
+                           "existing_lesson_hook": item["existing_lesson_hook"]} for item in all_lessons]
+    summary["repair_proposals"] = [{"lesson": item["lesson"], "extra_origins": [pair["origin"] for pair in item["extra_demos"]],
+                                   "survivors_after": item["survivors_after"]} for item in report["repair_proposals"]]
+    (args.out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
