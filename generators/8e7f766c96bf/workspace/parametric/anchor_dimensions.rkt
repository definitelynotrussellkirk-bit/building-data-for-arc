(rule!
  (let ((dummy 0))
    (define (cell<? a b)
      (or (< (first a) (first b))
          (and (= (first a) (first b)) (< (second a) (second b)))))
    (define (rect-border r0 c0 r1 c1)
      (filter (lambda (p)
                (or (= (first p) r0) (= (first p) r1)
                    (= (second p) c0) (= (second p) c1)))
              (positions-in-rect r0 c0 r1 c1)))
    (define (hollow-rect? obj)
      (let ((bb (obj-bbox obj)))
        (equal? (sort (obj-cells obj) cell<?)
                (sort (rect-border (first bb) (second bb) (third bb) (fourth bb)) cell<?))))
    (define (object<? a b)
      (let ((aa (obj-bbox a)) (bb (obj-bbox b)))
        (or (< (first aa) (first bb))
            (and (= (first aa) (first bb)) (< (second aa) (second bb))))))
    (define frames
      (sort (filter (lambda (o) (and (= (obj-color o) 1) (hollow-rect? o)))
                    (objects g 0))
            object<?))
    (define anchor (first frames))
    (define anchor-h (obj-h anchor))
    (define anchor-w (obj-w anchor))
    (for/fold ([out g])
              ([obj (filter (lambda (o)
                              (and (= (obj-h o) anchor-h)
                                   (= (obj-w o) anchor-w)))
                            frames)])
      (paint-cells out (bbox-interior-cells obj) 2))))
