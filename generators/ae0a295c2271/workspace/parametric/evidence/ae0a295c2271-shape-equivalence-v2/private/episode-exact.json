  "program": ";; Compare 4-connected objects by exact translated shape (no rotation/flip).\n;; Singleton shape classes become red 2; repeated classes become blue 1.\n(rule!\n (lambda (g)\n   (let* ((objs (objects g 0)))\n     (paint-objects-by\n      g objs\n      (lambda (o)\n        (let* ((n-matches\n                (count-if (lambda (other) (same-shape? o other)) objs)))\n          (if (= n-matches 1) 2 1)))))))",
