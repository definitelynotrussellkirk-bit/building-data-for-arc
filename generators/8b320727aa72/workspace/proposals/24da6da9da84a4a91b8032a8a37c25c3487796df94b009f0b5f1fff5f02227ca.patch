+"""One bounded peer check of current histogram lessons, outside accepted source."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+HOME = Path(__file__).resolve().parents[2]
+ROOT = HOME.parents[1]
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    args.out.mkdir(parents=True)
+    verify = load('_c2cd_peer_verify', HOME / 'workspace/parametric/verify.py')
+    adapter = verify.load_adapter()
+    paths = [HOME / 'generator.py', Path(__file__),
+             *[HOME / 'workspace/parametric' / name for name in
+               ('adapter.py', 'prototype.py', 'canonical.rkt', 'promotion.json', 'verify.py')]]
+    sources = [{'path': str(path.relative_to(ROOT)),
+                'sha256': hashlib.sha256(path.read_bytes()).hexdigest()} for path in paths]
+    report = {'task_id': 'c2cd365ed4fa', 'status': 'running', 'source_files': sources,
+              'command': [sys.executable, *sys.argv], 'cwd': str(Path.cwd()),
+              'seeds': [0, 13], 'demos': 3, 'queries': 4, 'episodes': [],
+              'finding': None, 'native_acceptance_changed': False,
+              'limits': 'Two seeds, two current adapter settings, six named rivals only; no universal uniqueness or production-sampler claim.'}
+    with verify.ProtectedExecutor(ROOT) as execute:
+        report['racket'] = execute.identity
+        for seed in report['seeds']:
+            for mode in ('fixed', 'count_ascending'):
+                episode = adapter.generate(seed, {'column_order': mode}, 3, 4)
+                verify.check_labels(episode, execute)
+                declared = verify.rival_programs(adapter, mode)
+                rivals = {name: declared[name] for name in
+                          ('four_connected', 'pixel_count', 'top_aligned', 'other_setting')}
+                template = declared['four_connected'].replace('(third e)', '(second e)').replace(
+                    '(sort-by records third)', '(sort-by records second)')
+                count = '(length (objects-8 masked 7))'
+                if template.count(count) != 1:
+                    raise ValueError('Rival count source changed')
+                rivals['ignore_singletons'] = template.replace(count,
+                    '(length (filter (lambda (o) (> (obj-size o) 1)) (objects-8 masked 7)))')
+                rivals['largest_object_area'] = template.replace(count,
+                    '(if (empty? (objects-8 masked 7)) 0 (max-of obj-size (objects-8 masked 7)))')
+                audit = verify.audit_rivals(episode, rivals, execute)
+                report['episodes'].append({'seed': seed, 'settings': episode['settings'], **audit})
+                if audit['query_changing_survivors']:
+                    name = audit['query_changing_survivors'][0]
+                    index = audit['rivals'][name]['query_mismatches'][0]
+                    case = {'seed': seed, 'settings': episode['settings'],
+                            'train': episode['train'], 'test': [episode['test'][index]],
+                            'program': episode['program_solution'], 'rival_program': rivals[name],
+                            'rival': name, 'rival_output': audit['rivals'][name]['query_predictions'][index],
+                            'racket': execute.identity, 'source_files': sources}
+                    (args.out / 'counterexample.json').write_text(json.dumps(case, sort_keys=True) + '\n')
+                    report['finding'] = {'path': 'counterexample.json', 'seed': seed, 'setting': mode, 'rival': name}
+                    break
+            if report['finding']:
+                break
+        report['racket_executions'] = execute.executions
+        report['cache_hits'] = execute.cache_hits
+    report['status'] = 'finding' if report['finding'] else 'no_issue_in_checked_cases'
+    (args.out / 'report.json').write_text(json.dumps(report, sort_keys=True, indent=2) + '\n')
+    print(json.dumps({'status': report['status'], 'episodes': len(report['episodes']),
+                      'racket_executions': report['racket_executions'], 'finding': report['finding']}, sort_keys=True))
+
+
+if __name__ == '__main__':
+    main()
