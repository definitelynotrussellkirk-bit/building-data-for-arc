+#!/usr/bin/env python3
+"""Bounded source-bound learnability witness; production is not modified."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK = "9e47b59d6afc"
+
+
+def literal(grid):
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    root = find_root(__file__)
+    generator, source_path, source_hash = load_selected_generator(TASK, root=root)
+    programs = {json.loads(line)["program_solution"] for line in canonical_path(root).read_text().splitlines()
+                if json.loads(line).get("task_id") == TASK}
+    assert len(programs) == 1
+    canonical = programs.pop()
+    old_anchor = "(c0 (second bb))"
+    new_anchor = "(c0 (second (first (sort cells pt<))))"
+    assert canonical.count(old_anchor) == 1
+    rival = canonical.replace(old_anchor, new_anchor)
+    old_shapes = "    (define a (normalize (find-color g 2)))\n    (define b (normalize (find-color g 3)))"
+    new_shapes = """    (define a0 (normalize (find-color g 2)))
+    (define b0 (normalize (find-color g 3)))
+    (define cmin (apply min (map second (append a0 b0))))
+    (define a (map (lambda (p) (list (first p) (- (second p) cmin))) a0))
+    (define b (map (lambda (p) (list (first p) (- (second p) cmin))) b0))"""
+    assert rival.count(old_shapes) == 1
+    rival = rival.replace(old_shapes, new_shapes)
+    seed, difficulty = 4, "medium"
+    pairs = []
+    with RacketBridge(max_calls_before_restart=32) as bridge:
+        runtime_identity = bridge.runtime_identity
+        for index in range(4):
+            grid = generator.generate(seed, index, difficulty=difficulty)
+            errors = generator.self_check(grid)
+            assert not errors, errors
+            truth = bridge.eval_text(f"({wrap_rule(canonical)} {literal(grid)})")
+            other = bridge.eval_text(f"({wrap_rule(rival)} {literal(grid)})")
+            assert truth == generator.expected_output(grid)
+            pairs.append({"sample_index": index, "shape_profile": generator.observe_profile(grid),
+                          "input": grid, "output": truth, "rival_output": other,
+                          "same_output": truth == other})
+    assert [pair["same_output"] for pair in pairs] == [True, True, True, False]
+    existing_hook = generator.lesson_identifiable(pairs[:3], pairs[3])
+    assert existing_hook == []
+    record = {
+        "schema": "arcpuzzles-bounded-peer-learnability-v1", "task_id": TASK,
+        "assignment": "review-ca962006fdff3a56", "outcome": "teaching_gap_reproduced",
+        "source_sha256": source_hash, "rule_hash": generator.RULE_HASH,
+        "source_path": str(Path(source_path).relative_to(root)),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "command": "WORK/.venv/bin/python review.py run python3 generators/9e47b59d6afc/workspace/first_occupied_anchor_probe.py --out ../checks/9e47b59d6afc/first-occupied-anchor.json",
+        "seed": seed, "difficulty": difficulty, "demo_indices": [0, 1, 2], "query_index": 3,
+        "rival_name": "align_first_occupied_cells",
+        "rival_description": "Align each shape's lexicographically first occupied cell, then crop the union; canonical instead aligns independent bounding-box origins.",
+        "canonical_program": canonical, "rival_program": rival,
+        "program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "racket": {"backend": "racket", "protected": True, "runtime_identity": runtime_identity},
+        "train": pairs[:3], "test": [pairs[3]],
+        "all_labels_executed_in_racket": True,
+        "existing_lesson_identifiable_result": existing_hook,
+        "finding": "The first three ordinary generated demonstrations fit both rules; the next ordinary generated query differs. The current lesson hook does not declare this rival and reports no ambiguity.",
+        "next_repair": "Add this rival to the teaching contract and construct or select a demonstration whose topmost occupied cell is to the right of its bounding-box left edge; refute it before accepting a query on which it differs.",
+        "limits": ["One source-bound lesson and one additional rival; no prevalence or universal-identifiability claim.",
+                   "Production source is unchanged; this is retained reviewer evidence, not an integrated repair or approval."]}
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"outcome": record["outcome"], "source_sha256": source_hash,
+                      "demo_matches": 3, "query_differs": True,
+                      "canonical_query_output": pairs[3]["output"],
+                      "rival_query_output": pairs[3]["rival_output"], "evidence": str(args.out)}))
+
+
+if __name__ == "__main__":
+    main()
