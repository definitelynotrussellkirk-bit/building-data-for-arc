+    """Dropping disconnected main fragments must be visible to lesson checks."""
+    demos = [_labeled(20, index) for index in range(4)]
+    query = _labeled(20, 4)
+
+    rival = GEN.LESSON_COMPETITORS[
+        "keep only the largest connected main component"
+    ]
+    originals = deepcopy([*demos, query])
+
+    assert all(rival(pair["input"]) == pair["output"] for pair in demos)
+    assert rival(query["input"]) != query["output"]
+    assert [*demos, query] == originals
