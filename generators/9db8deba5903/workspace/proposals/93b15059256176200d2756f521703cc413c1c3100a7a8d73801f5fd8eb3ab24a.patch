+#!/usr/bin/env python3
+"""Source-bound radius-cap shortcut probe for efa31853b924."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from reviewer_support import canonical_path, find_root
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+TASK_ID = "efa31853b924"
+SEED = 47
+DIFFICULTY = "easy"
+SAMPLE_INDICES = (0, 1, 2)
+
+
+def _load_generator(root: Path):
+    path = root / "generators" / TASK_ID / "generator.py"
+    spec = importlib.util.spec_from_file_location("efa_radius_probe_generator", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module, path
+
+
+def _canonical(root: Path) -> str:
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(root).read_text().splitlines()
+        for row in [json.loads(line)]
+        if row.get("task_id") == TASK_ID and row.get("program_solution")
+    }
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def _motif_offsets(grid):
+    marker = {}
+    motif = []
+    for row, values in enumerate(grid):
+        for col, value in enumerate(values):
+            if value in (2, 3, 4):
+                marker[value] = (row, col)
+            elif value == 8:
+                motif.append((row, col))
+    origin = marker[2]
+    vx = (marker[3][0] - origin[0], marker[3][1] - origin[1])
+    vy = (marker[4][0] - origin[0], marker[4][1] - origin[1])
+    offsets = []
+    for row, col in motif:
+        dr, dc = row - origin[0], col - origin[1]
+        offsets.append((dr * vx[0] + dc * vx[1], dr * vy[0] + dc * vy[1]))
+    return sorted(offsets)
+
+
+def _literal(grid) -> str:
+    return "'(" + " ".join(
+        "(" + " ".join(map(str, row)) + ")" for row in grid
+    ) + ")"
+
+
+def _execute(bridge, program, grid):
+    return bridge.eval_text(f"({wrap_rule(program)} {_literal(grid)})")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    root = find_root(__file__)
+    generator, generator_path = _load_generator(root)
+    canonical = _canonical(root)
+    needle = "(extract-local-points g sf (list 8) 4)"
+    if canonical.count(needle) != 1:
+        raise AssertionError("canonical radius call changed")
+    rival = canonical.replace(needle, "(extract-local-points g sf (list 8) 2)")
+    grids = [
+        generator.generate(SEED, index, difficulty=DIFFICULTY)
+        for index in SAMPLE_INDICES
+    ]
+    offsets = [_motif_offsets(grid) for grid in grids]
+    radii = [max(max(abs(u), abs(v)) for u, v in points) for points in offsets]
+    if radii[:2] != [2, 2] or radii[2] != 3:
+        raise AssertionError((offsets, radii))
+
+    bridge = RacketBridge()
+    try:
+        canonical_outputs = [_execute(bridge, canonical, grid) for grid in grids]
+        rival_outputs = [_execute(bridge, rival, grid) for grid in grids]
+        runtime = bridge.runtime_identity
+    finally:
+        bridge.close()
+    matches = [a == b for a, b in zip(canonical_outputs, rival_outputs)]
+    if matches != [True, True, False]:
+        raise AssertionError(matches)
+
+    report = {
+        "schema": "arcpuzzles-peer-shortcut-probe-v1",
+        "task_id": TASK_ID,
+        "finding": "radius_2_cap_fits_two_demos_but_fails_radius_3_query",
+        "seed": SEED,
+        "difficulty": DIFFICULTY,
+        "sample_indices": list(SAMPLE_INDICES),
+        "motif_offsets": [[list(point) for point in points] for points in offsets],
+        "motif_radii": radii,
+        "rival_matches_canonical": matches,
+        "visible_lesson": {
+            "train": [
+                {"input": grids[index], "output": canonical_outputs[index]}
+                for index in (0, 1)
+            ],
+            "test": [{"input": grids[2]}],
+        },
+        "query_canonical_output": canonical_outputs[2],
+        "query_rival_output": rival_outputs[2],
+        "canonical_program": canonical,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "rival_program": rival,
+        "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "generator_path": str(generator_path.relative_to(root)),
+        "generator_sha256": hashlib.sha256(generator_path.read_bytes()).hexdigest(),
+        "runtime": runtime,
+        "repair_recommendation": (
+            "Without increasing the two-demo budget, constructively schedule at least one "
+            "visible demonstration containing a Chebyshev-radius-3 motif point whenever "
+            "the held-out query contains one."
+        ),
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "task_id": TASK_ID,
+        "finding": report["finding"],
+        "radii": radii,
+        "matches": matches,
+        "protected_racket": runtime.get("protected"),
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
