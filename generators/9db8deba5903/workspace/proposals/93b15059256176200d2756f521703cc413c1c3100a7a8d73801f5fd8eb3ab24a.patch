+#!/usr/bin/env python3
+"""Bounded source-bound lesson and Racket-parity probe for f3acfc6e19e1."""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root
+
+TASK_ID = "f3acfc6e19e1"
+BANDS = ("easy", "medium", "hard")
+SEEDS = (0, 1, 2, 3, 4)
+STARTS = (0, 2, 4, 6)
+
+
+def _load_generator(root: Path):
+    path = root / "generators" / TASK_ID / "generator.py"
+    spec = importlib.util.spec_from_file_location("f3_lesson_probe_generator", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module, path
+
+
+def _canonical(root: Path) -> str:
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(root).read_text().splitlines()
+        for row in [json.loads(line)]
+        if row.get("task_id") == TASK_ID and row.get("program_solution")
+    }
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join(
+        "(" + " ".join(map(str, row)) + ")" for row in grid
+    ) + ")"
+
+
+def _execute(bridge: RacketBridge, program: str, grid: list[list[int]]):
+    return bridge.eval_text(f"({wrap_rule(program)} {_literal(grid)})")
+
+
+def _pair(generator: Any, grid: list[list[int]]) -> dict[str, Any]:
+    return {"input": copy.deepcopy(grid), "output": generator.rule_mirror(grid)}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+
+    root = find_root(__file__)
+    generator, generator_path = _load_generator(root)
+    canonical = _canonical(root)
+
+    rival_refutations = {name: 0 for name in generator.LESSON_COMPETITORS}
+    query_differences = {name: 0 for name in generator.LESSON_COMPETITORS}
+    failures: list[dict[str, Any]] = []
+    lessons = 0
+    examples = 0
+    representative: dict[str, dict[str, Any]] = {}
+
+    for band_index, band in enumerate(BANDS):
+        for seed in SEEDS:
+            actual_seed = 630_000 + band_index * 10_000 + seed
+            for start in STARTS:
+                grids = [
+                    generator.generate(actual_seed, start + offset, difficulty=band)
+                    for offset in range(4)
+                ]
+                demos = [_pair(generator, grid) for grid in grids[:3]]
+                query = _pair(generator, grids[3])
+                reasons = generator.lesson_identifiable(demos, query)
+                if reasons:
+                    failures.append({
+                        "band": band,
+                        "seed": actual_seed,
+                        "start": start,
+                        "reasons": reasons,
+                    })
+                keys = {
+                    value
+                    for pair in demos
+                    for value in pair["input"][0]
+                    if value != 0
+                }
+                if keys != set(generator.CODES):
+                    failures.append({
+                        "band": band,
+                        "seed": actual_seed,
+                        "start": start,
+                        "reasons": [f"demonstration keys were {sorted(keys)}"],
+                    })
+                for name, rival in generator.LESSON_COMPETITORS.items():
+                    refuted = any(
+                        rival(pair["input"]) != pair["output"] for pair in demos
+                    )
+                    if refuted:
+                        rival_refutations[name] += 1
+                    else:
+                        failures.append({
+                            "band": band,
+                            "seed": actual_seed,
+                            "start": start,
+                            "reasons": [f"competitor survives: {name}"],
+                        })
+                    if rival(query["input"]) != query["output"]:
+                        query_differences[name] += 1
+                if band not in representative:
+                    representative[band] = {
+                        "seed": actual_seed,
+                        "sample_index": start + 3,
+                        "input": query["input"],
+                        "python_output": query["output"],
+                    }
+                lessons += 1
+                examples += 4
+
+    if failures:
+        raise AssertionError(json.dumps(failures[:5], sort_keys=True))
+
+    bridge = RacketBridge()
+    try:
+        runtime = bridge.runtime_identity
+        racket_checks = []
+        for band in BANDS:
+            case = representative[band]
+            racket_output = _execute(bridge, canonical, case["input"])
+            if racket_output != case["python_output"]:
+                raise AssertionError(f"Racket/Python mismatch for {band}")
+            racket_checks.append({
+                "band": band,
+                "seed": case["seed"],
+                "sample_index": case["sample_index"],
+                "matched": True,
+                "input": case["input"],
+                "output": racket_output,
+            })
+    finally:
+        bridge.close()
+
+    report = {
+        "schema": "arcpuzzles-peer-lesson-probe-v1",
+        "task_id": TASK_ID,
+        "outcome": "bounded_no_finding",
+        "scope": {
+            "bands": list(BANDS),
+            "seeds_per_band": len(SEEDS),
+            "starts_per_seed": list(STARTS),
+            "lessons": lessons,
+            "examples": examples,
+            "demonstrations_per_lesson": 3,
+            "queries_per_lesson": 1,
+        },
+        "lesson_failures": failures,
+        "rival_refutations": rival_refutations,
+        "rival_query_differences": query_differences,
+        "racket_checks": racket_checks,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "generator_path": str(generator_path.relative_to(root)),
+        "generator_sha256": hashlib.sha256(generator_path.read_bytes()).hexdigest(),
+        "runtime": runtime,
+        "limits": (
+            "This is a bounded schedule replay of the eight declared competitors, not "
+            "a proof against every possible shortcut or every seed/sample window."
+        ),
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "task_id": TASK_ID,
+        "outcome": report["outcome"],
+        "lessons": lessons,
+        "examples": examples,
+        "rivals": len(rival_refutations),
+        "racket_checks": len(racket_checks),
+        "protected_racket": runtime.get("protected"),
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
