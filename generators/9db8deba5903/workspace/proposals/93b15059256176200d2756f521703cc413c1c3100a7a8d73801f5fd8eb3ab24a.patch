+        "radius_histogram": radius_histogram,
+        "racket_checks": racket_checks,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "generator_path": str(generator_path.relative_to(root)),
+        "generator_sha256": hashlib.sha256(generator_path.read_bytes()).hexdigest(),
+        "runtime": runtime,
+        "limits": (
+            "The sweep proves the parity schedule over 60 sampled windows and directly "
+            "refutes the radius-2 Racket rival on three representatives; it is not an "
+            "exhaustive proof against every possible shortcut."
+        ),
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "task_id": TASK_ID,
+        "outcome": report["outcome"],
+        "lessons": lessons,
