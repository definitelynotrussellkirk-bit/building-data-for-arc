+            if canonical_output == rival_output:
+                raise AssertionError(f"radius-2 rival survived representative {band}")
+            racket_checks.append({
+                **case,
+                "canonical_output": canonical_output,
+                "rival_output": rival_output,
+                "rival_refuted": True,
+            })
+    finally:
+        bridge.close()
+
+    report = {
+        "schema": "arcpuzzles-peer-curriculum-probe-v1",
+        "task_id": TASK_ID,
+        "outcome": "repaired_shortcut_refuted",
+        "scope": {
+            "bands": list(BANDS),
+            "seeds_per_band": len(SEEDS),
+            "starts_per_seed": list(STARTS),
+            "lessons": lessons,
+            "examples": examples,
+            "demonstrations_per_lesson": 2,
+            "queries_per_lesson": 1,
+        },
