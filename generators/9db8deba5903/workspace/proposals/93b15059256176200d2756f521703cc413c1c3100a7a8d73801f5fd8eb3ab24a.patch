+#!/usr/bin/env python3
+"""Bounded post-repair curriculum probe for the radius-2 shortcut."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root
+
+TASK_ID = "efa31853b924"
+BANDS = ("easy", "medium", "hard")
+SEEDS = (0, 1, 2, 3, 4)
+STARTS = (0, 2, 4, 6)
+
+
+def _load_generator(root: Path):
+    path = root / "generators" / TASK_ID / "generator.py"
+    spec = importlib.util.spec_from_file_location("efa_radius_curriculum_generator", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module, path
+
+
+def _canonical(root: Path) -> str:
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(root).read_text().splitlines()
+        for row in [json.loads(line)]
+        if row.get("task_id") == TASK_ID and row.get("program_solution")
+    }
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def _motif_offsets(grid: list[list[int]]) -> list[tuple[int, int]]:
+    marker: dict[int, tuple[int, int]] = {}
+    motif: list[tuple[int, int]] = []
+    for row, values in enumerate(grid):
+        for col, value in enumerate(values):
+            if value in (2, 3, 4):
+                marker[value] = (row, col)
+            elif value == 8:
+                motif.append((row, col))
+    origin = marker[2]
+    vx = (marker[3][0] - origin[0], marker[3][1] - origin[1])
+    vy = (marker[4][0] - origin[0], marker[4][1] - origin[1])
+    return sorted(
+        (
+            (row - origin[0]) * vx[0] + (col - origin[1]) * vx[1],
+            (row - origin[0]) * vy[0] + (col - origin[1]) * vy[1],
+        )
+        for row, col in motif
+    )
+
+
+def _radius(grid: list[list[int]]) -> int:
+    return max(max(abs(u), abs(v)) for u, v in _motif_offsets(grid))
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join(
+        "(" + " ".join(map(str, row)) + ")" for row in grid
+    ) + ")"
+
+
+def _execute(bridge: RacketBridge, program: str, grid: list[list[int]]):
+    return bridge.eval_text(f"({wrap_rule(program)} {_literal(grid)})")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+
+    root = find_root(__file__)
+    generator, generator_path = _load_generator(root)
+    canonical = _canonical(root)
+    needle = "(extract-local-points g sf (list 8) 4)"
+    if canonical.count(needle) != 1:
+        raise AssertionError("canonical radius call changed")
+    rival = canonical.replace(needle, "(extract-local-points g sf (list 8) 2)")
+
+    failures: list[dict[str, Any]] = []
+    representatives: dict[str, dict[str, Any]] = {}
+    radius_histogram = {"1": 0, "2": 0, "3": 0}
+    lessons = 0
+    examples = 0
+
+    for band_index, band in enumerate(BANDS):
+        for seed in SEEDS:
+            actual_seed = 720_000 + band_index * 10_000 + seed
+            for start in STARTS:
+                grids = [
+                    generator.generate(actual_seed, start + offset, difficulty=band)
+                    for offset in range(3)
+                ]
+                radii = [_radius(grid) for grid in grids]
+                for radius in radii:
+                    radius_histogram[str(radius)] = radius_histogram.get(str(radius), 0) + 1
+                if 3 not in radii[:2]:
+                    failures.append({
+                        "band": band,
+                        "seed": actual_seed,
+                        "start": start,
+                        "demo_radii": radii[:2],
+                    })
+                if band not in representatives:
+                    index = next(i for i, radius in enumerate(radii[:2]) if radius == 3)
+                    representatives[band] = {
+                        "seed": actual_seed,
+                        "sample_index": start + index,
+                        "input": grids[index],
+                        "offsets": [list(point) for point in _motif_offsets(grids[index])],
+                    }
+                lessons += 1
+                examples += 3
+
+    if failures:
+        raise AssertionError(json.dumps(failures[:5], sort_keys=True))
+
+    bridge = RacketBridge()
+    try:
+        runtime = bridge.runtime_identity
+        racket_checks = []
+        for band in BANDS:
+            case = representatives[band]
+            canonical_output = _execute(bridge, canonical, case["input"])
