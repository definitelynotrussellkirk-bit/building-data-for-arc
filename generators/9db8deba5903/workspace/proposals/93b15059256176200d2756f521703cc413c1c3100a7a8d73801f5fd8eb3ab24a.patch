+from __future__ import annotations
+
+import importlib
+
+
+TASK_ID = "efa31853b924"
+GEN = importlib.import_module(f"puzzle_generators.per_puzzle.{TASK_ID}.generator")
+BANDS = ("easy", "medium", "hard")
+
+
+def _motif_radius(grid: list[list[int]]) -> int:
+    marker: dict[int, tuple[int, int]] = {}
+    motif: list[tuple[int, int]] = []
+    for row, values in enumerate(grid):
+        for col, value in enumerate(values):
+            if value in (2, 3, 4):
+                marker[value] = (row, col)
+            elif value == 8:
+                motif.append((row, col))
+    assert set(marker) == {2, 3, 4}
+    assert motif
+    origin = marker[2]
+    vx = (marker[3][0] - origin[0], marker[3][1] - origin[1])
+    vy = (marker[4][0] - origin[0], marker[4][1] - origin[1])
+    offsets = [
+        (
+            (row - origin[0]) * vx[0] + (col - origin[1]) * vx[1],
+            (row - origin[0]) * vy[0] + (col - origin[1]) * vy[1],
+        )
+        for row, col in motif
+    ]
+    return max(max(abs(u), abs(v)) for u, v in offsets)
+
+
+def test_every_two_demo_window_exposes_radius_three():
+    for band_index, band in enumerate(BANDS):
+        for seed in range(12):
+            actual_seed = 510_000 + band_index * 10_000 + seed
+            for start in range(8):
+                radii = [
+                    _motif_radius(
+                        GEN.generate(actual_seed, start + offset, difficulty=band)
+                    )
+                    for offset in range(2)
+                ]
+                assert 3 in radii, (band, actual_seed, start, radii)
