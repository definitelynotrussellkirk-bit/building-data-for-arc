+"""Replay this source-bound, unchanged-generator lesson counterexample."""
+from pathlib import Path
+import json
+from reviewer_support import find_root,load_selected_generator
+from arcpuzzles.parametric_worker import _local_imports,_real_evaluator
+ROOT=find_root(__file__)
+evidence=json.loads(Path(__file__).with_name('witness.json').read_text())
+gen,path,sha=load_selected_generator(evidence['task_id'],root=ROOT)
+if sha!=evidence['generator_sha256']:
+    raise ValueError('Generator changed; explicitly review/rebind this witness instead of reusing its verdict')
+case=evidence['witness']
+for i,pair in zip(case['sample_indices'],case['pairs']):
+    assert gen.generate(case['seed'],i,difficulty=case['difficulty'])==pair['input']
+    assert gen.self_check(pair['input'])==[]
+runtime=ROOT if (ROOT/'RUNTIME_MANIFEST.json').is_file() else ROOT/'shared/runtime'
+with _local_imports(runtime,runtime):
+    apply,identity,bridge=_real_evaluator(runtime)
+    try:
+        outputs=[(apply(evidence['canonical_program'],p['input']),apply(evidence['rival_program'],p['input'])) for p in case['pairs']]
+    finally:
+        bridge.close()
+assert all(a==p['output'] for (a,b),p in zip(outputs,case['pairs']))
+assert all(a==b for a,b in outputs[:3])
+assert outputs[3][1]==case['rival_query']
+differences=sum(a!=b for x,y in zip(*outputs[3]) for a,b in zip(x,y))
+assert differences==evidence['query_difference_cells']>0
+print(json.dumps({'status':'reproduced','task_id':evidence['task_id'],'generator_sha256':sha,'racket':identity,'evaluations':8,'query_difference_cells':differences,'source_changed':False},indent=2,sort_keys=True))
