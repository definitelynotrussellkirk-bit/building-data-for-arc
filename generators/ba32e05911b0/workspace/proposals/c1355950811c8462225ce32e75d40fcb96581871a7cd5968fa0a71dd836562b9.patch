+"""Bounded optional peer review; run through the packet's protected-Racket wrapper."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _real_evaluator
+from reviewer_support import load_selected_generator
+
+
+ROOT = Path(__file__).resolve().parents[3]
+TASK = 'a3a85fedfec1'
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    gen, source, source_hash = load_selected_generator(TASK, root=ROOT)
+    canonical = {
+        row['program_solution']
+        for line in (ROOT / 'shared/data/canonical/puzzles.jsonl').read_text().splitlines()
+        if (row := json.loads(line)).get('task_id') == TASK
+    }
+    assert len(canonical) == 1
+    program = canonical.pop()
+    rank_anchor = '(rank (priority (third seed)))'
+    choice_anchor = '(< rank best-priority)'
+    assert program.count(rank_anchor) == program.count(choice_anchor) == 1
+    rivals = {
+        'row_major_first_hit': program.replace(choice_anchor, '(not best)'),
+        'row_major_last_hit': program.replace(choice_anchor, '#t'),
+        'numeric_min_color': program.replace(rank_anchor, '(rank (third seed))'),
+        'numeric_max_color': program.replace(rank_anchor, '(rank (- 10 (third seed)))'),
+        'reverse_legend_priority': program.replace(
+            rank_anchor, '(rank (- 10 (priority (third seed))))'),
+        'numeric_order_from_header_direction': program.replace(
+            rank_anchor,
+            '(rank (if (< (first priority-colors) (second priority-colors)) '
+            '(third seed) (- 10 (third seed))))'),
+    }
+    apply, identity, bridge = _real_evaluator(ROOT / 'shared/runtime')
+    pairs, windows, evaluations = [], [], 0
+    try:
+        for seed, difficulty in ((9024, None), (9025, 'hard')):
+            offset = len(pairs)
+            for sample_index in range(5):
+                grid = gen.generate(seed, sample_index, difficulty=difficulty)
+                assert gen.self_check(grid) == gen.teaching_check(grid) == []
+                output = apply(program, grid)
+                evaluations += 1
+                assert output == gen.rule_mirror(grid)
+                predictions = {}
+                for name, rival in rivals.items():
+                    predictions[name] = apply(rival, grid)
+                    evaluations += 1
+                    if name in gen.LESSON_COMPETITORS:
+                        assert predictions[name] == gen.LESSON_COMPETITORS[name](grid)
+                pairs.append({'seed': seed, 'sample_index': sample_index,
+                              'difficulty': difficulty, 'input': grid, 'output': output,
+                              'rival_predictions': predictions})
+            for start in (0, 1):
+                demo_indices = list(range(offset + start, offset + start + 3))
+                query_index = offset + start + 3
+                cases = {}
+                for name in rivals:
+                    refuting = [i for i in demo_indices
+                                if pairs[i]['rival_predictions'][name] != pairs[i]['output']]
+                    changes_query = (pairs[query_index]['rival_predictions'][name]
+                                     != pairs[query_index]['output'])
+                    cases[name] = {'refuting_pair_indices': refuting,
+                                   'changes_query': changes_query,
+                                   'underidentified': not refuting and changes_query}
+                windows.append({'demo_pair_indices': demo_indices,
+                                'query_pair_index': query_index, 'rivals': cases})
+    finally:
+        bridge.close()
+    findings = [row for row in windows
+                if any(v['underidentified'] for v in row['rivals'].values())]
+    result = {
+        'task_id': TASK, 'outcome': 'finding' if findings else 'finite_no_finding',
+        'source_path': source.relative_to(ROOT).as_posix(),
+        'source_sha256': source_hash,
+        'reproducer_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        'program': program,
+        'program_sha256': hashlib.sha256(program.encode()).hexdigest(),
+        'rival_programs': rivals, 'racket': identity,
+        'racket_evaluations': evaluations, 'pairs': pairs, 'windows': windows,
+        'limits': [
+            'Only two seeds, ten ordinary generated scenes and four consecutive '
+            'three-demo/one-query windows were exercised; no full battery.',
+            'No parametric extension or canonical repair was attempted.',
+            'Generated legends are numerically ascending or descending. The '
+            'header-direction numeric rival survives these demonstrations but '
+            'also agrees on their queries; this is a coverage limitation, not '
+            'a demonstrated ambiguous generated lesson.',
+            'Finite tested rivals do not establish universal rule uniqueness.',
+        ],
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
+    print(json.dumps({'outcome': result['outcome'], 'pairs': len(pairs),
+                      'lesson_windows': len(windows), 'rivals': list(rivals),
+                      'racket_evaluations': evaluations, 'source_sha256': source_hash,
+                      'program_sha256': result['program_sha256'],
+                      'reproducer_sha256': result['reproducer_sha256'],
+                      'out': str(args.out)}, sort_keys=True))
+    return int(bool(findings))
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
