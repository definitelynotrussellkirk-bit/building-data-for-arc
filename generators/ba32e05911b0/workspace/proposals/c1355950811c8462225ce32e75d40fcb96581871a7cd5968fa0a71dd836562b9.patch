+"""Racket-backed regression for a demonstrated three-roll teaching shortcut."""
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from arcpuzzles.parametric_worker import _real_evaluator
+
+
+HOME = Path(__file__).resolve().parents[1]
+
+
+@pytest.mark.parametrize('direction', ['right', 'left'])
+def test_two_demonstrations_refute_three_roll_cap_before_four_roll_queries(direction):
+    path = HOME / 'workspace/parametric/adapter.py'
+    spec = importlib.util.spec_from_file_location('_rolling_adversarial_adapter', path)
+    adapter = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(adapter)
+    settings = {'direction': direction}
+    episode = adapter.generate(17, settings, demos=2, queries=4)
+
+    # A one-token mutation of the already executable cap-two rival is enough
+    # to reproduce the old lesson's gap, independently of the Python mirror.
+    capped = adapter.prototype.rival_program(settings, 'cap_2')
+    assert capped.count('(< rolls 2)') == 1
+    capped = capped.replace('(< rolls 2)', '(< rolls 3)')
+    apply, identity, bridge = _real_evaluator(HOME.parents[1] / 'shared/runtime')
+    try:
+        assert identity['backend'] == 'racket' and identity['protected'] is True
+        matches = {
+            split: [apply(capped, pair['input']) == pair['output']
+                    for pair in episode[split]]
+            for split in ('train', 'test')
+        }
+    finally:
+        bridge.close()
+
+    assert matches['test'] == [False, True, True, False]
+    assert not all(matches['train']), (
+        'A three-roll rule fits every visible demo but disagrees on queries 0 and 3: '
+        f'{settings=}, {matches=}'
+    )
