+"""Focused contract checks for the separate rolling-direction prototype."""
+import copy
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+
+
+def implementation():
+    path = HOME / 'workspace/parametric/adapter.py'
+    assert path.is_file(), 'the native parametric adapter has not been implemented'
+    spec = importlib.util.spec_from_file_location('_rolling_contract_adapter', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_default_is_exact_selected_canonical_text():
+    adapter = implementation()
+    root = HOME.parents[1]
+    canonical = {json.loads(line)['program_solution']
+                 for line in (root / 'shared/data/canonical/puzzles.jsonl').read_text().splitlines()
+                 if json.loads(line).get('task_id') == 'ba32e05911b0'}
+    assert canonical == {adapter.program({'direction': 'right'})}
+    assert adapter.program({'direction': 'left'}) not in canonical
+
+
+@pytest.mark.parametrize('demos,queries', [(2, 1), (2, 4), (3, 4), (6, 4)])
+def test_independent_counts_distinct_inputs_and_parameter_matched_sampling(demos, queries):
+    adapter = implementation()
+    right = adapter.generate(17, {'direction': 'right'}, demos, queries)
+    left = adapter.generate(17, {'direction': 'left'}, demos, queries)
+    assert len(right['train']) == demos and len(right['test']) == queries
+    inputs = [p['input'] for k in ('train', 'test') for p in right[k]]
+    assert len({json.dumps(g) for g in inputs}) == len(inputs)
+    assert inputs == [p['input'] for k in ('train', 'test') for p in left[k]]
+    assert any(a['output'] != b['output'] for a, b in zip(right['train'], left['train']))
+    assert min(map(len, inputs)) >= 18
+    assert all(22 <= len(g[0]) <= 30 and len(g) <= 30 for g in inputs)
+
+
+def test_first_query_public_bytes_ignore_future_queries_and_private_metadata():
+    adapter = implementation()
+    proto = adapter.prototype
+    short = adapter.generate(10, {'direction': 'left'}, 3, 1)
+    long = adapter.generate(10, {'direction': 'left'}, 3, 4)
+    first = proto.public_query_bytes(long, 0)
+    assert first == proto.public_query_bytes(short, 0)
+    changed = copy.deepcopy(long)
+    changed['settings'] = {'secret': 'changed'}
+    changed['seed'] = 999
+    changed['program_solution'] = 'private program changed'
+    changed['test'][0]['output'] = [[9]]
+    changed['test'][1:] = [{'input': [[9]], 'output': [[8]]}]
+    assert first == proto.public_query_bytes(changed, 0)
+    public = json.loads(first)
+    assert set(public) == {'train', 'test'}
+    assert len(public['test']) == 1 and set(public['test'][0]) == {'input'}
+
+
+@pytest.mark.parametrize('settings', [{}, {'direction': 'up'}, {'direction': True},
+                                     {'direction': 'right', 'extra': 1}, None])
+def test_bad_settings_rejected(settings):
+    with pytest.raises(ValueError):
+        implementation().program(settings)
+
+
+@pytest.mark.parametrize('seed,demos,queries', [(True, 3, 4), (-1, 3, 4), (2**63, 3, 4),
+                                             (0, 1, 4), (0, 7, 4), (0, True, 4),
+                                             (0, 3, 0), (0, 3, 5), (0, 3, 1.0)])
+def test_bad_requests_rejected_before_sampling(seed, demos, queries):
+    with pytest.raises(ValueError):
+        implementation().generate(seed, {'direction': 'right'}, demos, queries)
