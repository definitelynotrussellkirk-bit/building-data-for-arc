+#!/usr/bin/env python3
+"""Reproduce this prototype's bounded Racket/teaching/export evidence.
+
+Run through review.py run from the packet root; see README.md. This is an
+authoring check, not a replacement for native qualification or acceptance.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _grid, _real_evaluator
+from reviewer_support import find_root, load_selected_generator
+
+HOME = Path(__file__).resolve().parent
+_spec = importlib.util.spec_from_file_location('_ba32_exercise_adapter', HOME / 'adapter.py')
+adapter = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(adapter)
+p = adapter.prototype
+
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def write_json(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n')
+
+
+def exercise(out, seed):
+    out = Path(out)
+    if out.exists():
+        raise FileExistsError('use a new output directory')
+    root = find_root(__file__)
+    apply, identity, bridge = _real_evaluator(root / 'shared/runtime')
+    evaluations = 0
+
+    def execute(program, grid):
+        nonlocal evaluations
+        evaluations += 1
+        return _grid(apply(program, copy.deepcopy(grid)))
+
+    result = {'schema': 'ba32-rolling-exercise-v1', 'status': 'running',
+              'racket': identity, 'seed': seed,
+              'sources': {str(path.relative_to(root)): digest(path)
+                          for path in sorted(HOME.iterdir()) if path.suffix in ('.py', '.json', '.rkt')},
+              'episodes': [], 'boundary_requests': [], 'public_ids': [],
+              'scope': 'Fixed demonstrations; finite named rivals only. No arbitrary holdout rotations, owner acceptance, or training admission.'}
+    episodes, public = [], {}
+    try:
+        for direction in p.DIRECTIONS:
+            settings = {'direction': direction}
+            episode = adapter.generate(seed, settings, 2, 4)
+            pairs = episode['train'] + episode['test']
+            for pair in pairs:
+                assert execute(episode['program_solution'], pair['input']) == pair['output'], 'Racket/Python label mismatch'
+            row = {'settings': settings, 'counts': {'demos': 2, 'queries': 4},
+                   'program_sha256': hashlib.sha256(episode['program_solution'].encode()).hexdigest(),
+                   'shapes': [[len(x['input']), len(x['input'][0])] for x in pairs], 'rivals': []}
+            for name in p.RIVALS:
+                source = p.rival_program(settings, name)
+                actual = [execute(source, pair['input']) for pair in pairs]
+                assert actual == [p.mirror(pair['input'], settings, name) for pair in pairs], name
+                refuting = [i for i in range(2) if actual[i] != pairs[i]['output']]
+                disagreements = [i for i in range(4) if actual[i + 2] != pairs[i + 2]['output']]
+                assert refuting, f'{direction}/{name} not distinguished by the two demos'
+                row['rivals'].append({'name': name, 'program': source,
+                                      'program_sha256': hashlib.sha256(source.encode()).hexdigest(),
+                                      'refuting_demos': refuting, 'query_disagreements': disagreements})
+            short = adapter.generate(seed, settings, 2, 1)
+            assert p.public_query_bytes(short) == p.public_query_bytes(episode)
+            changed = copy.deepcopy(episode)
+            changed['settings'], changed['seed'], changed['program_solution'] = {}, -1, 'changed'
+            changed['test'][0]['output'] = [[9]]
+            changed['test'][1:] = [{'input': [[9]], 'output': [[9]]}]
+            assert p.public_query_bytes(changed) == p.public_query_bytes(episode)
+            for index in range(4):
+                raw = p.public_query_bytes(episode, index)
+                identifier = hashlib.sha256(raw).hexdigest()
+                assert identifier not in public
+                public[identifier] = raw
+            stress = episode['test'][3]['input']
+            _, traces, _ = p.trace(stress, settings)
+            orange = [(r, c) for r, values in enumerate(stress) for c, v in enumerate(values) if v == 7]
+            row['stress'] = {'shape': [30, 30], 'orange_cells': len(orange),
+                             'orange_bounds': [min(r for r, c in orange), max(r for r, c in orange),
+                                               min(c for r, c in orange), max(c for r, c in orange)],
+                             'markers': len(traces),
+                             'rolls_per_marker': [sum(e['kind'] == 'roll' for e in t['events']) for t in traces]}
+            assert len(orange) >= 198 and row['stress']['markers'] == 3
+            assert row['stress']['rolls_per_marker'] == [4, 4, 4]
+            result['episodes'].append(row)
+            episodes.append(episode)
+
+        # Count boundaries and large seed bounds; every retained request is also Racket-labeled.
+        for direction in p.DIRECTIONS:
+            for request_seed, demos, queries in ((0, 2, 1), (2**63 - 1, 6, 4)):
+                settings = {'direction': direction}
+                episode = adapter.generate(request_seed, settings, demos, queries)
+                for pair in episode['train'] + episode['test']:
+                    assert execute(episode['program_solution'], pair['input']) == pair['output']
+                result['boundary_requests'].append({'seed': request_seed, 'settings': settings,
+                    'demos': demos, 'queries': queries, 'status': 'passed'})
+
+        # Reproduce the existing production teaching gap without changing its approved source.
+        canonical, path, source_hash = load_selected_generator('ba32e05911b0', root=root)
+        grids = [canonical.generate(10, i, difficulty='medium') for i in range(4)]
+        outputs = [execute(p.CANONICAL, grid) for grid in grids]
+        source = p.rival_program({'direction': 'right'}, 'no_roll')
+        wrong = [execute(source, grid) for grid in grids]
+        assert wrong[:3] == outputs[:3] and wrong[3] != outputs[3]
+        old = {'train': [{'input': g, 'output': o} for g, o in zip(grids[:3], outputs[:3])],
+               'test': [{'input': grids[3], 'output': outputs[3]}]}
+        try:
+            p.teaching_check(old, {'direction': 'right'})
+        except ValueError as error:
+            rejection = str(error)
+        else:
+            raise AssertionError('teaching guard accepted the known underidentified lesson')
+        result['production_gap'] = {'generator_sha256': source_hash, 'seed': 10,
+            'difficulty': 'medium', 'sample_indices': [0, 1, 2, 3],
+            'profiles': [canonical.observe_overrides(g)['scene_profile'] for g in grids],
+            'lesson': old, 'rival_program': source, 'rival_query_output': wrong[3],
+            'query_different_cells': sum(a != b for ra, rb in zip(wrong[3], outputs[3]) for a, b in zip(ra, rb)),
+            'prototype_guard_rejection': rejection,
+            'scope': 'Existing canonical sampler remains unchanged and this audit remains open; new native parametric lessons are repaired.'}
+        result['status'] = 'passed'
+        result['racket_evaluations'] = evaluations
+        result['public_ids'] = list(public)
+        result['success_rate'] = {'requests': 6, 'successes': 6, 'failures': 0,
+            'description': 'Two 2-demo/4-query lessons plus four explicit count/seed boundary requests; not a population estimate.'}
+        out.mkdir(parents=True)
+        (out / 'public').mkdir()
+        for identifier, raw in public.items():
+            (out / 'public' / (identifier + '.json')).write_bytes(raw)
+        write_json(out / 'episodes.private.json', episodes)
+        write_json(out / 'report.json', result)
+        return {'status': result['status'], 'racket_evaluations': evaluations,
+                'rivals_per_setting': len(p.RIVALS), 'public_single_query_files': len(public),
+                'boundary_requests': len(result['boundary_requests']),
+                'canonical_gap_different_cells': result['production_gap']['query_different_cells'],
+                'out': str(out)}
+    finally:
+        bridge.close()
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--seed', type=int, default=17)
+    args = parser.parse_args()
+    print(json.dumps(exercise(args.out, args.seed), sort_keys=True))
