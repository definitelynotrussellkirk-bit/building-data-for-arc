+"""Replay one consecutive three-demo orientation ambiguity through protected Racket.
+
+From the outer packet directory:
+  WORK/.venv/bin/python review.py run python generators/39ad03f74acb/workspace/reproduce_orientation.py
+
+Only seed 1, difficulty medium, indices 0..3 are evaluated. No source is edited.
+"""
+from __future__ import annotations
+
+import argparse
+import datetime
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+sys.path[:0] = [str(ROOT / 'src'), str(ROOT / 'shared/runtime')]
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = '39ad03f74acb'
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def packed(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':')).encode()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path,
+                        default=ROOT.parent / 'checks' / TASK / 'orientation-lesson.json')
+    args = parser.parse_args()
+    source = ROOT / 'generators' / TASK / 'generator.py'
+    source_sha = digest(source.read_bytes())
+    selected = []
+    with (ROOT / 'shared/data/canonical/puzzles.jsonl').open('rb') as handle:
+        for line_number, raw in enumerate(handle, 1):
+            row = json.loads(raw)
+            if row.get('task_id') == TASK:
+                selected.append((line_number, digest(raw), row))
+    programs = {row['program_solution'] for _, _, row in selected}
+    if len(programs) != 1:
+        raise ValueError('Expected one unambiguous canonical program')
+    reference = next(iter(programs))
+    anchor = '(and left right (not up) (not down))'
+    if reference.count(anchor) != 1:
+        raise ValueError('Canonical orientation mutation anchor changed')
+    rival = reference.replace(anchor, '#f')
+    result = {
+        'schema': 'arcpuzzles-bounded-orientation-lesson-v1', 'task_id': TASK,
+        'created_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+        'scope': {'seed': 1, 'difficulty': 'medium', 'sample_indices': [0, 1, 2, 3],
+                  'demonstrations': [0, 1, 2], 'query': 3, 'rivals': ['vertical_only'],
+                  'racket_evaluations': 8, 'search': 'Python orientation prescreen stopped at seed 1 after seeds 0 and 1.'},
+        'source_sha256': {
+            str(source.relative_to(ROOT)): source_sha,
+            str(Path(__file__).resolve().relative_to(ROOT)): digest(Path(__file__).read_bytes()),
+            'src/arcpuzzles/parametric_worker.py': digest((ROOT / 'src/arcpuzzles/parametric_worker.py').read_bytes()),
+            'shared/runtime/puzzle_generators/rule_wrap.py': digest((ROOT / 'shared/runtime/puzzle_generators/rule_wrap.py').read_bytes()),
+        },
+        'canonical_authority': [{'line': n, 'raw_line_sha256': sha} for n, sha, _ in selected],
+        'programs': {
+            'reference': {'source': reference, 'sha256': digest(reference.encode())},
+            'vertical_only': {'source': rival, 'sha256': digest(rival.encode()),
+                              'meaning': 'Recolor only strict vertical blue interiors; leave horizontal segments unchanged.'},
+        },
+        'command': 'WORK/.venv/bin/python review.py run python generators/39ad03f74acb/workspace/reproduce_orientation.py',
+        'outer_cwd': str(ROOT.parent.parent), 'payload_cwd': str(ROOT),
+        'pairs': [],
+        'limits': ['One emitted consecutive lesson and one plausible orientation-specific rival.',
+                   'This is a generated teaching ambiguity, not a claim that the rival fits all canonical pairs.',
+                   'No full battery, parameter extension, broader prevalence estimate, or generator repair.'],
+    }
+    with _local_imports(ROOT / 'shared/runtime', source.parent):
+        spec = importlib.util.spec_from_file_location('_orientation_review_39ad', source)
+        generator = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(generator)
+        result['examples_needed_declaration'] = getattr(generator, 'EXAMPLES_NEEDED', None)
+        apply, _, bridge = _real_evaluator(ROOT / 'shared/runtime')
+        result['runtime_identity'] = bridge.runtime_identity
+        try:
+            for index in range(4):
+                grid = generator.generate(1, index, difficulty='medium')
+                errors = generator.self_check(grid, difficulty='medium')
+                expected = apply(reference, grid)
+                alternative = apply(rival, grid)
+                differences = [
+                    {'row': r, 'col': c, 'reference': expected[r][c], 'rival': alternative[r][c]}
+                    for r in range(len(grid)) for c in range(len(grid[0]))
+                    if expected[r][c] != alternative[r][c]
+                ]
+                horizontal = sum(grid[r][c] == grid[r][c + 1] == 1
+                                 for r in range(len(grid)) for c in range(len(grid[0]) - 1))
+                vertical = sum(grid[r][c] == grid[r + 1][c] == 1
+                               for r in range(len(grid) - 1) for c in range(len(grid[0])))
+                result['pairs'].append({
+                    'sample_index': index, 'role': 'demo' if index < 3 else 'query',
+                    'input': grid, 'reference_output': expected, 'rival_output': alternative,
+                    'input_sha256': digest(packed(grid)), 'self_check_errors': errors,
+                    'horizontal_blue_neighbor_pairs': horizontal,
+                    'vertical_blue_neighbor_pairs': vertical,
+                    'matches': not differences, 'difference_count': len(differences),
+                    'differences': differences,
+                })
+        finally:
+            bridge.close()
+    if digest(source.read_bytes()) != source_sha:
+        raise ValueError('Generator source changed during execution')
+    checks = {
+        'protected_racket': result['runtime_identity'].get('protected') is True,
+        'all_inputs_self_check': all(not pair['self_check_errors'] for pair in result['pairs']),
+        'three_distinct_demonstrations_and_distinct_query': len({p['input_sha256'] for p in result['pairs']}) == 4,
+        'rival_fits_every_demo': all(pair['matches'] for pair in result['pairs'][:3]),
+        'rival_disagrees_on_query': not result['pairs'][3]['matches'],
+        'source_unchanged': True,
+    }
+    result['checks'] = checks
+    result['status'] = 'reproduced_ambiguity' if all(checks.values()) else 'not_reproduced'
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
+    print(json.dumps({'status': result['status'], 'checks': checks,
+                      'query_difference_count': result['pairs'][3]['difference_count'],
+                      'evidence': str(args.out), 'evidence_sha256': digest(args.out.read_bytes()),
+                      'generator_sha256': source_sha}, indent=2))
+    if not all(checks.values()):
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
