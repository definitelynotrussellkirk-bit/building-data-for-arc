(rule!
  (let ((dummy 0))
    (define (points-of grid color)
      (sort (find-color grid color) cell<))
    (define (color-groups grid)
      (map (lambda (color) (list color (points-of grid color)))
           (grid-colors grid 0)))
    (define (aligned? p q)
      (or (= (first p) (first q))
          (= (second p) (second q))
          (= (abs (- (first p) (first q)))
             (abs (- (second p) (second q))))))
    (define groups (color-groups g))
    (define points (map (lambda (entry) (first (second entry))) groups))
    (define n (length groups))
    (define (neighbors i)
      (filter (lambda (j) (aligned? (list-ref points i) (list-ref points j)))
              (range 0 n)))
    (define (expand seen)
      (let* ((reached (apply append (map neighbors seen)))
             (next (remove-duplicates (append seen reached))))
        (if (= (length next) (length seen))
            seen
            (expand next))))
    (define anchor-component (expand (list 0)))
    (grid-from-fn n n
      (lambda (i j)
        (if (and (member? i anchor-component)
                 (member? j anchor-component))
            8
            0)))))
