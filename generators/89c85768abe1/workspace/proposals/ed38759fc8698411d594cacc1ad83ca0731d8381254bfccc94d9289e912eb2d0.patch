+"""Regressions for unseen transform-key semantics in otherwise lawful lessons."""
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "shared/runtime"))
+from reviewer_support import load_selected_generator
+
+
+def test_formerly_admitted_three_demo_unseen_key_lesson_is_rejected():
+    generator, _, _ = load_selected_generator("9fc0b6db96fe", root=ROOT)
+    pairs = [{"input": generator.generate(2, index, difficulty="hard")} for index in range(4)]
+    for pair in pairs:
+        pair["output"] = generator.reference_output(pair["input"])
+    assert [pair["input"][0][0] for pair in pairs] == [1, 3, 2, 4]
+    assert generator.lesson_identifiable(pairs[:3], pairs[3])
+
+
+def test_four_demonstrations_still_reject_a_query_key_absent_from_them():
+    generator, _, _ = load_selected_generator("9fc0b6db96fe", root=ROOT)
+    pairs = [{"input": generator.generate(17, index, difficulty="hard", key=key)}
+             for index, key in enumerate((1, 2, 3, 1, 4))]
+    for pair in pairs:
+        pair["output"] = generator.reference_output(pair["input"])
+    reasons = generator.lesson_identifiable(pairs[:4], pairs[4])
+    assert any("query key" in reason and "demonstration" in reason for reason in reasons)
