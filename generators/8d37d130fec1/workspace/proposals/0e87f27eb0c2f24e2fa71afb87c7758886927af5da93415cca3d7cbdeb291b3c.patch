+#!/usr/bin/env python3
+"""Source-bound learnability audit for the repaired ``abbeda7fe821`` generator.
+
+The probe executes the selected canonical Racket program against canonical and
+generated inputs, checks the repaired curriculum against two retained geometry
+rivals, rotates every three-profile lesson, and audits the public control
+contract.  It intentionally preserves the two counterexamples that motivated
+the repair.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+TASK_ID = "abbeda7fe821"
+REPAIRED_FROM_SHA256 = "45b780e15e083b171a3a3750ad932dd5939e286b54e2bf9369cf7ac6a79a3394"
+ROOT = find_root(__file__)
+GEN, GENERATOR_PATH, GENERATOR_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _program() -> str:
+    programs = set()
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID and isinstance(row.get("program_solution"), str):
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise ValueError(f"expected one selected program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def _anchors(grid: list[list[int]]) -> list[tuple[int, int]]:
+    return [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 2]
+
+
+def _stamp(
+    grid: list[list[int]], *, interior_only: bool = False, lattice_only: bool = False
+) -> list[list[int]]:
+    out = copy.deepcopy(grid)
+    height, width = len(grid), len(grid[0])
+    for r, c in _anchors(grid):
+        if interior_only and not (0 < r < height - 1 and 0 < c < width - 1):
+            continue
+        if lattice_only and not (r % 3 == 1 and c % 3 == 1):
+            continue
+        for dr, dc in ((-1, -1), (-1, 1), (1, -1), (1, 1)):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < height and 0 <= cc < width:
+                out[rr][cc] = 7
+    return out
+
+
+def _grid(height: int, width: int, anchors: list[tuple[int, int]]) -> list[list[int]]:
+    result = [[0] * width for _ in range(height)]
+    for r, c in anchors:
+        result[r][c] = 2
+    return result
+
+
+def _hash_grid(grid: list[list[int]]) -> str:
+    body = json.dumps(grid, separators=(",", ":"), ensure_ascii=False).encode()
+    return hashlib.sha256(body).hexdigest()
+
+
+def _control_findings() -> list[str]:
+    findings: list[str] = []
+    expected_axes = {"grid_h", "grid_w", "n_anchors", "texture"}
+    if set(GEN.AXES) != expected_axes:
+        findings.append(f"declared axes {sorted(GEN.AXES)} != {sorted(expected_axes)}")
+
+    for texture in GEN.TEXTURES:
+        expected = {
+            "grid_h": 10,
+            "grid_w": 9,
+            "n_anchors": 4,
+            "texture": texture,
+        }
+        try:
+            grid = GEN.generate(99173, 7, difficulty="medium", **expected)
+            observed = GEN.observe_overrides(grid)
+        except Exception as exc:
+            findings.append(f"exact controls failed for {texture}: {type(exc).__name__}: {exc}")
+        else:
+            if observed != expected:
+                findings.append(f"exact controls for {texture}: observed {observed}, expected {expected}")
+
+    try:
+        GEN.generate(99173, 7, difficulty="medium", unknown_control=1)
+    except (TypeError, ValueError):
+        pass
+    except Exception as exc:
+        findings.append(f"unknown control raised unexpected {type(exc).__name__}: {exc}")
+    else:
+        findings.append("unknown control was accepted")
+    return findings
+
+
+def run_probe(seed_count: int = 6) -> dict:
+    if type(seed_count) is not int or not 1 <= seed_count <= 32:
+        raise ValueError("seed_count must be an exact integer in 1..32")
+
+    program = _program()
+    canonical = canonical_pairs(TASK_ID, root=ROOT)
+    generated: list[dict] = []
+    lesson_findings: list[dict] = []
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in range(seed_count):
+            lesson = []
+            for sample_index in range(3):
+                grid = GEN.generate(seed, sample_index, difficulty=difficulty)
+                item = {
+                    "difficulty": difficulty,
+                    "seed": seed,
+                    "sample_index": sample_index,
+                    "input": grid,
+                    "output": None,
+                }
+                generated.append(item)
+                lesson.append(item)
+            for query_index, query in enumerate(lesson):
+                demos = [pair for index, pair in enumerate(lesson) if index != query_index]
+                # Fill labels from the Python mirror here; protected-Racket parity
+                # below independently checks every one of these labels.
+                labeled_demos = [
+                    {"input": pair["input"], "output": GEN.rule_mirror(pair["input"])}
+                    for pair in demos
+                ]
+                labeled_query = {
+                    "input": query["input"],
+                    "output": GEN.rule_mirror(query["input"]),
+                }
+                reasons = GEN.lesson_identifiable(labeled_demos, labeled_query)
+                if reasons:
+                    lesson_findings.append(
+                        {
+                            "difficulty": difficulty,
+                            "seed": seed,
+                            "query_index": query_index,
+                            "reasons": reasons,
+                        }
+                    )
+
+    boundary_input = _grid(6, 6, [(0, 0), (4, 4)])
+    off_lattice_input = _grid(6, 6, [(2, 2), (4, 4)])
+    parity_failures: list[dict] = []
+    canonical_self_check_failures: list[dict] = []
+    runtime = ROOT / "shared/runtime"
+    with _local_imports(runtime, Path(GENERATOR_PATH).parent):
+        apply, racket_identity, bridge = _real_evaluator(runtime)
+        try:
+            for index, pair in enumerate(canonical):
+                errors = GEN.self_check(pair["input"])
+                if errors:
+                    canonical_self_check_failures.append({"index": index, "errors": errors})
+                actual = apply(program, pair["input"])
+                if actual != pair["output"] or GEN.rule_mirror(pair["input"]) != pair["output"]:
+                    parity_failures.append({"scope": "canonical", "index": index})
+            for index, item in enumerate(generated):
+                actual = apply(program, item["input"])
+                expected = GEN.rule_mirror(item["input"])
+                item["output"] = actual
+                if actual != expected:
+                    parity_failures.append({"scope": "generated", "index": index})
+            boundary_output = apply(program, boundary_input)
+            off_lattice_output = apply(program, off_lattice_input)
+        finally:
+            bridge.close()
+
+    rivals = {
+        "interior_only": lambda grid: _stamp(grid, interior_only=True),
+        "fixed_step3_lattice": lambda grid: _stamp(grid, lattice_only=True),
+    }
+    survivors: list[str] = []
+    rival_fit_counts: dict[str, int] = {}
+    for name, rival in rivals.items():
+        count = sum(rival(item["input"]) == item["output"] for item in generated)
+        rival_fit_counts[name] = count
+        if count == len(generated):
+            survivors.append(name)
+
+    generated_anchor_positions = {
+        position for item in generated for position in _anchors(item["input"])
+    }
+    all_generated_interior = all(
+        0 < r < len(item["input"]) - 1 and 0 < c < len(item["input"][0]) - 1
+        for item in generated
+        for r, c in _anchors(item["input"])
+    )
+    all_generated_on_lattice = all(
+        r % 3 == 1 and c % 3 == 1
+        for item in generated
+        for r, c in _anchors(item["input"])
+    )
+
+    witnesses = {
+        "boundary": {
+            "input": boundary_input,
+            "input_sha256": _hash_grid(boundary_input),
+            "official_output": boundary_output,
+            "interior_only_output": rivals["interior_only"](boundary_input),
+        },
+        "off_lattice": {
+            "input": off_lattice_input,
+            "input_sha256": _hash_grid(off_lattice_input),
+            "official_output": off_lattice_output,
+            "fixed_step3_lattice_output": rivals["fixed_step3_lattice"](off_lattice_input),
+        },
+    }
+    contract_findings = _control_findings()
+    findings: list[str] = []
+    if canonical_self_check_failures:
+        findings.append("canonical inputs fall outside the repaired strict domain")
+    if parity_failures:
+        findings.append("Python mirror or generated labels disagree with protected Racket")
+    if survivors:
+        findings.append("retained geometry rivals survive the generated census")
+    if lesson_findings:
