+from __future__ import annotations
+
+import copy
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+TASK_ID = "abbeda7fe821"
+ROOT = find_root(__file__)
+GEN, _SOURCE, _SHA = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _anchors(grid):
+    return [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 2]
+
+
+def _expected(grid):
+    out = copy.deepcopy(grid)
+    h, w = len(grid), len(grid[0])
+    for r, c in _anchors(grid):
+        for dr, dc in ((-1, -1), (-1, 1), (1, -1), (1, 1)):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                out[rr][cc] = 7
+    return out
+
+
+def _pair(grid):
+    return {"input": grid, "output": GEN.rule_mirror(grid)}
+
+
+def test_canonical_pairs_and_rule_mirror_are_exact():
+    assert GEN.VERSION == "2.1.0"
+    pairs = canonical_pairs(TASK_ID, root=ROOT)
+    assert len(pairs) == 5
+    for pair in pairs:
+        assert GEN.self_check(pair["input"]) == []
+        assert GEN.strict_canonical_like(pair["input"]) == []
+        assert GEN.rule_mirror(pair["input"]) == pair["output"] == _expected(pair["input"])
+
+
+def test_three_profile_schedule_covers_boundary_and_off_lattice_geometry():
+    assert GEN.TEXTURES == ("corner_boundary", "edge_boundary", "interior_off_lattice")
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in range(8):
+            profiles = []
+            for sample_index in range(9):
+                grid = GEN.generate(seed, sample_index, difficulty=difficulty)
+                anchors = _anchors(grid)
+                observed = GEN.observe_overrides(grid)
+                profiles.append(observed["texture"])
+                assert observed["grid_h"] == len(grid)
+                assert observed["grid_w"] == len(grid[0])
+                assert observed["n_anchors"] == len(anchors)
+                assert 2 <= len(anchors) <= 4
+                assert any(not (r % 3 == 1 and c % 3 == 1) for r, c in anchors)
+                assert all(
+                    not (abs(r1 - r2) == 1 and abs(c1 - c2) == 1)
+                    for i, (r1, c1) in enumerate(anchors)
+                    for r2, c2 in anchors[i + 1 :]
+                )
+                assert GEN.self_check(grid) == []
+                assert GEN.rule_mirror(grid) == _expected(grid)
+                if observed["texture"] == "corner_boundary":
+                    assert any(r in (0, len(grid) - 1) and c in (0, len(grid[0]) - 1) for r, c in anchors)
+                elif observed["texture"] == "edge_boundary":
+                    assert not any(r in (0, len(grid) - 1) and c in (0, len(grid[0]) - 1) for r, c in anchors)
+                    assert any(r in (0, len(grid) - 1) or c in (0, len(grid[0]) - 1) for r, c in anchors)
+                else:
+                    assert all(0 < r < len(grid) - 1 and 0 < c < len(grid[0]) - 1 for r, c in anchors)
+            assert profiles == [GEN.TEXTURES[i % 3] for i in range(9)]
+
+
+def test_any_two_consecutive_demonstrations_refute_declared_geometry_rivals():
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in range(5):
+            for start in range(3):
+                pairs = [_pair(GEN.generate(seed, start + offset, difficulty=difficulty)) for offset in range(3)]
+                for query_index, query in enumerate(pairs):
+                    demos = [pair for index, pair in enumerate(pairs) if index != query_index]
+                    assert GEN.lesson_identifiable(demos, query) == []
+
+
+def test_exact_controls_and_invalid_requests():
+    explicit = GEN.generate(
+        17,
+        5,
+        difficulty="medium",
+        grid_h=10,
+        grid_w=9,
+        n_anchors=4,
+        texture="edge_boundary",
+    )
+    assert GEN.observe_overrides(explicit) == {
+        "grid_h": 10,
+        "grid_w": 9,
+        "n_anchors": 4,
+        "texture": "edge_boundary",
+    }
+    assert explicit == GEN.generate(
+        17,
+        5,
+        difficulty="medium",
+        grid_h=10,
+        grid_w=9,
+        n_anchors=4,
+        texture="edge_boundary",
+    )
+    for kwargs in (
+        {"unknown_control": 1},
+        {"grid_h": True},
+        {"grid_w": 10.0},
+        {"n_anchors": "3"},
+        {"grid_h": 5},
+        {"grid_w": 11},
+        {"n_anchors": 1},
+        {"texture": "warm"},
+    ):
+        with pytest.raises((TypeError, ValueError)):
+            GEN.generate(1, 2, **kwargs)
+    for seed, sample_index in ((True, 0), (1.0, 0), ("1", 0), (1, True), (1, 1.0), (1, "1"), (1, -1)):
+        with pytest.raises(ValueError):
+            GEN.generate(seed, sample_index)
+    with pytest.raises(ValueError):
+        GEN.generate(1, 2, difficulty="extreme")
