+        expected = rule_mirror(demo["input"])
+        if demo["output"] != expected:
+            reasons.append(f"demo {index} output does not match the pinned rule")
+        for name, rival in LESSON_COMPETITORS.items():
+            if rival(demo["input"]) != expected:
