(rule! (lambda (g)
         (let ((h (rows g))
               (w (cols g)))
           (let ((zeros (filter (lambda (p) (zero? (at g (first p) (second p))))
                                (reduce append
                                        (list)
                                        (map (lambda (r)
                                               (map (lambda (c) (list r c)) (range 0 w)))
                                             (range 0 h))))))
             (reduce (lambda (acc pos)
                       (let ((zr (first pos))
                             (zc (second pos)))
                         (let ((color (let ((nbrs (filter (lambda (d)
                                                            (let ((nr (+ zr (first d)))
                                                                  (nc (+ zc (second d))))
                                                              (and
                                                                (>= nr 0)
                                                                (< nr h)
                                                                (>= nc 0)
                                                                (< nc w)
                                                                (not (zero? (at g nr nc))))))
                                                          (list (list -1 0)
                                                                (list 1 0)
                                                                (list 0 -1)
                                                                (list 0 1)))))
                                        (if (empty? nbrs)
                                            #f
                                            (let ((d (first nbrs)))
                                              (at g (+ zr (first d)) (+ zc (second d))))))))
                           (if (not color)
                               acc
                               (let ((row-ext (length (filter (lambda (c)
                                                                (let ((v (at g zr c)))
                                                                  (or
                                                                    (= v color)
                                                                    (zero? v))))
                                                              (range 0 w))))
                                     (col-ext (length (filter (lambda (r)
                                                                (let ((v (at g r zc)))
                                                                  (or
                                                                    (= v color)
                                                                    (zero? v))))
                                                              (range 0 h)))))
                                 (if (> row-ext col-ext)
                                     (reduce (lambda (gg r) (set-cell gg r zc 0))
                                             acc
                                             (filter (lambda (r)
                                                       (let ((v (at g r zc)))
                                                         (or (= v color) (zero? v))))
                                                     (range 0 h)))
                                     (reduce (lambda (gg c) (set-cell gg zr c 0))
                                             acc
                                             (filter (lambda (c)
                                                       (let ((v (at g zr c)))
                                                         (or (= v color) (zero? v))))
                                                     (range 0 w)))))))))
                     g
                     zeros)))))
