+def _source_hashes():
+    paths = {p for p in HERE.rglob("*") if p.is_file() and p.suffix in {".py", ".rkt", ".json"}
+             and not {"evidence", "examples", "__pycache__"}.intersection(p.relative_to(HERE).parts)}
