+"""Replay one bounded, ordinary-draw quadrant-threshold teaching witness.
+
+Run through the packet wrapper. This does not invoke the public worker or
+change the generator, authority, lesson checker, or historical dispositions.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator, public_challenge_id
+
+
+TASK = "637229802e6f"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+EXPECTED_SOURCE = "21ab150fecd7bb6f62ca9914f873a6efb87dfb7698e61711844070b36ae4f519"
+EXPECTED_PROGRAM = "c154985bdefa9fb7d3d0d8cdaef76d620698f0f29de2062b3943baef10653b69"
+EXPECTED_RULE = "315e7341b297"
+DEMO_KEYS = ((0, 0), (0, 2), (17, 2))
+QUERY_KEY = (0, 4)
+GUARD_KEY = (17, 0)
+
+
+def digest(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def grid_digest(grid) -> str:
+    return digest(json.dumps(grid, separators=(",", ":")).encode())
+
+
+def marker(grid):
+    cells = [(r, c) for r, row in enumerate(grid)
+             for c, value in enumerate(row) if value == 2]
+    assert len(cells) == 1
+    return cells[0]
+
+
+def threshold_output(grid, row_cut=2, column_cut=2):
+    """Python discovery aid only; retained labels are separately executed."""
+    mr, mc = marker(grid)
+    return [[2 if ((r < 2) == (mr < row_cut)
+                   and (c < 2) == (mc < column_cut)) else 6
+             for c in range(4)] for r in range(4)]
+
+
+def changes(left, right):
+    return [{"row": r, "column": c, "intended": a, "rival": b}
+            for r, (ra, rb) in enumerate(zip(left, right))
+            for c, (a, b) in enumerate(zip(ra, rb)) if a != b]
+
+
+def pair(case):
+    return {"input": case["input"], "output": case["outputs"]["intended"]}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise ValueError("Use a fresh evidence path; existing reports are immutable")
+
+    ledger = ROOT / "shared/data/canonical/puzzles.jsonl"
+    records = [(n, json.loads(line)) for n, line in enumerate(
+        ledger.read_text().splitlines(), 1) if json.loads(line)["task_id"] == TASK]
+    assert len(records) == 1
+    line_number, canonical = records[0]
+    intended = canonical["program_solution"]
+    assert digest(intended.encode()) == EXPECTED_PROGRAM
+    replacements = {
+        "row_threshold_1": ("(target-top? (< (fst pos) mid-r))",
+                            "(target-top? (< (fst pos) 1))"),
+        "column_threshold_3": ("(target-left? (< (snd pos) mid-c))",
+                               "(target-left? (< (snd pos) 3))"),
+    }
+    programs = {"intended": intended}
+    for name, (old, new) in replacements.items():
+        assert intended.count(old) == 1
+        programs[name] = intended.replace(old, new)
+
+    runtime = ROOT / "shared/runtime"
+    with _local_imports(runtime, HERE):
+        gen, source_path, source_hash = load_selected_generator(TASK, root=ROOT)
+        assert source_hash == EXPECTED_SOURCE and gen.RULE_HASH == EXPECTED_RULE
+        pool = {}
+        for seed in (0, 17):
+            for index in range(8):
+                grid = gen.generate(seed, index, difficulty="medium")
+                errors = gen.self_check(grid)
+                assert errors == []
+                mirror = gen.rule_mirror(grid)
+                assert mirror == threshold_output(grid)
+                pool[(seed, index)] = {
+                    "seed": seed, "sample_index": index, "difficulty": "medium",
+                    "overrides": {}, "input": grid,
+                    "input_sha256": grid_digest(grid),
+                    "marker": list(marker(grid)),
+                    "observed_axes": gen.observe_overrides(grid),
+                    "self_check_errors": errors,
+                    "python_prefilter_agreement": {
+                        "row_threshold_1": threshold_output(grid, row_cut=1) == mirror,
+                        "column_threshold_3": threshold_output(grid, column_cut=3) == mirror,
+                    },
+                }
+        assert len({item["input_sha256"] for item in pool.values()}) == 16
+        assert len({tuple(item["marker"]) for item in pool.values()}) == 16
+
+        selected_keys = (*DEMO_KEYS, QUERY_KEY, GUARD_KEY)
+        apply, identity, bridge = _real_evaluator(runtime)
+        evaluations = 0
+        executed = {}
+        canonical_cases = []
+        try:
+            assert identity["backend"] == "racket" and identity["protected"] is True
+
+            def execute(grid):
+                nonlocal evaluations
+                result = {}
+                for name, program in programs.items():
+                    result[name] = apply(program, grid)
+                    evaluations += 1
+                    assert len(result[name]) == 4 and all(len(row) == 4 for row in result[name])
+                assert result["intended"] == gen.rule_mirror(grid)
+                assert result["row_threshold_1"] == threshold_output(grid, row_cut=1)
+                assert result["column_threshold_3"] == threshold_output(grid, column_cut=3)
+                return result
+
+            for key in selected_keys:
+                item = dict(pool[key])
+                item["outputs"] = execute(item["input"])
+                executed[key] = item
+            for split in ("train", "test"):
+                for index, saved in enumerate(canonical[split]):
+                    outputs = execute(saved["input"])
+                    assert all(output == saved["output"] for output in outputs.values())
+                    canonical_cases.append({"split": split, "index": index,
+                        "input": saved["input"], "saved_output": saved["output"],
+                        "marker": list(marker(saved["input"])), "outputs": outputs})
+        finally:
+            bridge.close()
+
+        demos = [executed[key] for key in DEMO_KEYS]
+        query, guard = executed[QUERY_KEY], executed[GUARD_KEY]
+        lesson = {"train": [pair(item) for item in demos], "test": [pair(query)]}
+        repaired = {"train": [pair(guard), pair(demos[1]), pair(demos[2])],
+                    "test": [pair(query)]}
+        before_reasons = gen.lesson_identifiable(lesson["train"], lesson["test"][0])
+        after_reasons = gen.lesson_identifiable(repaired["train"], repaired["test"][0])
+        assert before_reasons == [] and after_reasons == []
+        comparisons = {}
+        for name in replacements:
+            comparisons[name] = {
+                "fits_all_visible_demos": all(item["outputs"][name] == item["outputs"]["intended"]
+                                             for item in demos),
+                "query_changed_cells": changes(query["outputs"]["intended"], query["outputs"][name]),
+                "guard_changed_cells": changes(guard["outputs"]["intended"], guard["outputs"][name]),
+                "alternate_query_output": query["outputs"][name],
+            }
+        assert comparisons["row_threshold_1"]["fits_all_visible_demos"]
+        assert len(comparisons["row_threshold_1"]["query_changed_cells"]) == 8
+        assert len(comparisons["row_threshold_1"]["guard_changed_cells"]) == 8
+        assert comparisons["column_threshold_3"]["fits_all_visible_demos"]
+        assert comparisons["column_threshold_3"]["query_changed_cells"] == []
+        assert evaluations == 27
+
+    history_path = HERE.parent / "evidence/repair-review-9acdffa9b96c5ade-v0001.json"
+    history = json.loads(history_path.read_text())
+    report = {
+        "schema": "637229802e6f-threshold-lesson-v1", "task_id": TASK,
+        "outcome": "confirmed_teaching_gap", "source_binding": {
+            "generator_path": str(source_path.relative_to(ROOT)),
+            "generator_sha256": source_hash, "canonical_path": str(ledger.relative_to(ROOT)),
+            "canonical_line": line_number, "canonical_program_sha256": EXPECTED_PROGRAM,
+            "canonical_normalized_rule_hash": gen.RULE_HASH,
+            "probe_path": str(Path(__file__).resolve().relative_to(ROOT)),
+            "probe_sha256": digest(Path(__file__).read_bytes()),
+        },
+        "racket": identity, "protected_evaluations": evaluations,
+        "programs": {name: {"source": program, "sha256": digest(program.encode())}
+                     for name, program in programs.items()},
+        "scope": {"ordinary_unique_draws": 16, "seeds": [0, 17],
+            "indices_per_seed": list(range(8)), "difficulty": "medium", "overrides": {},
+            "retained_ordinary_inputs": 5, "saved_canonical_inputs": 4,
+            "protected_program_count": 3, "authored_inputs": 0,
+            "lesson_assembly": "reviewer-selected ordinary draws from two seeds; not consecutive",
+            "public_worker_executed": False, "lesson_admission_hook_executed": True,
+            "discovery_labels": "Python mirror only; all retained labels independently executed in protected Racket",
+            "limits": "Two finite rivals, 16 ordinary draws and one retained query; no full battery or universal identification claim."},
+        "ordinary_pool": list(pool.values()),
+        "protected_cases": list(executed.values()), "canonical_cases": canonical_cases,
+        "canonical_all_three_programs_match_saved_labels": True,
+        "original_ambiguous_lesson": lesson,
+        "original_public_challenge_sha256": public_challenge_id(lesson),
+        "demonstration_keys": [list(key) for key in DEMO_KEYS],
+        "query_key": list(QUERY_KEY), "guard_key": list(GUARD_KEY),
+        "comparisons": comparisons,
+        "production_lesson_identifiable_reasons": before_reasons,
+        "guarded_three_demo_lesson": repaired,
+        "guarded_public_challenge_sha256": public_challenge_id(repaired),
+        "guarded_lesson_identifiable_reasons": after_reasons,
+        "guard_effect": "Replacing only demo 0 with the ordinary row-1 guard refutes row_threshold_1; the other two demos and original query stay unchanged.",
+        "new_scope_relative_to_history": "Mixed demo slots 1 and 3 need different marker-corner offsets, yet a shifted row-classification threshold survives. Both rivals retain the exact four-output codomain and also fit all four saved canonical pairs.",
+        "historical_hold": {"manifest": str(history_path.relative_to(ROOT)),
+            "disposition": history["disposition"],
+            "proposed_source_sha256": history["report"]["source_binding"]["generator_sha256"],
+            "proposal_is_current_selected_source": False,
+            "status": "Preserved; marker-corner/schedule finding and needs_evidence disposition remain unchanged."},
+        "repair_proposal": "Add executable half-threshold rivals to finite lesson checks and require a demonstration distinguishing a surviving query-changing threshold. The retained guard repairs this exact lesson without a fourth demonstration. A production schedule repair needs separate validation.",
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"outcome": report["outcome"], "protected_evaluations": evaluations,
+        "ordinary_unique_draws": 16, "query_changed_cells": 8, "guard_changed_cells": 8,
+        "lesson_identifiable_reasons": before_reasons, "output": str(args.out)}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
