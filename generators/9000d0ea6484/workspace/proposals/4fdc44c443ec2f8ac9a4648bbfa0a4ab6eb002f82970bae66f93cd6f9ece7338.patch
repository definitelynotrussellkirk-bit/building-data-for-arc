+def episode():
+    return {"seed": 17, "settings": {"start_section": 2, "scan_direction": "forward"},
+            "program_solution": "(rule! g)",
+            "train": [{"input": [[i]], "output": [[i]]} for i in range(4)],
+            "test": [{"input": [[i]], "output": [[i]]} for i in range(4, 8)]}
+
