+"""Bounded source-bound review of column-period teaching, with exact labels.
+
+Only ordinary generate(seed, sample_index) draws are used. Reviewer assembly
+does not establish public-worker episode or training-admission provenance.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import traceback
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+TASK = "903a3800b1b3"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+RUNTIME = ROOT / "shared/runtime"
+SOURCE_SHA = "f9fe361cc0a63bc7191b51682ca968e5a13adcd42ee3a7e1130591352755b52f"
+CANONICAL_SHA = "45922a949ffdf8e2df20c10f27b472ebc1e071b234789e3460041ec28d7caf8e"
+
+
+def digest(value):
+    raw = value if isinstance(value, str) else json.dumps(value, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(raw.encode()).hexdigest()
+
+
+def rivals(canonical):
+    needle = "(and (= v 4) (zero? (mod c 3)))"
+    assert canonical.count(needle) == 1
+    return {
+        "leftmost_yellow_origin": """(rule! (lambda (g)
+  (let ((left (apply min
+          (for*/list ((r (range 0 (rows g))) (c (range 0 (cols g))))
+            (if (= (at g r c) 4) c (cols g))))))
+    (cellmap g (r c v)
+      (if (and (= v 4) (zero? (mod (- c left) 3))) 6 v)))))""",
+        "period_six": canonical.replace(needle, "(and (= v 4) (zero? (mod c 6)))", 1),
+        "all_yellow": canonical.replace(needle, "(= v 4)", 1),
+    }
+
+
+def changed_cells(left, right):
+    assert len(left) == len(right) and all(len(a) == len(b) for a, b in zip(left, right))
+    return [[r, c] for r, row in enumerate(left) for c, value in enumerate(row) if value != right[r][c]]
+
+
+def metrics(grid):
+    cells = [[r, c] for r, row in enumerate(grid) for c, value in enumerate(row) if value == 4]
+    return {"shape": [len(grid), len(grid[0])], "yellow_cells": cells,
+            "yellow_count": len(cells), "leftmost_yellow_column": min((c for _, c in cells), default=None),
+            "yellow_column_residues": sorted({c % 3 for _, c in cells}),
+            "trigger_count": sum(c % 3 == 0 for _, c in cells),
+            "nontrigger_count": sum(c % 3 != 0 for _, c in cells)}
+
+
+def demo_only_guard(demonstrations, apply_program, rules):
+    """Execute rivals against demonstrations only; evaluator errors propagate."""
+    result = {}
+    for name, source in rules.items():
+        outputs = [apply_program(source, pair["input"]) for pair in demonstrations]
+        refuted = [index for index, (pair, actual) in enumerate(zip(demonstrations, outputs))
+                   if actual != pair["output"]]
+        result[name] = {"survives": not refuted, "refuted_demonstration_indices": refuted,
+                        "protected_outputs": outputs}
+    return result
+
+
+def find_witness(records, names, *, selected_subset=False):
+    for query_index, query in enumerate(records):
+        if query["self_check_errors"]:
+            continue
+        for name in names:
+            if query["outputs"][name] == query["outputs"]["intended"]:
+                continue
+            if selected_subset:
+                candidates = [row for row in records[:query_index]
+                              if not row["self_check_errors"]
+                              and row["outputs"][name] == row["outputs"]["intended"]]
+                unique = {}
+                for row in candidates:
+                    unique.setdefault(row["input_sha256"], row)
+                demonstrations = list(unique.values())[:3]
+            else:
+                demonstrations = records[max(0, query_index - 3):query_index]
+                origins = [row["origin"] for row in demonstrations] + [query["origin"]]
+                if (len(demonstrations) != 3 or len({row["seed"] for row in origins}) != 1
+                        or [row["sample_index"] for row in origins]
+                        != list(range(query["origin"]["sample_index"] - 3, query["origin"]["sample_index"] + 1))):
+                    continue
+            if (len(demonstrations) == 3
+                    and len({row["input_sha256"] for row in demonstrations + [query]}) == 4
+                    and all(not row["self_check_errors"]
+                            and row["outputs"][name] == row["outputs"]["intended"] for row in demonstrations)):
+                return {"rival": name, "demonstrations": demonstrations, "query": query,
+                        "assembly": "selected_subset_of_ordinary_draws" if selected_subset
+                        else "consecutive_ordinary_draws_assembled_by_reviewer"}
+    return None
+
+
+def run(report):
+    ledger = ROOT / "shared/data/canonical/puzzles.jsonl"
+    rows = [row for line in ledger.read_text().splitlines()
+            if (row := json.loads(line))["task_id"] == TASK]
+    assert len(rows) == 1
+    canonical = rows[0]
+    program = canonical["program_solution"]
+    assert digest(program) == CANONICAL_SHA
+    wrong = rivals(program)
+    programs = {"intended": program, **wrong}
+    report["rules"] = {name: {"program": source, "sha256": digest(source)} for name, source in programs.items()}
+    report["canonical_origin"] = {"path": ledger.relative_to(ROOT).as_posix(), "source": canonical["source"],
+                                  "program_sha256": digest(program)}
+    report["scope"] = {"seeds": [0, 17], "sample_indices_per_seed": list(range(8)),
+                       "difficulty": None, "overrides": {}, "maximum_ordinary_draws": 16,
+                       "rivals": list(wrong), "demonstrations_per_candidate": 3,
+                       "public_worker_executed": False, "authored_inputs": 0,
+                       "limits": ["Consecutive draw indices are reviewer assembly, not observed worker provenance.",
+                                  "Selected subsets are considered only if no consecutive witness is found.",
+                                  "No training admission or universal rule uniqueness is established."]}
+    report["protected_evaluations"] = 0
+    report["canonical_checks"] = []
+    report["ordinary_draws"] = []
+    with _local_imports(RUNTIME, HERE):
+        module, source_path, source_sha = load_selected_generator(TASK, root=ROOT)
+        assert source_sha == SOURCE_SHA
+        report["generator"] = {"path": source_path.relative_to(ROOT).as_posix(), "sha256": source_sha,
+                               "version": module.VERSION, "examples_needed": module.EXAMPLES_NEEDED}
+        evaluate, identity, bridge = _real_evaluator(RUNTIME)
+        report["runtime_identity"] = identity
+
+        def protected(source, grid):
+            actual = evaluate(source, grid)
+            report["protected_evaluations"] += 1
+            if (type(actual) is not list or len(actual) != len(grid)
+                    or any(type(row) is not list or len(row) != len(grid[0])
+                           or any(type(value) is not int or not 0 <= value <= 9 for value in row) for row in actual)):
+                raise ValueError("Protected evaluator did not return a same-shaped literal ARC grid")
+            return actual
+
+        def label(grid):
+            outputs = {name: protected(source, grid) for name, source in programs.items()}
+            independent = [[6 if value == 4 and c % 3 == 0 else value for c, value in enumerate(row)] for row in grid]
+            assert outputs["intended"] == independent
+            return outputs
+
+        witness = None
+        try:
+            for split in ("train", "test"):
+                for index, pair in enumerate(canonical[split]):
+                    outputs = label(pair["input"])
+                    assert outputs["intended"] == pair["output"]
+                    report["canonical_checks"].append({"split": split, "pair_index": index, **copy.deepcopy(pair),
+                                                       "outputs": outputs, "passed": True})
+            for seed in (0, 17):
+                for sample_index in range(8):
+                    grid = module.generate(seed, sample_index)
+                    record = {"origin": {"kind": "ordinary_generator_draw", "seed": seed,
+                                         "sample_index": sample_index, "difficulty": None, "overrides": {}},
+                              "input": grid, "input_sha256": digest(grid), "metrics": metrics(grid),
+                              "self_check_errors": module.self_check(grid), "outputs": label(grid)}
+                    record["rival_changed_cells"] = {
+                        name: changed_cells(record["outputs"]["intended"], record["outputs"][name]) for name in wrong}
+                    report["ordinary_draws"].append(record)
+                    witness = find_witness(report["ordinary_draws"], wrong)
+                    if witness:
+                        break
+                if witness:
+                    break
+            if witness is None:
+                witness = find_witness(report["ordinary_draws"], wrong, selected_subset=True)
+            if witness is not None:
+                train = [{"input": copy.deepcopy(row["input"]), "output": copy.deepcopy(row["outputs"]["intended"])}
+                         for row in witness["demonstrations"]]
+                query = witness["query"]
+                guard_before = demo_only_guard(train, protected, wrong)
+                added_demo = {"input": copy.deepcopy(query["input"]), "output": copy.deepcopy(query["outputs"]["intended"])}
+                guard_after = demo_only_guard(train + [added_demo], protected, wrong)
+                assert guard_before[witness["rival"]]["survives"] is True
+                assert guard_after[witness["rival"]]["survives"] is False
+                report["witness"] = {
+                    "construction": witness["assembly"], "public_worker_provenance": False,
+                    "rival": witness["rival"],
+                    "demonstration_origins": [row["origin"] for row in witness["demonstrations"]],
+                    "query_origin": query["origin"],
+                    "original_public_lesson": {"train": train, "test": [{"input": copy.deepcopy(query["input"])}]},
+                    "query_intended_output": query["outputs"]["intended"],
+                    "query_rival_output": query["outputs"][witness["rival"]],
+                    "query_changed_cells": query["rival_changed_cells"][witness["rival"]],
+                    "demo_only_guard_before": guard_before,
+                    "repair_proposal": {"kind": "use_distinguishing_draw_as_additional_demonstration",
+                                        "additional_demonstration": added_demo,
+                                        "demo_only_guard_after": guard_after,
+                                        "limitations": "This refutes the retained rival; it is not a newly admitted episode."},
+                }
+                report["status"] = "visible_demo_ambiguity"
+            else:
+                report["status"] = "bounded_no_new_finding"
+        finally:
+            bridge.close()
+    report["counts"] = {"ordinary_draws": len(report["ordinary_draws"]),
+                        "unique_ordinary_inputs": len({row["input_sha256"] for row in report["ordinary_draws"]}),
+                        "canonical_pairs": len(report["canonical_checks"]),
+                        "protected_evaluations": report["protected_evaluations"],
+                        "ordinary_self_check_violations": sum(bool(row["self_check_errors"]) for row in report["ordinary_draws"])}
+    assert report["counts"]["ordinary_draws"] <= 16 and report["protected_evaluations"] <= 120
+    assert hashlib.sha256(source_path.read_bytes()).hexdigest() == SOURCE_SHA
+    report["source_unchanged"] = True
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    report = {"schema": "arcpuzzles-bounded-peer-probe-v1", "task_id": TASK,
+              "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}
+    code = 0
+    try:
+        run(report)
+    except Exception as error:
+        code = 1
+        report.update(status="execution_error", error=str(error), traceback=traceback.format_exc())
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({key: report.get(key) for key in ("status", "counts", "error")}, sort_keys=True))
+    return code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
