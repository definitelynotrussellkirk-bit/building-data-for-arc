@@ -0,0 +1,140 @@
+"""Portable, source-bound probe for b24eadbaf79d orientation and axis defects."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+TASK_ID = "b24eadbaf79d"
+BANDS = ("easy", "medium", "hard")
+
+
+def _facts(grid: list[list[int]]) -> dict[str, Any]:
+    marker = [
+        (row, col)
+        for row, values in enumerate(grid)
+        for col, value in enumerate(values)
+        if value == 1
+    ]
+    template = [
+        (row, col)
+        for row, values in enumerate(grid)
+        for col, value in enumerate(values)
+        if value >= 2
+    ]
+    if not template:
+        raise ValueError("probe requires a nonempty template")
+    top = min(row for row, _ in template)
+    bottom = max(row for row, _ in template)
+    return {
+        "shape": [len(grid), len(grid[0])],
+        "marker": [[row, col] for row, col in marker],
+        "template_row_range": [top, bottom],
+        "marker_below_template": bool(marker and marker[0][0] > bottom),
+    }
+
+
+def build_report(*, root: str | Path, generated_per_band: int = 100) -> dict[str, Any]:
+    """Reproduce the retained findings against one explicit source tree."""
+    if isinstance(generated_per_band, bool) or not isinstance(generated_per_band, int):
+        raise TypeError("generated_per_band must be an integer")
+    if generated_per_band < 1:
+        raise ValueError("generated_per_band must be positive")
+
+    root = Path(root).resolve()
+    generator, source, source_sha256 = load_selected_generator(TASK_ID, root=root)
+
+    generated_rows: list[dict[str, Any]] = []
