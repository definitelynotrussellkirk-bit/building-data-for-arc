+"""Portable regression coverage for the b24eadbaf79d audit probe."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import find_root
+
+
+TASK_ID = "b24eadbaf79d"
+ROOT = find_root(__file__)
+PROBE_PATH = (
+    ROOT / "generators" / TASK_ID / "workspace" / "probe_orientation_and_axes.py"
+)
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("probe_orientation_and_axes", PROBE_PATH)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_portable_probe_reproduces_orientation_and_dead_axis_findings():
+    probe = _load_probe()
+    report = probe.build_report(root=ROOT, generated_per_band=16)
+
+    assert report["generated_samples"] == 48
+    assert report["generated_marker_below_template"] == 48
+    assert report["generated_opposite_orientation"] == 0
+    assert report["canonical_opposite_orientation_examples"] >= 1
+    assert report["exact_axis_reproductions"] == {
+        "variant_a_equals_variant_b": True,
+        "palette_default_equals_palette_cool": True,
+        "declared_grid_h_9_observed_height": 11,
+        "unknown_override_accepted": True,
+        "seed": 314159,
+        "sample_index": 7,
+        "difficulty": "medium",
+    }
