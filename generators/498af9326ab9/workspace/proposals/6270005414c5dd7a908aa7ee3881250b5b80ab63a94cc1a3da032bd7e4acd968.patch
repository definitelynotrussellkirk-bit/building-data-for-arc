+"""Bounded shape-template shortcut witness, with both labels from Racket."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK = "39a07044b798"
+SOURCE = "a4d59f7331fe3e8ed9ea0303b0fdc4d3944673bd15de15ea8b32bdbad2a44a81"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError("Use a new evidence path")
+    root = find_root(__file__)
+    module, _, digest = load_selected_generator(TASK, root=root)
+    assert digest == SOURCE, "Probe is bound to its audited source"
+    catalog = Catalog(root)
+    program = catalog._variants()[TASK][0]["program_solution"]
+    old = "(define (crop-ins ins) (subgrid left (obj-r1 ins) (obj-c1 ins) (obj-r2 ins) (obj-c2 ins)))"
+    new = """(define (crop-ins ins)
+      (grid-from-fn (obj-h ins) (obj-w ins)
+        (lambda (r c)
+          (if (or (and (= r 0) (= c (- (obj-w ins) 1)))
+                  (and (>= (obj-h ins) 3) (>= (obj-w ins) 3)
+                       (= r 1) (= c (- (obj-w ins) 1))))
+              0 (obj-color ins)))))"""
+    assert program.count(old) == 1
+    rival = program.replace(old, new)
+    generated = [module.generate(seed,0) for seed in range(8)]
+    query = [row[:] for row in generated[3]]
+    mid = len(query[0])//2
+    obj = module._components([row[:mid] for row in query])[0]
+    r0,c0,r1,c1 = module._bbox(obj["cells"])
+    old_shape = [row[c0:c1+1] for row in query[r0:r1+1]]
+    changed_shape = [row[::-1] for row in old_shape[::-1]]
+    assert old_shape != changed_shape
+    for r in range(r1-r0+1):
+        for c in range(c1-c0+1):
+            query[r0+r][c0+c] = changed_shape[r][c]
+    assert not module.self_check(query)
+    rows = []
+    with _local_imports(root/"shared/runtime",Path(__file__).parent):
+        apply, identity, bridge = _real_evaluator(root/"shared/runtime")
+        try:
+            for seed,grid in enumerate(generated):
+                correct, predicted = apply(program,grid), apply(rival,grid)
+                assert correct == predicted, f"Rival rejected by generated seed {seed}"
+                rows.append({"seed":seed,"input":grid,"output":correct})
+            correct, predicted = apply(program,query), apply(rival,query)
+            assert correct != predicted
+        finally:
+            bridge.close()
+    report = {"task_id":TASK,"generator_sha256":digest,"canonical_program_sha256":hashlib.sha256(program.encode()).hexdigest(),
+              "rival_program_sha256":hashlib.sha256(rival.encode()).hexdigest(),"racket":identity,
+              "finding":"Generated inserts share one deterministic corner-notch template. A rival can reconstruct that template from bounding-box dimensions/color and ignore the observed shape.",
+              "canonical_program":program,"rival_program":rival,"sampled_generated_grids":8,"sampled_rival_matches":8,
+              "racket_evaluations":18,"generated_checks":[{"seed":r["seed"],"rival_matches":True} for r in rows],
+              "lesson":{"train":[{"input":r["input"],"output":r["output"]} for r in rows[:2]],
+                        "test":{"input":query,"output":correct,"alternative_output":predicted}},
+              "query_construction":{"source_seed":3,"operation":"Rotate the first insert's pixels by 180 degrees inside its unchanged bounding box.",
+                                    "self_check":[],"actual_generator_support":False},
+              "scope":"Two generated demonstrations and a validator-accepted shape mutation. The query is outside the current shape constructor, not a claim of wrong labels on an emitted query.",
+              "next_repair":"Sample multiple connected bbox-exact notch/shape variants, and deliberately include a shape-sensitive demonstration before queries require it. Keep frame-size matching and rotation unchanged."}
+    args.out.parent.mkdir(parents=True,exist_ok=True)
+    args.out.write_text(json.dumps(report,indent=2,sort_keys=True)+"\n")
+    print(json.dumps({"task_id":TASK,"rival_matches":8,"sampled_grids":8,"racket_evaluations":18,"witness_differs":True}))
+
+
+if __name__ == "__main__":
+    main()
