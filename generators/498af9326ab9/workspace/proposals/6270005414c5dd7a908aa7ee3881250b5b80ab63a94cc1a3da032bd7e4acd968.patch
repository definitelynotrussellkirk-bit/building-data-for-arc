+"""Find a small emitted lesson underidentified on horizontal vs vertical triples."""
+from collections import deque
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK = "427d6a7812dd"
+SOURCE = "8db192822a20cbf1050ad2c4524ff60a3a615e2ab2904114bb6a8f051f2782c6"
+RIVAL = """(rule!
+  (for/fold ([out g]) ([obj (in-list (objects g 0))])
+    (if (and (= (obj-color obj) 2) (= (obj-size obj) 3)
+             (or (and (= (obj-h obj) 1) (= (obj-w obj) 3))
+                 (and (= (obj-h obj) 3) (= (obj-w obj) 1))))
+        (set-cell out (+ (obj-r1 obj) (quotient (obj-h obj) 2))
+                      (+ (obj-c1 obj) (quotient (obj-w obj) 2)) 1)
+        out)))"""
+
+
+def has_vertical_triple(grid):
+    remaining = {(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v == 2}
+    while remaining:
+        cell = min(remaining)
+        remaining.remove(cell)
+        component, queue = {cell}, deque([cell])
+        while queue:
+            r,c = queue.popleft()
+            for p in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
+                if p in remaining:
+                    remaining.remove(p);component.add(p);queue.append(p)
+        if len(component) == 3 and len({c for r,c in component}) == 1:
+            return True
+    return False
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out",type=Path,required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError("Use a new evidence path")
+    root = find_root(__file__)
+    module,_,digest = load_selected_generator(TASK,root=root)
+    assert digest == SOURCE, "Probe is bound to its audited source"
+    program = Catalog(root)._variants()[TASK][0]["program_solution"]
+    # Search consecutive, ordinary emitted windows, rather than select demos
+    # individually after seeing their answers. The cap is explicit.
+    rows,window = [],None
+    for seed in range(32):
+        grid = module.generate(seed,0)
+        assert not module.self_check(grid)
+        rows.append({"seed":seed,"input":grid,"vertical":has_vertical_triple(grid)})
+        if len(rows)>=4 and not any(r["vertical"] for r in rows[-4:-1]) and rows[-1]["vertical"]:
+            window=rows[-4:]
+            break
+    if window is None:
+        raise AssertionError("No three-demo witness in the bounded 32-seed search")
+    labels = []
+    with _local_imports(root/"shared/runtime",Path(__file__).parent):
+        apply,identity,bridge = _real_evaluator(root/"shared/runtime")
+        try:
+            for row in window:
+                labels.append({"input":row["input"],"output":apply(program,row["input"]),
+                               "alternative_output":apply(RIVAL,row["input"])})
+        finally:
+            bridge.close()
+    assert all(r["output"] == r["alternative_output"] for r in labels[:3])
+    assert labels[3]["output"] != labels[3]["alternative_output"]
+    report={"task_id":TASK,"generator_sha256":digest,"canonical_program_sha256":hashlib.sha256(program.encode()).hexdigest(),
+            "rival_program_sha256":hashlib.sha256(RIVAL.encode()).hexdigest(),"racket":identity,
+            "canonical_program":program,"rival_program":RIVAL,"racket_evaluations":8,
+            "searched_seeds":len(rows),"window_seeds":[r["seed"] for r in window],
+            "finding":"Three ordinary consecutive generated demonstrations omit vertical triples, so an orientation-insensitive three-cell-line rule fits them; the next emitted query contains a vertical triple and separates the rules.",
+            "lesson":{"train":[{"input":r["input"],"output":r["output"]} for r in labels[:3]],"test":labels[3]},
+            "query_is_actual_generator_output":True,"self_checks":[[] for _ in window],
+            "scope":"One bounded consecutive-window counterexample, not a prevalence estimate or a canonical-label defect.",
+            "next_repair":"Ensure the demonstrations include a vertical triple left unchanged, as well as a positive horizontal triple, before any query needs orientation discrimination. Keep other length distractors."}
+    args.out.parent.mkdir(parents=True,exist_ok=True)
+    args.out.write_text(json.dumps(report,indent=2,sort_keys=True)+"\n")
+    print(json.dumps({"task_id":TASK,"window_seeds":report["window_seeds"],"searched_seeds":len(rows),"racket_evaluations":8,"witness_differs":True}))
+
+
+if __name__ == "__main__":
+    main()
