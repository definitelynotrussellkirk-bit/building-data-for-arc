"""Finite, total-on-family wrong rules; these are hypotheses, not universal uniqueness."""
from pathlib import Path
import importlib.util
import copy
BASE=Path(__file__).resolve().parent
spec=importlib.util.spec_from_file_location('_bar_rival_adapter_'+str(BASE),BASE/'adapter.py')
adapter=importlib.util.module_from_spec(spec);spec.loader.exec_module(adapter)
NAMES=('identity','reverse','area','color','distinct_heights','unit_width','first_four','cap_13','fixed_middle','top_aligned')

def program(settings,name):
    if name not in NAMES:raise ValueError('Unknown rival')
    mode=adapter.validate(settings); op='>' if mode=='descending' else '<'
    source=adapter.program(settings)
    original=f'(sort (map fourth bars) {op})'
    if name=='identity':return '(rule! (lambda (g) g))'
    if name=='reverse':return adapter.program({'order':'ascending' if mode=='descending' else 'descending'})
    expr={
      'area':f'(map fourth (sort bars (lambda (a b) ({op} (* (fourth a) (- (second a) (first a))) (* (fourth b) (- (second b) (first b)))))))',
      'color':f'(map fourth (sort bars (lambda (a b) ({op} (third a) (third b)))))',
      'distinct_heights':f'(let ((unique (remove-duplicates {original}))) (for/list ((i (range (length bars)))) (list-ref unique (modulo i (length unique)))))',
      'first_four':f'(append (sort (map fourth (take bars (min 4 (length bars)))) {op}) (map fourth (drop bars (min 4 (length bars)))))',
      'cap_13':f'(map (lambda (x) (min x 13)) {original})',
    }
    if name in expr:return source.replace(original,expr[name])
    if name=='unit_width':return source.replace('(range (first bar) (second bar))','(range (first bar) (+ (first bar) 1))')
    if name=='fixed_middle':return source.replace('(- axis (quotient length 2))','(- (quotient height 2) (quotient length 2))')
    if name=='top_aligned':
        old='(range (- axis (quotient length 2)) (+ (- axis (quotient length 2)) length))'
        new='(range (max 0 (- axis (quotient (fourth bar) 2))) (min height (+ (- axis (quotient (fourth bar) 2)) length)))'
        return source.replace(old,new)
    raise AssertionError(name)


def solve(grid,settings,name):
    if name not in NAMES:raise ValueError('Unknown rival')
    mode=adapter.validate(settings);desc=mode=='descending';m=adapter.model
    axis,bars=m.analyze(grid); heights=sorted([b[3] for b in bars],reverse=desc)
    if name=='identity':return copy.deepcopy(grid)
    if name=='reverse':heights.reverse()
    if name=='area':heights=[b[3] for b in sorted(bars,key=lambda b:(b[1]-b[0])*b[3],reverse=desc)]
    if name=='color':heights=[b[3] for b in sorted(bars,key=lambda b:b[2],reverse=desc)]
    if name=='distinct_heights':
        unique=list(dict.fromkeys(heights));heights=[unique[i%len(unique)] for i in range(len(bars))]
    if name=='first_four':heights=sorted([b[3] for b in bars[:4]],reverse=desc)+[b[3] for b in bars[4:]]
    if name=='cap_13':heights=[min(h,13) for h in heights]
    if name=='unit_width':bars=[(b[0],b[0]+1,b[2],b[3]) for b in bars]
    if name in ('fixed_middle','top_aligned'):
        out=[[6 if r==axis else 8 for _ in grid[0]] for r in range(len(grid))]
        for bar,h in zip(bars,heights):
            top=len(grid)//2-h//2 if name=='fixed_middle' else axis-bar[3]//2
            for r in range(max(0,top),min(len(grid),top+h)):
                for c in range(bar[0],bar[1]):out[r][c]=bar[2]
        return out
    return m.paint(len(grid),len(grid[0]),axis,bars,heights)
