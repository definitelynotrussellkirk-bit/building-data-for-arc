+"""Bounded teaching and protected-Racket audit for the exact-pass family."""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+_HERE = Path(__file__).resolve().parent
+_SPEC = importlib.util.spec_from_file_location("midpoint_pass_depth_audit_target", _HERE / "prototype.py")
+if _SPEC is None or _SPEC.loader is None:
+    raise ImportError("cannot load adjacent parametric prototype")
+prototype = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(prototype)
+
+
+def _horizontal_only(grid):
+    out = deepcopy(grid)
+    for row in range(len(grid)):
+        for col in range(len(grid[0]) - 2):
+            color = grid[row][col]
+            if color and color == grid[row][col + 2] and grid[row][col + 1] == 0:
+                out[row][col + 1] = color
+    return out
+
+
+def _vertical_only(grid):
+    out = deepcopy(grid)
+    for row in range(len(grid) - 2):
+        for col in range(len(grid[0])):
+            color = grid[row][col]
+            if color and color == grid[row + 2][col] and grid[row + 1][col] == 0:
+                out[row + 1][col] = color
+    return out
+
+
+def _updated_vertical_scan(grid):
+    out = _horizontal_only(grid)
+    for row in range(len(out) - 2):
+        for col in range(len(out[0])):
+            color = out[row][col]
+            if color and color == out[row + 2][col] and out[row + 1][col] == 0:
+                out[row + 1][col] = color
+    return out
+
+
+def _horizontal_precedence(grid):
+    out = deepcopy(grid)
+    for row in range(len(grid) - 2):
+        for col in range(len(grid[0])):
+            color = grid[row][col]
+            if color and color == grid[row + 2][col] and grid[row + 1][col] == 0:
+                out[row + 1][col] = color
+    for row in range(len(grid)):
+        for col in range(len(grid[0]) - 2):
+            color = grid[row][col]
+            if color and color == grid[row][col + 2] and grid[row][col + 1] == 0:
+                out[row][col + 1] = color
+    return out
+
+
+def _fill_longspan(grid):
+    out = prototype.one_pass(grid)
+    for row in range(len(grid)):
+        for col in range(len(grid[0]) - 3):
+            color = grid[row][col]
+            if color and color == grid[row][col + 3]:
+                for middle in (col + 1, col + 2):
+                    if out[row][middle] == 0:
+                        out[row][middle] = color
+    for row in range(len(grid) - 3):
+        for col in range(len(grid[0])):
+            color = grid[row][col]
+            if color and color == grid[row + 3][col]:
+                for middle in (row + 1, row + 2):
+                    if out[middle][col] == 0:
+                        out[middle][col] = color
+    return out
+
+
+def _fill_diagonal(grid):
+    out = prototype.one_pass(grid)
+    for row in range(len(grid) - 2):
+        for col in range(len(grid[0]) - 2):
+            for dc in (2, -2):
+                far_col = col + dc
+                if not 0 <= far_col < len(grid[0]):
+                    continue
+                color = grid[row][col]
+                center_col = col + dc // 2
+                if color and color == grid[row + 2][far_col] and out[row + 1][center_col] == 0:
+                    out[row + 1][center_col] = color
+    return out
+
+
+def _overwrite_blocked(grid):
+    out = deepcopy(grid)
+    for row in range(len(grid)):
+        for col in range(len(grid[0]) - 2):
+            color = grid[row][col]
+            if color and color == grid[row][col + 2]:
+                out[row][col + 1] = color
+    for row in range(len(grid) - 2):
+        for col in range(len(grid[0])):
+            color = grid[row][col]
+            if color and color == grid[row + 2][col]:
+                out[row + 1][col] = color
+    return out
+
+
+def _fixed_color(grid):
+    out = deepcopy(grid)
+    for row in range(len(grid)):
+        for col in range(len(grid[0]) - 2):
+            color = grid[row][col]
+            if color and color == grid[row][col + 2] and grid[row][col + 1] == 0:
+                out[row][col + 1] = 1
+    for row in range(len(grid) - 2):
+        for col in range(len(grid[0])):
+            color = grid[row][col]
+            if color and color == grid[row + 2][col] and grid[row + 1][col] == 0:
+                out[row + 1][col] = 1
+    return out
+
+
+def _closure(grid):
+    out = deepcopy(grid)
+    for _ in range(12):
+        nxt = prototype.one_pass(out)
+        if nxt == out:
+            return out
+        out = nxt
+    raise RuntimeError("closure rival did not stabilize")
+
+
+RIVALS = {
+    "identity": lambda grid: deepcopy(grid),
+    "horizontal_only": _horizontal_only,
+    "vertical_only": _vertical_only,
+    "updated_vertical_scan": _updated_vertical_scan,
+    "horizontal_precedence": _horizontal_precedence,
+    "fill_longspan": _fill_longspan,
+    "fill_diagonal": _fill_diagonal,
+    "overwrite_blocked": _overwrite_blocked,
+    "fixed_color": _fixed_color,
+    "closure": _closure,
+    "three_pass": lambda grid: prototype.apply_passes(grid, 3),
+}
+
+
+def python_audit(seeds=(0, 17), demo_counts=range(2, 7)):
+    ambiguities = []
+    distinct = set()
+    pairs = 0
+    episodes = 0
+    stress = 0
+    rival_summary = {name: {"fits_demonstrations": 0, "query_disagreements": 0} for name in RIVALS}
+
+    for seed in seeds:
+        for passes in prototype.PASS_VALUES:
+            for demos in demo_counts:
+                episode = prototype.generate_episode(seed, passes=passes, demos=demos, queries=4)
+                episodes += 1
+                all_pairs = episode["train"] + episode["test"]
+                pairs += len(all_pairs)
+                distinct.update(json.dumps(pair["input"], separators=(",", ":")) for pair in all_pairs)
+                stress += int(any(len(pair["input"]) == len(pair["input"][0]) == 30 for pair in episode["test"]))
+                for name, rival in RIVALS.items():
+                    fits = all(rival(pair["input"]) == pair["output"] for pair in episode["train"])
+                    if not fits:
+                        continue
+                    rival_summary[name]["fits_demonstrations"] += 1
+                    disagreements = [
+                        index
+                        for index, pair in enumerate(episode["test"])
+                        if rival(pair["input"]) != pair["output"]
+                    ]
+                    rival_summary[name]["query_disagreements"] += len(disagreements)
+                    if disagreements:
+                        ambiguities.append(
+                            {
+                                "seed": seed,
+                                "passes": passes,
+                                "demos": demos,
+                                "rival": name,
+                                "queries": disagreements,
+                            }
+                        )
+    return {
+        "episodes": episodes,
+        "pairs": pairs,
+        "distinct_inputs": len(distinct),
+        "stress_30x30": stress,
+        "rivals": rival_summary,
+        "ambiguities": ambiguities,
+        "limits": "Finite declared rivals over seeds 0 and 17 and demo counts 2..6; not universal uniqueness.",
+    }
+
+
+def _racket_audit(seeds=(0, 17)):
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    bridge = RacketBridge()
+    wrapped = {}
+    mismatches = []
+    evaluations = 0
+    try:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise ValueError("audit requires a protected Racket backend")
+        for seed in seeds:
+            for passes in prototype.PASS_VALUES:
+                episode = prototype.generate_episode(seed, passes=passes, demos=6, queries=4)
+                program = prototype.rule_text(passes)
+                wrapped.setdefault(program, wrap_rule(program))
+                for split in ("train", "test"):
+                    for index, pair in enumerate(episode[split]):
+                        literal = "'(" + " ".join(
+                            "(" + " ".join(map(str, row)) + ")" for row in pair["input"]
+                        ) + ")"
+                        actual = bridge.eval_text(f"({wrapped[program]} {literal})")
+                        evaluations += 1
+                        if actual != pair["output"]:
+                            mismatches.append(
+                                {"seed": seed, "passes": passes, "split": split, "index": index}
+                            )
+        keep = (
+            "schema",
+            "backend",
+            "protected",
+            "binary_sha256",
+            "prelude_sha256",
+            "bridge_sha256",
+            "boot_script_sha256",
+            "candidate_symbol_policy_sha256",
+        )
+        return {
+            "runtime": {key: identity[key] for key in keep if key in identity},
+            "evaluations": evaluations,
+            "mismatches": mismatches,
+        }
+    finally:
+        bridge.close()
+
+
+def build_report():
+    report = {
+        "schema": "arcpuzzles-parametric-self-audit-v1",
+        "task_id": "fe54bfae4cee",
+        "python": python_audit(),
+        "racket": _racket_audit(),
+        "program_sha256": {
+            str(passes): hashlib.sha256(prototype.rule_text(passes).encode()).hexdigest()
+            for passes in prototype.PASS_VALUES
+        },
+    }
+    report["status"] = (
+        "passed"
+        if not report["python"]["ambiguities"] and not report["racket"]["mismatches"]
+        else "failed"
+    )
+    return report
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = build_report()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "episodes": report["python"]["episodes"],
+                "racket_evaluations": report["racket"]["evaluations"],
+                "ambiguities": len(report["python"]["ambiguities"]),
+                "mismatches": len(report["racket"]["mismatches"]),
+                "out": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0 if report["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
