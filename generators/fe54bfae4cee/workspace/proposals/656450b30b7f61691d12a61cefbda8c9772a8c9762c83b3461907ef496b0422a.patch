+"""Focused contracts for the opt-in one-pass/two-pass midpoint family."""
+from __future__ import annotations
+
+from copy import deepcopy
+from importlib.util import module_from_spec, spec_from_file_location
+import json
+from pathlib import Path
+import sys
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, public_challenge_bytes, public_challenge_id
+
+TASK_ID = "fe54bfae4cee"
+ROOT = find_root(__file__)
+HOME = Path(__file__).resolve().parents[1]
+PARAMETRIC = HOME / "workspace" / "parametric"
+CANONICAL_PROGRAM = "(rule! (let ((dummy 0)) (let ((after-h (for*/fold ((out g)) ((r (in-range (rows g))) (c (in-range (- (cols g) 2)))) (if (and (not (= (at g r c) 0)) (= (at g r c) (at g r (+ c 2))) (= (at g r (+ c 1)) 0)) (set-cell out r (+ c 1) (at g r c)) out)))) (for*/fold ((out after-h)) ((r (in-range (- (rows g) 2))) (c (in-range (cols g)))) (if (and (not (= (at g r c) 0)) (= (at g r c) (at g (+ r 2) c)) (= (at g (+ r 1) c) 0)) (set-cell out (+ r 1) c (at g r c)) out)))))"
+
+
+def _load(name: str, path: Path):
+    assert path.is_file(), f"missing implementation file: {path}"
+    spec = spec_from_file_location(name, path)
+    assert spec and spec.loader
+    module = module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _one_pass(grid: list[list[int]]) -> list[list[int]]:
+    h, w = len(grid), len(grid[0])
+    out = deepcopy(grid)
+    for r in range(h):
+        for c in range(w - 2):
+            color = grid[r][c]
+            if color and color == grid[r][c + 2] and grid[r][c + 1] == 0:
+                out[r][c + 1] = color
+    for r in range(h - 2):
+        for c in range(w):
+            color = grid[r][c]
+            if color and color == grid[r + 2][c] and grid[r + 1][c] == 0:
+                out[r + 1][c] = color
+    return out
+
+
+def _apply(grid: list[list[int]], passes: int) -> list[list[int]]:
+    out = deepcopy(grid)
+    for _ in range(passes):
+        out = _one_pass(out)
+    return out
+
+
+def _shared_midpoint_count(grid: list[list[int]]) -> int:
+    h, w = len(grid), len(grid[0])
+    mids: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w - 2):
+            if grid[r][c] and grid[r][c] == grid[r][c + 2] and grid[r][c + 1] == 0:
+                mids.append((r, c + 1))
+    for r in range(h - 2):
+        for c in range(w):
+            if grid[r][c] and grid[r][c] == grid[r + 2][c] and grid[r + 1][c] == 0:
+                mids.append((r + 1, c))
+    return len(mids) - len(set(mids))
+
+
+def test_adapter_preserves_exact_default_and_declares_two_pass_program():
+    prototype = _load("midpoint_pass_depth_prototype", PARAMETRIC / "prototype.py")
+    adapter = _load("midpoint_pass_depth_adapter", PARAMETRIC / "adapter.py")
+
+    assert adapter.program({"passes": 1}) == CANONICAL_PROGRAM
+    assert adapter.program({"passes": 2}) == prototype.TWO_PASS_PROGRAM
+    assert adapter.program({"passes": 2}) != CANONICAL_PROGRAM
+
+    for invalid in ({}, {"passes": 3}, {"passes": True}, {"passes": 1, "extra": 0}, None):
+        with pytest.raises(ValueError):
+            adapter.program(invalid)
+
+
+@pytest.mark.parametrize("seed", [0, 17, 991])
+@pytest.mark.parametrize("demos", range(2, 7))
+@pytest.mark.parametrize("passes", [1, 2])
+def test_episode_counts_distinct_inputs_stage_depth_and_python_labels(seed, demos, passes):
+    prototype = _load(f"midpoint_pass_proto_{seed}_{demos}_{passes}", PARAMETRIC / "prototype.py")
+    episode = prototype.generate_episode(seed, passes=passes, demos=demos, queries=4)
+
+    assert len(episode["train"]) == demos
+    assert len(episode["test"]) == 4
+    assert episode["program_solution"] == prototype.rule_text(passes)
+
+    pairs = episode["train"] + episode["test"]
+    serialized = [json.dumps(pair["input"], separators=(",", ":")) for pair in pairs]
+    assert len(serialized) == len(set(serialized))
+
+    for pair in pairs:
+        grid = pair["input"]
+        assert 12 <= len(grid) <= 30
+        assert 12 <= len(grid[0]) <= 30
+        assert all(type(cell) is int and 0 <= cell <= 9 for row in grid for cell in row)
+        stage1 = _one_pass(grid)
+        stage2 = _one_pass(stage1)
+        stage3 = _one_pass(stage2)
+        stage4 = _one_pass(stage3)
+        assert stage1 != grid
+        assert stage2 != stage1
+        assert stage3 != stage2
+        assert stage4 == stage3
+        assert pair["output"] == (stage1 if passes == 1 else stage2)
+
+    # Every lesson includes a crossed-pair precedence witness in the first demo.
+    assert _shared_midpoint_count(episode["train"][0]["input"]) >= 1
+
+    stress = episode["test"][-1]["input"]
+    assert (len(stress), len(stress[0])) == (30, 30)
+    nonzero = [(r, c, value) for r, row in enumerate(stress) for c, value in enumerate(row) if value]
+    assert len(nonzero) >= 70
+    assert {0, 29} <= {r for r, _, _ in nonzero}
+    assert {0, 29} <= {c for _, c, _ in nonzero}
+    assert len({value for _, _, value in nonzero}) >= 8
+
+
+def test_setting_changes_labels_not_inputs_and_every_demo_identifies_pass_count():
+    prototype = _load("midpoint_pass_shared_inputs", PARAMETRIC / "prototype.py")
+    one = prototype.generate_episode(73, passes=1, demos=6, queries=4)
+    two = prototype.generate_episode(73, passes=2, demos=6, queries=4)
+
+    assert [p["input"] for p in one["train"] + one["test"]] == [
+        p["input"] for p in two["train"] + two["test"]
+    ]
+    assert all(a["output"] != b["output"] for a, b in zip(one["train"], two["train"]))
+    assert all(a["output"] != b["output"] for a, b in zip(one["test"], two["test"]))
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"seed": True, "passes": 1, "demos": 3, "queries": 4},
+        {"seed": -1, "passes": 1, "demos": 3, "queries": 4},
+        {"seed": 0, "passes": 0, "demos": 3, "queries": 4},
+        {"seed": 0, "passes": 3, "demos": 3, "queries": 4},
+        {"seed": 0, "passes": True, "demos": 3, "queries": 4},
+        {"seed": 0, "passes": 1, "demos": 1, "queries": 4},
+        {"seed": 0, "passes": 1, "demos": 7, "queries": 4},
+        {"seed": 0, "passes": 1, "demos": 3, "queries": 3},
+        {"seed": 0, "passes": 1, "demos": 3, "queries": 5},
+    ],
+)
+def test_episode_rejects_out_of_contract_requests(kwargs):
+    prototype = _load("midpoint_pass_bad_requests", PARAMETRIC / "prototype.py")
+    with pytest.raises(ValueError):
+        prototype.generate_episode(**kwargs)
+
+
+def test_public_projection_ignores_private_settings_seed_program_and_query_answers():
+    prototype = _load("midpoint_pass_public_projection", PARAMETRIC / "prototype.py")
+    episode = prototype.generate_episode(109, passes=2, demos=3, queries=4)
+    changed = deepcopy(episode)
+    changed["settings"] = {"passes": 1}
+    changed["seed"] = 999999
+    changed["program_solution"] = "not the program"
+    for pair in changed["test"]:
+        pair["output"] = [[9]]
+
+    assert public_challenge_bytes(changed) == public_challenge_bytes(episode)
+    assert public_challenge_id(changed) == public_challenge_id(episode)
+    visible = json.loads(public_challenge_bytes(episode))
+    assert set(visible) == {"train", "test"}
+    assert all(set(pair) == {"input"} for pair in visible["test"])
+    serialized = json.dumps(visible, sort_keys=True)
+    assert "passes" not in serialized and "program" not in serialized and "seed" not in serialized
+
+
+def _racket_apply(bridge, program: str, grid: list[list[int]]):
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+    return bridge.eval_text(f"({wrap_rule(program)} {literal})")
+
+
+def test_protected_racket_replays_canonical_and_exposes_real_two_stage_dependency():
+    from arc_repl.racket_bridge import RacketBridge
+
+    prototype = _load("midpoint_pass_racket", PARAMETRIC / "prototype.py")
+    witness = prototype.generate_episode(0, passes=2, demos=2, queries=4)["train"][0]["input"]
+
+    with RacketBridge() as bridge:
+        assert bridge.runtime_identity["backend"] == "racket"
+        assert bridge.runtime_identity["protected"] is True
+        for pair in canonical_pairs(TASK_ID, root=ROOT, labeled_only=True):
+            assert _racket_apply(bridge, prototype.CANONICAL_PROGRAM, pair["input"]) == pair["output"]
+        stage1 = _racket_apply(bridge, prototype.CANONICAL_PROGRAM, witness)
+        stage2 = _racket_apply(bridge, prototype.TWO_PASS_PROGRAM, witness)
+        stage2_by_composition = _racket_apply(bridge, prototype.CANONICAL_PROGRAM, stage1)
+        stage3 = _racket_apply(bridge, prototype.CANONICAL_PROGRAM, stage2)
+        stage4 = _racket_apply(bridge, prototype.CANONICAL_PROGRAM, stage3)
+
+    assert stage1 == _one_pass(witness)
+    assert stage2 == _apply(witness, 2) == stage2_by_composition
+    assert stage2 != stage1  # skipping A leaves only the first-stage output
+    assert stage3 != stage2  # exact two passes is not closure
+    assert stage4 == stage3
+
+
+def test_bounded_teaching_audit_refutes_declared_shortcuts():
+    audit = _load("midpoint_pass_audit", PARAMETRIC / "audit.py")
+    report = audit.python_audit(seeds=(0, 17), demo_counts=range(2, 7))
+
+    assert report["episodes"] == 20
+    assert report["ambiguities"] == []
+    # Inputs intentionally repeat across settings and nested demo counts; only
+    # the two seeds × (six maximal demos + four queries) are distinct.
+    assert report["distinct_inputs"] == 20
+    assert report["stress_30x30"] == 20
+    assert {
+        "identity",
+        "horizontal_only",
+        "vertical_only",
+        "updated_vertical_scan",
+        "horizontal_precedence",
+        "fill_longspan",
+        "fill_diagonal",
+        "overwrite_blocked",
+        "fixed_color",
+        "closure",
+        "three_pass",
+    } <= set(report["rivals"])
+
+
+def test_promotion_contract_exposes_two_to_six_demos_and_exactly_four_queries():
+    contract = json.loads((PARAMETRIC / "promotion.json").read_text())
+    assert contract == {
+        "schema": "arcpuzzles-parametric-adapter-v1",
+        "adapter": "generators/fe54bfae4cee/workspace/parametric/adapter.py",
+        "parameters": {"passes": [1, 2]},
+        "default": {"passes": 1},
+        "limits": {"demos": [2, 6], "queries": [4, 4]},
+    }
