+"""Native promotion adapter for the exact-pass midpoint family."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+_HERE = Path(__file__).resolve().parent
+_SPEC = importlib.util.spec_from_file_location("midpoint_pass_depth_prototype", _HERE / "prototype.py")
+if _SPEC is None or _SPEC.loader is None:
+    raise ImportError("cannot load adjacent parametric prototype")
+prototype = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(prototype)
+
+
+def _settings(settings):
+    return prototype.validate_settings(settings)
+
+
+def program(settings):
+    settings = _settings(settings)
+    return prototype.rule_text(settings["passes"])
+
+
+def generate(seed, settings, demos, queries):
+    settings = _settings(settings)
+    return prototype.generate_episode(
+        seed,
+        passes=settings["passes"],
+        demos=demos,
+        queries=queries,
+    )
