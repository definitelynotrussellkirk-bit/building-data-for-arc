+"""Behavioral contract for the native one-pass/two-pass midpoint family."""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+from reviewer_support import canonical_path, find_root
+
+TASK_ID = "fe54bfae4cee"
+ROOT = find_root(__file__)
+HOME = ROOT / "generators" / TASK_ID
+PARAMETRIC = HOME / "workspace" / "parametric"
+PROTOTYPE_PATH = PARAMETRIC / "prototype.py"
+ADAPTER_PATH = PARAMETRIC / "adapter.py"
+PROMOTION_PATH = PARAMETRIC / "promotion.json"
+SELF_AUDIT_PATH = PARAMETRIC / "self_audit.py"
+
+
+def _load(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_program() -> str:
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        programs = {
+            row["program_solution"]
+            for line in handle
+            if (row := json.loads(line)).get("task_id") == TASK_ID
+        }
+    assert len(programs) == 1
+    return next(iter(programs))
+
+
+def _all_inputs(episode: dict) -> list[list[list[int]]]:
+    return [pair["input"] for pair in [*episode["train"], *episode["test"]]]
+
+
+def _changed(before: list[list[int]], after: list[list[int]]) -> set[tuple[int, int]]:
+    return {
+        (r, c)
+        for r, row in enumerate(before)
+        for c, value in enumerate(row)
+        if after[r][c] != value
+    }
+
+
+def test_native_parametric_sources_exist():
+    missing = [
+        path.relative_to(ROOT).as_posix()
+        for path in (PROTOTYPE_PATH, ADAPTER_PATH, PROMOTION_PATH, SELF_AUDIT_PATH)
+        if not path.is_file()
+    ]
+    assert not missing, f"missing native parametric sources: {missing}"
+
+
+@pytest.fixture(scope="module")
+def prototype():
+    return _load("test_fe54_fill_passes_prototype", PROTOTYPE_PATH)
+
+
+@pytest.fixture(scope="module")
+def adapter():
+    return _load("test_fe54_fill_passes_adapter", ADAPTER_PATH)
+
+
+def test_programs_preserve_exact_canonical_default_and_add_two_pass_rule(prototype):
+    canonical = _canonical_program()
+    one_pass = prototype.program_for(1)
+    two_pass = prototype.program_for(2)
+    assert one_pass == canonical
+    assert two_pass != canonical
+    assert two_pass == prototype.program_for(2)
+    assert two_pass.count(canonical.removeprefix("(rule! ").removesuffix(")")) == 1
+
+
+def test_requested_demo_counts_and_four_distinct_queries_are_supported(prototype):
+    for passes in prototype.PASS_OPTIONS:
+        for demos in range(2, 7):
+            episode = prototype.generate_episode(41, passes, demos, 4)
+            assert len(episode["train"]) == demos
+            assert len(episode["test"]) == 4
+            inputs = _all_inputs(episode)
+            assert len({json.dumps(grid, separators=(",", ":")) for grid in inputs}) == demos + 4
+            assert episode["program_solution"] == prototype.program_for(passes)
+
+
+def test_same_seed_uses_matched_inputs_and_minimum_demos_identify_pass_count(prototype):
+    one = prototype.generate_episode(1729, 1, 2, 4)
+    two = prototype.generate_episode(1729, 2, 2, 4)
+    assert _all_inputs(one) == _all_inputs(two)
+    assert one["train"][0]["output"] != two["train"][0]["output"]
+
+    deep = one["train"][1]["input"]
+    after_one = prototype.apply_passes(deep, 1)
+    after_two = prototype.apply_passes(deep, 2)
+    closure = prototype.apply_until_stable(deep)
+    assert len({json.dumps(value) for value in (after_one, after_two, closure)}) == 3
+    assert one["train"][1]["output"] == after_one
+    assert two["train"][1]["output"] == after_two
+
+
+def test_second_pass_consumes_a_new_first_pass_endpoint(prototype):
+    witness = prototype.causal_witness()
+    source = witness["input"]
+    first = prototype.apply_passes(source, 1)
+    second = prototype.apply_passes(source, 2)
+    created_first = tuple(witness["created_first"])
+    created_second = tuple(witness["created_second"])
+
+    assert source[created_first[0]][created_first[1]] == 0
+    assert first[created_first[0]][created_first[1]] == witness["color"]
+    assert first[created_second[0]][created_second[1]] == 0
+    assert second[created_second[0]][created_second[1]] == witness["color"]
+    assert created_second in _changed(first, second)
+    skipped = prototype.skip_first_pass(source)
+    assert skipped == first
+    assert skipped[created_second[0]][created_second[1]] == 0
+    assert skipped != second
+
+
+def test_minimum_lesson_teaches_crossed_midpoint_precedence(prototype):
+    episode = prototype.generate_episode(8, 1, 2, 4)
+    crosses = prototype.crossed_midpoints(episode["train"][0]["input"])
+    assert crosses
+    for row, col, horizontal_color, vertical_color in crosses:
+        assert horizontal_color != vertical_color
+        assert episode["train"][0]["output"][row][col] == vertical_color
+
+
+def test_queries_cover_boundaries_distractors_and_substantive_30x30_stress(prototype):
+    episode = prototype.generate_episode(5, 2, 3, 4)
+    shapes = [(len(pair["input"]), len(pair["input"][0])) for pair in episode["test"]]
+    assert shapes == [(7, 7), (12, 12), (18, 24), (30, 30)]
+
+    boundary = episode["test"][0]["input"]
+    assert any(boundary[0]) or any(boundary[-1]) or any(row[0] or row[-1] for row in boundary)
+
+    stress = episode["test"][-1]
+    nonzero = sum(value != 0 for row in stress["input"] for value in row)
+    changed = len(_changed(stress["input"], stress["output"]))
+    assert nonzero >= 60
+    assert changed >= 12
+    assert prototype.scene_profile(stress["input"])["motif_kinds"] >= {
+        "chain2",
+        "chain3",
+        "standalone",
+        "longspan",
+        "diagonal",
+        "blocked",
+        "cross",
+    }
+
+
+def test_generation_is_deterministic_fresh_and_strictly_validated(prototype):
+    first = prototype.generate_episode(99, 2, 6, 4)
+    second = prototype.generate_episode(99, 2, 6, 4)
+    assert first == second
+    assert first is not second
+    assert first["train"][0]["input"] is not second["train"][0]["input"]
+    first["train"][0]["input"][0][0] = (first["train"][0]["input"][0][0] + 1) % 10
+    assert first != second
+
+    for bad_seed in (True, -1, 2**63):
+        with pytest.raises((TypeError, ValueError)):
+            prototype.generate_episode(bad_seed, 1, 3, 4)
+    for bad_passes in (0, 3, True, "2", None):
+        with pytest.raises((TypeError, ValueError)):
+            prototype.generate_episode(1, bad_passes, 3, 4)
+    for bad_demos in (True, 1, 7):
+        with pytest.raises((TypeError, ValueError)):
+            prototype.generate_episode(1, 1, bad_demos, 4)
+    for bad_queries in (True, 1, 3, 5):
+        with pytest.raises((TypeError, ValueError)):
+            prototype.generate_episode(1, 1, 3, bad_queries)
+
+
+def test_adapter_and_contract_expose_only_the_declared_setting(adapter):
+    contract = json.loads(PROMOTION_PATH.read_text(encoding="utf-8"))
+    assert contract == {
+        "schema": "arcpuzzles-parametric-adapter-v1",
+        "adapter": f"generators/{TASK_ID}/workspace/parametric/adapter.py",
+        "parameters": {"fill_passes": [1, 2]},
+        "default": {"fill_passes": 1},
+        "limits": {"demos": [2, 6], "queries": [4, 4]},
+    }
+    for passes in (1, 2):
+        settings = {"fill_passes": passes}
+        assert adapter.program(settings) == adapter.prototype.program_for(passes)
+        episode = adapter.generate(12, settings, 3, 4)
+        assert episode == adapter.prototype.generate_episode(12, passes, 3, 4)
+
+    for settings in ({}, {"fill_passes": 3}, {"fill_passes": True}, {"extra": 1, "fill_passes": 1}):
+        with pytest.raises((TypeError, ValueError)):
+            adapter.program(settings)
+
+
+def test_bounded_self_audit_refutes_declared_shortcuts_from_demos_only():
+    audit = _load("test_fe54_fill_passes_self_audit", SELF_AUDIT_PATH)
+    report = audit.audit_family(seeds=(0, 17), demo_counts=(2, 3, 6), queries=4)
+    assert report["status"] == "passed"
+    assert len(report["cases"]) == 12
+    for case in report["cases"]:
+        selected = f"passes:{case['settings']['fill_passes']}"
+        assert case["demo_survivors"] == [selected]
+        assert not case["ambiguous_query_rivals"]
+        assert case["rival_count"] >= 8
+
+
+def test_self_audit_rejects_invalid_limits_and_is_deterministic():
+    audit = _load("test_fe54_fill_passes_self_audit_validation", SELF_AUDIT_PATH)
+    first = audit.audit_family(seeds=(41,), demo_counts=(2,), queries=4)
+    second = audit.audit_family(seeds=(41,), demo_counts=(2,), queries=4)
+    assert first == second
+    for seeds, demo_counts, queries in (((), (2,), 4), ((0,), (), 4), ((0,), (1,), 4), ((0,), (2,), 3)):
+        with pytest.raises((TypeError, ValueError)):
+            audit.audit_family(seeds=seeds, demo_counts=demo_counts, queries=queries)
