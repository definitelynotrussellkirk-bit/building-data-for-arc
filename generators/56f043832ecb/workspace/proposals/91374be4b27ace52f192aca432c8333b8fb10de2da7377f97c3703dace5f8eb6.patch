+"""Bounded frame-gallery ordering audit; run through the packet launcher.
+
+Draw exactly seeds 0/17, indices 0..7 with ordinary default arguments.  Inspect
+the ten consecutive three-demo/one-query windows within those draws using
+Python mirrors, then replay one selected window and the canonical pairs through
+protected Racket.  These explicit windows are not claimed to be the production
+worker's chosen lesson assembly.  Errors are failures, never rival refutations.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+TASK = "5a6a772cd217"
+ROOT = Path(__file__).resolve().parents[3]
+RUNTIME = ROOT / "shared/runtime"
+sys.path[:0] = [str(ROOT / "src"), str(RUNTIME)]
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from reviewer_support import canonical_pairs, load_selected_generator
+
+
+def _bytes(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
+
+
+def _sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def first_mark_mirror(grid, generator):
+    frames = copy.deepcopy(generator._analyze(grid)["frames"])
+    for frame in frames:
+        points = [(r, c) for r in range(frame["r1"] + 1, frame["r2"])
+                  for c in range(frame["c1"] + 1, frame["c2"])
+                  if grid[r][c] not in (0, 5)]
+        frame["first_mark"] = min(points) if points else (frame["r1"], frame["c1"])
+    frames.sort(key=lambda frame: frame["first_mark"])
+    height = max(frame["interior_height"] for frame in frames)
+    panels = []
+    for index, frame in enumerate(frames):
+        interior = frame["interior"]
+        h, w = len(interior), len(interior[0])
+        panel = [[0] * (w + int(w < 3)) for _ in range(height)]
+        left = int(index > 0 and w < 3)
+        for r in range(h):
+            for c in range(w):
+                panel[r][c + left] = interior[r][c]
+        panels.append(panel)
+    return [[value for panel in panels for value in panel[r]] for r in range(height)]
+
+
+def first_mark_program(canonical):
+    old = "(define (obj< a b) (let ((ba (obj-bbox a)) (bb (obj-bbox b)))"
+    assert canonical.count(old) == 1, "Selected comparator source changed"
+    helper = """(define (first-mark obj)
+      (let* ((bb (obj-bbox obj))
+             (marks (filter
+               (lambda (p)
+                 (and (> (first p) (first bb)) (< (first p) (third bb))
+                      (> (second p) (second bb)) (< (second p) (fourth bb))
+                      (not (= (at g (first p) (second p)) 0))
+                      (not (= (at g (first p) (second p)) 5))))
+               (grid-positions g))))
+        (if (empty? marks) (list (first bb) (second bb)) (first marks)))) """
+    return canonical.replace(old, helper + "(define (obj< a b) (let ((ba (first-mark a)) (bb (first-mark b)))", 1)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args()
+    out = Path(args.out)
+    if out.exists():
+        raise ValueError("Refusing to overwrite audit evidence")
+    generator, source_path, source_sha = load_selected_generator(TASK, root=ROOT)
+    assert generator.EXAMPLES_NEEDED == 3
+    record = Catalog(ROOT).get(TASK)
+    programs = {v["program_solution"] for v in record["variants"]
+                if isinstance(v.get("program_solution"), str)}
+    assert len(programs) == 1
+    canonical = next(iter(programs))
+    rival = first_mark_program(canonical)
+    draws = []
+    for seed in (0, 17):
+        for index in range(8):
+            grid = generator.generate(seed, index)
+            assert generator.self_check(grid) == []
+            draws.append({"seed": seed, "sample_index": index,
+                          "input": grid, "input_sha256": _sha(_bytes(grid)),
+                          "canonical_mirror": generator.rule_mirror(grid),
+                          "first_mark_mirror": first_mark_mirror(grid, generator)})
+    windows = []
+    for seed in (0, 17):
+        series = [row for row in draws if row["seed"] == seed]
+        for start in range(5):
+            examples = series[start:start+4]
+            fits = all(row["canonical_mirror"] == row["first_mark_mirror"] for row in examples[:3])
+            differs = examples[3]["canonical_mirror"] != examples[3]["first_mark_mirror"]
+            existing = {}
+            for name, function in generator.LESSON_COMPETITORS.items():
+                predictions = [function(row["input"]) for row in examples]
+                existing[name] = {
+                    "fits_demos": all(predictions[i] == examples[i]["canonical_mirror"] for i in range(3)),
+                    "changes_query": predictions[3] != examples[3]["canonical_mirror"],
+                }
+            windows.append({"seed": seed, "demo_indices": list(range(start, start+3)),
+                            "query_index": start+3, "first_mark_fits_demos": fits,
+                            "first_mark_changes_query": differs,
+                            "existing_rivals_python": existing})
+    findings = [row for row in windows if row["first_mark_fits_demos"] and row["first_mark_changes_query"]]
+    selected = findings[0] if findings else windows[0]
+    chosen_indices = selected["demo_indices"] + [selected["query_index"]]
+    chosen = [row for row in draws if row["seed"] == selected["seed"] and row["sample_index"] in chosen_indices]
+    executions = []
+    canonical_checks = []
+    with _local_imports(RUNTIME, Path(__file__).resolve().parent):
+        execute, identity, bridge = _real_evaluator(RUNTIME)
+        try:
+            for row in chosen:
+                outputs = {}
+                for name, program, expected in (
+                    ("canonical", canonical, row["canonical_mirror"]),
+                    ("first_mark", rival, row["first_mark_mirror"]),
+                ):
+                    result = _grid(execute(program, row["input"]))
+                    assert result == expected, f"{name} Python/Racket disagreement"
+                    outputs[name] = result
+                executions.append({"seed": row["seed"], "sample_index": row["sample_index"],
+                                   "role": "demo" if row["sample_index"] in selected["demo_indices"] else "query",
+                                   "input": row["input"], "outputs": outputs})
+            for pair in canonical_pairs(TASK, root=ROOT, labeled_only=True):
+                actual = _grid(execute(canonical, pair["input"]))
+                assert actual == pair["output"], "Canonical label mismatch"
+                candidate = _grid(execute(rival, pair["input"]))
+                canonical_checks.append({**pair, "canonical_output": actual,
+                                         "rival_output": candidate, "rival_matches": candidate == actual})
+        finally:
+            bridge.close()
+    replayed_demos_fit = all(row["outputs"]["canonical"] == row["outputs"]["first_mark"]
+                            for row in executions if row["role"] == "demo")
+    query = next(row for row in executions if row["role"] == "query")
+    replayed_query_differs = query["outputs"]["canonical"] != query["outputs"]["first_mark"]
+    assert replayed_demos_fit == selected["first_mark_fits_demos"]
+    assert replayed_query_differs == selected["first_mark_changes_query"]
+    result = {
+        "task_id": TASK,
+        "status": "confirmed_counterexample" if findings else "bounded_no_counterexample",
+        "source_binding": {source_path.relative_to(ROOT).as_posix(): source_sha,
+                           Path(__file__).resolve().relative_to(ROOT).as_posix(): _sha(Path(__file__).read_bytes())},
+        "rule_hash": record["rule_hash"],
+        "programs": {"canonical": canonical, "first_mark": rival},
+        "program_sha256": {"canonical": _sha(canonical.encode()), "first_mark": _sha(rival.encode())},
+        "racket": identity,
+        "sampling": {"seeds": [0, 17], "sample_indices": list(range(8)), "draws": 16,
+                     "difficulty": None, "overrides": {}, "minimum_demos": 3,
+                     "assembly_scope": "Ten explicit consecutive windows within these 16 ordinary draws; not a production-worker assembly claim"},
+        "rival_meaning": "Order exact gray frames by their first row-major colored interior pixel; retain all canonical extraction, alignment, padding and concatenation operations",
+        "windows": windows,
+        "python_counterexample_windows": len(findings),
+        "selected_window": selected,
+        "protected_replay": executions,
+        "protected_execution_count": len(executions)*2 + len(canonical_checks)*2,
+        "canonical_checks": canonical_checks,
+        "draw_inventory": [{key: row[key] for key in ("seed", "sample_index", "input_sha256")} for row in draws],
+        "limitations": ["Finite new-rival review, not uniqueness against arbitrary programs",
+                        "Only the selected generated lesson and canonical pairs received protected Racket replay",
+                        "No sampler, authority, approval, training admission, or worker assembly was changed"],
+    }
+    assert _sha(source_path.read_bytes()) == source_sha, "Generator changed during audit"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_bytes(_bytes(result))
+    print(json.dumps({"status": result["status"], "draws": 16, "windows": len(windows),
+                      "python_counterexamples": len(findings), "selected": selected,
+                      "protected_execution_count": result["protected_execution_count"],
+                      "out": str(out)}))
+
+
+if __name__ == "__main__":
+    main()
