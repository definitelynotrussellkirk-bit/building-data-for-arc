+"""Bounded, protected-Racket review of count-only XOR candidate matching.
+
+Run from the packet's outer directory with its review.py run wrapper. This
+authoring probe does not repair production source or clear existing audits.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+
+TASK = "5bf6e2e7ed82"
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def count_only_programs(canonical):
+    # Preserve the selected splitter, occupancy extraction, XOR construction
+    # and output rendering. We weaken only spatial equality to equal counts.
+    replacements = (
+        ("(equal? (sort (append", "(= (length (sort (append"),
+        ("cell<) target-occ)", "cell<)) (length target-occ))"),
+    )
+    first = canonical
+    for old, new in replacements:
+        if first.count(old) != 1:
+            raise ValueError("Selected canonical comparison boundary changed")
+        first = first.replace(old, new)
+    if first.count(" cands)))") != 1:
+        raise ValueError("Selected candidate search boundary changed")
+    last = first.replace(" cands)))", " (reverse cands))))")
+    return {"xor_count_first_match": first, "xor_count_last_match": last}
+
+
+def count_only_claim(generator, grid, *, last):
+    facts = generator._analyze(grid)
+    if facts["errors"]:
+        raise ValueError("Discovery draw violates the generator's domain")
+    indices = [index for index, cells in enumerate(facts["candidates"])
+               if len(facts["source"] ^ cells) == len(facts["target"])]
+    # Every lawful unique exact XOR match also satisfies the count condition.
+    if not indices:
+        raise ValueError("A lawful XOR draw must have a count-compatible candidate")
+    return generator._render_candidate(facts, indices[-1] if last else indices[0])
+
+
+def lesson_results(rows, names):
+    """Four consecutive demos and the immediately following ordinary query."""
+    checks = []
+    for seed in (0, 17):
+        pool = [row for row in rows if row["seed"] == seed]
+        for start in range(4):
+            demos, query = pool[start:start + 4], pool[start + 4]
+            checks.append({
+                "seed": seed,
+                "demo_indices": [row["sample_index"] for row in demos],
+                "query_index": query["sample_index"],
+                "rivals": {name: {
+                    "fits_all_four_demos": all(row["outputs"][name] == row["outputs"]["canonical"]
+                                               for row in demos),
+                    "query_differs": query["outputs"][name] != query["outputs"]["canonical"],
+                } for name in names},
+            })
+    return checks
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    generator, generator_path, generator_hash = load_selected_generator(TASK, root=ROOT)
