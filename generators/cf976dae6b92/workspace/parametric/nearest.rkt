(rule! (lambda (g)
         (let* ((p2 (first (find-color g 2)))
                (p4 (first (find-color g 4)))
                (p3 (first (find-color g 3)))
                (r2 (fst p2))
                (c2 (snd p2))
                (r4 (fst p4))
                (c4 (snd p4))
                (r3 (fst p3))
                (c3 (snd p3))
                (d4 (+ (abs (- r4 r2)) (abs (- c4 c2))))
                (d3 (+ (abs (- r3 r2)) (abs (- c3 c2))))
                (relay-is-3 (< d3 d4))
                (rr (if relay-is-3 r3 r4))
                (cr (if relay-is-3 c3 c4))
                (ro (if relay-is-3 r4 r3))
                (co (if relay-is-3 c4 c3)))
           (cellmap g
                    (r c v)
                    (cond
                      ((and (= r r2) (= c c2)) 2)
                      ((and (= r r4) (= c c4)) 4)
                      ((and (= r r3) (= c c3)) 3)
                      ((and (= r r2) (>= c (min c2 cr)) (<= c (max c2 cr))) 5)
                      ((and (= c cr) (>= r (min r2 rr)) (<= r (max r2 rr))) 5)
                      ((and (= r rr) (>= c (min cr co)) (<= c (max cr co))) 5)
                      ((and (= c co) (>= r (min rr ro)) (<= r (max rr ro))) 5)
                      (else 0))))))
