(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (begin
             (define block-cols (quotient w 2))
             (define rings (quotient (* h w) 4))
             (define (source-tile idx)
               (let* ((br (quotient idx block-cols))
                      (bc (modulo idx block-cols))
                      (r0 (* 2 br))
                      (c0 (* 2 bc)))
                 (list (at g r0 c0)
                       (at g r0 (+ c0 1))
                       (at g (+ r0 1) c0)
                       (at g (+ r0 1) (+ c0 1)))))
             (define (rotate-once tile)
               (list (list-ref tile 2)
                     (list-ref tile 0)
                     (list-ref tile 3)
                     (list-ref tile 1)))
             (define (rotate-tile tile turns)
               (if (= turns 0)
                   tile
                   (rotate-tile (rotate-once tile) (- turns 1))))
             (define (minimum-index tile)
               (let ((m (min (list-ref tile 0)
                             (list-ref tile 1)
                             (list-ref tile 2)
                             (list-ref tile 3))))
                 (cond ((= (list-ref tile 0) m) 0)
                       ((= (list-ref tile 1) m) 1)
                       ((= (list-ref tile 2) m) 2)
                       (else 3))))
             (define (orient idx previous acc)
               (if (= idx rings)
                   (reverse acc)
                   (let* ((turns (minimum-index previous))
                          (current (rotate-tile (source-tile idx) turns)))
                     (orient (+ idx 1) current (cons current acc)))))
             (define first-tile (source-tile 0))
             (define tiles (orient 1 first-tile (list first-tile)))
             (define n (* 2 rings))
             (build-grid n
                         n
                         (r c)
                         (let* ((layer (min r c (- n 1 r) (- n 1 c)))
                                (idx (- rings 1 layer))
                                (quadrant (+ (* 2 (if (< r (quotient n 2)) 0 1))
                                             (if (< c (quotient n 2)) 0 1))))
                           (list-ref (list-ref tiles idx) quadrant)))))))