(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((mid (/ h 2))
                  (dots (filter (lambda (p) (!= (at g (fst p) (snd p)) 0))
                                (flatmap (lambda (r)
                                           (map (lambda (c) (cons r c)) (range 0 w)))
                                         (range 0 h))))
                  (d1 (pick-min dots fst))
                  (d2 (second (sort-by dots (lambda (p) (fst p)))))
                  (c1 (at g (fst d1) (snd d1)))
                  (c2 (at g (fst d2) (snd d2)))
                  (r1 (fst d1))
                  (r2 (fst d2)))
             (cellmap g
                      (r c v)
                      (if (< r mid)
                          (cond
                            ((= r r1) c1)
                            ((zero? r) c1)
                            ((or (zero? c) (= c (- w 1))) c1)
                            (else 0))
                          (cond
                            ((= r r2) c2)
                            ((= r (- h 1)) c2)
                            ((or (zero? c) (= c (- w 1))) c2)
                            (else 0))))))))
