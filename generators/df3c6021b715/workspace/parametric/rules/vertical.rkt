(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((mid (/ w 2))
                  (dots (filter (lambda (p) (!= (at g (fst p) (snd p)) 0))
                                (flatmap (lambda (r)
                                           (map (lambda (c) (cons r c)) (range 0 w)))
                                         (range 0 h))))
                  (d1 (pick-min dots snd))
                  (d2 (second (sort-by dots (lambda (p) (snd p)))))
                  (c1 (at g (fst d1) (snd d1)))
                  (c2 (at g (fst d2) (snd d2)))
                  (x1 (snd d1))
                  (x2 (snd d2)))
             (cellmap g
                      (r c v)
                      (if (< c mid)
                          (cond
                            ((= c x1) c1)
                            ((zero? c) c1)
                            ((or (zero? r) (= r (- h 1))) c1)
                            (else 0))
                          (cond
                            ((= c x2) c2)
                            ((= c (- w 1)) c2)
                            ((or (zero? r) (= r (- h 1))) c2)
                            (else 0))))))))
