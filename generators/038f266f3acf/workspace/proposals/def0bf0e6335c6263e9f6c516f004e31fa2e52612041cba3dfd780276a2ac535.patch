+"""Bounded learnability probe for legend-driven transform stamping."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+
+TASK_ID = "12ec29eae990"
+ROOT = find_root(__file__)
+TARGET = ROOT / "generators" / TASK_ID
+PROBE = TARGET / "workspace" / "learnability_probe.py"
+
+
+def _load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_independent_solver_matches_canonical_and_finds_two_demo_ambiguity():
+    probe = _load(PROBE, "_12ec_learnability_probe_test")
+    generator, _, _ = load_selected_generator(TASK_ID, root=ROOT)
+
+    for pair in canonical_pairs(TASK_ID, root=ROOT, labeled_only=True):
+        assert probe.solve(pair["input"]) == pair["output"]
+
+    finding = probe.find_ambiguous_episode(generator, demos=2, max_examples=96)
+    assert finding["rival"] == "swap_rotate_cw_and_transpose"
+    assert len(finding["train"]) == 2
+    assert len(finding["test"]) == 1
+    assert all(row["canonical_output"] == row["rival_output"]
+               for row in finding["train"])
+    assert finding["test"][0]["canonical_output"] != finding["test"][0]["rival_output"]
+    assert finding["test"][0]["disagreement_cells"] >= 8
+    assert finding["examples_examined"] <= 96
+
+
+def test_rival_program_swaps_only_the_two_token_meanings():
+    probe = _load(PROBE, "_12ec_learnability_probe_program_test")
+    program = probe.canonical_program()
+    rival = probe.materialize_swap_rival(program)
+    assert rival != program
+    assert "[(= raw 2) 4]" in rival
+    assert "[(= raw 4) 2]" in rival
+    assert probe.materialize_swap_rival(program) == rival
