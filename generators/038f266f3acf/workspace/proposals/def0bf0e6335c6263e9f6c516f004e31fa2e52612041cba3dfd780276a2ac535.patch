+            "demo_counts": len(demo_counts),
+            "settings": 2,
+            "episodes": len(seeds) * len(demo_counts) * 2,
+            "pairs": pair_total,
+            "failures": 0,
+        },
+        "records": records,
+        "source_sha256": {
