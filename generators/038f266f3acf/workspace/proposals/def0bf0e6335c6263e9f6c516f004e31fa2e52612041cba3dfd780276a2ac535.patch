@@ -0,0 +1,388 @@
+#!/usr/bin/env python3
+"""Find a two-demo lesson that cannot distinguish CW from transpose.
+
+The probe independently implements the legend-stamping rule, constructs the
+nearby executable rival that swaps token meanings 2 and 4, searches only
+ordinary generated inputs, and optionally executes both programs through the
+packet's protected Racket bridge.  It does not modify the production generator.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+
+TASK_ID = "12ec29eae990"
+ROOT = Path(__file__).resolve().parents[3]
+RUNTIME = ROOT / "shared" / "runtime"
+for path in (ROOT / "src", RUNTIME):
+    if str(path) not in sys.path:
+        sys.path.insert(0, str(path))
+
+from reviewer_support import canonical_pairs, load_selected_generator  # noqa: E402
+
+
+TOKENS = (2, 3, 4, 9)
+SWAP = {2: 4, 4: 2, 3: 3, 9: 9}
+
+
+def _grid(value):
+    if (
+        type(value) is not list
+        or not value
+        or type(value[0]) is not list
+        or not value[0]
+    ):
+        raise ValueError("grid must be a nonempty list of rows")
+    width = len(value[0])
+    if any(
+        type(row) is not list
+        or len(row) != width
+        or any(type(cell) is not int or not 0 <= cell <= 9 for cell in row)
+        for row in value
+    ):
+        raise ValueError("grid must be rectangular exact integer colors 0..9")
+    return value
+
+
+def _normalize(cells):
+    if not cells:
+        return []
+    min_row = min(row for row, _ in cells)
+    min_col = min(col for _, col in cells)
+    return sorted((row - min_row, col - min_col) for row, col in cells)
+
+
+def _transform(cells, token):
+    cells = _normalize(cells)
+    if not cells:
+        return []
+    height = max(row for row, _ in cells) + 1
+    width = max(col for _, col in cells) + 1
+    if token == 9:
+        transformed = cells
+    elif token == 2:
+        transformed = [(col, height - 1 - row) for row, col in cells]
+    elif token == 3:
+        transformed = [
+            (height - 1 - row, width - 1 - col) for row, col in cells
+        ]
+    elif token == 4:
+        transformed = [(col, row) for row, col in cells]
+    else:
+        raise ValueError(f"unsupported transform token: {token}")
+    return _normalize(transformed)
+
+
+def solve(grid, *, swap_cw_transpose=False):
+    """Independent transcription of the canonical Racket transformation."""
+    grid = _grid(grid)
+    height, width = len(grid), len(grid[0])
+    if height < 2:
+        raise ValueError("legend-stamping input needs two legend rows")
+    output = [[0 for _ in range(width)] for _ in range(height - 2)]
+    mapping = {}
+    for col in range(width):
+        color, token = grid[1][col], grid[0][col]
+        if color != 0 and token in TOKENS:
+            mapping[color] = SWAP[token] if swap_cw_transpose else token
+    source = _normalize(
+        [
+            (row - 2, col)
+            for row in range(2, height)
+            for col in range(width)
+            if grid[row][col] == 5
+        ]
+    )
+    if not source:
+        return output
+    for row in range(2, height):
+        for col in range(width):
+            color = grid[row][col]
+            if color == 0 or color == 5:
+                continue
+            if color not in mapping:
+                raise ValueError(f"body anchor color {color} is absent from legend")
+            for delta_row, delta_col in _transform(source, mapping[color]):
+                target_row = row - 2 + delta_row
+                target_col = col + delta_col
+                if 0 <= target_row < height - 2 and 0 <= target_col < width:
+                    output[target_row][target_col] = color
+    return output
+
+
+def canonical_program():
+    programs = set()
+    ledger = ROOT / "shared" / "data" / "canonical" / "puzzles.jsonl"
+    with ledger.open(encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                program = row.get("program_solution")
+                if isinstance(program, str):
+                    programs.add(program)
+    if len(programs) != 1:
+        raise ValueError("expected exactly one canonical program")
+    return next(iter(programs))
+
+
+def materialize_swap_rival(program):
+    if not isinstance(program, str):
+        raise TypeError("program must be text")
+    cw = "[(= raw 2) 2]"
+    transpose = "[(= raw 4) 4]"
+    if program.count(cw) != 1 or program.count(transpose) != 1:
+        raise ValueError("canonical token-map edit sites changed")
+    sentinel_cw = "[(= raw 2) __SWAP_CW_TRANSPOSE_SENTINEL__]"
+    sentinel_tr = "[(= raw 4) __SWAP_TRANSPOSE_CW_SENTINEL__]"
+    rival = program.replace(cw, sentinel_cw).replace(transpose, sentinel_tr)
+    return rival.replace(sentinel_cw, "[(= raw 2) 4]").replace(
+        sentinel_tr, "[(= raw 4) 2]"
+    )
+
+
+def _difference(left, right):
+    _grid(left)
+    _grid(right)
+    if (len(left), len(left[0])) != (len(right), len(right[0])):
+        raise ValueError("outputs have different dimensions")
+    return sum(
+        a != b
+        for left_row, right_row in zip(left, right)
+        for a, b in zip(left_row, right_row)
+    )
+
+
+def _legend_tokens(grid):
+    return [value for value in grid[0] if value in TOKENS]
+
+
+def _record(index, grid, canonical_output, rival_output):
+    return {
+        "draw_index": index,
+        "seed": 730_000 + index,
+        "sample_index": 17 * index + 3,
+        "difficulty": ("easy", "medium", "hard")[index % 3],
+        "legend_tokens": _legend_tokens(grid),
+        "input": copy.deepcopy(grid),
+        "canonical_output": canonical_output,
+        "rival_output": rival_output,
+        "disagreement_cells": _difference(canonical_output, rival_output),
+    }
+
+
+def find_ambiguous_episode(generator, *, demos=2, max_examples=96):
+    if type(demos) is not int or not 2 <= demos <= 6:
+        raise ValueError("demos must be an exact integer in 2..6")
+    if type(max_examples) is not int or not demos + 1 <= max_examples <= 10000:
+        raise ValueError("max_examples must be a sufficient exact integer")
+    agreeing = []
+    disagreeing = None
+    seen = set()
+    for index in range(max_examples):
+        difficulty = ("easy", "medium", "hard")[index % 3]
+        grid = generator.generate(
+            730_000 + index,
+            17 * index + 3,
+            difficulty=difficulty,
+        )
+        digest = hashlib.sha256(
+            json.dumps(grid, separators=(",", ":")).encode()
+        ).hexdigest()
+        if digest in seen:
+            raise AssertionError("generator repeated an input in bounded probe")
+        seen.add(digest)
+        canonical_output = solve(grid)
+        rival_output = solve(grid, swap_cw_transpose=True)
+        record = _record(index, grid, canonical_output, rival_output)
+        # The agreement must exercise at least one of the two confused tokens;
+        # otherwise an all-identity lesson would be a weaker witness.
+        exercises_swap = any(token in (2, 4) for token in record["legend_tokens"])
+        if canonical_output == rival_output and exercises_swap and len(agreeing) < demos:
+            agreeing.append(record)
+        elif canonical_output != rival_output:
+            if (disagreeing is None
+                    or record["disagreement_cells"] > disagreeing["disagreement_cells"]):
+                disagreeing = record
+    if len(agreeing) == demos and disagreeing is not None:
+        return {
+            "rival": "swap_rotate_cw_and_transpose",
+            "train": agreeing,
+            "test": [disagreeing],
+            "examples_examined": max_examples,
+        }
+    raise RuntimeError(
+        f"no {demos}-demo ambiguity plus disagreeing query in {max_examples} draws"
+    )
+
+
+def survey(generator, *, count=512):
+    if type(count) is not int or not 1 <= count <= 10000:
+        raise ValueError("survey count must be an exact integer in 1..10000")
+    agreements = Counter()
+    for index in range(count):
+        difficulty = ("easy", "medium", "hard")[index % 3]
+        grid = generator.generate(
+            910_000 + index,
+            31 * index + 5,
+            difficulty=difficulty,
+        )
+        same = solve(grid) == solve(grid, swap_cw_transpose=True)
+        agreements["total"] += 1
+        agreements["agreements"] += same
+        agreements[f"{difficulty}_total"] += 1
+        agreements[f"{difficulty}_agreements"] += same
+    return dict(agreements)
+
+
+def _racket_outputs(program, grids):
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    wrapped = wrap_rule(program)
+    bridge = RacketBridge(timeout=30.0)
+    try:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires protected Racket")
+        outputs = []
+        for grid in grids:
+            literal = "'(" + " ".join(
+                "(" + " ".join(map(str, row)) + ")" for row in grid
+            ) + ")"
+            outputs.append(bridge.eval_text(f"({wrapped} {literal})"))
+        return outputs, {
+            key: identity[key]
+            for key in (
+                "schema",
+                "backend",
+                "protected",
+                "binary_sha256",
+                "prelude_sha256",
+                "bridge_sha256",
+                "boot_script_sha256",
+                "candidate_symbol_policy_sha256",
+            )
+            if key in identity
+        }
+    finally:
+        bridge.close()
+
+
+def build_report(*, demos=2, max_examples=96, survey_count=512):
+    generator, source_path, generator_sha256 = load_selected_generator(
+        TASK_ID, root=ROOT
+    )
+    finding = find_ambiguous_episode(
+        generator, demos=demos, max_examples=max_examples
+    )
+    program = canonical_program()
+    rival_program = materialize_swap_rival(program)
+    rows = finding["train"] + finding["test"]
+    grids = [row["input"] for row in rows]
+    canonical_outputs, identity = _racket_outputs(program, grids)
+    rival_outputs, rival_identity = _racket_outputs(rival_program, grids)
+    if identity != rival_identity:
+        raise RuntimeError("Racket runtime identity changed between programs")
+    for row, canonical_output, rival_output in zip(
+        rows, canonical_outputs, rival_outputs
+    ):
+        if canonical_output != row["canonical_output"]:
+            raise RuntimeError("independent canonical solver disagrees with Racket")
+        if rival_output != row["rival_output"]:
+            raise RuntimeError("independent rival solver disagrees with Racket")
+
+    canonical = canonical_pairs(TASK_ID, root=ROOT, labeled_only=True)
+    canonical_agreements = sum(
+        solve(pair["input"], swap_cw_transpose=True) == pair["output"]
+        for pair in canonical
+    )
+    finding["train_racket_fit"] = all(
+        row["canonical_output"] == row["rival_output"]
+        for row in finding["train"]
+    )
+    finding["query_racket_disagreement"] = (
+        finding["test"][0]["canonical_output"]
+        != finding["test"][0]["rival_output"]
+    )
+    return {
+        "schema": "12ec29eae990-learnability-probe-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "generator_sha256": generator_sha256,
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "rival_program_sha256": hashlib.sha256(rival_program.encode()).hexdigest(),
+        "racket": identity,
+        "racket_evaluations": 2 * len(rows),
+        "canonical_pairs": {
+            "labeled": len(canonical),
+            "rival_agreements": canonical_agreements,
+        },
+        "survey": survey(generator, count=survey_count),
+        "finding": finding,
+        "programs": {
+            "canonical": program,
+            "swap_rotate_cw_and_transpose": rival_program,
+        },
+        "suggested_repair": (
+            "At episode assembly, require at least one visible demonstration where "
+            "tokens 2 and 4 produce different unclipped stamps. A constructive option "
+            "is an asymmetric motif plus an interior anchor for a 2-or-4 token; retain "
+            "the current query diversity after the finite rival is rejected."
+        ),
+        "limits": (
+            "One finite executable rival and deterministic generated draws; this is "
+            "not a universal ambiguity proof, owner acceptance, or training admission."
+        ),
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--demos", type=int, default=2)
+    parser.add_argument("--max-examples", type=int, default=96)
+    parser.add_argument("--survey", type=int, default=512)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    try:
+        report = build_report(
+            demos=args.demos,
+            max_examples=args.max_examples,
+            survey_count=args.survey,
+        )
+        if args.out.exists() or args.out.is_symlink():
+            raise FileExistsError(f"Choose a new output path: {args.out}")
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(
+            json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
+        )
+    except (OSError, ValueError, RuntimeError, AssertionError, TypeError) as error:
+        parser.error(str(error))
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "examples_examined": report["finding"]["examples_examined"],
+                "demo_count": len(report["finding"]["train"]),
+                "query_disagreement_cells": report["finding"]["test"][0][
+                    "disagreement_cells"
+                ],
+                "survey": report["survey"],
+                "racket_evaluations": report["racket_evaluations"],
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
