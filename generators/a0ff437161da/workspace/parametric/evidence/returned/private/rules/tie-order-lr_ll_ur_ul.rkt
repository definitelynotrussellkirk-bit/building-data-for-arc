(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((bg 8)
                  (cell (find-first (lambda (p) (!= (at g (fst p) (snd p)) bg))
                                    (flatmap (lambda (r)
                                               (map (lambda (c) (cons r c)) (range 0 w)))
                                             (range 0 h))))
                  (cr (fst cell))
                  (cc (snd cell))
                  (color (at g cr cc))
                  (corners (list (cons (- h 1) (- w 1))
                                 (cons (- h 1) 0)
                                 (cons 0 (- w 1))
                                 (cons 0 0)))
                  (nearest (first (sort-by corners
                                           (lambda (p)
                                             (+ (abs (- cr (fst p)))
                                                (abs (- cc (snd p))))))))
                  (nr (fst nearest))
                  (nc (snd nearest))
                  (r1 (min cr nr))
                  (r2 (max cr nr))
                  (c1 (min cc nc))
                  (c2 (max cc nc)))
             (cellmap g
                      (r c v)
                      (if (and (>= r r1) (<= r r2) (>= c c1) (<= c c2)) color v))))))
