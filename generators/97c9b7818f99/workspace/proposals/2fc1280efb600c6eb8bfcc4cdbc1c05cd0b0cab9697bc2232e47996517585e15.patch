+#!/usr/bin/env python3
+"""Source-bound semantic and finite-rival audit for 50a1b00ebe2f.
+
+This utility is intentionally task-local so a future reviewer can rerun the same
+bounded checks against the exact selected generator bytes.  It verifies Python
+oracle parity, per-example separation from six plausible Boolean shortcuts, and
+a representative set of labels through the protected canonical Racket rule.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Callable
+
+from arc_repl.racket_bridge import RacketBridge
+from arcpuzzles import Catalog
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_pairs, load_selected_generator
+
+TASK = "50a1b00ebe2f"
+
+
+def oracle(grid):
+    return [
+        [8 if grid[row][col] != 0 or grid[row][col + 5] != 0 else 0 for col in range(4)]
+        for row in range(len(grid))
+    ]
+
+
+def left_only(grid):
+    return [[8 if grid[row][col] != 0 else 0 for col in range(4)] for row in range(len(grid))]
+
+
+def right_only(grid):
+    return [[8 if grid[row][col + 5] != 0 else 0 for col in range(4)] for row in range(len(grid))]
+
+
+def conjunction(grid):
+    return [[8 if grid[row][col] != 0 and grid[row][col + 5] != 0 else 0 for col in range(4)] for row in range(len(grid))]
+
+
+def exclusive_or(grid):
+    return [[8 if (grid[row][col] != 0) != (grid[row][col + 5] != 0) else 0 for col in range(4)] for row in range(len(grid))]
+
+
+def solid_fill(grid):
+    return [[8] * 4 for _ in grid]
+
+
+def preserve_source_color(grid):
+    return [
+        [grid[row][col] or grid[row][col + 5] for col in range(4)]
+        for row in range(len(grid))
+    ]
+
+
+RIVALS: dict[str, Callable] = {
+    "left_only": left_only,
+    "right_only": right_only,
+    "and": conjunction,
+    "xor": exclusive_or,
+    "solid_fill": solid_fill,
+    "preserve_source_color": preserve_source_color,
+}
+
+
+def unique_program(root: Path) -> str:
+    record = Catalog(root).get(TASK)
+    programs = {
+        variant["program_solution"]
+        for variant in record["variants"]
+        if isinstance(variant.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def evaluate_racket(bridge: RacketBridge, wrapped_program: str, grid, index: int):
+    name = f"peer50-case-{index}"
+    bridge.define_grid(name, grid)
+    return bridge.eval_text(f"({wrapped_program} {name})")
+
+
+def run(root: Path) -> dict:
+    module, source, source_sha256 = load_selected_generator(TASK, root=root)
+    program = unique_program(root)
+    wrapped_program = wrap_rule(program)
+    failures: list[str] = []
+    rival_defeats = {name: 0 for name in RIVALS}
+    generated = []
+    seen_inputs = set()
+    seen_outputs = set()
+
+    difficulties = (None, "easy", "medium", "hard")
+    profiles = tuple(module.TRUTH_PROFILES)
+    for difficulty in difficulties:
+        for seed in range(8):
+            for profile_index, profile in enumerate(profiles):
+                grid = module.generate(seed, profile_index, difficulty=difficulty, truth_profile=profile)
+                expected = oracle(grid)
+                errors = module.self_check(grid)
+                if errors:
+                    failures.append(f"generated {difficulty}/{seed}/{profile}: {errors}")
+                if module.rule_mirror(grid) != expected:
+                    failures.append(f"Python mirror mismatch for {difficulty}/{seed}/{profile}")
+                for name, rival in RIVALS.items():
+                    if rival(grid) == expected:
+                        failures.append(f"rival {name} survived {difficulty}/{seed}/{profile}")
+                    else:
+                        rival_defeats[name] += 1
+                generated.append(
+                    {
+                        "difficulty": difficulty,
+                        "seed": seed,
+                        "sample_index": profile_index,
+                        "profile": profile,
+                        "grid": grid,
+                        "output": expected,
+                    }
+                )
+                seen_inputs.add(tuple(map(tuple, grid)))
+                seen_outputs.add(tuple(map(tuple, expected)))
+
+    boundary_specs = (
+        {"grid_h": 2, "or_count": 6, "truth_profile": "balanced"},
+        {"grid_h": 2, "or_count": 7, "truth_profile": "overlap_heavy"},
+        {"grid_h": 30, "or_count": 6, "truth_profile": "left_heavy"},
+        {"grid_h": 30, "or_count": 119, "truth_profile": "right_heavy"},
+    )
+    boundaries = []
+    for index, overrides in enumerate(boundary_specs):
+        grid = module.generate(900 + index, index, **overrides)
+        expected = oracle(grid)
+        observed = module.observe_overrides(grid)
+        if module.rule_mirror(grid) != expected or module.self_check(grid):
+            failures.append(f"boundary {index} failed mirror/self-check")
+        for key, value in overrides.items():
+            if observed.get(key) != value:
+                failures.append(f"boundary {index} did not expose {key}={value!r}: {observed}")
+        boundaries.append({"overrides": overrides, "observed": observed, "grid": grid, "output": expected})
+
+    canonical = canonical_pairs(TASK, root=root, labeled_only=True)
+    for index, pair in enumerate(canonical):
+        if oracle(pair["input"]) != pair["output"]:
+            failures.append(f"canonical Python oracle mismatch at pair {index}")
+        if module.rule_mirror(pair["input"]) != pair["output"]:
+            failures.append(f"canonical module mirror mismatch at pair {index}")
+
+    racket_cases = [
+        {"kind": "canonical", "name": f"canonical-{index}", "grid": pair["input"], "expected": pair["output"]}
+        for index, pair in enumerate(canonical)
+    ]
+    # Cover all profiles, all difficulty labels, and both exact height extremes.
+    racket_cases.extend(
+        {
+            "kind": "generated",
+            "name": f"generated-{index}",
+            "grid": case["grid"],
+            "expected": case["output"],
+        }
+        for index, case in enumerate(generated[:16])
+    )
+    racket_cases.extend(
+        {
+            "kind": "boundary",
+            "name": f"boundary-{index}",
+            "grid": case["grid"],
+            "expected": case["output"],
+        }
+        for index, case in enumerate(boundaries)
+    )
+
+    racket_rows = []
+    with RacketBridge(timeout=20, max_calls_before_restart=64) as bridge:
+        runtime = bridge.runtime_identity
+        for index, case in enumerate(racket_cases):
+            actual = evaluate_racket(bridge, wrapped_program, case["grid"], index)
+            if actual != case["expected"]:
+                failures.append(f"protected Racket mismatch for {case['name']}")
+            racket_rows.append({"kind": case["kind"], "name": case["name"], "matched": actual == case["expected"]})
+
+    return {
+        "schema": "50a1b00ebe2f-adversarial-review-v1",
+        "status": "passed" if not failures else "failed",
+        "task_id": TASK,
+        "generator_version": module.VERSION,
+        "source_path": source.relative_to(root).as_posix(),
+        "source_sha256": source_sha256,
+        "rule_hash": module.RULE_HASH,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "generated_cases": len(generated),
+        "unique_generated_inputs": len(seen_inputs),
+        "unique_generated_outputs": len(seen_outputs),
+        "boundary_cases": len(boundaries),
+        "canonical_pairs": len(canonical),
+        "rival_defeats": rival_defeats,
+        "racket_evaluations": len(racket_rows),
+        "racket_rows": racket_rows,
+        "racket_runtime": runtime,
+        "failures": failures,
+        "scope": "Finite six-rival audit plus representative protected-Racket parity; not a proof of universal rule uniqueness.",
+        "training_admitted": False,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path.cwd().resolve()
+    report = run(root)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "generated_cases": report["generated_cases"],
+                "unique_generated_inputs": report["unique_generated_inputs"],
+                "unique_generated_outputs": report["unique_generated_outputs"],
+                "rival_defeats": report["rival_defeats"],
+                "racket_evaluations": report["racket_evaluations"],
+                "failures": report["failures"],
+            },
+            sort_keys=True,
+        )
+    )
+    return 0 if report["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
