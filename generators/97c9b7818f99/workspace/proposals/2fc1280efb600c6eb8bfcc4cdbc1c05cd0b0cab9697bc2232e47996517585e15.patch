+) -> list[list[int]]:
+    grid = full_grid(height, 9, 0)
+    for row in range(height):
+        grid[row][4] = sep_color
+
+    coordinates = [(row, col) for row in range(height) for col in range(4)]
+    rng.shuffle(coordinates)
+    occupied = coordinates[:or_count]
+
+    left_count, right_count, both_count = _profile_counts(or_count, truth_profile)
+    categories = (["left"] * left_count + ["right"] * right_count + ["both"] * both_count)
+    rng.shuffle(categories)
+    for (row, col), category in zip(occupied, categories):
+        if category in ("left", "both"):
+            grid[row][col] = left_color
+        if category in ("right", "both"):
+            grid[row][col + 5] = right_color
+    return grid
+
+
+def _valid_grid(grid: Any) -> list[str]:
+    errors: list[str] = []
+    if not isinstance(grid, list) or not grid:
+        return ["grid must be a nonempty list"]
+    if not 2 <= len(grid) <= 30:
+        errors.append(f"height must be in 2..30, got {len(grid)}")
+
+    if any(not isinstance(row, list) for row in grid):
+        errors.append("every row must be a list")
+        return errors
+    widths = {len(row) for row in grid}
+    if widths != {9}:
+        errors.append(f"every row must have width 9, got {sorted(widths)}")
+        return errors
+    if any(type(value) is not int or not 0 <= value <= 9 for row in grid for value in row):
+        errors.append("grid values must be integer colors 0..9 (not bool)")
+        return errors
+
+    separator = {row[4] for row in grid}
+    if len(separator) != 1 or 0 in separator:
+        errors.append("separator column 4 must be one uniform nonzero color")
+
+    left_palette = {grid[row][col] for row in range(len(grid)) for col in range(4) if grid[row][col] != 0}
+    right_palette = {grid[row][col + 5] for row in range(len(grid)) for col in range(4) if grid[row][col + 5] != 0}
+    if len(left_palette) != 1:
+        errors.append(f"left panel must use exactly one nonzero color, got {sorted(left_palette)}")
+    if len(right_palette) != 1:
+        errors.append(f"right panel must use exactly one nonzero color, got {sorted(right_palette)}")
+
+    signatures = {
+        (grid[row][col] != 0, grid[row][col + 5] != 0)
+        for row in range(len(grid))
+        for col in range(4)
+    }
+    missing = set(_SIGNATURES) - signatures
+    if missing:
+        errors.append(f"missing aligned occupancy signature(s): {sorted(missing)}")
+    return errors
+
+
+def _signature_counts(grid: list[list[int]]) -> dict[tuple[bool, bool], int]:
+    counts = {signature: 0 for signature in _SIGNATURES}
+    for row in range(len(grid)):
+        for col in range(4):
+            counts[(grid[row][col] != 0, grid[row][col + 5] != 0)] += 1
+    return counts
+
+
+def _infer_truth_profile(grid: list[list[int]]) -> str | None:
+    counts = _signature_counts(grid)
+    left = counts[(True, False)]
+    right = counts[(False, True)]
+    both = counts[(True, True)]
+    if max(left, right, both) - min(left, right, both) <= 1:
+        return "balanced"
+    if right == both == 1 and left > 1:
+        return "left_heavy"
+    if left == both == 1 and right > 1:
+        return "right_heavy"
+    if left == right == 1 and both > 1:
+        return "overlap_heavy"
+    return None
+
 
