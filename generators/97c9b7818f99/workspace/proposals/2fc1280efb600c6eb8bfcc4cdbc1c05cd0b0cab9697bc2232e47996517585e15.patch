+def _validate_call(seed: Any, sample_index: Any, difficulty: Any, overrides: dict[str, Any]) -> None:
+    if type(seed) is not int:
+        raise TypeError("seed must be an integer (not bool)")
+    if type(sample_index) is not int or sample_index < 0:
+        raise TypeError("sample_index must be a nonnegative integer (not bool)")
+    if difficulty not in _ALLOWED_DIFFICULTIES:
+        raise ValueError(f"unknown difficulty: {difficulty!r}")
+    unknown = sorted(set(overrides) - _ALLOWED_OVERRIDES)
+    if unknown:
+        raise ValueError("unknown override(s): " + ", ".join(unknown))
+
+
+def _profile_counts(or_count: int, profile: str) -> tuple[int, int, int]:
+    """Return exact (left-only, right-only, both) counts."""
+    if profile == "balanced":
+        quotient, remainder = divmod(or_count, 3)
+        counts = [quotient, quotient, quotient]
+        for index in range(remainder):
+            counts[index] += 1
+        return tuple(counts)  # type: ignore[return-value]
+    if profile == "left_heavy":
+        return or_count - 2, 1, 1
+    if profile == "right_heavy":
+        return 1, or_count - 2, 1
+    if profile == "overlap_heavy":
+        return 1, 1, or_count - 2
+    raise ValueError(f"unknown truth_profile: {profile!r}")
+
+
+def _build_grid(
