+from __future__ import annotations
+
+import copy
+import importlib
+import random
+
+import pytest
+
+from reviewer_support import canonical_pairs as load_canonical_pairs, find_root
+
+
+TASK = "50a1b00ebe2f"
+MODULE = importlib.import_module(f"puzzle_generators.per_puzzle.{TASK}.generator")
+ROOT = find_root(__file__)
+
+
+def canonical_pairs():
+    return load_canonical_pairs(TASK, root=ROOT, labeled_only=True)
+
+
+def independent_oracle(grid):
+    return [
+        [8 if grid[row][col] != 0 or grid[row][col + 5] != 0 else 0 for col in range(4)]
+        for row in range(len(grid))
+    ]
+
+
+def occupancy_signatures(grid):
+    return {
+        (grid[row][col] != 0, grid[row][col + 5] != 0)
+        for row in range(len(grid))
+        for col in range(4)
+    }
+
+
+def left_only(grid):
+    return [[8 if grid[row][col] != 0 else 0 for col in range(4)] for row in range(len(grid))]
+
+
+def right_only(grid):
+    return [[8 if grid[row][col + 5] != 0 else 0 for col in range(4)] for row in range(len(grid))]
+
+
+def conjunction(grid):
+    return [[8 if grid[row][col] != 0 and grid[row][col + 5] != 0 else 0 for col in range(4)] for row in range(len(grid))]
+
+
+def exclusive_or(grid):
+    return [[8 if (grid[row][col] != 0) != (grid[row][col + 5] != 0) else 0 for col in range(4)] for row in range(len(grid))]
+
+
+def signature_counts(grid):
+    counts = {(False, False): 0, (True, False): 0, (False, True): 0, (True, True): 0}
+    for row in range(len(grid)):
+        for col in range(4):
+            counts[(grid[row][col] != 0, grid[row][col + 5] != 0)] += 1
+    return counts
+
+
+@pytest.mark.parametrize("pair", canonical_pairs())
+def test_every_canonical_pair_matches_independent_oracle(pair):
+    assert independent_oracle(pair["input"]) == pair["output"]
+    assert MODULE.rule_mirror(pair["input"]) == pair["output"]
+    assert not MODULE.self_check(pair["input"])
+
+
+@pytest.mark.parametrize("difficulty", [None, "easy", "medium", "hard"])
+@pytest.mark.parametrize("profile", ["balanced", "left_heavy", "right_heavy", "overlap_heavy"])
+def test_each_profile_is_strict_and_individually_refutes_boolean_shortcuts(difficulty, profile):
+    grid = MODULE.generate(7_000 + len(profile), 11, difficulty=difficulty, truth_profile=profile)
+    expected = independent_oracle(grid)
+    assert not MODULE.self_check(grid)
+    assert MODULE.rule_mirror(grid) == expected
+    assert occupancy_signatures(grid) == {(False, False), (True, False), (False, True), (True, True)}
