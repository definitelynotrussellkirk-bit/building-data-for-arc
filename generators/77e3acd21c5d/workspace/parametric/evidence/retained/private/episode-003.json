{"canonical_program_sha256":"a85716c73ec0707204db97aa851d949370e884e0e78763e446fb0bfb568684ef","draws":[{"marker_mode":"row_tie","profile":"large6","sample_index":0},{"marker_mode":"col_tie","profile":"compact4","sample_index":1},{"marker_mode":"corner","profile":"stack3","sample_index":2},{"marker_mode":"both_tie","profile":"wide4","sample_index":3},{"marker_mode":"clipped","profile":"large6","sample_index":4},{"marker_mode":"both_tie","profile":"compact4","sample_index":5}],"input_seed":8569211593414761443,"input_sha256":["101f7e20a9d41e21fa3fadd5615a6a6cba8c39968bd86f1b9234d6f330f7bd5e","d6367dd6f72ea639b6661fef149c9990ec438a271c91edaf5ef5b1bb2f1f93c2","ec756d1f6b5ff6073220c8ea7117a5a7fad6f975a158aab91b73e5a3dd2f68fa","5af18868ae615ce11e3850c0433cf6b58431ab883af13a23a2310042a2d1f7e4","39526470dc340c7098b8874f3a95d1d5bc771fdc38dbbf001cea0ad43f39e399","f4566ff8001dd3c6a3701cec583f075a5c3b0cbb093c4ab8d04c9c5b1066f1cb"],"label_applications":54,"label_backend":"racket","limitations":"Finite evidence against these nine settings only; no universal identifiability or production approval claim.","output_sha256":["0030f448646734a19b1640a13671f01ff1779e086d5d96a86d25b82050251f6a","41b4f53f332c742a17c6a3abae19d77575727893001b1a3091a69cd839e7b02e","edd8d7c663187bb95fee179510ba80027c96263ee83046810fd0e0c506dc1dd7","a5005c43cbd0ed91bd406c69ff7a26add17a57ee45ee8ba7d6454e673dfd9264","406c30e5b7e163beb393d15021aa357ea9d28e0a28b94c9de196f5f4224c03eb","2d34993271d8223896d2300e6aaa83da99cf68d26c06f2af8997862a3e8e1737"],"parameter_selection":"seeded","parameters":{"column_ties":"both","row_ties":"low"},"program":"(rule!\n ;; Two rectangles: a plain EMPTY one and a (widest) SOURCE stamped\n ;; with marker dots. Rebuild the empty rectangle with the markers\n ;; transferred edge-relative: each marker keeps its distance to its\n ;; NEAREST edge on each axis; an exact tie mirrors it to both sides.\n (lambda (g)\n   (let ()\n     (define bg (at g 0 0))\n     (define objs (objects-multicolor g bg))\n     (define (colors-of o)\n       (unique (map (lambda (p) (at g (first p) (second p)))\n                    (obj-cells o))))\n     (define blank (find (lambda (o) (= 1 (length (colors-of o)))) objs))\n     (define blank-color (first (colors-of blank)))\n     (define eh (obj-h blank))\n     (define ew (obj-w blank))\n     (define source\n       (pick-max (filter (lambda (o) (> (length (colors-of o)) 1)) objs)\n                 obj-w))\n     (define rect-color  ;; the source's majority (frame) color\n       (pick-max (colors-of source)\n                 (lambda (c) (count-if (lambda (p)\n                                         (= (at g (first p) (second p))\n                                            c))\n                                       (obj-cells source)))))\n     (define marker-color\n       (find-first (lambda (c) (not (= c rect-color)))\n                   (colors-of source)))\n     (define markers  ;; marker positions relative to the source bbox\n       (map (lambda (p) (list (- (first p) (obj-r1 source))\n                              (- (second p) (obj-c1 source))))\n            (filter (lambda (p) (= (at g (first p) (second p))\n                                   marker-color))\n                    (obj-cells source))))\n     (define (anchors mr mc)  ;; landing spots in the empty rectangle\n       (let* ((bot (- (obj-h source) 1 mr))\n              (right (- (obj-w source) 1 mc))\n              (rrs (cond ((< mr bot) (list mr))\n                         ((> mr bot) (list (- eh 1 bot)))\n                         (else (list mr))))\n              (ccs (cond ((< mc right) (list mc))\n                         ((> mc right) (list (- ew 1 right)))\n                         (else (list mc (- ew 1 right))))))\n         (filter (lambda (rc) (in-bounds? (first rc) (second rc) eh ew))\n                 (for*/list ((r rrs) (c ccs)) (list r c)))))\n     (paint-cells (empty-grid eh ew blank-color)\n                  (flatmap (lambda (m) (anchors (first m) (second m)))\n                           markers)\n                  marker-color))))","program_sha256":"42c48dd855ba62196e2d83a042366b1d610edf0d1d6acdf72df4ba237cdc1de2","public_sha256":"70616da196bfe375b78b0bff484960080e7e07f371ec53cd7b21db80694f14a4","rejections":[],"rivals":{"rows-both_columns-both":{"demo_matches":[false,true,true,false,true],"first_refuting_demo":0,"first_refuting_output":[[2,2,2,2,2,2,2,2,2],[2,1,2,2,2,2,2,2,2],[2,2,2,2,2,2,2,1,2],[2,2,2,2,2,2,2,2,2],[2,2,2,2,2,2,2,1,2],[2,1,2,2,2,2,2,2,2],[2,2,2,2,2,2,2,2,2]],"output_sha256":["045e8cfb8aabc261d6c202bba7ac1e994d88b93a4b90c9eb30e059bd1f2c94bc","41b4f53f332c742a17c6a3abae19d77575727893001b1a3091a69cd839e7b02e","edd8d7c663187bb95fee179510ba80027c96263ee83046810fd0e0c506dc1dd7","2216af5f6c9f665e2a61909875ce135d00add53086053f6da8e990d37fc36f0f","406c30e5b7e163beb393d15021aa357ea9d28e0a28b94c9de196f5f4224c03eb","00ca4d73c47378a44ccee60685d77d3a253291d49efcfb51a29b86861441f17a"],"parameters":{"column_ties":"both","row_ties":"both"},"program_sha256":"a85716c73ec0707204db97aa851d949370e884e0e78763e446fb0bfb568684ef","query_matches":[false],"status":"eliminated"},"rows-both_columns-high":{"demo_matches":[false,false,true,false,true],"first_refuting_demo":0,"first_refuting_output":[[2,2,2,2,2,2,2,2,2],[2,1,2,2,2,2,2,2,2],[2,2,2,2,2,2,2,1,2],[2,2,2,2,2,2,2,2,2],[2,2,2,2,2,2,2,1,2],[2,1,2,2,2,2,2,2,2],[2,2,2,2,2,2,2,2,2]],"output_sha256":["045e8cfb8aabc261d6c202bba7ac1e994d88b93a4b90c9eb30e059bd1f2c94bc","276cb71b33c9895471ada93adb1fbb9780978b81394625ea23a39689a1f3e008","edd8d7c663187bb95fee179510ba80027c96263ee83046810fd0e0c506dc1dd7","3f327f2f1310fdbdf0360160d93c15930501ac6f54a58adfe7ec20bdc41eb870","406c30e5b7e163beb393d15021aa357ea9d28e0a28b94c9de196f5f4224c03eb","fc3147d2a37d84e85a2b7d2fc6c23bd649270a68caf23b54142f92fae6a2f471"],"parameters":{"column_ties":"high","row_ties":"both"},"program_sha256":"31f0eea4ffd75dbe8c1012ad956e95495c4b23b0e3a3d722dd7ea8cec4629478","query_matches":[false],"status":"