(rule! (lambda (g)
         (let ((h (rows g))
               (w (cols g)))
           (let ((objs (objects-multicolor g 0)))
             (let ((diag (first (sort-by objs (lambda (o) (- 0 (obj-size o)))))))
               (let ((diag-cells (obj-cells diag)))
                 (let ((isolated (filter (lambda (p)
                                           (not (for/or ((d diag-cells))
                                                        (and
                                                          (= (first d) (first p))
                                                          (= (second d) (second p))))))
                                         (filter (lambda (p)
                                                   (not (zero? (at g
                                                                   (first p)
                                                                   (second p)))))
                                                 (reduce append
                                                         (list)
                                                         (map (lambda (r)
                                                                (map (lambda (c)
                                                                       (list r c))
                                                                     (range 0 w)))
                                                              (range 0 h)))))))
                   (let* ((n (- (length isolated) 1))
                          (isolated-colors (map (lambda (p) (at g (first p) (second p)))
                                                isolated))
                          (color-count (lambda (v)
                                         (length (filter (lambda (p)
                                                           (= (at g
                                                                  (first p)
                                                                  (second p))
                                                              v))
                                                         isolated))))
                          (first-index (lambda (v)
                                         (let ((p (first (filter (lambda (p2)
                                                                   (= (at g
                                                                          (first p2)
                                                                          (second p2))
                                                                      v))
                                                                 isolated))))
                                           (+ (* (first p) w) (second p)))))
                          (tri-color (first (sort (unique isolated-colors)
                                                  (lambda (a b)
                                                    (let ((ca (color-count a))
                                                          (cb (color-count b)))
                                                      (if (= ca cb)
                                                          (< (first-index a)
                                                             (first-index b))
                                                          (> ca cb))))))))
                     (let ((corner (find (lambda (p)
                                           (or
                                             (and (zero? (first p)) (zero? (second p)))
                                             (and
                                               (zero? (first p))
                                               (= (second p) (- w 1)))
                                             (and
                                               (= (first p) (- h 1))
                                               (zero? (second p)))
                                             (and
                                               (= (first p) (- h 1))
                                               (= (second p) (- w 1)))))
                                         isolated)))
                       (if (not corner)
                           g
                           (let ((cr (first corner))
                                 (cc (second corner)))
                             (let ((base (reduce (lambda (gg d)
                                                   (set-cell gg
                                                             (first d)
                                                             (second d)
                                                             (at g (first d) (second d))))
                                                 (grid-from-fn h w (lambda (r c) 0))
                                                 diag-cells)))
                               (reduce (lambda (gg i)
                                         (let ((num (- n i)))
                                           (reduce (lambda (gg2 j)
                                                     (let ((tr (if (zero? cr)
                                                                   i
                                                                   (- (- h 1) i)))
                                                           (tc (if (zero? cc)
                                                                   j
                                                                   (- (- w 1) j))))
                                                       (set-cell gg2 tr tc tri-color)))
                                                   gg
                                                   (range 0 num))))
                                       base
                                       (range 0 n))))))))))))))