usage: arcpuzzles authority-sync [-h] --selected-only [--out OUT]
                                 [--apply REVIEWED_PROPOSAL.json]
                                 id

positional arguments:
  id

options:
  -h, --help            show this help message and exit
  --selected-only       canonical program_solution to selected target_code;
                        preserves archival raw_code
  --out OUT             new JSON proposal file; refuses to overwrite
  --apply REVIEWED_PROPOSAL.json
                        explicitly apply this exact current dry-run proposal;
                        retains recovery snapshots
