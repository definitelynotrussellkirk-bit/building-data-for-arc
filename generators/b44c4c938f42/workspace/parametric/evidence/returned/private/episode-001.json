      "text": "(rule!\n  ;; alt: split by all-zero separators, take each panel's largest non-8 object,\n  ;;      then greedily place largest-first on the shared 8-background canvas.\n  (let* ((sep-cols (filter (lambda (c) (all? (lambda (r) (zero? (at g r c))) (range h)))\n                           (range w)))\n         (starts (cons 0 (map add1 sep-cols)))\n         (ends (append sep-cols (list w)))\n         (spans (filter (lambda (se) (< (first se) (second se))) (map list starts ends)))\n         (parts (map (lambda (se) (subgrid g 0 (first se) (- h 1) (- (second se) 1))) spans))\n         (out-w (cols (first parts)))\n         (shifts (list (list 0 0) (list 0 1) (list 0 -1) (list -1 0) (list 1 0)\n                       (list -1 1) (list -1 -1) (list 1 1) (list 1 -1)\n                       (list 0 2) (list 0 -2) (list -2 0) (list 2 0)))\n         (placed (make-hash)))\n    (define (largest-shape part)\n      (let ((objs (objects part 8)))\n        (if (empty? objs) #f (argmax obj-size objs))))\n    (define (inside? p)\n      (and (>= (first p) 0) (< (first p) h)\n           (>= (second p) 0) (< (second p) out-w)))\n    (define (free? cells)\n      (and (all? inside? cells)\n           (all? (lambda (p) (not (hash-has-key? placed p))) cells)))\n    (for ((obj (in-list (sort (filter values (map largest-shape parts))\n                              (lambda (a b) (> (obj-size a) (obj-size b)))))))\n      (let place ((ss shifts))\n        (unless (empty? ss)\n          (let* ((sh (first ss))\n                 (cells (map (lambda (p) (list (+ (first p) (first sh))\n                                                (+ (second p) (second sh))))\n                             (obj-cells obj))))\n            (if (free? cells)\n                (for ((p (in-list cells))) (hash-set! placed p (obj-color obj)))\n                (place (rest ss)))))))\n    (build-grid h out-w (r c) (hash-ref placed (list r c) 8))))"
