(rule!
 ;; Every blue(1) blob that ENCLOSES a background pocket gets outlined:
 ;; the background ring around it (8-adjacent, inside its bbox+1)
 ;; turns red(2) — with bbox corners patched in when both their edge
 ;; neighbors made the ring — and the enclosed pocket cells touching
 ;; the blob turn green(3). Blobs without pockets stay bare.
 (lambda (g)
   (let ()
     (define bg 0)
     (define (near? p cells)
       (any? (lambda (d) (member? (list (+ (first p) (first d))
                                        (+ (second p) (second d)))
                                  cells))
             all-8-deltas))
     (define (add-corner edge outside p p1 p2 clipped?)
       (if (and (not clipped?)
                (member? p outside)
                (member? p1 edge) (member? p2 edge)
                (not (member? p edge)))
           (cons p edge)
           edge))
     (define (process acc obj)
       (let* ((cells (obj-cells obj))
              (raw-r0 (- (obj-r1 obj) 1)) (raw-c0 (- (obj-c1 obj) 1))
              (raw-r1 (+ (obj-r2 obj) 1)) (raw-c1 (+ (obj-c2 obj) 1))
              (r0 (max 0 raw-r0)) (c0 (max 0 raw-c0))
              (r1 (min (- h 1) raw-r1)) (c1 (min (- w 1) raw-c1))
              (bg-cells (filter (lambda (p) (= (at g (first p)
                                                  (second p))
                                               bg))
                                (positions-in-rect r0 c0 r1 c1)))
              (outside  ;; bg reachable from the box rim, boxed flood
               (for/fold ((seen (list)))
                         ((seed (filter (lambda (p)
                                          (or (= (first p) r0)
                                              (= (first p) r1)
                                              (= (second p) c0)
                                              (= (second p) c1)))
                                        bg-cells)))
                 (if (member? seed seen)
                     seen
                     (for/fold ((a seen))
                               ((p (connected-region
                                    g (first seed) (second seed)
                                    (lambda (r c v)
                                      (and (= v bg)
                                           (>= r r0) (<= r r1)
                                           (>= c c0) (<= c c1)))
                                    4)))
                       (if (member? p a) a (cons p a))))))
              (ring (filter (lambda (p) (near? p cells)) outside))
              (ring+corners
               (add-corner
                (add-corner
                 (add-corner
                  (add-corner ring outside (list r0 c0)
                              (list r0 (+ c0 1)) (list (+ r0 1) c0)
                              (or (< raw-r0 0) (< raw-c0 0)))
                  outside (list r0 c1) (list r0 (- c1 1))
                  (list (+ r0 1) c1)
                  (or (< raw-r0 0) (>= raw-c1 w)))
                 outside (list r1 c0) (list r1 (+ c0 1))
                 (list (- r1 1) c0)
                 (or (>= raw-r1 h) (< raw-c0 0)))
                outside (list r1 c1) (list r1 (- c1 1))
                (list (- r1 1) c1)
                (or (>= raw-r1 h) (>= raw-c1 w))))
              (pocket (filter (lambda (p) (and (not (member? p outside))
                                               (near? p cells)))
                              bg-cells)))
         (if (empty? pocket)
             acc
             (paint-cells (paint-cells acc ring+corners 2) pocket 3))))
     (let ((blue-objs (filter (lambda (o) (= (obj-color o) 1)) (objects g bg))))
       (if (empty? blue-objs) g (process g (first blue-objs)))))))