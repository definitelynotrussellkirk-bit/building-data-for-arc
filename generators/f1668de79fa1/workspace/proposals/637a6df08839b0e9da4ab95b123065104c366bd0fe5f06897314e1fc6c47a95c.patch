+"""Task-local regression and teaching-contract tests for f1668de79fa1."""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(HOME / "workspace"))
+from reference_probe import (  # noqa: E402
+    canonical_pairs,
+    facts,
+    lesson,
+    load_generator,
+    oracle,
+    size_conditioned_rotation,
+)
+
+gen = load_generator(os.environ.get("GENERATOR_UNDER_TEST"))
+PAIRS = canonical_pairs()
+
+
+def _pinned_seed(band: str, index: int) -> int:
+    digest = hashlib.sha256(
+        f"profile-floor:v1:{gen.TASK_ID}:{band}:{index}".encode()
+    ).hexdigest()
+    return int(digest[:12], 16)
+
+
+def test_contract_surface_is_small_exact_and_rule_pinned():
+    assert gen.RULE_HASH == "6fbd99546842"
+    assert gen.VERSION == "2.0.0"
+    assert set(gen.AXES) == {"grid_h", "grid_w", "template_size"}
+    assert gen.INCOMPATIBLE_OVERRIDE_COMBINATIONS == []
+    assert gen.EXAMPLES_NEEDED == 4
+
+
+@pytest.mark.parametrize("pair", PAIRS, ids=["train0", "train1", "test0"])
+def test_canonical_inputs_are_owned_and_independent_oracle_matches(pair):
+    assert gen.self_check(pair["input"]) == []
+    assert gen.strict_canonical_like(pair["input"]) == []
+    assert oracle(pair["input"]) == pair["output"]
+    assert gen.rule_mirror(pair["input"]) == pair["output"]
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_every_exact_override_combination_is_constructive_and_observable(band):
+    for height in range(8, 16):
+        for width in range(13, 19):
+            for size in range(4, 8):
+                grid = gen.generate(
+                    917,
+                    height * 100 + width * 10 + size,
+                    difficulty=band,
+                    grid_h=height,
+                    grid_w=width,
+                    template_size=size,
+                )
+                expected = {
+                    "grid_h": height,
+                    "grid_w": width,
+                    "template_size": size,
+                }
+                assert gen.self_check(grid) == []
+                assert facts(grid) | {} == expected | {
+                    "lr_asymmetric": True,
+                    "rival_disagrees": size == 5,
+                }
+                assert gen.observe_overrides(grid) == expected
+                assert gen.rule_mirror(grid) == oracle(grid)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"typo": 1},
+        {"grid_h": 7}, {"grid_h": 16}, {"grid_h": True}, {"grid_h": 8.5},
+        {"grid_w": 12}, {"grid_w": 19}, {"grid_w": False}, {"grid_w": "13"},
+        {"template_size": 3}, {"template_size": 8},
+        {"template_size": True}, {"template_size": 5.0},
+    ],
+)
+def test_invalid_or_unknown_overrides_are_rejected(kwargs):
+    with pytest.raises(ValueError):
+        gen.generate(0, 0, **kwargs)
+
+
+def test_unknown_difficulty_is_rejected():
+    with pytest.raises(ValueError):
+        gen.generate(0, 0, difficulty="expert")
+
+
+@pytest.mark.parametrize("band", ["easy", "medium", "hard"])
+def test_pinned_profile_floor_has_exact_canonical_support_in_every_band(band):
+    canonical_profiles = {(8, 13, 3), (8, 14, 3), (9, 14, 3)}
+    profiles = []
+    for index in range(20):
+        seed = _pinned_seed(band, index)
+        grid = gen.generate(seed, seed % 7919 + index, difficulty=band)
+        profiles.append((len(grid), len(grid[0]), len({v for row in grid for v in row})))
+    assert any(profile in canonical_profiles for profile in profiles)
+
+
+@pytest.mark.parametrize("band", ["easy", "medium", "hard"])
+def test_every_five_pair_window_teaches_the_canonical_fitting_rival(band):
+    for start in range(18):
+        pairs = lesson(8300 + start, start, band, generator=gen)
+        witness_indexes = [
+            index
+            for index, pair in enumerate(pairs)
+            if size_conditioned_rotation(pair["input"]) != pair["output"]
+        ]
+        assert len(witness_indexes) >= 2
+        for held_out in range(len(pairs)):
+            demos = [pair for index, pair in enumerate(pairs) if index != held_out]
+            query = pairs[held_out]
+            assert any(
+                size_conditioned_rotation(pair["input"]) != pair["output"]
+                for pair in demos
+            )
+            assert gen.lesson_identifiable(demos, query) == []
+
+
+def test_declared_shortcut_fits_every_canonical_pair_and_generated_witness_refutes_it():
+    name = "rotate_five_else_flip_lr"
+    assert set(gen.CANONICAL_SHORTCUTS) == {name}
+    assert set(gen.LESSON_COMPETITORS) == {name}
+    assert set(gen.SEMANTIC_RIVALS) == {name}
+    rival = gen.CANONICAL_SHORTCUTS[name]
+    assert all(rival(pair["input"]) == pair["output"] for pair in PAIRS)
+
+    witness = gen.generate(41, 0, difficulty="easy", template_size=5)
+    assert gen.SEMANTIC_WITNESSES["five_cell_non_ud_symmetric"](witness)
+    assert gen.WITNESS_RIVALS["five_cell_non_ud_symmetric"] == [name]
+    assert rival(witness) == size_conditioned_rotation(witness)
+    assert rival(witness) != oracle(witness)
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_default_distribution_is_valid_deterministic_and_diverse(band):
+    grids = [gen.generate(1200 + index, index, difficulty=band) for index in range(96)]
+    assert all(gen.self_check(grid) == [] for grid in grids)
+    assert all(gen.strict_canonical_like(grid) == [] for grid in grids)
+    assert all(
+        grid == gen.generate(1200 + index, index, difficulty=band)
+        for index, grid in enumerate(grids)
+    )
+    assert len({tuple(map(tuple, grid)) for grid in grids}) >= 90
+    assert {facts(grid)["template_size"] for grid in grids} == {4, 5, 6, 7}
+    assert sum(facts(grid)["rival_disagrees"] for grid in grids) >= 40
+
+
+@pytest.mark.parametrize(
+    "mutation",
+    ["ragged", "bool_cell", "unknown_color", "remove_marker", "extra_marker",
+     "disconnect_template", "lr_symmetric_template"],
+)
+def test_self_check_rejects_targeted_destructive_mutations(mutation):
+    grid = gen.generate(73, 5, grid_h=10, grid_w=15, template_size=5)
+    changed = deepcopy(grid)
+    if mutation == "ragged":
+        changed[0] = changed[0][:-1]
+    elif mutation == "bool_cell":
+        changed[0][0] = True
+    elif mutation == "unknown_color":
+        changed[0][0] = 9
+    elif mutation == "remove_marker":
+        for row in changed:
+            for col, value in enumerate(row):
+                if value == 1:
+                    row[col] = 0
+    elif mutation == "extra_marker":
+        row, col = next(
+            (r, c)
+            for r, values in enumerate(changed)
+            for c, value in enumerate(values)
+            if value == 0
+        )
+        changed[row][col] = 1
+    elif mutation == "disconnect_template":
+        points = [(r, c) for r, row in enumerate(changed) for c, value in enumerate(row) if value == 2]
+        r, c = points[-1]
+        changed[r][c] = 0
+        changed[-1][-1] = 2
+    elif mutation == "lr_symmetric_template":
+        changed = [[0] * 15 for _ in range(10)]
+        for r, c in ((1, 1), (1, 2), (1, 3), (2, 2), (3, 2)):
+            changed[r][c] = 2
+        changed[6][8] = 1
+    assert gen.self_check(changed)
+
+
+@pytest.mark.parametrize("grid", [None, [], [[]], [[0], [0, 1]], [[True] * 13 for _ in range(8)]])
+def test_self_check_is_diagnostic_on_malformed_values(grid):
+    errors = gen.self_check(grid)
+    assert errors
+    assert all(isinstance(error, str) and error for error in errors)
+
+
+def test_keyed_generation_is_independent_of_python_hash_seed():
+    script = (
+        "import importlib.util,json,sys;"
+        "p=sys.argv[1];s=importlib.util.spec_from_file_location('g',p);"
+        "m=importlib.util.module_from_spec(s);s.loader.exec_module(m);"
+        "print(json.dumps(m.generate(31,8,difficulty='hard')))"
+    )
+    results = []
+    for hash_seed in ("1", "901"):
+        env = dict(os.environ, PYTHONHASHSEED=hash_seed, PYTHONDONTWRITEBYTECODE="1")
+        results.append(
+            subprocess.check_output(
+                [sys.executable, "-B", "-c", script, str(Path(gen.__file__).resolve())],
+                env=env,
+                text=True,
+            )
+        )
+    assert results[0] == results[1]
