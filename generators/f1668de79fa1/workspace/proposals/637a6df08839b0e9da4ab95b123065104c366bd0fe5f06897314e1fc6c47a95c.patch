+"""Independent pixel oracle and curriculum probes for f1668de79fa1.
+
+This reviewer-owned helper never calls production transformation helpers.  It can
+load an alternate candidate through ``GENERATOR_UNDER_TEST`` and is retained so
+future reviewers can replay canonical, override, shortcut, and lesson checks.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import importlib.util
+import os
+from pathlib import Path
+import sys
+from typing import Iterable
+
+from reviewer_support import canonical_pairs as _canonical_pairs, find_root
+
+TASK_ID = "f1668de79fa1"
+HOME = Path(__file__).resolve().parents[1]
+
+
+def load_generator(path: str | os.PathLike[str] | None = None):
+    source = Path(path or os.environ.get("GENERATOR_UNDER_TEST") or HOME / "generator.py").resolve()
+    spec = importlib.util.spec_from_file_location(f"reviewed_{TASK_ID}", source)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load generator from {source}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def canonical_pairs():
+    return _canonical_pairs(TASK_ID, root=find_root(__file__))
+
+
+def normalize(cells: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    points = tuple(cells)
+    if not points:
+        return ()
+    top = min(row for row, _ in points)
+    left = min(col for _, col in points)
+    return tuple(sorted((row - top, col - left) for row, col in points))
+
+
+def template(grid) -> tuple[tuple[int, int], ...]:
+    return normalize(
+        (row, col)
+        for row, values in enumerate(grid)
+        for col, value in enumerate(values)
+        if value == 2
+    )
+
+
+def marker(grid) -> tuple[int, int]:
+    hits = [
+        (row, col)
+        for row, values in enumerate(grid)
+        for col, value in enumerate(values)
+        if value == 1
+    ]
+    if len(hits) != 1:
+        raise ValueError(f"expected one marker, found {len(hits)}")
+    return hits[0]
+
+
+def flip_lr(shape: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    points = normalize(shape)
+    width = max(col for _, col in points) + 1
+    return tuple(sorted((row, width - 1 - col) for row, col in points))
+
+
+def rotate_180(shape: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    points = normalize(shape)
+    height = max(row for row, _ in points) + 1
+    width = max(col for _, col in points) + 1
+    return tuple(sorted((height - 1 - row, width - 1 - col) for row, col in points))
+
+
+def _stamp(grid, shape):
+    height, width = len(grid), len(grid[0])
+    anchor_row, anchor_col = marker(grid)
+    out = [[0] * width for _ in range(height)]
+    for drow, dcol in shape:
+        row, col = anchor_row + drow, anchor_col + dcol
+        if 0 <= row < height and 0 <= col < width:
+            out[row][col] = 8
+    return out
+
+
+def oracle(grid):
+    """Independent intended rule: horizontal bbox reflection at marker."""
+    return _stamp(grid, flip_lr(template(grid)))
+
+
+def size_conditioned_rotation(grid):
+    """Plausible rival: rotate five-cell templates, mirror all other sizes."""
+    shape = template(grid)
+    transformed = rotate_180(shape) if len(shape) == 5 else flip_lr(shape)
+    return _stamp(grid, transformed)
+
+
+def facts(grid):
+    shape = template(grid)
+    return {
+        "grid_h": len(grid),
+        "grid_w": len(grid[0]),
+        "template_size": len(shape),
+        "lr_asymmetric": flip_lr(shape) != shape,
+        "rival_disagrees": size_conditioned_rotation(grid) != oracle(grid),
+    }
+
+
+def lesson(seed: int, start: int, band: str, *, count: int = 5, generator=None):
+    module = generator or load_generator()
+    pairs = []
+    for offset in range(count):
+        grid = module.generate(seed, start + offset, difficulty=band)
+        pairs.append({"input": deepcopy(grid), "output": oracle(grid)})
+    return pairs
