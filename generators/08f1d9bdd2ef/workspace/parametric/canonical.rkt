(rule!
  (lambda (g)
    (let* ((h (rows g))
           (w (cols g))
           (sep-rows (filter (lambda (r) (= (row-count g r 8) w)) (range 0 h)))
           (sep-cols (filter (lambda (c) (= (col-count g c 8) h)) (range 0 w)))
           (r0 (first sep-rows))
           (r1 (second sep-rows))
           (c0 (first sep-cols))
           (c1 (second sep-cols)))
      (define (band x a b)
        (cond ((< x a) 0)
              ((< x b) 1)
              (else 2)))
      (cellmap g (r c v)
        (let ((br (band r r0 r1))
              (bc (band c c0 c1)))
          (cond ((= v 8) 8)
                ((and (= br 0) (= bc 1)) 2)
                ((and (= br 1) (= bc 0)) 4)
                ((and (= br 1) (= bc 1)) 6)
                ((and (= br 1) (= bc 2)) 3)
                ((and (= br 2) (= bc 1)) 1)
                (else 0)))))))