(rule!
  (let ((primary (make-hash)))
    (define origins
      (map (lambda (p) (cons (first p) (second p))) (find-color g 2)))
    (define queue origins)
    (for ([p (in-list queue)]) (hash-set! primary p 0))
    (let bfs-primary ()
      (unless (empty? queue)
        (let ((cur (first queue)))
          (set! queue (rest queue))
          (for ([d (in-list cardinal-deltas)])
            (let ((nr (+ (car cur) (first d)))
                  (nc (+ (cdr cur) (second d))))
              (when (and (in-bounds? nr nc (rows g) (cols g))
                         (not (hash-has-key? primary (cons nr nc)))
                         (or (= (at g nr nc) 0) (= (at g nr nc) 2)))
                (hash-set! primary (cons nr nc) (+ (hash-ref primary cur) 1))
                (set! queue (append queue (list (cons nr nc))))))))
        (bfs-primary)))
    (define relay (first origins))
    (define farthest-distance -1)
    (for ([r (in-range (rows g))])
      (for ([c (in-range (cols g))])
        (let ((p (cons r c)))
          (when (and (hash-has-key? primary p)
                     (> (hash-ref primary p) farthest-distance))
            (set! relay p)
            (set! farthest-distance (hash-ref primary p))))))
    (let ((dist (make-hash)))
      (define relay-queue (list relay))
      (hash-set! dist relay 0)
      (let bfs-relay ()
        (unless (empty? relay-queue)
          (let ((cur (first relay-queue)))
            (set! relay-queue (rest relay-queue))
            (for ([d (in-list cardinal-deltas)])
              (let ((nr (+ (car cur) (first d)))
                    (nc (+ (cdr cur) (second d))))
                (when (and (in-bounds? nr nc (rows g) (cols g))
                           (not (hash-has-key? dist (cons nr nc)))
                           (or (= (at g nr nc) 0) (= (at g nr nc) 2)))
                  (hash-set! dist (cons nr nc) (+ (hash-ref dist cur) 1))
                  (set! relay-queue
                        (append relay-queue (list (cons nr nc))))))))
          (bfs-relay)))
      (grid-from-fn (rows g) (cols g)
        (lambda (r c)
          (if (hash-has-key? dist (cons r c))
              (let ((m (modulo (hash-ref dist (cons r c)) 3)))
                (cond [(= m 0) 3] [(= m 1) 4] [else 5]))
              (at g r c)))))))
