@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Bounded holdout audit for the frame curriculum and declared rivals.
+
+The probe checks five-pair windows under every query rotation.  It also replays
+one window per difficulty through the selected Racket authority so the local
+packer is not the only label source in the retained receipt.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+TASK_ID = "881173b7bc9d"
+HERE = Path(__file__).resolve()
+REPO_ROOT = HERE.parents[3]
+for support in (REPO_ROOT / "shared" / "runtime", REPO_ROOT / "src"):
+    if support.is_dir() and str(support) not in sys.path:
+        sys.path.insert(0, str(support))
+GENERATOR = HERE.parents[1] / "generator.py"
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(f"curriculum_probe_{TASK_ID}", GENERATOR)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {GENERATOR}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _digest(value) -> str:
+    return hashlib.sha256(
+        json.dumps(value, separators=(",", ":"), sort_keys=True).encode("utf-8")
+    ).hexdigest()
+
+
+def run(*, starts: int = 12, window: int = 5, racket_windows: int = 1) -> dict:
+    from arcpuzzles import Catalog
+
+    gen = _load_generator()
+    failures: list[dict] = []
+    windows = rotations = rival_checks = 0
+    seen: set[str] = set()
+    min_four_counts: list[int] = []
+    racket_pairs: list[dict] = []
+
+    for band_index, band in enumerate(("easy", "medium", "hard")):
+        for start in range(starts):
+            seed = 17000 + band_index * 100 + start
+            pairs = []
+            for offset in range(window):
+                sample_index = start + offset
+                grid = gen.generate(seed, sample_index, difficulty=band)
+                errors = gen.self_check(grid, difficulty=band)
+                if errors:
+                    failures.append({
+                        "kind": "self_check", "band": band, "start": start,
+                        "sample_index": sample_index, "errors": errors,
+                    })
+                output = gen._pack(grid, gen._frames(grid))
+                pair = {"input": grid, "output": output, "sample_index": sample_index}
+                pairs.append(pair)
+                seen.add(_digest(grid))
+            windows += 1
+            min_four_counts.append(sum(
+                gen.SEMANTIC_RIVALS["min_four"](pair["input"]) != pair["output"]
+                for pair in pairs
+            ))
+            for query_index in range(window):
+                demos = [pair for index, pair in enumerate(pairs) if index != query_index]
+                rotations += 1
+                for name, rival in gen.LESSON_COMPETITORS.items():
+                    rival_checks += 1
+                    if not any(rival(pair["input"]) != pair["output"] for pair in demos):
+                        failures.append({
+                            "kind": "unrefuted_rival", "band": band, "start": start,
+                            "query_index": query_index, "rival": name,
+                        })
+            if start < racket_windows:
+                racket_pairs.extend(pairs)
+
+    receipt = Catalog(REPO_ROOT).apply(
+        TASK_ID, [pair["input"] for pair in racket_pairs],
+        reference="canonical", timeout=240,
+    )
+    racket_failures = []
+    for index, (pair, item) in enumerate(zip(racket_pairs, receipt["results"])):
+        if item["error"] is not None or item["output"] != pair["output"]:
+            racket_failures.append({
+                "index": index, "error": item["error"],
+                "match": item["output"] == pair["output"] if item["output"] is not None else False,
+            })
+
+    minimum = min(min_four_counts) if min_four_counts else 0
+    return {
+        "schema": "arcpuzzles-peer-curriculum-probe-v1",
+        "task_id": TASK_ID,
+        "generator_sha256": hashlib.sha256(GENERATOR.read_bytes()).hexdigest(),
+        "generator_version": gen.VERSION,
+        "rule_hash": gen.RULE_HASH,
+        "policy": {
+            "bands": ["easy", "medium", "hard"],
+            "starts": starts,
+            "window_pairs": window,
+            "query_policy": "every pair held out once; remaining pairs are demonstrations",
+            "rivals": sorted(gen.LESSON_COMPETITORS),
+        },
+        "counts": {
+            "windows": windows,
+            "rotations": rotations,
+            "rival_checks": rival_checks,
+            "unique_inputs": len(seen),
+            "failures": len(failures),
+            "minimum_min_four_witnesses_per_window": minimum,
+        },
+        "racket": {
+            "evaluations": len(racket_pairs),
+            "rule_hash_matches_catalog": receipt.get("rule_hash_matches_catalog"),
+            "failures": racket_failures,
+        },
+        "status": "pass" if not failures and not racket_failures and minimum >= 2 else "fail",
+        "failures": failures,
+        "limitations": [
+            "Finite seed/start sample and declared rivals only.",
+            "Only the selected representative windows are replayed through Racket; the remaining finite checks use the task mirror covered by task-local parity tests.",
+        ],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--starts", type=int, default=12)
+    parser.add_argument("--window", type=int, default=5)
+    parser.add_argument("--racket-windows", type=int, default=1)
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args()
+    if args.starts <= 0 or args.window < 2 or args.racket_windows < 0:
+        parser.error("invalid bounded probe counts")
+    result = run(starts=args.starts, window=args.window, racket_windows=args.racket_windows)
+    text = json.dumps(result, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(text)
+    print(text, end="")
+    return 0 if result["status"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
