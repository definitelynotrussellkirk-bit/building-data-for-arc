+    ).hexdigest()
+
+
+def _diff_count(a: list[list[int]], b: list[list[int]]) -> int:
+    return sum(x != y for row_a, row_b in zip(a, b) for x, y in zip(row_a, row_b))
+
+
+def color1_only_shortcut(gen, grid: list[list[int]]) -> list[list[int]]:
+    """Use the correct rule only on the color-1 wall subdomain."""
+    wall_color = gen.observe_overrides(grid)["wall_color"]
+    if wall_color == 1:
+        return gen._bfs_prediction(deepcopy(grid))
+    return deepcopy(grid)
+
+
+def build_case(seed: int = 15, difficulty: str = "medium") -> dict[str, Any]:
+    gen = _load_generator()
