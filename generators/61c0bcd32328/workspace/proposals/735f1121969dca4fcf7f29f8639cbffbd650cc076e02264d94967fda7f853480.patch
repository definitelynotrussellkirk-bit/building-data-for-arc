+    return {
+        "seed": seed,
+        "difficulty": difficulty,
+        "demo_wall_colors": [pair["wall_color"] for pair in pairs[:3]],
+        "query_wall_color": pairs[3]["wall_color"],
+        "demo_shortcut_matches": [pair["shortcut_matches"] for pair in pairs[:3]],
+        "query_shortcut_matches": pairs[3]["shortcut_matches"],
+        "query_disagreement_cells": pairs[3]["disagreement_cells"],
+        "pairs": pairs,
+    }
+
+
