+#!/usr/bin/env python3
+"""Source-bound probe for canvas-midpoint versus rectangle-midpoint ambiguity.
+
+The canonical rule decides the stamp side from the color-2 marker's position
+relative to the color-5 rectangle midpoint.  The wrong rule uses the whole
+canvas midpoint instead.  Seed 1's ordinary medium lesson does not distinguish
+those rules in its four demonstrations, but its next query does.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+TASK_ID = "0f7d80015d9d"
+HERE = Path(__file__).resolve()
+TASK_ROOT = HERE.parents[1]
+REPO = HERE.parents[3]
+GENERATOR = TASK_ROOT / "generator.py"
+for path in (REPO / "src", REPO / "shared" / "runtime"):
+    if str(path) not in sys.path:
+        sys.path.insert(0, str(path))
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location("peer_global_midpoint_generator", GENERATOR)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {GENERATOR}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha_bytes(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _sha_json(value: Any) -> str:
+    return hashlib.sha256(
+        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    ).hexdigest()
+
+
+def _diff_count(a: list[list[int]], b: list[list[int]]) -> int:
+    return sum(x != y for row_a, row_b in zip(a, b) for x, y in zip(row_a, row_b))
+
+
+def global_midpoint_shortcut(gen, grid: list[list[int]]) -> list[list[int]]:
+    """Apply marker movement correctly but choose the stamp side globally."""
+    analysis = gen._analyze(grid)
+    if analysis["errors"]:
+        raise ValueError(analysis["errors"])
+    output = deepcopy(grid)
+    red = analysis["red"]
+    cyan = analysis["cyan"]
+    _, bottom, left, right = analysis["rect"]
+    output[red[0]][red[1]] = 7
+    output[cyan[0]][cyan[1]] = 2
+    canvas_midpoint = (analysis["width"] - 1) // 2
+    red_left = red[1] < canvas_midpoint
+    destination = right + 1 if red_left else left - 1
+    output[bottom][destination] = 8
+    return output
+
+
+def build_case(seed: int = 1, difficulty: str = "medium") -> dict[str, Any]:
+    gen = _load_generator()
+    pairs = []
+    for sample_index in range(5):
+        grid = gen.generate(seed, sample_index, difficulty=difficulty)
+        truth = gen.rule_mirror(deepcopy(grid))
+        shortcut = global_midpoint_shortcut(gen, grid)
+        analysis = gen._analyze(grid)
+        pairs.append(
+            {
+                "sample_index": sample_index,
+                "profile": gen.schedule_profile(seed, sample_index, difficulty),
+                "shape": [analysis["height"], analysis["width"]],
+                "rect": list(analysis["rect"]),
+                "red": list(analysis["red"]),
+                "rectangle_midpoint": analysis["midpoint"],
+                "canvas_midpoint": (analysis["width"] - 1) // 2,
+                "input": grid,
+                "truth": truth,
+                "shortcut": shortcut,
+                "shortcut_matches": shortcut == truth,
+                "disagreement_cells": _diff_count(shortcut, truth),
+                "input_sha256": _sha_json(grid),
+                "truth_sha256": _sha_json(truth),
+                "shortcut_sha256": _sha_json(shortcut),
+            }
+        )
+    query = pairs[4]
+    return {
+        "seed": seed,
+        "difficulty": difficulty,
+        "demo_shortcut_matches": [pair["shortcut_matches"] for pair in pairs[:4]],
+        "query_shortcut_matches": query["shortcut_matches"],
+        "query_disagreement_cells": query["disagreement_cells"],
+        "query_rectangle_midpoint": query["rectangle_midpoint"],
+        "query_canvas_midpoint": query["canvas_midpoint"],
+        "pairs": pairs,
+    }
+
+
+def run(out: Path, *, seed: int = 1, difficulty: str = "medium") -> dict[str, Any]:
+    from arcpuzzles import Catalog
+
+    out = Path(out)
+    if out.exists():
+        raise FileExistsError(out)
+    out.mkdir(parents=True)
+    case = build_case(seed=seed, difficulty=difficulty)
+    inputs = [pair["input"] for pair in case["pairs"]]
+    receipt = Catalog(REPO).apply(
+        TASK_ID,
+        inputs,
+        reference="canonical",
+        allow_unapproved=True,
+        timeout=120,
+    )
+    (out / "racket-receipt.json").write_text(
+        json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    if len(receipt["results"]) != len(case["pairs"]):
+        raise AssertionError("Catalog.apply returned the wrong number of labels")
+    for pair, result in zip(case["pairs"], receipt["results"]):
+        if not result.get("valid_output") or result.get("output") is None:
+            raise AssertionError(f"protected Racket failed: {result.get('error')}")
+        if result["output"] != pair["truth"]:
+            raise AssertionError("generator mirror differs from protected Racket")
+        pair["racket_output_sha256"] = result["output_sha256"]
+        pair["racket_result_index"] = result["index"]
+
+    passed = (
+        case["demo_shortcut_matches"] == [True, True, True, True]
+        and case["query_shortcut_matches"] is False
+        and case["query_disagreement_cells"] > 0
+        and case["query_rectangle_midpoint"] != case["query_canvas_midpoint"]
+    )
+    report = {
+        "schema": "0f7d80015d9d-global-midpoint-shortcut-probe-v1",
+        "status": "shortcut_survives_demos_and_fails_query" if passed else "unexpected",
+        "task_id": TASK_ID,
+        "generator_path": str(GENERATOR.relative_to(REPO)),
+        "generator_sha256": _sha_bytes(GENERATOR),
+        "probe_sha256": _sha_bytes(HERE),
+        "wrong_rule": (
+            "Move the markers correctly, but choose the new color-8 stamp side from "
+            "the color-2 marker's position relative to the whole canvas midpoint "
+            "instead of the color-5 rectangle midpoint."
+        ),
+        "lesson_policy": "samples 0..3 are demonstrations and sample 4 is the query",
+        "protected_racket": {
+            "executed_rule_hash": receipt.get("executed_rule_hash"),
+            "rule_text_sha256": receipt.get("rule_text_sha256"),
+            "generator_sha256": receipt.get("generator_sha256"),
+            "evaluations": len(inputs),
+            "receipt": "racket-receipt.json",
+        },
+        "case": case,
+        "pass": passed,
+        "repair_recommendation": (
+            "Require at least one visible demonstration where the rectangle midpoint "
+            "and canvas midpoint classify the red marker differently, or add this "
+            "rival to lesson_identifiable before using such a query."
+        ),
+        "limits": [
+            "This is one deterministic ordinary lesson and one executable shortcut, not a universal ambiguity proof.",
+            "Production source and canonical Racket text are not modified by this probe.",
+        ],
+    }
+    (out / "report.json").write_text(
+        json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    print(json.dumps({
+        "status": report["status"],
+        "query_rectangle_midpoint": case["query_rectangle_midpoint"],
+        "query_canvas_midpoint": case["query_canvas_midpoint"],
+        "query_disagreement_cells": case["query_disagreement_cells"],
+        "racket_evaluations": len(inputs),
+        "out": str(out.resolve()),
+    }, sort_keys=True))
+    if not passed:
+        raise AssertionError("expected shortcut witness was not reproduced")
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=1)
+    parser.add_argument("--difficulty", choices=("easy", "medium", "hard"), default="medium")
+    args = parser.parse_args()
+    run(args.out, seed=args.seed, difficulty=args.difficulty)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
