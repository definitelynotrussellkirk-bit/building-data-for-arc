+"""Source-bound probe for a color-1-only maze solver lesson shortcut.
+
+The wrong rule applies the intended BFS transformation when walls are color 1,
+but treats color-9 mazes as unsupported and returns the input unchanged.  This
+is a compact domain-gating shortcut: all canonical examples use color-1 walls,
+and seed 15's first three ordinary demonstrations do too, while its next query
+uses lawful color-9 walls.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
