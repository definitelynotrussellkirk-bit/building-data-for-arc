+"""Retain one replacement from the already screened window; two Racket calls."""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+import learnability_probe as probe
+
+
+def main():
+    evidence_path, output_path = map(lambda value: Path(value).resolve(), sys.argv[1:])
+    if output_path.exists():
+        raise FileExistsError(output_path)
+    evidence = json.loads(evidence_path.read_text())
+    case = evidence["cases"][0]
+    assert case["rival"] == "vertical_walls_only"
+    assert hashlib.sha256(probe.SOURCE.read_bytes()).hexdigest() == evidence["source_binding"]["generator_sha256"]
+    spec = importlib.util.spec_from_file_location("replacement_generator", probe.SOURCE)
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    seen = [pair["input"] for pair in case["train"] + case["test"]]
+    candidate = None
+    for seed in evidence["scope"]["seeds"]:
+        for index in range(4):
+            grid = generator.generate(seed, index)
+            if grid not in seen and probe.label(grid) != probe.label(grid, case["rival"]):
+                candidate = seed, index, grid
+                break
+        if candidate is not None:
+            break
+    assert candidate is not None, "no replacement in the already screened inputs"
+    seed, index, grid = candidate
+    apply, identity, bridge = probe._real_evaluator((probe.ROOT / "shared/runtime").resolve())
+    try:
+        canonical = probe._grid(apply(case["program"], grid))
+        rival = probe._grid(apply(case["rival_program"], grid))
+    finally:
+        bridge.close()
+    assert canonical == probe.label(grid)
+    assert rival == probe.label(grid, case["rival"])
+    assert canonical != rival
+    report = {
+        "schema": "arcpuzzles-peer-replacement-demonstration-v1",
+        "task_id": probe.TASK,
+        "status": "verified_proposal_production_unchanged",
+        "source_binding": evidence["source_binding"],
+        "source_evidence_sha256": hashlib.sha256(evidence_path.read_bytes()).hexdigest(),
+        "replacement_probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "invocation": {"argv": sys.argv, "cwd": str(probe.ROOT), "exit_code": 0},
+        "racket": identity,
+        "native_evaluations": 2,
+        "screen_scope": "only the original sixteen seeds and four indices; stop at first eligible candidate",
+        "replace_demo_index": 0,
+        "demonstration_count": 3,
+        "query_unchanged": True,
+        "distinct_from_all_original_inputs": grid not in seen,
+        "case": {"seed": seed, "sample_index": index, "input": grid,
+                 "program": case["program"], "output": canonical,
+                 "rival_program": case["rival_program"], "rival_output": rival},
+        "limit": "This repairs the retained episode against one rival; it is not an implemented sampler policy or universal teaching guarantee.",
+    }
+    output_path.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"seed": seed, "sample_index": index,
+                      "different_cells": sum(a != b for row, other in zip(canonical, rival) for a, b in zip(row, other)),
+                      "shape": [len(grid), len(grid[0])], "native_evaluations": 2,
+                      "output": str(output_path)}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
