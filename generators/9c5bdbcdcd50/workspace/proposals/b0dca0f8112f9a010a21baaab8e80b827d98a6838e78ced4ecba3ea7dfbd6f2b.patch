+"""Bounded three-demo/one-query shortcut probe; labels replayed with Racket."""
+from __future__ import annotations
+
+from collections import deque
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _grid, _real_evaluator
+
+
+TASK = "d7b74143cb92"
+ROOT = Path.cwd()
+SOURCE = ROOT / "generators" / TASK / "generator.py"
+RIVALS = ("ignore_walls", "vertical_walls_only", "close_gap", "tie_lowest", "tie_highest", "two_way_ties_only")
+
+
+def label(grid, rival="canonical"):
+    height, width = len(grid), len(grid[0])
+    distances = {}
+    for color in (2, 3, 4):
+        start = next((r, c) for r in range(height) for c in range(width) if grid[r][c] == color)
+        distance = {start: 0}
+        queue = deque([start])
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if not (0 <= nr < height and 0 <= nc < width) or (nr, nc) in distance:
+                    continue
+                blocked = grid[nr][nc] == 5
+                if rival == "ignore_walls":
+                    blocked = False
+                elif rival == "vertical_walls_only":
+                    blocked = blocked and nc == width // 2
+                elif rival == "close_gap":
+                    blocked = blocked or (nc == width // 2 and 0 < nr < height - 1)
+                if not blocked:
+                    distance[nr, nc] = distance[r, c] + 1
+                    queue.append((nr, nc))
+        distances[color] = distance
+    output = [row[:] for row in grid]
+    for r in range(height):
+        for c in range(width):
+            if grid[r][c] != 0:
+                continue
+            available = [(distances[color][r, c], color) for color in (2, 3, 4) if (r, c) in distances[color]]
+            if not available:
+                continue
+            minimum = min(distance for distance, _ in available)
+            winners = [color for distance, color in available if distance == minimum]
+            if rival == "tie_lowest":
+                output[r][c] = min(winners) + 4
+            elif rival == "tie_highest":
+                output[r][c] = max(winners) + 4
+            elif rival == "two_way_ties_only":
+                output[r][c] = 9 if len(winners) == 2 else winners[0] + 4
+            else:
+                output[r][c] = 9 if len(winners) > 1 else winners[0] + 4
+    return output
+
+
+def rival_program(program, rival):
+    wall = "(not (= (at g nr nc) 5))"
+    tie = "(if (> (length winners) 1) 9 (out-color (first (first winners))))"
+    changes = {
+        "ignore_walls": (wall, "#t"),
+        "vertical_walls_only": (wall, "(or (not (= (at g nr nc) 5)) (not (= nc (quotient (cols g) 2))))"),
+        "close_gap": (wall, "(and (not (= (at g nr nc) 5)) (not (and (= nc (quotient (cols g) 2)) (> nr 0) (< nr (- (rows g) 1)))))"),
+        "tie_lowest": (tie, "(out-color (first (first winners)))"),
+        "tie_highest": (tie, "(out-color (first (last winners)))"),
+        "two_way_ties_only": (tie, "(if (= (length winners) 2) 9 (out-color (first (first winners))))"),
+    }
+    old, new = changes[rival]
+    assert program.count(old) == 1, (rival, "unexpected canonical program")
+    return program.replace(old, new)
+
+
+def main():
+    destination = Path(sys.argv[1]).resolve()
+    if destination.exists():
+        raise FileExistsError(destination)
+    catalog = Catalog(ROOT)
+    descriptor = catalog.describe(TASK)
+    program = catalog._variants()[descriptor.get("rule_task_id", TASK)][0]["program_solution"]
+    spec = importlib.util.spec_from_file_location("peer_generator", SOURCE)
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    fits = {rival: 0 for rival in RIVALS}
+    findings = []
+    records = []
+    for seed in range(16):
+        grids = [generator.generate(seed, index) for index in range(4)]
+        assert all(generator.self_check(grid) == [] for grid in grids)
+        labels = [label(grid) for grid in grids]
+        records.append((seed, grids, labels))
+        for rival in RIVALS:
+            claims = [label(grid, rival) for grid in grids]
+            if claims[:3] == labels[:3]:
+                fits[rival] += 1
+                if claims[3] != labels[3]:
+                    findings.append((seed, rival, grids, labels, claims))
+    apply, identity, bridge = _real_evaluator((ROOT / "shared/runtime").resolve())
+    evidence = []
+    try:
+        chosen = findings[:1]
+        if not chosen:
+            seed, grids, labels = records[0]
+            chosen = [(seed, None, grids, labels, None)]
+        for seed, rival, grids, labels, claims in chosen:
+            candidate = rival_program(program, rival) if rival else None
+            pairs = []
+            for index, grid in enumerate(grids):
+                actual = _grid(apply(program, grid))
+                assert actual == labels[index], (seed, index, "canonical mirror disagreement")
+                pair = {"input": grid, "output": actual}
+                if candidate:
+                    other = _grid(apply(candidate, grid))
+                    assert other == claims[index], (seed, index, "rival mirror disagreement")
+                    pair["rival_output"] = other
+                pairs.append(pair)
+            evidence.append({"seed": seed, "sample_indices": [0, 1, 2, 3], "rival": rival,
+                             "program": program, "rival_program": candidate,
+                             "train": pairs[:3], "test": pairs[3:]})
+    finally:
+        bridge.close()
+    report = {
+        "schema": "arcpuzzles-bounded-peer-learnability-v1",
+        "task_id": TASK,
+        "outcome": "finding" if findings else "bounded_no_finding",
+        "source_binding": {"generator_sha256": hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
+                           "rule_sha256": hashlib.sha256(program.encode()).hexdigest(),
+                           "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()},
+        "invocation": {"argv": sys.argv, "cwd": str(ROOT), "exit_code": 0,
+                       "outer_argv": ["python3", "review.py", "run", "python3", f"generators/{TASK}/workspace/learnability_probe.py", str(destination)]},
+        "racket": identity,
+        "scope": {"seeds": list(range(16)), "demos": 3, "queries": 1, "input_count": 64,
+                  "rivals": list(RIVALS), "demo_fit_episode_counts": fits,
+                  "finding_count": len(findings), "native_replayed_episodes": len(evidence)},
+        "cases": evidence,
+        "limits": ["Finite six-rival, sixteen-seed review; no universal learnability claim.",
+                   "All 64 inputs screened with independent Python BFS; only the retained episode replayed through protected Racket.",
+                   "Fixed seed-color positions permit positional shortcuts throughout this sampler; color-position generalization is not exercised.",
+                   "No canonical generator change, full battery, or parametric construction was attempted."],
+    }
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"outcome": report["outcome"], "scope": report["scope"], "path": str(destination)}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
