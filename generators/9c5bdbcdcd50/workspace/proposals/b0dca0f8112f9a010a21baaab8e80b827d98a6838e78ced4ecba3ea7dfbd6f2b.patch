+"""One source-bound learnability counterexample; no broad generator battery."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+TASK = "82bce7d23c06"
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "src"))
+sys.path.insert(0, str(ROOT / "shared/runtime"))
+
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def replacement_candidate(args, generator, path, source_hash, program, rival):
+    """Execute only one new candidate; reuse the retained original lesson."""
+    prior_bytes = args.replacement_for.read_bytes()
+    prior = json.loads(prior_bytes)
+    if (prior.get("status") != "counterexample_confirmed"
+            or prior.get("source_sha256") != source_hash
+            or prior.get("program") != program or prior.get("rival_program") != rival
+            or prior.get("racket", {}).get("protected") is not True
+            or [row["matches"] for row in prior["cases"]] != [True, True, True, False]):
+        raise ValueError("Replacement requires the unchanged source-bound original case")
+    value = [[2, 2]]
+    if generator.self_check(value):
+        raise AssertionError("Replacement input is outside the admitted grammar")
+    record = {
+        "schema": "bounded-peer-teaching-repair-candidate-v1", "task_id": TASK,
+        "status": "running", "argv": sys.argv, "cwd": str(Path.cwd()),
+        "source_path": path.relative_to(ROOT).as_posix(), "source_sha256": source_hash,
+        "rule_hash": prior["rule_hash"], "program": program,
+        "program_sha256": sha(program.encode()), "rival_program": rival,
+        "rival_program_sha256": sha(rival.encode()),
+        "prior_evidence_path": str(args.replacement_for),
+        "prior_evidence_sha256": sha(prior_bytes), "racket_evaluations": 0,
+        "replaces_demo_index": 0, "demonstrations_before": 3,
+        "demonstrations_after": 3, "production_or_assembler_changed": False,
+        "finding_remains_open": True,
+    }
+    try:
+        with _local_imports(ROOT / "shared/runtime", path.parent):
+            apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+            record["racket"] = identity
+            try:
+                actual = _grid(apply(program, _grid(value)))
+                alternative = _grid(apply(rival, _grid(value)))
+                record["racket_evaluations"] = 2
+            finally:
+                bridge.close()
+        if actual == alternative or actual != generator.rule_mirror(value):
+            raise AssertionError("Replacement failed to distinguish the rival correctly")
+        train = [{"input": value, "output": actual}] + [
+            {"input": row["input"], "output": row["output"]}
+            for row in prior["cases"][1:3]]
+        query = prior["cases"][3]
+        inputs = [row["input"] for row in train] + [query["input"]]
+        if len({json.dumps(grid) for grid in inputs}) != 4:
+            raise AssertionError("Replacement must be distinct from remaining demos and query")
+        if sha(path.read_bytes()) != source_hash:
+            raise AssertionError("Canonical source changed during candidate review")
+        record.update(
+            status="replacement_candidate_verified", exit_code=0,
+            replacement={"input": value, "output": actual, "rival_output": alternative,
+                         "output_shape": [len(actual), len(actual[0])],
+                         "rival_output_shape": [len(alternative), len(alternative[0])]},
+            repaired_train=train, unchanged_query=query,
+            rival_matches_repaired_demonstrations=[False, True, True],
+            distinct_from_query=True,
+            limits="Two new protected-Racket evaluations for one lawful replacement. Other demonstrations and query reuse the hash-bound prior evidence. The lesson-assembly proposal is not implemented; no production fix or acceptance is claimed.")
+    except Exception as error:
+        record.update(status="failed", exit_code=1,
+                      error={"type": type(error).__name__, "message": str(error)})
+        raise
+    finally:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        with args.out.open("x") as stream:
+            json.dump(record, stream, sort_keys=True, indent=2)
+            stream.write("\n")
+    print(json.dumps({"status": record["status"], "racket_evaluations": 2,
+                      "demonstrations_after": 3, "evidence": str(args.out)}))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--replacement-for", type=Path,
+                        help="Verify one replacement using existing counterexample evidence; two new Racket evaluations only")
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    generator, path, source_hash = load_selected_generator(TASK, root=ROOT)
+    rows = [json.loads(line) for line in
+            (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()]
+    selected = [row for row in rows if row.get("task_id") == TASK]
+    programs = {row["program_solution"] for row in selected}
+    if len(programs) != 1:
+        raise ValueError("Expected one exact canonical program")
+    program = programs.pop()
+    old = "(nz (for/sum ((c (range 0 n))) (if (!= (at g 0 c) 0) 1 0)))"
+    new = "(nz (length (remove-duplicates (filter (lambda (v) (!= v 0)) (for/list ((c (range 0 n))) (at g 0 c))))))"
+    if program.count(old) != 1:
+        raise ValueError("Canonical counting expression changed")
+    rival = program.replace(old, new, 1)
+    if args.replacement_for is not None:
+        replacement_candidate(args, generator, path, source_hash, program, rival)
+        return
+    inputs = [generator.generate(6, index) for index in range(4)]
+    if any(generator.self_check(value) for value in inputs):
+        raise AssertionError("Ordinary generated input violates the selected grammar")
+    record = {
+        "schema": "bounded-peer-teaching-review-v1", "task_id": TASK,
+        "status": "running", "argv": sys.argv, "cwd": str(Path.cwd()),
+        "source_path": path.relative_to(ROOT).as_posix(),
+        "source_sha256": source_hash, "rule_hash": "70db807242f1",
+        "program": program, "program_sha256": sha(program.encode()),
+        "rival_name": "count_distinct_nonzero_colors_instead_of_nonzero_cells",
+        "rival_program": rival, "rival_program_sha256": sha(rival.encode()),
+        "sampling": {"seed": 6, "sample_indices": [0, 1, 2, 3],
+                     "difficulty": None, "overrides": {},
+                     "candidate_search": "Inspected default seed0, then seeds1..6; stopped at first three-demo/fourth-query counterexample. No broad census."},
+        "scope": "Three consecutive scalar draws treated as visible demonstrations and the fourth as query. This is a supported generated lesson, not a claim about a particular downstream episode assembler.",
+        "cases": [], "racket_evaluations": 0,
+    }
+    try:
+        with _local_imports(ROOT / "shared/runtime", path.parent):
+            apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+            record["racket"] = identity
+            try:
+                for index, value in enumerate(inputs):
+                    actual = _grid(apply(program, _grid(value)))
+                    alternative = _grid(apply(rival, _grid(value)))
+                    record["racket_evaluations"] += 2
+                    if actual != generator.rule_mirror(value):
+                        raise AssertionError("Canonical Racket disagrees with the selected mirror")
+                    record["cases"].append({
+                        "role": "demonstration" if index < 3 else "query",
+                        "sample_index": index, "input": value,
+                        "output": actual, "rival_output": alternative,
+                        "matches": actual == alternative,
+                        "output_shape": [len(actual), len(actual[0])],
+                        "rival_output_shape": [len(alternative), len(alternative[0])],
+                    })
+            finally:
+                bridge.close()
+        if not all(row["matches"] for row in record["cases"][:3]):
+            raise AssertionError("Rival does not fit all visible demonstrations")
+        if record["cases"][3]["matches"]:
+            raise AssertionError("Rival does not disagree on the query")
+        if sha(path.read_bytes()) != source_hash:
+            raise AssertionError("Canonical source changed during the review")
+        record.update(status="counterexample_confirmed", exit_code=0,
+                      recommendation="When assembling lessons with repeated-color queries, include one repeated-color demonstration that separates cell count from distinct-color count. Retain the repeated-color generator branch.",
+                      limits="One finite rival and one four-input generated lesson; eight protected-Racket evaluations. No canonical source repair, acceptance change, full pytest suite, or downstream assembler repair was attempted.")
+    except Exception as error:
+        record.update(status="failed", exit_code=1,
+                      error={"type": type(error).__name__, "message": str(error)})
+        raise
+    finally:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        with args.out.open("x") as stream:
+            json.dump(record, stream, sort_keys=True, indent=2)
+            stream.write("\n")
+    print(json.dumps({"status": record["status"], "racket_evaluations": record["racket_evaluations"],
+                      "evidence": str(args.out), "query_shapes": [record["cases"][-1]["output_shape"], record["cases"][-1]["rival_output_shape"]]}))
+
+
+if __name__ == "__main__":
+    main()
