+"""Reproduce a default-sampler missing-branch teaching gap for abee0b4bed48.
+
+Run from an ARCpuzzles repository root with the protected Racket runtime:
+  python generators/abee0b4bed48/workspace/review-b280d98a5fff10a2/probe.py --out RESULT.json
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+TASK_ID = "abee0b4bed48"
+SEED = 10
+DEMO_INDICES = (0, 1, 2)
+QUERY_INDEX = 3
+
+
+def build(root: Path) -> dict:
+    root = root.resolve()
+    generator, source, source_sha = load_selected_generator(TASK_ID, root=root)
+    variants = Catalog(root)._variants().get(TASK_ID, [])
+    programs = {row.get("program_solution") for row in variants}
+    if len(programs) != 1:
+        raise ValueError("expected one exact canonical program")
+    canonical = next(iter(programs))
+    needle = "((= cnt 8) 3)"
+    if canonical.count(needle) != 1:
+        raise ValueError("canonical eight-cell branch changed")
+    rival = canonical.replace(needle, "((= cnt 8) 4)", 1)
+
+    grids = [generator.generate(SEED, index) for index in (*DEMO_INDICES, QUERY_INDEX)]
+    analyses = [generator._analysis(grid) for grid in grids]
+    kinds = [{record["kind"] for record in analysis["records"]} for analysis in analyses]
+    if any("eight" in observed for observed in kinds[:3]):
+        raise AssertionError("an eight-gray branch entered the visible demonstrations")
+    if "eight" not in kinds[3]:
+        raise AssertionError("the query no longer exercises the missing eight-gray branch")
+
+    runtime = root / "shared/runtime"
+    with _local_imports(runtime, runtime):
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            canonical_outputs = [apply(canonical, grid) for grid in grids]
+            rival_outputs = [apply(rival, grid) for grid in grids]
+        finally:
+            bridge.close()
+    if canonical_outputs[:3] != rival_outputs[:3]:
+        raise AssertionError("shortcut does not fit all visible demonstrations")
+    if canonical_outputs[3] == rival_outputs[3]:
+        raise AssertionError("shortcut does not change the query")
+
+    changed = sum(
+        left != right
+        for left_row, right_row in zip(canonical_outputs[3], rival_outputs[3])
+        for left, right in zip(left_row, right_row)
+    )
+    return {
+        "schema": "arcpuzzles-peer-teaching-counterexample-v1",
+        "task_id": TASK_ID,
+        "status": "confirmed",
+        "finding": (
+            "Default seed 10 exposes no eight-gray zone in sample indices 0..2. A rival that "
+            "maps count 8 to the singleton label 4 fits every visible demonstration. Sample "
+            "index 3 contains two eight-gray zones, where the canonical label is 3."
+        ),
+        "generator": {
+            "path": source.relative_to(root).as_posix(),
+            "sha256": source_sha,
+        },
+        "seed": SEED,
+        "demo_sample_indices": list(DEMO_INDICES),
+        "query_sample_index": QUERY_INDEX,
+        "profiles": [generator.observe_overrides(grid)["scene_profile"] for grid in grids],
+        "branch_kinds": [sorted(observed) for observed in kinds],
+        "canonical_program": canonical,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "rival_program": rival,
+        "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "racket": identity,
+        "racket_evaluations": 8,
+        "demonstrations": [
+            {
+                "input": grid,
+                "canonical_output": canonical_output,
+                "rival_output": rival_output,
+            }
+            for grid, canonical_output, rival_output in zip(
+                grids[:3], canonical_outputs[:3], rival_outputs[:3]
+            )
+        ],
+        "query": {
+            "input": grids[3],
+            "canonical_output": canonical_outputs[3],
+            "rival_output": rival_outputs[3],
+            "changed_cells": changed,
+        },
+        "suggested_repair": (
+            "Select or construct at least one demonstration containing an eight-gray zone, "
+            "preferably paired with a singleton, without increasing the demonstration count."
+        ),
+        "limits": "One deterministic default-sampler episode and one explicit rival; not a universal ambiguity proof.",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--root", type=Path, default=Path.cwd())
+    args = parser.parse_args()
+    result = build(args.root)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")
+    print(json.dumps({
+        "status": result["status"],
+        "profiles": result["profiles"],
+        "branch_kinds": result["branch_kinds"],
+        "query_changed_cells": result["query"]["changed_cells"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
