(rule! (let ((dummy 0))
  (define dirs4 (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))
  (define intermediate
    (for*/fold ((out g)) ((r (in-range (rows g))) (c (in-range (cols g))))
      (let ((v (at g r c)))
        (if (and (not (= v 0))
                 (all? (lambda (d)
                         (let ((nr (+ r (first d))) (nc (+ c (second d))))
                           (not (and (in-bounds? nr nc (rows g) (cols g))
                                     (not (= (at g nr nc) 0))))))
                       dirs4))
            (let* ((left (if (and (>= (- c 1) 0) (= (at out r (- c 1)) 0))
                             (set-cell out r (- c 1) v) out))
                   (right (if (and (< (+ c 1) (cols g)) (= (at left r (+ c 1)) 0))
                              (set-cell left r (+ c 1) v) left)))
              right)
            out))))
  (define largest (pick-max (objects intermediate 0) obj-size))
  (draw-rect-filled intermediate
                    (obj-r1 largest) (obj-c1 largest)
                    (obj-r2 largest) (obj-c2 largest) 9)))
