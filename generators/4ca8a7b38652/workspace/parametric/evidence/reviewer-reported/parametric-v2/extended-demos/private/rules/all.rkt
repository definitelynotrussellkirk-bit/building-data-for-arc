(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((colors (unique (flatmap (lambda (r)
                             (map (lambda (c) (at g r c))
                                  (range 0 w)))
                           (range 0 h))))
                  (n (length colors)))
             (if (<= n 1) g (build-grid (* h n) (* w n) (r c) (at g (/ r n) (/ c n))))))))