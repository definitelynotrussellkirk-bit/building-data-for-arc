 def generate(seed, sample_index, *, difficulty=None, **overrides):
     """Generate one deterministic input grid; outputs remain Racket-authoritative."""
+    # Validate before schedule arithmetic: bool is an int subclass and a
+    # negative index would otherwise silently wrap around the lesson period.
+    if type(seed) is not int:
+        raise TypeError("seed must be a Python int; booleans are not accepted")
+    if type(sample_index) is not int:
+        raise TypeError("sample_index must be a Python int; booleans are not accepted")
+    if sample_index < 0:
+        raise ValueError("sample_index must be nonnegative")
     _validate_override_keys(overrides)
     if difficulty not in {None, "easy", "medium", "hard"}:
         raise ValueError("difficulty must be None, 'easy', 'medium', or 'hard'")
