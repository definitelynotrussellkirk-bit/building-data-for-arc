(rule! (lambda (g)
  (let* ((h (rows g))
         (w (cols g)))
    (let* ((cells (filter (lambda (p) p)
                          (for*/list ((r (range 0 h)) (c (range 0 w)))
                            (and (!= (at g r c) 7)
                                 (list r c (at g r c))))))
           (base (recolor-cells g cells 7))
           (projected
             (reduce
               (lambda (acc cell)
                 (let* ((cr (first cell))
                        (cc (second cell))
                        (cv (third cell))
                        (top (zero? cr))
                        (left (zero? cc))
                        (dr (if top 1 -1))
                        (dc (if left 1 -1))
                        (new-cells
                          (if top
                              (list (list (+ cr dr) (+ cc dc))
                                    (list (+ cr dr) (+ cc (* 2 dc)))
                                    (list (+ cr (* 2 dr)) (+ cc dc))
                                    (list (+ cr (* 2 dr)) (+ cc (* 2 dc))))
                              (list (list (+ cr (* 3 dr)) (+ cc (* 2 dc)))
                                    (list (+ cr (* 2 dr)) (+ cc (* 2 dc)))
                                    (list (+ cr dr) (+ cc (* 3 dc)))))))
                   (recolor-cells acc new-cells cv)))
               base
               cells))
           (colors (remove-duplicates (map third cells)))
           (more-source? (lambda (a b)
                           (let ((ca (length (filter (lambda (cell) (= (third cell) a)) cells)))
                                 (cb (length (filter (lambda (cell) (= (third cell) b)) cells))))
                             (if (= ca cb) (< a b) (> ca cb)))))
           (selected (first (sort colors more-source?))))
      (recolor-cells projected (find-color projected selected) 1)))))
