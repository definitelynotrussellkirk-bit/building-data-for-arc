(rule! (lambda (g)
  (let* ((h (rows g))
         (w (cols g)))
    (let* ((cells (filter (lambda (p) p)
                          (for*/list ((r (range 0 h)) (c (range 0 w)))
                            (and (!= (at g r c) 7)
                                 (list r c (at g r c))))))
           (base (recolor-cells g cells 7)))
      (reduce
        (lambda (acc cell)
          (let* ((cr (first cell))
                 (cc (second cell))
                 (cv (third cell))
                 (top (zero? cr))
                 (left (zero? cc))
                 (dr (if top 1 -1))
                 (dc (if left 1 -1))
                 (new-cells
                   (if top
                       (list (list (+ cr (* 1 dr)) (+ cc (* 1 dc)))
                             (list (+ cr (* 1 dr)) (+ cc (* 2 dc)))
                             (list (+ cr (* 2 dr)) (+ cc (* 1 dc)))
                             (list (+ cr (* 2 dr)) (+ cc (* 2 dc))))
                       (list (list (+ cr (* 3 dr)) (+ cc (* 2 dc)))
                             (list (+ cr (* 2 dr)) (+ cc (* 2 dc)))
                             (list (+ cr (* 1 dr)) (+ cc (* 3 dc)))))))
            (recolor-cells acc new-cells cv)))
        base
        cells)))))
