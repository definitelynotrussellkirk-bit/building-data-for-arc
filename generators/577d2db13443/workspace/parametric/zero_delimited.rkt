(rule! (let ((dummy 0))
  (define (segments grid)
    (apply append
      (for/list ((r (in-range (rows grid))))
        (let loop ((c 0) (acc (list)))
          (if (>= c (cols grid)) (reverse acc)
              (if (= (at grid r c) 0)
                  (loop (+ c 1) acc)
                  (let find-end ((cc c))
                    (if (and (< (+ cc 1) (cols grid))
                             (not (= (at grid r (+ cc 1)) 0)))
                        (find-end (+ cc 1))
                        (loop (+ cc 1) (cons (list r c cc) acc))))))))))
  (for/fold ((out g)) ((segment (in-list (segments g))))
    (set-cell (set-cell out (first segment) (second segment) 1)
              (first segment) (third segment) 1))))
