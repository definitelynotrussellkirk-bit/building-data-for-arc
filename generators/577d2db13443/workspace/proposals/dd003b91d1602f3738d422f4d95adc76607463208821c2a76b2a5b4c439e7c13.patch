+++ b/repo/generators/577d2db13443/workspace/parametric/first_cap_component.rkt
@@ -0,0 +1,20 @@
+(rule! (let ((dummy 0))
+  (define (row-run r start end color) (list r start end color))
+  (define (row-runs grid)
+    (apply append
+      (for/list ((r (in-range (rows grid))))
+        (let loop ((c 0) (acc (list)))
+          (if (>= c (cols grid)) (reverse acc)
+              (let ((v (at grid r c)))
+                (if (= v 0) (loop (+ c 1) acc)
+                    (let find-end ((cc c))
+                      (if (and (< (+ cc 1) (cols grid)) (= (at grid r (+ cc 1)) v))
+                          (find-end (+ cc 1))
+                          (loop (+ cc 1) (cons (row-run r c cc v) acc)))))))))))
+  (define capped
+    (for/fold ((out g)) ((run (in-list (row-runs g))))
+      (set-cell (set-cell out (first run) (second run) 1)
+                (first run) (third run) 1)))
+  (define cap-components
+    (filter (lambda (obj) (= (obj-color obj) 1)) (objects capped 0)))
+  (paint-cells capped (obj-cells (first cap-components)) 8)))
diff --git a/repo/generators/577d2db13443/workspace/parametric/highlight_largest_cap_component.rkt b/repo/generators/577d2db13443/workspace/parametric/highlight_largest_cap_component.rkt
