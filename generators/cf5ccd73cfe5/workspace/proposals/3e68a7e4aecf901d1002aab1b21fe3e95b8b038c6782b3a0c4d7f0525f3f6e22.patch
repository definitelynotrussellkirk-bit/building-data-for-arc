@@ -0,0 +1,237 @@
+"""Bounded protected-Racket learnability audit for the orientation adapter."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+
+def _load_adjacent(name: str):
+    path = Path(__file__).resolve().with_name(name)
+    spec = importlib.util.spec_from_file_location(
+        "_cf5ccd73cfe5_audit_" + name.replace(".", "_") + "_" + hashlib.sha256(str(path).encode()).hexdigest(),
+        path,
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load task-local source from {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+_ADAPTER = _load_adjacent("adapter.py")
+_PROTOTYPE = _ADAPTER._PROTOTYPE
+
+
+def _replace_once(source: str, old: str, new: str, name: str) -> str:
+    if source.count(old) != 1:
+        raise ValueError(f"{name} source anchor changed; explicit review required")
+    return source.replace(old, new)
+
+
+def rival_programs(settings: dict) -> dict[str, str]:
+    orientation = _ADAPTER._orientation(settings)
+    source = _ADAPTER.program({"orientation": orientation})
+    row = "(- marker-h 1 mr)" if orientation in ("flip_ud", "rot180") else "mr"
+    col = "(- marker-w 1 mc)" if orientation in ("flip_lr", "rot180") else "mc"
+    lookup = f"(hash-has-key? marker-set (list {row} {col}))"
+    return {
+        "red_border": _replace_once(
+            source,
+            "(set-cell out\n                                               (- (first cell) fr1)\n                                               (- (second cell) fc1)\n                                               frame-color)",
+            "(set-cell out\n                                               (- (first cell) fr1)\n                                               (- (second cell) fc1)\n                                               2)",
+            "red-border rival",
+        ),
+        "uniform_height_scale": _replace_once(
+            source,
+            "(mc (quotient ic scale-w))",
+            "(mc (quotient ic scale-h))",
+            "uniform-scale rival",
+        ),
+        "solid_marker_bbox": _replace_once(source, lookup, "#t", "solid-bbox rival"),
+    }
+
+
+def _public(episode: dict) -> dict:
+    return {
+        "train": [
+            {"input": pair["input"], "output": pair["output"]}
+            for pair in episode["train"]
+        ],
+        "test": [{"input": pair["input"]} for pair in episode["test"]],
+    }
+
+
+def _digest(value) -> str:
+    if not isinstance(value, (bytes, bytearray)):
+        value = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(value).hexdigest()
+
+
+def _run_with_bridge(out: Path, *, seed: int, demos: int, queries: int,
+                     settings: tuple[str, ...], bridge) -> dict:
+    from reviewer_support import public_challenge_bytes, public_challenge_id
+
+    evaluations = 0
+
+    def execute(program, grid):
+        nonlocal evaluations
+        evaluations += 1
+        return _PROTOTYPE.execute(bridge, program, grid)
+
+    setting_rows = []
+    for orientation in settings:
+        chosen = {"orientation": orientation}
+        episode = _ADAPTER.generate(seed, chosen, demos, queries)
+        setting_programs = {
+            candidate: _ADAPTER.program({"orientation": candidate})
+            for candidate in _PROTOTYPE.SETTINGS
+        }
+
+        for split in ("train", "test"):
+            for pair in episode[split]:
+                actual = execute(episode["program_solution"], pair["input"])
+                if actual != pair["output"]:
+                    raise ValueError(f"adapter label differs from protected Racket for {orientation}")
+
+        native_survivors = []
+        for candidate, program in setting_programs.items():
+            outputs = [execute(program, pair["input"]) for pair in episode["train"]]
+            if all(output == pair["output"] for output, pair in zip(outputs, episode["train"])):
+                native_survivors.append(candidate)
+        if native_survivors != [orientation]:
+            raise ValueError(f"native settings are not demonstration-identifiable: {native_survivors}")
+
+        extra_rows = {}
+        for name, program in rival_programs(chosen).items():
+            demo_outputs = [execute(program, pair["input"]) for pair in episode["train"]]
+            query_outputs = [execute(program, pair["input"]) for pair in episode["test"]]
+            mismatch_indices = [
+                index for index, (actual, pair) in enumerate(zip(demo_outputs, episode["train"]))
+                if actual != pair["output"]
+            ]
+            if not mismatch_indices:
+                raise ValueError(f"plausible wrong rule survives every visible demonstration: {name}")
+            first = mismatch_indices[0]
+            extra_rows[name] = {
+                "program_sha256": _digest(program.encode()),
+                "survives_demonstrations": False,
+                "demo_mismatch_indices": mismatch_indices,
+                "query_differs": [
+                    index for index, (actual, pair) in enumerate(zip(query_outputs, episode["test"]))
+                    if actual != pair["output"]
+                ],
+                "minimal_racket_labeled_case": {
+                    "demo_index": first,
+                    "input": episode["train"][first]["input"],
+                    "intended_output": episode["train"][first]["output"],
+                    "rival_output": demo_outputs[first],
+                },
+            }
+
+        public = _public(episode)
+        public_id = public_challenge_id(public)
+        (out / "public" / f"{public_id}.json").write_bytes(public_challenge_bytes(public))
+        setting_rows.append({
+            "settings": chosen,
+            "program_sha256": _digest(episode["program_solution"].encode()),
+            "native_survivors": native_survivors,
+            "extra_rivals": extra_rows,
+            "public_challenge_id": public_id,
+            "input_shapes": {
+                split: [[len(pair["input"]), len(pair["input"][0])] for pair in episode[split]]
+                for split in ("train", "test")
+            },
+            "query_output_sha256": [_digest(pair["output"]) for pair in episode["test"]],
+        })
+
+    runtime = bridge.runtime_identity
+    result = {
+        "schema": "cf5ccd73cfe5-parametric-self-audit-v1",
+        "status": "passed",
+        "task_id": _PROTOTYPE.TASK,
+        "seed": seed,
+        "demos": demos,
+        "queries": queries,
+        "settings_checked": len(setting_rows),
+        "settings": setting_rows,
+        "racket": {
+            key: runtime[key]
+            for key in ("backend", "protected", "binary_sha256", "prelude_sha256", "bridge_sha256")
+            if key in runtime
+        },
+        "racket_evaluations": evaluations,
+        "limits": (
+            "Finite audit of four declared settings and three executable wrong rules; "
+            "not a proof of universal uniqueness or training benefit."
+        ),
+    }
+    (out / "private" / "audit.json").write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    receipt = {
+        "schema": "cf5ccd73cfe5-parametric-self-audit-receipt-v1",
+        "audit_sha256": _digest((out / "private" / "audit.json").read_bytes()),
+        "public_files": {
+            path.name: _digest(path.read_bytes()) for path in sorted((out / "public").glob("*.json"))
+        },
+        "source_sha256": {
+            path.name: _digest(path.read_bytes())
+            for path in (
+                Path(__file__).resolve(),
+                Path(__file__).resolve().with_name("adapter.py"),
+                Path(__file__).resolve().with_name("orientation.py"),
+            )
+        },
+    }
+    (out / "receipt.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
+    return result
+
+
+def run_audit(out, *, seed=0, demos=2, queries=4, settings=None, bridge=None):
+    if type(seed) is not int or not 0 <= seed <= 2**63 - 1:
+        raise ValueError("seed must be an exact integer in 0..2**63-1")
+    if type(demos) is not int or not 2 <= demos <= 6:
+        raise ValueError("demos must be an exact integer in 2..6")
+    if type(queries) is not int or not 1 <= queries <= 4:
+        raise ValueError("queries must be an exact integer in 1..4")
+    selected = tuple(_PROTOTYPE.SETTINGS if settings is None else settings)
+    if not selected or len(set(selected)) != len(selected) or any(value not in _PROTOTYPE.SETTINGS for value in selected):
+        raise ValueError("settings must be distinct declared orientation values")
+
+    out = Path(out)
+    if out.exists() and any(out.iterdir()):
+        raise FileExistsError(out)
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "public").mkdir()
+    (out / "private").mkdir()
+
+    if bridge is not None:
+        return _run_with_bridge(out, seed=seed, demos=demos, queries=queries,
+                                settings=selected, bridge=bridge)
+    from arc_repl.racket_bridge import RacketBridge
+    with RacketBridge() as live:
+        return _run_with_bridge(out, seed=seed, demos=demos, queries=queries,
+                                settings=selected, bridge=live)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--demos", type=int, default=2)
+    parser.add_argument("--queries", type=int, default=4)
+    args = parser.parse_args(argv)
+    result = run_audit(args.out, seed=args.seed, demos=args.demos, queries=args.queries)
+    print(json.dumps({
+        "status": result["status"],
+        "task_id": result["task_id"],
+        "settings_checked": result["settings_checked"],
+        "racket_evaluations": result["racket_evaluations"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
