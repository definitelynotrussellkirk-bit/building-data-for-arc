+"""Bounded produced-domain learnability probe for c9db537b5068."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+from pathlib import Path
+
+HOME = Path(__file__).resolve().parents[1]
+PROBE = HOME / "workspace/learnability_probe.py"
+
+
+def _load(path: Path):
+    assert path.is_file(), f"missing diagnostic: {path}"
+    name = "_c9_probe_" + hashlib.sha256(str(path).encode()).hexdigest()
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_probe_finds_exact_canonical_dimension_shortcut_in_produced_window():
+    probe = _load(PROBE)
+    witness = probe.find_witness(
+        seeds=range(1), starts=range(8), difficulties=(None,), demos=3
+    )
+    assert witness is not None
+    assert witness["seed"] == 0
+    assert witness["difficulty"] is None
+    assert witness["demo_indices"] == [4, 5, 6]
+    assert witness["query_index"] == 7
+    assert witness["rival"] == "canonical_bbox_dimensions_only"
+    assert witness["demo_bbox_dimensions"] == [[5, 5], [4, 5], [4, 6]]
+    assert witness["query_bbox_dimensions"] == [4, 4]
+    assert all(witness["rival_demo_matches"])
+    assert witness["rival_query_matches"] is False
