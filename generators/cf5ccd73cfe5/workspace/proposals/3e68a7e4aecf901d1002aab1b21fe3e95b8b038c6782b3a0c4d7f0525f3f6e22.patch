+"""Native promotion adapter contract for the orientation family."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+PARAMETRIC = HOME / "workspace/parametric"
+
+
+def _load(path: Path, stem: str):
+    assert path.is_file(), f"missing native parametric source: {path.name}"
+    name = f"_{stem}_{hashlib.sha256(str(path).encode()).hexdigest()}"
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_native_adapter_maps_exact_settings_to_existing_racket_programs():
+    prototype = _load(PARAMETRIC / "orientation.py", "orientation")
+    adapter = _load(PARAMETRIC / "adapter.py", "adapter")
+
+    for setting in prototype.SETTINGS:
+        assert adapter.program({"orientation": setting}) == prototype.program(setting)
+
+    for invalid in ({}, {"orientation": "rot90"}, {"orientation": "identity", "extra": 1}):
+        with pytest.raises(ValueError):
+            adapter.program(invalid)
+
+@pytest.fixture(scope="module")
+def bridge():
+    from arc_repl.racket_bridge import RacketBridge
+
+    with RacketBridge() as live:
+        yield live
+
+
+def test_generate_honors_independent_counts_with_matched_inputs_and_racket_labels(bridge):
+    prototype = _load(PARAMETRIC / "orientation.py", "orientation_generate")
+    adapter = _load(PARAMETRIC / "adapter.py", "adapter_generate")
+    episodes = {
+        setting: adapter.generate(17, {"orientation": setting}, 2, 4)
+        for setting in prototype.SETTINGS
+    }
+
+    baseline_inputs = None
+    for setting, episode in episodes.items():
+        assert len(episode["train"]) == 2
+        assert len(episode["test"]) == 4
+        assert episode["program_solution"] == prototype.program(setting)
+        inputs = [pair["input"] for split in ("train", "test") for pair in episode[split]]
+        assert len({prototype.encoded(grid) for grid in inputs}) == 6
+        if baseline_inputs is None:
+            baseline_inputs = inputs
+        else:
+            assert inputs == baseline_inputs
+        for split in ("train", "test"):
+            for pair in episode[split]:
+                assert prototype.execute(bridge, episode["program_solution"], pair["input"]) == pair["output"]
+
+
+def test_all_declared_count_boundaries_are_independent_and_strict():
+    adapter = _load(PARAMETRIC / "adapter.py", "adapter_counts")
+    settings = {"orientation": "rot180"}
+
+    for demos in range(2, 7):
+        for queries in range(1, 5):
+            episode = adapter.generate(7, settings, demos, queries)
+            assert len(episode["train"]) == demos
+            assert len(episode["test"]) == queries
+
+    for seed, demos, queries in (
+        (True, 2, 1), (0, 1, 1), (0, 7, 1), (0, 2, 0), (0, 2, 5),
+    ):
+        with pytest.raises(ValueError):
+            adapter.generate(seed, settings, demos, queries)
+
+
+def test_four_query_schedule_has_substantive_30x30_boundary_stress_and_stable_prefix():
+    prototype = _load(PARAMETRIC / "orientation.py", "orientation_stress")
+    adapter = _load(PARAMETRIC / "adapter.py", "adapter_stress")
+    settings = {"orientation": "flip_lr"}
+
+    full = adapter.generate(29, settings, 3, 4)
+    single = adapter.generate(29, settings, 3, 1)
+    assert single["train"] == full["train"]
+    assert single["test"] == full["test"][:1]
+
+    queries = full["test"]
+    assert len(queries) == 4
+    assert len({prototype.encoded(pair["input"]) for pair in queries}) == 4
+    large = [pair for pair in queries if (len(pair["input"]), len(pair["input"][0])) == (30, 30)]
+    assert len(large) == 1
+    grid = large[0]["input"]
+    assert any(grid[0]) and any(grid[-1])
+    assert any(row[0] for row in grid) and any(row[-1] for row in grid)
+    assert len(large[0]["output"]) >= 24 and len(large[0]["output"][0]) >= 24
+
+
+def test_two_demo_minimum_refutes_declared_shortcuts_for_every_setting():
+    prototype = _load(PARAMETRIC / "orientation.py", "orientation_shortcuts")
+    adapter = _load(PARAMETRIC / "adapter.py", "adapter_shortcuts")
+    generator = adapter._GENERATOR
+
+    for setting in prototype.SETTINGS:
+        episode = adapter.generate(0, {"orientation": setting}, 2, 4)
+        survivors = [
+            name
+            for name, rival in generator.CANONICAL_SHORTCUTS.items()
+            if all(rival(pair["input"]) == pair["output"] for pair in episode["train"])
+        ]
+        assert survivors == [], (setting, survivors)
+
+
+def test_self_audit_executes_wrong_rules_and_writes_strict_public_projection(tmp_path, bridge):
+    prototype = _load(PARAMETRIC / "orientation.py", "orientation_audit")
+    audit = _load(PARAMETRIC / "audit.py", "audit")
+
+    result = audit.run_audit(tmp_path, seed=0, demos=2, queries=4,
+                             settings=("identity",), bridge=bridge)
+    assert result["status"] == "passed"
+    assert result["settings_checked"] == 1
+    assert result["racket"]["backend"] == "racket"
+    assert result["racket"]["protected"] is True
+    assert result["racket_evaluations"] > 0
+    assert set(result["settings"][0]["extra_rivals"]) == {
+        "red_border", "solid_marker_bbox", "uniform_height_scale"
+    }
+    assert all(not row["survives_demonstrations"]
+               for row in result["settings"][0]["extra_rivals"].values())
+
+    public_files = sorted((tmp_path / "public").glob("*.json"))
+    assert len(public_files) == 1
+    payload = json.loads(public_files[0].read_text())
+    assert set(payload) == {"train", "test"}
+    assert len(payload["train"]) == 2 and len(payload["test"]) == 4
+    assert all(set(pair) == {"input"} for pair in payload["test"])
+    text = public_files[0].read_text()
+    assert all(secret not in text for secret in prototype.SETTINGS)
