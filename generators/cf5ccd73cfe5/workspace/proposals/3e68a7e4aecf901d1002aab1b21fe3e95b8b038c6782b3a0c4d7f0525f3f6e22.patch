+"""Bounded produced-domain learnability probe for d4f2f542248a."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+from pathlib import Path
+
+HOME = Path(__file__).resolve().parents[1]
+PROBE = HOME / "workspace/learnability_probe.py"
+
+
+def _load(path: Path):
+    assert path.is_file(), f"missing diagnostic: {path}"
+    name = "_d4_probe_" + hashlib.sha256(str(path).encode()).hexdigest()
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_probe_finds_disconnected_pocket_gate_in_produced_window():
+    probe = _load(PROBE)
+    witness = probe.find_witness(
+        seeds=range(1), starts=range(9), difficulties=(None,), demos=3
+    )
+    assert witness is not None
+    assert witness["seed"] == 0
+    assert witness["difficulty"] is None
+    assert witness["demo_indices"] == [5, 6, 7]
+    assert witness["query_index"] == 8
+    assert witness["rival"] == "skip_when_disconnected_pockets_exist"
+    assert witness["demo_profiles"] == [
+        "dead_end_contrast", "public_3", "many_paths_few_gates"
+    ]
+    assert witness["query_profile"] == "disconnected_pockets"
+    assert witness["demo_unreachable_open"] == [0, 0, 0]
+    assert witness["query_unreachable_open"] > 0
+    assert all(witness["rival_demo_matches"])
+    assert witness["rival_query_matches"] is False
diff --git a/repo/generators/d4f2f542248a/workspace/learnability_probe.py b/repo/generators/d4f2f542248a/workspace/learnability_probe.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/d4f2f542248a/workspace/learnability_probe.py
@@ -0,0 +1,234 @@
+"""Find and Racket-bind a produced-domain teaching shortcut for d4f2f542248a."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+TASK = "d4f2f542248a"
+HOME = Path(__file__).resolve().parents[1]
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def _load_generator():
+    path = HOME / "generator.py"
+    name = "_d4f2f542248a_probe_generator_" + hashlib.sha256(str(path).encode()).hexdigest()
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load generator from {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+GENERATOR = _load_generator()
+
+
+def _digest(value) -> str:
+    if not isinstance(value, (bytes, bytearray)):
+        value = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(value).hexdigest()
+
+
+def skip_when_disconnected_pockets_exist(grid):
+    """Plausible shortcut: apply the path rule only when all open cells connect."""
+    facts = GENERATOR._path_facts(grid)
+    if not facts.get("connected") or facts["unreachable_open"]:
+        return [list(row) for row in grid]
+    return GENERATOR.rule_mirror(grid)
+
+
+RIVALS = {"skip_when_disconnected_pockets_exist": skip_when_disconnected_pockets_exist}
+
+
+def find_witness(*, seeds, starts, difficulties=(None, "easy", "medium", "hard"), demos=3):
+    """Return the first consecutive produced lesson fitting a declared rival."""
+    if type(demos) is not int or demos < 1:
+        raise ValueError("demos must be a positive exact integer")
+    starts = tuple(starts)
+    for start in starts:
+        if type(start) is not int or start < 0:
+            raise ValueError("starts must contain nonnegative exact integers")
+    for difficulty in difficulties:
+        for seed in seeds:
+            if type(seed) is not int:
+                raise ValueError("seeds must contain exact integers")
+            cache = {}
+            for start in starts:
+                grids = []
+                for index in range(start, start + demos + 1):
+                    if index not in cache:
+                        cache[index] = GENERATOR.generate(seed, index, difficulty=difficulty)
+                    grids.append(cache[index])
+                intended = [GENERATOR.rule_mirror(grid) for grid in grids]
+                analyses = [GENERATOR._analysis(grid) for grid in grids]
+                for name, rival in RIVALS.items():
+                    rival_outputs = [rival(grid) for grid in grids]
+                    demo_matches = [
+                        rival_outputs[index] == intended[index]
+                        for index in range(demos)
+                    ]
+                    query_matches = rival_outputs[demos] == intended[demos]
+                    if all(demo_matches) and not query_matches:
+                        return {
+                            "task_id": TASK,
+                            "seed": seed,
+                            "difficulty": difficulty,
+                            "demo_indices": list(range(start, start + demos)),
+                            "query_index": start + demos,
+                            "rival": name,
+                            "demo_profiles": [
+                                item["scene_profile"] for item in analyses[:demos]
+                            ],
+                            "query_profile": analyses[demos]["scene_profile"],
+                            "demo_unreachable_open": [
+                                item["facts"]["unreachable_open"]
+                                for item in analyses[:demos]
+                            ],
+                            "query_unreachable_open": analyses[demos]["facts"]["unreachable_open"],
+                            "rival_demo_matches": demo_matches,
+                            "rival_query_matches": query_matches,
+                        }
+    return None
+
+
+def _canonical_program() -> str:
+    programs = set()
+    path = ROOT / "shared/data/canonical/puzzles.jsonl"
+    with path.open() as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program for {TASK}, found {len(programs)}")
+    return programs.pop()
+
+
+def _execute(bridge, source, grid):
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    literal = "'(" + " ".join(
+        "(" + " ".join(map(str, row)) + ")" for row in grid
+    ) + ")"
+    result = bridge.eval_text(f"({wrap_rule(source)} {literal})")
+    if not isinstance(result, list) or not result or any(not isinstance(row, list) for row in result):
+        raise ValueError("Racket did not return a nonempty grid")
+    return result
+
+
+def materialize(witness, bridge):
+    """Rebuild the selected window and bind intended labels to canonical Racket."""
+    if witness is None:
+        raise ValueError("cannot materialize a missing witness")
+    indices = [*witness["demo_indices"], witness["query_index"]]
+    grids = [
+        GENERATOR.generate(witness["seed"], index, difficulty=witness["difficulty"])
+        for index in indices
+    ]
+    source = _canonical_program()
+    intended = [_execute(bridge, source, grid) for grid in grids]
+    mirror = [GENERATOR.rule_mirror(grid) for grid in grids]
+    if intended != mirror:
+        raise ValueError("path-count mirror differs from canonical Racket")
+    rival = RIVALS[witness["rival"]]
+    rival_outputs = [rival(grid) for grid in grids]
+    demos = len(witness["demo_indices"])
+    if not all(rival_outputs[index] == intended[index] for index in range(demos)):
+        raise ValueError("rival no longer fits every visible demonstration")
+    if rival_outputs[demos] == intended[demos]:
+        raise ValueError("rival no longer differs on the held-out query")
+    return {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "status": "finding",
+        **witness,
+        "canonical_program_sha256": _digest(source.encode()),
+        "generator_sha256": _digest((HOME / "generator.py").read_bytes()),
+        "probe_sha256": _digest(Path(__file__).read_bytes()),
+        "racket": {
+            key: bridge.runtime_identity[key]
+            for key in ("backend", "protected", "binary_sha256", "prelude_sha256", "bridge_sha256")
+            if key in bridge.runtime_identity
+        },
+        "pairs": [
+            {
+                "role": "demo" if index < demos else "query",
+                "sample_index": indices[index],
+                "scene_profile": GENERATOR._analysis(grids[index])["scene_profile"],
+                "input": grids[index],
+                "intended_output": intended[index],
+                "rival_output": rival_outputs[index],
+                "matches": intended[index] == rival_outputs[index],
+            }
+            for index in range(len(grids))
+        ],
+        "finding": (
+            "The three consecutive visible demonstrations contain no disconnected open "
+            "pocket, so the executable rule 'return the input unchanged whenever a pocket "
+            "exists' fits every label; the next produced disconnected-pockets query still "
+            "requires marking unavoidable shortest-path cells and separates the rules."
+        ),
+        "suggested_repair": (
+            "Construct or schedule the demonstrations so a disconnected-pockets example "
+            "is visible before a disconnected-pockets query, without increasing the demo count."
+        ),
+        "limits": (
+            "First witness in the requested finite seed/start/difficulty bounds; this does not "
+            "measure ambiguity frequency or prove other rival classes absent."
+        ),
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--max-seeds", type=int, default=16)
+    parser.add_argument("--max-starts", type=int, default=32)
+    parser.add_argument("--demos", type=int, default=3)
+    args = parser.parse_args(argv)
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    witness = find_witness(
+        seeds=range(args.max_seeds),
+        starts=range(args.max_starts),
+        demos=args.demos,
+    )
+    if witness is None:
+        result = {
+            "schema": "arcpuzzles-peer-learnability-probe-v1",
+            "status": "no_witness_within_bounds",
+            "task_id": TASK,
+            "bounds": {
+                "max_seeds": args.max_seeds,
+                "max_starts": args.max_starts,
+                "demos": args.demos,
+            },
+            "rivals": sorted(RIVALS),
+        }
+    else:
+        from arc_repl.racket_bridge import RacketBridge
+        with RacketBridge() as bridge:
+            result = materialize(witness, bridge)
+        result["bounds"] = {
+            "max_seeds": args.max_seeds,
+            "max_starts": args.max_starts,
+            "demos": args.demos,
+        }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": result["status"],
+        "task_id": TASK,
+        "rival": result.get("rival"),
+        "seed": result.get("seed"),
+        "demo_indices": result.get("demo_indices"),
+        "query_index": result.get("query_index"),
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
