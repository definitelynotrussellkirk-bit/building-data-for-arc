(rule! (lambda (grid)
         (let* ((h (rows grid))
                (w (cols grid))
                (objs (objects grid 0)))
           (foldl (lambda (obj acc)
                    (let* ((color (if (= (obj-size obj) 7) 2 1))
                           (cells (obj-cells obj)))
                      (recolor-cells acc cells color)))
                  (empty-grid h w 0)
                  objs))))