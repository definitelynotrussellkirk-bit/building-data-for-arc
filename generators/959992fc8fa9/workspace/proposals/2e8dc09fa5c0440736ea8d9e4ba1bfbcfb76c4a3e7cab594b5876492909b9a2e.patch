+"""Regression coverage for template/layout role identifiability."""
+from __future__ import annotations
+
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK_ID = "4dc9d686082b"
+ROOT = find_root(__file__)
+gen, _PATH, _SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _factor_masks(grid: list[list[int]]) -> tuple[list[list[int]], list[list[int]]]:
+    height, width = len(grid), len(grid[0])
+    separators = [col for col in range(width) if grid[0][col] == 5]
+    assert len(separators) == 3
+    first, second, _third = separators
+
+    template_cells = [
+        (row, col)
+        for row in range(height)
+        for col in range(first)
+        if grid[row][col] == 1
+    ]
+    top = min(row for row, _ in template_cells)
+    bottom = max(row for row, _ in template_cells)
+    left = min(col for _, col in template_cells)
+    right = max(col for _, col in template_cells)
+    template = [
+        [1 if grid[row][col] == 1 else 0 for col in range(left, right + 1)]
+        for row in range(top, bottom + 1)
+    ]
+
+    layout_cells = [
+        (row, col)
+        for row in range(height)
+        for col in range(first + 1, second)
+        if grid[row][col] == 2
+    ]
+    layout_top = min(row for row, _ in layout_cells)
+    layout_left = min(col for _, col in layout_cells)
+    layout = [
+        [
+            1 if grid[row][col] == 2 else 0
+            for col in range(layout_left, layout_left + len(template[0]))
+        ]
+        for row in range(layout_top, layout_top + len(template))
+    ]
+    return template, layout
+
+
+def _distinguishes_role_order(grid: list[list[int]]) -> bool:
+    template, layout = _factor_masks(grid)
+    height, width = len(template), len(template[0])
+    actual = [
+        layout[outer_row][outer_col] * template[inner_row][inner_col]
+        for outer_row in range(height)
+        for inner_row in range(height)
+        for outer_col in range(width)
+        for inner_col in range(width)
+    ]
+    swapped = [
+        template[outer_row][outer_col] * layout[inner_row][inner_col]
+        for outer_row in range(height)
+        for inner_row in range(height)
+        for outer_col in range(width)
+        for inner_col in range(width)
+    ]
+    return actual != swapped
+
+
+def test_seed_37_lesson_constructively_distinguishes_template_and_layout_roles():
+    lesson = [gen.generate(37, sample_index) for sample_index in range(5)]
+    assert all(gen.self_check(grid) == [] for grid in lesson)
+    assert all(_distinguishes_role_order(grid) for grid in lesson)
