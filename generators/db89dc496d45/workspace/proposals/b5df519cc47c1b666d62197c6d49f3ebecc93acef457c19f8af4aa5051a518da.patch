+def _is_rectangular(cells) -> bool:
+    rows = [row for row, _ in cells]
+    cols = [col for _, col in cells]
+    area = (max(rows) - min(rows) + 1) * (max(cols) - min(cols) + 1)
+    return area == len(cells)
