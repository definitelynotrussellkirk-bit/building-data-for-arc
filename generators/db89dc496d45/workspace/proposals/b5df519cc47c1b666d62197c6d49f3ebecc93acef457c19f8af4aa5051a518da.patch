+"""Regression tests for the keyed-rotation generator contract and lesson schedule."""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import random
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+REPO = HOME.parents[1]
+SOURCE = HOME / "generator.py"
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location("generator_1aec632783b9", SOURCE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_pairs():
+    with (REPO / "shared/data/canonical/puzzles.jsonl").open(encoding="utf-8") as stream:
+        row = next(json.loads(line) for line in stream if json.loads(line).get("task_id") == "1aec632783b9")
+    test = row["test"] if isinstance(row["test"], list) else [row["test"]]
+    return list(row["train"]) + test
+
+
+def _key(grid):
+    keys = [value for row in grid for value in row if value in (2, 3, 4, 5)]
+    assert len(keys) == 1
+    return keys[0]
+
+
+def _key_position(grid):
+    return next(
+        (row, col)
+        for row, values in enumerate(grid)
+        for col, value in enumerate(values)
+        if value in (2, 3, 4, 5)
+    )
+
+
+def _freeze(grid):
+    return tuple(tuple(row) for row in grid)
+
+
+def test_canonical_pairs_are_accepted_and_rule_mirror_matches_labels():
+    gen = _load()
+    for pair in _canonical_pairs():
+        before = copy.deepcopy(pair["input"])
+        assert gen.self_check(pair["input"]) == []
+        assert gen.rule_mirror(pair["input"]) == pair["output"]
+        assert pair["input"] == before
+
+
+def test_helpful_texture_aliases_select_the_declared_rotation_key():
+    gen = _load()
+    aliases = {"identity": 2, "cw": 3, "rot180": 4, "ccw": 5}
+    grids = {}
+    for texture, expected_key in aliases.items():
+        grid = gen.generate(42, 7, difficulty="medium", texture=texture)
+        assert _key(grid) == expected_key
+        assert gen.self_check(grid) == []
+        grids[texture] = grid
+    stripped = []
+    for grid in grids.values():
+        clone = copy.deepcopy(grid)
+        row, col = _key_position(clone)
+        clone[row][col] = 0
+        stripped.append(_freeze(clone))
+    assert len(set(stripped)) == 1
+
+
+@pytest.mark.parametrize(
+    ("corner", "selector"),
+    [
+        ("tl", lambda h, w: (0, 0)),
+        ("tr", lambda h, w: (0, w - 1)),
+        ("bl", lambda h, w: (h - 1, 0)),
+        ("br", lambda h, w: (h - 1, w - 1)),
+    ],
+)
+def test_corner_axis_uses_the_documented_string_domain(corner, selector):
+    gen = _load()
+    grid = gen.generate(91, 3, difficulty="hard", corner=corner)
+    assert _key_position(grid) == selector(len(grid), len(grid[0]))
+    assert gen.self_check(grid) == []
+
+
+def test_unknown_conflicting_and_bad_scalar_overrides_fail_closed():
+    gen = _load()
+    with pytest.raises(ValueError, match="unknown override"):
+        gen.generate(1, 0, mystery_axis="typo")
+    with pytest.raises(ValueError, match="unsupported difficulty"):
+        gen.generate(1, 0, difficulty="impossible")
+    with pytest.raises(ValueError, match="conflict"):
+        gen.generate(1, 0, key=2, texture="cw")
+    for value in (True, 3.0, "3"):
+        with pytest.raises((TypeError, ValueError)):
+            gen.generate(1, 0, key=value)
+    for value in (True, 8.0, "8"):
+        with pytest.raises((TypeError, ValueError)):
+            gen.generate(1, 0, grid_h=value)
+
+
+def test_self_check_rejects_minimal_structure_impostors():
+    gen = _load()
+
+    two_blobs = [[0] * 7 for _ in range(7)]
+    for row, col in ((1, 1), (1, 2), (2, 1), (4, 4), (4, 5), (5, 4)):
+        two_blobs[row][col] = 1
+    two_blobs[0][0] = 2
+
+    rectangle = [[0] * 7 for _ in range(7)]
+    for row in (2, 3):
+        for col in (2, 3):
+            rectangle[row][col] = 1
+    rectangle[0][0] = 2
+
+    interior_key = [[0] * 7 for _ in range(7)]
+    for row, col in ((1, 1), (1, 2), (2, 1)):
+        interior_key[row][col] = 1
+    interior_key[3][3] = 2
+
+    unexpected_color = copy.deepcopy(interior_key)
+    unexpected_color[3][3] = 0
+    unexpected_color[0][0] = 2
+    unexpected_color[6][6] = 9
+
+    for malformed in (two_blobs, rectangle, interior_key, unexpected_color):
+        assert gen.self_check(malformed)
+
+
+def test_every_aligned_four_pair_lesson_repeats_a_visible_query_key():
+    gen = _load()
+    assert gen.EXAMPLES_NEEDED == 3
+    query_keys = set()
+    for seed in range(32):
+        for block in range(8):
+            start = 4 * block
+            pairs = []
+            for offset in range(4):
+                grid = gen.generate(seed, start + offset, difficulty="medium")
+                pairs.append({"input": grid, "output": gen.rule_mirror(grid)})
+            query_keys.add(_key(pairs[-1]["input"]))
+            assert _key(pairs[-1]["input"]) in {
+                _key(pair["input"]) for pair in pairs[:3]
+            }
+            assert gen.lesson_identifiable(pairs[:3], pairs[-1]) == []
+    assert query_keys == {2, 3, 4, 5}
+
+
+def test_generation_is_deterministic_fresh_and_global_rng_pure():
+    gen = _load()
+    random.seed(20261025)
+    state = random.getstate()
+    first = gen.generate(77, 11, difficulty="hard")
+    second = gen.generate(77, 11, difficulty="hard")
+    assert random.getstate() == state
+    assert first == second and first is not second
+    assert all(left is not right for left, right in zip(first, second))
+    frozen = _freeze(second)
+    first[0][0] = 9 if first[0][0] != 9 else 8
+    assert _freeze(gen.generate(77, 11, difficulty="hard")) == frozen
+
+
+def test_fallback_template_handles_smallest_canvas_with_largest_blob():
+    """The guaranteed fallback must cover every advertised axis combination."""
+    gen = _load()
+    cells = gen._fallback_blob(7, 7, set(), 9)
+    assert len(cells) == 9
+    assert all(0 <= row < 7 and 0 <= col < 7 for row, col in cells)
+    assert len(gen._components(set(cells))) == 1
+    assert not gen._is_rectangular(cells)
+    assert gen._rotations_distinct(cells)
