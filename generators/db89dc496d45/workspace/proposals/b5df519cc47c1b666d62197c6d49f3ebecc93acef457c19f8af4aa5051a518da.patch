+"""Bounded lesson, override, and protected-Racket audit for 1aec632783b9.
+
+The report is source-bound reviewer evidence, not owner acceptance.  It checks
+aligned three-demo/one-query lessons, the exact advertised controls, strict
+rejection surfaces, canonical parity, and a sampled protected-Racket replay.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+TASK_ID = "1aec632783b9"
+HERE = Path(__file__).resolve()
+REPO = HERE.parents[3]
+SOURCE = REPO / "generators" / TASK_ID / "generator.py"
+sys.path.insert(0, str(REPO / "shared" / "runtime"))
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(f"audit_{TASK_ID}", SOURCE)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {SOURCE}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_row():
+    rows = []
+    with (REPO / "shared/data/canonical/puzzles.jsonl").open(encoding="utf-8") as stream:
+        for line in stream:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                rows.append(row)
+    if len(rows) != 1:
+        raise ValueError(f"expected one canonical row, found {len(rows)}")
+    return rows[0]
+
+
+def _key(grid):
+    values = [value for row in grid for value in row if value in (2, 3, 4, 5)]
+    if len(values) != 1:
+        raise ValueError(f"expected one key, found {values}")
+    return values[0]
+
+
+def _grid_literal(grid):
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def python_audit(gen, seed_count: int, block_count: int):
+    failures = []
+    key_counts = Counter()
+    corner_counts = Counter()
+    size_counts = Counter()
+    distinct_inputs = set()
+    lesson_count = 0
+    pair_count = 0
+
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in range(seed_count):
+            for block in range(block_count):
+                start = 4 * block
+                pairs = []
+                for offset in range(4):
+                    index = start + offset
+                    grid = gen.generate(seed, index, difficulty=difficulty)
+                    errors = gen.self_check(grid, difficulty=difficulty)
+                    if errors:
+                        failures.append(
+                            {
+                                "kind": "self_check",
+                                "difficulty": difficulty,
+                                "seed": seed,
+                                "index": index,
+                                "errors": errors,
+                            }
+                        )
+                    output = gen.rule_mirror(grid)
+                    pairs.append({"input": grid, "output": output})
+                    facts = gen.analyze_scene(grid)["facts"]
+                    key_counts[str(facts["key"])] += 1
+                    corner_counts[facts["corner"]] += 1
+                    size_counts[str(len(facts["template_cells"]))] += 1
+                    distinct_inputs.add(json.dumps(grid, separators=(",", ":")))
+                    pair_count += 1
+
+                query_key = _key(pairs[-1]["input"])
+                demo_keys = {_key(pair["input"]) for pair in pairs[:3]}
+                reasons = gen.lesson_identifiable(pairs[:3], pairs[-1])
+                if query_key not in demo_keys or reasons:
+                    failures.append(
+                        {
+                            "kind": "lesson",
+                            "difficulty": difficulty,
+                            "seed": seed,
+                            "block": block,
+                            "demo_keys": sorted(demo_keys),
+                            "query_key": query_key,
+                            "reasons": reasons,
+                        }
+                    )
+                lesson_count += 1
+
+    aliases = {"identity": 2, "cw": 3, "rot180": 4, "ccw": 5}
+    alias_rows = {}
+    for texture, expected in aliases.items():
+        grid = gen.generate(19, 7, difficulty="medium", texture=texture)
+        alias_rows[texture] = {"expected_key": expected, "observed_key": _key(grid)}
+        if _key(grid) != expected:
+            failures.append({"kind": "texture_alias", "texture": texture})
+
+    corner_rows = {}
+    expected_corners = {
+        "tl": lambda h, w: (0, 0),
+        "tr": lambda h, w: (0, w - 1),
+        "bl": lambda h, w: (h - 1, 0),
+        "br": lambda h, w: (h - 1, w - 1),
+    }
+    for corner, expected in expected_corners.items():
+        grid = gen.generate(23, 2, difficulty="medium", corner=corner)
+        facts = gen.analyze_scene(grid)["facts"]
+        observed = facts["corner"]
+        corner_rows[corner] = observed
+        if observed != corner:
+            failures.append({"kind": "corner_axis", "corner": corner, "observed": observed})
+
+    return {
+        "lessons": lesson_count,
+        "pairs": pair_count,
+        "distinct_inputs": len(distinct_inputs),
+        "key_counts": dict(sorted(key_counts.items())),
+        "corner_counts": dict(sorted(corner_counts.items())),
+        "blob_size_counts": dict(sorted(size_counts.items(), key=lambda item: int(item[0]))),
+        "texture_aliases": alias_rows,
+        "corner_overrides": corner_rows,
+        "failures": failures,
+    }
+
+
+def racket_audit(gen, canonical, sample_count: int):
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    bridge = RacketBridge()
+    try:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise ValueError("protected Racket runtime required")
+        wrapped = wrap_rule(canonical["program_solution"])
+        mismatches = []
+        rows = []
+        for index in range(sample_count):
+            difficulty = ("easy", "medium", "hard")[index % 3]
+            grid = gen.generate(700 + index // 4, index, difficulty=difficulty)
+            expected = gen.rule_mirror(grid)
+            actual = bridge.eval_text(f"({wrapped} {_grid_literal(grid)})")
+            rows.append(
+                {
+                    "seed": 700 + index // 4,
+                    "sample_index": index,
+                    "difficulty": difficulty,
+                    "key": _key(grid),
+                    "matches": actual == expected,
+                }
+            )
+            if actual != expected:
+                mismatches.append({"index": index, "expected": expected, "actual": actual})
+        keep = (
+            "schema",
+            "backend",
+            "protected",
+            "deterministic",
+            "binary_sha256",
+            "prelude_sha256",
+            "bridge_sha256",
+            "security_canary",
+        )
+        return {
+            "evaluations": sample_count,
+            "mismatches": mismatches,
+            "rows": rows,
+            "runtime": {name: identity.get(name) for name in keep if name in identity},
+        }
+    finally:
+        bridge.close()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed-count", type=int, default=64)
+    parser.add_argument("--block-count", type=int, default=8)
+    parser.add_argument("--racket-samples", type=int, default=32)
+    args = parser.parse_args()
+
+    gen = _load_generator()
+    canonical = _canonical_row()
+    python_report = python_audit(gen, args.seed_count, args.block_count)
+    racket_report = racket_audit(gen, canonical, args.racket_samples)
+    canonical_pairs = list(canonical["train"]) + (
+        list(canonical["test"]) if isinstance(canonical["test"], list) else [canonical["test"]]
+    )
+    canonical_failures = [
+        index
+        for index, pair in enumerate(canonical_pairs)
+        if gen.self_check(pair["input"]) or gen.rule_mirror(pair["input"]) != pair["output"]
+    ]
+
+    passed = (
+        not python_report["failures"]
+        and not racket_report["mismatches"]
+        and not canonical_failures
+    )
+    report = {
+        "schema": "arcpuzzles-1aec632783b9-repair-audit-v1",
+        "task_id": TASK_ID,
+        "status": "passed" if passed else "failed",
+        "source": {
+            "path": f"generators/{TASK_ID}/generator.py",
+            "sha256": hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
+            "version": gen.VERSION,
+        },
+        "canonical": {
+            "program_sha256": hashlib.sha256(canonical["program_solution"].encode()).hexdigest(),
+            "pairs": len(canonical_pairs),
+            "failures": canonical_failures,
+        },
+        "bounded": python_report,
+        "protected_racket": racket_report,
+        "limits": (
+            "Aligned four-pair blocks over the requested finite seeds and bands, plus sampled "
+            "protected-Racket labels; not universal induction or owner acceptance."
+        ),
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "lessons": python_report["lessons"],
+                "pairs": python_report["pairs"],
+                "distinct_inputs": python_report["distinct_inputs"],
+                "racket_evaluations": racket_report["evaluations"],
+                "failures": len(python_report["failures"]) + len(racket_report["mismatches"]) + len(canonical_failures),
+                "out": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0 if passed else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
