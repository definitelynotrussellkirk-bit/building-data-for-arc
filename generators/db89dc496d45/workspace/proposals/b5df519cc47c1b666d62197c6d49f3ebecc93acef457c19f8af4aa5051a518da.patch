+def _fallback_blob(height: int, width: int, used: set[tuple[int, int]], target: int):
+    # Keep the guaranteed fallback compact enough for the smallest advertised
+    # 7x7 canvas even at the largest advertised blob size (9).  A top arm,
+    # left arm, and short foot remain connected, nonrectangular, and
+    # rotationally asymmetric for every target in 3..9.
+    top_arm = min(4, target - 1)
+    base = [(0, col) for col in range(top_arm)]
+    remaining = target - top_arm
+    vertical = min(3, remaining)
+    base.extend((row, 0) for row in range(1, vertical + 1))
+    remaining -= vertical
+    base.extend((vertical, col) for col in range(1, remaining + 1))
+    variants = []
+    current = base
+    for _ in range(4):
+        min_row = min(row for row, _ in current)
+        min_col = min(col for _, col in current)
+        normalized = sorted((row - min_row, col - min_col) for row, col in current)
+        if normalized not in variants:
+            variants.append(normalized)
+        current = [(col, -row) for row, col in current]
+    for shape in variants:
+        shape_h = max(row for row, _ in shape) + 1
+        shape_w = max(col for _, col in shape) + 1
+        for top in range(height - shape_h + 1):
+            for left in range(width - shape_w + 1):
+                cells = {(top + row, left + col) for row, col in shape}
+                if not cells & used:
+                    return cells
+    raise ValueError("could not place a lawful asymmetric fallback template")
