        "from pathlib import Path\nimport hashlib,json\nroot=Path.cwd(); checks=root.parent/'checks/parametric'; evidence=checks/'evidence-final'\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nreport=json.loads((evidence/'verification.json').read_text())\nassert report['status']=='pass' and report['counts']['episodes']==9\nassert report['counts']['production_rival_checks']==18 and report['counts']['rotation_rival_checks']==72\nassert report['racket_runtime']['protected'] is True\nassert Path(report['racket_runtime']['binary_path'])==root.parent/'.review/racket-runtime/racket/bin/racket'\nsource=root/'generators/0b8ba9bb3c63/workspace/parametric'\ngenerator_sha=sha(root/'generators/0b8ba9bb3c63/generator.py')\nassert report['selected_generator_sha256']==generator_sha\nfor name,digest in report['source_hashes'].items():\n assert sha(source/name)==digest\nfor item in report['episodes']:\n public_path=evidence/item['public_file']; private_path=evidence/item['private_file']\n assert sha(public_path)==item['public_sha256'] and sha(private_path)==item['private_sha256']\n public=json.loads(public_path.read_text()); private=json.loads(private_path.read_text())\n assert set(public)=={'train','test'} and len(public['train'])==3 and len(public['test'])==1\n assert all(set(pair)=={'input','output'} for pair in public['train']) and set(public['test'][0])=={'input'}\n assert private['parameters']=={'beam_axes':item['beam_axes']}\n assert private['selected_generator_sha256']==generator_sha\n assert private['prototype_source_hashes']==report['source_hashes']\n assert hashlib.sha256(private['rule']['text'].encode()).hexdigest()==item['rule_sha256']\n assert private['rule']['text']==(source/private['rule']['file']).read_text()\n assert private['identifiability']['production']['status']=='pass'\n assert len(private['identifiability']['rotations'])==4\n assert all(r['status']=='pass' and all(c['refuting_demo_indices'] and c['query_differs'] for c in r['rivals']) for r in private['identifiability']['rotations'])\ninputs=report['episodes']\nfor offset in (0,3,6):\n rows=[json.loads((evidence/inputs[i]['public_file']).read_text()) for i in range(offset,offset+3)]\n assert all([p['input'] for p in row['train']+row['test']]==[p['input'] for p in rows[0]['train']+rows[0]['test']] for row in rows)\nfiles=[p for p in checks.rglob('*') if p.is_file()]\nassert len(files)<=40 and sum(p.stat().st_size for p in files)<2_000_000\nresult={'status':'pass','episode_files_verified':18,'public_projection_checks':9,'all_declared_rivals_refuted':True,'shared_inputs_across_settings':True,'racket_is_included_binary':True,'generator_sha256':generator_sha,'source_hashes':{p.name:sha(p) for p in source.iterdir() if p.is_file()},'test_sha256':sha(root/'generators/0b8ba9bb3c63/tests/test_parametric_0b8ba9bb3c63.py'),'evidence_file_count_before_audit':len(files),'evidence_bytes_before_audit':sum(p.stat().st_size for p in files),'reference_text_sha256':report['source_hashes']['both.rkt']}\n(checks/'artifact-audit.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint(json.dumps(result,indent=2))\n"
