+            first["parameters"]["transparent_color"]))
+
+    def test_boundary_scenes_are_solid_rectangles_and_keep_exact_dimensions(self):
+        random.seed(44)
+        global_state = random.getstate()
+        for height, width in ((17, 17), (17, 30), (30, 17), (30, 30)):
