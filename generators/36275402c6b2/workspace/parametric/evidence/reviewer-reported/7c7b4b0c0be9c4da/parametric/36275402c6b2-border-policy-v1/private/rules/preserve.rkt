(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((nz (filter (lambda (p) (!= (at g (first p) (second p)) 0))
                              (for*/list ((r (range 0 h)) (c (range 0 w))) (list r c))))
                  (objs (objects g 0))
                  (sorted-objs (sort-by objs (lambda (o) (- (obj-size o)))))
                  (rect-obj (first sorted-objs)))
             (with-bbox rect-obj
                        (rr1 cc1 rr2 cc2)
                        (let* ((rect-h (+ (- rr2 rr1) 1))
                               (rect-w (+ (- cc2 cc1) 1))
                               (rect (subgrid g rr1 cc1 rr2 cc2))
                               (pair-cells (filter (lambda (p)
                                                     (let ((r (first p))
                                                           (c (second p)))
                                                       (not (and
                                                              (>= r rr1)
                                                              (<= r rr2)
                                                              (>= c cc1)
                                                              (<= c cc2)))))
                                                   nz))
                               (pairs (filter (lambda (p) p)
                                              (map (lambda (pc)
                                                     (let ((r (first pc))
                                                           (c (second pc)))
                                                       (and
                                                         (member (list r (+ c 1))
                                                                 pair-cells)
                                                         (list (at g r c)
                                                               (at g r (+ c 1))))))
                                                   pair-cells)))
                               (result (build-grid rect-h
                                                   rect-w
                                                   (r c)
                                                   (let* ((v (at rect r c))
                                                          (mapping (find (lambda (p)
                                                                           (= (second p)
                                                                              v))
                                                                         pairs)))
                                                     (if (and mapping (> r 0) (< r (- rect-h 1)) (> c 0) (< c (- rect-w 1))) (first mapping) v)))))
                          result))))))