+def _validate_generate_arguments(seed, sample_index, difficulty, overrides) -> None:
+    """Reject lossy scalar coercions at the public generator boundary.
+
+    ``GenCtx`` intentionally retains legacy coercing draws for older generators.
+    This generator advertises exact integer controls, so validate its call
+    contract before those draws can turn booleans, floats, or strings into
+    apparently valid values.  ``None`` remains the shared no-override sentinel.
+    """
+    if type(seed) is not int or seed < 0:
+        raise ValueError("seed must be a non-negative literal integer")
+    if type(sample_index) is not int or sample_index < 0:
+        raise ValueError("sample_index must be a non-negative literal integer")
+    if difficulty not in _DIFFICULTIES or (
+        difficulty is not None and type(difficulty) is not str
+    ):
+        raise ValueError("difficulty must be None, 'easy', 'medium', or 'hard'")
+    for axis, value in overrides.items():
+        if value is not None and type(value) is not int:
+            raise ValueError(f"{axis} must be a literal integer")
 
 
