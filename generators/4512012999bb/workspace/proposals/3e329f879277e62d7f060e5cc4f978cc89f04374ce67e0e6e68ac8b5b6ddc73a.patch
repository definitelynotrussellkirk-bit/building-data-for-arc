+"""Bounded source-pinned positional-shortcut review, not an approval battery."""
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import time
+
+from reviewer_support import find_root, load_selected_generator
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+TASK = 'e8fb1b5bedfe'
+PIN = '994f0203ad5c12371aacf6b64c3d5e15a238b6e58e6567024934f80338e5bcb0'
+ROOT = find_root(__file__)
+
+
+def main():
+    started = time.monotonic()
+    gen, path, digest = load_selected_generator(TASK, root=ROOT)
+    assert digest == PIN
+    helper = Path(__file__).with_name('reference_probe.py')
+    spec = importlib.util.spec_from_file_location('_peer_geometry_e8fb1b5bedfe', helper)
+    geometry = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(geometry)
+    catalog = Catalog(ROOT)
+    selected = catalog.describe(TASK)
+    programs = {row['program_solution'] for row in catalog._variants()[selected.get('rule_task_id', TASK)]}
+    assert len(programs) == 1
+    canonical = programs.pop()
+    rivals = {name: (axis, reverse) for name, axis, reverse in
+              [('top_to_bottom', 0, False), ('bottom_to_top', 0, True),
+               ('left_to_right', 1, False), ('right_to_left', 1, True)]}
+
+    def predict(grid, axis, reverse):
+        frames = geometry.frame_components(grid)
+        frames.sort(key=lambda frame: frame['bbox'][axis], reverse=reverse)
+        output = deepcopy(grid)
+        geometry._fill(output, frames[0], 2)
+        geometry._fill(output, frames[-1], 8)
+        return output
+
+    found = None
+    windows = generated = 0
+    for seed in range(880000, 880400):
+        grids = [gen.generate(seed, index, difficulty='medium') for index in range(6)]
+        generated += len(grids)
+        gold = [geometry.expected_output(grid) for grid in grids]
+        for start in range(3):
+            windows += 1
+            demos = [{'input': grids[index], 'output': gold[index]} for index in range(start, start + 3)]
+            query = {'input': grids[start + 3], 'output': gold[start + 3]}
+            assert not gen.lesson_identifiable(demos, query)
+            for name, (axis, reverse) in rivals.items():
+                if (all(predict(pair['input'], axis, reverse) == pair['output'] for pair in demos)
+                        and predict(query['input'], axis, reverse) != query['output']):
+                    found = {'seed': seed, 'sample_indices': list(range(start, start + 4)),
+                             'difficulty': 'medium', 'rival': name, 'axis': axis, 'reverse': reverse,
+                             'train': demos, 'query': query}
+                    break
+            if found:
+                break
+        if found or time.monotonic() - started > 75:
+            break
+    report = {'task_id': TASK, 'generator_sha256': digest, 'rule_hash': selected['rule_hash'],
+              'canonical_program_sha256': hashlib.sha256(canonical.encode()).hexdigest(),
+              'canonical_program': canonical, 'probe_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              'geometry_helper_sha256': hashlib.sha256(helper.read_bytes()).hexdigest(),
+              'rivals': list(rivals), 'windows': windows, 'generated_coordinates': generated,
+              'seed_range': [880000, seed], 'limits': 'Four finite positional rivals, three-demo medium windows only; no universal identifiability claim.',
+              'status': 'bounded_no_finding' if found is None else 'unresolved_teaching_ambiguity'}
+    if found:
+        axis = 'first' if found['axis'] == 0 else 'second'
+        comparison = '>' if found['reverse'] else '<'
+        rival = canonical.replace('(< aa ab)', f'({comparison} ({axis} ba) ({axis} bb))')
+        assert rival != canonical
+        with _local_imports(ROOT / 'shared/runtime', Path(__file__).parent):
+            apply, identity, bridge = _real_evaluator(ROOT / 'shared/runtime')
+            try:
+                for pair in found['train'] + [found['query']]:
+                    assert _grid(apply(canonical, pair['input'])) == pair['output']
