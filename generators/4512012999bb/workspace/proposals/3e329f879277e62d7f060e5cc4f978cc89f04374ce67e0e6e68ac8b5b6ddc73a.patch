+"""Reproduce a four-demo half-turn shortcut ambiguity at pinned source bytes."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from reviewer_support import canonical_path, load_selected_generator
+
+TASK = "e685e65af79d"
+PIN = "72c9a3133fc6426cf0b32d861dd93ee08feba8acc30f21afa3546bbde55be33c"
+
+
+def main():
+    started = time.perf_counter()
+    source = ROOT / "generators" / TASK / "generator.py"
+    actual_hash = hashlib.sha256(source.read_bytes()).hexdigest()
+    if actual_hash != PIN:
+        raise AssertionError("Selected source differs from pinned audit bytes")
+    generator = load_selected_generator(TASK, root=ROOT)[0]
+    programs = {r["program_solution"] for r in map(json.loads, canonical_path(ROOT).read_text().splitlines()) if r["task_id"] == TASK}
+    if len(programs) != 1:
+        raise AssertionError("Expected unique canonical program")
+    canonical = programs.pop()
+    if canonical.count("(rot shape)") != 1:
+        raise AssertionError("Canonical rotation site changed")
+    rival = canonical.replace("(rot shape)", "(rot (rot shape))", 1)
+    report = {
+        "schema": "source-bound-peer-shortcut-witness-v1", "task_id": TASK,
+        "source_sha256": actual_hash,
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "canonical_program": canonical, "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "rival_program": rival, "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "rival_description": "Overlay only the original object and its 180-degree rotation inside its bbox.",
+        "seed": 59, "demo_sample_indices": [0, 1, 2, 3], "query_sample_index": 4,
+        "discovery_scope": "Bounded exploratory Python comparison of default episodes for seeds 0..59, five sequential sample indices each; this retained reproducer executes only seed 59.",
+        "status": "running", "train": [], "test": [], "racket_evaluations": 0,
+        "limits": "One generated episode witness, not a failure-rate estimate. No canonical label error established; no generator repair or approval change.",
+    }
+    out = ROOT.parent / "checks" / TASK / "report.json"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    if out.exists():
+        raise FileExistsError(out)
+    bridge = None
+    try:
+        with _local_imports(ROOT / "shared/runtime", source.parent):
+            apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+            report["runtime"] = identity
+            for index in range(5):
+                grid = generator.generate(59, index)
+                errors = generator.self_check(grid)
+                if errors:
+                    raise AssertionError(f"Generated scene failed self-check: {errors}")
+                expected = _grid(apply(canonical, grid))
+                report["racket_evaluations"] += 1
+                wrong = _grid(apply(rival, grid))
+                report["racket_evaluations"] += 1
+                differences = [[r, c, expected[r][c], wrong[r][c]]
+                               for r in range(len(grid)) for c in range(len(grid[0]))
+                               if expected[r][c] != wrong[r][c]]
+                pair = {"sample_index": index, "input": grid, "output": expected,
+                        "rival_output": wrong, "differing_cells": differences,
+                        "self_check": errors}
+                report["train" if index < 4 else "test"].append(pair)
+                if (index < 4 and differences) or (index == 4 and not differences):
+                    raise AssertionError("Pinned ambiguity did not reproduce in protected Racket")
+        report["status"] = "confirmed_learnability_gap"
+        report["finding"] = "Four generated demonstrations do not identify 90-degree rotational closure against a plausible 180-degree-only overlay; the next generated query distinguishes them."
+    except Exception as exc:
+        report["status"] = "failed"
+        report["error"] = {"type": type(exc).__name__, "message": str(exc)}
+        raise
+    finally:
+        if bridge is not None:
+            bridge.close()
+        report["elapsed_seconds"] = time.perf_counter() - started
+        out.write_text(json.dumps(report, sort_keys=True, separators=(",", ":")) + "\n")
+    print(json.dumps({"status": report["status"], "racket_evaluations": report["racket_evaluations"],
+                      "query_differences": report["test"][0]["differing_cells"], "report": str(out)}))
+
+
+if __name__ == "__main__":
+    main()
