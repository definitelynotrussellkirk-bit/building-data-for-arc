(rule!
 ;; Read four same-size framed panels embedded in noise. One panel is blank, two
 ;; same-palette panels form a worked transformation example, and the remaining
 ;; panel is the question. Infer the demonstrated operation (complement, straight
 ;; connector, center ripple, or corner ripple) in the direction whose source
 ;; density best matches the question, then apply it with the question palette.
 (lambda (g)
  (let ()
   (define H (rows g)) (define W (cols g))
   (define (nz-colors a) (sort (remove-duplicates (filter (lambda (x) (not (= x 0))) (flatten a))) <))
   (define (nz-count a) (count (lambda (x) (not (= x 0))) (flatten a)))
   (define (ring? r c s v)
    (and (not (= v 0))
         (for/and ((x (range c (+ c s)))) (and (= (at g r x) v) (= (at g (+ r s -1) x) v)))
         (for/and ((y (range r (+ r s)))) (and (= (at g y c) v) (= (at g y (+ c s -1)) v)))))
   (define (candidate-ring? s r c)
    (let ((v (at g r c)))
     (and (ring? r c s v)
          (let* ((a (subgrid g (+ r 1) (+ c 1) (+ r s -2) (+ c s -2)))
                 (cs (nz-colors a)))
           (and (<= (length cs) 2) (>= (count-color a 0) 4))))))
   (define rings
    (for*/list ((s (range 5 10))
                (r (range 0 (+ 1 (- H s))))
                (c (range 0 (+ 1 (- W s))))
                #:when (candidate-ring? s r c))
     (let ((a (subgrid g (+ r 1) (+ c 1) (+ r s -2) (+ c s -2))))
      (list s r c a))))
   (define sides (remove-duplicates (map first rings)))
   (define chosen-side
    (first (filter (lambda (s) (= 4 (count (lambda (x) (= (first x) s)) rings))) sides)))
   (define boxes (filter (lambda (x) (= (first x) chosen-side)) rings))
   (define panels (map fourth boxes))
   (define blank (first (filter (lambda (i) (= 0 (nz-count (list-ref panels i)))) (range 4))))
   (define nonblank (filter (lambda (i) (not (= i blank))) (range 4)))
   (define pair
    (first (for*/list ((i nonblank) (j nonblank) #:when (< i j)
                      #:when (equal? (nz-colors (list-ref panels i)) (nz-colors (list-ref panels j))))
             (list i j))))
   (define qidx (first (filter (lambda (i) (not (member i pair))) nonblank)))
   (define q (list-ref panels qidx))
   (define (complement a)
    (let ((cs (nz-colors a)))
     (and (= (length cs) 1)
          (let ((v (first cs))) (map (lambda (row) (map (lambda (x) (if (= x 0) v 0)) row)) a)))))
   (define (set-a a r c v) (set-cell a r c v))
   (define (connect-with a corner)
    (let* ((cs (nz-colors a))
           (fill (first (filter (lambda (x) (not (= x corner))) cs)))
           (n (rows a))
           (rowed
            (for/fold ((out a)) ((r (range n)))
             (let ((inds (filter (lambda (c) (not (= (at a r c) 0))) (range n))))
              (for*/fold ((z out)) ((ii (range (length inds))) (jj (range (+ ii 1) (length inds))))
               (let* ((c1 (list-ref inds ii)) (c2 (list-ref inds jj))
                      (clear? (for/and ((c (range (+ c1 1) c2))) (= (at a r c) 0))))
                (if clear? (for/fold ((u z)) ((c (range (+ c1 1) c2))) (set-cell u r c fill)) z))))))
           (colled
            (for/fold ((out rowed)) ((c (range n)))
             (let ((inds (filter (lambda (r) (not (= (at a r c) 0))) (range n))))
              (for*/fold ((z out)) ((ii (range (length inds))) (jj (range (+ ii 1) (length inds))))
               (let* ((r1 (list-ref inds ii)) (r2 (list-ref inds jj))
                      (clear? (for/and ((r (range (+ r1 1) r2))) (= (at a r c) 0))))
                (if clear? (for/fold ((u z)) ((r (range (+ r1 1) r2))) (set-cell u r c fill)) z)))))))
     colled))
   (define (center-ripple a)
    (let* ((n (rows a)) (cr (quotient n 2)) (cc (quotient n 2))
           (maxd (+ cr cc))
           (prof
            (for/list ((d (range (+ maxd 1))))
             (let ((vals (remove-duplicates
                          (for*/list ((r (range n)) (c (range n)) #:when (= (+ (abs (- r cr)) (abs (- c cc))) d))
                           (at a r c)))))
              (and (= (length vals) 1) (first vals))))))
     (and (andmap identity prof)
          (let ((k (let loop ((i 0)) (if (or (= i (length prof)) (= (list-ref prof i) 0)) i (loop (+ i 1))))))
           (and (> k 0) (andmap (lambda (x) (= x 0)) (drop prof k))
                (for/list ((r (range n)))
                 (for/list ((c (range n)))
                  (let ((d (+ (abs (- r cr)) (abs (- c cc)))))
                   (if (< d k) 0 (list-ref prof (modulo (- d k) k)))))))))))
   (define (corner-ripple a)
    (let* ((n (rows a)) (cs (nz-colors a)))
     (and (= (length cs) 2)
          (let* ((counts (map (lambda (v) (count-color a v)) cs))
                 (fill (if (< (first counts) (second counts)) (first cs) (second cs)))
                 (edge (if (= fill (first cs)) (second cs) (first cs))))
           (for/list ((r (range n)))
            (for/list ((c (range n)))
             (let ((d (apply min (list (+ r c) (+ r (- n 1 c)) (+ (- n 1 r) c) (+ (- n 1 r) (- n 1 c))))))
              (cond ((= d 0) 0) ((= d 1) edge) (else fill)))))))))
   (define (applications a)
    (append
     (let ((x (complement a))) (if x (list (list 'complement #f x)) '()))
     (if (= (length (nz-colors a)) 2)
      (map (lambda (corner) (list 'connect corner (connect-with a corner))) (nz-colors a)) '())
     (let ((x (center-ripple a))) (if x (list (list 'center-ripple #f x)) '()))
     (let ((x (corner-ripple a))) (if x (list (list 'corner-ripple #f x)) '()))))
   (define candidates
    (apply append
     (for/list ((dir (list pair (reverse pair))))
      (let* ((si (first dir)) (ti (second dir)) (src (list-ref panels si)) (tgt (list-ref panels ti)))
       (filter-map
        (lambda (rec) (and (equal? (third rec) tgt)
                           (list (abs (- (nz-count src) (nz-count q))) (first rec) (second rec))))
        (applications src))))))
   (define best (first (sort candidates (lambda (a b) (< (first a) (first b))))))
   (define op (second best))
   (cond
    ((eq? op 'complement) (complement q))
    ((eq? op 'connect)
     (let* ((cs (nz-colors q))
            (corner (first (sort cs (lambda (a b) (< (count-color q a) (count-color q b)))))))
      (connect-with q corner)))
    ((eq? op 'center-ripple) (center-ripple q))
    (else (corner-ripple q))))))
