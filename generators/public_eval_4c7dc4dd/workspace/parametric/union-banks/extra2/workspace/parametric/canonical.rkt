(rule!
 ;; Find the four largest congruent square panel frames, use the surrounding
 ;; monochrome rectangles to pair them, infer the demonstrated panel operation,
 ;; and apply it to the panel paired with the unique empty slot.
 (lambda (g)
  (let ()
    (define result-view "transformed")
    (define gh (rows g))
    (define gw (cols g))
    (define (square-frame? r c side)
      (define color (at g r c))
      (and (not (= color 0))
           (for/and ((x (range c (+ c side))))
             (and (= (at g r x) color)
                  (= (at g (+ r side -1) x) color)))
           (for/and ((x (range r (+ r side))))
             (and (= (at g x c) color)
                  (= (at g x (+ c side -1)) color)))))
    ;; Frame records are (row col side color interior-grid).
    (define (frames-at side)
      (for*/list ((r (range 0 (+ 1 (- gh side))))
                  (c (range 0 (+ 1 (- gw side))))
                  #:when (square-frame? r c side))
        (list r c side (at g r c)
              (subgrid g (+ r 1) (+ c 1) (+ r side -2) (+ c side -2)))))
    (define side
      (apply max
        (filter (lambda (s) (>= (length (frames-at s)) 4))
                (range 4 (+ 1 (min 10 gh gw))))))
    (define frames (frames-at side))
    (define (fr-r f) (first f))
    (define (fr-c f) (second f))
    (define (fr-side f) (third f))
    (define (fr-color f) (fourth f))
    (define (fr-grid f) (fifth f))
    (define (fr-r2 f) (+ (fr-r f) (fr-side f) -1))
    (define (fr-c2 f) (+ (fr-c f) (fr-side f) -1))
    (define (inside? f r0 c0 r1 c1)
      (and (< r0 (fr-r f)) (< c0 (fr-c f))
           (< (fr-r2 f) r1) (< (fr-c2 f) c1)))
    (define (border-color r0 c0 r1 c1)
      (define color (at g r0 c0))
      (and (not (= color 0))
           (= (at g r0 c1) color) (= (at g r1 c0) color) (= (at g r1 c1) color)
           (for/and ((c (range c0 (+ c1 1))))
             (and (= (at g r0 c) color) (= (at g r1 c) color)))
           (for/and ((r (range r0 (+ r1 1))))
             (and (= (at g r c0) color) (= (at g r c1) color)))
           color))
    ;; Return (r0 c0 r1 c1 color) for a complete enclosing rectangle that
    ;; contains exactly the selected two panel frames.
    (define (enclosing a b)
      (define top (min (fr-r a) (fr-r b)))
      (define bottom (max (fr-r2 a) (fr-r2 b)))
      (define left (min (fr-c a) (fr-c b)))
      (define right (max (fr-c2 a) (fr-c2 b)))
      (for*/first ((r0 (range 0 top))
                   (r1 (range (+ bottom 1) gh))
                   (c0 (range 0 left))
                   (c1 (range (+ right 1) gw))
                   #:when
                   (let ((color (border-color r0 c0 r1 c1)))
                     (and color
                          (= 2 (length (filter (lambda (f) (inside? f r0 c0 r1 c1)) frames))))))
        (list r0 c0 r1 c1 (border-color r0 c0 r1 c1))))
    (define (all-zero? panel)
      (for*/and ((r (range (rows panel))) (c (range (cols panel))))
        (= (at panel r c) 0)))
    (define empty-frame (first (filter (lambda (f) (all-zero? (fr-grid f))) frames)))
    (define paired
      (filter (lambda (f) (and (not (equal? f empty-frame)) (enclosing empty-frame f))) frames))
    (define query-frame (first paired))
    (define query-outer (enclosing empty-frame query-frame))
    (define query-color (fifth query-outer))
    (define demo-frames
      (filter (lambda (f) (and (not (equal? f empty-frame))
                               (not (equal? f query-frame)))) frames))
    (define demo-outer (enclosing (first demo-frames) (second demo-frames)))
    (define demo-color (fifth demo-outer))
    (define demo-a (fr-grid (first demo-frames)))
    (define demo-b (fr-grid (second demo-frames)))
    (define query (fr-grid query-frame))
    (define slot-color (fr-color empty-frame))
    (define (nonzero-count panel)
      (for*/sum ((r (range (rows panel))) (c (range (cols panel))))
        (if (= (at panel r c) 0) 0 1)))
    (define (parity-color panel parity fallback)
      (define values
        (for*/list ((r (range (rows panel))) (c (range (cols panel)))
                    #:when (and (not (= (at panel r c) 0))
                                (= (modulo (+ r c) 2) parity)))
          (at panel r c)))
      (if (null? values) fallback
          (let ((colors (sort (remove-duplicates values) <)))
            (pick-max colors
              (lambda (color) (count-if (lambda (v) (= v color)) values))))))
    (define (complement panel role)
      (define p0 (parity-color panel 0 role))
      (define p1 (parity-color panel 1 role))
      (build-grid (rows panel) (cols panel) (r c)
        (if (= (at panel r c) 0)
            (if (= (modulo (+ r c) 2) 0) p0 p1)
            0)))
    (define (connected panel role)
      (build-grid (rows panel) (cols panel) (r c)
        (define old (at panel r c))
        (define row-marks
          (for/list ((x (range (cols panel))) #:when (not (= (at panel r x) 0))) x))
        (define col-marks
          (for/list ((x (range (rows panel))) #:when (not (= (at panel x c) 0))) x))
        (if (not (= old 0)) old
            (if (or (and (>= (length row-marks) 2)
                         (<= (apply min row-marks) c (apply max row-marks)))
                    (and (>= (length col-marks) 2)
                         (<= (apply min col-marks) r (apply max col-marks))))
                role 0))))
    ;; Seed record is (bottom? right? corner adjacent-row adjacent-col fill).
    (define (corner-seed panel)
      (define h (rows panel))
      (define w (cols panel))
      (define nz
        (for*/list ((r (range h)) (c (range w)) #:when (not (= (at panel r c) 0)))
          (list r c)))
      (for*/first ((bottom (list #f #t)) (right (list #f #t))
                   #:when
                   (let* ((cell (lambda (dr dc)
                                  (at panel (if bottom (- h 1 dr) dr)
                                            (if right (- w 1 dc) dc))))
                          (v00 (cell 0 0)) (v01 (cell 0 1))
                          (v10 (cell 1 0)) (v11 (cell 1 1)))
                     (and (= (length nz) 3)
                          (for/and ((p nz))
                            (and (< (if bottom (- h 1 (first p)) (first p)) 2)
                                 (< (if right (- w 1 (second p)) (second p)) 2)))
                          (= v00 0) (not (= v01 0)) (= v01 v10) (not (= v11 0)))))
        (let ((cell (lambda (dr dc)
                      (at panel (if bottom (- h 1 dr) dr)
                                (if right (- w 1 dc) dc)))))
          (list bottom right (cell 0 0) (cell 0 1) (cell 1 0) (cell 1 1)))))
    (define (corner-expanded panel)
      (define seed (corner-seed panel))
      (and seed
        (build-grid (rows panel) (cols panel) (r c)
          (define dr (min r (- (rows panel) 1 r)))
          (define dc (min c (- (cols panel) 1 c)))
          (cond ((and (= dr 0) (= dc 0)) (third seed))
                ((and (= dr 0) (= dc 1)) (fourth seed))
                ((and (= dr 1) (= dc 0)) (fifth seed))
                (else (sixth seed))))))
    (define sparse (if (< (nonzero-count demo-a) (nonzero-count demo-b)) demo-a demo-b))
    (define dense (if (equal? sparse demo-a) demo-b demo-a))
    (define is-complement
      (or (equal? (complement demo-a demo-color) demo-b)
          (equal? (complement demo-b demo-color) demo-a)))
    (define is-connect (equal? (connected sparse demo-color) dense))
    (define expanded-demo (corner-expanded sparse))
    (define is-corner (and expanded-demo (equal? expanded-demo dense)))
    (define operation
      (cond (is-complement 'complement)
            (is-connect 'connect)
            (is-corner 'corner-expand)
            (else (error 'transfer "unidentified demonstrated operation"))))
    ;; Step A: produce the entire transformed query. Step B may consume it.
    (define transformed
      (cond ((equal? operation 'complement) (complement query query-color))
            ((equal? operation 'connect) (connected query query-color))
            (else (corner-expanded query))))
    (if (equal? result-view "transformed")
        transformed
        (build-grid (rows transformed) (cols transformed) (r c)
          (if (= (at transformed r c) (at query r c)) 0 slot-color))))))
