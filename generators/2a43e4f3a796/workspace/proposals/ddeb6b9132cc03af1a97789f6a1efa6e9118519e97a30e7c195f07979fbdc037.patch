+"""Find and replay one bounded default-lesson frame-count shortcut.
+
+Run through review.py with --out ../checks/43a7d8f7ab6c/frame-cap.
+Only seeds 0..7 and caps one/two are inspected. Source and approval are unchanged.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from arcpuzzles.runtime import generate
+
+
+TASK = "43a7d8f7ab6c"
+
+
+def digest(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    root, output = Path.cwd().resolve(), args.out.resolve()
+    if output.exists():
+        raise ValueError("Choose a fresh output directory")
+    catalog = Catalog(root)
+    selected = catalog.get(TASK)
+    sources = {v["program_solution"] for v in selected["variants"]}
+    if len(sources) != 1:
+        raise ValueError("Exact selected authority must be unique")
+    canonical = next(iter(sources))
+    source = root / selected["generator"]
+    runtime = root / "shared/runtime"
+    discovery, found = [], None
+    with _local_imports(runtime, source.parent):
+        spec = importlib.util.spec_from_file_location("frame_peer_review", source)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        for seed in range(8):
+            grids = [module.generate(seed, index) for index in range(4)]
+            checks = [module.self_check(grid) for grid in grids]
