+"""Bounded color-blind positional rival; reference labels use protected Racket.
+
+Run from the outer review packet:
+WORK/.venv/bin/python review.py run ../.venv/bin/python \
+  generators/419ed66194f2/workspace/learnability_probe.py \
+  --out ../checks/419ed66194f2/learnability-witness.json
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve()
+ROOT = next(p for p in HERE.parents if (p / "shared/runtime/reviewer_support.py").is_file())
+sys.path[:0] = [str(ROOT / "shared/runtime"), str(ROOT / "src")]
+from reviewer_support import canonical_path, load_selected_generator
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+TASK = "419ed66194f2"
+EXPECTED_SOURCE_SHA256 = "15eba3d46c6b9cc618fb1d229cc6581dfe2a4d373cfe93a00da8c47ea42304b9"
+RIVAL = """(rule!
+ (let* ((all (objects g 0))
+        (anchors (sort (filter (lambda (o) (= (obj-size o) 1)) all)
+                       (lambda (a b) (< (obj-c1 a) (obj-c1 b)))))
+        (sources (sort (filter (lambda (o) (> (obj-size o) 1)) all)
+                       (lambda (a b) (< (obj-c1 a) (obj-c1 b))))))
+   (for/fold ((out (empty-grid (rows g) (cols g) 0)))
+             ((anchor (in-list anchors)) (obj (in-list sources)))
+     (for/fold ((acc out)) ((p (in-list (obj-cells obj))))
+       (let ((rr (+ (obj-r1 anchor) (- (first p) (obj-r1 obj))))
+             (cc (+ (obj-c1 anchor) (- (second p) (obj-c1 obj)))))
+         (if (in-bounds? rr cc (rows g) (cols g))
+             (set-cell acc rr cc (obj-color obj)) acc))))))
+"""
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def python_rival(module, grid):
+    facts = module._analysis(grid)
+    assert not facts["errors"], facts["errors"]
+    anchors = sorted((v["anchor"] for v in facts["colors"].values()), key=lambda p: p[1])
+    sources = sorted(facts["colors"].items(), key=lambda item: item[1]["source_bbox"][1])
+    out = [[0] * len(grid[0]) for _ in grid]
+    for anchor, (color, obj) in zip(anchors, sources):
+        r0, c0 = obj["source_bbox"]
+        for r, c in obj["source"]:
+            rr, cc = anchor[0] + r - r0, anchor[1] + c - c0
+            if 0 <= rr < len(grid) and 0 <= cc < len(grid[0]):
+                out[rr][cc] = color
+    return out
+
+
+def authored_query():
+    # Two legal three-cell components, with the color anchors in reverse order.
+    # This is deliberately authored, not a reported default generator draw.
+    grid = [[0] * 10 for _ in range(8)]
+    grid[0][1], grid[0][6] = 6, 2
+    for r, c in ((5, 1), (5, 2), (6, 1)):
+        grid[r][c] = 2
+    for r, c in ((5, 6), (6, 6), (6, 7)):
+        grid[r][c] = 6
+    return grid
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    module, source, source_hash = load_selected_generator(TASK, root=ROOT)
+    assert source_hash == EXPECTED_SOURCE_SHA256, "Source changed; this finding needs review"
+    source = Path(source)
+    rows = [json.loads(line) for line in canonical_path(ROOT).read_text().splitlines() if line.strip()]
+    programs = {row["program_solution"] for row in rows if row["task_id"] == TASK}
+    assert len(programs) == 1
+    canonical = programs.pop()
+    screening = []
+    retained = None
+    first_ambiguous = None
+    for seed in range(8):
+        grids = [module.generate(seed, index) for index in range(4)]
+        errors = [module.self_check(g) for g in grids]
+        assert errors == [[], [], [], []], errors
+        mask = [python_rival(module, g) == module.rule_mirror(g) for g in grids]
+        screening.append({"seed": seed, "sample_indices": [0, 1, 2, 3], "rival_matches_python_mirror": mask,
+                          "layout_profiles": [module.observe_overrides(g)["layout_profile"] for g in grids]})
+        if all(mask[:3]) and first_ambiguous is None:
+            first_ambiguous = (seed, deepcopy(grids[:3]))
+        if all(mask[:3]) and not mask[3]:
+            retained = (seed, grids, "generated_default_three_demo_one_query")
+            break
+    if retained is None and first_ambiguous is not None:
+        seed, demos = first_ambiguous
+        retained = (seed, demos + [authored_query()], "generated_demos_with_authored_validator_lawful_query")
+    assert retained is not None, "No retained case within this finite budget"
+    seed, grids, kind = retained
+    errors = [module.self_check(g) for g in grids]
+    assert errors == [[], [], [], []], errors
+    with _local_imports(ROOT / "shared/runtime", HERE.parent):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            canonical_outputs = [_grid(apply(canonical, deepcopy(g))) for g in grids]
+            rival_outputs = [_grid(apply(RIVAL, deepcopy(g))) for g in grids]
+        finally:
+            bridge.close()
+    assert canonical_outputs == [module.rule_mirror(g) for g in grids]
+    assert rival_outputs == [python_rival(module, g) for g in grids]
+    assert canonical_outputs[:3] == rival_outputs[:3]
+    assert canonical_outputs[3] != rival_outputs[3]
+    differences = [{"row": r, "column": c, "reference": a, "rival": rival_outputs[3][r][c]}
+                   for r, row in enumerate(canonical_outputs[3]) for c, a in enumerate(row)
+                   if a != rival_outputs[3][r][c]]
+    assert sha(source.read_bytes()) == source_hash
+    evidence = {
+        "schema": "arc-bounded-learnability-witness-v1", "task_id": TASK,
+        "status": "proposed_teaching_gap_with_authored_query; no approval change",
+        "source_path": source.relative_to(ROOT).as_posix(), "source_sha256": source_hash,
+        "probe_path": HERE.relative_to(ROOT).as_posix(), "probe_sha256": sha(HERE.read_bytes()),
+        "rule_hash": module.RULE_HASH, "canonical_program_sha256": sha(canonical.encode()),
+        "rival_program_sha256": sha(RIVAL.encode()),
+        "command": "WORK/.venv/bin/python review.py run ../.venv/bin/python generators/419ed66194f2/workspace/learnability_probe.py --out ../checks/419ed66194f2/learnability-witness.json",
+        "programs": {"canonical": canonical, "rival": RIVAL}, "runtime": identity,
+        "candidate": "Sort sources and singleton anchors independently by left column, pair by position, and preserve source color while stamping.",
+        "bounded_screening": {"backend": "Python screening only; retained outputs independently checked in protected Racket",
+                              "seeds": screening, "generated_inputs": 4 * len(screening),
+                              "generated_default_counterexample_found": kind == "generated_default_three_demo_one_query"},
+        "retained_case": {"kind": kind, "demo_seed": seed, "demo_sample_indices": [0, 1, 2],
+                          "query_origin": "authored 8x10 reversed-anchor scene" if "authored" in kind else "sample_index=3",
+                          "self_check_errors": errors, "demo_rival_fit": [True, True, True],
+                          "query_difference_cells": differences,
+                          "pairs": [{"role": "demo" if i < 3 else "query", "input": g,
+                                     "reference_output": canonical_outputs[i], "rival_output": rival_outputs[i]}
+                                    for i, g in enumerate(grids)]},
+        "native_racket_calls": 8,
+        "scope": "One fixed positional rival; seeds 0..7 only. No generated default witness in that finite sample. The retained authored query demonstrates missing color-matching evidence in seed 2's three demos, not a default failure rate or a production-rule error.",
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(evidence, indent=2) + "\n")
+    print(json.dumps({"out": str(args.out), "kind": kind, "demo_seed": seed,
+                      "generated_screened": 4 * len(screening), "racket_calls": 8,
+                      "query_differences": len(differences), "self_check_errors": errors}))
+
+
+if __name__ == "__main__":
+    main()
