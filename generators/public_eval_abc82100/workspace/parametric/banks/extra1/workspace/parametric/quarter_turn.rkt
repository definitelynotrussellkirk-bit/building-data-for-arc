(rule!
  (define rotate-stencil #t)
  (define cyan-components
    (map obj-cells (filter (lambda (o) (= (obj-color o) 8)) (objects-8 g 0))))
  (define directions (list (list -1 0) (list 0 -1) (list 0 1) (list 1 0)))
  (define (add p d) (list (+ (first p) (first d)) (+ (second p) (second d))))
  (define (pixel p) (safe-at g (first p) (second p) 0))
  (define (inside p) (in-bounds? (first p) (second p) h w))
  (define (first-occupied p d)
    (cond ((not (inside p)) #f)
          ((not (= (pixel p) 0)) p)
          (else (first-occupied (add p d) d))))
  (define tails
    (for*/fold ((acc '())) ((p (grid-positions g)) (d directions))
      (define q (add p d))
      (define a (add q d))
      (define source (pixel p))
      (define target (pixel q))
      (define hit (if (and (> source 0) (not (= source 8))
                          (> target 0) (not (= target 8)) (not (= source target)))
                      (first-occupied a d) #f))
      (define component (if (and hit (= (pixel hit) 8))
        (find-first (lambda (i) (member hit (list-ref cyan-components i)))
                    (range (length cyan-components))) #f))
      (if component (append acc (list (list source target p q a d component))) acc)))
  (define (forward? p t)
    (define a (list-ref t 4))
    (define d (list-ref t 5))
    (>= (+ (* (- (first p) (first a)) (first d))
           (* (- (second p) (second a)) (second d))) 0))
  (define (distance-score p t)
    (define a (list-ref t 4))
    (define d (list-ref t 5))
    (define rr (- (first p) (first a)))
    (define cc (- (second p) (second a)))
    (+ (* 10000 (abs (- (* rr (second d)) (* cc (first d)))))
       (+ (abs rr) (abs cc))))
  (define (owns? p t)
    (define eligible (filter (lambda (other)
      (and (= (list-ref other 6) (list-ref t 6)) (forward? p other))) tails))
    (and (not (null? eligible))
         (equal? t (pick-min eligible (lambda (other) (distance-score p other))))))
  (define templates
    (filter (lambda (t) (not (null? (list-ref t 7))))
      (for/list ((t tails))
        (define a (list-ref t 4))
        (define offsets
          (for/list ((p (list-ref cyan-components (list-ref t 6))) #:when (owns? p t))
            (list (- (first p) (first a)) (- (second p) (second a)))))
        (append t (list offsets)))))
  (define marker-cells (append-map (lambda (t) (list (list-ref t 2) (list-ref t 3))) templates))
  (define source-colors (map first templates))
  (define blanked
    (grid-from-fn h w (lambda (r c)
      (define v (at g r c))
      (if (or (= v 8) (member (list r c) marker-cells) (member v source-colors)) 0 v))))
  (for/fold ((out blanked)) ((t templates))
    (define offsets (list-ref t 7))
    (define oriented-offsets
      (if rotate-stencil
          (map (lambda (p) (list (second p) (- (first p)))) offsets)
          offsets))
    (define seeds (filter (lambda (p) (not (member p marker-cells))) (find-color g (first t))))
    (for/fold ((painted out)) ((p seeds))
      (recolor-cells painted (map (lambda (delta) (add p delta)) oriented-offsets) (second t)))))
