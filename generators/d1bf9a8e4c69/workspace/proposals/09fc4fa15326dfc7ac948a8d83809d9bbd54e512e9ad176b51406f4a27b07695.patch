+"""Source-bound ambiguity probe for the d1559d680a5f motif-stamping task.
+
+Every visible canonical motif is invariant under an up/down reflection.  That
+makes three wrong transforms observationally identical to the intended ones:
+transpose for clockwise rotation, 180-degree rotation for left/right reflection,
+and anti-diagonal reflection for counter-clockwise rotation.  This probe retains
+an asymmetric lawful query that separates the rules under protected Racket.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import re
+
+TASK_ID = "d1559d680a5f"
+HERE = Path(__file__).resolve().parent
+ROOT = next(
+    candidate
+    for candidate in HERE.parents
+    if (candidate / "shared" / "data" / "canonical" / "puzzles.jsonl").is_file()
+)
+CANONICAL_PATH = ROOT / "shared" / "data" / "canonical" / "puzzles.jsonl"
+GENERATOR_PATH = ROOT / "generators" / TASK_ID / "generator.py"
+
+Cell = tuple[int, int]
+Grid = list[list[int]]
+
+
+def canonical_row() -> dict:
+    for line in CANONICAL_PATH.read_text(encoding="utf-8").splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            return row
+    raise ValueError(f"missing canonical row {TASK_ID}")
+
+
+def _motif(grid: Grid) -> tuple[set[Cell], int, int, int]:
+    cells = [(row, col, value) for row, values in enumerate(grid) for col, value in enumerate(values) if value]
+    if not cells:
+        raise ValueError("motif input must contain nonzero cells")
+    colors = {value for _row, _col, value in cells}
+    if len(colors) != 1:
+        raise ValueError("motif input must use one nonzero color")
+    r0 = min(row for row, _col, _value in cells)
+    c0 = min(col for _row, col, _value in cells)
+    norm = {(row - r0, col - c0) for row, col, _value in cells}
+    height = max(row for row, _col in norm) + 1
+    width = max(col for _row, col in norm) + 1
+    return norm, height, width, next(iter(colors))
+
+
+def is_vertically_symmetric(grid: Grid) -> bool:
+    norm, height, _width, _color = _motif(grid)
+    return norm == {(height - 1 - row, col) for row, col in norm}
+
+
+def _stamp(output: Grid, cells: set[Cell], top: int, left: int, color: int) -> None:
+    for row, col in cells:
+        output[top + row][left + col] = color
+
+
+def _render(grid: Grid, *, shortcut: bool) -> Grid:
+    norm, height, width, color = _motif(grid)
+    size = 2 * width + height
+    output = [[0] * size for _ in range(size)]
+    if shortcut:
+        top = {(col, row) for row, col in norm}
+        right = {(height - 1 - row, width - 1 - col) for row, col in norm}
+        bottom = {(width - 1 - col, height - 1 - row) for row, col in norm}
+    else:
+        top = {(col, height - 1 - row) for row, col in norm}
+        right = {(row, width - 1 - col) for row, col in norm}
+        bottom = {(width - 1 - col, row) for row, col in norm}
+    _stamp(output, top, 0, width, color)
+    _stamp(output, norm, width, 0, color)
+    _stamp(output, right, width, width + height, color)
+    _stamp(output, bottom, width + height, width, color)
+    return output
+
+
+def canonical_mirror(grid: Grid) -> Grid:
+    return _render(grid, shortcut=False)
+
+
+def symmetry_shortcut_mirror(grid: Grid) -> Grid:
+    return _render(grid, shortcut=True)
+
+
+def asymmetric_query_input() -> Grid:
+    grid = [[0] * 7 for _ in range(7)]
+    for row, col in ((0, 0), (1, 0), (2, 0), (2, 1), (2, 2)):
+        grid[2 + row][2 + col] = 6
+    return grid
+
+
+def shortcut_program(canonical: str | None = None) -> str:
+    source = canonical_row()["program_solution"] if canonical is None else canonical
+    substitutions = (
+        (
+            r"\(cw \(map \(lambda \(p\) \(list \(snd p\) \(- bh 1 \(fst p\)\)\)\) norm\)\)",
+            "(cw (map (lambda (p) (list (snd p) (fst p))) norm))",
+        ),
+        (
+            r"\(ccw \(map \(lambda \(p\) \(list \(- bw 1 \(snd p\)\) \(fst p\)\)\) norm\)\)",
+            "(ccw (map (lambda (p) (list (- bw 1 (snd p)) (- bh 1 (fst p)))) norm))",
+        ),
+        (
+            r"\(flr \(map \(lambda \(p\) \(list \(fst p\) \(- bw 1 \(snd p\)\)\)\) norm\)\)",
+            "(flr (map (lambda (p) (list (- bh 1 (fst p)) (- bw 1 (snd p)))) norm))",
+        ),
+    )
+    for pattern, replacement in substitutions:
+        source, count = re.subn(pattern, replacement, source, count=1)
+        if count != 1:
+            raise ValueError(f"canonical transform binding no longer matches: {pattern}")
+    return source
+
+
+def _changed(left: Grid, right: Grid) -> int:
+    return sum(
+        a != b
+        for left_row, right_row in zip(left, right, strict=True)
+        for a, b in zip(left_row, right_row, strict=True)
+    )
+
+
+def run_probe() -> dict:
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    row = canonical_row()
+    canonical = row["program_solution"]
+    shortcut = shortcut_program(canonical)
+    pairs = row["train"] + row["test"]
+    query = asymmetric_query_input()
+
+    def literal(grid):
+        return "'(" + " ".join("(" + " ".join(map(str, values)) + ")" for values in grid) + ")"
+
+    with RacketBridge(max_calls_before_restart=32) as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires protected Racket")
+        wrapped = {"canonical": wrap_rule(canonical), "shortcut": wrap_rule(shortcut)}
+
+        def apply(name, grid):
+            return bridge.eval_text(f"({wrapped[name]} {literal(grid)})")
+
+        canonical_rows = []
+        for split in ("train", "test"):
+            for index, pair in enumerate(row[split]):
+                intended = apply("canonical", pair["input"])
+                rival = apply("shortcut", pair["input"])
+                if intended != pair["output"]:
+                    raise AssertionError(f"canonical Racket mismatch on {split}[{index}]")
+                if rival != pair["output"]:
+                    raise AssertionError(f"shortcut does not fit {split}[{index}]")
+                canonical_rows.append({
+                    "split": split,
+                    "index": index,
+                    "vertical_symmetry": is_vertically_symmetric(pair["input"]),
+                    "shortcut_fits": True,
+                })
+        intended = apply("canonical", query)
+        rival = apply("shortcut", query)
+        if intended != canonical_mirror(query) or rival != symmetry_shortcut_mirror(query):
+            raise AssertionError("Racket/Python parity failed on asymmetric query")
+        if intended == rival:
+            raise AssertionError("asymmetric query failed to separate shortcut")
+
+    return {
+        "schema": "arcpuzzles-d1559d680a5f-symmetry-shortcut-v1",
+        "task_id": TASK_ID,
+        "status": "retained_finding",
+        "generator_sha256": hashlib.sha256(GENERATOR_PATH.read_bytes()).hexdigest(),
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "shortcut_program_sha256": hashlib.sha256(shortcut.encode()).hexdigest(),
+        "finding": (
+            "All four visible demonstrations and the canonical query use motifs invariant under "
+            "top-bottom reflection. A rule using transpose, 180-degree rotation, and anti-diagonal "
+            "reflection in place of the intended clockwise, left-right, and counter-clockwise "
+            "transforms therefore fits every visible pair."
+        ),
+        "canonical_pairs": canonical_rows,
+        "canonical_pair_count": len(canonical_rows),
+        "shortcut_program": shortcut,
+        "counterexample": {
+            "input": query,
+            "canonical_output": intended,
+            "shortcut_output": rival,
+            "changed_cells": _changed(intended, rival),
+            "vertical_symmetry": False,
+        },
+        "repair_recommendation": (
+            "Add at least one vertically asymmetric demonstration to every lesson and retain this "
+            "shortcut as an executable semantic rival; the existing L motif is already a compact refuter."
+        ),
+        "racket": identity,
+        "racket_evaluations": 2 * (len(canonical_rows) + 1),
+        "scope": "Bounded source-bound ambiguity witness; no production source was changed or approved.",
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args(argv)
+    report = run_probe()
+    output = Path(args.out)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"],
+        "canonical_pair_count": report["canonical_pair_count"],
+        "changed_cells": report["counterexample"]["changed_cells"],
+        "racket_evaluations": report["racket_evaluations"],
+        "out": str(output),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
