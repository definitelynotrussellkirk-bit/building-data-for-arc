+"""Regression contract for the d1559d680a5f canonical-symmetry shortcut probe."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+
+_SOURCE = Path(__file__).resolve()
+_RUNTIME = next(
+    candidate / "shared" / "runtime"
+    for candidate in _SOURCE.parents
+    if (candidate / "shared" / "runtime" / "reviewer_support.py").is_file()
+)
+sys.path.insert(0, str(_RUNTIME))
+from reviewer_support import find_root  # noqa: E402
+
+ROOT = find_root(__file__)
+PROBE_PATH = ROOT / "generators" / "d1559d680a5f" / "workspace" / "symmetry_shortcut_probe.py"
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("_d155_symmetry_probe_test", PROBE_PATH)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_visible_canonical_pairs_admit_vertical_symmetry_shortcut_but_asymmetric_query_refutes_it():
+    assert PROBE_PATH.is_file()
+    probe = _load_probe()
+    row = probe.canonical_row()
+    pairs = row["train"] + row["test"]
+    assert len(row["train"]) == 4
+    assert len(row["test"]) == 1
+    assert all(probe.is_vertically_symmetric(pair["input"]) for pair in pairs)
+    assert all(probe.canonical_mirror(pair["input"]) == pair["output"] for pair in pairs)
+    assert all(probe.symmetry_shortcut_mirror(pair["input"]) == pair["output"] for pair in pairs)
+
+    query = probe.asymmetric_query_input()
+    assert not probe.is_vertically_symmetric(query)
+    assert probe.canonical_mirror(query) != probe.symmetry_shortcut_mirror(query)
