+        (
+            Box(1, 2, 4, 5, "br", "irregular"),
+            Box(8, 9, 5, 5, "br", "dense"),
+            Box(15, 10, 4, 4, "tr", "zigzag"),
+        ),
+        repeated_pair=(0, 2),
+    ),
+)
