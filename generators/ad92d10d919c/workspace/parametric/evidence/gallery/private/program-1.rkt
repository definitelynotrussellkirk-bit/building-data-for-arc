(rule! (let ((dummy 0))
  (for*/fold ((out g)) ((r (in-range 1 (- (rows g) 1)))
                         (c (in-range 1 (- (cols g) 1))))
    (let* ((a (at g (- r 1) (- c 1)))
           (b (at g (- r 1) (+ c 1)))
           (d (at g (+ r 1) (- c 1)))
           (e (at g (+ r 1) (+ c 1)))
           (v (cond
                ((and (not (= a 0))
                      (or (and (= b a) (= d a))
                          (and (= b a) (= e a))
                          (and (= d a) (= e a)))) a)
                ((and (not (= b 0)) (= d b) (= e b)) b)
                (else 0))))
      (if (and (= (at g r c) 0) (not (= v 0)))
          (set-cell out r c v)
          out)))))