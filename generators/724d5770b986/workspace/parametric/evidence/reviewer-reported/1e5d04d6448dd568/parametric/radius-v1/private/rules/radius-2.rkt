(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((ones (for*/list ((r (range 0 h)) (c (range 0 w)) #:when (= (at g r c) 1))
                          (list r c))))
             (for/fold ((out g))
               ((p ones))
               (let ((pr (first p))
                     (pc (second p)))
                 (for*/fold ((gg out))
                            ((dr (in-list ' (-2 -1 0 1 2))) (dc (in-list ' (-2 -1 0 1 2))))
                            (let ((r (+ pr dr))
                                  (c (+ pc dc)))
                              (cond
                                ((or (< r 0) (>= r h) (< c 0) (>= c w)) gg)
                                ((zero? (at g r c)) (set-cell gg r c 1))
                                (else gg))))))))))