(rule! (lambda (g)
  (let* ((original-blue
          (filter (lambda (obj) (= (obj-color obj) 1)) (objects g 0)))
         (largest-before (pick-max original-blue obj-size))
         (expanded ((lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((ones (for*/list ((r (range 0 h)) (c (range 0 w)) #:when (= (at g r c) 1))
                          (list r c))))
             (for/fold ((out g))
               ((p ones))
               (let ((pr (first p))
                     (pc (second p)))
                 (for*/fold ((gg out))
                            ((dr (in-list ' (-1 0 1))) (dc (in-list ' (-1 0 1))))
                            (let ((r (+ pr dr))
                                  (c (+ pc dc)))
                              (cond
                                ((or (< r 0) (>= r h) (< c 0) (>= c w)) gg)
                                ((zero? (at g r c)) (set-cell gg r c 1))
                                (else gg))))))))) g)))
    (paint-cells expanded (obj-cells largest-before) 8))))
