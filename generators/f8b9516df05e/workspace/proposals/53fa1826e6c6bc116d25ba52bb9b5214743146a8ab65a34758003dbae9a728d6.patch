+"""Independent probes for task f8b9516df05e.
+
+This module deliberately does not import the production generator.  It gives
+reviewers a small Python oracle for the preserved Racket behavior and structural
+measurements used by the task-local regression suite.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Iterable
+
+EMITTER_COLORS = frozenset({1, 2, 3, 4, 5, 6, 7, 9})
+
+
+def first_emitter_and_blockers(row: Iterable[int]):
+    values = list(row)
+    emitter = next(
+        ((index, value) for index, value in enumerate(values) if value in EMITTER_COLORS),
+        None,
+    )
+    if emitter is None:
+        return None, []
+    blocker_columns = [
+        index for index in range(emitter[0] + 1, len(values)) if values[index] == 8
+    ]
+    return emitter, blocker_columns
+
+
+def reference_output(grid: list[list[int]]) -> list[list[int]]:
+    """Mirror the selected rule: fill to the first rightward color-8 blocker."""
+    output = deepcopy(grid)
+    for row_index, row in enumerate(grid):
+        emitter, blockers = first_emitter_and_blockers(row)
+        if emitter is None or not blockers:
+            continue
+        emitter_column, color = emitter
+        first_blocker = blockers[0]
+        for column in range(emitter_column + 1, first_blocker):
+            output[row_index][column] = color
+    return output
+
+
+def active_rows(grid: list[list[int]]) -> list[int]:
+    rows = []
+    for row_index, row in enumerate(grid):
+        emitter, blockers = first_emitter_and_blockers(row)
+        if emitter is not None and blockers:
+            rows.append(row_index)
+    return rows
+
+
+def has_multiple_right_blockers(grid: list[list[int]]) -> bool:
+    return any(
+        emitter is not None and len(blockers) >= 2
+        for row in grid
+        for emitter, blockers in [first_emitter_and_blockers(row)]
+    )
+
+
+def profile(grid: list[list[int]]) -> tuple[int, int, int]:
+    return len(grid), len(grid[0]), len({value for row in grid for value in row})
