+def test_self_check_rejects_structural_impostors():
+    good = gen.generate(8119, 5, grid_h=9, grid_w=11, rays=4)
+    assert gen.self_check(good) == []
+
+    ragged = copy.deepcopy(good)
+    ragged[0].pop()
+    assert gen.self_check(ragged)
+
+    bad_color = copy.deepcopy(good)
+    bad_color[0][0] = 10
+    assert gen.self_check(bad_color)
+
+    blocked_gap = copy.deepcopy(good)
+    row_index = active_rows(blocked_gap)[0]
+    row = blocked_gap[row_index]
+    emitter = next(i for i, value in enumerate(row) if value not in (0, 8))
+    blocker = next(i for i in range(emitter + 1, len(row)) if row[i] == 8)
+    row[emitter + 1] = row[emitter]
+    assert gen.self_check(blocked_gap)
+
+    no_blocker = copy.deepcopy(good)
+    row_index = active_rows(no_blocker)[0]
+    row = no_blocker[row_index]
+    emitter = next(i for i, value in enumerate(row) if value not in (0, 8))
+    for column in range(emitter + 1, len(row)):
+        if row[column] == 8:
+            row[column] = 0
+    assert gen.self_check(no_blocker)
