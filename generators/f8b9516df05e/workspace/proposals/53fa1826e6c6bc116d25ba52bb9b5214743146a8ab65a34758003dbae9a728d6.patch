+    assert gen.self_check(grid) == []
+    assert gen.observe_overrides(grid) == {
+        "grid_h": h,
+        "grid_w": w,
+        "rays": rays,
+    }
+    assert len(active_rows(grid)) == rays
+    assert has_multiple_right_blockers(grid)
+    assert gen.rule_mirror(grid) == reference_output(grid)
