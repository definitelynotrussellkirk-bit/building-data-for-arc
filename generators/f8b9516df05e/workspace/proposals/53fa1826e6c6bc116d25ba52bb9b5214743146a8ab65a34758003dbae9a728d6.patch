+def test_rule_pin_and_truthful_override_surface():
+    assert gen.RULE_HASH == "d469cd5280c8"
+    assert set(gen.AXES) == {"grid_h", "grid_w", "rays"}
+    assert gen.INCOMPATIBLE_OVERRIDE_COMBINATIONS == []
