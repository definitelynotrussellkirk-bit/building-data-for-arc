+def _load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+GENERATOR_PATH = Path(
+    os.environ.get(
+        "GENERATOR_UNDER_TEST",
+        LIBRARY / "generators" / TASK_ID / "generator.py",
+    )
+).resolve()
+gen = _load(GENERATOR_PATH, "review_generator_f8b9516df05e")
+
+
+def _canonical_pairs():
+    return canonical_pairs(TASK_ID, root=LIBRARY)
+
+
+def _pair(grid):
+    return {"input": copy.deepcopy(grid), "output": reference_output(grid)}
+
+
+def _pinned_seed(band: str, index: int) -> int:
+    digest = hashlib.sha256(
+        f"profile-floor:v1:{TASK_ID}:{band}:{index}".encode()
+    ).hexdigest()
+    return int(digest[:12], 16)
