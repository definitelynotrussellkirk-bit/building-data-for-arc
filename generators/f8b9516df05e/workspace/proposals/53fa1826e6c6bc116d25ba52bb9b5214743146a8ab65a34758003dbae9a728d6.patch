+def test_exact_overrides_are_constructive_and_observable_in_every_band(band, values):
+    h, w, rays = values
+    grid = gen.generate(
+        9301,
+        17,
+        difficulty=band,
+        grid_h=h,
+        grid_w=w,
+        rays=rays,
