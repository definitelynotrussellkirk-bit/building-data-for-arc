+
+def test_cli_build_and_verify_round_trip(tmp_path):
+    output_dir = tmp_path / "evidence"
+    build = subprocess.run(
+        [
+            sys.executable,
+            str(PROTOTYPE_PATH),
+            "build",
+            "--seeds",
+            "30",
+            "31",
+            "32",
+            "--difficulty",
+            "medium",
+            "--demos",
+            "1",
+            "--queries",
+            "1",
+            "--out",
+            str(output_dir),
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    assert build.returncode == 0, build.stderr
+    build_report = json.loads(build.stdout)
+    assert build_report["summary"]["episodes"] == 3
+    assert build_report["output"] == str(output_dir.resolve())
+
+    verify = subprocess.run(
+        [
+            sys.executable,
+            str(PROTOTYPE_PATH),
+            "verify",
+            "--out",
+            str(output_dir),
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    assert verify.returncode == 0, verify.stderr
+    assert json.loads(verify.stdout) == {
+        "episodes": 3,
+        "private_labeled_pairs": 6,
+        "programs": 3,
+        "public_files": 3,
+        "racket_rechecks": 0,
+    }
