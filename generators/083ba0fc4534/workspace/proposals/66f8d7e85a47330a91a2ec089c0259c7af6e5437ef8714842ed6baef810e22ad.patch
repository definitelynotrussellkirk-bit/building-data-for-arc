+            "input_sha256": sha_json(generated),
+            "diagonal_pairs": diagonal,
+            "canonical_output": canonical_generated,
+            "canonical_output_sha256": sha_json(canonical_generated),
+            "rival_name": "fill_any_pair_rect",
+            "rival_output": rival_generated,
+            "rival_output_sha256": sha_json(rival_generated),
