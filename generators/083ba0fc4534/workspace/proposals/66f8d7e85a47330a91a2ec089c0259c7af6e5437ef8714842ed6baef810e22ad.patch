+#!/usr/bin/env python3
+"""Retain one protected-Racket witness for the small-component filter."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from solvers.grounded_rules import GROUNDED_RULES
+
+
+HERE = Path(__file__).resolve().parent
+TASK_ID = "5c9fd75979d1"
+GENERATOR_PATH = HERE.parent / "generator.py"
+
+
+def load_generator():
+    spec = importlib.util.spec_from_file_location(f"probe_{TASK_ID}", GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise ImportError(GENERATOR_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def grid_literal(grid):
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def sha_json(value):
+    raw = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def apply(bridge, program, grid):
+    result = bridge.eval_text(f"({wrap_rule(program)} {grid_literal(grid)})")
+    if not isinstance(result, list) or not result or not isinstance(result[0], list):
+        raise ValueError("Racket returned a non-grid")
+    return result
+
+
+def component_record(component):
+    top, left, bottom, right = component["bbox"]
+    return {
+        "color": component["color"],
+        "cells": [list(cell) for cell in component["cells"]],
+        "bbox": [top, left, bottom, right],
+        "bbox_area": (bottom - top + 1) * (right - left + 1),
+    }
+
+
+def build_report():
+    generator = load_generator()
+    grid = generator.generate(
+        91_000,
+        700,
+        difficulty="medium",
+        scene_profile="noisy_3x3_repeat6",
+    )
+    small = [
+        component_record(component)
+        for component in generator._components(grid)
+        if (component["bbox"][2] - component["bbox"][0] + 1)
+        * (component["bbox"][3] - component["bbox"][1] + 1)
+        <= 2
+    ]
+    if not small:
+        raise ValueError("generated witness has no small component")
+
+    canonical = GROUNDED_RULES[TASK_ID]
+    needle = "(> (* bh bw) 2)"
+    if canonical.count(needle) != 1:
+        raise ValueError("canonical filter expression changed")
+    rival = canonical.replace(needle, "#t")
+
+    bridge = RacketBridge()
+    try:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise ValueError("protected Racket is required")
+        canonical_output = apply(bridge, canonical, grid)
+        rival_output = apply(bridge, rival, grid)
+    finally:
+        bridge.close()
+
+    if canonical_output != generator.rule_mirror(grid):
+        raise ValueError("canonical Python mirror differs from Racket")
+    if rival_output != generator.rule_keep_all_components(grid):
+        raise ValueError("rival Python mirror differs from Racket")
+    if canonical_output == rival_output:
+        raise ValueError("small-component witness did not refute rival")
+    if generator.self_check(grid):
+        raise ValueError("generated witness failed self_check")
+
+    return {
+        "schema": f"{TASK_ID}-learnability-witness-v1",
+        "task_id": TASK_ID,
+        "generator_version": generator.VERSION,
+        "generator_sha256": hashlib.sha256(GENERATOR_PATH.read_bytes()).hexdigest(),
+        "finding": (
+            "The former generator never exercised the canonical bbox-area > 2 filter. "
+            "Version 3.1.0 adds one detached one-cell fragment to every generated scene."
+        ),
+        "finite_rival": {
+            "name": "keep_all_components",
+            "description": "retain every nonzero component instead of discarding bbox-area <= 2 noise",
+            "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+            "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        },
+        "input": grid,
+        "input_sha256": sha_json(grid),
+        "small_components": small,
+        "canonical_output": canonical_output,
+        "canonical_output_sha256": sha_json(canonical_output),
+        "rival_output": rival_output,
+        "rival_output_sha256": sha_json(rival_output),
+        "outputs_differ": canonical_output != rival_output,
+        "self_check": generator.self_check(grid),
+        "racket": identity,
+        "scope": "one generated source-bound witness against one finite shortcut; not a universal uniqueness proof",
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    report = build_report()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"task_id": TASK_ID, "out": str(args.out), "outputs_differ": True}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
