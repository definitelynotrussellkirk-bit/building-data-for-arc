+#!/usr/bin/env python3
+"""Retain protected-Racket witnesses for ffb7c0bc9376 peer repairs."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_pairs, find_root
+
+
+HERE = Path(__file__).resolve().parent
+TASK_ID = "ffb7c0bc9376"
+GENERATOR_PATH = HERE.parent / "generator.py"
+RIVAL = """(rule!
+  (for/fold ([out g]) ([color (grid-colors g 0)])
+    (let ((cells (find-color g color)))
+      (if (= (length cells) 2)
+          (let* ((a (first cells))
+                 (b (second cells))
+                 (r1 (first a)) (c1 (second a))
+                 (r2 (first b)) (c2 (second b)))
+            (paint-cells out
+              (positions-in-rect (min r1 r2) (min c1 c2)
+                                 (max r1 r2) (max c1 c2))
+              color))
+          out))))"""
+
+
+def load_generator():
+    spec = importlib.util.spec_from_file_location(f"probe_{TASK_ID}", GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise ImportError(GENERATOR_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def grid_literal(grid):
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def sha_json(value):
+    raw = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def apply(bridge, program, grid):
+    result = bridge.eval_text(f"({wrap_rule(program)} {grid_literal(grid)})")
+    if not isinstance(result, list) or not result or not isinstance(result[0], list):
+        raise ValueError("Racket returned a non-grid")
+    return result
+
+
+def by_color(grid):
+    result = {}
+    for row, values in enumerate(grid):
+        for col, value in enumerate(values):
+            if value:
+                result.setdefault(value, []).append((row, col))
+    return result
+
+
+def diagonal_pairs(grid):
+    return {
+        color: [list(cell) for cell in cells]
+        for color, cells in by_color(grid).items()
+        if len(cells) == 2 and cells[0][0] != cells[1][0] and cells[0][1] != cells[1][1]
+    }
+
+
+def adjacent_pair(grid):
+    for color, cells in by_color(grid).items():
+        if len(cells) != 2:
+            continue
+        (r1, c1), (r2, c2) = cells
+        if (r1 == r2 and abs(c1 - c2) == 1) or (c1 == c2 and abs(r1 - r2) == 1):
+            return {"color": color, "cells": [list(cells[0]), list(cells[1])]}
+    return None
+
+
+def build_report():
+    generator = load_generator()
+    root = find_root(__file__)
+    source_record = json.loads(
+        (root / "shared/data/base/solutions/banks/53ccebf2a36f/E125__ffb7c0bc9376.json").read_text()
+    )
+    canonical = source_record["racket_target"]["target_code"]
+    generated = generator.generate(40_000, 3, difficulty="easy")
+    diagonal = diagonal_pairs(generated)
+    if not diagonal:
+        raise ValueError("generated witness has no diagonal pair")
+
+    pairs = canonical_pairs(TASK_ID, root=find_root(__file__), variant=0, labeled_only=True)
+    canonical_case = next((pair for pair in pairs if adjacent_pair(pair["input"])), None)
+    if canonical_case is None:
+        raise ValueError("canonical adjacent-pair witness not found")
+
+    bridge = RacketBridge()
+    try:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise ValueError("protected Racket is required")
+        canonical_generated = apply(bridge, canonical, generated)
+        rival_generated = apply(bridge, RIVAL, generated)
+        canonical_adjacent = apply(bridge, canonical, canonical_case["input"])
+    finally:
+        bridge.close()
+
+    if canonical_generated != generator.rule_mirror(generated):
+        raise ValueError("canonical Python mirror differs from Racket")
+    if rival_generated != generator.rule_fill_any_pair_rect(generated):
+        raise ValueError("rival Python mirror differs from Racket")
+    if canonical_generated == rival_generated:
+        raise ValueError("diagonal witness did not refute rival")
+    if canonical_adjacent != canonical_case["output"]:
+        raise ValueError("canonical adjacent case label differs from Racket")
+    if generator.self_check(canonical_case["input"]):
+        raise ValueError("canonical adjacent case remains rejected")
+
+    return {
+        "schema": f"{TASK_ID}-learnability-witness-v1",
+        "task_id": TASK_ID,
+        "generator_version": generator.VERSION,
+        "generator_sha256": hashlib.sha256(GENERATOR_PATH.read_bytes()).hexdigest(),
