+"""Focused teaching and non-interference tests for ffb7c0bc9376."""
+from __future__ import annotations
+
+import importlib
+from itertools import combinations
+
+from reviewer_support import canonical_pairs, find_root
+
+
+TASK_ID = "ffb7c0bc9376"
+MOD = importlib.import_module(f"puzzle_generators.per_puzzle.{TASK_ID}.generator")
+ROOT = find_root(__file__)
+
+
+def by_color(grid):
+    result = {}
+    for row, values in enumerate(grid):
+        for col, value in enumerate(values):
+            if value:
+                result.setdefault(value, []).append((row, col))
+    return result
+
+
+def segment(cells):
+    (r1, c1), (r2, c2) = cells
+    if r1 == r2:
+        return {(r1, col) for col in range(min(c1, c2), max(c1, c2) + 1)}
+    if c1 == c2:
+        return {(row, c1) for row in range(min(r1, r2), max(r1, r2) + 1)}
+    return None
+
+
+def test_canonical_pairs_are_accepted_and_mirror_matches():
+    pairs = canonical_pairs(TASK_ID, root=ROOT, variant=0, labeled_only=True)
+    assert pairs
+    for pair in pairs:
+        assert MOD.self_check(pair["input"]) == []
+        assert MOD.rule_mirror(pair["input"]) == pair["output"]
+
+
+def test_generated_examples_refute_fill_any_pair_and_do_not_interfere():
+    for band in ("easy", "medium", "hard"):
+        for seed in range(40):
+            grid = MOD.generate(40_000 + seed, seed * 17 + 3, difficulty=band)
+            assert MOD.self_check(grid) == []
+            groups = by_color(grid)
+            aligned = []
+            diagonal = []
+            inert = []
+            for color, cells in groups.items():
+                if len(cells) == 2:
+                    path = segment(cells)
+                    if path is None:
+                        diagonal.extend(cells)
+                    elif len(path) >= 3:
+                        aligned.append((color, path))
+                    else:
+                        inert.extend(cells)
+                else:
+                    inert.extend(cells)
+            assert diagonal, (band, seed)
+            for (_color_a, path_a), (_color_b, path_b) in combinations(aligned, 2):
+                assert path_a.isdisjoint(path_b), (band, seed)
+            reserved = set().union(*(path for _color, path in aligned)) if aligned else set()
+            assert reserved.isdisjoint(diagonal)
+            assert reserved.isdisjoint(inert)
+            assert MOD.rule_fill_any_pair_rect(grid) != MOD.rule_mirror(grid)
+    assert set(MOD.CANONICAL_SHORTCUTS) == {"fill_any_pair_rect"}
+
+
+def test_rule_hash_is_pinned():
+    assert MOD.RULE_HASH == "f1ae0294f170"
