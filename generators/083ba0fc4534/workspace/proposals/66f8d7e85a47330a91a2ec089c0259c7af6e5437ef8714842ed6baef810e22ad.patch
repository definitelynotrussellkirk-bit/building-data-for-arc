+            "input_sha256": sha_json(canonical_case["input"]),
+            "expected_output_sha256": sha_json(canonical_case["output"]),
+            "racket_output_sha256": sha_json(canonical_adjacent),
+            "self_check": generator.self_check(canonical_case["input"]),
+            "racket_matches_label": canonical_adjacent == canonical_case["output"],
+        },
+        "program_sha256": {
+            "canonical": hashlib.sha256(canonical.encode()).hexdigest(),
+            "fill_any_pair_rect": hashlib.sha256(RIVAL.encode()).hexdigest(),
+        },
+        "racket": identity,
+        "scope": "one generated rival witness plus one canonical adjacent-pair regression; finite, not universal",
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    report = build_report()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"task_id": TASK_ID, "out": str(args.out), "outputs_differ": True}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
