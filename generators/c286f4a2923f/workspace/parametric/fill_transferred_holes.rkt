(rule!
  (let ((dummy 0))
    (define (offset< a b)
      (if (= (first a) (first b))
          (< (second a) (second b))
          (< (first a) (first b))))
    (define (find-single grid color)
      (first (filter (lambda (obj) (= (obj-color obj) color)) (objects grid 0))))
    (define (relative-offsets obj anchor)
      (let* ((ar (cond ((= anchor 0) (obj-r1 obj))
                       ((= anchor 1) (obj-r1 obj))
                       ((= anchor 2) (obj-r2 obj))
                       (else (obj-r2 obj))))
             (ac (cond ((= anchor 0) (obj-c1 obj))
                       ((= anchor 1) (obj-c2 obj))
                       ((= anchor 2) (obj-c1 obj))
                       (else (obj-c2 obj)))))
        (sort
          (map (lambda (p) (list (- (first p) ar) (- (second p) ac)))
               (obj-cells obj))
          offset<)))
    (define (place-offsets out offsets anchor color)
      (for/fold ((acc out)) ((p (in-list offsets)))
        (set-cell acc
                  (+ (first anchor) (first p))
                  (+ (second anchor) (second p))
                  color)))
    (define source (find-single g 2))
    (define target (find-single g 3))
    (define transferred
      (place-offsets
        (empty-grid (rows g) (cols g) 0)
        (relative-offsets source 0)
        (list (obj-r1 target) (obj-c1 target))
        8))
    (fill-all-enclosed transferred 4 0)))
