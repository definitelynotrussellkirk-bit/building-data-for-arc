(rule! (lambda (g)
         (let ((n (rows g)))
           (build-grid (* 3 n)
                       (* 3 n)
                       (r c)
                       (let ((br (quotient r n))
                             (bc (quotient c n))
                             (lr (mod r n))
                             (lc (mod c n)))
                         (at g
                             (if (odd? br) (- n 1 lr) lr)
                             (if (odd? bc) (- n 1 lc) lc)))))))
