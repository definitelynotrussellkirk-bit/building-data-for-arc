+"""Bounded protected-Racket learnability probe; never changes production code.
+
+Run through the packet wrapper so the selected local Racket is pinned:
+  python review.py run python generators/f68fe53c1702/workspace/probe_three_marker_bbox.py \
+    --out ../checks/f68fe53c1702/three-marker-bbox.json
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+
+TASK = "f68fe53c1702"
+ROOT = find_root(__file__)
+SEEDS = (0, 1, 2, 3)
+INDICES = (0, 1, 2, 3)
+RIVAL = """(rule!
+  (let* ((cells (filter-cells g (lambda (r c v) (not (= v 0)))))
+         (n (length cells)))
+    (if (empty? cells)
+        g
+        (let* ((groups
+                 (if (< n 3)
+                     (list cells)
+                     (for*/list ([i (in-range n)]
+                                 [j (in-range (+ i 1) n)]
+                                 [k (in-range (+ j 1) n)])
+                       (list (list-ref cells i) (list-ref cells j) (list-ref cells k)))))
+               (boxes (map bbox-of-cells groups))
+               (area (lambda (b)
+                       (* (+ 1 (- (third b) (first b)))
+                          (+ 1 (- (fourth b) (second b))))))
+               (bb (first (sort boxes (lambda (a b) (> (area a) (area b))))))
+               (color (at g (first (first cells)) (second (first cells))))
+               (r0 (first bb)) (c0 (second bb)) (r1 (third bb)) (c1 (fourth bb))
+               (outline
+                 (append
+                   (for/list ([c (in-range c0 (+ c1 1))]) (list r0 c))
+                   (for/list ([c (in-range c0 (+ c1 1))]) (list r1 c))
+                   (for/list ([r (in-range r0 (+ r1 1))]) (list r c0))
+                   (for/list ([r (in-range r0 (+ r1 1))]) (list r c1)))))
+          (paint-cells (empty-grid (rows g) (cols g) 0) outline color)))))"""
+
+
+def sha256(body):
+    return hashlib.sha256(body).hexdigest()
+
+
+def run():
+    generator, source_path, source_hash = load_selected_generator(TASK, root=ROOT)
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        programs = {row["program_solution"] for line in handle
+                    if (row := json.loads(line)).get("task_id") == TASK}
+    if len(programs) != 1:
+        raise ValueError("This probe requires one exact task-local canonical program")
+    canonical = programs.pop()
+    wrapped = {source: wrap_rule(source) for source in (canonical, RIVAL)}
+    report = {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "task_id": TASK,
+        "production_changed": False,
+        "source": {
+            "path": source_path.relative_to(ROOT).as_posix(),
+            "sha256": source_hash,
+            "version": generator.VERSION,
+            "declared_rule_hash": generator.RULE_HASH,
+            "canonical_program_sha256": sha256(canonical.encode()),
+            "rival_program_sha256": sha256(RIVAL.encode()),
+            "probe_sha256": sha256(Path(__file__).read_bytes()),
+        },
+        "rival": {
+            "name": "maximum_area_three_marker_bbox",
+            "description": "Draw the largest-area bounding box supported by any three markers, erasing interior marks. Ties retain the first row-major triple.",
+            "motivation": "The canonical construction has three rectangle-corner markers; this rule keeps using only three markers when more appear.",
+            "program": RIVAL,
+        },
+        "canonical_program": canonical,
+        "scope": {
+            "seed_bound": list(SEEDS),
+            "sample_indices": list(INDICES),
+            "difficulty": None,
+            "overrides": {},
+            "rotations": "each of the four pairs can be the query",
+            "stop_at_first_counterexample": True,
+        },
+        "checked_windows": [],
+        "racket_evaluations": 0,
+        "limits": [
+            "One additional geometric rival and at most four four-example windows; no suite, census, or global uniqueness claim.",
+            "A rotated held-out query is used; this does not claim ambiguity for the fixed index-3 query in the first default window.",
+            "The generator's two declared rivals are a narrower finite set; no source or acceptance metadata is modified.",
+            "The retained counterexample is an audit proposal, not an applied repair or a change to training admission.",
+        ],
+    }
+    bridge = RacketBridge()
+    try:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("The probe requires a protected live Racket backend")
+        report["runtime"] = identity
+
+        def apply(source, grid):
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            output = bridge.eval_text(f"({wrapped[source]} {literal})")
+            report["racket_evaluations"] += 1
+            return output
+
+        for seed in SEEDS:
+            pairs, rival_outputs = [], []
+            for index in INDICES:
+                grid = generator.generate(seed, index)
+                errors = generator.self_check(grid)
+                if errors:
+                    raise AssertionError({"seed": seed, "index": index, "errors": errors})
+                pairs.append({"input": grid, "output": apply(canonical, grid)})
+                rival_outputs.append(apply(RIVAL, grid))
+            agrees = [pair["output"] == alternate for pair, alternate in zip(pairs, rival_outputs)]
+            report["checked_windows"].append({"seed": seed, "rival_matches_by_index": agrees})
+            for query_index in INDICES:
+                demo_indices = [i for i in INDICES if i != query_index]
+                if not agrees[query_index] and all(agrees[i] for i in demo_indices):
+                    demos = [pairs[i] for i in demo_indices]
+                    query = pairs[query_index]
+                    report["result"] = "three_demo_counterexample"
+                    report["witness"] = {
+                        "seed": seed,
+                        "demo_sample_indices": demo_indices,
+                        "query_sample_index": query_index,
+                        "train": demos,
+                        "test": [query],
+                        "rival_train_outputs": [rival_outputs[i] for i in demo_indices],
+                        "rival_test_output": rival_outputs[query_index],
+                        "existing_lesson_identifiable_findings": generator.lesson_identifiable(demos, query),
+                        "query_changed_cells": sum(a != b for row, other in zip(query["output"], rival_outputs[query_index])
+                                                   for a, b in zip(row, other)),
+                    }
+                    return report
+        report["result"] = "no_counterexample_within_bound"
+        return report
+    finally:
+        bridge.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({key: report[key] for key in ("task_id", "result", "checked_windows", "racket_evaluations")}))
+
+
+if __name__ == "__main__":
+    main()
