+#!/usr/bin/env python3
+"""Bounded audit of repaint-order teaching in three-demo production lessons.
+
+Run through the packet wrapper so reference labels use protected Racket:
+python3 review.py run python3 generators/f13d23b71bd4/workspace/learnability_probe.py \
+  --out ../checks/f13d23b71bd4/learnability/reverse-paint-order.json
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+TASK_ID = "f13d23b71bd4"
+MAX_SEEDS = 16
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[3]
+    source_path = root / "generators" / TASK_ID / "generator.py"
+    spec = importlib.util.spec_from_file_location("audited_f13d23b71bd4", source_path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    rows = [json.loads(line) for line in (root / "shared/data/canonical/puzzles.jsonl").open()
+            if line.strip()]
+    programs = {row["program_solution"] for row in rows if row.get("task_id") == TASK_ID}
+    assert len(programs) == 1
+    program = programs.pop()
+    site = "(objs (objects g bg))"
+    assert program.count(site) == 1
+    rival = program.replace(site, "(objs (reverse (objects g bg)))", 1)
+
+    def reverse_mirror(grid):
+        output = [[7] * len(grid[0]) for _ in grid]
+        for obj in reversed(module._components(grid)):
+            for row, col in obj["target"]:
+                output[row][col] = obj["color"]
+        return output
+
+    selected = None
+    searched_seeds = []
+    for seed in range(MAX_SEEDS):
+        grids = [module.generate(seed, index) for index in range(4)]
+        assert all(not module.self_check(grid) for grid in grids)
+        canonical_claims = [module.rule_mirror(grid) for grid in grids]
+        rival_claims = [reverse_mirror(grid) for grid in grids]
+        searched_seeds.append(seed)
+        if canonical_claims[:3] == rival_claims[:3] and canonical_claims[3] != rival_claims[3]:
+            selected = (seed, grids, canonical_claims, rival_claims)
+            break
+
+    record = {
+        "schema": "arcpuzzles-bounded-learnability-audit-v1",
+        "task_id": TASK_ID,
+        "status": "finite_no_finding" if selected is None else "finding",
+        "production_changed": False,
+        "source_binding": {
+            "generator_path": str(source_path.relative_to(root)),
+            "generator_sha256": sha(source_path),
+            "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+            "probe_path": str(Path(__file__).resolve().relative_to(root)),
+            "probe_sha256": sha(__file__),
+        },
+        "command": {
+            "cwd": "repo",
+            "argv": ["python3", str(Path(__file__).resolve().relative_to(root)),
+                     "--out", str(args.out)],
+            "entrypoint": "python3 review.py run",
+            "exit_code": 0,
+        },
+        "search": {
+            "seed_limit": MAX_SEEDS,
+            "searched_seeds": searched_seeds,
+            "sample_indices": [0, 1, 2, 3],
+            "demonstration_indices": [0, 1, 2],
+            "query_indices": [3],
+            "difficulty": None,
+            "overrides": {},
+            "candidate_filter": "Python mirrors; retained labels independently executed in protected Racket",
+        },
+        "rival": {
+            "name": "reverse_repaint_order",
+            "meaning": "Objects are still monochrome 4-connected and size>=4 falls, but earlier discovered objects win landing collisions.",
+            "program": rival,
+            "program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        },
+        "racket_evaluations": 0,
+        "limits": [
+            "One plausible rival and at most sixteen default-seed lessons; not a census or universal identifiability result.",
+            "The selected production generator and canonical reference are unchanged.",
+            "This probe does not review the separate minimum_fall_size prototype, its export-order follow-up, or native admission.",
+        ],
+    }
+    if selected is not None:
+        seed, grids, canonical_claims, rival_claims = selected
+        from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+        runtime = root / "shared/runtime"
+        pairs = []
+        with _local_imports(runtime, runtime):
+            apply, identity, bridge = _real_evaluator(runtime)
+            try:
+                for index, grid in enumerate(grids):
+                    expected = _grid(apply(program, grid))
+                    alternate = _grid(apply(rival, grid))
+                    assert expected == canonical_claims[index]
+                    assert alternate == rival_claims[index]
+                    pairs.append({
+                        "sample_index": index,
+                        "scene_profile": module.observe_overrides(grid)["scene_profile"],
+                        "input": grid,
+                        "output": expected,
+                        "rival_output": alternate,
+                        "rival_agrees": expected == alternate,
+                    })
+            finally:
+                bridge.close()
+        assert all(pair["rival_agrees"] for pair in pairs[:3])
+        assert not pairs[3]["rival_agrees"]
+        record.update({
+            "racket": identity,
+            "racket_evaluations": 8,
+            "lesson": {"seed": seed, "program": program, "train": pairs[:3], "test": pairs[3:]},
+            "query_different_cells": [
+                {"row": r, "col": c, "canonical": pairs[3]["output"][r][c],
+                 "rival": pairs[3]["rival_output"][r][c]}
+                for r, row in enumerate(pairs[3]["output"])
+                for c, value in enumerate(row) if value != pairs[3]["rival_output"][r][c]
+            ],
+            "finding": "The reverse repaint-order rule fits all three visible demonstrations and changes the generated query answer.",
+            "next_action": "Before emitting a multicolor collision query, require a demonstration that distinguishes repaint priority, or reject/resample that query; add reverse_repaint_order as an executable lesson rival.",
+        })
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": record["status"], "searched_seeds": searched_seeds,
+        "seed": record.get("lesson", {}).get("seed"),
+        "profiles": [pair["scene_profile"] for split in ("train", "test")
+                     for pair in record.get("lesson", {}).get(split, [])],
+        "racket_evaluations": record["racket_evaluations"], "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
