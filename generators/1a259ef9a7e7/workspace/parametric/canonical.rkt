(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((wide (lambda (r c)
                          (if (< c w) (at g r (- (- w 1) c)) (at g r (- c w))))))
             (build-grid (* 3 h)
                         (* 2 w)
                         (r c)
                         (let* ((block (/ r h))
                                (rr (mod r h))
                                (src-r (if (zero? (mod block 2)) (- (- h 1) rr) rr)))
                           (wide src-r c)))))))