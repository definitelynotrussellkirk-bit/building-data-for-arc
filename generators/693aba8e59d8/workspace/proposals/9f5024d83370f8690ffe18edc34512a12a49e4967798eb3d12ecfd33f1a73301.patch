+        {"seed": 1.0, "sample_index": 0},
+        {"seed": 1, "sample_index": -1},
+        {"seed": 1, "sample_index": 0, "difficulty": "impossible"},
+        {"seed": 1, "sample_index": 0, "grid_h": True},
+        {"seed": 1, "sample_index": 0, "grid_w": "7"},
+        {"seed": 1, "sample_index": 0, "template_size": 2},
