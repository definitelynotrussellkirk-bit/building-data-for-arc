+def _shape_variants(cells) -> tuple[tuple[tuple[int, int], ...], ...]:
+    current = tuple(cells)
+    variants: list[tuple[tuple[int, int], ...]] = []
+    for _ in range(4):
+        normalized = _normalize_cells(current)
+        reflected = _normalize_cells((row, -col) for row, col in current)
+        for candidate in (normalized, reflected):
+            if candidate not in variants:
+                variants.append(candidate)
+        current = tuple((col, -row) for row, col in current)
+    return tuple(variants)
