+def test_generation_is_deterministic_fresh_and_global_rng_pure():
+    random.seed(8675309)
+    before = random.getstate()
+    first = gen.generate(42, 2, difficulty="hard")
+    after = random.getstate()
+    second = gen.generate(42, 2, difficulty="hard")
+    assert before == after
+    assert first == second
