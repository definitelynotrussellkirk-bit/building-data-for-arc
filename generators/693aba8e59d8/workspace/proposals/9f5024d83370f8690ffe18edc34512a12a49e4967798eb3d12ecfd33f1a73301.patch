+#!/usr/bin/env python3
+"""Reproduce the pre-repair constant-scale shortcut with protected Racket.
+
+The preserved v1.3.0 generator emits seed 7 marker counts 4,4,4,3 for
+sample indices 0..3.  Therefore an `always upscale by four` program fits all
+three demonstrations but fails the held-out query.  This tool binds the case to
+the preserved source and canonical rule and executes both programs in protected
+Racket.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import find_root
+
+TASK_ID = "5a6c8785f6d9"
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parent
+OLD_SOURCE = TASK_HOME / "counterexamples/review-de6fb3d52a32cf07/pre_repair_generator.py"
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load_old_generator():
+    spec = importlib.util.spec_from_file_location("pre_repair_5a6c8785f6d9", OLD_SOURCE)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {OLD_SOURCE}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_record(root: Path) -> dict[str, Any]:
+    bank = root / "shared/data/base/solutions/banks/2eea055c3155/hard_07__5a6c8785f6d9.json"
+    record = json.loads(bank.read_text(encoding="utf-8"))
+    if record.get("task_id") != TASK_ID:
+        raise AssertionError("canonical bank task mismatch")
+    return record
+
+
+def _components(grid: list[list[int]]) -> list[list[tuple[int, int]]]:
+    rows, cols = len(grid), len(grid[0])
+    remaining = {(r, c) for r in range(rows) for c in range(cols) if grid[r][c] != 0}
+    objects: list[list[tuple[int, int]]] = []
+    while remaining:
+        start = next(iter(remaining))
+        color = grid[start[0]][start[1]]
+        stack = [start]
+        remaining.remove(start)
+        cells: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            cells.append((r, c))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nxt = (r + dr, c + dc)
+                if nxt in remaining and grid[nxt[0]][nxt[1]] == color:
+                    remaining.remove(nxt)
+                    stack.append(nxt)
+        objects.append(cells)
+    return objects
+
+
+def _marker_count(grid: list[list[int]]) -> int:
+    return sum(len(obj) == 1 for obj in _components(grid))
+
+
+def _execute(programs: dict[str, str], grids: list[list[list[int]]]):
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise AssertionError("protected Racket required")
+        symbols: dict[str, str] = {}
+        for index, (name, source) in enumerate(programs.items()):
+            symbol = f"__pre_repair_scale_{index}"
+            bridge.eval_text(f"(define {symbol} {wrap_rule(source)})")
+            symbols[name] = symbol
+        inputs: list[str] = []
+        for index, grid in enumerate(grids):
+            symbol = f"__pre_repair_input_{index}"
+            bridge.define_grid(symbol, grid)
+            inputs.append(symbol)
+        outputs = {
+            name: [bridge.eval_text(f"({symbol} {input_symbol})") for input_symbol in inputs]
+            for name, symbol in symbols.items()
+        }
+    return outputs, identity
+
+
+def build_report(seed: int = 7) -> dict[str, Any]:
+    root = find_root(__file__)
+    old = _load_old_generator()
+    grids = [old.generate(seed, index) for index in range(4)]
+    counts = [_marker_count(grid) for grid in grids]
+    if counts != [4, 4, 4, 3]:
+        raise AssertionError(f"preserved generator no longer reproduces expected counts: {counts}")
+
+    record = _canonical_record(root)
+    canonical = record["racket_target"]["target_code"]
+    needle = "(upscale pat (length markers))"
+    if canonical.count(needle) != 1:
+        raise AssertionError("canonical source replacement anchor changed")
+    constant_four = canonical.replace(needle, "(upscale pat 4)")
+    outputs, identity = _execute(
+        {"canonical_marker_count": canonical, "constant_scale_4": constant_four}, grids
+    )
+    demo_matches = [
+        outputs["canonical_marker_count"][index] == outputs["constant_scale_4"][index]
+        for index in range(3)
+    ]
+    query_matches = outputs["canonical_marker_count"][3] == outputs["constant_scale_4"][3]
+    if demo_matches != [True, True, True] or query_matches:
+        raise AssertionError("counterexample did not exhibit the required shortcut")
+
+    return {
+        "schema": "5a6c8785f6d9-pre-repair-constant-scale-counterexample-v1",
+        "status": "reproduced",
+        "training_admitted": False,
+        "seed": seed,
+        "sample_indices": [0, 1, 2, 3],
+        "marker_counts": counts,
+        "demonstration_indices": [0, 1, 2],
+        "query_index": 3,
+        "shortcut": "always upscale the recovered template by four",
+        "demo_matches": demo_matches,
+        "query_matches": query_matches,
+        "query_changed_cells": sum(
+            a != b
+            for row_a, row_b in zip(
+                outputs["canonical_marker_count"][3], outputs["constant_scale_4"][3]
+            )
+            for a, b in zip(row_a, row_b)
+        ),
+        "racket": {
+            "identity": identity,
+            "programs": 2,
+            "inputs": 4,
+            "evaluations": 8,
+        },
+        "source_sha256": {
+            "pre_repair_generator.py": _sha(OLD_SOURCE),
+            "canonical_bank.json": _sha(
+                root / "shared/data/base/solutions/banks/2eea055c3155/hard_07__5a6c8785f6d9.json"
+            ),
+            "canonical_program": hashlib.sha256(canonical.encode()).hexdigest(),
+            "constant_scale_4_program": hashlib.sha256(constant_four.encode()).hexdigest(),
+        },
+        "pairs": [
+            {
+                "role": "demo" if index < 3 else "query",
+                "sample_index": index,
+                "marker_count": counts[index],
+                "input": grid,
+                "canonical_output": outputs["canonical_marker_count"][index],
+                "shortcut_output": outputs["constant_scale_4"][index],
+            }
+            for index, grid in enumerate(grids)
+        ],
+        "repair": (
+            "Replace independent random marker counts with a four-slot 2/3/4/4 curriculum; "
+            "every three-demonstration rotation then shows three distinct scale factors and "
+            "the declared finite-rival gate rejects constant-scale rules."
+        ),
+        "limits": [
+            "This is one exact source-bound pre-repair counterexample, not an exhaustive proof.",
+            "The post-repair schedule census separately checks all four rotations and ten declared rivals.",
+        ],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=7)
+    args = parser.parse_args()
+    report = build_report(args.seed)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"],
+        "marker_counts": report["marker_counts"],
+        "demo_matches": report["demo_matches"],
+        "query_matches": report["query_matches"],
+        "query_changed_cells": report["query_changed_cells"],
+        "evaluations": report["racket"]["evaluations"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
