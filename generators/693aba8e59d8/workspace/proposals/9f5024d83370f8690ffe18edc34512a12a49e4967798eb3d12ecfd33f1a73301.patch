+def _normalize_cells(cells) -> tuple[tuple[int, int], ...]:
+    materialized = tuple(cells)
+    min_row = min(row for row, _ in materialized)
+    min_col = min(col for _, col in materialized)
+    return tuple(
+        sorted((row - min_row, col - min_col) for row, col in materialized)
+    )
