+#!/usr/bin/env python3
+"""Adjudicate the rectangle-outline trainer flag with protected Racket.
+
+The flagged alternative, "join every pair of same-colored cells sharing a row
+or column", is not a competing rule on this generator's valid domain.  Each
+color has exactly the four Cartesian corners of one axis-aligned rectangle, so
+the aligned pairs are exactly its four boundary sides.  This tool executes both
+Racket programs on canonical, flagged, and generated inputs and records the
+source-bound equivalence result.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_pairs, find_root
+
+TASK_ID = "64592477ccc8"
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parent
+CANONICAL_BANK = "shared/data/base/solutions/banks/dc02f6f7c147/E102__64592477ccc8.json"
+FLAGGED_PRIVATE = TASK_HOME / "evidence/trainer-ambiguity-current/episodes.private.jsonl"
+FLAGGED_CURRENT = TASK_HOME / "evidence/trainer-ambiguity-current/current.json"
+
+PAIRWISE_JOIN_RACKET = r"""(rule!
+  (let ((colors (remove-duplicates
+                  (map third (filter (lambda (cell) (not (= (third cell) 0)))
+                                     (grid-cells g))))))
+    (for/fold ([out (empty-grid (rows g) (cols g) 0)]) ([color (in-list colors)])
+      (let ((cells (find-color g color)))
+        (for*/fold ([painted out]) ([p (in-list cells)] [q (in-list cells)])
+          (cond
+            [(= (first p) (first q))
+             (paint-cells painted
+               (for/list ([c (in-range (min (second p) (second q))
+                                       (+ (max (second p) (second q)) 1))])
+                 (list (first p) c))
+               color)]
+            [(= (second p) (second q))
+             (paint-cells painted
+               (for/list ([r (in-range (min (first p) (first q))
+                                       (+ (max (first p) (first q)) 1))])
+                 (list r (second p)))
+               color)]
+            [else painted]))))))"""
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _grid_key(grid: list[list[int]]) -> bytes:
+    return json.dumps(grid, separators=(",", ":")).encode()
+
+
+def _load_flagged_inputs() -> tuple[list[list[list[int]]], list[dict[str, Any]]]:
+    grids: list[list[list[int]]] = []
+    metadata: list[dict[str, Any]] = []
+    for line_number, line in enumerate(FLAGGED_PRIVATE.read_text(encoding="utf-8").splitlines(), 1):
+        if not line.strip():
+            continue
+        row = json.loads(line)
+        episode = row["episode"]
+        pairs = list(episode.get("train", [])) + list(episode.get("test", []))
+        for pair_index, pair in enumerate(pairs):
+            grids.append(pair["input"])
+            metadata.append({
+                "line": line_number,
+                "episode_id": episode.get("episode_id"),
+                "role": "demo" if pair_index < len(episode.get("train", [])) else "query",
+                "pair_index": pair_index,
+            })
+    return grids, metadata
+
+
+def _execute(programs: dict[str, str], grids: list[list[list[int]]]):
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise AssertionError("protected Racket required")
+        symbols: dict[str, str] = {}
+        for index, (name, source) in enumerate(programs.items()):
+            symbol = f"__rectangle_equiv_rule_{index}"
+            bridge.eval_text(f"(define {symbol} {wrap_rule(source)})")
+            symbols[name] = symbol
+        input_symbols: list[str] = []
+        for index, grid in enumerate(grids):
+            symbol = f"__rectangle_equiv_input_{index}"
+            bridge.define_grid(symbol, grid)
+            input_symbols.append(symbol)
+        outputs = {
+            name: [bridge.eval_text(f"({symbol} {input_symbol})") for input_symbol in input_symbols]
+            for name, symbol in symbols.items()
+        }
+    return outputs, identity
+
+
+def build_report() -> dict[str, Any]:
+    root = find_root(__file__)
+    generator_path = TASK_HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location("audit_generator_64592477ccc8", generator_path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {generator_path}")
+    gen = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(gen)
+    canonical_path = root / CANONICAL_BANK
+    canonical_record = json.loads(canonical_path.read_text(encoding="utf-8"))
+    canonical_program = canonical_record["racket_target"]["target_code"]
+
+    sources: list[tuple[str, list[list[int]], dict[str, Any]]] = []
+    for index, pair in enumerate(canonical_pairs(TASK_ID, root=root)):
+        sources.append(("canonical", pair["input"], {"pair_index": index, "expected": pair["output"]}))
+
+    flagged_grids, flagged_metadata = _load_flagged_inputs()
+    for grid, metadata in zip(flagged_grids, flagged_metadata):
+        sources.append(("trainer_flag", grid, metadata))
+
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in (0, 17):
+            for sample_index in range(16):
+                grid = gen.generate(seed, sample_index, difficulty=difficulty)
+                sources.append(("generated", grid, {
+                    "difficulty": difficulty,
+                    "seed": seed,
+                    "sample_index": sample_index,
+                }))
+
+    # Preserve the first occurrence while deduplicating exact inputs.
+    unique: dict[bytes, tuple[str, list[list[int]], dict[str, Any]]] = {}
+    for source, grid, metadata in sources:
+        unique.setdefault(_grid_key(grid), (source, grid, metadata))
+    records = list(unique.values())
+    grids = [record[1] for record in records]
+
+    for source, grid, metadata in records:
+        errors = gen.self_check(grid)
+        if errors:
+            raise AssertionError(f"invalid {source} grid {metadata}: {errors}")
+
+    outputs, identity = _execute(
+        {"bounding_box_outline": canonical_program, "aligned_pair_join": PAIRWISE_JOIN_RACKET},
+        grids,
+    )
+    canonical_outputs = outputs["bounding_box_outline"]
+    rival_outputs = outputs["aligned_pair_join"]
+    mismatches = [index for index, (left, right) in enumerate(zip(canonical_outputs, rival_outputs)) if left != right]
+    if mismatches:
+        raise AssertionError(f"Racket programs differ on inputs {mismatches[:10]}")
+
+    mirror_mismatches = [
+        index for index, (grid, output) in enumerate(zip(grids, canonical_outputs))
+        if gen.rule_mirror(grid) != output
+    ]
+    if mirror_mismatches:
+        raise AssertionError(f"production mirror differs on inputs {mirror_mismatches[:10]}")
+
+    canonical_expected_mismatches = []
+    for index, (source, _grid, metadata) in enumerate(records):
+        expected = metadata.get("expected")
+        if source == "canonical" and expected is not None and canonical_outputs[index] != expected:
+            canonical_expected_mismatches.append(index)
+    if canonical_expected_mismatches:
+        raise AssertionError(f"canonical labels differ on {canonical_expected_mismatches}")
+
+    counts: dict[str, int] = {}
+    for source, _grid, _metadata in records:
+        counts[source] = counts.get(source, 0) + 1
+
+    flagged_indices = [index for index, record in enumerate(records) if record[0] == "trainer_flag"]
+    return {
+        "schema": "64592477ccc8-aligned-pair-equivalence-audit-v1",
+        "status": "equivalent_on_checked_valid_domain",
+        "verdict": "trainer_flag_is_extensional_equivalence_not_query_changing_ambiguity",
+        "training_admitted": False,
+        "structural_argument": [
+            "self_check requires each color to occupy exactly four cells equal to the Cartesian corners {r0,r1} x {c0,c1} of one nondegenerate axis-aligned rectangle",
+            "among those four cells, the same-row pairs are exactly the top and bottom sides and the same-column pairs are exactly the left and right sides",
+            "joining every aligned same-color pair therefore paints exactly the bounding-box outline",
+            "self_check also requires outlines of different colors to be disjoint, so program order cannot create a cross-color overwrite difference",
+        ],
+        "checked_inputs": len(grids),
+        "input_sources": counts,
+        "flagged_inputs_checked": len(flagged_indices),
+        "racket": {
+            "identity": identity,
+            "programs": 2,
+            "inputs": len(grids),
+            "evaluations": 2 * len(grids),
+            "mismatches": 0,
+        },
+        "production_mirror_mismatches": 0,
+        "canonical_expected_mismatches": 0,
+        "program_sha256": {
+            "bounding_box_outline": hashlib.sha256(canonical_program.encode()).hexdigest(),
+            "aligned_pair_join": hashlib.sha256(PAIRWISE_JOIN_RACKET.encode()).hexdigest(),
+        },
+        "source_sha256": {
+            "generator.py": _sha(TASK_HOME / "generator.py"),
+            "canonical_bank.json": _sha(canonical_path),
+            "trainer_current.json": _sha(FLAGGED_CURRENT),
+            "trainer_episodes.private.jsonl": _sha(FLAGGED_PRIVATE),
+            "equivalence_audit.py": _sha(Path(__file__)),
+        },
+        "source_sample": [
+            {"index": index, "source": source, "metadata": metadata}
+            for index, (source, _grid, metadata) in enumerate(records[:12])
+        ],
+        "limits": [
+            "The executable pass is finite: canonical pairs, the retained trainer episode, and 96 generated inputs.",
+            "The structural argument applies to every input accepted by the current self_check contract.",
+            "No generator acceptance or training admission is claimed by this adjudication.",
+        ],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = build_report()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"],
+        "checked_inputs": report["checked_inputs"],
+        "flagged_inputs_checked": report["flagged_inputs_checked"],
+        "evaluations": report["racket"]["evaluations"],
+        "mismatches": report["racket"]["mismatches"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
