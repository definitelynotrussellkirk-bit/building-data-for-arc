+def _coerce_grid(grid):
+    if not isinstance(grid, (list, tuple)) or not grid:
+        return None, ["grid must be a nonempty row sequence"]
+    rows = []
+    width = None
+    for row_index, row in enumerate(grid):
+        if isinstance(row, str):
+            values = [int(value) for value in row] if row and row.isdigit() else []
+        elif isinstance(row, (list, tuple)):
+            values = list(row)
+        else:
+            return None, [f"row {row_index} must be a sequence"]
+        if not values:
+            return None, [f"row {row_index} must be nonempty"]
+        if width is None:
+            width = len(values)
+        elif len(values) != width:
+            return None, ["grid must be rectangular"]
+        if any(type(value) is not int or not 0 <= value <= 9 for value in values):
+            return None, ["grid values must be integer ARC colors 0..9"]
+        rows.append(values)
+    if not 1 <= len(rows) <= 30 or not 1 <= width <= 30:
+        return None, ["grid dimensions must be in 1..30"]
+    return rows, []
+
+
+def _components(grid):
+    height = len(grid)
+    width = len(grid[0])
+    seen: set[tuple[int, int]] = set()
+    components = []
+    for start_row in range(height):
+        for start_col in range(width):
+            color = grid[start_row][start_col]
+            if color == 0 or (start_row, start_col) in seen:
+                continue
+            queue = deque([(start_row, start_col)])
+            seen.add((start_row, start_col))
+            cells = []
+            while queue:
+                row, col = queue.popleft()
+                cells.append((row, col))
+                for next_row, next_col in (
+                    (row - 1, col),
+                    (row + 1, col),
+                    (row, col - 1),
+                    (row, col + 1),
+                ):
+                    if (
+                        0 <= next_row < height
+                        and 0 <= next_col < width
+                        and (next_row, next_col) not in seen
+                        and grid[next_row][next_col] == color
+                    ):
+                        seen.add((next_row, next_col))
+                        queue.append((next_row, next_col))
+            components.append({"color": color, "cells": tuple(sorted(cells))})
+    return components
+
+
+def _fills_bbox(cells) -> bool:
+    rows = [row for row, _ in cells]
+    cols = [col for _, col in cells]
+    return (max(rows) - min(rows) + 1) * (max(cols) - min(cols) + 1) == len(cells)
+
