+from __future__ import annotations
+
+import importlib
+import random
+
+import pytest
+from reviewer_support import canonical_pairs, find_root
+
+
+gen = importlib.import_module("puzzle_generators.per_puzzle.5a6c8785f6d9.generator")
+ROOT = find_root(__file__)
+TASK_ID = "5a6c8785f6d9"
+
+
+def _pair(grid):
+    return {"input": grid, "output": gen.authoritative_output(grid)}
+
+
+def _marker_color_counts(grid):
+    analysis = gen._scene_analysis(grid)
+    assert analysis[2] == []
+    facts = analysis[1]
+    return facts["n_markers"], len(set(facts["marker_colors"])), len(facts["nonzero_colors"])
+
+
+def test_canonical_pairs_are_accepted_and_mirrored():
+    for pair in canonical_pairs(TASK_ID, root=ROOT):
+        assert gen.self_check(pair["input"]) == []
+        assert gen.authoritative_output(pair["input"]) == pair["output"]
+
+
+def test_default_four_slot_schedule_is_exact_and_seed_independent():
+    for difficulty in (None, "easy", "medium", "hard"):
+        for seed in (0, 7, 17, 99):
+            observed = [
+                gen.observe_overrides(gen.generate(seed, index, difficulty=difficulty))["n_markers"]
+                for index in range(8)
+            ]
+            assert observed == [2, 3, 4, 4, 2, 3, 4, 4]
+
+
+def test_every_three_demo_rotation_refutes_declared_query_changing_rivals():
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in (0, 7, 17):
+            cycle = [gen.generate(seed, index, difficulty=difficulty) for index in range(4)]
+            for query_index in range(4):
+                demos = [_pair(cycle[index]) for index in range(4) if index != query_index]
+                query = _pair(cycle[query_index])
+                assert gen.lesson_identifiable(demos, query) == []
+                assert len({gen.observe_overrides(pair["input"])["n_markers"] for pair in demos}) >= 2
+
+
+
+def test_default_schedule_never_shrinks_both_grid_dimensions():
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in (0, 7, 17, 99):
+            for index in range(8):
+                grid = gen.generate(seed, index, difficulty=difficulty)
+                output = gen.authoritative_output(grid)
+                assert not (
+                    len(output) < len(grid)
+                    and len(output[0]) < len(grid[0])
+                ), (difficulty, seed, index, (len(grid), len(grid[0])), (len(output), len(output[0])))
+
+def test_marker_colors_do_not_encode_the_scale_factor():
+    for start in range(4):
+        demos = [gen.generate(23, start + offset, difficulty="medium") for offset in range(3)]
+        facts = [_marker_color_counts(grid) for grid in demos]
+        assert any(n_markers != distinct_marker_colors for n_markers, distinct_marker_colors, _ in facts)
+        assert any(n_markers != distinct_nonzero_colors for n_markers, _, distinct_nonzero_colors in facts)
+
+
+def test_declared_override_values_are_exact_and_observable():
+    cases = (
+        {"grid_h": 4, "grid_w": 5, "template_size": 3, "n_markers": 2},
+        {"grid_h": 5, "grid_w": 5, "template_size": 3, "n_markers": 4},
+        {"grid_h": 5, "grid_w": 5, "template_size": 6, "n_markers": 4},
+        {"grid_h": 10, "grid_w": 12, "template_size": 6, "n_markers": 1},
+        {"grid_h": 7, "grid_w": 8, "template_size": 4, "n_markers": 2},
+    )
+    for index, overrides in enumerate(cases):
+        grid = gen.generate(101, index, difficulty="hard", **overrides)
+        observed = gen.observe_overrides(grid)
+        assert {name: observed[name] for name in overrides} == overrides
+        assert gen.self_check(grid) == []
