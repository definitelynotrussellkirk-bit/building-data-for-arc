+def _normalize_band(difficulty: Any) -> str:
+    if difficulty is None or difficulty == "medium":
+        return "medium"
+    if difficulty in ("easy", "hard"):
+        return str(difficulty)
+    raise ValueError("difficulty must be None, 'easy', 'medium', or 'hard'")
+
+
+def _validate_call(
+    seed: Any,
+    sample_index: Any,
+    difficulty: Any,
+    overrides: dict[str, Any],
+) -> str:
+    if type(seed) is not int:
+        raise TypeError("seed must be an integer (not bool)")
+    if type(sample_index) is not int or sample_index < 0:
+        raise TypeError("sample_index must be a nonnegative integer (not bool)")
+    band = _normalize_band(difficulty)
+    unknown = sorted(set(overrides) - set(AXES))
+    if unknown:
+        raise TypeError("unknown override(s): " + ", ".join(unknown))
+    bounds = {
+        "grid_h": (4, 10),
+        "grid_w": (5, 12),
+        "template_size": (3, 6),
+        "n_markers": (1, 4),
+    }
+    for label, (low, high) in bounds.items():
+        value = overrides.get(label)
+        if value is None:
+            continue
+        if type(value) is not int:
+            raise TypeError(f"{label} must be an integer (not bool)")
+        if not low <= value <= high:
+            raise ValueError(f"{label} must be in [{low}, {high}]")
+    return band
+
+
+def schedule_profile(seed: int, sample_index: int, difficulty: Any = None) -> str:
+    """Return the declared curriculum slot; seed affects layout, not the slot."""
+    if type(seed) is not int:
+        raise TypeError("seed must be an integer (not bool)")
+    if type(sample_index) is not int or sample_index < 0:
+        raise TypeError("sample_index must be a nonnegative integer (not bool)")
+    band = _normalize_band(difficulty)
+    return f"{band}:{SCHEDULE_PROFILES[sample_index % LESSON_SCHEDULE_PERIOD]}"
