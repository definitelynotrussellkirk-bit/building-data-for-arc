+def _scene_analysis(grid):
+    coerced, errors = _coerce_grid(grid)
+    if errors:
+        return coerced, None, errors
+    components = _components(coerced)
+    templates = [component for component in components if len(component["cells"]) > 1]
+    markers = [component for component in components if len(component["cells"]) == 1]
+    if len(templates) != 1:
+        errors.append(f"expected exactly one multi-cell template, found {len(templates)}")
+    if not 1 <= len(markers) <= 4:
+        errors.append(f"expected 1..4 singleton markers, found {len(markers)}")
+    if errors:
+        return coerced, None, errors
+
+    template = templates[0]
+    template_cells = template["cells"]
+    if not 3 <= len(template_cells) <= 6:
+        errors.append(f"template must contain 3..6 cells, found {len(template_cells)}")
+    if _fills_bbox(template_cells):
+        errors.append("template fills its bounding box")
+
+    height = len(coerced)
+    width = len(coerced[0])
+    marker_cells = [component["cells"][0] for component in markers]
+    for row, col in marker_cells:
