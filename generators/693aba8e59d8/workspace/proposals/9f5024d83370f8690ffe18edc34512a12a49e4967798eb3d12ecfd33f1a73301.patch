+def _independent_marker_set(candidates, count: int, rng):
+    ordered = list(candidates)
+    rng.shuffle(ordered)
+
+    def search(start: int, chosen: list[tuple[int, int]]):
+        if len(chosen) == count:
+            return tuple(chosen)
+        if len(ordered) - start < count - len(chosen):
+            return None
+        for index in range(start, len(ordered)):
+            cell = ordered[index]
+            if all(abs(cell[0] - row) + abs(cell[1] - col) != 1 for row, col in chosen):
+                chosen.append(cell)
+                result = search(index + 1, chosen)
+                if result is not None:
+                    return result
+                chosen.pop()
+        return None
+
+    return search(0, [])
