+
+    rows = [row for row, _ in template_cells]
+    cols = [col for _, col in template_cells]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    bbox_height = r1 - r0 + 1
+    bbox_width = c1 - c0 + 1
