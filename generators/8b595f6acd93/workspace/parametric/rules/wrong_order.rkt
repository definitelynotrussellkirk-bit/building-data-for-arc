(rule!
 (let ((dirs4 (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))
       (dirs8 (list (list -1 -1) (list -1 0) (list -1 1)
                    (list 0 -1)                 (list 0 1)
                    (list 1 -1)  (list 1 0)  (list 1 1))))
   (define (yellow-neighbors grid r c)
     (filter (lambda (d)
               (let ((rr (+ r (first d))) (cc (+ c (second d))))
                 (and (in-bounds? rr cc (rows grid) (cols grid))
                      (= (at grid rr cc) 4))))
             dirs8))
   (define paired-first
     (grid-from-fn
      (rows g) (cols g)
      (lambda (r c)
        (let ((v (at g r c)))
          (if (and (= v 4)
                   (= (length (yellow-neighbors g r c)) 1)
                   (let* ((d (first (yellow-neighbors g r c)))
                          (rr (+ r (first d)))
                          (cc (+ c (second d))))
                     (= (length (yellow-neighbors g rr cc)) 1)))
              8
              v)))))
   (define (plus-center? grid r c)
     (and (= (at grid r c) 0)
          (all? (lambda (d)
                  (let ((rr (+ r (first d))) (cc (+ c (second d))))
                    (and (in-bounds? rr cc (rows grid) (cols grid))
                         (= (at grid rr cc) 3))))
                dirs4)))
   (for*/fold ((out paired-first))
              ((r (in-range (rows paired-first)))
               (c (in-range (cols paired-first))))
     (if (plus-center? paired-first r c) (set-cell out r c 4) out))))
