(rule!
 (let ((dirs8 (list (list -1 -1) (list -1 0) (list -1 1)
                    (list 0 -1)                 (list 0 1)
                    (list 1 -1)  (list 1 0)  (list 1 1))))
   (define (uniform-nonzero-plus? grid r c)
     (and (= (at grid r c) 0)
          (> r 0) (< r (- (rows grid) 1))
          (> c 0) (< c (- (cols grid) 1))
          (let ((v (at grid (- r 1) c)))
            (and (!= v 0)
                 (= (at grid (+ r 1) c) v)
                 (= (at grid r (- c 1)) v)
                 (= (at grid r (+ c 1)) v)))))
   (define filled
     (for*/fold ((out g)) ((r (in-range (rows g))) (c (in-range (cols g))))
       (if (uniform-nonzero-plus? g r c) (set-cell out r c 4) out)))
   (define (yellow-neighbors grid r c)
     (filter (lambda (d)
               (let ((rr (+ r (first d))) (cc (+ c (second d))))
                 (and (in-bounds? rr cc (rows grid) (cols grid))
                      (= (at grid rr cc) 4))))
             dirs8))
   (grid-from-fn
    (rows filled) (cols filled)
    (lambda (r c)
      (let ((v (at filled r c)))
        (if (and (= v 4)
                 (= (length (yellow-neighbors filled r c)) 1)
                 (let* ((d (first (yellow-neighbors filled r c)))
                        (rr (+ r (first d)))
                        (cc (+ c (second d))))
                   (= (length (yellow-neighbors filled rr cc)) 1)))
            8
            v))))))
