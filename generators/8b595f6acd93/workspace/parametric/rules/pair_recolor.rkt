(rule!
 (let ((dirs4 (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))
       (dirs8 (list (list -1 -1) (list -1 0) (list -1 1)
                    (list 0 -1)                 (list 0 1)
                    (list 1 -1)  (list 1 0)  (list 1 1))))
   (define (plus-center? grid r c)
     (and (= (at grid r c) 0)
          (all? (lambda (d)
                  (let ((rr (+ r (first d))) (cc (+ c (second d))))
                    (and (in-bounds? rr cc (rows grid) (cols grid))
                         (= (at grid rr cc) 3))))
                dirs4)))
   (define filled
     (for*/fold ((out g)) ((r (in-range (rows g))) (c (in-range (cols g))))
       (if (plus-center? g r c) (set-cell out r c 4) out)))
   (define (yellow-neighbors grid r c)
     (filter (lambda (d)
               (let ((rr (+ r (first d))) (cc (+ c (second d))))
                 (and (in-bounds? rr cc (rows grid) (cols grid))
                      (= (at grid rr cc) 4))))
             dirs8))
   (grid-from-fn
    (rows filled) (cols filled)
    (lambda (r c)
      (let ((v (at filled r c)))
        (if (and (= v 4)
                 (= (length (yellow-neighbors filled r c)) 1)
                 (let* ((d (first (yellow-neighbors filled r c)))
                        (rr (+ r (first d)))
                        (cc (+ c (second d))))
                   (= (length (yellow-neighbors filled rr cc)) 1)))
            8
            v))))))
