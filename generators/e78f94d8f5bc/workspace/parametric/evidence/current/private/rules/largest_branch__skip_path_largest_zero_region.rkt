(rule! (lambda (g)
  (let* ((pts (find-color g 2))
         (p1 (first pts))
         (p2 (second pts))
         (r1 (fst p1)) (c1 (snd p1))
         (r2 (fst p2)) (c2 (snd p2))
         (filled g)
         (regions (find-0-regions g 0))
         (chosen (pick-max regions length))
         (marked (if chosen (recolor-cells g chosen 8) g)))
    (set-cell (set-cell marked r1 c1 2) r2 c2 2))))