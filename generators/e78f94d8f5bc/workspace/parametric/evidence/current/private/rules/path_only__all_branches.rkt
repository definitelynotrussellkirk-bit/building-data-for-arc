(rule! (lambda (g)
  (let* ((pts (find-color g 2))
         (p1 (first pts))
         (p2 (second pts))
         (r1 (fst p1)) (c1 (snd p1))
         (r2 (fst p2)) (c2 (snd p2))
         (filled (shortest-path-fill g r1 c1 r2 c2 4 0))
         (marked (recolor filled 0 8)))
    (set-cell (set-cell marked r1 c1 2) r2 c2 2))))