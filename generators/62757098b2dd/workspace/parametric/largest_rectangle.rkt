(rule! (lambda (g)
  (let* ((h (rows g))
         (w (cols g))
         (objs (objects (grid-from-fn h w (lambda (r c) (if (= (cell-at g r c) 5) 5 0))) 0))
         (anchor (argmax (lambda (obj) (length (obj-cells obj))) objs))
         (anchor-cells (obj-cells anchor))
         (anchor-rs (map first anchor-cells))
         (anchor-cs (map second anchor-cells))
         (ar1 (apply min anchor-rs))
         (ac1 (apply min anchor-cs))
         (ar2 (apply max anchor-rs))
         (ac2 (apply max anchor-cs))
         (atl (cell-at g (- ar1 1) (- ac1 1)))
         (atr (cell-at g (- ar1 1) (+ ac2 1)))
         (abl (cell-at g (+ ar2 1) (- ac1 1)))
         (abr (cell-at g (+ ar2 1) (+ ac2 1)))
         (result (make-hash)))
    (for* ((r (range 0 h)) (c (range 0 w)))
      (hash-set! result (list r c) (cell-at g r c)))
    (for ((obj objs))
      (let* ((cells (obj-cells obj))
             (rs (map first cells))
             (cs (map second cells))
             (fr1 (apply min rs))
             (fc1 (apply min cs))
             (fr2 (apply max rs))
             (fc2 (apply max cs))
             (fh (+ 1 (- fr2 fr1)))
             (fw (+ 1 (- fc2 fc1)))
             (mid-r (+ fr1 (quotient fh 2)))
             (mid-c (+ fc1 (quotient fw 2))))
        (hash-set! result (list (- fr1 1) (- fc1 1)) 0)
        (hash-set! result (list (- fr1 1) (+ fc2 1)) 0)
        (hash-set! result (list (+ fr2 1) (- fc1 1)) 0)
        (hash-set! result (list (+ fr2 1) (+ fc2 1)) 0)
        (for* ((r (range fr1 (+ fr2 1))) (c (range fc1 (+ fc2 1))))
          (hash-set! result (list r c)
            (cond
              ((and (< r mid-r) (< c mid-c)) atl)
              ((and (< r mid-r) (>= c mid-c)) atr)
              ((and (>= r mid-r) (< c mid-c)) abl)
              (else abr))))))
    (grid-from-fn h w (lambda (r c) (hash-ref result (list r c) 0))))))
