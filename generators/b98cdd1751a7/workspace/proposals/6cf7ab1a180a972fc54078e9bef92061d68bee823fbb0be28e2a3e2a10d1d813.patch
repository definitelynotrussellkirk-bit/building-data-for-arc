+
+def extract(grid):
+    rows = [row for row in range(1, len(grid)) if grid[row][0] == 8]
+    cols = [col for col in range(1, len(grid[0])) if grid[0][col] == 8]
+    return [[grid[row][col] for col in cols] for row in rows]
+
+
+def canonical_program():
+    rows = []
+    for line in canonical_path(ROOT).read_text(encoding="utf-8").splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            rows.append(row)
+    assert len(rows) == 1
+    return rows[0]["program_solution"]
+
+
+def racket_apply(bridge, program, grid):
+    bridge.define_grid("g", grid)
+    return bridge.eval_text(f"({wrap_rule(program)} g)")
+
+
+def test_canonical_inputs_are_admitted_and_labels_remain_exact():
+    pairs = canonical_pairs(TASK_ID, root=ROOT, labeled_only=True)
+    assert len(pairs) == 5
+    program = canonical_program()
+    with RacketBridge() as bridge:
+        assert bridge.runtime_identity["protected"] is True
+        for pair in pairs:
+            assert MODULE.self_check(pair["input"]) == []
+            assert extract(pair["input"]) == pair["output"]
+            assert racket_apply(bridge, program, pair["input"]) == pair["output"]
+
+
+def test_ordinary_distribution_teaches_one_marker_branches_and_interior_eight():
+    single_row = single_col = selected_eight = 0
+    total = 0
+    for band_index, band in enumerate(("easy", "medium", "hard")):
+        for index in range(160):
+            grid = MODULE.generate(20_000 + band_index, index, difficulty=band)
+            assert MODULE.self_check(grid) == []
+            rows, cols = marker_counts(grid)
+            single_row += rows == 1
+            single_col += cols == 1
+            selected_eight += any(value == 8 for row in extract(grid) for value in row)
+            total += 1
+    assert single_row >= 35
+    assert single_col >= 35
+    assert selected_eight >= total // 3
+
+
+def test_exact_boundary_overrides_are_honored_and_observable():
+    small = MODULE.generate(
+        1, 2, grid_h=5, grid_w=5, n_row_markers=1, n_col_markers=1,
+        palette_size=2, include_eight=True,
+    )
+    assert (len(small), len(small[0])) == (5, 5)
+    assert marker_counts(small) == (1, 1)
+    assert extract(small) == [[8]]
+
+    large = MODULE.generate(
+        3, 4, grid_h=16, grid_w=16, n_row_markers=6, n_col_markers=6,
+        palette_size=8, include_eight=False,
+    )
+    assert (len(large), len(large[0])) == (16, 16)
+    assert marker_counts(large) == (6, 6)
+    assert all(value != 8 for row in extract(large) for value in row)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"surprise_unknown_control": True},
+        {"palette_kind": "warm"},
+        {"grid_h": True},
+        {"n_row_markers": 0},
+        {"n_col_markers": 7},
+        {"palette_size": 1},
+        {"include_eight": 1},
+    ],
+)
+def test_invalid_or_undeclared_controls_fail_closed(kwargs):
+    with pytest.raises((TypeError, ValueError)):
+        MODULE.generate(0, 0, **kwargs)
+
+
+def test_invalid_difficulty_fails_closed():
+    with pytest.raises(ValueError):
+        MODULE.generate(0, 0, difficulty="bogus")
+
+
+def test_determinism_fresh_returns_and_global_rng_isolation():
+    random.seed(123456)
+    state = random.getstate()
+    first = MODULE.generate(91, 7, difficulty="hard")
+    assert random.getstate() == state
+    second = MODULE.generate(91, 7, difficulty="hard")
+    assert first == second and first is not second and first[0] is not second[0]
+    original = second[0][0]
+    first[0][0] = 9
+    assert second[0][0] == original
