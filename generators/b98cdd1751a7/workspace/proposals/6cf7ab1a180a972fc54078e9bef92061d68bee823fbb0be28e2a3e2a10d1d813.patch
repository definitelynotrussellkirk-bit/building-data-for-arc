+"""Proposed semantic repair for ARC task 3f600d3093b8.
+
+Rows marked by color 8 in column zero and columns marked by color 8 in row
+zero select an interior submatrix.  This proposal covers the canonical
+one-marker cases and deliberately uses 8 as ordinary interior data.
+
+This file is a nonselected owner-integration proposal.  Production remains
+``../../generator.py`` until the owner reviews and accepts this source.
+"""
+from __future__ import annotations
+
+from puzzle_generators.base import gen_ctx
+from puzzle_generators.helpers.grid import full_grid
+
+
+GENERATOR_ID = "3f600d3093b8"
+TASK_ID = "3f600d3093b8"
+VERSION = "2.1.0-proposal"
+SUMMARY = (
+    "Mark one to six rows in column 0 and one to six columns in row 0 with "
+    "color 8; fill the interior from a controllable palette that may include "
+    "8 as ordinary data. The rule extracts the marked-row × marked-column "
+    "submatrix in ascending index order."
+)
+INVARIANTS = [
+    "the rectangular ARC grid has at least one marked row and one marked column",
+    "row markers are exactly the color-8 cells in column zero below the header",
+    "column markers are exactly the color-8 cells in row zero right of the header",
+    "interior color 8 is legal data and is not interpreted as a marker",
+]
+AXES = {
+    "grid_h": {"type": "int", "default": "difficulty-skewed 5..16", "valid": "5..16"},
+    "grid_w": {"type": "int", "default": "difficulty-skewed 5..16", "valid": "5..16"},
+    "n_row_markers": {"type": "int", "default": "difficulty-skewed 1..6", "valid": "1..6"},
+    "n_col_markers": {"type": "int", "default": "difficulty-skewed 1..6", "valid": "1..6"},
+    "palette_size": {"type": "int", "default": "difficulty-skewed 2..8", "valid": "2..8"},
+    "include_eight": {"type": "bool", "default": "rng false|true", "valid": "false|true"},
+}
+
+_ALLOWED_DIFFICULTIES = (None, "easy", "medium", "hard")
+_INT_OVERRIDES = {"grid_h", "grid_w", "n_row_markers", "n_col_markers", "palette_size"}
+
+
+def _validate_controls(difficulty, overrides):
+    if difficulty not in _ALLOWED_DIFFICULTIES:
+        raise ValueError("difficulty must be None, easy, medium, or hard")
+    unknown = set(overrides) - set(AXES)
+    if unknown:
+        raise ValueError("unknown overrides: " + ", ".join(sorted(unknown)))
+    for name in _INT_OVERRIDES:
+        if name in overrides and overrides[name] is not None and type(overrides[name]) is not int:
+            raise TypeError(f"{name} must be an exact integer")
+    if ("include_eight" in overrides and overrides["include_eight"] is not None
+            and type(overrides["include_eight"]) is not bool):
+        raise TypeError("include_eight must be a Boolean")
+
+
+def self_check(grid, *, difficulty=None, meta=None) -> list[str]:
+    """Accept every lawful nonempty extraction, including one-marker cases."""
+    if type(grid) is not list or not grid or type(grid[0]) is not list or not grid[0]:
+        return ["grid must be a nonempty list of nonempty rows"]
+    height, width = len(grid), len(grid[0])
+    errors = []
+    if not (1 <= height <= 30 and 1 <= width <= 30):
+        errors.append(f"grid dimensions must be in 1..30, got {height}x{width}")
+    if any(type(row) is not list or len(row) != width for row in grid):
+        return errors + ["grid must be rectangular"]
+    if any(type(value) is not int or not 0 <= value <= 9 for row in grid for value in row):
+        errors.append("cells must be exact ARC color integers 0..9")
+        return errors
+    row_markers = [row for row in range(1, height) if grid[row][0] == 8]
+    col_markers = [col for col in range(1, width) if grid[0][col] == 8]
+    if not row_markers:
+        errors.append("expected at least one row marker in column zero")
+    if not col_markers:
+        errors.append("expected at least one column marker in row zero")
+    return errors
+
+
+def generate(seed, sample_index, *, difficulty=None, **overrides):
+    _validate_controls(difficulty, overrides)
+    ctx = gen_ctx(
+        seed=seed,
+        sample_index=sample_index,
+        version=VERSION,
+        task_id=TASK_ID,
+        difficulty=difficulty,
+        overrides=overrides,
+    )
+    height = ctx.draw_int_diff("grid_h", 5, 16)
+    width = ctx.draw_int_diff("grid_w", 5, 16)
+    n_rows = ctx.draw_int_diff("n_row_markers", 1, min(6, height - 1))
+    n_cols = ctx.draw_int_diff("n_col_markers", 1, min(6, width - 1))
+    palette_size = ctx.draw_int_diff("palette_size", 2, 8)
+    include_eight = ctx.draw_choice("include_eight", (False, True))
+
+    placement = ctx.draw_rng("placement")
+    row_markers = sorted(placement.sample(range(1, height), n_rows))
+    col_markers = sorted(placement.sample(range(1, width), n_cols))
+
+    grid = full_grid(height, width, 0)
+    for row in row_markers:
+        grid[row][0] = 8
+    for col in col_markers:
+        grid[0][col] = 8
+
+    if include_eight:
+        rest = ctx.draw_distinct_colors(
+            "palette", n=palette_size - 1, exclude={0, 8}
+        )
+        palette = (8, *rest)
+    else:
+        palette = ctx.draw_distinct_colors("palette", n=palette_size, exclude={0, 8})
+
+    content = ctx.draw_rng("content")
+    for row in range(1, height):
+        for col in range(1, width):
+            if content.random() < 0.5:
+                grid[row][col] = content.choice(palette)
+
+    # Make the previously missing branch constructive rather than relying on
+    # a low-probability random intersection.
+    if include_eight:
+        grid[row_markers[0]][col_markers[0]] = 8
+    return grid
