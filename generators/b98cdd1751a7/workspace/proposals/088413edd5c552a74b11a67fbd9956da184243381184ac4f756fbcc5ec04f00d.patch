+"""Reproducible bounded self-audit for the b98cdd1751a7 parametric family.
+
+This tool executes the Python adapter only. Native qualification independently
+replays every retained label through protected Racket.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+
+HERE = Path(__file__).resolve().parent
+TASK_ID = "b98cdd1751a7"
+SCHEMA = f"{TASK_ID}-parametric-self-audit-v1"
+DEFAULT_SEEDS = (0, 17, 29)
+DEFAULT_DEMOS = (2, 3, 6)
+
+
+def _load_adapter():
+    source = HERE / "adapter.py"
+    spec = importlib.util.spec_from_file_location(f"{TASK_ID}_audit_adapter", source)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load adapter: {source}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _freeze(grid):
+    return tuple(tuple(row) for row in grid)
+
+
+def _inputs(episode):
+    return [pair["input"] for pair in episode["train"] + episode["test"]]
+
+
+def _validate_exact_ints(values, name, low, high):
+    result = tuple(values)
+    if not result or any(type(value) is not int or not low <= value <= high for value in result):
+        raise ValueError(f"{name} must contain exact integers in {low}..{high}")
+    if len(set(result)) != len(result):
+        raise ValueError(f"{name} must be distinct")
+    return result
+
+
+def build_report(*, seeds=DEFAULT_SEEDS, demo_counts=DEFAULT_DEMOS):
+    """Return a deterministic finite audit report for declared settings/counts."""
+    adapter = _load_adapter()
+    seeds = _validate_exact_ints(seeds, "seeds", 0, adapter.MAX_SEED)
+    demo_counts = _validate_exact_ints(
+        demo_counts, "demo_counts", adapter.MIN_DEMOS, adapter.MAX_DEMOS
+    )
+
+    cases = []
+    matched_input_groups = 0
+    for seed in seeds:
+        for demos in demo_counts:
+            episodes = {
+                order: adapter.generate(seed, {"within_group_order": order}, demos, 4)
+                for order in adapter.ORDERS
+            }
+            reference_inputs = _inputs(episodes[adapter.ORDERS[0]])
+            if any(_inputs(episode) != reference_inputs for episode in episodes.values()):
+                raise AssertionError("settings did not receive matched inputs")
+            matched_input_groups += 1
+
+            distinct_inputs = len({_freeze(grid) for grid in reference_inputs})
+            for order, episode in episodes.items():
+                audit = adapter.audit_episode(episode, order)
+                dependency_grid = episode["train"][0]["input"]
+                expected = adapter.solve(dependency_grid, order)
+                counterfactual = adapter.solve_with_literal_canvas_midpoint(
+                    dependency_grid, order
+                )
+                cases.append(
+                    {
+                        "seed": seed,
+                        "demos": demos,
+                        "settings": {"within_group_order": order},
+                        "input_count": len(reference_inputs),
+                        "distinct_input_count": distinct_inputs,
+                        "query_count": len(episode["test"]),
+                        "query_shapes": [
+                            [len(pair["input"]), len(pair["input"][0])]
+                            for pair in episode["test"]
+                        ],
+                        "setting_survivors": audit["setting_survivors"],
+                        "rivals_tested": audit["rivals_tested"],
+                        "surviving_rivals": audit["surviving_rivals"],
+                        "ambiguous_query_rivals": audit["ambiguous_query_rivals"],
+                        "causal_midpoint_counterexample": expected != counterfactual,
+                        "dependency_intermediate": adapter.dependency_intermediate(
+                            dependency_grid, order
+                        ),
+                    }
+                )
+
+    checks = {
+        "episodes": len(cases),
+        "matched_input_groups": matched_input_groups,
+        "all_settings_identified": all(
+            case["setting_survivors"]
+            == [case["settings"]["within_group_order"]]
+            for case in cases
+        ),
+        "all_declared_rivals_rejected": all(
+            not case["surviving_rivals"] for case in cases
+        ),
+        "all_inputs_distinct": all(
+            case["input_count"] == case["distinct_input_count"] for case in cases
+        ),
+        "all_query_counts_four": all(case["query_count"] == 4 for case in cases),
+        "all_have_exact_30x30_query": all(
+            [30, 30] in case["query_shapes"] for case in cases
+        ),
+        "all_have_causal_midpoint_counterexample": all(
+            case["causal_midpoint_counterexample"] for case in cases
+        ),
+    }
+    if not all(value is True for key, value in checks.items() if key.startswith("all_")):
+        raise AssertionError(f"self-audit failed: {checks}")
+
+    source_files = [
+        HERE / "adapter.py",
+        HERE / "promotion.json",
+        HERE / "fewest_cells_first.rkt",
+        HERE / "fewest_cells_canvas_midpoint.rkt",
+        Path(adapter.ROOT) / f"generators/{TASK_ID}/generator.py",
+    ]
+    return {
+        "schema": SCHEMA,
+        "task_id": TASK_ID,
+        "verification_scope": (
+            "Finite Python adapter self-audit only; native qualification separately "
+            "replays labels through protected Racket."
+        ),
+        "seeds": list(seeds),
+        "demo_counts": list(demo_counts),
+        "settings": [
+            {"within_group_order": order} for order in adapter.ORDERS
+        ],
+        "source_files": [
+            {
+                "path": path.relative_to(adapter.ROOT).as_posix(),
+                "sha256": _sha256(path),
+            }
+            for path in source_files
+        ],
+        "checks": checks,
+        "cases": cases,
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed", type=int, action="append", dest="seeds")
+    parser.add_argument("--demos", type=int, action="append", dest="demo_counts")
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args(argv)
+    report = build_report(
+        seeds=DEFAULT_SEEDS if args.seeds is None else args.seeds,
+        demo_counts=DEFAULT_DEMOS if args.demo_counts is None else args.demo_counts,
+    )
+    payload = json.dumps(
+        report, sort_keys=True, separators=(",", ":"), ensure_ascii=False
+    ) + "\n"
+    if args.out is None:
+        sys.stdout.write(payload)
+    else:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        if args.out.exists() or args.out.is_symlink():
+            raise FileExistsError(args.out)
+        args.out.write_text(payload, encoding="utf-8")
+        print(args.out)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
