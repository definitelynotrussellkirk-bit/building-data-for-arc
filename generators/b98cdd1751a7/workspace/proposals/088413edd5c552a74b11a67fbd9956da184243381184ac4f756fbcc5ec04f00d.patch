+"""Focused semantic and adversarial regressions for generator ad8f89160989."""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+import random
+import sys
+
+import pytest
+
+
+TASK_ID = "ad8f89160989"
+LIBRARY = next(
+    path for path in Path(__file__).resolve().parents
+    if (path / "shared/runtime").is_dir()
+)
+sys.path.insert(0, str(LIBRARY / "shared/runtime"))
+
+from reviewer_support import canonical_path, find_root, load_selected_generator  # noqa: E402
+
+ROOT = find_root(__file__)
+MODULE, SOURCE, SOURCE_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _canonical_row():
+    rows = [
+        json.loads(line)
+        for line in canonical_path(ROOT).read_text(encoding="utf-8").splitlines()
+        if json.loads(line).get("task_id") == TASK_ID
+    ]
+    assert len(rows) == 1
+    return rows[0]
+
+
+def _normalized_hash(source):
+    return hashlib.sha256(" ".join(source.split()).encode()).hexdigest()[:12]
+
+
+def _grid(value):
+    """Expand the canonical JSONL's compact string rows to ARC integer rows."""
+    if value and all(isinstance(row, str) for row in value):
+        return [[int(cell) for cell in row] for row in value]
+    return copy.deepcopy(value)
+
+
+def _seeds(grid):
+    return [
+        (row, col, value)
+        for row, line in enumerate(grid)
+        for col, value in enumerate(line)
+        if value != 0
+    ]
+
+
+def _oracle(grid):
+    output = copy.deepcopy(grid)
+    height, width = len(grid), len(grid[0])
+    seeds = [(row, col) for row, col, _ in _seeds(grid)]
+    for row, col in seeds:
+        for drow, dcol in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            rr, cc = row + drow, col + dcol
+            if 0 <= rr < height and 0 <= cc < width and output[rr][cc] == 0:
+                output[rr][cc] = 8
+    return output
+
+
+def test_metadata_and_canonical_authority_are_exact():
+    row = _canonical_row()
+    assert MODULE.VERSION == "3.0.0"
+    assert MODULE.RULE_HASH == _normalized_hash(row["program_solution"]) == "fcdfc7c3b2ca"
+    assert tuple(MODULE.SCENE_PROFILES) == ("interior", "edge", "corner", "mixed")
+    assert tuple(MODULE.AXES) == ("grid_h", "grid_w", "n_seeds", "scene_profile", "texture")
+
+
+def test_every_canonical_pair_matches_independent_oracle_and_mirror():
+    row = _canonical_row()
+    for pair in list(row["train"]) + list(row["test"]):
+        grid = _grid(pair["input"])
+        expected = _grid(pair["output"])
+        before = copy.deepcopy(grid)
+        assert MODULE.self_check(grid) == []
+        assert MODULE.observe_overrides(grid)["scene_profile"] == "interior"
+        assert MODULE.rule_mirror(grid) == expected == _oracle(grid)
+        assert grid == before
+
+
+@pytest.mark.parametrize("difficulty", ["easy", "medium", "hard"])
+@pytest.mark.parametrize("profile", ["interior", "edge", "corner", "mixed"])
+def test_forced_profiles_are_constructive_effectful_and_observable(difficulty, profile):
+    seen = set()
+    for seed in range(24):
+        grid = MODULE.generate(
+            seed,
+            seed * 31 + 7,
+            difficulty=difficulty,
+            scene_profile=profile,
+        )
+        assert MODULE.self_check(
+            grid,
+            difficulty=difficulty,
+            meta={"overrides": {"scene_profile": profile}},
+        ) == []
+        facts = MODULE.observe_overrides(grid)
+        assert facts["scene_profile"] == profile
+        assert 2 <= facts["n_seeds"] <= 4
+        assert MODULE.rule_mirror(grid) == _oracle(grid) != grid
+        seeds = _seeds(grid)
+        assert len({color for _, _, color in seeds}) == len(seeds)
+        assert all(
+            abs(r1 - r2) + abs(c1 - c2) >= 3
+            for index, (r1, c1, _) in enumerate(seeds)
+            for r2, c2, _ in seeds[index + 1 :]
+        )
+        seen.add(tuple(map(tuple, grid)))
+    assert len(seen) >= 22
+
+
+def test_default_distribution_covers_all_profiles_and_boundary_clipping():
+    profiles = set()
+    clipped = {"edge": False, "corner": False}
+    for index in range(320):
+        grid = MODULE.generate(7000 + index, index * 17 + 5)
+        profile = MODULE.observe_overrides(grid)["scene_profile"]
+        profiles.add(profile)
+        if profile in clipped:
+            output = MODULE.rule_mirror(grid)
+            seeds = _seeds(grid)
+            painted = sum(value == 8 for row in output for value in row)
+            if painted < 4 * len(seeds):
+                clipped[profile] = True
+    assert profiles == set(MODULE.SCENE_PROFILES)
+    assert clipped == {"edge": True, "corner": True}
+
+
+def test_checker_rejects_invariant_violations_and_is_input_pure():
+    valid = MODULE.generate(11, 13, scene_profile="interior", n_seeds=3)
+    before = copy.deepcopy(valid)
+    assert MODULE.self_check(valid) == []
+    assert valid == before
+
+    ragged = copy.deepcopy(valid)
+    ragged[0].pop()
+    boolean = copy.deepcopy(valid)
+    boolean[0][0] = True
+    color8 = copy.deepcopy(valid)
+    color8[0][0] = 8
+    one_seed = [[0] * 7 for _ in range(7)]
+    one_seed[3][3] = 2
+    duplicate_colors = [[0] * 7 for _ in range(7)]
+    duplicate_colors[1][1] = duplicate_colors[5][5] = 2
+    too_close = [[0] * 7 for _ in range(7)]
+    too_close[2][2], too_close[2][4] = 2, 3
+    invalid_color = copy.deepcopy(valid)
+    invalid_color[0][0] = 5
+
+    for mutation in (ragged, boolean, color8, one_seed, duplicate_colors, too_close, invalid_color):
+        assert MODULE.self_check(mutation), mutation
+        with pytest.raises(ValueError):
+            MODULE.rule_mirror(mutation)
+
+
+def test_degenerate_textures_remain_explicit_audit_only_cases():
+    for texture in MODULE.DEGENERATE_TEXTURES:
+        grid = MODULE.generate(0, 0, texture=texture)
+        assert MODULE.self_check(grid, meta={"overrides": {"texture": texture}}) == []
+        assert MODULE.self_check(grid)
+
+
+def test_invalid_controls_fail_closed():
+    with pytest.raises(ValueError):
+        MODULE.generate(0, 0, difficulty="extreme")
+    with pytest.raises(ValueError):
+        MODULE.generate(0, 0, scene_profile="unknown")
+    with pytest.raises((TypeError, ValueError)):
+        MODULE.generate(0, 0, n_seeds=True)
+    with pytest.raises(ValueError):
+        MODULE.generate(0, 0, mystery="x")
+    with pytest.raises(ValueError):
+        MODULE.generate(0, 0, texture="unknown")
+
+
+def test_determinism_fresh_returns_and_global_rng_isolation():
+    random.seed(20261024)
+    state = random.getstate()
+    first = MODULE.generate(71, 89, difficulty="hard", scene_profile="mixed")
+    assert random.getstate() == state
+    second = MODULE.generate(71, 89, difficulty="hard", scene_profile="mixed")
+    assert first == second
+    assert first is not second
+    assert all(left is not right for left, right in zip(first, second))
+    snapshot = copy.deepcopy(first)
+    first[0][0] = (first[0][0] + 1) % 10
+    assert MODULE.generate(71, 89, difficulty="hard", scene_profile="mixed") == snapshot
+
+
+def _load_audit_tool():
+    path = ROOT / "generators" / TASK_ID / "workspace" / "adversarial_review.py"
+    assert path.is_file(), "adversarial review tool is missing"
+    spec = __import__("importlib.util").util.spec_from_file_location(
