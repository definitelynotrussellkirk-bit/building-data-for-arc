+"""Native contract and teaching checks for row-group assembly ordering."""
+from __future__ import annotations
+
+from copy import deepcopy
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+import pytest
+
+
+TASK_ID = "b98cdd1751a7"
+HOME = Path(__file__).resolve().parents[1]
+LIBRARY = next(
+    path for path in Path(__file__).resolve().parents
+    if (path / "shared/runtime").is_dir()
+)
+sys.path.insert(0, str(LIBRARY / "shared/runtime"))
+
+from reviewer_support import (  # noqa: E402
+    canonical_path,
+    find_root,
+    public_challenge_bytes,
+    public_challenge_id,
+)
+
+SOURCE = HOME / "workspace" / "parametric" / "adapter.py"
+AUDIT_SOURCE = HOME / "workspace" / "parametric" / "audit.py"
+
+
+def _load_adapter():
+    assert SOURCE.is_file(), f"missing native adapter: {SOURCE}"
+    spec = importlib.util.spec_from_file_location("tested_b98_parametric", SOURCE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _load_audit():
+    assert AUDIT_SOURCE.is_file(), f"missing self-audit tool: {AUDIT_SOURCE}"
+    spec = importlib.util.spec_from_file_location("tested_b98_parametric_audit", AUDIT_SOURCE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture(scope="module")
+def adapter():
+    return _load_adapter()
+
+
+def _canonical_program():
+    with canonical_path(find_root(__file__)).open(encoding="utf-8") as stream:
+        rows = [row for row in map(json.loads, stream) if row.get("task_id") == TASK_ID]
+    assert len(rows) == 1
+    return rows[0]["program_solution"]
+
+
+def _all_inputs(episode):
+    return [pair["input"] for pair in episode["train"] + episode["test"]]
+
+
+def _freeze(grid):
+    return tuple(map(tuple, grid))
+
+
+
+def test_self_audit_tool_records_matched_inputs_rivals_and_causal_cases():
+    audit = _load_audit()
+    report = audit.build_report(seeds=(0, 17), demo_counts=(2, 3))
+    assert report["schema"] == "b98cdd1751a7-parametric-self-audit-v1"
+    assert report["task_id"] == TASK_ID
+    assert report["checks"] == {
+        "episodes": 8,
+        "matched_input_groups": 4,
+        "all_settings_identified": True,
+        "all_declared_rivals_rejected": True,
+        "all_inputs_distinct": True,
+        "all_query_counts_four": True,
+        "all_have_exact_30x30_query": True,
+        "all_have_causal_midpoint_counterexample": True,
+    }
+    assert len(report["cases"]) == 8
+    assert all(case["surviving_rivals"] == [] for case in report["cases"])
+    assert all(case["query_shapes"][-1] == [30, 30] for case in report["cases"])
+
+
+def test_default_program_is_exact_canonical_and_alternative_is_distinct(adapter):
+    canonical = adapter.program({"within_group_order": "left_to_right"})
+    sparse = adapter.program({"within_group_order": "fewest_cells_first"})
+    assert canonical == _canonical_program()
+    assert sparse != canonical
+    assert canonical.strip().startswith("(rule!")
+    assert sparse.strip().startswith("(rule!")
+
+
+@pytest.mark.parametrize("seed", [0, 17, 2**63 - 1])
+@pytest.mark.parametrize("demos", [2, 3, 6])
+def test_counts_matched_inputs_distinctness_and_setting_identification(adapter, seed, demos):
+    episodes = {
+        order: adapter.generate(seed, {"within_group_order": order}, demos, 4)
+        for order in adapter.ORDERS
+    }
+    common_inputs = _all_inputs(episodes["left_to_right"])
+    assert len(common_inputs) == demos + 4
+    assert len({_freeze(grid) for grid in common_inputs}) == demos + 4
+    assert all(_all_inputs(episode) == common_inputs for episode in episodes.values())
+    for selected, episode in episodes.items():
+        assert len(episode["train"]) == demos
+        assert len(episode["test"]) == 4
+        assert episode["program_solution"] == adapter.program({"within_group_order": selected})
+        survivors = [
+            candidate
+            for candidate in adapter.ORDERS
+            if all(
+                adapter.solve(pair["input"], candidate) == pair["output"]
+                for pair in episode["train"]
+            )
+        ]
+        assert survivors == [selected]
+
+
+@pytest.mark.parametrize("selected", ["left_to_right", "fewest_cells_first"])
+def test_first_two_demos_reject_declared_shortcuts(adapter, selected):
+    for seed in (0, 17, 29):
+        episode = adapter.generate(seed, {"within_group_order": selected}, 2, 4)
+        audit = adapter.audit_episode(episode, selected)
+        assert audit["setting_survivors"] == [selected]
+        assert audit["surviving_rivals"] == []
+        assert audit["ambiguous_query_rivals"] == []
+
+
+def test_query_set_has_four_size_profiles_and_substantive_30x30_dependency_case(adapter):
+    episode = adapter.generate(23, {"within_group_order": "fewest_cells_first"}, 3, 4)
+    queries = episode["test"]
+    shapes = [(len(pair["input"]), len(pair["input"][0])) for pair in queries]
+    assert len(set(shapes)) == 4
+    assert shapes[-1] == (30, 30)
+    grid = queries[-1]["input"]
+    facts = adapter.analyze(grid)
+    assert facts["canonical_group_sizes"] == [2, 2]
+    assert facts["literal_canvas_group_sizes"] in ([0, 4], [4, 0])
+    rows = [row for row, line in enumerate(grid) if any(line)]
+    cols = [col for col in range(30) if any(grid[row][col] for row in range(30))]
+    assert max(rows) - min(rows) >= 8
+    assert max(cols) - min(cols) >= 20
+    assert sum(value != 0 for line in grid for value in line) >= 18
+
+
+def test_dependency_intermediate_drives_second_stage_and_wrong_intermediate_changes_output(adapter):
+    grid = adapter.generate(0, {"within_group_order": "fewest_cells_first"}, 2, 4)["train"][0]["input"]
+    record = adapter.dependency_intermediate(grid, "fewest_cells_first")
+    assert record["group_sizes"] == [2, 2]
+    assert record["ordered_cell_counts"] == [sorted(counts) for counts in record["group_cell_counts"]]
+    assert record["canonical_midpoint"] != record["literal_canvas_midpoint"]
+    expected = adapter.solve(grid, "fewest_cells_first")
+    wrong = adapter.solve_with_literal_canvas_midpoint(grid, "fewest_cells_first")
+    assert wrong != expected
+
+
+def test_public_projection_uses_same_first_query_and_ignores_private_fields(adapter):
+    episode = adapter.generate(17, {"within_group_order": "left_to_right"}, 3, 4)
+    repeated = adapter.generate(17, {"within_group_order": "left_to_right"}, 3, 4)
+    before = deepcopy(episode)
+    first = adapter.public_turn(episode, 0)
+    assert first == adapter.public_turn(repeated, 0)
+    assert set(first) == {"train", "test"}
+    assert len(first["test"]) == 1 and set(first["test"][0]) == {"input"}
+    private = deepcopy(episode)
+    private.update(seed=999, settings={"secret": True}, program_solution="changed")
+    for pair in private["test"]:
+        pair["output"] = [[9]]
+    assert public_challenge_bytes(episode) == public_challenge_bytes(private)
+    assert public_challenge_id(episode) == public_challenge_id(private)
+    assert adapter.public_turn(private, 0) == first
+    assert episode == before
+
+
+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda adapter: adapter.program({}),
+        lambda adapter: adapter.program({"within_group_order": "unknown"}),
+        lambda adapter: adapter.generate(True, {"within_group_order": "left_to_right"}, 3, 4),
+        lambda adapter: adapter.generate(-1, {"within_group_order": "left_to_right"}, 3, 4),
+        lambda adapter: adapter.generate(0, {"within_group_order": "left_to_right"}, 1, 4),
+        lambda adapter: adapter.generate(0, {"within_group_order": "left_to_right"}, 7, 4),
+        lambda adapter: adapter.generate(0, {"within_group_order": "left_to_right"}, 3, 1),
+        lambda adapter: adapter.generate(0, {"within_group_order": "left_to_right"}, 3, 5),
+        lambda adapter: adapter.public_turn(
+            {"train": [{"input": [[0]], "output": [[0]]}], "test": [{"input": [[0]], "output": [[0]]}]},
+            True,
+        ),
+    ],
+)
+def test_invalid_contract_values_fail_closed(adapter, call):
+    with pytest.raises((TypeError, ValueError)):
+        call(adapter)
