+#!/usr/bin/env python3
+"""Reproducible adversarial and protected-Racket audit for ad8f89160989.
+
+The pure portion is importable by task-local tests.  The CLI additionally runs
+all retained inputs through the protected canonical Racket rule with
+``allow_unapproved=True``; that produces audit evidence only and never grants
+approval or admits training data.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+
+TASK_ID = "ad8f89160989"
+SCHEMA = "arcpuzzles-adversarial-review-v1"
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+CASE_SPECS = (
+    # profile, seed, sample index, height, width, seed count
+    ("interior", 101, 1001, 7, 7, 2),
+    ("interior", 102, 1002, 8, 9, 3),
+    ("interior", 103, 1003, 10, 10, 4),
+    ("edge", 201, 2001, 7, 8, 2),
+    ("edge", 202, 2002, 9, 8, 3),
+    ("edge", 203, 2003, 10, 10, 4),
+    ("corner", 301, 3001, 7, 7, 2),
+    ("corner", 302, 3002, 8, 10, 3),
+    ("corner", 303, 3003, 10, 9, 4),
+    ("mixed", 401, 4001, 7, 9, 2),
+    ("mixed", 402, 4002, 9, 8, 3),
+    ("mixed", 403, 4003, 10, 10, 4),
+)
+
+
+def _grid_sha256(grid: list[list[int]]) -> str:
+    return hashlib.sha256(json.dumps(grid, separators=(",", ":")).encode()).hexdigest()
+
+
+def _source_sha256(module: Any) -> str:
+    return hashlib.sha256(Path(module.__file__).read_bytes()).hexdigest()
+
+
+def _seed_records(grid: list[list[int]]) -> list[tuple[int, int, int]]:
+    return [
+        (row, col, value)
+        for row, line in enumerate(grid)
+        for col, value in enumerate(line)
+        if value != 0
+    ]
+
+
+def _paint(
+    grid: list[list[int]],
+    directions: tuple[tuple[int, int], ...],
+    color_for_seed,
+    *,
+    include_seed=lambda _row, _col, _height, _width: True,
+) -> list[list[int]]:
+    output = copy.deepcopy(grid)
+    height, width = len(grid), len(grid[0])
+    for row, col, color in _seed_records(grid):
+        if not include_seed(row, col, height, width):
+            continue
+        for drow, dcol in directions:
+            rr, cc = row + drow, col + dcol
+            if 0 <= rr < height and 0 <= cc < width and output[rr][cc] == 0:
+                output[rr][cc] = color_for_seed(color)
+    return output
+
+
+def oracle(grid: list[list[int]]) -> list[list[int]]:
+    """Independent exact rule: preserve seeds; cyan-fill in-bounds cardinal neighbors."""
+    return _paint(grid, DIRS4, lambda _seed_color: 8)
+
+
+def rival_outputs(grid: list[list[int]]) -> dict[str, list[list[int]]]:
+    """Four plausible but semantically wrong shortcuts used by the audit."""
+    height, width = len(grid), len(grid[0])
+    return {
+        "diagonal_halo": _paint(grid, DIAGONALS, lambda _seed_color: 8),
+        "fill_all_background": [
+            [8 if value == 0 else value for value in row]
+            for row in grid
+        ],
+        "interior_only": _paint(
+            grid,
+            DIRS4,
+            lambda _seed_color: 8,
+            include_seed=lambda row, col, _height, _width: (
+                0 < row < height - 1 and 0 < col < width - 1
+            ),
+        ),
+        "seed_colored_halo": _paint(grid, DIRS4, lambda seed_color: seed_color),
+    }
+
+
+def build_cases(generator: Any) -> list[dict[str, Any]]:
+    """Construct a stable 12-case profile/size/count matrix from the selected generator."""
+    cases: list[dict[str, Any]] = []
+    for profile, seed, sample_index, height, width, count in CASE_SPECS:
+        grid = generator.generate(
+            seed,
+            sample_index,
+            grid_h=height,
+            grid_w=width,
+            n_seeds=count,
+            scene_profile=profile,
+        )
+        errors = generator.self_check(
+            grid,
+            meta={
+                "overrides": {
+                    "grid_h": height,
+                    "grid_w": width,
+                    "n_seeds": count,
+                    "scene_profile": profile,
+                }
+            },
+        )
+        if errors:
+            raise AssertionError(f"{profile}-{count}: generated invalid case: {errors}")
+        cases.append(
+            {
+                "case_id": f"{profile}-{count}-{height}x{width}",
+                "profile": profile,
+                "seed": seed,
+                "sample_index": sample_index,
+                "grid_h": height,
+                "grid_w": width,
+                "n_seeds": count,
+                "input": grid,
+                "input_sha256": _grid_sha256(grid),
+            }
+        )
+    return cases
+
+
+def evaluate_pure(generator: Any, cases: list[dict[str, Any]]) -> dict[str, Any]:
+    """Compare the Python mirror with an independent oracle and all declared rivals."""
+    mirror_mismatches: list[str] = []
+    rival_names = tuple(rival_outputs(cases[0]["input"])) if cases else ()
+    rivals = {name: {"defeated_by": [], "matched_by": []} for name in rival_names}
+    case_results: list[dict[str, Any]] = []
+
+    for case in cases:
+        grid = case["input"]
+        expected = oracle(grid)
+        mirrored = generator.rule_mirror(grid)
+        if mirrored != expected:
+            mirror_mismatches.append(case["case_id"])
+        case_rivals = rival_outputs(grid)
+        defeated = []
+        for name, output in case_rivals.items():
+            key = "matched_by" if output == expected else "defeated_by"
+            rivals[name][key].append(case["case_id"])
+            if output != expected:
+                defeated.append(name)
+        case_results.append(
+            {
+                "case_id": case["case_id"],
+                "profile": case["profile"],
+                "input_sha256": case["input_sha256"],
+                "expected_output_sha256": _grid_sha256(expected),
+                "defeated_rivals": sorted(defeated),
+            }
+        )
+
+    for item in rivals.values():
+        item["defeated_by"] = sorted(item["defeated_by"])
+        item["matched_by"] = sorted(item["matched_by"])
+    return {
+        "mirror_matches_oracle": not mirror_mismatches,
+        "mirror_mismatches": mirror_mismatches,
+        "all_rivals_defeated": all(item["defeated_by"] for item in rivals.values()),
+        "rivals": rivals,
+        "cases": case_results,
+    }
+
+
+def evaluate_protected(root: Path, generator: Any, cases: list[dict[str, Any]]) -> dict[str, Any]:
+    """Execute the protected canonical Racket rule on the retained inputs."""
+    sys.path.insert(0, str(root / "src"))
+    from arcpuzzles.catalog import Catalog  # pylint: disable=import-outside-toplevel
+    from arcpuzzles.runtime import apply_rule  # pylint: disable=import-outside-toplevel
+
+    applied = apply_rule(
+        Catalog(root),
+        TASK_ID,
+        [case["input"] for case in cases],
+        allow_unapproved=True,
+        check_generator_domain=True,
+    )
+    case_results = []
+    mismatches = []
+    domain_failures = []
+    for case, result in zip(cases, applied["results"], strict=True):
+        expected = oracle(case["input"])
+        matches = result.get("output") == expected
+        domain = result.get("generator_domain", {})
+        domain_valid = domain.get("status") == "valid" and not domain.get("errors")
+        if not matches:
+            mismatches.append(case["case_id"])
+        if not domain_valid:
+            domain_failures.append(case["case_id"])
+        case_results.append(
+            {
+                "case_id": case["case_id"],
+                "input_sha256": result["input_sha256"],
+                "output_sha256": result["output_sha256"],
+                "valid_output": result.get("valid_output"),
+                "error": result.get("error"),
+                "generator_domain": domain,
+                "matches_independent_oracle": matches,
+            }
+        )
+    return {
+        "reference": applied["reference"],
+        "rule_file": applied["rule_file"],
+        "executed_rule_hash": applied["executed_rule_hash"],
+        "catalog_rule_hash": applied["catalog_rule_hash"],
+        "rule_hash_matches_catalog": applied["rule_hash_matches_catalog"],
+        "rule_text_sha256": applied["rule_text_sha256"],
+        "catalog_approved": applied["catalog_approved"],
+        "approved": applied["approved"],
+        "train_safety": applied["train_safety"],
+        "all_outputs_match_independent_oracle": not mismatches,
+        "mismatches": mismatches,
+        "all_inputs_in_generator_domain": not domain_failures,
+        "domain_failures": domain_failures,
+        "cases": case_results,
+        "note": applied["note"],
+    }
+
+
+def _load_generator(root: Path) -> Any:
+    path = root / "generators" / TASK_ID / "generator.py"
+    spec = importlib.util.spec_from_file_location(f"generator_{TASK_ID}", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def build_report(root: Path) -> dict[str, Any]:
+    generator = _load_generator(root)
+    cases = build_cases(generator)
+    pure = evaluate_pure(generator, cases)
+    protected = evaluate_protected(root, generator, cases)
+    return {
+        "schema": SCHEMA,
+        "task_id": TASK_ID,
+        "generator_version": generator.VERSION,
+        "generator_rule_hash": generator.RULE_HASH,
+        "generator_source_sha256": _source_sha256(generator),
+        "case_count": len(cases),
+        "profiles": list(generator.SCENE_PROFILES),
+        "pure": pure,
+        "protected_racket": protected,
+        "cases": cases,
+        "overall_passed": (
+            pure["mirror_matches_oracle"]
+            and pure["all_rivals_defeated"]
+            and protected["all_outputs_match_independent_oracle"]
+            and protected["all_inputs_in_generator_domain"]
+            and protected["rule_hash_matches_catalog"]
+        ),
+        "governance": (
+            "Audit evidence only. Protected execution with allow_unapproved=True "
+            "does not approve the changed generator or admit training data."
+        ),
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True, help="repository-relative JSON output path")
+    args = parser.parse_args(argv)
+    root = Path(__file__).resolve().parents[3]
+    report = build_report(root)
+    output = args.out if args.out.is_absolute() else root / args.out
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "task_id": TASK_ID,
+        "overall_passed": report["overall_passed"],
+        "case_count": report["case_count"],
+        "out": str(output.relative_to(root)),
+    }, sort_keys=True))
+    return 0 if report["overall_passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
