+def _choose_spaced(candidates, count, rng):
+    ordered = _shuffled(candidates, rng)
+
+    def search(start, chosen):
+        if len(chosen) == count:
+            return tuple(chosen)
+        needed = count - len(chosen)
+        if len(ordered) - start < needed:
+            return None
+        for index in range(start, len(ordered)):
+            row, col = ordered[index]
+            if not _far_enough(chosen, row, col):
+                continue
+            result = search(index + 1, chosen + [(row, col)])
+            if result is not None:
+                return result
+        return None
+
+    result = search(0, [])
+    if result is None:
+        raise ValueError("could not construct separated singleton seeds")
+    return result
