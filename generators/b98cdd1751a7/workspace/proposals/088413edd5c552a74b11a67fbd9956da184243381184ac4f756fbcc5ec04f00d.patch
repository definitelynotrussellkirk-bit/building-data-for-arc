+    )
+    module = __import__("importlib.util").util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_adversarial_audit_matrix_defeats_declared_shortcuts():
+    audit = _load_audit_tool()
+    cases = audit.build_cases(MODULE)
+    assert {case["profile"] for case in cases} == set(MODULE.SCENE_PROFILES)
+    assert len(cases) == 12
+    assert len({case["input_sha256"] for case in cases}) == len(cases)
+
+    pure = audit.evaluate_pure(MODULE, cases)
+    assert pure["mirror_matches_oracle"] is True
+    assert pure["all_rivals_defeated"] is True
+    assert set(pure["rivals"]) == {
+        "diagonal_halo",
+        "fill_all_background",
+        "interior_only",
+        "seed_colored_halo",
+    }
+    assert all(item["defeated_by"] for item in pure["rivals"].values())
