+                            "sha256": _sha256_bytes(public_bytes),
+                            "query_answer_invariance": True,
+                        }
+                    )
+
+    source_paths = [
+        HERE / "adapter.py",
+        HERE / "family.py",
+        HERE / "canonical.rkt",
+        HERE / "promotion.json",
+        HERE / "build_native_evidence.py",
