(rule!
  ;; Proposed variant: move by 1 copy/copies of the red-to-green vector.
  (let* ((src (first (find-color g 2)))
         (dst (first (find-color g 3)))
         (dr (* 1 (- (first dst) (first src))))
         (dc (* 1 (- (second dst) (second src)))))
    (foldl (lambda (cell out)
             (let* ((r (first cell))
                    (c (second cell))
                    (v (third cell))
                    (nr (+ r dr))
                    (nc (+ c dc)))
               (if (and (not (= v 0))
                        (not (= v 2))
                        (not (= v 3))
                        (in-bounds? nr nc (rows g) (cols g)))
                   (set-cell out nr nc v)
                   out)))
           (empty-grid (rows g) (cols g) 0)
           (grid-cells g))))
