(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (begin
             (define bg 0)
             (define rects
               (map (lambda (o)
                      (let* ((cells (obj-cells o))
                             (rs (map first cells))
                             (cs (map second cells))
                             (r1 (min-list rs))
                             (r2 (max-list rs))
                             (c1 (min-list cs))
                             (c2 (max-list cs))
                             (rh (+ (- r2 r1) 1))
                             (rw (+ (- c2 c1) 1))
                             (border (quotient (max rh rw) 2)))
                        (list r1 c1 r2 c2 border)))
                    (objects-8 g bg)))
             (define (in-b r c) (and (>= r 0) (< r h) (>= c 0) (< c w)))
             (define after-stems
               (reduce (lambda (gg rect)
                         (let* ((r1 (first rect))
                                (c1 (second rect))
                                (r2 (third rect))
                                (c2 (nth rect 3))
                                (border (nth rect 4))
                                (stem-start (+ r2 border 1)))
                           (recolor-cells gg
                                          (filter (lambda (rc)
                                                    (in-b (first rc) (second rc)))
                                                  (flatmap (lambda (r)
                                                             (map (lambda (c)
                                                                    (list r c))
                                                                  (range c1 (+ c2 1))))
                                                           (range stem-start h)))
                                          1)))
                       g
                       rects))
             (define after-borders
               (reduce (lambda (gg rect)
                         (let* ((r1 (first rect))
                                (c1 (second rect))
                                (r2 (third rect))
                                (c2 (nth rect 3))
                                (border (nth rect 4))
                                (br1 (- r1 border))
                                (br2 (+ r2 border))
                                (bc1 (- c1 border))
                                (bc2 (+ c2 border)))
                           (reduce (lambda (gg2 rc)
                                     (let ((r (first rc))
                                           (c (second rc)))
                                       (if (and (in-b r c) (!= (at g r c) 9))
                                           (set-cell gg2 r c 3)
                                           gg2)))
                                   gg
                                   (filter (lambda (rc)
                                             (let ((r (first rc))
                                                   (c (second rc)))
                                               (or (< r r1) (> r r2) (< c c1) (> c c2))))
                                           (flatmap (lambda (r)
                                                      (map (lambda (c) (list r c))
                                                           (range bc1 (+ bc2 1))))
                                                    (range br1 (+ br2 1)))))))
                       after-stems
                       rects))
             after-borders))))