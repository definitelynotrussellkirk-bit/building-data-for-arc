(rule!
 (lambda (g)
  (let ()
   (define behavior-mode "counterclockwise")
   (define h (rows g))
   (define w (cols g))
   (define bg 6)
   (define frame-color 0)
   (define empty-color 5)
   (define fill-color 7)
   (define bar-color 9)
   (define (right-end r c)
    (if (and (< (+ c 1) w) (= (at g r (+ c 1)) frame-color))
        (right-end r (+ c 1)) c))
   (define (down-end r c)
    (if (and (< (+ r 1) h) (= (at g (+ r 1) c) frame-color))
        (down-end (+ r 1) c) r))
   (define (valid-frame? box)
    (let ((r0 (first box)) (c0 (second box))
          (r1 (third box)) (c1 (fourth box)))
     (and (>= (- r1 r0) 2) (>= (- c1 c0) 2)
          (for*/and ((r (in-range r0 (+ r1 1)))
                     (c (in-range c0 (+ c1 1))))
           (if (or (= r r0) (= r r1) (= c c0) (= c c1))
               (= (at g r c) frame-color)
               (member (at g r c) (list empty-color fill-color)))))))
   (define candidates
    (for*/list ((r0 (in-range h)) (c0 (in-range w))
                #:when (= (at g r0 c0) frame-color)
                #:when (or (= r0 0) (not (= (at g (- r0 1) c0) frame-color)))
                #:when (or (= c0 0) (not (= (at g r0 (- c0 1)) frame-color))))
     (list r0 c0 (down-end r0 c0) (right-end r0 c0))))
   (define frames (filter valid-frame? candidates))
   (define (attached-cells side box)
    (let ((r0 (first box)) (c0 (second box))
          (r1 (third box)) (c1 (fourth box)))
     (cond ((eq? side 'up) (for/list ((c (in-range c0 (+ c1 1)))) (list (- r0 1) c)))
           ((eq? side 'down) (for/list ((c (in-range c0 (+ c1 1)))) (list (+ r1 1) c)))
           ((eq? side 'left) (for/list ((r (in-range r0 (+ r1 1)))) (list r (- c0 1))))
           (else (for/list ((r (in-range r0 (+ r1 1)))) (list r (+ c1 1)))))))
   (define (side-in-bounds? side box)
    (let ((r0 (first box)) (c0 (second box))
          (r1 (third box)) (c1 (fourth box)))
     (cond ((eq? side 'up) (> r0 0)) ((eq? side 'down) (< (+ r1 1) h))
           ((eq? side 'left) (> c0 0)) (else (< (+ c1 1) w)))))
   (define (full-bar? cells)
    (and (not (empty? cells))
         (for/and ((p cells)) (= (at g (first p) (second p)) bar-color))))
   (define (line-at side box coordinate)
    (let ((r0 (first box)) (c0 (second box))
          (r1 (third box)) (c1 (fourth box)))
     (if (member side '(up down))
         (for/list ((c (in-range c0 (+ c1 1)))) (list coordinate c))
         (for/list ((r (in-range r0 (+ r1 1)))) (list r coordinate)))))
   (define (target-coordinate side box attached)
    (define step (if (member side '(up left)) -1 1))
    (define limit (if (member side '(up down)) h w))
    (let loop ((coordinate (+ attached step)))
     (cond ((or (< coordinate 0) (>= coordinate limit))
            (error "missing collinear target bar"))
           ((full-bar? (line-at side box coordinate)) coordinate)
           (else (loop (+ coordinate step))))))
   (define (sweep box side counterclockwise?)
    (let* ((r0 (first box)) (c0 (second box))
           (r1 (third box)) (c1 (fourth box))
           (rows-up (range (+ r0 1) r1))
           (rows-down (reverse rows-up))
           (cols-right (range (+ c0 1) c1))
           (cols-left (reverse cols-right)))
     (cond
      ((eq? side 'up)
       (for*/list ((r rows-up) (c (if counterclockwise? cols-left cols-right))) (list r c)))
      ((eq? side 'down)
       (for*/list ((r rows-down) (c (if counterclockwise? cols-right cols-left))) (list r c)))
      ((eq? side 'right)
       (for*/list ((c cols-left) (r (if counterclockwise? rows-down rows-up))) (list r c)))
      (else
       (for*/list ((c cols-right) (r (if counterclockwise? rows-up rows-down))) (list r c))))))
   (define (make-record box)
    (define sides
     (filter (lambda (side)
              (and (side-in-bounds? side box)
                   (full-bar? (attached-cells side box))))
             '(up right down left)))
    (define side (first sides))
    (define r0 (first box)) (define c0 (second box))
    (define r1 (third box)) (define c1 (fourth box))
    (define attached
     (cond ((eq? side 'up) (- r0 1)) ((eq? side 'down) (+ r1 1))
           ((eq? side 'left) (- c0 1)) (else (+ c1 1))))
    (define target (target-coordinate side box attached))
    (define distance (abs (- target attached)))
    (define gray-count
     (for*/sum ((r (in-range (+ r0 1) r1)) (c (in-range (+ c0 1) c1)))
      (if (= (at g r c) empty-color) 1 0)))
    (define travel (if (equal? behavior-mode "full_distance")
                       distance (min distance gray-count)))
    (define counterclockwise? (equal? behavior-mode "counterclockwise"))
    (define available
     (filter (lambda (p) (= (at g (first p) (second p)) empty-color))
             (sweep box side counterclockwise?)))
    (define fill-count (if (equal? behavior-mode "no_fill") 0 travel))
    (define chosen (take available (min fill-count (length available))))
    (define dr (cond ((eq? side 'up) (- travel)) ((eq? side 'down) travel) (else 0)))
    (define dc (cond ((eq? side 'left) (- travel)) ((eq? side 'right) travel) (else 0)))
    (list box side travel dr dc (attached-cells side box) chosen))
   (define records (map make-record frames))
   (define cleared
    (for/fold ((out g)) ((record records))
     (let* ((box (first record)) (travel (third record))
            (r0 (first box)) (c0 (second box))
            (r1 (third box)) (c1 (fourth box))
            (attached (sixth record)))
      (if (= travel 0) out
       (let ((without-box
              (for*/fold ((acc out)) ((r (in-range r0 (+ r1 1)))
                                      (c (in-range c0 (+ c1 1))))
               (set-cell acc r c bg))))
        (for/fold ((acc without-box)) ((p attached))
         (set-cell acc (first p) (second p) bg)))))))
   (for/fold ((out cleared)) ((record records))
    (let* ((box (first record)) (dr (fourth record)) (dc (fifth record))
           (attached (sixth record)) (chosen (seventh record))
           (r0 (first box)) (c0 (second box))
           (r1 (third box)) (c1 (fourth box))
           (with-box
            (for*/fold ((acc out)) ((r (in-range r0 (+ r1 1)))
                                    (c (in-range c0 (+ c1 1))))
             (set-cell acc (+ r dr) (+ c dc)
                       (if (member (list r c) chosen) fill-color (at g r c))))))
     (for/fold ((acc with-box)) ((p attached))
      (set-cell acc (+ (first p) dr) (+ (second p) dc) bar-color)))))))
