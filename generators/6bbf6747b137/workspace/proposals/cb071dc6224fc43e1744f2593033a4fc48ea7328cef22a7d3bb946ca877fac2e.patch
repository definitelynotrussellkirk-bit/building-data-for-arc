+"""Regression tests for query-answer ambiguity and optional label validation."""
+from __future__ import annotations
+
+from copy import deepcopy
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+
+TASK_ID = "9c75b1456763"
+
+
+@pytest.fixture
+def lesson():
+    root = find_root(__file__)
+    generator, _path, _sha256 = load_selected_generator(TASK_ID, root=root)
+    pairs = canonical_pairs(TASK_ID, root=root, labeled_only=True)
+    # The 20x20 and 30x30 demonstrations leave the 18x18 canvas held out.
+    by_size = {len(pair["input"]): pair for pair in pairs if pair["split"] == "train"}
+    return generator, [by_size[20], by_size[30]], by_size[18]
+
+
+def test_lesson_accepts_query_with_only_public_input(lesson):
+    generator, demos, query = lesson
+    assert generator.lesson_identifiable(demos, {"input": query["input"]}) == []
+
+
+def test_answer_equivalent_survivor_is_not_query_ambiguity(lesson, monkeypatch):
+    generator, demos, query = lesson
+    monkeypatch.setattr(
+        generator, "LESSON_COMPETITORS", {"equivalent": generator.rule_mirror}
+    )
+    assert generator.lesson_identifiable(demos, query) == []
+
+
+def test_only_demo_fitting_query_disagreements_are_reported(lesson, monkeypatch):
+    generator, demos, query = lesson
+
+    def first_network_on_small_canvas(grid):
+        if len(grid) == 18:
+            return generator._rival_first_component_only(grid)
+        return generator.rule_mirror(grid)
+
+    monkeypatch.setattr(
+        generator,
+        "LESSON_COMPETITORS",
+        {
+            "equivalent": generator.rule_mirror,
+            "small_canvas_first_network": first_network_on_small_canvas,
+            "refuted_global_color": generator._rival_global_first_marker,
+        },
+    )
+    reasons = generator.lesson_identifiable(demos, query)
+    assert len(reasons) == 1
+    assert "small_canvas_first_network" in reasons[0]
+    assert "equivalent" not in reasons[0]
+    assert "refuted_global_color" not in reasons[0]
+
+
+def test_eliminated_rival_is_not_reconsidered_using_query(lesson, monkeypatch):
+    generator, demos, query = lesson
+
+    def refuted_on_demos(grid):
+        if len(grid) == 18:
+            raise AssertionError("an eliminated rival must not inspect the query")
+        return generator._rival_first_component_only(grid)
+
+    monkeypatch.setattr(generator, "LESSON_COMPETITORS", {"refuted": refuted_on_demos})
+    assert generator.lesson_identifiable(demos, query) == []
+
+
+@pytest.mark.parametrize("replacement", [False, 0.0])
+def test_demo_labels_reject_noninteger_values_equal_to_integer_colors(lesson, replacement):
+    generator, demos, query = lesson
+    demos = deepcopy(demos)
+    output = demos[0]["output"]
+    row, col = next(
+        (r, c) for r, values in enumerate(output) for c, value in enumerate(values)
+        if value == 0
+    )
+    output[row][col] = replacement
+    reasons = generator.lesson_identifiable(demos, query)
+    assert reasons
+    assert any("demo 0" in reason and "output" in reason for reason in reasons)
+
+
