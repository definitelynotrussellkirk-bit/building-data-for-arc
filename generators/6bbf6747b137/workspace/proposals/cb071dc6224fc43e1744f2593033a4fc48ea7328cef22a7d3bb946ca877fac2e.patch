+
+    def should_not_infer_from_bad_labels(_grid):
+        raise AssertionError("incorrect labels cannot supply a lesson certificate")
+
+    monkeypatch.setattr(generator, "LESSON_COMPETITORS", {"unused": should_not_infer_from_bad_labels})
+    reasons = generator.lesson_identifiable(demos, query)
+    assert any("demo 0 output" in reason for reason in reasons)
+
+
+@pytest.mark.parametrize("bad_query", [None, {}, {"input": []}, {"input": [[False]]}, {"input": [[0], [0, 1]]}])
+def test_malformed_public_query_returns_reasons(lesson, bad_query):
+    generator, demos, _query = lesson
+    reasons = generator.lesson_identifiable(demos, bad_query)
+    assert reasons
+    assert all(isinstance(reason, str) for reason in reasons)
