+def test_present_query_label_rejects_noninteger_values(lesson, replacement):
+    generator, demos, query = lesson
+    query = deepcopy(query)
+    output = query["output"]
+    row, col = next(
+        (r, c) for r, values in enumerate(output) for c, value in enumerate(values)
+        if value == 0
+    )
+    output[row][col] = replacement
+    reasons = generator.lesson_identifiable(demos, query)
+    assert reasons
+    assert any("query output" in reason for reason in reasons)
+
+
