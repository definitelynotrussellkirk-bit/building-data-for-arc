@@ -0,0 +1,150 @@
+"""Bounded structural-boundary and verifier probe; labels come from Racket.
+
+Run from the packet repository through review.py run, passing a new --out dir.
+This is focused repair evidence, not a general generator census or approval.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import deque
+import hashlib
+import json
+from pathlib import Path
+import time
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+
+TASK_ID = "6e8324f40386"
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def reference_shape(grid):
+    """Independent flood-fill expectation to compare with authoritative labels."""
+    h, w = len(grid), len(grid[0])
+    output = [[0] * w for _ in range(h)]
+    seen = set()
+    components = touching = 0
+    for r in range(h):
+        for c in range(w):
+            if grid[r][c] == 0 or (r, c) in seen:
+                continue
+            cells, queue = [], deque([(r, c)])
+            seen.add((r, c))
+            while queue:
+                a, b = queue.popleft()
+                cells.append((a, b))
+                for x, y in ((a - 1, b), (a + 1, b), (a, b - 1), (a, b + 1)):
+                    if (0 <= x < h and 0 <= y < w and (x, y) not in seen
+                            and grid[x][y] == grid[r][c]):
+                        seen.add((x, y))
+                        queue.append((x, y))
+            border = any(a in (0, h - 1) or b in (0, w - 1) for a, b in cells)
+            components += 1
+            touching += border
+            for a, b in cells:
+                output[a][b] = 2 if border else 8
+    return output, components, touching
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    root = find_root(__file__)
+    gen, source, source_sha = load_selected_generator(TASK_ID, root=root)
+    rows = [json.loads(line) for line in canonical_path(root).read_text().splitlines()
+            if json.loads(line).get("task_id") == TASK_ID]
+    assert len(rows) == 1
+    rule = rows[0]["program_solution"]
+    started = time.monotonic()
+    report = {"task_id": TASK_ID, "generator_sha256": source_sha,
+              "rule_sha256": hashlib.sha256(rule.encode()).hexdigest(),
+              "surfaces": ["minimum/maximum dimensions and component counts",
+                           "integer rejection and requested-count verifier"],
+              "budget_seconds": 300, "cases": [], "rejections": [], "failures": []}
+    representatives = []
+
+    def label(bridge, grid, identity, expected=None):
+        before = digest(grid)
+        py_output, n, touching = reference_shape(grid)
+        bridge.define_grid("__structural_input", grid)
+        output = bridge.eval_text("(__structural_rule __structural_input)")
+        assert digest(grid) == before, "input mutated"
+        assert output == py_output, "Racket/flood-fill mismatch"
+        if expected is not None:
+            assert output == expected, "canonical label mismatch"
+        record = {**identity, "dimensions": [len(grid), len(grid[0])],
+                  "n": n, "n_touching_border": touching,
+                  "input_sha256": before, "output_sha256": digest(output)}
+        report["cases"].append(record)
+        if len(representatives) < 4 and identity["kind"] == "generated":
+            representatives.append({**identity, "input": grid, "output": output})
+        return n, touching
+
+    with RacketBridge() as bridge:
+        report["runtime_identity"] = bridge.runtime_identity
+        bridge.eval_text(f"(define __structural_rule {wrap_rule(rule)})")
+        for pair in canonical_pairs(TASK_ID, root=root):
+            label(bridge, pair["input"], {"kind": "canonical", "split": pair["split"],
+                                         "pair_index": pair["pair_index"]}, pair["output"])
+
+        settings = []
+        for h, w in ((6, 8), (14, 16)):
+            for n, touching in ((2, 1), (3, 1), (3, 2), (5, 1), (5, 4)):
+                settings.append({"grid_h": h, "grid_w": w, "n": n,
+                                 "n_touching_border": touching})
+        settings.extend(dict(zip(("grid_h", "grid_w", "n", "n_touching_border"), values))
+                        for values in ((7, 8, 2, 1), (8, 8, 3, 2),
+                                       (6, 9, 3, 1), (8, 9, 3, 2)))
+        for overrides in settings:
+            for seed in (3, 11):
+                assert time.monotonic() - started < 300, "five-minute budget exhausted"
+                identity = {"kind": "generated", "seed": seed, "sample_index": 0,
+                            "overrides": overrides}
+                try:
+                    grid = gen.generate(seed, 0, **overrides)
+                    n, touching = label(bridge, grid, identity)
+                    assert (n, touching) == (overrides["n"], overrides["n_touching_border"])
+                    assert gen.self_check(grid, meta=overrides) == []
+                    assert gen.generate(seed, 0, **overrides) == grid, "nondeterministic repeat"
+                except Exception as error:
+                    report["failures"].append({**identity, "error": f"{type(error).__name__}: {error}"})
+
+    invalid = [("n", 3.5, TypeError), ("n", "3", TypeError),
+               ("grid_h", True, TypeError), ("grid_w", 8.0, TypeError),
+               ("n_touching_border", "1", TypeError),
+               ("n_touching_border", 0, ValueError),
+               ("n_touching_border", 3, ValueError)]
+    for axis, value, expected in invalid:
+        try:
+            gen.generate(3, 0, **{"n": 3, axis: value})
+        except expected as error:
+            report["rejections"].append({"axis": axis, "value": value,
+                                         "exception": type(error).__name__})
+        else:
+            report["failures"].append({"axis": axis, "value": value,
+                                       "error": f"expected {expected.__name__}"})
+    grid = gen.generate(3, 0, n=3, n_touching_border=1)
+    assert gen.self_check(grid, meta={"n": 2})
+    assert gen.self_check(grid, meta={"n_touching_border": 2})
+    report["metadata_mismatch_rejections"] = 2
+    report["elapsed_seconds"] = round(time.monotonic() - started, 3)
+    report["canonical_labels"] = sum(case["kind"] == "canonical" for case in report["cases"])
+    report["generated_labels"] = sum(case["kind"] == "generated" for case in report["cases"])
+    report["status"] = "pass" if not report["failures"] else "finding"
+    (args.out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    (args.out / "representative_pairs.json").write_text(json.dumps(representatives, indent=2) + "\n")
+    print(json.dumps({key: report[key] for key in ("status", "elapsed_seconds", "canonical_labels",
+                                                  "generated_labels", "failures")}, indent=2))
+    return int(bool(report["failures"]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
