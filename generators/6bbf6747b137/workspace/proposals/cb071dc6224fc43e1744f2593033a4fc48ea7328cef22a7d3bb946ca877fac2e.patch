+"""Bounded, source-bound edge probe; run through review.py run from the packet."""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import time
+
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+
+TASK_ID = "6bbf6747b137"
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args()
+    started = time.monotonic()
+    root = find_root(__file__)
+    generator, source, source_hash = load_selected_generator(TASK_ID, root=root)
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.helpers.selfcheck import components
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    rules = {row["program_solution"]
+             for line in canonical_path(root).read_text().splitlines()
+             if (row := json.loads(line)).get("task_id") == TASK_ID}
+    assert len(rules) == 1
+    rule = rules.pop()
+    program = wrap_rule(rule)
+    report = {
+        "task_id": TASK_ID,
+        "generator_sha256": source_hash,
+        "canonical_program_sha256": hashlib.sha256(rule.encode()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "budget_seconds": 300,
+        "surfaces": ["sampler bounds and completion", "numeric and grid rejection paths"],
+        "boundary_sampling": {"cases": 0, "racket_matches": 0, "deterministic_repeats": 0},
+        "representative_labels": [],
+    }
+    shapes = [(7, 7), (7, 14), (14, 7), (14, 14)]
+    case_hashes = []
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        report["racket_runtime"] = {key: value for key, value in identity.items()
+                                    if key.endswith("sha256") or key in ("schema", "backend", "protected")}
+        for height, width in shapes:
+            for k in range(1, 7):
+                for seed in range(4):
+                    assert time.monotonic() - started < 240, "edge-probe time limit reached"
+                    kwargs = {"grid_h": height, "grid_w": width, "K": k}
+                    grid = generator.generate(seed, seed % 3, **kwargs)
+                    assert grid == generator.generate(seed, seed % 3, **kwargs)
+                    objects = components(grid[1:])
+                    sizes = [len(obj["cells"]) for obj in objects]
+                    assert (len(grid), len(grid[0]), grid[0].count(1)) == (height, width, k)
+                    assert len(sizes) == len(set(sizes)) == 3 and sizes.count(k) == 1
+                    assert generator.self_check(grid) == []
+                    expected = [[0] * width for _ in range(height)]
+                    for obj in objects:
+                        if len(obj["cells"]) == k:
+                            for row, col in obj["cells"]:
+                                expected[row + 1][col] = obj["color"]
+                    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+                    output = bridge.eval_text(f"({program} {literal})")
+                    assert output == expected
+                    report["boundary_sampling"]["cases"] += 1
+                    report["boundary_sampling"]["racket_matches"] += 1
+                    report["boundary_sampling"]["deterministic_repeats"] += 1
+                    case_hashes.append(digest({"seed": seed, "sample_index": seed % 3,
+                                               "overrides": kwargs, "input": grid, "output": output}))
+                    if (height, width, seed) == (7, 7, 0) and k in (1, 5, 6):
+                        report["representative_labels"].append({
+                            "seed": seed, "sample_index": 0, "overrides": kwargs,
+                            "input": grid, "racket_output": output,
+                        })
+    report["boundary_sampling"].update({
+        "shapes": shapes, "K_values": list(range(1, 7)), "seeds": list(range(4)),
+        "sample_index": "seed % 3", "case_digest_sha256": digest(case_hashes),
+    })
+    report["default_header_counts"] = dict(Counter(
+        generator.generate(seed, 0)[0].count(1) for seed in range(64)
+    ))
+    assert {5, 6} <= report["default_header_counts"].keys()
+
+    invalid = [{name: value} for name in ("K", "grid_h", "grid_w")
+               for value in (True, 3.5, "8")]
+    invalid += [{"K": 0}, {"K": 7}, {"grid_h": 6}, {"grid_h": 15},
+                {"grid_w": 6}, {"grid_w": 15}]
+    for overrides in invalid:
+        try:
+            generator.generate(0, 0, **overrides)
+        except (TypeError, ValueError):
+            continue
+        raise AssertionError(f"accepted invalid override: {overrides}")
+    report["invalid_overrides_rejected"] = len(invalid)
+    malformed = [None, [], [[]], [0], [[0], [0, 1]], [[True], [2]],
+                 [[0], [2.0]], [[0], [10]], [[2], [3]], [[0], [0]],
+                 [[1] * 7, [2] + [0] * 6]]
+    for grid in malformed:
+        assert generator.self_check(grid), grid
