+#!/usr/bin/env python3
+"""Bounded Racket-backed checks of lesson labels and query-specific rivals."""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import time
+
+from puzzle_generators.runner import _apply_rule, _open_bridge_with_rule, wrap_rule
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+
+TASK_ID = "9c75b1456763"
+
+
+def run_probe():
+    started = time.monotonic()
+    root = find_root(__file__)
+    generator, source, source_sha256 = load_selected_generator(TASK_ID, root=root)
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        selected = []
+        for line in handle:
+            if line.strip():
+                row = json.loads(line)
+                if row.get("task_id") == TASK_ID:
+                    selected.append(row)
+    assert len(selected) == 1, "the probe requires one unambiguous task authority"
+    program = selected[0]["program_solution"]
+    pairs = canonical_pairs(TASK_ID, root=root, labeled_only=True)
+
+    bridge, function_name = _open_bridge_with_rule(wrap_rule(program))
+    reference_rows = []
+    try:
+        for pair in pairs:
+            output = _apply_rule(bridge, function_name, pair["input"])
+            assert output == pair["output"], "Racket disagrees with a canonical label"
+            assert output == generator.rule_mirror(pair["input"]), "Python mirror differs"
+            reference_rows.append({
+                "variant": pair["variant"], "split": pair["split"],
+                "pair_index": pair["pair_index"], "racket_matches_label_and_mirror": True,
+            })
+    finally:
+        bridge.shutdown()
+
+    checks = []
+
+    def check(name, demos, query, *, accepted, named=None):
+        reasons = generator.lesson_identifiable(demos, query)
+        assert (not reasons) == accepted, (name, reasons)
+        if named is not None:
+            assert len(reasons) == 1 and named in reasons[0], (name, reasons)
+            assert "equivalent" not in reasons[0], (name, reasons)
+        checks.append({"case": name, "accepted": not reasons, "reasons": reasons})
+
+    for index, pair in enumerate(pairs):
+        demos = pairs[:index] + pairs[index + 1:]
+        check(f"rotation_{index}_masked", demos, {"input": pair["input"]}, accepted=True)
+        check(f"rotation_{index}_labelled", demos, pair, accepted=True)
+
+    by_size = {len(pair["input"]): pair for pair in pairs if pair["split"] == "train"}
+    demos, query = [by_size[20], by_size[30]], by_size[18]
+    for split in ("demo", "query"):
+        for mutation in ("boolean", "float", "missing_grid", "ragged", "wrong_color"):
+            changed_demos, changed_query = deepcopy(demos), deepcopy(query)
+            pair = changed_demos[0] if split == "demo" else changed_query
+            output = pair["output"]
+            r, c = next((r, c) for r, row in enumerate(output) for c, v in enumerate(row) if v == 0)
+            if mutation == "boolean":
+                output[r][c] = False
+            elif mutation == "float":
+                output[r][c] = 0.0
+            elif mutation == "missing_grid":
+                pair["output"] = None
+            elif mutation == "ragged":
+                output[0] = output[0][:-1]
+            else:
+                output[r][c] = 9
+            check(f"{split}_{mutation}", changed_demos, changed_query, accepted=False)
+
+    declared = generator.LESSON_COMPETITORS
+    try:
+        def first_network_on_small_canvas(grid):
+            if len(grid) == 18:
+                return generator._rival_first_component_only(grid)
+            return generator.rule_mirror(grid)
+
+        generator.LESSON_COMPETITORS = {"equivalent": generator.rule_mirror}
+        check("answer_equivalent_survivor", demos, {"input": query["input"]}, accepted=True)
+        generator.LESSON_COMPETITORS = {
+            "equivalent": generator.rule_mirror,
+            "small_canvas_first_network": first_network_on_small_canvas,
+            "global_color_refuted_by_demos": generator._rival_global_first_marker,
+        }
+        check("query_changing_survivor", demos, {"input": query["input"]}, accepted=False,
+              named="small_canvas_first_network")
+        check("survivor_agrees_on_other_query", demos, {"input": pairs[-1]["input"]}, accepted=True)
+
+        def refuted(grid):
+            if len(grid) == 18:
+                raise AssertionError("an eliminated rival must not inspect the query")
+            return generator._rival_first_component_only(grid)
+
+        generator.LESSON_COMPETITORS = {"refuted": refuted}
+        check("eliminated_before_query", demos, {"input": query["input"]}, accepted=True)
+    finally:
+        generator.LESSON_COMPETITORS = declared
+
+    elapsed = time.monotonic() - started
+    assert elapsed <= 300, "adversarial check exceeded its five-minute budget"
+    return {
+        "schema": "9c75b1456763-lesson-contract-probe-v1",
+        "task_id": TASK_ID,
+        "source_binding": {
+            "path": source.relative_to(root).as_posix(), "sha256": source_sha256,
+            "version": generator.VERSION, "declared_rule_hash": generator.RULE_HASH,
+            "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+            "probe_path": Path(__file__).resolve().relative_to(root).as_posix(),
+            "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        },
+        "racket_labels": reference_rows,
+        "checks": checks,
+        "adversarial": {
+            "budget_seconds": 300, "elapsed_seconds": elapsed,
+            "surfaces": ["label scalar types and malformed grids", "demo-survival versus query disagreement"],
+            "result": "No additional finding in the bounded cases.",
+        },
+        "limits": [
+            "Four canonical inputs; production sampler coverage is unchanged and not censused here.",
+            "Temporary rivals exercise the hook contract; they are not new production declarations.",
+            "Finite named-rival checks do not prove universal induction or approval.",
+        ],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    report = run_probe()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(f"Racket labels: {len(report['racket_labels'])}; lesson boundary cases: {len(report['checks'])}; all passed")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
