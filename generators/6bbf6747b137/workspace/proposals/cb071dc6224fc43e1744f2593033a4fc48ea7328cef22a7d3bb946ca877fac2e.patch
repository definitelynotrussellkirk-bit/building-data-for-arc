+ROOT = find_root(__file__)
+
+
+@pytest.fixture(scope="module")
+def generator():
+    return load_selected_generator(TASK_ID, root=ROOT)[0]
+
+
+def body_components(grid):
+    from puzzle_generators.helpers.selfcheck import components
+
+    return components(grid[1:], same_color=True, connectivity=4)
+
+
