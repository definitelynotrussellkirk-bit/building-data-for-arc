+"""Regression tests for the selected border-recolor generator's shape controls."""
+from __future__ import annotations
+
+import random
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+
+ROOT = find_root(__file__)
+GEN, _, _ = load_selected_generator("6e8324f40386", root=ROOT)
+
+
+def observed_counts(grid):
+    """The selected sampler gives each separated component a distinct color."""
+    colors = {cell for row in grid for cell in row} - {0}
+    edge_colors = set(grid[0]) | set(grid[-1])
+    edge_colors.update(row[0] for row in grid)
+    edge_colors.update(row[-1] for row in grid)
+    return len(colors), len(edge_colors - {0})
+
+
+@pytest.mark.parametrize("n,touching", [(2, 1), (5, 1), (5, 4)])
+@pytest.mark.parametrize("difficulty", ["easy", None, "hard"])
+def test_component_count_override_is_independent_of_difficulty(n, touching, difficulty):
+    grid = GEN.generate(17, 0, difficulty=difficulty, n=n,
+                        n_touching_border=touching)
+    assert observed_counts(grid) == (n, touching)
+    assert GEN.self_check(grid) == []
+
+
+@pytest.mark.parametrize("touching", [1, 2])
+def test_requested_border_count_is_honored(touching):
+    grid = GEN.generate(0, 0, n=3, n_touching_border=touching)
+    assert observed_counts(grid) == (3, touching)
+
+
+@pytest.mark.parametrize("h,w,n,touching", [(7, 8, 2, 1), (8, 8, 3, 2),
+                                            (6, 9, 3, 1), (8, 9, 3, 2)])
+def test_canonical_geometry_can_be_requested(h, w, n, touching):
+    grid = GEN.generate(31, 0, grid_h=h, grid_w=w, n=n,
+                        n_touching_border=touching)
+    assert (len(grid), len(grid[0])) == (h, w)
+    assert observed_counts(grid) == (n, touching)
+
+
+def test_canonical_inputs_satisfy_component_contract():
+    for pair in canonical_pairs("6e8324f40386", root=ROOT):
+        assert GEN.self_check(pair["input"]) == [], (pair["split"], pair["pair_index"])
+
+
+@pytest.mark.parametrize("axis,value", [("n", 3.5), ("n", "3"),
+                                        ("grid_h", 9.5), ("grid_w", "11"),
+                                        ("n_touching_border", True)])
+def test_structural_counts_reject_noninteger_overrides(axis, value):
+    with pytest.raises(TypeError, match="integer"):
+        GEN.generate(0, 0, **{axis: value})
+
+
+@pytest.mark.parametrize("overrides", [{"n": 1}, {"n": 6},
+                                        {"grid_h": 5}, {"grid_h": 15},
+                                        {"grid_w": 7}, {"grid_w": 17},
+                                        {"n": 3, "n_touching_border": 0},
+                                        {"n": 3, "n_touching_border": 3}])
+def test_out_of_domain_structure_is_rejected(overrides):
+    with pytest.raises(ValueError):
+        GEN.generate(0, 0, **overrides)
+
+
+def test_interior_placement_accepts_exact_one_cell_margin():
+    grid = [[0] * 8 for _ in range(6)]
+    cells = [(0, 0), (1, 0), (2, 0), (3, 0)]
+    assert GEN._place_component(grid, cells, 4, random.Random(3), mode="interior")
+    assert observed_counts(grid) == (1, 0)
+    assert sum(cell == 4 for row in grid for cell in row) == 4
+
+
+def test_self_check_reports_requested_count_mismatches():
+    grid = GEN.generate(10, 0, n=3, n_touching_border=1)
+    assert GEN.self_check(grid, meta={"n": 3, "n_touching_border": 1}) == []
+    assert GEN.self_check(grid, meta={"n": 2})
+    assert GEN.self_check(grid, meta={"n_touching_border": 2})
