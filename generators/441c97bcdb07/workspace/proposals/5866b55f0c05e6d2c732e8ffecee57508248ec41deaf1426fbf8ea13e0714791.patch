+#!/usr/bin/env python3
+"""Source-bound teaching audit for square-bbox shortcut rivals."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, normalize_grid
+
+TASK_ID = "4c0f3760c653"
+ASSIGNED_SOURCE_SHA256 = "7bd20564ddb727278030987a1bdf4738679270b772e3bfc9579e5570144acf2b"
+
+
+def load_generator(root: Path):
+    source = root / "generators" / TASK_ID / "generator.py"
+    spec = importlib.util.spec_from_file_location(f"audit_{TASK_ID}_generator", source)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {source}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module, source
+
+
+def canonical_program(root: Path) -> str:
+    programs: set[str] = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one canonical program, got {len(programs)}")
+    return next(iter(programs))
+
+
+def components(grid: list[list[int]]) -> list[tuple[int, set[tuple[int, int]]]]:
+    height, width = len(grid), len(grid[0])
+    unseen = {(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value}
+    result: list[tuple[int, set[tuple[int, int]]]] = []
+    while unseen:
+        start = min(unseen)
+        color = grid[start[0]][start[1]]
+        unseen.remove(start)
+        cells = {start}
+        stack = [start]
+        while stack:
+            row, col = stack.pop()
+            for neighbor in ((row - 1, col), (row + 1, col), (row, col - 1), (row, col + 1)):
+                rr, cc = neighbor
+                if 0 <= rr < height and 0 <= cc < width and neighbor in unseen and grid[rr][cc] == color:
+                    unseen.remove(neighbor)
+                    cells.add(neighbor)
+                    stack.append(neighbor)
+        result.append((color, cells))
+    return result
+
+
+def bbox(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [row for row, _ in cells]
+    cols = [col for _, col in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def is_square_bbox(cells: set[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = bbox(cells)
+    return r1 - r0 == c1 - c0
+
+
+def is_solid_2x2(cells: set[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = bbox(cells)
+    return r1 - r0 == 1 and c1 - c0 == 1 and len(cells) == 4
+
+
+def solve(grid: list[list[int]], mode: str) -> list[list[int]]:
+    output = [[0 for _ in row] for row in grid]
+    comps = components(grid)
+    max_area = max((len(cells) for _color, cells in comps), default=0)
+    for color, cells in comps:
+        if mode == "square_bbox":
+            keep = is_square_bbox(cells)
+        elif mode == "solid_2x2_only":
+            keep = is_solid_2x2(cells)
+        elif mode == "largest_area_only":
+            keep = len(cells) == max_area
+        else:
+            raise ValueError(mode)
+        if keep:
+            for row, col in cells:
+                output[row][col] = color
+    return output
+
+
+def racket_eval(bridge: RacketBridge, wrapped: str, grid: list[list[int]]) -> list[list[int]]:
+    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+    return normalize_grid(bridge.eval_text(f"({wrapped} {literal})"))
+
+
+def differing_cells(a: list[list[int]], b: list[list[int]]) -> int:
+    return sum(a[r][c] != b[r][c] for r in range(len(a)) for c in range(len(a[0])))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seeds", type=int, default=32)
+    parser.add_argument("--samples", type=int, default=12)
+    args = parser.parse_args()
+
+    root = find_root(__file__)
+    generator, source = load_generator(root)
+    source_sha256 = hashlib.sha256(source.read_bytes()).hexdigest()
+    program = canonical_program(root)
+    wrapped = wrap_rule(program)
+
+    difficulties = (None, "easy", "medium", "hard")
+    checked = 0
+    windows = 0
+    profile_counts: dict[str, int] = {}
+    witness_by_profile: dict[str, dict] = {}
+    for difficulty in difficulties:
+        for seed in range(args.seeds):
+            grids = []
+            for sample_index in range(args.samples):
+                grid = generator.generate(seed, sample_index, difficulty=difficulty)
+                errors = generator.self_check(grid)
+                if errors:
+                    raise AssertionError((difficulty, seed, sample_index, errors))
+                profile = generator.schedule_profile(seed, sample_index, difficulty=difficulty)
+                profile_counts[profile] = profile_counts.get(profile, 0) + 1
+                canonical = solve(grid, "square_bbox")
+                rivals = {
+                    "solid_2x2_only": solve(grid, "solid_2x2_only"),
+                    "largest_area_only": solve(grid, "largest_area_only"),
+                }
+                if profile not in witness_by_profile:
+                    witness_by_profile[profile] = {
+                        "input": grid,
+                        "canonical_output": canonical,
+                        "rival_differences": {name: differing_cells(canonical, output) for name, output in rivals.items()},
+                    }
+                grids.append(grid)
+                checked += 1
+            for start in range(len(grids) - 2):
+                window = grids[start : start + 3]
+                canonical_outputs = [solve(grid, "square_bbox") for grid in window]
+                for rival in ("solid_2x2_only", "largest_area_only"):
+                    rival_outputs = [solve(grid, rival) for grid in window]
+                    if canonical_outputs == rival_outputs:
+                        raise AssertionError(("ambiguous repaired window", rival, difficulty, seed, start))
+                windows += 1
+
+    racket_evaluations = 0
+    with RacketBridge(timeout=30, startup_timeout=60) as bridge:
+        for profile in generator.SCHEDULE_PROFILES:
+            grid = witness_by_profile[profile]["input"]
+            expected = solve(grid, "square_bbox")
+            actual = racket_eval(bridge, wrapped, grid)
+            racket_evaluations += 1
+            if actual != expected:
+                raise AssertionError((profile, "canonical Racket mismatch"))
