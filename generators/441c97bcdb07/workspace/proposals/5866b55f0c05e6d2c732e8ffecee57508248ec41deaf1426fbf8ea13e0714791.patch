+"""Regression checks for the Manhattan-vs-Euclidean teaching surface."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, normalize_grid
+
+
+TASK_ID = "42ccd1ff25f3"
+ROOT = find_root(__file__)
+SOURCE = ROOT / "generators" / TASK_ID / "generator.py"
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(f"test_{TASK_ID}_generator", SOURCE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _program() -> str:
+    programs = set()
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        for line in handle:
+            if line.strip():
+                row = json.loads(line)
+                if row.get("task_id") == TASK_ID:
+                    programs.add(row["program_solution"])
+    assert len(programs) == 1
+    return next(iter(programs))
+
+
+def _solve(grid, metric: str):
+    seeds = [(r, c, value) for r, row in enumerate(grid) for c, value in enumerate(row) if value]
+    output = []
+    for row_index, row in enumerate(grid):
+        out_row = []
+        for col_index, value in enumerate(row):
+            if value:
+                out_row.append(value)
+                continue
+            ranked = []
+            for seed_row, seed_col, seed_color in seeds:
+                delta_row = abs(row_index - seed_row)
+                delta_col = abs(col_index - seed_col)
+                if metric == "manhattan":
+                    distance = delta_row + delta_col
+                elif metric == "euclidean_squared":
+                    distance = delta_row * delta_row + delta_col * delta_col
+                else:
+                    raise ValueError(metric)
+                ranked.append((distance, seed_color))
+            ranked.sort()
+            out_row.append(0 if len(ranked) >= 2 and ranked[0][0] == ranked[1][0] else ranked[0][1])
+        output.append(out_row)
+    return output
+
+
+def _racket(bridge: RacketBridge, grid):
+    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+    return normalize_grid(bridge.eval_text(f"({wrap_rule(_program())} {literal})"))
+
+
+def test_default_draws_constructively_distinguish_manhattan_from_euclidean():
+    generator = _load_generator()
+    for difficulty in (None, "easy", "medium", "hard"):
+        for seed in range(64):
+            for sample_index in range(8):
+                grid = generator.generate(seed, sample_index, difficulty=difficulty)
+                assert _solve(grid, "manhattan") != _solve(grid, "euclidean_squared"), (
+                    difficulty,
+                    seed,
+                    sample_index,
+                    len(grid),
+                    len(grid[0]),
+                )
+
+
+def test_exact_dimension_overrides_remain_available_for_audits():
+    generator = _load_generator()
+    for height, width in ((6, 7), (6, 9), (8, 8)):
+        grid = generator.generate(5, 3, grid_h=height, grid_w=width)
+        assert (len(grid), len(grid[0])) == (height, width)
+        assert generator.self_check(grid) == []
+
+
+def test_postrepair_metric_witness_matches_protected_canonical_racket():
+    generator = _load_generator()
+    grid = generator.generate(176, 0)
+    expected = _solve(grid, "manhattan")
+    assert expected != _solve(grid, "euclidean_squared")
+    with RacketBridge(timeout=30, startup_timeout=60) as bridge:
+        assert _racket(bridge, grid) == expected
+        assert bridge.runtime_identity["protected"] is True
