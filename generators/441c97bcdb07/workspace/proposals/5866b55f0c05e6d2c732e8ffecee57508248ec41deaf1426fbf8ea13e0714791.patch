+"""Regression checks for non-solid square-bbox teaching examples."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, normalize_grid
+
+
+TASK_ID = "4c0f3760c653"
+ROOT = find_root(__file__)
+SOURCE = ROOT / "generators" / TASK_ID / "generator.py"
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(f"test_{TASK_ID}_generator", SOURCE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _program() -> str:
+    programs = set()
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        for line in handle:
+            if line.strip():
+                row = json.loads(line)
+                if row.get("task_id") == TASK_ID:
+                    programs.add(row["program_solution"])
+    assert len(programs) == 1
+    return next(iter(programs))
+
+
+def _components(grid):
+    height, width = len(grid), len(grid[0])
+    unseen = {(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value}
+    result = []
+    while unseen:
+        start = min(unseen)
+        color = grid[start[0]][start[1]]
+        unseen.remove(start)
+        cells = {start}
+        stack = [start]
+        while stack:
+            row, col = stack.pop()
+            for neighbor in ((row - 1, col), (row + 1, col), (row, col - 1), (row, col + 1)):
+                rr, cc = neighbor
+                if 0 <= rr < height and 0 <= cc < width and neighbor in unseen and grid[rr][cc] == color:
+                    unseen.remove(neighbor)
+                    cells.add(neighbor)
+                    stack.append(neighbor)
+        result.append((color, cells))
+    return result
+
+
+def _bbox(cells):
+    rows = [row for row, _ in cells]
+    cols = [col for _, col in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_square_bbox(cells):
+    r0, c0, r1, c1 = _bbox(cells)
+    return r1 - r0 == c1 - c0
+
+
+def _is_solid_2x2(cells):
+    r0, c0, r1, c1 = _bbox(cells)
+    return r1 - r0 == 1 and c1 - c0 == 1 and len(cells) == 4
+
+
+def _solve(grid, mode: str):
+    output = [[0 for _ in row] for row in grid]
+    for color, cells in _components(grid):
+        keep = _is_square_bbox(cells) if mode == "square_bbox" else _is_solid_2x2(cells)
+        if keep:
+            for row, col in cells:
+                output[row][col] = color
+    return output
+
+
+def _racket(bridge: RacketBridge, grid):
+    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+    return normalize_grid(bridge.eval_text(f"({wrap_rule(_program())} {literal})"))
+
+
+def _has_non_solid_square_witness(grid):
+    return any(_is_square_bbox(cells) and not _is_solid_2x2(cells) for _color, cells in _components(grid))
+
+
+def test_every_three_sample_window_contains_a_non_solid_square_bbox_witness():
+    generator = _load_generator()
+    for difficulty in (None, "easy", "medium", "hard"):
+        for seed in range(24):
+            samples = [generator.generate(seed, index, difficulty=difficulty) for index in range(15)]
+            for start in range(13):
+                assert any(_has_non_solid_square_witness(grid) for grid in samples[start : start + 3]), (
+                    difficulty,
+                    seed,
+                    start,
+                )
+
+
+def test_three_demo_windows_refute_solid_2x2_only_and_remain_lawful():
+    generator = _load_generator()
+    for seed in range(32):
+        samples = [generator.generate(seed, index) for index in range(8)]
+        assert all(generator.self_check(grid) == [] for grid in samples)
+        for start in range(6):
+            window = samples[start : start + 3]
+            assert any(_solve(grid, "square_bbox") != _solve(grid, "solid_2x2_only") for grid in window)
+
+
+def test_non_solid_square_witness_matches_protected_canonical_racket():
+    generator = _load_generator()
+    grid = generator.generate(7, 1)
+    assert _has_non_solid_square_witness(grid)
+    expected = _solve(grid, "square_bbox")
+    assert expected != _solve(grid, "solid_2x2_only")
+    with RacketBridge(timeout=30, startup_timeout=60) as bridge:
+        assert _racket(bridge, grid) == expected
+        assert bridge.runtime_identity["protected"] is True
