+#!/usr/bin/env python3
+"""Source-bound Manhattan-vs-Euclidean teaching audit for 42ccd1ff25f3."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from typing import Iterable
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, normalize_grid
+
+TASK_ID = "42ccd1ff25f3"
+ASSIGNED_SOURCE_SHA256 = "56539199ddc6604a7ef04b4fb7cb57a6c5a026992c3b7e0c5168a980d60fd453"
+
+
+def load_generator(root: Path):
+    source = root / "generators" / TASK_ID / "generator.py"
+    spec = importlib.util.spec_from_file_location(f"audit_{TASK_ID}_generator", source)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {source}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module, source
+
+
+def canonical_program(root: Path) -> str:
+    programs: set[str] = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one canonical program, got {len(programs)}")
+    return next(iter(programs))
+
+
+def solve(grid: list[list[int]], metric: str) -> list[list[int]]:
+    seeds = [(r, c, value) for r, row in enumerate(grid) for c, value in enumerate(row) if value]
+    output: list[list[int]] = []
+    for row_index, row in enumerate(grid):
+        out_row: list[int] = []
+        for col_index, value in enumerate(row):
+            if value:
+                out_row.append(value)
+                continue
+            ranked: list[tuple[int, int]] = []
+            for seed_row, seed_col, seed_color in seeds:
+                dr = abs(row_index - seed_row)
+                dc = abs(col_index - seed_col)
+                if metric == "manhattan":
+                    distance = dr + dc
+                elif metric == "euclidean_squared":
+                    distance = dr * dr + dc * dc
+                else:
+                    raise ValueError(metric)
+                ranked.append((distance, seed_color))
+            ranked.sort()
+            out_row.append(0 if ranked[0][0] == ranked[1][0] else ranked[0][1])
+        output.append(out_row)
+    return output
+
+
+def make_grid(height: int, width: int, colors: Iterable[int]) -> list[list[int]]:
+    colors = tuple(colors)
+    grid = [[0 for _ in range(width)] for _ in range(height)]
+    for (row, col), color in zip(((1, 1), (1, width - 2), (height - 2, 3)), colors, strict=True):
+        grid[row][col] = color
+    return grid
+
+
+def racket_eval(bridge: RacketBridge, wrapped: str, grid: list[list[int]]) -> list[list[int]]:
+    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+    return normalize_grid(bridge.eval_text(f"({wrapped} {literal})"))
+
+
+def differing_cells(a: list[list[int]], b: list[list[int]]) -> list[list[int]]:
+    return [[r, c, a[r][c], b[r][c]] for r in range(len(a)) for c in range(len(a[0])) if a[r][c] != b[r][c]]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seeds", type=int, default=64)
+    parser.add_argument("--samples", type=int, default=8)
+    args = parser.parse_args()
+
+    root = find_root(__file__)
+    generator, source = load_generator(root)
+    source_bytes = source.read_bytes()
+    source_sha256 = hashlib.sha256(source_bytes).hexdigest()
+    program = canonical_program(root)
+    wrapped = wrap_rule(program)
+
+    lesson_specs = [
+        (6, 9, (2, 3, 4)),
+        (6, 7, (5, 7, 2)),
+        (6, 9, (6, 3, 8)),
+    ]
+    query_spec = (8, 8, (4, 2, 6))
+    lesson = [make_grid(*spec) for spec in lesson_specs]
+    query = make_grid(*query_spec)
+    lesson_rows = []
+    racket_evaluations = 0
+    with RacketBridge(timeout=30, startup_timeout=60) as bridge:
+        for grid in lesson:
+            manhattan = solve(grid, "manhattan")
+            euclidean = solve(grid, "euclidean_squared")
+            racket = racket_eval(bridge, wrapped, grid)
+            racket_evaluations += 1
+            if racket != manhattan or euclidean != manhattan:
+                raise AssertionError("historical demonstration does not preserve the ambiguity")
+            lesson_rows.append({"input": grid, "canonical_output": racket})
+        manhattan_query = solve(query, "manhattan")
+        euclidean_query = solve(query, "euclidean_squared")
+        racket_query = racket_eval(bridge, wrapped, query)
+        racket_evaluations += 1
+        if racket_query != manhattan_query or euclidean_query == manhattan_query:
+            raise AssertionError("query does not separate the two metrics")
+        runtime_identity = bridge.runtime_identity
+
+    difficulties = (None, "easy", "medium", "hard")
+    checked = 0
+    dimensions: dict[str, int] = {}
+    for difficulty in difficulties:
+        for seed in range(args.seeds):
+            for sample_index in range(args.samples):
+                grid = generator.generate(seed, sample_index, difficulty=difficulty)
+                if generator.self_check(grid) != []:
+                    raise AssertionError((difficulty, seed, sample_index, generator.self_check(grid)))
+                if solve(grid, "manhattan") == solve(grid, "euclidean_squared"):
+                    raise AssertionError(("ambiguous default after repair", difficulty, seed, sample_index))
+                key = f"{len(grid)}x{len(grid[0])}"
+                dimensions[key] = dimensions.get(key, 0) + 1
+                checked += 1
+
+    explicit_ambiguous = []
+    for height, width in ((6, 7), (6, 9)):
+        grid = generator.generate(5, 3, grid_h=height, grid_w=width)
+        if solve(grid, "manhattan") != solve(grid, "euclidean_squared"):
+            raise AssertionError("explicit legacy audit dimension unexpectedly stopped being ambiguous")
+        explicit_ambiguous.append([height, width])
+
+    report = {
+        "schema": "arcpuzzles-peer-metric-audit-v1",
+        "task_id": TASK_ID,
+        "status": "passed",
+        "assigned_source_sha256": ASSIGNED_SOURCE_SHA256,
+        "audited_source_sha256": source_sha256,
+        "generator_version": generator.VERSION,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "historical_ambiguity": {
+            "rival": "euclidean_squared_nearest_seed",
+            "demonstrations": lesson_rows,
+            "query_input": query,
+            "canonical_query_output": manhattan_query,
+            "rival_query_output": euclidean_query,
+            "differing_cells": differing_cells(manhattan_query, euclidean_query),
+        },
+        "repair": {
+            "summary": "ordinary h=6 draws use width 8; explicit 6x7 and 6x9 overrides remain available for audits",
+            "default_draws_checked": checked,
+            "dimension_counts": dict(sorted(dimensions.items())),
+            "remaining_explicit_ambiguous_dimensions": explicit_ambiguous,
+        },
+        "racket": {
+            "evaluations": racket_evaluations,
+            "runtime_identity": runtime_identity,
+        },
+        "limits": "Finite Euclidean rival audit only; this is not a proof against every alternative distance rule.",
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": report["status"],
+        "out": str(args.out),
+        "default_draws_checked": checked,
+        "query_differing_cells": len(report["historical_ambiguity"]["differing_cells"]),
+        "racket_evaluations": racket_evaluations,
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
