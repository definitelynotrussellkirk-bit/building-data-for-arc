(rule! (let ((dummy 0))
  (define (fifth xs) (list-ref xs 4))
  (define (row-run r start end color)
    (list r start end (+ 1 (- end start)) color))
  (define (run-line run) (first run))
  (define (run-start run) (second run))
  (define (run-length run) (fourth run))
  (define (run-color run) (fifth run))
  (define (row-runs grid)
    (apply append
      (for/list ((r (in-range (rows grid))))
        (let loop ((c 0) (acc (list)))
          (if (>= c (cols grid))
              (reverse acc)
              (let ((v (at grid r c)))
                (if (= v 0)
                    (loop (+ c 1) acc)
                    (let find-end ((cc c))
                      (if (and (< (+ cc 1) (cols grid))
                               (= (at grid r (+ cc 1)) v))
                          (find-end (+ cc 1))
                          (loop (+ cc 1) (cons (row-run r c cc v) acc)))))))))))
  (for/fold ((out (empty-grid (rows g) (cols g) 0))) ((run (in-list (row-runs g))))
    (let* ((r (run-line run))
           (start (run-start run))
           (len (run-length run))
           (color (run-color run))
           (left (+ start (quotient (- len 1) 2)))
           (right (+ start (quotient len 2))))
      (set-cell (set-cell out r left color) r right color))))
)
