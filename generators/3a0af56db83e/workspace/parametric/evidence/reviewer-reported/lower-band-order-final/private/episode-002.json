  "racket_program": "(rule! (lambda (g)\n  (let* ((w (cols g))\n         ;; Four monochrome 3-row masks are stacked vertically. Project them\n         ;; onto one 3-row frame without letting color identity encode priority.\n         (band (lambda (j r c) (at g (+ (* j 3) r) c))))\n    (build-grid 3 w (r c)\n      ;; First nonzero wins in priority order 0 > 1 > 2 > 3.\n      (let ((v0 (band 0 r c))\n            (v1 (band 1 r c))\n            (v3 (band 3 r c))\n            (v2 (band 2 r c)))\n        (cond\n          ((!= v0 0) v0)\n          ((!= v1 0) v1)\n          ((!= v2 0) v2)\n          ((!= v3 0) v3)\n          (else 0)))))))",
