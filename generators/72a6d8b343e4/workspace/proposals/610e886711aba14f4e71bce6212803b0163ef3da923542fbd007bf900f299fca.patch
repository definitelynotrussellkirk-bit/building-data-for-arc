+@lru_cache(maxsize=256)
+def _candidate_pool(kind, h, w):
+    """Return immutable (occupied, reserved-footprint) candidates."""
+    candidates = []
+    if kind == "horizontal":
+        for r in range(h):
+            for c1 in range(w - 2):
+                for c2 in range(c1 + 2, w):
+                    occupied = ((r, c1), (r, c2))
+                    candidates.append((occupied, _line_cells(*occupied)))
+    elif kind == "vertical":
+        for c in range(w):
+            for r1 in range(h - 2):
+                for r2 in range(r1 + 2, h):
+                    occupied = ((r1, c), (r2, c))
+                    candidates.append((occupied, _line_cells(*occupied)))
+    elif kind == "adjacent":
+        for r in range(h):
+            for c in range(w - 1):
+                occupied = ((r, c), (r, c + 1))
+                candidates.append((occupied, occupied))
+        for r in range(h - 1):
+            for c in range(w):
+                occupied = ((r, c), (r + 1, c))
+                candidates.append((occupied, occupied))
+    elif kind == "diagonal":
+        cells = [(r, c) for r in range(h) for c in range(w)]
+        for index, a in enumerate(cells):
+            for b in cells[index + 1:]:
+                if a[0] != b[0] and a[1] != b[1]:
+                    occupied = (a, b)
+                    candidates.append((occupied, occupied))
+    elif kind == "singleton":
+        for r in range(h):
+            for c in range(w):
+                occupied = ((r, c),)
+                candidates.append((occupied, occupied))
+    else:
+        raise ValueError(f"unknown placement kind: {kind}")
+    return tuple(candidates)
+
