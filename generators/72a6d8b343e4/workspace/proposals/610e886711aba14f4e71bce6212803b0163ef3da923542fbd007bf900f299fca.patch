+"""Independent probes for ARC task 72a6d8b343e4 (Endpoint Bridge).
+
+This is reviewer tooling, not label authority.  It intentionally reconstructs
+all geometry from pixels and never imports private helpers from generator.py.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+from typing import Iterable
+
+TASK_ID = "72a6d8b343e4"
+GENERATOR_HOME = Path(__file__).resolve().parents[1]
+REPO_ROOT = GENERATOR_HOME.parents[1]
+for _path in (REPO_ROOT / "shared/runtime", REPO_ROOT / "src", REPO_ROOT):
+    _text = str(_path)
+    if _text not in sys.path:
+        sys.path.insert(0, _text)
+
+
+def load_generator(path: str | os.PathLike[str] | None = None):
+    selected = path or os.environ.get("GENERATOR_UNDER_TEST")
+    selected_path = Path(selected) if selected else GENERATOR_HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location(
+        f"generator_under_test_{TASK_ID}", selected_path
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load generator from {selected_path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def canonical_pairs() -> list[dict]:
+    """Load normalized public pairs through the portable copied-runtime helper."""
+    from reviewer_support import canonical_pairs as _canonical_pairs, find_root
+
+    return [
+        {"input": [list(row) for row in pair["input"]],
+         "output": [list(row) for row in pair["output"]]}
+        for pair in _canonical_pairs(TASK_ID, root=find_root(__file__))
+    ]
+
+
+def _positions_by_color(grid: list[list[int]]) -> dict[int, list[tuple[int, int]]]:
+    positions: dict[int, list[tuple[int, int]]] = {}
+    for r, row in enumerate(grid):
+        for c, value in enumerate(row):
+            if value != 0:
+                positions.setdefault(value, []).append((r, c))
+    return positions
+
+
+def _segment(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r1, c1 = a
+    r2, c2 = b
+    if r1 == r2:
+        lo, hi = sorted((c1, c2))
+        return [(r1, c) for c in range(lo, hi + 1)]
+    if c1 == c2:
+        lo, hi = sorted((r1, r2))
+        return [(r, c1) for r in range(lo, hi + 1)]
+    return []
+
+
+def authority_output(grid: list[list[int]]) -> list[list[int]]:
+    """Independent mirror of the selected rule, using original-grid counts."""
+    out = deepcopy(grid)
+    for color, points in _positions_by_color(grid).items():
+        if len(points) != 2:
+            continue
+        for r, c in _segment(points[0], points[1]):
+            out[r][c] = color
+    return out
+
+
+def overconnect_multiples_output(grid: list[list[int]]) -> list[list[int]]:
+    """Rival: connect every aligned same-color pair, even with 3+ occurrences."""
+    out = deepcopy(grid)
+    for color, points in _positions_by_color(grid).items():
+        for i, a in enumerate(points):
+            for b in points[i + 1:]:
+                for r, c in _segment(a, b):
+                    out[r][c] = color
+    return out
+
+
+def connect_diagonal_l_output(grid: list[list[int]]) -> list[list[int]]:
+    """Rival: connect every exact pair; diagonal pairs use a row-then-column L."""
+    out = deepcopy(grid)
+    for color, points in _positions_by_color(grid).items():
+        if len(points) != 2:
+            continue
+        a, b = points
+        segment = _segment(a, b)
+        if segment:
+            cells = segment
+        else:
+            r1, c1 = a
+            r2, c2 = b
+            c_lo, c_hi = sorted((c1, c2))
+            r_lo, r_hi = sorted((r1, r2))
+            cells = [(r1, c) for c in range(c_lo, c_hi + 1)]
+            cells += [(r, c2) for r in range(r_lo, r_hi + 1)]
+        for r, c in cells:
+            out[r][c] = color
+    return out
+
+
+def observed(grid: list[list[int]]) -> dict[str, int]:
+    counts = Counter()
+    for points in _positions_by_color(grid).values():
+        if len(points) == 1:
+            counts["n_singletons"] += 1
+        elif len(points) == 2:
+            (r1, c1), (r2, c2) = points
+            if r1 == r2 and abs(c1 - c2) == 1:
+                counts["n_adjacent"] += 1
+            elif c1 == c2 and abs(r1 - r2) == 1:
+                counts["n_adjacent"] += 1
+            elif r1 == r2:
+                counts["n_horizontal"] += 1
+            elif c1 == c2:
+                counts["n_vertical"] += 1
+            else:
+                counts["n_diagonal"] += 1
+        elif len(points) == 3:
+            counts["n_triples"] += 1
+        else:
+            counts["other_multiplicity"] += 1
+    return {
+        "grid_h": len(grid),
+        "grid_w": len(grid[0]) if grid else 0,
+        "n_horizontal": counts["n_horizontal"],
+        "n_vertical": counts["n_vertical"],
+        "n_diagonal": counts["n_diagonal"],
+        "n_triples": counts["n_triples"],
+        "n_singletons": counts["n_singletons"],
+        "n_adjacent": counts["n_adjacent"],
+    }
+
+
+def exact_two_witness(grid: list[list[int]]) -> bool:
+    return overconnect_multiples_output(grid) != authority_output(grid)
+
+
+def alignment_witness(grid: list[list[int]]) -> bool:
+    return connect_diagonal_l_output(grid) != authority_output(grid)
+
+
+def profile(grid: list[list[int]]) -> tuple[int, int, int]:
+    return len(grid), len(grid[0]), len({value for row in grid for value in row})
+
+
+def fingerprint(grid: list[list[int]]) -> str:
+    payload = json.dumps(grid, separators=(",", ":")).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def audit(module, *, per_band: int = 120) -> dict:
+    report: dict[str, object] = {"task_id": TASK_ID, "bands": {}}
+    canonical = canonical_pairs()
+    report["canonical_pairs"] = len(canonical)
+    report["canonical_oracle_matches"] = sum(
+        authority_output(pair["input"]) == pair["output"] for pair in canonical
+    )
+    for band in ("easy", "medium", "hard"):
+        rows = []
+        for index in range(per_band):
+            grid = module.generate(20261004, index, difficulty=band)
+            rows.append({
+                "fingerprint": fingerprint(grid),
+                "profile": profile(grid),
+                "observed": observed(grid),
+                "self_check": module.self_check(grid, difficulty=band),
+                "exact_two_witness": exact_two_witness(grid),
+                "alignment_witness": alignment_witness(grid),
+                "oracle_changed_cells": sum(
+                    a != b
+                    for in_row, out_row in zip(grid, authority_output(grid))
+                    for a, b in zip(in_row, out_row)
+                ),
+            })
+        report["bands"][band] = {
+            "samples": len(rows),
+            "unique_inputs": len({row["fingerprint"] for row in rows}),
+            "canonical_profiles": sum(
+                tuple(row["profile"]) in {(8, 9, 3), (8, 10, 3), (8, 11, 3)}
+                for row in rows
+            ),
+            "exact_two_witnesses": sum(row["exact_two_witness"] for row in rows),
+            "alignment_witnesses": sum(row["alignment_witness"] for row in rows),
+            "self_check_failures": sum(bool(row["self_check"]) for row in rows),
+            "unchanged_outputs": sum(row["oracle_changed_cells"] == 0 for row in rows),
+        }
+    return report
+
+
+def main(argv: Iterable[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--generator")
+    parser.add_argument("--per-band", type=int, default=120)
+    parser.add_argument("--out")
+    args = parser.parse_args(list(argv) if argv is not None else None)
+    report = audit(load_generator(args.generator), per_band=args.per_band)
+    text = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        Path(args.out).write_text(text)
+    else:
+        print(text, end="")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
