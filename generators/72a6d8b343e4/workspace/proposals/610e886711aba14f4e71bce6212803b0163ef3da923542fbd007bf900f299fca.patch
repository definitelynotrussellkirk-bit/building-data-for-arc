+from __future__ import annotations
+
+import os
+from pathlib import Path
+import sys
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(HOME / "workspace"))
+from reference_probe import (
+    alignment_witness,
+    authority_output,
+    canonical_pairs,
+    connect_diagonal_l_output,
+    exact_two_witness,
+    load_generator,
+    observed,
+    overconnect_multiples_output,
+    profile,
+)
+
+gen = load_generator(os.environ.get("GENERATOR_UNDER_TEST"))
+
+
+def test_rule_pin_and_public_contract_are_explicit():
+    assert gen.RULE_HASH == "3650a4704dc3"
+    assert set(gen.AXES) == {
+        "grid_h",
+        "grid_w",
+        "n_horizontal",
+        "n_vertical",
+        "n_diagonal",
+        "n_triples",
+        "n_singletons",
+        "n_adjacent",
+    }
+    assert gen.INCOMPATIBLE_OVERRIDE_COMBINATIONS == []
+    for pair in canonical_pairs():
+        assert gen.self_check(pair["input"]) == []
+        assert authority_output(pair["input"]) == pair["output"]
+
+
+def test_unknown_override_is_rejected_instead_of_silently_ignored():
+    with pytest.raises(ValueError, match="unknown override"):
+        gen.generate(1, 0, typo_axis=1)
+
+
+@pytest.mark.parametrize("difficulty", ["easy", "medium", "hard"])
+def test_every_advertised_override_is_exact_in_every_band(difficulty):
+    options = {
+        "grid_h": 8,
+        "grid_w": 11,
+        "n_horizontal": 1,
+        "n_vertical": 1,
+        "n_diagonal": 1,
+        "n_triples": 1,
+        "n_singletons": 1,
+        "n_adjacent": 1,
+    }
+    grid = gen.generate(1701, 9, difficulty=difficulty, **options)
+    assert observed(grid) == options
+    assert gen.observe_overrides(grid) == options
+    assert gen.self_check(grid, difficulty=difficulty, meta={"overrides": options}) == []
+
+
+def test_declared_rivals_fit_canonical_pairs_and_generated_witnesses_defeat_them():
+    assert set(gen.SEMANTIC_WITNESSES) == {"exactly_two_only", "axis_alignment_only"}
+    assert set(gen.SEMANTIC_RIVALS) == {"overconnect_multiples", "connect_diagonal_l"}
+    for pair in canonical_pairs():
+        assert gen.SEMANTIC_RIVALS["overconnect_multiples"](pair["input"]) == pair["output"]
+        assert gen.SEMANTIC_RIVALS["connect_diagonal_l"](pair["input"]) == pair["output"]
+
+    grid = gen.generate(881, 4, grid_h=8, grid_w=11,
+                        n_horizontal=1, n_vertical=1, n_diagonal=1,
+                        n_triples=1, n_singletons=0, n_adjacent=0)
+    assert exact_two_witness(grid)
+    assert alignment_witness(grid)
+    assert gen.SEMANTIC_WITNESSES["exactly_two_only"](grid)
+    assert gen.SEMANTIC_WITNESSES["axis_alignment_only"](grid)
+    assert gen.SEMANTIC_RIVALS["overconnect_multiples"](grid) == overconnect_multiples_output(grid)
+    assert gen.SEMANTIC_RIVALS["connect_diagonal_l"](grid) == connect_diagonal_l_output(grid)
+    assert gen.rule_mirror(grid) == authority_output(grid)
+
+
+def test_canonical_anchor_schedule_has_one_slot_per_three_and_disables_for_overrides():
+    seen_slots = set()
+    for seed in (20261004, 20261005):
+        for block in range(24):
+            flags = [
+                gen._is_canonical_anchor(seed, block * 3 + slot, has_overrides=False)
+                for slot in range(3)
+            ]
+            assert sum(flags) == 1
+            seen_slots.add(flags.index(True))
+    assert seen_slots == {0, 1, 2}
+    assert not gen._is_canonical_anchor(20261004, 0, has_overrides=True)
