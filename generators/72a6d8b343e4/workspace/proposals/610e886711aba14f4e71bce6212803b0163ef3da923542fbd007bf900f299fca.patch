+    assert sum(exact_two_witness(grid) for grid in grids) >= 30
+    assert sum(alignment_witness(grid) for grid in grids) >= 30
+    assert all(gen.self_check(grid, difficulty=difficulty) == [] for grid in grids)
+    assert all(authority_output(grid) != grid for grid in grids)
