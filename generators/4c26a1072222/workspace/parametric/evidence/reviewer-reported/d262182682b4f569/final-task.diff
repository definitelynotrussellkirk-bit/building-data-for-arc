+#!/usr/bin/env python3
+"""Bounded adversarial probe for parametric sampler/export edge surfaces."""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[3]
+for dependency in (REPO, REPO / "shared" / "runtime", HERE):
+    text = str(dependency)
+    if text not in sys.path:
+        sys.path.insert(0, text)
+
+from reviewer_support import public_challenge_id  # noqa: E402
+import prototype  # noqa: E402
+
+
+SEEDS = (0, -1, 2**63 - 1, 20261023)
+COUNT_CASES = ((4, 4), (5, 6))
+
+
+def _grid_errors(grid: Any, label: str) -> list[str]:
+    if type(grid) is not list or not 1 <= len(grid) <= 30:
+        return [f"{label}: grid row count outside 1..30"]
+    if type(grid[0]) is not list or not 1 <= len(grid[0]) <= 30:
+        return [f"{label}: grid column count outside 1..30"]
+    width = len(grid[0])
+    errors = []
+    for row_index, row in enumerate(grid):
+        if type(row) is not list or len(row) != width:
+            errors.append(f"{label}: row {row_index} is ragged or not a list")
+            continue
+        for col_index, value in enumerate(row):
+            if type(value) is not int or not 0 <= value <= 9:
+                errors.append(
+                    f"{label}: cell ({row_index},{col_index}) is not exact int 0..9"
+                )
+    return errors
+
+
+def _visible_grid_errors(public: dict[str, Any]) -> list[str]:
+    errors: list[str] = []
+    for split in ("train", "test"):
+        for index, pair in enumerate(public[split]):
+            errors.extend(_grid_errors(pair["input"], f"{split}[{index}].input"))
+            if split == "train":
+                errors.extend(
+                    _grid_errors(pair["output"], f"{split}[{index}].output")
+                )
+            elif set(pair) != {"input"}:
+                errors.append(f"test[{index}] leaked fields {sorted(set(pair) - {'input'})}")
+    return errors
+
+
+def _episode_inputs(episode: dict[str, Any]) -> list[Any]:
+    return [
+        pair["input"]
+        for split in ("train", "test")
+        for pair in episode[split]
+    ]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args()
+
+    failures: list[str] = []
+    cases: list[dict[str, Any]] = []
+    max_retry_attempt = 0
+    all_public_ids: set[str] = set()
+
+    try:
+        prototype.choose_setting(True)
+        failures.append("bool seed was accepted")
+    except TypeError:
+        pass
+
+    for seed in SEEDS:
+        for n_train, n_test in COUNT_CASES:
+            episodes = {
+                setting: prototype.build_episode(
+                    seed,
+                    application_direction=setting,
+                    n_train=n_train,
+                    n_test=n_test,
+                )
+                for setting in prototype.SETTINGS
+            }
+            schedules = {
+                setting: _episode_inputs(episode)
+                for setting, episode in episodes.items()
+            }
+            if schedules["forward"] != schedules["inverse"]:
+                failures.append(
+                    f"seed={seed} counts={n_train}/{n_test}: input schedule depends on setting"
+                )
+
+            for setting, episode in episodes.items():
+                errors = prototype.episode_errors(episode)
+                if errors:
+                    failures.append(
+                        f"seed={seed} counts={n_train}/{n_test} setting={setting}: {errors}"
+                    )
+                survivors = prototype.setting_survivors(episode["train"])
+                if survivors != [setting]:
+                    failures.append(
+                        f"seed={seed} counts={n_train}/{n_test} setting={setting}: survivors={survivors}"
+                    )
+                serialized = [
+                    json.dumps(grid, separators=(",", ":"))
+                    for grid in _episode_inputs(episode)
+                ]
+                if len(serialized) != len(set(serialized)):
+                    failures.append(
+                        f"seed={seed} counts={n_train}/{n_test} setting={setting}: duplicate inputs"
+                    )
+                if any(
+                    prototype.apply_setting(pair["input"], "forward")
+                    == prototype.apply_setting(pair["input"], "inverse")
+                    for split in ("train", "test")
+                    for pair in episode[split]
+                ):
+                    failures.append(
+                        f"seed={seed} counts={n_train}/{n_test} setting={setting}: non-distinguishing input"
+                    )
+
+                attempts = [
+                    pair["sampling"]["attempt"]
+                    for split in ("train", "test")
+                    for pair in episode[split]
+                ]
+                max_retry_attempt = max(max_retry_attempt, *attempts)
+
+                public = prototype.public_projection(episode)
+                public_id = prototype.public_identifier(episode)
+                all_public_ids.add(public_id)
+                if public_id != public_challenge_id(public):
+                    failures.append(
+                        f"seed={seed} counts={n_train}/{n_test} setting={setting}: public ID mismatch"
+                    )
+                failures.extend(
+                    f"seed={seed} counts={n_train}/{n_test} setting={setting}: {error}"
+                    for error in _visible_grid_errors(public)
+                )
+
+                hidden = deepcopy(episode)
+                hidden["seed"] = seed + 1
+                hidden["parameters"] = {
+                    "application_direction": (
+                        "inverse" if setting == "forward" else "forward"
+                    )
+                }
+                hidden["program"] = "hidden replacement"
+                hidden["generator_sha256"] = "0" * 64
+                for pair in hidden["test"]:
+                    pair["output"] = [[9]]
+                    pair["sampling"] = {"hidden": True}
+                if prototype.public_identifier(hidden) != public_id:
+                    failures.append(
+                        f"seed={seed} counts={n_train}/{n_test} setting={setting}: hidden fields changed public ID"
+                    )
+
+                cases.append(
+                    {
+                        "seed": seed,
+                        "n_train": n_train,
+                        "n_test": n_test,
+                        "setting": setting,
+                        "public_id": public_id,
+                        "survivors": survivors,
+                        "max_retry_attempt": max(attempts),
+                        "unique_inputs": len(set(serialized)),
+                    }
+                )
+
+    rejection_episode = prototype.build_episode(
+        17, application_direction="forward", n_train=4, n_test=4
+    )
+    corrupt = deepcopy(rejection_episode)
+    corrupt["train"][0]["output"] = [[0]]
+    if not any("label mismatches" in error for error in prototype.episode_errors(corrupt)):
+        failures.append("episode_errors did not reject a corrupted demonstration label")
+
+    duplicate = deepcopy(rejection_episode)
+    duplicate["test"][0]["input"] = deepcopy(duplicate["train"][0]["input"])
+    duplicate["test"][0]["output"] = prototype.apply_setting(
+        duplicate["test"][0]["input"], "forward"
+    )
+    if not any("duplicates another episode input" in error for error in prototype.episode_errors(duplicate)):
+        failures.append("episode_errors did not reject a duplicated query input")
+
+    report = {
+        "schema": "4c26a1072222-parametric-adversarial-probe-v1",
+        "status": "passed" if not failures else "failed",
+        "surfaces": [
+            "sampler_boundaries_and_retry_schedules",
+            "public_private_export_and_numeric_types",
+        ],
+        "seed_cases": list(SEEDS),
+        "count_cases": [list(case) for case in COUNT_CASES],
+        "settings": list(prototype.SETTINGS),
+        "episode_cases": len(cases),
+        "input_grids_checked": sum(row["unique_inputs"] for row in cases),
+        "max_retry_attempt": max_retry_attempt,
+        "distinct_public_ids": len(all_public_ids),
+        "rejection_paths": {
+            "bool_seed": "rejected",
+            "corrupt_demo_label": "rejected",
+            "duplicate_query_input": "rejected",
+        },
+        "failures": failures,
+        "cases": cases,
+        "limits": [
+            "Bounded to four edge seeds and two train/query count combinations.",
+            "Did not exhaust the 512-attempt retry limit because all retained cases succeeded on attempt 0.",
+            "Racket parity is covered separately by checks/parametric/manifest.json.",
+        ],
+    }
+    out = Path(args.out).resolve()
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({key: report[key] for key in (
+        "status", "episode_cases", "input_grids_checked", "max_retry_attempt", "distinct_public_ids"
+    )}, sort_keys=True))
+    return 0 if not failures else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff -ruN .review/baseline/repo/generators/4c26a1072222/workspace/parametric/prototype.py repo/generators/4c26a1072222/workspace/parametric/prototype.py
--- .review/baseline/repo/generators/4c26a1072222/workspace/parametric/prototype.py	1970-01-01 00:00:00.000000000 +0000
+++ repo/generators/4c26a1072222/workspace/parametric/prototype.py	2026-10-23 17:11:16.624170792 +0000
@@ -0,0 +1,358 @@
+"""Task-local episode-fixed forward/inverse rule variants for ``4c26a1072222``.
+
+The canonical setting infers one D4 transform and one functional color map from
+A→B in each band, then applies that same transform and map to C.  This proposed
+prototype varies one nearby semantic choice once per episode:
+
+* ``forward``: apply the inferred transform to C (the registered canonical rule);
+* ``inverse``: apply the inverse of the inferred transform to C while retaining
+  the same A→B color map.
+
+Only quarter-turn transforms differ between the settings.  Production generation
+and canonical authority remain unchanged, and the default setting returns the
+registered canonical Racket source byte-for-byte.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+from functools import lru_cache
+import hashlib
+import json
+from typing import Any, Iterable
+
+from reviewer_support import (
+    canonical_path,
+    find_root,
+    load_selected_generator,
+    public_challenge_id,
+)
+
+
+TASK_ID = "4c26a1072222"
+PROTOTYPE_VERSION = "1.0.0"
+DEFAULT_SETTING = "forward"
+SETTINGS = (DEFAULT_SETTING, "inverse")
+MIN_TRAIN = 4
+MIN_TEST = 4
+
+_CANONICAL_C_BINDING = "(v (c-val gr t lr c))"
+_INVERSE_C_BINDING = (
+    "(v (c-val gr (cond ((= t 4) 5) ((= t 5) 4) (else t)) lr c))"
+)
+_INVERSE_TRANSFORM = {0: 0, 1: 1, 2: 2, 3: 3, 4: 5, 5: 4, 6: 6, 7: 7}
+_DIFFICULTIES = ("easy", "medium", "hard", None)
+_QUARTER_TURNS = ("rotate_cw", "rotate_ccw")
+
+
+def _validate_seed(seed: Any) -> int:
+    if type(seed) is not int:
+        raise TypeError("seed must be an integer (not bool)")
+    return seed
+
+
+def validate_setting(setting: Any) -> str:
+    if type(setting) is not str:
+        raise TypeError("application_direction must be a string")
+    if setting not in SETTINGS:
+        raise ValueError(f"application_direction must be one of {SETTINGS}")
+    return setting
+
+
+def setting_key(setting: str) -> str:
+    return validate_setting(setting)
+
+
+def choose_setting(seed: int) -> str:
+    """Choose one hidden application direction for the complete episode."""
+    seed = _validate_seed(seed)
+    digest = hashlib.sha256(
+        f"{TASK_ID}|{PROTOTYPE_VERSION}|episode-setting|{seed}".encode()
+    ).digest()
+    return SETTINGS[int.from_bytes(digest[:8], "big") % len(SETTINGS)]
+
+
+@lru_cache(maxsize=1)
+def canonical_program() -> str:
+    root = find_root(__file__)
+    programs: set[str] = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise RuntimeError(
+            f"expected one unique canonical program for {TASK_ID}, found {len(programs)}"
+        )
+    return programs.pop()
+
+
+def _replace_once(source: str, old: str, new: str) -> str:
+    count = source.count(old)
+    if count != 1:
+        raise RuntimeError(f"canonical rule drift: expected one {old!r}, found {count}")
+    return source.replace(old, new, 1)
+
+
+def program_for(setting: str = DEFAULT_SETTING) -> str:
+    """Return exact Racket source for one proposed application direction."""
+    setting = validate_setting(setting)
+    source = canonical_program()
+    if setting == DEFAULT_SETTING:
+        if source.count(_CANONICAL_C_BINDING) != 1:
+            raise RuntimeError("canonical C-transform binding drifted")
+        return source
+    return _replace_once(source, _CANONICAL_C_BINDING, _INVERSE_C_BINDING)
+
+
+@lru_cache(maxsize=1)
+def _selected_generator():
+    root = find_root(__file__)
+    return load_selected_generator(TASK_ID, root=root)
+
+
+def apply_setting(grid: Any, setting: str = DEFAULT_SETTING) -> list[list[int]]:
+    """Apply one direction using the selected generator's exact band analysis."""
+    setting = validate_setting(setting)
+    generator, _source_path, _source_sha256 = _selected_generator()
+    info, errors = generator._analyze(grid)
+    if errors:
+        raise ValueError("; ".join(errors))
+
+    output = [[0 for _ in range(2)] for _ in range(info["height"])]
+    for band in info["bands"]:
+        transform = band["transform"]
+        if setting == "inverse":
+            transform = _INVERSE_TRANSFORM[transform]
+        generator._render_band(output, band, transform, band["mapping"])
+    return output
+
+
+def _candidate_seed(seed: int, split: str, index: int, attempt: int) -> int:
+    payload = (
+        f"{TASK_ID}|{PROTOTYPE_VERSION}|input|{seed}|{split}|{index}|{attempt}"
+    ).encode()
+    return int.from_bytes(hashlib.sha256(payload).digest()[:8], "big")
+
+
+def _input_spec(split: str, index: int) -> dict[str, Any]:
+    if split == "train":
+        offset = index
+    elif split == "test":
+        offset = index + 17
+    else:
+        raise ValueError(f"unknown split: {split}")
+    return {
+        "sample_index": offset,
+        "n_bands": 3 + (offset % 2),
+        "first_transform": _QUARTER_TURNS[offset % len(_QUARTER_TURNS)],
+        "difficulty": _DIFFICULTIES[offset % len(_DIFFICULTIES)],
+    }
+
+
+def _build_input(
+    generator: Any,
+    *,
+    seed: int,
+    split: str,
+    index: int,
+    used: set[str],
+) -> tuple[list[list[int]], dict[str, Any]]:
+    spec = _input_spec(split, index)
+    for attempt in range(512):
+        draw_seed = _candidate_seed(seed, split, index, attempt)
+        grid = generator.generate(
+            draw_seed,
+            spec["sample_index"],
+            difficulty=spec["difficulty"],
+            n_bands=spec["n_bands"],
+            first_transform=spec["first_transform"],
+        )
+        encoded = json.dumps(grid, separators=(",", ":"))
+        if encoded in used:
+            continue
+        if generator.self_check(grid, difficulty=spec["difficulty"]):
+            continue
+        if apply_setting(grid, "forward") == apply_setting(grid, "inverse"):
+            continue
+        observed = generator.observe_overrides(grid)
+        if observed != {
+            "n_bands": spec["n_bands"],
+            "first_transform": spec["first_transform"],
+        }:
+            raise RuntimeError(
+                f"selected generator realized {observed}, expected input spec {spec}"
+            )
+        used.add(encoded)
+        return grid, {
+            "split": split,
+            "index": index,
+            "draw_seed": draw_seed,
+            "attempt": attempt,
+            **spec,
+        }
+    raise RuntimeError(
+        f"could not draw a unique direction-distinguishing {split}[{index}] "
+        "after 512 attempts"
+    )
+
+
+def build_episode(
+    seed: int,
+    *,
+    application_direction: str | None = None,
+    n_train: int = MIN_TRAIN,
+    n_test: int = MIN_TEST,
+) -> dict[str, Any]:
+    """Build an episode with one fixed setting, four demos, and four queries."""
+    seed = _validate_seed(seed)
+    if type(n_train) is not int or n_train < MIN_TRAIN:
+        raise ValueError(f"n_train must be an integer >= {MIN_TRAIN}")
+    if type(n_test) is not int or n_test < MIN_TEST:
+        raise ValueError(f"n_test must be an integer >= {MIN_TEST}")
+    selected = (
+        choose_setting(seed)
+        if application_direction is None
+        else validate_setting(application_direction)
+    )
+
+    generator, source_path, source_sha256 = _selected_generator()
+    used: set[str] = set()
+    splits: dict[str, list[dict[str, Any]]] = {"train": [], "test": []}
+    for split, count in (("train", n_train), ("test", n_test)):
+        for index in range(count):
+            grid, sampling = _build_input(
+                generator,
+                seed=seed,
+                split=split,
+                index=index,
+                used=used,
+            )
+            splits[split].append(
+                {
+                    "input": grid,
+                    "output": apply_setting(grid, selected),
+                    "sampling": sampling,
+                }
+            )
+
+    return {
+        "schema": "4c26a1072222-parametric-episode-v1",
+        "scope": "proposed task-local prototype; not selected canonical execution",
+        "task_id": TASK_ID,
+        "prototype_version": PROTOTYPE_VERSION,
+        "seed": seed,
+        "parameters": {"application_direction": selected},
+        "program": program_for(selected),
+        "generator_source": str(source_path),
+        "generator_sha256": source_sha256,
+        "train": splits["train"],
+        "test": splits["test"],
+    }
+
+
+def setting_from_parameters(parameters: Any) -> str:
+    if not isinstance(parameters, dict):
+        raise TypeError("parameters must be a mapping")
+    return validate_setting(parameters.get("application_direction"))
+
+
+def setting_survivors(demos: Iterable[dict[str, Any]]) -> list[str]:
+    demos = list(demos)
+    survivors: list[str] = []
+    for candidate in SETTINGS:
+        try:
+            if all(
+                isinstance(pair, dict)
+                and pair.get("output") == apply_setting(pair.get("input"), candidate)
+                for pair in demos
+            ):
+                survivors.append(candidate)
+        except (TypeError, ValueError):
+            continue
+    return survivors
+
+
+def episode_errors(episode: Any) -> list[str]:
+    errors: list[str] = []
+    if not isinstance(episode, dict):
+        return ["episode must be a mapping"]
+    try:
+        selected = setting_from_parameters(episode.get("parameters"))
+    except (TypeError, ValueError) as exc:
+        return [f"invalid parameters: {exc}"]
+    if episode.get("program") != program_for(selected):
+        errors.append("program does not match the fixed setting")
+
+    generator, _source_path, current_sha = _selected_generator()
+    if episode.get("generator_sha256") != current_sha:
+        errors.append("selected generator source hash drifted")
+
+    seen: set[str] = set()
+    for split, minimum in (("train", MIN_TRAIN), ("test", MIN_TEST)):
+        pairs = episode.get(split)
+        if not isinstance(pairs, list) or len(pairs) < minimum:
+            errors.append(f"{split} must contain at least {minimum} pairs")
+            continue
+        for index, pair in enumerate(pairs):
+            if not isinstance(pair, dict) or "input" not in pair or "output" not in pair:
+                errors.append(f"{split}[{index}] lacks input/output")
+                continue
+            try:
+                grammar_errors = generator.self_check(pair["input"])
+                if grammar_errors:
+                    errors.append(
+                        f"{split}[{index}] outside selected grammar: {grammar_errors}"
+                    )
+                expected = apply_setting(pair["input"], selected)
+                if pair["output"] != expected:
+                    errors.append(f"{split}[{index}] label mismatches fixed setting")
+                if apply_setting(pair["input"], "forward") == apply_setting(
+                    pair["input"], "inverse"
+                ):
+                    errors.append(f"{split}[{index}] does not distinguish settings")
+                encoded = json.dumps(pair["input"], separators=(",", ":"))
+                if encoded in seen:
+                    errors.append(f"{split}[{index}] duplicates another episode input")
+                seen.add(encoded)
+            except (TypeError, ValueError) as exc:
+                errors.append(f"{split}[{index}] invalid: {exc}")
+
+    train = episode.get("train")
+    if isinstance(train, list) and len(train) >= MIN_TRAIN:
+        survivors = setting_survivors(train)
+        if survivors != [selected]:
+            errors.append(
+                "demonstrations do not uniquely identify the fixed setting: "
+                + ", ".join(survivors)
+            )
+    return errors
+
+
+def public_projection(episode: dict[str, Any]) -> dict[str, Any]:
+    """Return only visible demonstrations and query inputs."""
+    if not isinstance(episode, dict):
+        raise ValueError("episode must be a mapping")
+    train = episode.get("train")
+    test = episode.get("test")
+    if not isinstance(train, list) or not train or not isinstance(test, list) or not test:
+        raise ValueError("episode must contain nonempty train and test lists")
+    try:
+        return {
+            "train": [
+                {
+                    "input": deepcopy(pair["input"]),
+                    "output": deepcopy(pair["output"]),
+                }
+                for pair in train
+            ],
+            "test": [{"input": deepcopy(pair["input"])} for pair in test],
+        }
+    except (KeyError, TypeError) as exc:
+        raise ValueError("visible pairs are malformed") from exc
+
+
+def public_identifier(episode: dict[str, Any]) -> str:
+    return public_challenge_id(public_projection(episode))
