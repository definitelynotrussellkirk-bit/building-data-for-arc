+#!/usr/bin/env python3
+"""Bounded source-bound rival probe; protected Racket supplies all labels."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+def bounding_box_stamp(gen, grid):
+    """Wrong rule: translate each whole 2x2 bbox, retaining pass precedence."""
+    out = [row[:] for row in grid]
+    h, w = len(grid), len(grid[0])
+    for source, fill in ((5, 4), (2, 3)):
+        for component in gen._components(grid):
+            if component["color"] != source:
+                continue
+            dr, dc = gen._shift(source, component["shape_index"])
+            for r in range(component["row0"], component["row0"] + 2):
+                for c in range(component["col0"], component["col0"] + 2):
+                    rr, cc = r + dr, c + dc
+                    if 0 <= rr < h and 0 <= cc < w:
+                        out[rr][cc] = fill
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", required=True, type=Path)
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    root = args.root.resolve()
+    sys.path.insert(0, str(root / "shared/runtime"))
+    from reviewer_support import load_selected_generator
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+    gen, source, digest = load_selected_generator("e99db71ae23d", root=root)
+    authority = root / "shared/data/base/solutions/training/1e5d6875__e99db71ae23d.json"
+    program = json.loads(authority.read_text())["racket_target"]["target_code"]
+    report = {
+        "schema": "bounded-peer-rival-probe-v1", "task_id": gen.TASK_ID,
+        "generator_sha256": digest, "rule_hash": gen.RULE_HASH,
+        "program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "source_path": str(source.relative_to(root)),
+        "authority_path": str(authority.relative_to(root)),
+        "argv": sys.argv, "seed": 0, "difficulty": "hard",
+        "rival": "translate_filled_bbox_instead_of_L",
+        "rival_description": bounding_box_stamp.__doc__, "pairs": [],
+        "limits": "One seed, four default pairs, one rival. No full battery, exhaustive ambiguity claim, parametric admission, or owner acceptance."
+    }
+    bridge = RacketBridge()
+    try:
+        report["runtime_identity"] = bridge.runtime_identity
+        assert bridge.runtime_identity["backend"] == "racket"
+        assert bridge.runtime_identity["protected"] is True
+        for index in range(4):
+            grid = gen.generate(0, index, difficulty="hard")
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            output = bridge.eval_text(f"({wrap_rule(program)} {literal})")
+            rival = bounding_box_stamp(gen, grid)
