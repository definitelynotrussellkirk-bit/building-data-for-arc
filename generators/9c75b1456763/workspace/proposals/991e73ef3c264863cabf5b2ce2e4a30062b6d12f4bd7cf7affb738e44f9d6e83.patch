+"""Bounded production-only hole-filled-area rival; run via packet review.py run.
+
+prepare writes inputs; public arcpuzzles apply supplies protected Racket labels;
+finalize compares those labels. It neither changes production nor qualifies it.
+"""
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+TASK = "41a5c2fcf25a"
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "shared/runtime"))
+from reviewer_support import canonical_pairs, load_selected_generator
+
+GEN, SOURCE, SOURCE_SHA = load_selected_generator(TASK, root=ROOT)
+OUT = ROOT.parent / "checks" / TASK
+DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def components(grid):
+    pending = {(r, c) for r in range(1, len(grid))
+               for c in range(len(grid[0])) if grid[r][c]}
+    found = []
+    while pending:
+        first = min(pending)
+        pending.remove(first)
+        cells, todo = {first}, [first]
+        while todo:
+            r, c = todo.pop()
+            for dr, dc in DIRS:
+                point = (r + dr, c + dc)
+                if point in pending:
+                    pending.remove(point)
+                    cells.add(point)
+                    todo.append(point)
+        found.append(cells)
+    return found
+
+
+def filled_area(cells):
+    lo_r, hi_r = min(r for r, c in cells) - 1, max(r for r, c in cells) + 1
+    lo_c, hi_c = min(c for r, c in cells) - 1, max(c for r, c in cells) + 1
+    outside, todo = {(lo_r, lo_c)}, [(lo_r, lo_c)]
+    while todo:
+        r, c = todo.pop()
+        for dr, dc in DIRS:
+            point = (r + dr, c + dc)
+            if (lo_r <= point[0] <= hi_r and lo_c <= point[1] <= hi_c
+                    and point not in cells and point not in outside):
+                outside.add(point)
+                todo.append(point)
+    return (hi_r - lo_r + 1) * (hi_c - lo_c + 1) - len(outside)
+
+
+def solve(grid, *, fill_holes=False):
+    out = deepcopy(grid)
+    area = filled_area if fill_holes else len
+    ordered = sorted(components(grid), key=lambda cells:
+                     (-area(cells), min(r for r, c in cells), min(c for r, c in cells)))
+    for color, cells in zip([c for c in grid[0] if c], ordered):
+        for r, c in cells:
+            out[r][c] = color
+    return out
+
+
+def dump(name, value):
+    OUT.mkdir(parents=True, exist_ok=True)
+    (OUT / name).write_text(json.dumps(value, indent=2) + "\n")
+
+
+def prepare():
+    witness = [[0] * 11 for _ in range(10)]
+    witness[0][:2] = [2, 3]
+    for r in (2, 3):
+        for c in (1, 2, 3, 4):
+            witness[r][c] = 8
+    for r in (6, 7, 8):
+        for c in (7, 8, 9):
+            if (r, c) != (7, 8):
+                witness[r][c] = 8
+    cases = [{"kind": "witness", "name": "solid_eight_before_ring_eight", "input": witness}]
+    for n in (2, 3, 4):
+        for index in range(4):
+            cases.append({"kind": "generated", "seed": 17, "sample_index": index,
+                          "difficulty": None, "overrides": {"n_blobs": n},
+                          "input": GEN.generate(17, index, n_blobs=n)})
+    for pair in canonical_pairs(TASK, root=ROOT, labeled_only=True):
+        cases.append({"kind": "canonical", "input": pair["input"],
+                      "canonical_output": pair["output"]})
+    shapes = [set(shape) for choices in GEN._SHAPES.values() for shape in choices]
+    report = {"task_id": TASK, "generator_sha256": SOURCE_SHA,
+              "rule_hash": GEN.RULE_HASH, "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "rival": "rank by component area after filling enclosed background; recolor original cells only",
+              "witness_self_check": GEN.self_check(witness),
+              "witness_strict_canonical_like": GEN.strict_canonical_like(witness),
+              "witness_true_areas": [len(c) for c in components(witness)],
+              "witness_filled_areas": [filled_area(c) for c in components(witness)],
+              "shape_support_count": len(shapes),
+              "shape_support_with_holes": sum(filled_area(c) != len(c) for c in shapes),
+              "actual_racket_pending": True,
+              "scope": "One declared finite rival, 12 generated draws, canonical pairs and one constructed witness; no full battery or parametric audit."}
+    dump("peer-cases.json", cases)
+    dump("peer-inputs.json", [case["input"] for case in cases])
+    dump("peer-summary.json", report)
+    assert not report["witness_self_check"] and not report["witness_strict_canonical_like"]
+    assert report["witness_true_areas"] == [8, 8] and report["witness_filled_areas"] == [8, 9]
+    assert report["shape_support_with_holes"] == 0
+    print(json.dumps(report))
+
+
+def finalize():
+    report = json.loads((OUT / "peer-summary.json").read_text())
+    cases = json.loads((OUT / "peer-cases.json").read_text())
+    actual = json.loads((OUT / "peer-racket.json").read_text())
+    assert actual["generator_sha256"] == SOURCE_SHA == report["generator_sha256"]
+    assert actual["executed_rule_hash"] == GEN.RULE_HASH
+    assert len(actual["results"]) == len(cases)
+    counts = {kind: {"count": 0, "rival_matches": 0} for kind in ("witness", "generated", "canonical")}
+    for case, row in zip(cases, actual["results"]):
+        assert row["input"] == case["input"] and row["valid_output"] and not row["error"]
+        assert row["output"] == solve(case["input"])
+        if case["kind"] == "canonical":
+            assert row["output"] == case["canonical_output"]
+        counts[case["kind"]]["count"] += 1
+        counts[case["kind"]]["rival_matches"] += row["output"] == solve(case["input"], fill_holes=True)
+        if case["kind"] == "witness":
+            dump("peer-witness.json", {**case, "actual_racket_output": row["output"],
+                                       "rival_output": solve(case["input"], fill_holes=True),
+                                       "generator_sha256": SOURCE_SHA, "rule_hash": GEN.RULE_HASH})
+    generated = [(case, row) for case, row in zip(cases, actual["results"])
+                 if case["kind"] == "generated"]
+    lessons = []
+    for n in (2, 3, 4):
+        pairs = [(case, row) for case, row in generated if case["overrides"]["n_blobs"] == n]
+        lessons.append({"seed": 17, "overrides": {"n_blobs": n},
+                        "train": [{"sample_index": c["sample_index"], "input": c["input"],
+                                   "output": row["output"]} for c, row in pairs[:3]],
+                        "test": [{"sample_index": pairs[3][0]["sample_index"],
+                                  "input": pairs[3][0]["input"],
+                                  "actual_racket_output": pairs[3][1]["output"],
+                                  "python_rival_output": solve(pairs[3][0]["input"], fill_holes=True)}]})
+    dump("peer-lessons.json", {"generator_sha256": SOURCE_SHA, "rule_hash": GEN.RULE_HASH,
+                               "label_source": "Protected Racket; rival outputs explicitly Python",
+                               "lessons": lessons})
+    report.update(actual_racket_pending=False, actual_results=counts,
+                  rule_text_sha256=actual["rule_text_sha256"],
+                  outcome="confirmed production support blind spot for one finite rival; no incorrect generated label or control defect found")
+    dump("peer-summary.json", report)
+    print(json.dumps(report))
+    assert counts["witness"] == {"count": 1, "rival_matches": 0}
+    assert counts["generated"] == {"count": 12, "rival_matches": 12}
+    assert counts["canonical"]["count"] == counts["canonical"]["rival_matches"]
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("phase", choices=("prepare", "finalize"))
+    args = parser.parse_args()
+    (prepare if args.phase == "prepare" else finalize)()
