(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g))
                (blued (recolor-map* g (hash 2 1 3 1 4 1 5 1 6 1 7 1 8 1 9 1)))
                (comps (objects blued 0)))
           (reduce (lambda (acc comp)
                     (let* ((marker-colors (filter (lambda (v) (and (!= v 0) (!= v 1)))
                                                   (map (lambda (cell)
                                                          (at g (fst cell) (snd cell)))
                                                        (obj-cells comp))))
                            (mc (if (empty? marker-colors) #f (first marker-colors))))
                       (if mc
                           (reduce (lambda (a cell)
                                     (let* ((r (fst cell))
                                            (c (snd cell)))
                                       (if (and
                                             (> r 0)
                                             (< r (- h 1))
                                             (> c 0)
                                             (< c (- w 1))
                                             (!= (at blued (- r 1) c) 0)
                                             (!= (at blued (+ r 1) c) 0)
                                             (!= (at blued r (- c 1)) 0)
                                             (!= (at blued r (+ c 1)) 0)
                                             (!= (at blued (- r 1) (- c 1)) 0)
                                             (!= (at blued (- r 1) (+ c 1)) 0)
                                             (!= (at blued (+ r 1) (- c 1)) 0)
                                             (!= (at blued (+ r 1) (+ c 1)) 0))
                                           (set-cell a r c mc)
                                           a)))
                                   acc
                                   (obj-cells comp))
                           acc)))
                   g
                   comps))))