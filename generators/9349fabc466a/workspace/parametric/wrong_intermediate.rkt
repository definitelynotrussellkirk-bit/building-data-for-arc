(rule!
  (let ((colors (grid-colors g 0)))
    (define (span-stage)
      (grid-from-fn (rows g) (cols g)
        (lambda (r c)
          (let ((v (at g r c)))
            (if (not (= v 0))
                v
                (let ((fill-color
                        (find-first
                          (lambda (color)
                            (let ((pts (find-color g color)))
                              (or
                                (any? (lambda (p1) (any? (lambda (p2)
                                  (and (= (first p1) r) (= (first p2) r)
                                       (<= (min (second p1) (second p2)) c)
                                       (<= c (max (second p1) (second p2))))) pts)) pts)
                                (any? (lambda (p1) (any? (lambda (p2)
                                  (and (= (second p1) c) (= (second p2) c)
                                       (<= (min (first p1) (first p2)) r)
                                       (<= r (max (first p1) (first p2))))) pts)) pts))))
                          colors)))
                  (if fill-color fill-color 0)))))))
    (define stage (span-stage))
    (define (marker-box color)
      (let* ((pts (find-color g color))
             (rs (map first pts))
             (cs (map second pts)))
        (list (apply min rs) (apply max rs) (apply min cs) (apply max cs))))
    (define (box-area box)
      (* (+ 1 (- (second box) (first box)))
         (+ 1 (- (fourth box) (third box)))))
    (define ranked
      (sort colors
        (lambda (a b)
          (let ((aa (box-area (marker-box a))) (bb (box-area (marker-box b))))
            (or (> aa bb) (and (= aa bb) (< a b)))))))
    (define box (marker-box (first ranked)))
    (define top (max 0 (- (first box) 1)))
    (define bottom (min (- (rows g) 1) (+ (second box) 1)))
    (define left (max 0 (- (third box) 1)))
    (define right (min (- (cols g) 1) (+ (fourth box) 1)))
    (grid-from-fn (rows g) (cols g)
      (lambda (r c)
        (let ((v (at stage r c)))
          (if (not (= v 0)) v
              (if (or (and (or (= r top) (= r bottom)) (<= left c) (<= c right))
                      (and (or (= c left) (= c right)) (<= top r) (<= r bottom)))
                  9 0)))))))
