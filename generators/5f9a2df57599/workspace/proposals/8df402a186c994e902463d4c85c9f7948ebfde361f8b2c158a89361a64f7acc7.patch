+"""Bounded, actual-draw teaching probe for the fold-orientation decision.
+
+This authors a diagnostic three-demo/one-query lesson from ordinary default
+generator calls. It does not claim that a native episode issuer selected that
+lesson, alter production, or grant any approval.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+
+TASK_ID = "5955ced85d5c"
+ROOT = Path(__file__).resolve().parents[3]
+EXPECTED_SOURCE = "d7f673a3cbf6442cadc28edd4e138b2b4fd3daede450820f6c974b52bb7ee523"
+EXPECTED_RULE_HASH = "fe6070160080"
+ANCHOR = "(vertical-fold (> (* dr dr) (* dc dc)))"
+
+
+def raw(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+def sha(value):
+    return hashlib.sha256(value.encode() if isinstance(value, str) else value).hexdigest()
+
+
+def selected_program():
+    catalog = Catalog(ROOT)
+    description = catalog.describe(TASK_ID)
+    sources = {row["program_solution"] for row in catalog.get(TASK_ID)["variants"]
+               if isinstance(row.get("program_solution"), str)}
+    if len(sources) != 1 or description["rule_hash"] != EXPECTED_RULE_HASH:
+        raise ValueError("selected canonical rule binding changed")
+    return next(iter(sources)), description
+
+
+def source_binding():
+    program, description = selected_program()
+    files = [ROOT / f"generators/{TASK_ID}/generator.py", Path(__file__).resolve(),
+             ROOT / "src/arcpuzzles/parametric_worker.py",
+             ROOT / "shared/runtime/puzzle_generators/rule_wrap.py",
+             ROOT / "shared/runtime/reviewer_support.py"]
+    return {
+        "source_sha256": description["generator_sha256"],
+        "rule_hash": description["rule_hash"], "canonical_program_sha256": sha(program),
+        "files": {path.relative_to(ROOT).as_posix(): sha(path.read_bytes()) for path in files},
+    }
+
+
+def orientation(grid):
+    reds = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 2]
+    rows, cols = {r for r, _ in reds}, {c for _, c in reds}
+    if len(rows) == 1 and len(cols) > 1:
+        return "horizontal_red_line"
+    if len(cols) == 1 and len(rows) > 1:
+        return "vertical_red_line"
+    raise ValueError("draw does not contain a nontrivial straight red fold")
+
+
+def probe(out):
+    destination = Path(out)
+    if destination.exists():
+        raise FileExistsError(destination)
+    binding = source_binding()
+    generator, generator_path, actual_source = load_selected_generator(TASK_ID, root=ROOT)
+    if actual_source != EXPECTED_SOURCE or binding["source_sha256"] != EXPECTED_SOURCE:
+        raise ValueError("production source differs from the reviewed target")
+    intended, description = selected_program()
+    if intended.count(ANCHOR) != 1:
+        raise ValueError("canonical orientation decision is not uniquely anchored")
+
+    searches, chosen = [], None
+    generation_errors = []
+    # Only input geometry determines the diagnostic case. No query output is
+    # used to select either the orientation-fixed hypothesis or its program.
+    for seed in range(16):
+        draws = []
+        for index in range(4):
+            request = {"seed": seed, "sample_index": index, "difficulty": None, "overrides": {}}
+            try:
+                grid = generator.generate(seed, index, difficulty=None)
+                errors = generator.self_check(grid, difficulty=None)
+                if errors:
+                    raise ValueError("self_check: " + "; ".join(errors))
+                row = {"request": request, "input": _grid(grid), "orientation": orientation(grid),
+                       "self_check": errors, "input_sha256": sha(raw(grid))}
+                draws.append(row)
+                searches.append({key: value for key, value in row.items() if key != "input"})
+            except Exception as error:
+                generation_errors.append({"request": request, "error": repr(error)})
+        if len(draws) != 4:
+            continue
+        taught = {row["orientation"] for row in draws[:3]}
+        if len(taught) == 1 and draws[3]["orientation"] not in taught:
+            chosen = draws
+            break
+
+    if chosen is None:
+        result = {"schema": "arcpuzzles-peer-fold-orientation-probe-v1",
+                  "task_id": TASK_ID, "status": "no_diagnostic_lesson_in_bounded_search",
+                  "source_binding": binding, "search": searches, "generation_errors": generation_errors,
+                  "limits": ["At most sixteen seeds and four actual default draws per seed; no broader search.",
+                             "No Racket comparisons were run because the diagnostic input pattern was absent."]}
+        destination.mkdir(parents=True)
+        (destination / "report.json").write_bytes(raw(result))
+        return result
+
+    taught_orientation = chosen[0]["orientation"]
+    constant = "(= 1 1)" if taught_orientation == "horizontal_red_line" else "(= 1 0)"
+    rival = intended.replace(ANCHOR, f"(vertical-fold {constant})", 1)
+    claims = []
+    with _local_imports(ROOT / "shared/runtime", generator_path.parent):
+        execute, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            if identity.get("backend") != "racket" or identity.get("protected") is not True:
+                raise ValueError("the probe requires actual protected Racket")
+            for row in chosen[:3]:
+                actual, wrong = _grid(execute(intended, row["input"])), _grid(execute(rival, row["input"]))
+                claims.append({**row, "output": actual, "rival_output": wrong,
+                               "exact_match": actual == wrong})
+            # Freeze the demo-only version space before executing the query.
+            survives = all(row["exact_match"] for row in claims)
+            frozen_survivors = ["intended", "fixed_orientation"] if survives else ["intended"]
+            query = chosen[3]
+            actual, wrong = _grid(execute(intended, query["input"])), _grid(execute(rival, query["input"]))
+            query = {**query, "output": actual, "rival_output": wrong,
+                     "exact_match": actual == wrong,
+                     "differing_cells": [[r, c] for r in range(len(actual)) for c in range(len(actual[0]))
+                                          if actual[r][c] != wrong[r][c]]}
+        finally:
+            bridge.close()
+    if source_binding() != binding:
+        raise ValueError("source changed while probing")
+    reproduced = survives and not query["exact_match"]
+    lesson = {
+        "schema": "arcpuzzles-authored-direct-draw-lesson-v1", "task_id": TASK_ID,
+        "provenance": "Reviewer-authored lesson from four actual default generator calls; not a native-issued episode.",
+        "train": claims, "test": [query],
+        "programs": {"intended": intended, "fixed_orientation": rival},
+        "demo_survivors_frozen_before_query_execution": frozen_survivors,
+        "rival_selected_from_demo_inputs_only": True,
+        "query_input_used_to_choose_diagnostic_case": True,
+        "query_labels_used_to_fit_rival": False,
+    }
+    result = {
+        "schema": "arcpuzzles-peer-fold-orientation-probe-v1", "task_id": TASK_ID,
+        "status": "teaching_gap_reproduced" if reproduced else "rival_did_not_reproduce_gap",
+        "source_binding": binding, "racket": identity,
+        "counts": {"candidate_seeds": len({row["request"]["seed"] for row in searches}),
+                   "actual_generator_draws": len(searches), "generation_errors": len(generation_errors),
+                   "retained_demo_inputs": 3, "retained_query_inputs": 1, "protected_racket_evaluations": 8},
+        "selected_seed": chosen[0]["request"]["seed"],
+        "demo_orientation": taught_orientation, "query_orientation": query["orientation"],
+        "rival": "Fix reflection orientation to the one shown in every demo; retain the exact centroid-side, half-cell-axis, color, and painting logic.",
+        "program_sha256": {"intended": sha(intended), "fixed_orientation": sha(rival)},
+        "demo_exact_matches": [row["exact_match"] for row in claims],
+        "query_exact_match": query["exact_match"], "query_differing_cells": len(query["differing_cells"]),
+        "demo_survivors_frozen_before_query_execution": frozen_survivors,
+        "generation_errors": generation_errors,
+        "limits": [
+            "One reviewer-authored direct-draw lesson, not evidence that a native episode issuer selected it.",
+            "Input geometry selected this diagnostic lesson within a sixteen-seed cap; this is not an unbiased failure-rate estimate.",
+            "Only one orientation-fixed rival was tested; no universal ambiguity or identifiability conclusion.",
+            "No production, canonical rule, audit-index, or approval changes; prior control and reverse-side-support findings remain unresolved.",
+        ],
+    }
+    destination.mkdir(parents=True)
+    for name, value in (("lesson.json", lesson), ("search.json", searches), ("report.json", result)):
+        (destination / name).write_bytes(raw(value))
+    (destination / "intended.rkt").write_text(intended)
+    (destination / "fixed-orientation.rkt").write_text(rival)
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    options = parser.parse_args(argv)
+    result = probe(options.out)
+    print(json.dumps({key: result[key] for key in ("status", "counts", "selected_seed", "demo_exact_matches", "query_exact_match", "query_differing_cells") if key in result}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
