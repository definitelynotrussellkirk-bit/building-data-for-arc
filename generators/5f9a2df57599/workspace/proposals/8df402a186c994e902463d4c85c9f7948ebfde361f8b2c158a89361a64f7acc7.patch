+#!/usr/bin/env python3
+"""Bounded authored-lesson audit of BFS neighbor-order teaching.
+
+Screen exactly three consecutive four-draw windows and their query rotations in
+independent Python.  Freeze each demo version space before consulting its query.
+Replay one retained intended/rival lesson and the four original canonical pairs
+through the current same-checkout protected native evaluator.  This probe does
+not issue native episodes, change production, or grant any approval.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter, deque
+from copy import deepcopy
+import hashlib
+import itertools
+import json
+from pathlib import Path
+import sys
+
+TASK_ID = "6a289c5b0897"
+REPO = Path(__file__).resolve().parents[3]
+SEEDS = (0, 17, 101)
+ORDER_ANCHOR = "(define dirs4-ordered (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))"
+STEPS = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
+ORDERS = tuple("".join(order) for order in itertools.permutations("UDLR"))
+
+
+def raw(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+def digest(value):
+    return hashlib.sha256(raw(value)).hexdigest()
+
+
+def program_hash(program):
+    return hashlib.sha256(program.encode()).hexdigest()
+
+
+def python_bfs(grid, order="UDLR"):
+    """Fresh queue/predecessor implementation, not the generator mirror."""
+    if order not in ORDERS:
+        raise ValueError("expected a permutation of UDLR")
+    counts = Counter(cell for row in grid for cell in row)
+    terminals = [color for color, count in counts.items() if color not in (0, 5) and count == 2]
+    if len(terminals) != 1:
+        raise ValueError("expected exactly one terminal color")
+    color = terminals[0]
+    points = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == color]
+    start, goal = points
+    previous = {start: None}
+    queue = deque([start])
+    while queue:
+        current = queue.popleft()
+        if current == goal:
+            break
+        for direction in order:
+            dr, dc = STEPS[direction]
+            neighbor = (current[0] + dr, current[1] + dc)
+            r, c = neighbor
+            if (0 <= r < len(grid) and 0 <= c < len(grid[0])
+                    and neighbor not in previous and grid[r][c] in (0, color)):
+                previous[neighbor] = current
+                queue.append(neighbor)
+    output = [[0] * len(grid[0]) for _ in grid]
+    if goal not in previous:
+        return output
+    current = goal
+    while current is not None:
+        output[current[0]][current[1]] = color
+        current = previous[current]
+    return output
+
+
+def ordered_program(canonical, order):
+    if order not in ORDERS or canonical.count(ORDER_ANCHOR) != 1:
+        raise ValueError("canonical order anchor must be unique and order declared")
+    if order == "UDLR":
+        return canonical
+    replacement = "(define dirs4-ordered (list " + " ".join(
+        f"(list {STEPS[d][0]} {STEPS[d][1]})" for d in order) + "))"
+    return canonical.replace(ORDER_ANCHOR, replacement, 1)
+
+
+def screen(generator):
+    windows, rows, findings = [], [], []
+    for seed in SEEDS:
+        grids = [generator.generate(seed, index, difficulty="medium") for index in range(4)]
+        if len({digest(grid) for grid in grids}) != 4:
+            raise ValueError("the four authored direct draws must be distinct")
+        if any(generator.self_check(grid) for grid in grids):
+            raise ValueError("a direct draw failed the current production validator")
+        windows.append({"seed": seed, "difficulty": "medium", "sample_indices": list(range(4)),
+                        "inputs": grids,
+                        "schedule_profiles": [generator.schedule_profile(seed, i, "medium") for i in range(4)]})
+        for held_out in range(4):
+            demo_indices = [i for i in range(4) if i != held_out]
+            demos = [{"input": grids[i], "output": python_bfs(grids[i])} for i in demo_indices]
+            # The query is not evaluated until this immutable demo-only set exists.
+            survivors = tuple(order for order in ORDERS if all(
+                python_bfs(pair["input"], order) == pair["output"] for pair in demos))
+            query = {"input": grids[held_out], "output": python_bfs(grids[held_out])}
+            disagreeing = [order for order in survivors
+                           if python_bfs(query["input"], order) != query["output"]]
+            row = {"seed": seed, "difficulty": "medium", "demo_sample_indices": demo_indices,
+                   "query_sample_index": held_out, "demo_survivors_before_query": list(survivors),
+                   "query_disagreeing_survivors": disagreeing,
+                   "selected_using_query_labels": False, "python_only": True}
+            rows.append(row)
+            if disagreeing:
+                # Selection of evidence occurs after the version-space test; it
+                # never selects a hypothesis for a learner or rewrites its demos.
+                preference = [order for order in ("URDL", "RUDL", "RDLU") if order in disagreeing]
+                order = preference[0] if preference else disagreeing[0]
+                findings.append({"screen": row, "train": demos, "query": query, "rival_order": order})
+    if findings:
+        retained = findings[0]
+    else:
+        first = windows[0]
+        retained = {"screen": rows[3], "train": [{"input": first["inputs"][i],
+                    "output": python_bfs(first["inputs"][i])} for i in range(3)],
+                    "query": {"input": first["inputs"][3], "output": python_bfs(first["inputs"][3])},
+                    "rival_order": "LDRU"}
+    return {"declared_orders": list(ORDERS), "windows": windows, "rotations": rows,
+            "rotation_count": len(rows), "ambiguous_rotations": len(findings),
+            "retained": retained, "racket_evaluations": 0}
+
+
+def run(out):
+    from arcpuzzles import Catalog
+    from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+    from reviewer_support import canonical_pairs, load_selected_generator
+
+    out = Path(out).resolve()
+    if out.exists():
+        raise FileExistsError("evidence destination must be new")
+    catalog = Catalog(REPO)
+    described = catalog.describe(TASK_ID)
+    record = catalog.get(TASK_ID)
+    candidates = {row["program_solution"] for row in record["variants"]
+                  if isinstance(row.get("program_solution"), str)}
+    if len(candidates) != 1:
+        raise ValueError("expected one exact canonical authority")
+    canonical = candidates.pop()
+    if program_hash(" ".join(canonical.split()))[:12] != described["rule_hash"]:
+        raise ValueError("canonical normalized hash does not match the catalog")
+    generator, source_path, source_sha = load_selected_generator(TASK_ID, root=REPO)
+    if source_sha != described["generator_sha256"]:
+        raise ValueError("selected generator source differs from catalog identity")
+    probe = screen(generator)
+    retained = probe["retained"]
+    order = retained["rival_order"]
+    rival = ordered_program(canonical, order)
+    originals = canonical_pairs(TASK_ID, root=REPO, labeled_only=True)
+    if len(originals) != 4:
+        raise ValueError("expected four original labeled canonical pairs")
+
+    runtime = REPO / "shared/runtime"
+    actual = []
+    with _local_imports(runtime, runtime):
+        from arc_repl.parser import parse_all, Symbol
+        for program in (canonical, rival):
+            forms = parse_all(program)
+            if len(forms) != 1 or len(forms[0]) != 2 or forms[0][0] != Symbol("rule!"):
+                raise ValueError("program must contain exactly one complete rule!")
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            groups = [("retained_demo", i, pair) for i, pair in enumerate(retained["train"])]
+            groups += [("retained_query", 0, retained["query"])]
+            groups += [("original_canonical", i, pair) for i, pair in enumerate(originals)]
+            for kind, index, pair in groups:
+                grid = _grid(pair["input"])
+                intended = _grid(apply(canonical, deepcopy(grid)))
+                competing = _grid(apply(rival, deepcopy(grid)))
+                if intended != pair["output"] or intended != python_bfs(grid):
+                    raise ValueError(f"intended Python/claimed/protected label mismatch at {kind}:{index}")
+                if competing != python_bfs(grid, order):
+                    raise ValueError(f"rival Python/protected label mismatch at {kind}:{index}")
+                actual.append({"kind": kind, "index": index, "input": grid,
+                               "output": intended, "rival_output": competing,
+                               "input_sha256": digest(grid), "output_sha256": digest(intended),
+                               "rival_output_sha256": digest(competing), "agrees": intended == competing})
+        finally:
+            bridge.close()
+    demo_rows = [row for row in actual if row["kind"] == "retained_demo"]
+    query_row = next(row for row in actual if row["kind"] == "retained_query")
+    canonical_rows = [row for row in actual if row["kind"] == "original_canonical"]
+    verified_gap = all(row["agrees"] for row in demo_rows) and not query_row["agrees"]
+    if bool(probe["ambiguous_rotations"]) != verified_gap:
+        raise ValueError("protected retained lesson does not substantiate screen result")
+    teaching_reasons = generator.lesson_identifiable(retained["train"], retained["query"])
+    current_sha = hashlib.sha256(source_path.read_bytes()).hexdigest()
+    if current_sha != source_sha:
+        raise ValueError("generator source changed during the probe")
+    out.mkdir(parents=True)
+    (out / "intended.rkt").write_text(canonical)
+    (out / "rival.rkt").write_text(rival)
+    (out / "python-screen.json").write_bytes(raw(probe))
+    (out / "protected-execution.json").write_bytes(raw({"racket": identity,
+        "actual_evaluations": 2 * len(actual), "cases": actual}))
+    lesson = {"task_id": TASK_ID, "provenance": "authored direct-draw lesson; not a native-issued or Catalog.generate episode",
+              "generator_request": {"seed": retained["screen"]["seed"], "difficulty": "medium",
+                                    "demo_sample_indices": retained["screen"]["demo_sample_indices"],
+                                    "query_sample_index": retained["screen"]["query_sample_index"],
+                                    "overrides": {}},
+              "train": [{"input": row["input"], "output": row["output"]} for row in demo_rows],
+              "test": [{"input": query_row["input"], "output": query_row["output"]}],
+              "program": canonical, "rival_program": rival, "rival_order": order,
+              "rival_demo_outputs": [row["rival_output"] for row in demo_rows],
+              "rival_query_output": query_row["rival_output"],
+              "demo_survivors_before_query": retained["screen"]["demo_survivors_before_query"],
+              "current_lesson_identifiable_reasons": teaching_reasons}
+    (out / "retained-lesson.json").write_bytes(raw(lesson))
+    report = {"task_id": TASK_ID, "outcome": "finding" if verified_gap else "no_issue",
+              "source_sha256": source_sha, "rule_hash": described["rule_hash"],
+              "canonical_program_sha256": program_hash(canonical), "rival_program_sha256": program_hash(rival),
+              "probe_source_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "source_binding": {"generator": source_path.relative_to(REPO).as_posix(),
+                                 "generator_sha256": source_sha,
+                                 "parametric_worker_sha256": hashlib.sha256((REPO / "src/arcpuzzles/parametric_worker.py").read_bytes()).hexdigest()},
+              "racket": identity, "actual_racket_evaluations": 2 * len(actual),
+              "python_screen": {"orders": len(ORDERS), "seeds": list(SEEDS), "inputs": 12,
+                                "rotations": probe["rotation_count"], "ambiguous_rotations": probe["ambiguous_rotations"]},
+              "retained_rival_order": order, "retained_generator_request": lesson["generator_request"],
+              "all_three_visible_demos_match": all(row["agrees"] for row in demo_rows),
+              "query_disagrees": not query_row["agrees"],
+              "canonical_rival_agreement": [row["agrees"] for row in canonical_rows],
+              "canonical_refutation_indices": [row["index"] for row in canonical_rows if not row["agrees"]],
+              "current_lesson_identifiable_reasons": teaching_reasons,
+              "native_issued_episode": False, "query_labels_used_to_select_demo_survivors": False,
+              "limits": ["Three predeclared four-draw windows and 24 neighbor permutations only.",
+                         "The 12-rotation screen is Python-only; protected replay covers one retained lesson and four original canonical pairs.",
+                         "An authored direct-draw rotation does not establish that the native episode sampler issues this lesson.",
+                         "No production, selected authority, approval, review index, or training admission changes."]}
+    report["artifacts"] = [{"path": path.name, "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
+                           for path in sorted(out.iterdir()) if path.is_file()]
+    (out / "report.json").write_bytes(raw(report))
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run(args.out)
+    print(json.dumps(report, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
