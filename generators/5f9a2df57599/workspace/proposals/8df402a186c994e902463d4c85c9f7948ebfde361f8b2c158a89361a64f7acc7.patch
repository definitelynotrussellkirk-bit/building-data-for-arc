+        "train": [
+            {"input": [[0]], "output": [[9]]},
+            {"input": [[1]], "output": [[9]]},
+            {"input": [[2]], "output": [[9]]},
+        ],
+        "test": [
+            {"input": [[3]], "output": [[9]]},
