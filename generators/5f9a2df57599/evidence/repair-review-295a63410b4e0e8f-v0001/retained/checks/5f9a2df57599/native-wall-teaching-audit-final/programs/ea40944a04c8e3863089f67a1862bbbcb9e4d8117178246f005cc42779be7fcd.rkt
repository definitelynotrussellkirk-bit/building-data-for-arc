(rule! (lambda (g)
      (let* ((h (rows g)) (w (cols g))
             (zero-regions (objects g 5))
             (eligible (filter (lambda (obj) (with-bbox obj (r1 c1 r2 c2) (and (> r1 0) (< r2 (- h 1)) (not (and (= c1 0) (= c2 0) (> r2 r1))) (> c1 0) (< c2 (- w 1))))) zero-regions))
             (selected eligible))
        (paint-objects g selected 4))))