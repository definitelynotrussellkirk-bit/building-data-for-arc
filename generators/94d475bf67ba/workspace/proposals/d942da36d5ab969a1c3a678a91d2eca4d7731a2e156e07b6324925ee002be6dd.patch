+"""Bounded demonstration/query orientation ambiguity probe, protected Racket.
+
+This does not relabel the source lesson, qualify a generator, or admit training.
+It retains the original labels and complete competing source programs separately.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+TASK_ID = 'a09c214ca5fa'
+ROOT = Path(__file__).resolve().parents[3]
+sys.path[:0] = [str(ROOT / 'src'), str(ROOT / 'shared/runtime')]
+from reviewer_support import load_selected_generator
+from arcpuzzles.parametric_worker import _real_evaluator
+
+ALTERNATIVE = '''(rule!
+  (let ((div-col (find-first
+                  (lambda (c) (for/and ([r (range 0 h)]) (= (at g r c) 8)))
+                  (range 0 w))))
+    (if div-col
+        (for/fold ([out g]) ([p (find-color g 6)])
+          (let* ((r (first p)) (c (second p)) (nc (- (* 2 div-col) c)))
+            (if (in-bounds? r nc h w) (set-cell out r nc 6) out)))
+        g)))'''
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    generator, source, source_hash = load_selected_generator(TASK_ID, root=ROOT)
+    row = next(json.loads(line) for line in (ROOT / 'shared/data/canonical/puzzles.jsonl').open()
+               if json.loads(line).get('task_id') == TASK_ID)
+    canonical = row['program_solution']
+    found = None
+    for seed in range(64):
+        grids = [generator.generate(seed, index) for index in range(5)]
+        vertical = [any(all(g[r][c] == 8 for r in range(len(g)))
+                        for c in range(len(g[0]))) for g in grids]
+        if vertical == [True, True, True, True, False]:
+            found = seed, grids
+            break
+    if found is None:
+        raise RuntimeError('No orientation witness in the bounded 64-seed search')
+    seed, grids = found
+    assert all(not generator.self_check(g) for g in grids)
+    apply, identity, bridge = _real_evaluator(ROOT / 'shared/runtime')
+    try:
+        original = [apply(canonical, g) for g in grids]
+        alternate = [apply(ALTERNATIVE, g) for g in grids]
+        canonical_pair_matches = [apply(canonical, pair['input']) == pair['output']
+                                  for pair in row['train'] + [row['test']]]
+    finally:
+        bridge.close()
+    assert all(canonical_pair_matches)
+    assert original[:4] == alternate[:4]
+    assert original[4] != alternate[4]
+    differences = [[r, c, original[4][r][c], alternate[4][r][c]]
+                   for r, row_values in enumerate(original[4]) for c in range(len(row_values))
+                   if original[4][r][c] != alternate[4][r][c]]
+    witness = {
+        'schema': 'arc-bounded-learnability-witness-v1',
+        'task_id': TASK_ID,
+        'generator_sha256': source_hash,
+        'canonical_program_sha256': hashlib.sha256(canonical.encode()).hexdigest(),
+        'alternative_program_sha256': hashlib.sha256(ALTERNATIVE.encode()).hexdigest(),
+        'seed': seed, 'sample_indices': list(range(5)),
+        'n_train': 4, 'n_test': 1,
+        'search': {'seeds_examined': seed + 1, 'seed_limit_exclusive': 64,
+                   'stopped_at_first_witness': True},
+        'source_program': canonical,
+        'alternative_program': ALTERNATIVE,
+        'alternative_rule': 'Reflect magenta across a full cyan column; leave row-divider inputs unchanged.',
+        'original_lesson': {'train': [{'input': g, 'output': y} for g, y in zip(grids[:4], original[:4])],
+                            'test': [{'input': grids[4], 'output': original[4]}]},
+        'alternative_outputs': {'train': alternate[:4], 'test': [alternate[4]]},
+        'verification': {'protected_runtime': identity,
+                         'all_demonstrations_match': True, 'query_disagrees': True,
+                         'query_difference_cells': differences,
+                         'canonical_pair_matches': canonical_pair_matches,
+                         'racket_evaluations': 15,
+                         'all_generator_self_checks_pass': True},
+        'interpretation': 'A generated four-demo lesson omits horizontal-divider behavior; a natural vertical-only rule survives its demos and fails its query.',
+        'scope': 'One generated lesson; no claim that canonical visible demos are ambiguous or all generated lessons fail. No broad battery.',
+        'alternative_answer_stream': {'status': 'preserved_for_optional_review',
+                                      'original_labels_retained': True, 'training_admitted': False},
+    }
+    args.out.mkdir(parents=True, exist_ok=True)
+    (args.out / 'witness.json').write_text(json.dumps(witness, indent=2) + '\n')
+    (args.out / 'canonical.rkt').write_text(canonical)
+    (args.out / 'vertical_only.rkt').write_text(ALTERNATIVE)
+    summary = {'task_id': TASK_ID, 'seed': seed, 'demonstration_agreement': '4/4',
+               'query_difference_cells': len(differences), 'protected': identity['protected'],
+               'canonical_pair_matches': canonical_pair_matches, 'racket_evaluations': 15}
+    (args.out / 'verification.json').write_text(json.dumps(summary, indent=2) + '\n')
+    print(json.dumps(summary))
+
+if __name__ == '__main__':
+    main()
