(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((fives (find-color g 5))
                  (rs (map first fives))
                  (cs (map second fives))
                  (r1 (- (min-list rs) 1))
                  (c1 (min-list cs))
                  (r2 (+ (max-list rs) 1))
                  (c2 (max-list cs)))
             (subgrid g r1 c1 r2 c2)))))
