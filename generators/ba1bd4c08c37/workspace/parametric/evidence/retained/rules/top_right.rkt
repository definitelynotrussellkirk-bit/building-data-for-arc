(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((nz (for*/list ((r (range 0 h)) (c (range 0 w)) #:when (!= (at g r c) 0))
                        (list r c)))
                  (rs (map first nz))
                  (cs (map second nz))
                  (r1 (min-list rs))
                  (c1 (min-list cs))
                  (r2 (max-list rs))
                  (c2 (max-list cs))
                  (bh (+ 1 (- r2 r1)))
                  (bw (+ 1 (- c2 c1)))
                  (half-h (quotient bh 2))
                  (half-w (quotient bw 2)))
             (build-grid half-h half-w (i j) (at g (+ r1 i) (+ c1 half-w j)))))))
