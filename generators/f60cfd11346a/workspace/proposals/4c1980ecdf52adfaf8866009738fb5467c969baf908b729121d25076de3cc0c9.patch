+#!/usr/bin/env python3
+"""Audit whether lessons teach that rays stop at intervening nonzero cells."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "91ba301501c5"
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _canonical_program(root: Path) -> str:
+    for line in canonical_path(root).read_text(encoding="utf-8").splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID and row.get("program_solution"):
+            return row["program_solution"]
+    raise RuntimeError("canonical program not found")
+
+
+def _skip_intervening_markers(grid: list[list[int]]) -> list[list[int]]:
+    """Wrong rule: keep extending through markers, but not through the gray divider."""
+    line = next(r for r, row in enumerate(grid) if row and all(value == 5 for value in row))
+    out = [row[:] for row in grid]
+    height, width = len(grid), len(grid[0])
+    for r in range(height):
+        for c in range(width):
+            value = grid[r][c]
+            if value not in (1, 2):
+                continue
+            above = r < line
+            if value == 1:
+                direction = -1 if above else 1
+            else:
+                direction = 1 if above else -1
+            rr = r + direction
+            while 0 <= rr < height and rr != line:
+                if grid[rr][c] == 0:
+                    out[rr][c] = value
+                rr += direction
+    return out
+
+
+def _witness() -> list[list[int]]:
+    grid = [[0] * 10 for _ in range(10)]
+    grid[5] = [5] * 10
+    # Above: red at row 1 blocks the outward blue at row 3 after one zero.
+    grid[1][2] = 2
+    grid[3][2] = 1
+    # Independent positive evidence for every color/side branch.
+    grid[2][4] = 1
+    grid[8][6] = 1
+    grid[8][7] = 2
+    return grid
+
+
+def audit(draws_per_band: int = 512) -> dict:
+    root = find_root(__file__)
+    module, source_path, source_sha = load_selected_generator(TASK_ID, root=root)
+    program = _canonical_program(root)
+    wrapped = wrap_rule(program)
+
+    witness = _witness()
+    intended = module._apply_variant(witness, blue_mode="away", red_mode="toward")
+    rival = _skip_intervening_markers(witness)
+    if intended == rival:
+        raise AssertionError("counterexample does not distinguish stop-at-blocker semantics")
+
+    checked = 0
+    differences = []
+    same_side_collisions = 0
+    samples = []
+    for band_index, band in enumerate(("easy", "medium", "hard")):
+        for index in range(draws_per_band):
+            seed = 100_000 * band_index + index
+            grid = module.generate(seed, index, difficulty=band)
+            expected = module._apply_variant(grid, blue_mode="away", red_mode="toward")
+            wrong = _skip_intervening_markers(grid)
+            checked += 1
+            if expected != wrong:
+                differences.append({"band": band, "seed": seed, "sample_index": index})
+            line = module._line_row(grid)
+            for side in ("above", "below"):
+                cols = [
+                    c
+                    for r, row in enumerate(grid)
+                    for c, value in enumerate(row)
+                    if value in (1, 2) and ((r < line) == (side == "above"))
+                ]
+                if len(cols) != len(set(cols)):
+                    same_side_collisions += 1
+            if index == 0:
+                samples.append(grid)
+    if differences:
+        raise AssertionError(differences[:3])
+
+    evaluations = 0
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("protected Racket backend required")
+        got = bridge.eval_text(f"({wrapped} {_literal(witness)})")
+        evaluations += 1
+        if got != intended:
+            raise AssertionError("canonical Racket disagrees with independent intended mirror")
+        for grid in samples:
+            got = bridge.eval_text(f"({wrapped} {_literal(grid)})")
+            evaluations += 1
+            if got != module._apply_variant(grid, blue_mode="away", red_mode="toward"):
+                raise AssertionError("generated protected-Racket label mismatch")
+        racket = {
+            key: identity[key]
+            for key in (
+                "schema", "backend", "protected", "binary_sha256",
+                "prelude_sha256", "bridge_sha256", "boot_script_sha256",
+                "candidate_symbol_policy_sha256",
+            )
+            if key in identity
+        }
+
+    return {
+        "schema": "91ba301501c5-stop-at-blocker-probe-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "generator_sha256": source_sha,
+        "tool_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "canonical_program_sha256": hashlib.sha256(program.encode("utf-8")).hexdigest(),
+        "protected_racket": racket,
+        "racket_evaluations": evaluations,
+        "finite_generated_draws": {
+            "count": checked,
+            "skip_marker_rival_differences": len(differences),
+            "same_side_collision_occurrences": same_side_collisions,
+        },
+        "counterexample": {
+            "input": witness,
+            "canonical_output": intended,
+            "skip_intervening_markers_output": rival,
+            "different_cells": [
+                [r, c, intended[r][c], rival[r][c]]
+                for r in range(len(witness))
+                for c in range(len(witness[0]))
+                if intended[r][c] != rival[r][c]
+            ],
+            "current_self_check_reasons": module.self_check(witness),
+        },
+        "finding": (
+            "The selected Racket rule stops a ray at any intervening nonzero cell, "
+            "but the current training grammar enforces distinct same-side columns. "
+            "A skip-intervening-markers rival therefore matched every audited draw "
+            "and diverged on the protected-Racket counterexample."
+        ),
+        "next_action": (
+            "Add a separately named same-side blocker profile, retain positive "
+            "evidence for all four branches, and add this rival to lesson checks."
+        ),
+        "limits": (
+            "Finite generated draws and one constructed rule-domain counterexample; "
+            "the production source is intentionally unchanged."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--draws-per-band", type=int, default=512)
+    args = parser.parse_args()
+    report = audit(args.draws_per_band)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": report["status"],
+        "draws": report["finite_generated_draws"]["count"],
+        "rival_differences": report["finite_generated_draws"]["skip_marker_rival_differences"],
+        "racket_evaluations": report["racket_evaluations"],
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
