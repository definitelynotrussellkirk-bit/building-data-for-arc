--- /dev/null
+++ b/repo/generators/f60cfd11346a/workspace/parametric/relay.rkt
@@ -0,0 +1,28 @@
+(rule!
+  (let ((dummy 0))
+    (define (adjacent-to-region? p region)
+      (any? (lambda (d)
+              (member? (list (+ (first p) (first d))
+                             (+ (second p) (second d)))
+                       region))
