+#!/usr/bin/env python3
+"""Reproduce and count the uniform-first-stride lesson shortcut."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "c1fd38e5812b"
+HERE = Path(__file__).resolve().parent
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _canonical_program(root: Path) -> str:
+    for line in canonical_path(root).read_text(encoding="utf-8").splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID and row.get("program_solution"):
+            return row["program_solution"]
+    raise RuntimeError("canonical program not found")
+
+
+def _pair(module, seed: int, sample_index: int) -> dict:
+    grid = module.generate(seed, sample_index, difficulty="hard")
+    analysis = module._analyze(grid)
+    return {
+        "input": grid,
+        "output": module.solve_python(grid),
+        "profile": analysis["scene_profile"],
+        "row_spans": analysis["row_spans"],
+        "col_spans": analysis["col_spans"],
+    }
+
+
+def audit(window_count: int = 2048) -> dict:
+    root = find_root(__file__)
+    module, source_path, source_sha = load_selected_generator(TASK_ID, root=root)
+    program = _canonical_program(root)
+    wrapped = wrap_rule(program)
+
+    exact_seed = 21
+    exact = [_pair(module, exact_seed, index) for index in range(3)]
+    demos = [{"input": row["input"], "output": row["output"]} for row in exact[:2]]
+    query = {"input": exact[2]["input"], "output": exact[2]["output"]}
+    rival_outputs = [module._uniform_first_stride_rival(row["input"]) for row in exact]
+    if rival_outputs[:2] != [row["output"] for row in exact[:2]]:
+        raise AssertionError("fixed-stride rival does not fit exact demonstrations")
+    if rival_outputs[2] == exact[2]["output"]:
+        raise AssertionError("fixed-stride rival does not change exact query")
+    reasons = module.lesson_identifiable(demos, query)
+    if not any("uniform_first_stride" in reason for reason in reasons):
+        raise AssertionError(reasons)
+
+    evaluations = 0
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("protected Racket backend required")
+        for row in exact:
+            got = bridge.eval_text(f"({wrapped} {_literal(row['input'])})")
+            evaluations += 1
+            if got != row["output"]:
+                raise AssertionError("canonical Racket label mismatch")
+        racket = {
+            key: identity[key]
+            for key in (
+                "schema", "backend", "protected", "binary_sha256",
+                "prelude_sha256", "bridge_sha256", "boot_script_sha256",
+                "candidate_symbol_policy_sha256",
+            )
+            if key in identity
+        }
+
+    surviving = []
+    for seed in range(window_count):
+        pairs = [_pair(module, seed, index) for index in range(3)]
+        fits = all(
+            module._uniform_first_stride_rival(row["input"]) == row["output"]
+            for row in pairs[:2]
+        )
+        changes = module._uniform_first_stride_rival(pairs[2]["input"]) != pairs[2]["output"]
+        if fits and changes:
+            public_pairs = [
+                {"input": row["input"], "output": row["output"]}
+                for row in pairs
+            ]
+            hook = module.lesson_identifiable(public_pairs[:2], public_pairs[2])
+            if not any("uniform_first_stride" in reason for reason in hook):
+                raise AssertionError((seed, hook))
+            surviving.append({
+                "seed": seed,
+                "profiles": [row["profile"] for row in pairs],
+            })
+
+    test_path = root / "generators" / TASK_ID / "tests" / "test_generator_c1fd38e5812b.py"
+    return {
+        "schema": "c1fd38e5812b-uniform-stride-probe-v1",
+        "status": "passed",
+        "task_id": TASK_ID,
+        "generator_sha256": source_sha,
+        "test_sha256": hashlib.sha256(test_path.read_bytes()).hexdigest(),
+        "tool_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "canonical_program_sha256": hashlib.sha256(program.encode("utf-8")).hexdigest(),
+        "protected_racket": racket,
+        "racket_evaluations": evaluations,
+        "exact_witness": {
+            "seed": exact_seed,
+            "profiles": [row["profile"] for row in exact],
+            "row_spans": [row["row_spans"] for row in exact],
+            "col_spans": [row["col_spans"] for row in exact],
+            "rival_fits_both_demos": True,
+            "rival_changes_query": True,
+            "lesson_guard_reasons": reasons,
+            "pairs": [
+                {
+                    "input": row["input"],
+                    "canonical_output": row["output"],
+                    "uniform_first_stride_output": rival,
+                }
+                for row, rival in zip(exact, rival_outputs)
+            ],
+        },
+        "finite_default_windows": {
+            "count": window_count,
+            "ambiguous_before_guard": len(surviving),
+            "all_rejected_by_guard": True,
+            "first_ten": surviving[:10],
+        },
+        "limits": (
+            "Finite consecutive hard-band windows and one named rival only; "
+            "this is not a universal identifiability proof."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--windows", type=int, default=2048)
+    args = parser.parse_args()
+    report = audit(args.windows)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": report["status"],
+        "racket_evaluations": report["racket_evaluations"],
+        "windows": report["finite_default_windows"]["count"],
+        "ambiguous_before_guard": report["finite_default_windows"]["ambiguous_before_guard"],
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
