(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (begin
             (define objs (objects-multicolor g 0))
             (define (obj-pattern o)
               (define bb (obj-bbox o))
               (define r1 (first bb))
               (define c1 (second bb))
               (define r2 (third bb))
               (define c2 (fourth bb))
               (build-grid (+ 1 (- r2 r1))
                           (+ 1 (- c2 c1))
                           (r c)
                           (at g (+ r r1) (+ c c1))))
             (define patterns (map obj-pattern objs))
             (define (count-equal p ps) (count-if (lambda (q) (equal? p q)) ps))
             (define selected (find-first (lambda (p) (= (count-equal p patterns) 1)) patterns))
             (define ph (rows selected))
             (define pw (cols selected))
             (define (value-count v)
               (for*/sum ((r (range 0 ph)) (c (range 0 pw)))
                 (if (= (at selected r c) v) 1 0)))
             (define corner-positions
               (list (list 0 0)
                     (list 0 (- pw 1))
                     (list (- ph 1) 0)
                     (list (- ph 1) (- pw 1))))
             (define marker-pos
               (find-first (lambda (p)
                             (let ((v (at selected (first p) (second p))))
                               (and (!= v 0) (= (value-count v) 1))))
                           corner-positions))
             (define mr (first marker-pos))
             (define mc (second marker-pos))
             (define row-reverse? (= mr (- ph 1)))
             (define col-reverse? (= mc (- pw 1)))
             (build-grid ph
                         pw
                         (r c)
                         (at selected
                             (if row-reverse? (- (- ph 1) r) r)
                             (if col-reverse? (- (- pw 1) c) c)))))))
