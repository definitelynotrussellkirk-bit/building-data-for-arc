(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((top-color (at g 0 0))
                  (bottom-color (at g (- h 1) 0))
                  (left-color (at g 0 0))
                  (right-color (at g 0 (- w 1)))
                  (top-bottom? (and
                                 (!= top-color 0)
                                 (!= bottom-color 0)
                                 (for/and ((c (range 0 w))) (= (at g 0 c) top-color))
                                 (for/and ((c (range 0 w)))
                                          (= (at g (- h 1) c) bottom-color))))
                  (left-right? (and
                                 (!= left-color 0)
                                 (!= right-color 0)
                                 (for/and ((r (range 0 h))) (= (at g r 0) left-color))
                                 (for/and ((r (range 0 h)))
                                          (= (at g r (- w 1)) right-color)))))
             (cond
               (top-bottom? (reduce (lambda (acc p)
                                      (let* ((r (fst p))
                                             (c (snd p))
                                             (nr (if (< (* 2 r) h) (- r 1) (+ r 1)))
                                             (nr2 (if (< (* 2 r) h) (- r 2) (+ r 2)))
                                             (color (if (< (* 2 r) h)
                                                        top-color
                                                        bottom-color)))
                                        (if (in-bounds? nr c h w)
                                            (let ((once (set-cell acc nr c color)))
                                              (if (in-bounds? nr2 c h w)
                                                  (set-cell once nr2 c color)
                                                  once))
                                            acc)))
                                    g
                                    (find-color g 1)))
               (left-right? (reduce (lambda (acc p)
                                      (let* ((r (fst p))
                                             (c (snd p))
                                             (nc (if (< (* 2 c) w) (- c 1) (+ c 1)))
                                             (nc2 (if (< (* 2 c) w) (- c 2) (+ c 2)))
                                             (color (if (< (* 2 c) w)
                                                        left-color
                                                        right-color)))
                                        (if (in-bounds? r nc h w)
                                            (let ((once (set-cell acc r nc color)))
                                              (if (in-bounds? r nc2 h w)
                                                  (set-cell once r nc2 color)
                                                  once))
                                            acc)))
                                    g
                                    (find-color g 1)))
               (else g))))))