+#!/usr/bin/env python3
+"""Bounded learnability/self-check sweep for the repaired b31e765ef780 generator."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[3]
+for path in (ROOT / "src", ROOT / "shared/runtime", ROOT / "shared/tools"):
+    sys.path.insert(0, str(path))
+SOURCE = ROOT / "generators/b31e765ef780/generator.py"
+EXPECTED_SHA256 = "a9cce360c57589c816557c76d309d70df5e1c14f7fe7f15d3efd5c9d2f76fa45"
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"could not load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seeds", type=int, default=128)
+    parser.add_argument("--indices", type=int, default=8)
+    parser.add_argument("--out", type=Path, default=HERE / "sweep.json")
+    args = parser.parse_args()
+    if args.seeds < 1 or args.indices < 1:
+        raise ValueError("seeds and indices must be positive")
+
+    source_sha = hashlib.sha256(SOURCE.read_bytes()).hexdigest()
+    if source_sha != EXPECTED_SHA256:
+        raise RuntimeError(f"generator source drifted: {source_sha}")
+    generator = load(SOURCE, "b31_sweep_generator")
+    witness_tool = load(HERE / "reproduce.py", "b31_witness_tool")
+
+    failures = []
+    accepted = 0
+    size_contrast = 0
+    per_difficulty = {}
+    for difficulty in (None, "easy", "medium", "hard"):
+        label = "default" if difficulty is None else difficulty
+        local = {"requested": args.seeds * args.indices, "accepted": 0, "failures": 0}
+        for seed in range(args.seeds):
+            for sample_index in range(args.indices):
+                try:
+                    grid = generator.generate(seed, sample_index, difficulty=difficulty)
+                    errors = generator.self_check(grid, difficulty=difficulty)
+                    parts = witness_tool.components(grid)
+                    holes = [part["size"] for part in parts if part["holed"]]
+                    solids = [part["size"] for part in parts if not part["holed"]]
+                    contrast = bool(holes and solids and max(solids) > min(holes))
+                    if errors or not contrast:
+                        failures.append({
+                            "difficulty": label,
+                            "seed": seed,
+                            "sample_index": sample_index,
+                            "self_check": errors,
+                            "components": parts,
+                            "size_contrast": contrast,
+                        })
+                        local["failures"] += 1
+                    else:
+                        accepted += 1
+                        size_contrast += 1
+                        local["accepted"] += 1
+                except Exception as exc:
+                    failures.append({
+                        "difficulty": label,
+                        "seed": seed,
+                        "sample_index": sample_index,
+                        "error": f"{type(exc).__name__}: {exc}",
+                    })
+                    local["failures"] += 1
+        per_difficulty[label] = local
+
+    requested = 4 * args.seeds * args.indices
+    report = {
+        "schema": "arcpuzzles-peer-bounded-sweep-v1",
+        "task_id": "b31e765ef780",
+        "assignment_id": "review-f4bbc5c710b4b80e",
+        "status": "passed" if not failures and accepted == requested else "failed",
+        "source_sha256": source_sha,
+        "parameters": {
