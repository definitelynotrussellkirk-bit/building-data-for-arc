@@ -0,0 +1,92 @@
+"""Regression checks for hole-vs-size learnability in b31e765ef780."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+from pathlib import Path
+import sys
+
+
+HOME = Path(__file__).resolve().parents[1]
+SOURCE = HOME / "generator.py"
+
+
+def _load():
+    name = "b31_generator_" + hashlib.sha256(SOURCE.read_bytes()).hexdigest()[:12]
+    spec = importlib.util.spec_from_file_location(name, SOURCE)
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _components(grid):
+    h, w = len(grid), len(grid[0])
+    reachable = set()
+    stack = [
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if grid[r][c] == 0 and (r in (0, h - 1) or c in (0, w - 1))
+    ]
+    reachable.update(stack)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr, nc = r + dr, c + dc
+            if (0 <= nr < h and 0 <= nc < w and grid[nr][nc] == 0
+                    and (nr, nc) not in reachable):
+                reachable.add((nr, nc))
+                stack.append((nr, nc))
+
+    seen = set()
+    result = []
+    for r in range(h):
+        for c in range(w):
+            color = grid[r][c]
+            if color == 0 or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if (0 <= nr < h and 0 <= nc < w and (nr, nc) not in seen
+                            and grid[nr][nc] == color):
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
+            r0 = min(rr for rr, _ in cells)
+            r1 = max(rr for rr, _ in cells)
+            c0 = min(cc for _, cc in cells)
+            c1 = max(cc for _, cc in cells)
+            has_bbox_zero = any(
+                grid[rr][cc] == 0 and (rr, cc) not in reachable
+                for rr in range(r0, r1 + 1)
+                for cc in range(c0, c1 + 1)
+            )
+            result.append({"size": len(cells), "holed": has_bbox_zero})
+    return result
+
+
+def test_ordinary_inputs_refute_recolor_large_components_shortcut():
+    generator = _load()
+    for difficulty in (None, "easy", "hard"):
+        for seed in range(16):
+            for sample_index in range(4):
+                grid = generator.generate(seed, sample_index, difficulty=difficulty)
+                components = _components(grid)
+                holes = [item["size"] for item in components if item["holed"]]
+                solids = [item["size"] for item in components if not item["holed"]]
+                assert holes and solids
+                assert max(solids) > min(holes), (difficulty, seed, sample_index, components)
+
+
+def test_self_check_rejects_lessons_without_a_solid_contrast():
+    generator = _load()
+    grid = generator._draw_from_degenerate("all_holed", None)
+    errors = generator.self_check(grid)
+    assert any("solid" in error.lower() for error in errors), errors
