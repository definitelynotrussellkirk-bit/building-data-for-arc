+#!/usr/bin/env python3
+"""Replay the size-shortcut defect and its repair through protected Racket.
+
+The retained pre-repair generator teaches a coincidental rule: every component
+of size at least eight is holed, while every solid component is smaller.  The
+repaired generator emits a solid 3x3 block (size nine), so component size no
+longer identifies the components that should be recolored.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+from typing import Any
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[3]
+for path in (ROOT / "src", ROOT / "shared/runtime", ROOT / "shared/tools"):
+    sys.path.insert(0, str(path))
+
+local_racket = ROOT.parent / ".review/racket-runtime/racket/bin/racket"
+if local_racket.is_file():
+    os.environ.setdefault("RACKET_PATH", str(local_racket))
+
+from arcpuzzles.catalog import Catalog  # noqa: E402
+from arc_repl.racket_bridge import RacketBridge  # noqa: E402
+from puzzle_generators.rule_wrap import wrap_rule  # noqa: E402
+
+TASK_ID = "b31e765ef780"
+ASSIGNMENT_ID = "review-f4bbc5c710b4b80e"
+BEFORE_SOURCE = HERE / "private/source_snapshot/generator_before.py"
+AFTER_SOURCE = ROOT / "generators" / TASK_ID / "generator.py"
+EXPECTED_BEFORE_SHA256 = "19de300a606587ba86bd36168233c0cf5204f32814f520910b0d5c8e65fe374d"
+EXPECTED_AFTER_SHA256 = "a9cce360c57589c816557c76d309d70df5e1c14f7fe7f15d3efd5c9d2f76fa45"
+
+RIVAL_SOURCE = """(rule! (lambda (g)
+  (for/fold ((out g)) ((obj (objects g 0)))
+    (if (>= (length (obj-cells obj)) 8)
+        (recolor-cells out (obj-cells obj) 8)
+        out))))"""
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def load_module(path: Path, label: str):
+    name = f"{label}_{sha256(path)[:12]}"
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"could not load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def grid_literal(grid: list[list[int]]) -> str:
+    rows = " ".join("(" + " ".join(str(value) for value in row) + ")" for row in grid)
+    return f"'({rows})"
+
+
+def application(source: str, grid: list[list[int]]) -> str:
+    return f"({wrap_rule(source)} {grid_literal(grid)})"
+
+
+def components(grid: list[list[int]]) -> list[dict[str, Any]]:
+    """Describe same-color components and classify holes independently."""
+    h, w = len(grid), len(grid[0])
+    reachable: set[tuple[int, int]] = set()
+    stack = [
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if grid[r][c] == 0 and (r in (0, h - 1) or c in (0, w - 1))
+    ]
+    reachable.update(stack)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr, nc = r + dr, c + dc
+            if (
+                0 <= nr < h
+                and 0 <= nc < w
+                and grid[nr][nc] == 0
+                and (nr, nc) not in reachable
+            ):
+                reachable.add((nr, nc))
+                stack.append((nr, nc))
+
+    seen: set[tuple[int, int]] = set()
+    result: list[dict[str, Any]] = []
+    for r in range(h):
+        for c in range(w):
+            color = grid[r][c]
+            if color == 0 or (r, c) in seen:
+                continue
+            cells: list[tuple[int, int]] = []
+            todo = [(r, c)]
+            seen.add((r, c))
+            while todo:
+                rr, cc = todo.pop()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and (nr, nc) not in seen
+                        and grid[nr][nc] == color
+                    ):
+                        seen.add((nr, nc))
+                        todo.append((nr, nc))
+            r0 = min(rr for rr, _ in cells)
+            r1 = max(rr for rr, _ in cells)
+            c0 = min(cc for _, cc in cells)
+            c1 = max(cc for _, cc in cells)
+            holed = any(
+                grid[rr][cc] == 0 and (rr, cc) not in reachable
+                for rr in range(r0, r1 + 1)
+                for cc in range(c0, c1 + 1)
+            )
+            result.append(
+                {
+                    "color": color,
+                    "size": len(cells),
+                    "holed": holed,
+                    "bbox": [r0, c0, r1, c1],
+                }
+            )
+    return sorted(result, key=lambda item: (item["bbox"], item["color"]))
+
+
+def difference_count(left: list[list[int]], right: list[list[int]]) -> int:
+    return sum(a != b for row_a, row_b in zip(left, right) for a, b in zip(row_a, row_b))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, default=HERE / "large-component-shortcut.json")
+    args = parser.parse_args()
+
+    before_sha = sha256(BEFORE_SOURCE)
+    after_sha = sha256(AFTER_SOURCE)
+    if before_sha != EXPECTED_BEFORE_SHA256:
+        raise RuntimeError(f"before source drifted: {before_sha}")
+    if after_sha != EXPECTED_AFTER_SHA256:
+        raise RuntimeError(f"after source drifted: {after_sha}")
+
+    before = load_module(BEFORE_SOURCE, "b31_before")
+    after = load_module(AFTER_SOURCE, "b31_after")
+    variants = Catalog(ROOT).get(TASK_ID)["variants"]
+    canonical_sources = {
+        variant["program_solution"]
+        for variant in variants
+        if isinstance(variant.get("program_solution"), str)
+        and variant["program_solution"].strip()
+    }
+    if len(canonical_sources) != 1:
+        raise RuntimeError(f"expected one canonical authority, found {len(canonical_sources)}")
+    canonical_source = next(iter(canonical_sources))
+    normalized_rule_sha = hashlib.sha256(" ".join(canonical_source.split()).encode()).hexdigest()
+
+    cases: list[tuple[str, Any, int]] = [
+        ("before_demo_0", before, 0),
+        ("before_demo_1", before, 1),
+        ("after_query_0", after, 0),
+    ]
+    rows: list[dict[str, Any]] = []
+    eval_count = 0
+    with RacketBridge(max_calls_before_restart=32) as bridge:
+        runtime = {
+            "protected_racket": True,
+            "binary": bridge.racket_binary,
+            "binary_sha256": sha256(Path(bridge.racket_binary)),
+            "prelude": str(Path(bridge.prelude_path).resolve()),
+            "prelude_sha256": sha256(Path(bridge.prelude_path)),
+        }
+        for name, module, sample_index in cases:
+            input_grid = module.generate(0, sample_index, difficulty="easy")
+            canonical_output = bridge.eval_text(application(canonical_source, input_grid))
+            rival_output = bridge.eval_text(application(RIVAL_SOURCE, input_grid))
+            eval_count += 2
+            rows.append(
+                {
+                    "name": name,
+                    "seed": 0,
+                    "sample_index": sample_index,
+                    "difficulty": "easy",
+                    "input": input_grid,
+                    "components": components(input_grid),
+                    "canonical_output": canonical_output,
+                    "rival_output": rival_output,
+                    "rival_matches": rival_output == canonical_output,
+                    "difference_cells": difference_count(canonical_output, rival_output),
+                    "self_check": module.self_check(input_grid),
+                }
+            )
+
+    before_rows = rows[:2]
+    after_row = rows[2]
+    checks = {
+        "before_source_bound": before_sha == EXPECTED_BEFORE_SHA256,
+        "after_source_bound": after_sha == EXPECTED_AFTER_SHA256,
+        "before_two_demonstrations_fit_size_rival": all(row["rival_matches"] for row in before_rows),
+        "before_holes_are_at_least_eight": all(
+            item["size"] >= 8
+            for row in before_rows
+            for item in row["components"]
+            if item["holed"]
+        ),
+        "before_solids_are_below_eight": all(
+            item["size"] < 8
+            for row in before_rows
+            for item in row["components"]
+            if not item["holed"]
+        ),
+        "after_contains_large_solid": any(
+            not item["holed"] and item["size"] >= 8 for item in after_row["components"]
+        ),
+        "after_query_rejects_size_rival": not after_row["rival_matches"],
+        "after_query_has_nonzero_difference": after_row["difference_cells"] > 0,
+        "all_self_checks_pass": all(not row["self_check"] for row in rows),
+    }
+    passed = all(checks.values())
+    report = {
+        "schema": "arcpuzzles-peer-shortcut-witness-v1",
+        "task_id": TASK_ID,
+        "assignment_id": ASSIGNMENT_ID,
+        "status": "passed" if passed else "failed",
+        "finding": (
+            "The original generator made every holed component size >= 8 and every solid "
+            "component size < 8, so a size-threshold rival fit. The repair guarantees a "
+            "solid 3x3 component of size 9 while retaining a holed 3x3 ring of size 8."
+        ),
+        "source_binding": {
+            "before_path": str(BEFORE_SOURCE.relative_to(ROOT)),
+            "before_sha256": before_sha,
+            "after_path": str(AFTER_SOURCE.relative_to(ROOT)),
+            "after_sha256": after_sha,
+            "canonical_rule_sha256": normalized_rule_sha,
+        },
+        "rival": {
+            "name": "recolor_every_component_of_size_at_least_8",
+            "source": RIVAL_SOURCE,
+        },
+        "runtime": {**runtime, "evaluation_count": eval_count},
+        "cases": rows,
+        "checks": checks,
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": report["status"],
+        "out": str(args.out),
+        "evaluation_count": eval_count,
+        "before_matches": [row["rival_matches"] for row in before_rows],
+        "after_matches": after_row["rival_matches"],
+        "after_difference_cells": after_row["difference_cells"],
+    }, sort_keys=True))
+    return 0 if passed else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
