+++ b/repo/generators/9536d5aef3f6/workspace/conflict_condition_probe.py
@@ -0,0 +1,253 @@
+"""Bounded lesson-local conflict-condition audit for 9536d5aef3f6.
+
+The generator's canonical rule swaps every unequal occupied transpose pair.  A
+three-demonstration lesson normally contains only one such pair, so conditional
+rules can agree with all demonstrations and disagree on the next pair.  This
+tool makes those finite rivals executable and scans every cyclic three-demo
+window for a bounded seed range.
+
+This is an audit helper, not a production oracle or a proof of ambiguity beyond
+the declared rivals and sampled seeds.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from collections.abc import Callable
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from types import ModuleType
+from typing import Any
+
+
+HERE = Path(__file__).resolve().parent
+GENERATOR_PATH = HERE.parent / "generator.py"
+BANDS = ("easy", "medium", "hard")
+Predicate = Callable[[int, int, int, int, int], bool]
+
+
+def _load_generator() -> ModuleType:
+    spec = importlib.util.spec_from_file_location(
+        "_9536d5aef3f6_conflict_condition_probe_generator", GENERATOR_PATH
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError("could not load adjacent generator")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _coerce_grid(grid: Any) -> list[list[int]]:
+    if not isinstance(grid, (list, tuple)):
+        raise TypeError("grid must be a rectangular sequence")
+    rows = [list(row) for row in grid]
+    if not rows or not rows[0] or any(len(row) != len(rows[0]) for row in rows):
+        raise ValueError("grid must be nonempty and rectangular")
+    if len(rows) != len(rows[0]):
+        raise ValueError("transpose probe requires a square grid")
+    return rows
+
+
+def _conditional_conflict_rule(grid: Any, predicate: Predicate) -> list[list[int]]:
+    """Mirror unpaired cells, but swap an occupied pair only when predicate holds."""
+    rows = _coerce_grid(grid)
+    size = len(rows)
+    out = [row[:] for row in rows]
+
+    # Unpaired sources and diagonal sources behave canonically.
+    for r, row in enumerate(rows):
+        for c, value in enumerate(row):
+            if value == 0 or r == c:
+                continue
+            if rows[c][r] == 0:
+                out[c][r] = value
+
+    # Occupied pairs are evaluated once from the immutable input snapshot.
+    for r in range(size):
+        for c in range(r + 1, size):
+            upper = rows[r][c]
+            lower = rows[c][r]
+            if upper == 0 or lower == 0:
+                continue
+            if predicate(r, c, upper, lower, size):
+                out[r][c] = lower
+                out[c][r] = upper
+    return out
+
+
+def _predicates() -> dict[str, Predicate]:
+    return {
+        "adjacent_conflicts_only": lambda r, c, upper, lower, size: c - r == 1,
+        "far_conflicts_only": lambda r, c, upper, lower, size: c - r >= 2,
+        "border_conflicts_only": lambda r, c, upper, lower, size: r == 0 or c == size - 1,
+        "interior_conflicts_only": lambda r, c, upper, lower, size: r > 0 and c < size - 1,
+        "upper_less_lower_only": lambda r, c, upper, lower, size: upper < lower,
+        "upper_greater_lower_only": lambda r, c, upper, lower, size: upper > lower,
+        "even_orbit_only": lambda r, c, upper, lower, size: (r + c) % 2 == 0,
+        "odd_orbit_only": lambda r, c, upper, lower, size: (r + c) % 2 == 1,
+        "near_main_only": lambda r, c, upper, lower, size: c - r <= 2,
+        "far_from_main_only": lambda r, c, upper, lower, size: c - r > 2,
+        "upper_half_only": lambda r, c, upper, lower, size: r < size // 2,
+        "lower_half_only": lambda r, c, upper, lower, size: c >= (size + 1) // 2,
+    }
+
+
+def _rivals() -> dict[str, Callable[[Any], list[list[int]]]]:
+    return {
+        name: (lambda grid, predicate=predicate: _conditional_conflict_rule(grid, predicate))
+        for name, predicate in _predicates().items()
+    }
+
+
+def _pair(generator: ModuleType, grid: list[list[int]]) -> dict[str, object]:
+    return {"input": grid, "output": generator.rule_mirror(grid)}
+
+
+def _conflicts(grid: list[list[int]]) -> list[dict[str, int]]:
+    result: list[dict[str, int]] = []
+    for r in range(len(grid)):
+        for c in range(r + 1, len(grid)):
+            if grid[r][c] and grid[c][r]:
+                result.append(
+                    {
+                        "row": r,
+                        "col": c,
+                        "upper": grid[r][c],
+                        "lower": grid[c][r],
+                        "distance": c - r,
+                    }
+                )
+    return result
+
+
+def run_probe(*, seeds: int = 128) -> dict[str, object]:
+    if type(seeds) is not int or not 1 <= seeds <= 1024:
+        raise ValueError("seeds must be an exact integer in 1..1024")
+
+    generator = _load_generator()
+    rivals = _rivals()
+    failures: list[dict[str, object]] = []
+    ambiguity_counts: Counter[str] = Counter()
+    ambiguous_windows = 0
+    first_ambiguity: dict[str, object] | None = None
+    windows = 0
+    pairs_checked = 0
+    period = len(generator.SCHEDULE_PROFILES)
+
+    for band in BANDS:
+        for seed in range(seeds):
+            stream_seed = 70_000 + seed
+            for start in range(period * 2):
+                try:
+                    grids = [
+                        generator.generate(
+                            stream_seed, start + offset, difficulty=band
+                        )
+                        for offset in range(4)
+                    ]
+                    pairs = [_pair(generator, grid) for grid in grids]
+                    demos, query = pairs[:3], pairs[3]
+                    survivors = []
+                    for name, rival in rivals.items():
+                        if all(
+                            rival(pair["input"]) == pair["output"]
+                            for pair in demos
+                        ) and rival(query["input"]) != query["output"]:
+                            survivors.append(name)
+                            ambiguity_counts[name] += 1
+                    if survivors:
+                        ambiguous_windows += 1
+                        if first_ambiguity is None:
+                            first_ambiguity = {
+                                "band": band,
+                                "seed": seed,
+                                "stream_seed": stream_seed,
+                                "start": start,
+                                "demo_sample_indices": [start, start + 1, start + 2],
+                                "query_sample_index": start + 3,
+                                "demo_profiles": [
+                                    generator.schedule_profile(
+                                        stream_seed, start + offset, band
+                                    )
+                                    for offset in range(3)
+                                ],
+                                "query_profile": generator.schedule_profile(
+                                    stream_seed, start + 3, band
+                                ),
+                                "demo_conflicts": [
+                                    _conflicts(pair["input"]) for pair in demos
+                                ],
+                                "query_conflicts": _conflicts(query["input"]),
+                                "rivals": sorted(survivors),
+                            }
+                    windows += 1
+                    pairs_checked += 4
+                except Exception as exc:
+                    failures.append(
+                        {
+                            "band": band,
+                            "seed": seed,
+                            "start": start,
+                            "type": type(exc).__name__,
+                            "message": str(exc),
+                        }
+                    )
+
+    if failures:
+        status = "failed"
+    elif ambiguous_windows:
+        status = "ambiguity_found"
+    else:
+        status = "no_ambiguity_found"
+    return {
+        "schema": "9536d5aef3f6-conflict-condition-probe-v1",
+        "status": status,
+        "generator_sha256": hashlib.sha256(GENERATOR_PATH.read_bytes()).hexdigest(),
+        "generator_version": generator.VERSION,
+        "seed_count": seeds,
+        "bands": list(BANDS),
+        "cyclic_starts_per_seed_band": period * 2,
+        "windows": windows,
+        "pairs_checked": pairs_checked,
+        "rivals": sorted(rivals),
+        "ambiguous_lessons": ambiguous_windows,
+        "ambiguities_by_rival": dict(sorted(ambiguity_counts.items())),
+        "first_ambiguity": first_ambiguity,
+        "failures": failures,
+        "scope": (
+            "Finite conditional-conflict rivals over deterministic generated "
+            "three-demo windows using the Python mirror. The retained case "
+            "should be replayed with protected Racket before a source repair."
+        ),
+        "repair_direction": (
+            "Constructively place at least two unequal occupied transpose pairs "
+            "with contrasting distance, border/interior position, color order, "
+            "and parity in every three-demo lesson, while preserving directional "
+            "and immutable-snapshot evidence."
+        ),
+    }
+
+
+def _args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seeds", type=int, default=128)
+    parser.add_argument("--out", type=Path)
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = _args()
+    report = run_probe(seeds=args.seeds)
+    payload = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(payload, encoding="utf-8")
+    else:
+        print(payload, end="")
+    return 0 if report["status"] != "failed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
