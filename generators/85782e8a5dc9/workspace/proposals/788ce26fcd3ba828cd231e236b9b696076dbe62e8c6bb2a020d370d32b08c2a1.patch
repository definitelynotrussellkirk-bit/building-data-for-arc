@@ -0,0 +1,140 @@
+"""Bounded cyclic-lesson probe for generator 827c34fc8e04.
+
+The probe is intentionally finite.  It loads the adjacent generator source,
+materializes every cyclic three-demo window for a bounded seed range, and asks
+all declared executable rivals whether they can fit the demonstrations while
+changing the query answer.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from types import ModuleType
+
+
+HERE = Path(__file__).resolve().parent
+GENERATOR_PATH = HERE.parent / "generator.py"
+BANDS = ("easy", "medium", "hard")
+
+
+def _load_generator() -> ModuleType:
+    spec = importlib.util.spec_from_file_location(
+        "_827c34fc8e04_learnability_probe_generator", GENERATOR_PATH
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError("could not load adjacent generator")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _pair(generator: ModuleType, grid: list[list[int]]) -> dict[str, object]:
+    return {"input": grid, "output": generator.rule_mirror(grid)}
+
+
+def run_probe(*, seeds: int = 128) -> dict[str, object]:
+    if type(seeds) is not int or not 1 <= seeds <= 1024:
+        raise ValueError("seeds must be an exact integer in 1..1024")
+
+    generator = _load_generator()
+    failures: list[dict[str, object]] = []
+    rival_ambiguities: Counter[str] = Counter()
+    profile_counts: Counter[str] = Counter()
+    windows = 0
+    pairs_checked = 0
+    period = len(generator.SCHEDULE_PROFILES)
+
+    for band in BANDS:
+        for seed in range(seeds):
+            for start in range(period * 2):
+                try:
+                    grids = [
+                        generator.generate(
+                            90_000 + seed, start + offset, difficulty=band
+                        )
+                        for offset in range(4)
+                    ]
+                    pairs = [_pair(generator, grid) for grid in grids]
+                    demos, query = pairs[:3], pairs[3]
+                    reasons = generator.lesson_identifiable(demos, query)
+                    for offset in range(4):
+                        profile_counts[
+                            generator.schedule_profile(
+                                90_000 + seed, start + offset, band
+                            )
+                        ] += 1
+                    for name, rival in generator.LESSON_COMPETITORS.items():
+                        if all(
+                            rival(pair["input"]) == pair["output"]
+                            for pair in demos
+                        ) and rival(query["input"]) != query["output"]:
+                            rival_ambiguities[name] += 1
+                    if reasons:
+                        failures.append(
+                            {
+                                "band": band,
+                                "seed": seed,
+                                "start": start,
+                                "reasons": reasons,
+                            }
+                        )
+                    windows += 1
+                    pairs_checked += 4
+                except Exception as exc:  # Preserve exact bounded replay coordinates.
+                    failures.append(
+                        {
+                            "band": band,
+                            "seed": seed,
+                            "start": start,
+                            "type": type(exc).__name__,
+                            "message": str(exc),
+                        }
+                    )
+
+    ambiguous_lessons = sum(rival_ambiguities.values())
+    return {
+        "schema": "827c34fc8e04-cyclic-learnability-probe-v1",
+        "status": "passed" if not failures and not ambiguous_lessons else "failed",
+        "generator_sha256": hashlib.sha256(GENERATOR_PATH.read_bytes()).hexdigest(),
+        "seed_count": seeds,
+        "bands": list(BANDS),
+        "cyclic_starts_per_seed_band": period * 2,
+        "windows": windows,
+        "pairs_checked": pairs_checked,
+        "rivals": sorted(generator.LESSON_COMPETITORS),
+        "ambiguous_lessons": ambiguous_lessons,
+        "ambiguities_by_rival": dict(sorted(rival_ambiguities.items())),
+        "profile_counts": dict(sorted(profile_counts.items())),
+        "failures": failures,
+        "scope": (
+            "Finite declared rivals, deterministic seeds, and Python mirror only; "
+            "this is not a universal identifiability proof or an authority replay."
+        ),
+    }
+
+
+def _args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seeds", type=int, default=128)
+    parser.add_argument("--out", type=Path)
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = _args()
+    report = run_probe(seeds=args.seeds)
+    payload = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(payload, encoding="utf-8")
+    else:
+        print(payload, end="")
+    return 0 if report["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
