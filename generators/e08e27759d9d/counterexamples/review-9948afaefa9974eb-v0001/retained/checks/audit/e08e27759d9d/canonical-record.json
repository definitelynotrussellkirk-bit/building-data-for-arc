  "program_solution": "(rule!\n ;; Walls (1/7/9) partition the board into rooms, each stamped with a\n ;; motif. Compare motifs up to rotation/flip and emit a 1-row strip\n ;; (one cell per room, reading order): cyan(8) marks the rooms whose\n ;; motif matches no other room's.\n (lambda (g)\n   (let ()\n     (define (wall? v) (member? v (list 1 7 9)))\n     (define rooms\n       (sort (objects (grid-from-fn h w (lambda (r c)\n                                          (if (wall? (at g r c)) 0 1)))\n                      0)\n             (lambda (a b) (or (< (obj-r1 a) (obj-r1 b))\n                               (and (= (obj-r1 a) (obj-r1 b))\n                                    (< (obj-c1 a) (obj-c1 b)))))))\n     (define (spin p t)  ;; the 8 dihedral images of a cell\n       (let ((r (first p)) (c (second p)))\n         (cond ((= t 0) (list r c))\n               ((= t 1) (list c (- r)))\n               ((= t 2) (list (- r) (- c)))\n               ((= t 3) (list (- c) r))\n               ((= t 4) (list r (- c)))\n               ((= t 5) (list (- c) (- r)))\n               ((= t 6) (list (- r) c))\n               (else (list c r)))))\n     (define (dihedral cells)  ;; the motif's 8 normalized variants\n       (if (empty? cells)\n           (list (list))\n           (remove-duplicates\n            (for/list ((t (in-range 8)))\n              (let* ((raw (map (lambda (p) (spin p t)) cells))\n                     (mr (min-of first raw))\n                     (mc (min-of second raw)))\n                (sort (map (lambda (p) (list (- (first p) mr)\n                                             (- (second p) mc)))\n                           raw)\n                      cell<))))))\n     (define sets\n       (map (lambda (room)\n              (dihedral\n               (filter (lambda (x) x)\n                       (map (lambda (p)\n                              (and (not (zero? (at g (first p)\n                                                   (second p))))\n                                   (list (- (first p) (obj-r1 room))\n                                         (- (second p)\n                                            (obj-c1 room)))))\n                            (obj-cells room)))))\n            rooms))\n     (define uniques  ;; room indices whose set intersects only itself\n       (map first\n            (filter (lambda (pair)\n                      (= 1 (count-if\n                            (lambda (s)\n                              (any? (lambda (v) (member? v s))\n                                    (second pair)))\n                            sets)))\n                    (enumerate-list sets))))\n     (grid-from-fn 1 (length rooms)\n                   (lambda (r c) (if (member? c uniques) 8 0))))))",
