+def _distances(adjacency, seed):
+    distance, queue = {seed: 0}, deque([seed])
+    while queue:
+        index = queue.popleft()
+        for other in sorted(adjacency[index]):
+            if other not in distance:
+                distance[other] = distance[index] + 1
+                queue.append(other)
+    return distance
