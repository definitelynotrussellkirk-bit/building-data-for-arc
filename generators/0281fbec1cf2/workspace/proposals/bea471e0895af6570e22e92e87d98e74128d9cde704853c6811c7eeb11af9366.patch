+"""Protected-Racket witness for a public-demo color-8 preservation shortcut.
+
+The three public demonstrations never place a color-8 distractor on either
+post-turn leg.  Consequently a plausible solver that preserves every color-8
+cell fits all visible demonstrations.  A generated blocked-cross scene places
+an 8 on a later leg, where the canonical rule overwrites it with green.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator, normalize_grid
+
+TASK_ID = "49f2e1c9f51a"
+ROOT = find_root(__file__)
+_HOME = ROOT / "generators" / TASK_ID
+_REPLACE_SITE = "(painted (paint-cells g path 3))"
+_REPLACE_WITH = "(painted (paint-cells g (filter (lambda (p) (not (= (at g (first p) (second p)) 8))) path) 3))"
+
+
+def _training_row() -> dict[str, Any]:
+    rows = []
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID and row.get("source") == "training":
+                rows.append(row)
+    if len(rows) != 1:
+        raise ValueError(f"expected one training authority row, found {len(rows)}")
+    return rows[0]
+
+
+def _pairs(value: Any) -> list[dict[str, list[list[int]]]]:
+    if isinstance(value, dict):
+        value = [value]
+    if not isinstance(value, list):
+        raise ValueError("canonical pairs must be a list or object")
+    result = []
+    for pair in value:
+        if not isinstance(pair, dict):
+            raise ValueError("canonical pair must be an object")
+        result.append({
+            "input": normalize_grid(pair.get("input")),
+            "output": normalize_grid(pair.get("output")),
+        })
+    return result
+
+
+def _rival_program(canonical: str) -> str:
+    if canonical.count(_REPLACE_SITE) != 1:
+        raise ValueError("canonical paint site changed; review the rival rather than guessing")
+    rival = canonical.replace(_REPLACE_SITE, _REPLACE_WITH, 1)
+    if rival == canonical:
+        raise AssertionError("rival construction did not change the program")
+    return rival
+
+
+def _literal(grid: Any) -> str:
+    value = normalize_grid(grid)
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in value) + ")"
+
+
+def _execute(bridge: RacketBridge, cache: dict[str, str], program: str,
+             grid: Any) -> list[list[int]]:
+    callable_source = cache.setdefault(program, wrap_rule(program))
+    return normalize_grid(bridge.eval_text(f"({callable_source} {_literal(grid)})"))
+
+
+def build_witness() -> dict[str, Any]:
+    row = _training_row()
+    demonstrations = _pairs(row.get("train"))
+    if len(demonstrations) != 3:
+        raise ValueError(f"expected three public demonstrations, found {len(demonstrations)}")
+    canonical_program = row.get("program_solution")
+    if not isinstance(canonical_program, str):
+        raise ValueError("training authority lacks a program_solution")
+    rival_program = _rival_program(canonical_program)
+
+    generator, source_path, source_sha256 = load_selected_generator(TASK_ID, root=ROOT)
+    query_profile = "horizontal_right_blocked_cross"
+    query_input = generator.generate(23, 4, difficulty="hard", scene_profile=query_profile)
+    query_analysis = generator._analysis(query_input)
+    if query_analysis["errors"]:
+        raise AssertionError(query_analysis["errors"])
+    query_output = generator.rule_mirror(query_input)
+    overwritten = list(query_analysis["facts"]["overwritten_eights"])
+    if not overwritten:
+        raise AssertionError("query must put at least one color-8 cell on a later path leg")
+
+    inputs = [pair["input"] for pair in demonstrations] + [query_input]
+    claimed = [pair["output"] for pair in demonstrations] + [query_output]
+    with RacketBridge() as bridge:
+        identity = deepcopy(bridge.runtime_identity)
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise ValueError("lesson probe requires protected Racket")
+        cache: dict[str, str] = {}
+        canonical_outputs = [_execute(bridge, cache, canonical_program, grid) for grid in inputs]
+        rival_outputs = [_execute(bridge, cache, rival_program, grid) for grid in inputs]
+
+    canonical_matches = canonical_outputs == claimed
+    rival_demo_matches = [actual == expected for actual, expected in zip(
+        rival_outputs[:3], canonical_outputs[:3], strict=True
+    )]
+    query_differs = rival_outputs[3] != canonical_outputs[3]
+    if not canonical_matches or not all(rival_demo_matches) or not query_differs:
+        raise AssertionError({
+            "canonical_matches": canonical_matches,
+            "rival_demo_matches": rival_demo_matches,
+            "query_differs": query_differs,
+        })
+
+    return {
+        "schema": "arcpuzzles-peer-learnability-witness-v1",
+        "task_id": TASK_ID,
+        "status": "shortcut_found",
+        "finding": "A solver that preserves all color-8 cells fits every public demonstration because none crosses an 8 after the first turn, but fails a lawful blocked-cross query.",
+        "demonstrations": 3,
+        "query_profile": query_profile,
+        "query_overwritten_eights": len(overwritten),
+        "overwritten_eight_cells": [list(cell) for cell in overwritten],
+        "canonical_matches_claimed_labels": canonical_matches,
+        "rival_fits_all_demonstrations": all(rival_demo_matches),
+        "rival_demo_matches": rival_demo_matches,
+        "query_differs": query_differs,
+        "racket_evaluations": 8,
+        "racket": identity,
+        "generator_source": source_path.relative_to(ROOT).as_posix(),
+        "generator_sha256": source_sha256,
+        "canonical_program": canonical_program,
+        "canonical_program_sha256": hashlib.sha256(canonical_program.encode()).hexdigest(),
+        "rival_program": rival_program,
+        "rival_program_sha256": hashlib.sha256(rival_program.encode()).hexdigest(),
+        "demo_inputs": [deepcopy(pair["input"]) for pair in demonstrations],
+        "demo_outputs": canonical_outputs[:3],
+        "query_input": deepcopy(query_input),
+        "canonical_query_output": canonical_outputs[3],
+        "rival_query_output": rival_outputs[3],
+        "repair_recommendation": "When assembling a lesson, place at least one blocked-cross scene with a post-turn color-8 crossing in the visible demonstrations; the current generator already provides four such profiles, so no production-rule change is needed.",
+        "limits": "One concrete source-bound lesson and one named rival; not a proof against every alternative rule.",
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args(argv)
+    report = build_witness()
+    encoded = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out is not None:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(encoded)
+    print(json.dumps({
+        "status": report["status"],
+        "task_id": TASK_ID,
+        "racket_evaluations": report["racket_evaluations"],
+        "rival_fits_all_demonstrations": report["rival_fits_all_demonstrations"],
+        "query_differs": report["query_differs"],
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
