+"""Executable learnability witness for the preserve-color-8 shortcut."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+
+from reviewer_support import find_root
+
+TASK = "49f2e1c9f51a"
+ROOT = find_root(__file__)
+PROBE = ROOT / "generators" / TASK / "workspace" / "lesson_probe.py"
+
+
+def _load_probe():
+    assert PROBE.is_file(), "lesson probe has not been built"
+    spec = importlib.util.spec_from_file_location("_peer_probe_49f2e1c9f51a", PROBE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_public_demos_admit_preserve_eights_shortcut_but_crossing_query_refutes_it():
+    report = _load_probe().build_witness()
+    assert report["status"] == "shortcut_found"
+    assert report["demonstrations"] == 3
+    assert report["query_profile"] == "horizontal_right_blocked_cross"
+    assert report["canonical_matches_claimed_labels"] is True
+    assert report["rival_fits_all_demonstrations"] is True
+    assert report["query_differs"] is True
+    assert report["query_overwritten_eights"] >= 1
+    assert report["racket"]["backend"] == "racket"
+    assert report["racket"]["protected"] is True
+    assert report["racket_evaluations"] == 8
