(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((sep-rows (filter (lambda (r)
                                      (all? (lambda (c) (zero? (at g r c))) (range 0 w)))
                                    (range 0 h)))
                  (sep-cols (filter (lambda (c)
                                      (all? (lambda (r) (zero? (at g r c))) (range 0 h)))
                                    (range 0 w)))
                  (sr0 (first sep-rows))
                  (sr1 (second sep-rows))
                  (sc0 (first sep-cols))
                  (sc1 (second sep-cols)))
             (cellmap g
                      (r c v)
                      (let ((v v))
                        (if (zero? v)
                            0
                            (let* ((gr (cond ((< r sr0) 0) ((> r sr1) 2) (else 1)))
                                   (gc (cond ((< c sc0) 0) ((> c sc1) 2) (else 1)))
                                   (base-r (cond
                                             ((zero? gr) 0)
                                             ((= gr 1) (+ sr0 1))
                                             (else (+ sr1 1))))
                                   (base-c (cond
                                             ((zero? gc) 0)
                                             ((= gc 1) (+ sc0 1))
                                             (else (+ sc1 1))))
                                   (lr (- r base-r))
                                   (lc (- c base-c))
                                   (h-mark (if (= gc 1)
                                               (let ((lv (at g (+ base-r lr) (+ 0 lc)))
                                                     (rv (at g
                                                             (+ base-r lr)
                                                             (+ (+ sc1 1) lc))))
                                                 (if (and (= lv rv) (!= lv 1)) lv 0))
                                               0))
                                   (v-mark (if (= gr 1)
                                               (let ((tv (at g (+ 0 lr) (+ base-c lc)))
                                                     (bv (at g
                                                             (+ (+ sr1 1) lr)
                                                             (+ base-c lc))))
                                                 (if (and (= tv bv) (!= tv 1)) tv 0))
                                               0)))
                              (cond
                                ((!= v-mark 0) v-mark)
                                ((!= h-mark 0) h-mark)
                                (else v))))))))))