+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+PARAM = HOME / "workspace" / "parametric"
+
+
+def load_adapter():
+    path = PARAM / "adapter.py"
+    spec = importlib.util.spec_from_file_location("translate_fragment_adapter", path)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def fingerprint(grid):
+    return json.dumps(grid, separators=(",", ":"))
+
+
+def test_settings_share_inputs_and_default_program_is_exact():
+    adapter = load_adapter()
+    canonical = adapter.generate(17, {"finish": "translate_only"}, demos=3, queries=4)
+    alternate = adapter.generate(17, {"finish": "largest_visible_fragment"}, demos=3, queries=4)
+    assert [p["input"] for p in canonical["train"] + canonical["test"]] == [
+        p["input"] for p in alternate["train"] + alternate["test"]
+    ]
+    assert adapter.program({"finish": "translate_only"}).encode() == (PARAM / "canonical.rkt").read_bytes()
+
+
+@pytest.mark.parametrize("demos", range(2, 7))
+@pytest.mark.parametrize("queries", range(1, 5))
+def test_counts_prefix_and_teaching(demos, queries):
+    adapter = load_adapter()
+    episode = adapter.generate(5, {"finish": "largest_visible_fragment"}, demos=demos, queries=queries)
+    assert len(episode["train"]) == demos
+    assert len(episode["test"]) == queries
+    fps = [fingerprint(p["input"]) for p in episode["train"] + episode["test"]]
+    assert len(fps) == len(set(fps))
+    assert adapter.teaching_check(episode)["status"] == "identified"
+
+
+def test_queries_are_prefix_stable_and_public_projection_is_input_only():
+    adapter = load_adapter()
+    four = adapter.generate(9, {"finish": "translate_only"}, demos=3, queries=4)
+    one = adapter.generate(9, {"finish": "translate_only"}, demos=3, queries=1)
+    assert four["train"] == one["train"]
+    assert four["test"][0] == one["test"][0]
+    assert adapter.public_turn(four, 0) == adapter.public_turn(one, 0)
+    for index in range(4):
+        turn = adapter.public_turn(four, index)
+        assert len(turn["test"]) == 1
+        assert turn["test"][0] == {"input": four["test"][index]["input"]}
+        assert "settings" not in turn and "program_solution" not in turn
+        if index:
+            assert set(turn) == {"test"}
+
+
+def test_clipping_creates_fragments_and_wrong_order_changes_output():
+    adapter = load_adapter()
+    episode = adapter.generate(0, {"finish": "largest_visible_fragment"}, demos=2, queries=4)
+    grid = episode["test"][0]["input"]
+    selected = adapter.solve(grid, {"finish": "largest_visible_fragment"})
+    wrong = adapter.wrong_order_solve(grid)
+    trace = adapter.dependency_trace(grid, {"finish": "largest_visible_fragment"})
+    assert selected != wrong
+    assert trace["visible_components"] == 2
+    assert trace["largest_visible_cells"] > trace["smallest_visible_cells"]
+    assert sum(v == 4 for row in selected for v in row) == trace["largest_visible_cells"]
+    assert sum(v == 8 for row in selected for v in row) == trace["smallest_visible_cells"]
+
+
+def test_fourth_query_is_substantive_30_by_30():
+    adapter = load_adapter()
+    episode = adapter.generate(23, {"finish": "largest_visible_fragment"}, demos=2, queries=4)
+    grid = episode["test"][3]["input"]
+    assert (len(grid), len(grid[0])) == (30, 30)
+    assert sum(v == 3 for row in grid for v in row) >= 40
+    out = episode["test"][3]["output"]
+    assert sum(v == 4 for row in out for v in row) >= 10
+    assert sum(v == 8 for row in out for v in row) >= 8
+
+
+@pytest.mark.parametrize("settings", [{}, {"finish": "bogus"}, {"finish": True}, {"finish": "translate_only", "x": 1}])
+def test_invalid_settings_reject(settings):
+    adapter = load_adapter()
+    with pytest.raises(ValueError):
+        adapter.generate(0, settings, demos=2, queries=1)
