(rule!
  (let ((dummy 0))
    (define (normalize cells)
      (let ((bb (bbox-of-cells cells)))
        (map (lambda (p) (list (- (first p) (first bb))
                               (- (second p) (second bb))))
             cells)))
    (define (rotate-cw cells height)
      (map (lambda (p) (list (second p) (- height 1 (first p)))) cells))
    (define (flip-lr cells width)
      (map (lambda (p) (list (first p) (- width 1 (second p)))) cells))
    (let* ((comp2 (first (sort (objects (keep-only g 2) 0)
                               (lambda (a b) (> (obj-size a) (obj-size b))))))
           (comp3 (first (sort (objects (keep-only g 3) 0)
                               (lambda (a b) (> (obj-size a) (obj-size b))))))
           (n2 (normalize (obj-cells comp2)))
           (n3 (normalize (obj-cells comp3)))
           (pts (sort (filter (lambda (p) (member p n3)) n2)
                      (lambda (a b)
                        (if (= (first a) (first b))
                            (< (second a) (second b))
                            (< (first a) (first b)))))))
      (if (empty? pts)
          (list (list 0))
          (let* ((height (+ (apply max (map first pts)) 1))
                 (width (+ (apply max (map second pts)) 1))
                 (odd-count (= (modulo (length pts) 2) 1))
                 (out-pts (if odd-count
                              (rotate-cw pts height)
                              (flip-lr pts width)))
                 (out-height (if odd-count width height))
                 (out-width (if odd-count height width)))
            (paint-cells (empty-grid out-height out-width 0) out-pts 8))))))
