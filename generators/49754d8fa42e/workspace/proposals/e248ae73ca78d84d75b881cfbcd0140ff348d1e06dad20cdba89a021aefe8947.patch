@@ -0,0 +1,76 @@
+"""Bounded source-bound demonstration coverage probe; no production mutation."""
+from pathlib import Path
+import hashlib
+import importlib.util
+import json
+import argparse
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+
+def run(out):
+    root = Path.cwd()
+    path = root / 'generators/4c1d80c25a99/generator.py'
+    spec = importlib.util.spec_from_file_location('peer_wall_class_current', path)
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    record = Catalog(root).get('4c1d80c25a99')
+    programs = {v['program_solution'] for v in record['variants']}
+    assert len(programs) == 1
+    program = next(iter(programs))
+    old = '(member? v (list 1 7 9))'
+    assert program.count(old) == 1
+    rival = program.replace(old, '(= v 1)')
+    selected = None
+    for seed in range(128):
+        grids = [generator.generate(seed, i, difficulty='medium') for i in range(4)]
+        walls = [{v for row in g for v in row if v in (1, 7, 9)} for g in grids]
+        if walls[:3] == [{1}] * 3 and walls[3] in ({7}, {9}):
+            selected = (seed, grids, walls)
+            break
+    assert selected is not None, 'No bounded wall-class counterexample found'
+    seed, grids, walls = selected
+    assert all(generator.self_check(g) == [] for g in grids)
+    runtime = root / 'shared/runtime'
+    with _local_imports(runtime, path.parent):
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            labels = [apply(program, g) for g in grids]
+            predictions = [apply(rival, g) for g in grids]
+        finally:
+            bridge.close()
+    matches = [actual == predicted for actual, predicted in zip(labels, predictions)]
+    assert matches == [True, True, True, False]
+    report = {
+        'schema': '4c1d80c25a99-bounded-wall-class-review-v1',
+        'status': 'confirmed_teaching_counterexample',
