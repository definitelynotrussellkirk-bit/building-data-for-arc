+"""One bounded learnability probe; execute through the packet review.py run launcher."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import time
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+TASK = "f69240d923b2"
+RIVAL = "(rule! (lambda (g) (crop-to-content (cellmap g (r c v) (if (= v 8) 0 v)) 0)))"
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def sexpr(value):
+    return "(" + " ".join(sexpr(item) for item in value) + ")" if isinstance(value, list) else str(value)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--max-seeds", type=int, default=64)
+    args = parser.parse_args()
+    if not 1 <= args.max_seeds <= 64:
+        raise ValueError("This probe permits 1..64 seeds only")
+    if args.output.exists():
+        raise ValueError("Evidence output must be fresh")
+    started = time.monotonic()
+    root = Path(__file__).resolve().parents[3]
+    home = root / "generators" / TASK
+    source = home / "generator.py"
+    catalog = Catalog(root)
+    description = catalog.describe(TASK)
+    canonical_set = {v["program_solution"] for v in catalog._variants()[description.get("rule_task_id", TASK)]}
+    if len(canonical_set) != 1:
+        raise ValueError("Expected one exact canonical program")
+    canonical = canonical_set.pop()
+    programs = {"canonical": canonical, "erase_frame_then_tight_crop": RIVAL}
+    evidence = {
+        "schema": "arcpuzzles-bounded-peer-learnability-probe-v1",
+        "task_id": TASK,
+        "source": {"path": source.relative_to(root).as_posix(), "sha256": digest(source.read_bytes())},
+        "reproducer": {"path": Path(__file__).resolve().relative_to(root).as_posix(),
+                       "sha256": digest(Path(__file__).read_bytes())},
+        "rule_hash": description["rule_hash"],
+        "programs": {name: {"source": code, "sha256": digest(code.encode())}
+                     for name, code in programs.items()},
+        "review_index_present": (home / "evidence/review_index.json").exists(),
+        "limits": {"rivals": 1, "max_seeds": args.max_seeds, "seed_range": [0, args.max_seeds - 1],
+                   "demos_per_lesson": 3, "queries_per_lesson": 1,
+                   "sample_indices": [0, 1, 2, 3], "difficulty": None,
+                   "overrides": {}, "stop_at_first_witness": True,
+                   "scope": "Generated default lessons only; no full battery or uniqueness claim."},
+        "lessons": [],
+    }
+    evaluations = calls = grids_checked = 0
+    runtime = root / "shared/runtime"
+    with _local_imports(runtime, home):
+        from puzzle_generators.rule_wrap import wrap_rule
+        name = "_peer_crop_generator_" + TASK
+        spec = importlib.util.spec_from_file_location(name, source)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+        _, identity, bridge = _real_evaluator(runtime)
+        evidence["racket"] = identity
+        wrapped = {name: wrap_rule(code) for name, code in programs.items()}
+        try:
+            for seed in range(args.max_seeds):
+                grids = [_grid(module.generate(seed, index)) for index in range(4)]
+                if any(module.self_check(grid) for grid in grids):
+                    raise ValueError("Generated input failed the generator's own checks")
+                if len({json.dumps(grid) for grid in grids}) != 4:
+                    raise ValueError("Duplicate inputs in candidate lesson")
+                grids_checked += 4
+                predictions = {}
+                for name, code in wrapped.items():
+                    result = bridge.eval_text(f"(map {code} '{sexpr(grids)})")
+                    if type(result) is not list or len(result) != 4:
+                        raise ValueError("Unexpected protected-Racket batch result")
+                    predictions[name] = [_grid(grid) for grid in result]
+                    evaluations += 4
+                    calls += 1
+                labels = predictions["canonical"]
+                rival = predictions["erase_frame_then_tight_crop"]
+                fits = labels[:3] == rival[:3]
+                differs = labels[3] != rival[3]
+                evidence["lessons"].append({"seed": seed, "demonstrations_fit_rival": fits,
+                                            "query_disagrees": differs})
+                if fits and differs:
+                    evidence.update(status="witnessed", finding=(
+                        "Three generated demonstrations admit erasing the cyan frame and tightly "
+                        "cropping remaining nonzero content. The next generated query contains "
+                        "an all-zero interior edge that the canonical frame crop preserves and "
+                        "the rival removes."))
+                    evidence["witness"] = {
+                        "seed": seed,
+                        "train": [{"sample_index": i, "input": grids[i], "output": labels[i],
+                                   "rival_output": rival[i]} for i in range(3)],
+                        "test": [{"sample_index": 3, "input": grids[3], "output": labels[3],
+                                  "rival_output": rival[3]}],
+                    }
+                    break
+            else:
+                evidence.update(status="bounded_no_finding", finding=(
+                    "No fitting-three-demonstration/divergent-query witness was found for this "
+                    "one rival within the stated finite seed bound; uniqueness was not established."))
+        finally:
+            bridge.close()
+    if digest(source.read_bytes()) != evidence["source"]["sha256"]:
+        raise ValueError("Generator source changed during probe")
+    evidence["counts"] = {"lessons_tested": len(evidence["lessons"]), "generated_grids": grids_checked,
+                          "protected_grid_program_evaluations": evaluations,
+                          "protected_bridge_calls": calls}
+    evidence["elapsed_seconds"] = round(time.monotonic() - started, 6)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(evidence, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({key: evidence[key] for key in ("task_id", "status", "finding", "counts", "elapsed_seconds")}))
+    print("evidence=" + str(args.output))
+
+
+if __name__ == "__main__":
+    main()
