(rule!
  (define bg (mode g -1))
  (define os (objects g bg))
  (define source (pick-max os obj-size))
  (define source-color (obj-color source))
  (define anchor (first (filter (lambda (o) (and (= (obj-size o) 1) (= (obj-color o) source-color))) os)))
  (define marks (filter (lambda (o) (not (= (obj-color o) source-color))) os))
  (define mark-color (obj-color (first marks)))
  (define ar (obj-r1 anchor))
  (define ac (obj-c1 anchor))
  (define (gcd2 a b) (if (= b 0) (abs a) (gcd2 b (remainder a b))))
  (define dy-unit (max 1 (for/fold ([n 0]) ([o marks]) (gcd2 n (- (obj-r1 o) ar)))))
  (define dx-unit (max 1 (for/fold ([n 0]) ([o marks]) (gcd2 n (- (obj-c1 o) ac)))))
  (define offsets (map (lambda (o) (list (quotient (- (obj-r1 o) ar) dy-unit) (quotient (- (obj-c1 o) ac) dx-unit))) marks))
  (define placements offsets)
  (define motif-h (obj-h source))
  (define motif-w (obj-w source))
  (define blank (build-grid h w (r c) bg))
  (define centered (recolor-cells blank (obj-cells source) mark-color))
  (for/fold ([out centered]) ([p placements])
    (define moved (map (lambda (q) (list (+ (first q) (* (first p) motif-h)) (+ (second q) (* (second p) motif-w)))) (obj-cells source)))
    (recolor-cells out moved source-color)))
