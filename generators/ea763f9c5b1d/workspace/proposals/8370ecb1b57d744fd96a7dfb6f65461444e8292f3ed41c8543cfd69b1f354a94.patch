+(rule!
+ (let ((dummy 0))
+   (define dirs4 (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))
+   (define (paint grid cells color)
+     (for/fold ((out grid)) ((p (in-list cells)))
+       (if (in-bounds? (first p) (second p) (rows out) (cols out))
+           (set-cell out (first p) (second p) color)
+           out)))
+   (define (components-any-nonzero grid)
+     (let loop-pos ((positions (grid-positions grid)) (seen (list)) (acc (list)))
+       (cond
+         ((empty? positions) (reverse acc))
+         ((or (member? (first positions) seen)
+              (= (at grid (first (first positions)) (second (first positions))) 0))
+          (loop-pos (rest positions) seen acc))
+         (else
+          (let bfs ((queue (list (first positions)))
+                    (seen2 (cons (first positions) seen))
+                    (cells (list)))
+            (if (empty? queue)
+                (loop-pos (rest positions) seen2 (cons (sort cells cell<) acc))
+                (let* ((cur (first queue))
+                       (nbrs
+                        (filter
+                         (lambda (p)
+                           (and (in-bounds? (first p) (second p) (rows grid) (cols grid))
+                                (not (member? p seen2))
+                                (not (= (at grid (first p) (second p)) 0))))
+                         (map (lambda (d)
+                                (list (+ (first cur) (first d))
+                                      (+ (second cur) (second d))))
+                              dirs4))))
+                  (bfs (append (rest queue) nbrs)
+                       (append seen2 nbrs)
+                       (cons cur cells)))))))))
+   (let* ((components (components-any-nonzero g))
+          (anchors
+           (filter
+            (lambda (cells)
+              (= (at g (first (first cells)) (second (first cells))) 1))
+            components))
+          (threshold (length (first anchors))))
+     (for/fold ((out (empty-grid (rows g) (cols g) 0)))
+               ((cells (in-list components)))
+       (paint out cells (if (< (length cells) threshold) 3 4))))))
diff --git a/repo/generators/ea763f9c5b1d/workspace/parametric/audit.py b/repo/generators/ea763f9c5b1d/workspace/parametric/audit.py
