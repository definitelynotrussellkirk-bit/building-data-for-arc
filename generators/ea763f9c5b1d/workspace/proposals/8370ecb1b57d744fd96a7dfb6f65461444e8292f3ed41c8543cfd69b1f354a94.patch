+"""Bounded learnability probe for the code-marker exclusion shortcut.
+
+The rival agrees with the canonical rule except when selector color equals the
+transform-code color: it treats both corner cells as metadata and therefore
+skips the top-right singleton that the canonical object ordering selects.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+TASK_ID = "0a6303ab93b7"
+EXPECTED_GENERATOR_SHA256 = "abc3d7381b002856257445f83acc09f242ff3a3c7b71964f98cf18777c17a82a"
+RIVAL_NAME = "exclude_both_corner_markers"
+_CARDINAL = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _components(grid: list[list[int]], color: int) -> list[list[tuple[int, int]]]:
+    height, width = len(grid), len(grid[0])
+    seen: set[tuple[int, int]] = set()
+    result: list[list[tuple[int, int]]] = []
+    for row in range(height):
+        for col in range(width):
+            if grid[row][col] != color or (row, col) in seen:
+                continue
+            stack = [(row, col)]
+            seen.add((row, col))
+            cells: list[tuple[int, int]] = []
+            while stack:
+                current = stack.pop()
+                cells.append(current)
+                r, c = current
+                for dr, dc in _CARDINAL:
+                    neighbor = (r + dr, c + dc)
+                    if (0 <= neighbor[0] < height and 0 <= neighbor[1] < width
+                            and neighbor not in seen
+                            and grid[neighbor[0]][neighbor[1]] == color):
+                        seen.add(neighbor)
+                        stack.append(neighbor)
+            result.append(cells)
+    return result
+
+
+def _object_grid(cells: list[tuple[int, int]], color: int) -> list[list[int]]:
+    top = min(row for row, _ in cells)
+    left = min(col for _, col in cells)
+    normalized = [(row - top, col - left) for row, col in cells]
+    height = max(row for row, _ in normalized) + 1
+    width = max(col for _, col in normalized) + 1
+    output = [[0] * width for _ in range(height)]
+    for row, col in normalized:
+        output[row][col] = color
+    return output
+
+
+def _transform(grid: list[list[int]], code: int) -> list[list[int]]:
+    if code == 2:
+        return [list(row) for row in zip(*grid[::-1])]
+    if code == 3:
+        return [row[::-1] for row in grid[::-1]]
+    if code == 4:
+        return [row[::-1] for row in grid]
+    return [list(row) for row in grid]
+
+
+def rival_output(grid: list[list[int]]) -> list[list[int]] | None:
+    """Execute the plausible wrong rule that excludes both corner markers."""
+    height, width = len(grid), len(grid[0])
+    selector = grid[0][0]
+    code = grid[0][width - 1]
+    candidates = [
+        cells for cells in _components(grid, selector)
+        if (0, 0) not in cells and (0, width - 1) not in cells
+    ]
+    if not candidates:
+        return None
+    candidates.sort(key=lambda cells: (
+        min(row for row, _ in cells),
+        min(col for _, col in cells),
+    ))
+    return _transform(_object_grid(candidates[0], selector), code)
+
+
+def _texture(grid: list[list[int]]) -> str:
+    selector, code = grid[0][0], grid[0][-1]
+    all_candidates = [cells for cells in _components(grid, selector) if (0, 0) not in cells]
+    if code == selector:
+        return "corner_wins"
+    if code >= 5:
+        return "weird_code"
+    body = [cells for cells in all_candidates if not any(row == 0 for row, _ in cells)]
+    if len(body) >= 2:
+        return "multi_candidate"
+    subgrid = _object_grid(body[0], selector)
+    if len({json.dumps(_transform(subgrid, candidate)) for candidate in (1, 2, 3, 4)}) < 4:
+        return "symmetric"
+    return "plain"
+
+
+def _row(generator: Any, seed: int, sample_index: int) -> dict[str, Any]:
+    grid = generator.generate(seed, sample_index)
+    canonical = generator._mirror(grid)
+    if canonical is None:
+        raise ValueError("selected generator produced no canonical object")
+    return {
+        "sample_index": sample_index,
+        "texture": _texture(grid),
+        "input": grid,
+        "canonical": canonical,
+        "rival": rival_output(grid),
+    }
+
+
+def lesson_window(generator: Any, *, seed: int, start: int) -> dict[str, Any]:
+    rows = [_row(generator, seed, start + offset) for offset in range(5)]
+    return {"seed": seed, "start": start, "demos": rows[:4], "query": rows[4]}
+
+
+def scan(generator: Any, *, seeds: int = 128, starts: int = 4) -> dict[str, Any]:
+    checked = 0
+    findings = 0
+    first: dict[str, int] | None = None
+    for seed in range(seeds):
+        for start in range(starts):
+            case = lesson_window(generator, seed=seed, start=start)
+            checked += 1
+            if (all(row["canonical"] == row["rival"] for row in case["demos"])
+                    and case["query"]["canonical"] != case["query"]["rival"]):
+                findings += 1
+                if first is None:
+                    first = {"seed": seed, "start": start}
+    return {
+        "lessons_checked": checked,
+        "surviving_disagreements": findings,
+        "first": first,
+    }
+
+
+def _canonical_program(root: Path) -> str:
+    from reviewer_support import canonical_path
+
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                return row["program_solution"]
+    raise KeyError(TASK_ID)
+
+
+def _rival_program(canonical: str) -> str:
+    needle = "(and (= (obj-color o) sel) (not (member (list 0 0) (obj-cells o))))"
+    replacement = (
+        "(and (= (obj-color o) sel) "
+        "(not (member (list 0 0) (obj-cells o))) "
+        "(not (member (list 0 (- (cols g) 1)) (obj-cells o))))"
+    )
+    if canonical.count(needle) != 1:
+        raise ValueError("canonical selector filter changed; rival patch is no longer source-bound")
+    return canonical.replace(needle, replacement)
+
+
+def _protected_replay(root: Path, canonical: str, rival: str, case: dict[str, Any]) -> dict[str, Any]:
+    from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+    runtime = root / "shared/runtime"
+    rows = [*case["demos"], case["query"]]
+    with _local_imports(runtime, runtime):
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            for row in rows:
+                actual = _grid(apply(canonical, _grid(row["input"])))
+                alternate = _grid(apply(rival, _grid(row["input"])))
+                if actual != _grid(row["canonical"]):
+                    raise ValueError("canonical Python mirror differs from protected Racket")
+                if alternate != _grid(row["rival"]):
+                    raise ValueError("rival Python mirror differs from protected Racket")
+        finally:
+            bridge.close()
+    if not all(row["canonical"] == row["rival"] for row in case["demos"]):
+        raise ValueError("retained rival does not fit every demonstration")
+    if case["query"]["canonical"] == case["query"]["rival"]:
+        raise ValueError("retained rival does not change the query")
+    return {"racket": identity, "evaluations": 2 * len(rows)}
+
+
+def build_report(*, seeds: int = 128, starts: int = 4) -> dict[str, Any]:
+    from reviewer_support import find_root, load_selected_generator
+
+    root = find_root(__file__)
+    generator, source_path, source_sha256 = load_selected_generator(TASK_ID, root=root)
+    if source_sha256 != EXPECTED_GENERATOR_SHA256:
+        raise ValueError(
+            f"generator source changed: expected {EXPECTED_GENERATOR_SHA256}, got {source_sha256}"
+        )
+    canonical = _canonical_program(root)
+    rival = _rival_program(canonical)
+    retained = lesson_window(generator, seed=0, start=3)
+    replay = _protected_replay(root, canonical, rival, retained)
+    summary = scan(generator, seeds=seeds, starts=starts)
+    return {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "rival": RIVAL_NAME,
+        "source_binding": {
+            "generator_path": source_path.relative_to(root).as_posix(),
+            "generator_sha256": source_sha256,
+            "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+            "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        },
+        "scan": summary,
+        "witness": {
+            "seed": retained["seed"],
+            "start": retained["start"],
+            "demos": retained["demos"],
+            "query": retained["query"],
+            **replay,
+        },
+        "repair": (
+            "Reject lessons while this rival survives, or ensure a visible demonstration has "
+            "code==selector so the canonical top-right singleton choice is observed."
+        ),
+        "limits": "Finite consecutive-window scan; no claim of universal ambiguity coverage.",
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seeds", type=int, default=128)
+    parser.add_argument("--starts", type=int, default=4)
+    args = parser.parse_args(argv)
+    if args.seeds < 1 or args.starts < 1:
+        parser.error("--seeds and --starts must be positive")
+    report = build_report(seeds=args.seeds, starts=args.starts)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    with args.out.open("x", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+    print(json.dumps({"status": report["status"], **report["scan"], "out": str(args.out)}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
