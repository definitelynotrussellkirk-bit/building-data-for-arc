+"""Regression for a query-only closure heuristic omitted by the declared rivals."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import load_selected_generator
+
+HOME = Path(__file__).resolve().parents[1]
+PROBE = HOME / "workspace" / "query_intrinsic_shortcut_probe.py"
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("probe_f7a512650552", PROBE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_retained_window_exposes_query_larger_closure_shortcut():
+    probe = _load_probe()
+    generator, _path, source_sha256 = load_selected_generator("f7a512650552")
+    assert source_sha256 == probe.EXPECTED_GENERATOR_SHA256
+
+    case = probe.lesson_window(generator, seed=0, start=0)
+    assert [row["mode"] for row in case["demos"]] == [0, 1, 0]
+    assert case["query"]["mode"] == 1
+    assert all(row["canonical"] == row["rival"] for row in case["demos"])
+    assert case["query"]["canonical"] != case["query"]["rival"]
+
+
+def test_bounded_scan_counts_only_survive_demos_then_disagree_query():
+    probe = _load_probe()
+    generator, _path, _source_sha256 = load_selected_generator("f7a512650552")
+    report = probe.scan(generator, seeds=1, starts=9)
+    assert report == {
+        "lessons_checked": 9,
+        "surviving_disagreements": 1,
+        "first": {"seed": 0, "start": 0},
+    }
