+"""Regression for the code-marker exclusion shortcut found during review."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import load_selected_generator
+
+HOME = Path(__file__).resolve().parents[1]
+PROBE = HOME / "workspace" / "learnability_probe.py"
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("probe_0a6303ab93b7", PROBE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_retained_window_exposes_code_marker_exclusion_shortcut():
+    probe = _load_probe()
+    generator, _path, source_sha256 = load_selected_generator("0a6303ab93b7")
+    assert source_sha256 == probe.EXPECTED_GENERATOR_SHA256
+
+    case = probe.lesson_window(generator, seed=0, start=3)
+    assert [row["texture"] for row in case["demos"]] == [
+        "plain",
+        "multi_candidate",
+        "weird_code",
+        "plain",
+    ]
+    assert case["query"]["texture"] == "corner_wins"
+    assert all(row["canonical"] == row["rival"] for row in case["demos"])
+    assert case["query"]["canonical"] != case["query"]["rival"]
+
+
+def test_bounded_scan_counts_only_survive_demos_then_disagree_query():
+    probe = _load_probe()
+    generator, _path, _source_sha256 = load_selected_generator("0a6303ab93b7")
+    report = probe.scan(generator, seeds=1, starts=4)
+    assert report == {
+        "lessons_checked": 4,
+        "surviving_disagreements": 1,
+        "first": {"seed": 0, "start": 3},
+    }
