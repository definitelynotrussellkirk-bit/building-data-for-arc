+        ),
+    }
+    if result["protected_racket"] is not True:
+        raise AssertionError("probe did not run in the protected Racket runtime")
+
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_text(
+        json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    result = run_probe(args.out)
+    print(
+        json.dumps(
+            {
+                "status": result["status"],
+                "task_id": result["task_id"],
+                "seed": result["seed"],
+                "nonzero_color_counts": result["nonzero_color_counts"],
+                "demo_matches": result["demo_matches"],
+                "query_matches": result["query_matches"],
+                "protected_racket": result["protected_racket"],
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
