+"""Source-pinned protected-Racket probe for a query-count-gated shortcut.
+
+For seed 0 and sample indices 0..3, the visible demonstrations contain 2, 2,
+and 1 color-1 query objects; the held query contains 4.  A rival can therefore
+use exact-shape matching normally, but on four-query inputs choose the first
+template of equal area.  It fits all demonstrations and fails the query.
+Production source is not modified.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import strip_rule_wrapper
+from reviewer_support import canonical_path, find_root, normalize_grid
+
+
+TASK_ID = "51481963f4a3"
+SEED = 0
+SAMPLE_INDICES = (0, 1, 2, 3)
+EXPECTED_GENERATOR_SHA256 = (
+    "3dfa138fe7eea00abd096015c58e7969a90cc91277a6e0df6f051ed8c4da6239"
+)
+
+_HERE = Path(__file__).resolve().parent
+_GENERATOR_PATH = _HERE.parent / "generator.py"
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load_generator():
+    raw = _GENERATOR_PATH.read_bytes()
+    name = "_generator_51481963f4a3_probe_" + hashlib.sha256(
+        str(_GENERATOR_PATH).encode() + raw
+    ).hexdigest()
+    existing = sys.modules.get(name)
+    if existing is not None:
+        return existing
+    spec = importlib.util.spec_from_file_location(name, _GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load {_GENERATOR_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    try:
+        spec.loader.exec_module(module)
+    except BaseException:
+        sys.modules.pop(name, None)
+        raise
+    return module
+
+
+generator = _load_generator()
+
+_FINAL_COLOR_EXPR = "(if (null? hits) #f (obj-color (first hits)))"
+_COUNT_GATED_EXPR = """(if (= (length ones) 4)
+                                     (let ((size-hits
+                                            (filter (lambda (t)
+                                                      (= (obj-size obj)
+                                                         (obj-size t)))
+                                                    templates)))
+                                       (if (null? size-hits)
+                                           #f
+                                           (obj-color (first size-hits))))
+                                     (if (null? hits)
+                                         #f
+                                         (obj-color (first hits))))"""
+
+
+def _canonical_program(root: Path) -> str:
+    matches = []
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("content_hash") == TASK_ID:
+                matches.append(row["program_solution"])
+    if len(matches) != 1:
+        raise ValueError(f"expected one canonical {TASK_ID} row, found {len(matches)}")
+    return matches[0]
+
+
+def _rival_program(canonical: str) -> str:
+    if canonical.count(_FINAL_COLOR_EXPR) != 1:
+        raise ValueError("canonical final color expression changed")
+    return canonical.replace(_FINAL_COLOR_EXPR, _COUNT_GATED_EXPR, 1)
+
+
+def _racket_datum(value: Any) -> str:
+    if type(value) is int:
+        return str(value)
+    if isinstance(value, (list, tuple)):
+        return "(" + " ".join(_racket_datum(item) for item in value) + ")"
+    raise TypeError(f"unsupported Racket datum: {type(value).__name__}")
+
+
+def _execute(bridge: RacketBridge, program: str, grid: list[list[int]]) -> list[list[int]]:
+    body = strip_rule_wrapper(program)
+    expression = f"({body} (quote {_racket_datum(normalize_grid(grid))}))"
+    return normalize_grid(bridge.eval_text(expression))
+
+
+def _python_rival(grid: list[list[int]]) -> list[list[int]]:
+    info = generator._analyze_scene(grid)
+    if info.get("errors"):
+        raise ValueError("invalid retained input: " + "; ".join(info["errors"]))
+    output = [list(row) for row in grid]
+    gated = len(info["queries"]) == 4
+    for query in info["queries"]:
+        if gated:
+            matches = [
+                template
+                for template in info["templates"]
+                if template["size"] == query["size"]
+            ]
+        else:
+            matches = [
+                template
+                for template in info["templates"]
+                if template["shape"] == query["shape"]
+            ]
+        if not matches:
+            continue
+        color = matches[0]["color"]
+        for row, col in query["cells"]:
+            output[row][col] = color
+    return output
+
+
+def run_probe(out: Path | str) -> dict[str, Any]:
+    destination = Path(out)
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError(destination)
+
+    generator_sha = _sha(_GENERATOR_PATH)
+    if generator_sha != EXPECTED_GENERATOR_SHA256:
+        raise ValueError(
+            f"generator source drift: expected {EXPECTED_GENERATOR_SHA256}, got {generator_sha}"
+        )
+
+    root = find_root(__file__)
+    grids = [
+        normalize_grid(generator.generate(SEED, sample_index))
+        for sample_index in SAMPLE_INDICES
+    ]
+    analyses = [generator._analyze_scene(grid) for grid in grids]
+    if any(info.get("errors") for info in analyses):
+        raise ValueError("retained lesson contains an invalid scene")
+    profiles = [info["profile"] for info in analyses]
+    query_counts = [len(info["queries"]) for info in analyses]
+    expected_profiles = [
+        "two_bijection",
+        "two_bijection",
+        "single_match",
+        "repeated_query",
+    ]
+    if profiles != expected_profiles or query_counts != [2, 2, 1, 4]:
+        raise ValueError(
+            f"retained lesson changed: profiles={profiles}, query_counts={query_counts}"
+        )
+
+    canonical = _canonical_program(root)
+    rival = _rival_program(canonical)
+    with RacketBridge(max_calls_before_restart=32) as bridge:
+        pairs = []
+        for grid in grids:
+            selected_output = _execute(bridge, canonical, grid)
+            rival_output = _execute(bridge, rival, grid)
+            python_selected = generator.rule_mirror(grid)
+            python_rival = _python_rival(grid)
+            if selected_output != python_selected:
+                raise AssertionError("protected Racket and canonical Python mirror disagree")
+            if rival_output != python_rival:
+                raise AssertionError("protected Racket and rival Python mirror disagree")
+            pairs.append(
+                {
+                    "input": grid,
+                    "selected_output": selected_output,
+                    "rival_output": rival_output,
+                    "matches": selected_output == rival_output,
+                }
+            )
+        runtime = bridge.runtime_identity
+
+    demo_matches = [pair["matches"] for pair in pairs[:3]]
+    query_matches = pairs[3]["matches"]
+    if demo_matches != [True, True, True] or query_matches is not False:
+        raise AssertionError(
+            f"counterexample no longer holds: demos={demo_matches}, query={query_matches}"
+        )
+
+    result: dict[str, Any] = {
+        "schema": "arcpuzzles-peer-curriculum-counterexample-v1",
+        "status": "counterexample",
+        "task_id": TASK_ID,
+        "seed": SEED,
+        "sample_indices": list(SAMPLE_INDICES),
+        "scene_profiles": profiles,
+        "query_object_counts": query_counts,
+        "shortcut": (
+            "Use exact normalized-shape matching unless the input contains "
+            "four color-1 query objects; then choose the first equal-area template."
+        ),
+        "demo_matches": demo_matches,
+        "query_matches": query_matches,
+        "pairs": pairs,
+        "selected_program": canonical,
+        "selected_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "rival_program": rival,
+        "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "generator_path": f"generators/{TASK_ID}/generator.py",
+        "generator_sha256": generator_sha,
+        "protected_racket": bool(runtime.get("protected")),
+        "racket": runtime,
+        "racket_evaluations": 8,
+        "recommendation": (
+            "When a four-query scene may be held out, include a four-query "
+            "demonstration or explicitly test query-count-gated matching rivals."
+        ),
+        "limits": (
+            "One exact four-pair seed and one named rival; this does not prove "
+            "other lessons ambiguous or prescribe the only repair."
+        ),
+    }
+    if result["protected_racket"] is not True:
+        raise AssertionError("probe did not run in the protected Racket runtime")
+
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_text(
+        json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    result = run_probe(args.out)
+    print(
+        json.dumps(
+            {
+                "status": result["status"],
+                "task_id": result["task_id"],
+                "seed": result["seed"],
+                "scene_profiles": result["scene_profiles"],
+                "query_object_counts": result["query_object_counts"],
+                "demo_matches": result["demo_matches"],
+                "query_matches": result["query_matches"],
+                "protected_racket": result["protected_racket"],
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
