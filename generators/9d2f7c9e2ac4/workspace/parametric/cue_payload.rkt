(rule!
 (let ((dummy 0))
  (define (e5-full-col grid color)
   (let ((hits (filter (lambda (c) (all? (lambda (r) (= (at grid r c) color)) (range (rows grid)))) (range (cols grid)))))
    (if (empty? hits) #f (first hits))))
  (define (e5-full-row grid color)
   (let ((hits (filter (lambda (r) (all? (lambda (c) (= (at grid r c) color)) (range (cols grid)))) (range (rows grid)))))
    (if (empty? hits) #f (first hits))))
  (define (e5-quadrant-bounds grid quad)
   (let ((gr (e5-full-row grid 9)) (gc (e5-full-col grid 9)))
    (cond ((equal? quad 'TL) (list 0 gr 0 gc))
          ((equal? quad 'TR) (list 0 gr (+ gc 1) (cols grid)))
          ((equal? quad 'BL) (list (+ gr 1) (rows grid) 0 gc))
          (else (list (+ gr 1) (rows grid) (+ gc 1) (cols grid))))))
  (define (e5-quad-cells grid quad)
   (let* ((b (e5-quadrant-bounds grid quad))
          (r0 (first b)) (r1 (second b)) (c0 (third b)) (c1 (fourth b)))
    (filter values
     (for*/list ((r (in-range r0 r1)) (c (in-range c0 c1)))
      (let ((v (at grid r c)))
       (if (or (= v 0) (= v 9)) #f (list v (- r r0) (- c c0))))))))
  (define (e5-rotate-rel-cells cells-rel)
   (let* ((coords (map (lambda (x) (list (second x) (third x))) cells-rel))
          (bb (bbox-of-cells coords))
          (rmin (first bb)) (cmin (second bb))
          (rmax (third bb)) (cmax (fourth bb))
          (h (+ 1 (- rmax rmin)))
          (shape (map (lambda (p) (list (- (first p) rmin) (- (second p) cmin))) coords))
          (rot (map (lambda (p) (list (second p) (- h 1 (first p)))) shape)))
    (list rot rmin cmin)))
  (define (e5-neighbors4 r c)
   (list (list (- r 1) c) (list (+ r 1) c) (list r (- c 1)) (list r (+ c 1))))
  (let ((cells-rel (e5-quad-cells g 'BL)))
   (if (empty? cells-rel)
       g
       (let* ((color (first (first cells-rel)))
              (rot-info (e5-rotate-rel-cells cells-rel))
              (rot (first rot-info))
              (roff (second rot-info))
              (coff (third rot-info))
              (b (e5-quadrant-bounds g 'BR))
              (br0 (first b)) (br1 (second b))
              (bc0 (third b)) (bc1 (fourth b))
              (stage-a
               (for/fold ((out g)) ((p (in-list rot)))
                (let ((rr (+ br0 roff (first p))) (cc (+ bc0 coff (second p))))
                 (if (and (< rr br1) (< cc bc1)) (set-cell out rr cc color) out))))
              (cue-colors
               (remove-duplicates
                (filter values
                 (for*/list ((r (in-range br0 br1)) (c (in-range bc0 bc1)))
                  (let ((v (at stage-a r c)))
                   (if (and (not (= v 0))
                            (not (= v 9))
                            (not (= v color))
                            (any? (lambda (p)
                                   (and (in-bounds? (first p) (second p) (rows stage-a) (cols stage-a))
                                        (= (at stage-a (first p) (second p)) color)))
                                  (e5-neighbors4 r c)))
                       v
                       #f))))))
              (cue-color (first cue-colors)))
        (cellmap stage-a (r c v) (if (= v cue-color) color v)))))))
