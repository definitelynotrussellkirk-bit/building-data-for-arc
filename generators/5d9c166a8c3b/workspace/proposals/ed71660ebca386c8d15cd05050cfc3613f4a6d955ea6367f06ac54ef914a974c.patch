+"""Bounded episode-level tie-break audit; does not change generator approval."""
+from pathlib import Path
+import hashlib
+import importlib.util
+import json
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.runtime import generate, validate_grid
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+TASK = "7b088f161470"
+EXPECTED = "ee796bd6fc60f5b0bb9664351830177d22c4b00a8fcdcc15164ba93ce1100a45"
+source = ROOT / "generators" / TASK / "generator.py"
+assert hashlib.sha256(source.read_bytes()).hexdigest() == EXPECTED
+spec = importlib.util.spec_from_file_location("peer_review_gen", source)
+gen = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(gen)
+
+def earliest_mirror(grid):
+    info = gen._analysis(grid)
+    output = [row[:] for row in info["output"]]
+    counts = info["rung_counts"]
+    positive = [(count, i) for i, count in enumerate(counts) if count > 0]
+    winner = min(positive)[1] if positive else 0
+    for i, row in enumerate(output):
+        row[4] = 5 if i == winner else 0
+    return output
+
+attempts = []
+selected = None
+for seed in range(24):
+    grids = [gen.generate(seed, i) for i in range(4)]
+    if len({json.dumps(grid) for grid in grids}) != 4:
+        continue
+    matches = [earliest_mirror(grid) == gen.rule_mirror(grid) for grid in grids]
+    attempts.append({"seed": seed, "matches": matches,
+                     "profiles": [gen._analysis(grid)["scene_profile"] for grid in grids]})
+    if all(matches[:3]) and not matches[3]:
+        selected = seed
+        break
+assert selected is not None, "No witness in the declared finite seed bound"
+catalog = Catalog(ROOT)
+episode, = generate(catalog, TASK, count=1, seed=selected, n_train=3, n_test=1, timeout=90)
+assert episode["executed_rule_hash"] == "5cb6f6518f37"
+canonical = episode["program"]
+old = "(- 100 (second p))"
+assert canonical.count(old) == 1
+rival = canonical.replace(old, "(+ 100 (second p))")
+bridge = RacketBridge()
+try:
+    identity = bridge.runtime_identity
+    assert identity["backend"] == "racket" and identity["protected"] is True
+    labels = []
+    for split in ("train", "test"):
+        for index, pair in enumerate(episode[split]):
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in pair["input"]) + ")"
+            correct = validate_grid(bridge.eval_text(f"({wrap_rule(canonical)} {literal})"))
+            wrong = validate_grid(bridge.eval_text(f"({wrap_rule(rival)} {literal})"))
+            assert correct == pair["output"] == gen.rule_mirror(pair["input"])
+            assert wrong == earliest_mirror(pair["input"])
+            labels.append({"split": split, "index": index,
+                           "rung_counts": gen._analysis(pair["input"])["rung_counts"],
+                           "canonical_output": correct, "rival_output": wrong,
+                           "agree": correct == wrong})
+finally:
+    bridge.shutdown()
+assert all(row["agree"] for row in labels if row["split"] == "train")
+assert any(not row["agree"] for row in labels if row["split"] == "test")
+report = {"schema": "arcpuzzles-bounded-peer-learnability-v1", "status": "finding",
+          "task_id": TASK, "source_sha256": EXPECTED, "rule_hash": "5cb6f6518f37",
+          "rival": "earliest rather than latest floor among equal smallest positive rung counts",
+          "seed_bound": [0, 23], "prefilter_attempts": attempts, "seed": selected,
+          "racket": identity, "racket_replay_evaluations": len(labels) * 2,
+          "episode": episode, "rival_program": rival, "comparisons": labels,
+          "limitation": "One actual three-demo/one-query episode and one rival; no universal ambiguity claim. Canonical production source unchanged.",
+          "recommendation": "Require a positive minimum-tie demonstration whenever any query requires the later-index tie-break."}
+out = ROOT.parent / "checks" / TASK / "bounded_tie_break_review.json"
+out.parent.mkdir(parents=True, exist_ok=True)
+out.write_text(json.dumps(report, indent=2) + "\n")
+print(json.dumps({"status": report["status"], "seed": selected,
+                  "sample_indices": episode["sample_indices"], "comparisons": labels,
+                  "racket": identity, "evidence": str(out)}))
