+"""Bounded three-demo corner-anchor audit; labels require protected Racket."""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import find_root, load_selected_generator
+
+TASK = "9d2f7c9e2ac4"
+EXPECTED = "8105b0c6704d022567a9681768c76fc3624d3be5c300b1b941a9fbc1494cf104"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    root = find_root(__file__)
+    module, source_path, source_hash = load_selected_generator(TASK, root=root)
+    if source_hash != EXPECTED:
+        raise ValueError("Source changed; re-review this witness")
+    ledger = root / "shared/data/canonical/puzzles.jsonl"
+    programs = {row["program_solution"] for line in ledger.read_text().splitlines()
+                if line.strip() and (row := json.loads(line)).get("task_id") == TASK}
+    if len(programs) != 1:
+        raise ValueError("Expected one canonical program")
+    canonical = programs.pop()
+    old = "(list rot rmin cmin)"
+    if canonical.count(old) != 1:
+        raise ValueError("Canonical corner-anchor construction changed")
+    rival = canonical.replace(old,
+        "(list rot (+ rmin (- h (+ 1 (- cmax cmin)))) cmin)")
+    grids = [module.generate(2, index, difficulty="easy") for index in range(1, 5)]
+    if any(module.self_check(grid) or module.strict_canonical_like(grid) for grid in grids):
+        raise ValueError("The selected ordinary inputs failed current validators")
+    bridge = RacketBridge()
+    try:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise ValueError("Protected Racket required")
+        def run(program, grid):
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            output = bridge.eval_text(f"({wrap_rule(program)} {literal})")
+            if (type(output) is not list or len(output) != len(grid)
+                    or any(type(row) is not list or len(row) != len(grid[0])
+                           or any(type(cell) is not int or not 0 <= cell <= 9 for cell in row)
+                           for row in output)):
+                raise ValueError("Malformed Racket output")
+            return output
+        outputs = [run(canonical, grid) for grid in grids]
+        alternatives = [run(rival, grid) for grid in grids]
+    finally:
+        bridge.close()
+    pairs = [{"input": grid, "output": output} for grid, output in zip(grids, outputs)]
+    fits = [actual == alternative for actual, alternative in zip(outputs, alternatives)]
+    if fits != [True, True, True, False]:
+        raise AssertionError(f"Expected distinguishing fourth pair: {fits}")
+    hook = module.lesson_identifiable(pairs[:3], pairs[3])
+    if hook:
+        raise AssertionError("The known finite hook already detects this window")
+    features = []
+    for index, grid in enumerate(grids, start=1):
+        source = module._panel(grid, "BL")
+        normalized = module._normalize(source)
+        features.append({"sample_index": index, "grid_n": len(grid),
+                         "source_cells": len(source), "source_offset": list(module._offset(source)),
+                         "source_bbox": [1 + max(r for r, _ in normalized),
+                                         1 + max(c for _, c in normalized)]})
+    changed = [[r, c, outputs[3][r][c], alternatives[3][r][c]]
+               for r in range(len(grids[3])) for c in range(len(grids[3][0]))
+               if outputs[3][r][c] != alternatives[3][r][c]]
+    existing = root / f"generators/{TASK}/counterexamples/current-shortcut.json"
+    result = {
+        "schema": "arcpuzzles-bounded-peer-learnability-review-v1", "task_id": TASK,
+        "status": "finding", "generator_sha256": source_hash,
+        "generator_path": source_path.relative_to(root).as_posix(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "existing_evidence": {"path": existing.relative_to(root).as_posix(),
+                              "sha256": hashlib.sha256(existing.read_bytes()).hexdigest()},
+        "selection": {"seed": 2, "difficulty": "easy", "sample_indices": [1, 2, 3, 4],
+                      "overrides": {}, "basis": "consecutive direct generator draws; no rejection or filtering",
+                      "discovery": "bounded Python screen stopped at seed 2, start 1; fresh labels below are Racket"},
+        "racket": {k: v for k, v in identity.items()
+                   if k in ("backend", "protected", "binary_sha256", "prelude_sha256", "bridge_sha256")},
+        "racket_evaluations": 8, "features": features,
+        "rival": {"name": "preserve_bottom_left_bbox_corner",
+                  "description": "Rotate clockwise while preserving the source bbox bottom row and left column.",
+                  "program": rival, "program_sha256": hashlib.sha256(rival.encode()).hexdigest()},
+        "canonical_program": canonical,
+        "train": pairs[:3], "test": [pairs[3]], "rival_query_output": alternatives[3],
+        "demo_matches": fits[:3], "query_matches": fits[3], "query_changed_cells": changed,
+        "current_declared_rival_count": len(module.LESSON_COMPETITORS), "current_lesson_hook_reasons": hook,
+        "interpretation": "All demos have square 3x3 source boxes, hiding corner choice. The query has a 3x2 source box and the rival shifts its rotated result down one row.",
+        "suggested_follow_up": "Add corner-anchor rivals and ensure a non-square source witness remains among demos under query holdouts; preserve source authority and input diversity.",
+        "limits": ["One finite source-bound window; no prevalence estimate or universal ambiguity claim.",
+                   "Direct generator draws, not a new runner/materializer census.",
+                   "The visible upper analogy supports top-left anchoring, but the tested executable rival leaves that fixed context unchanged, as the canonical program does.",
+                   "No generator, rule, approval, or admission changes."]}
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, sort_keys=True, separators=(",", ":")) + "\n")
+    print(json.dumps({"status": result["status"], "demo_matches": fits[:3],
+                      "query_matches": fits[3], "changed_query_cells": len(changed),
+                      "racket_evaluations": 8, "out": str(args.out)}))
+
+
+if __name__ == "__main__":
+    main()
