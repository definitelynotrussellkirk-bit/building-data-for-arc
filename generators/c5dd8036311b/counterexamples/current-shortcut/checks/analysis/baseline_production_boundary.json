    "program": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g))\n                (bar-row (find-first (lambda (r)\n                                       (for/or ((c (range 0 w))) (= (at g r c) 1)))\n                                     (range 0 h)))\n                (markers (filter (lambda (c)\n                                   (let ((v (at g bar-row c))) (and (!= v 0) (!= v 1))))\n                                 (range 0 w))))\n           (reduce (lambda (grid mc)\n                     (let* ((color (at g bar-row mc))\n                            (col-h (if (= color 8) 3 4))\n                            (start-r (- bar-row col-h)))\n                       (reduce (lambda (g2 dr)\n                                 (let ((r (+ start-r dr)))\n                                   (if (and (>= r 0) (< r bar-row))\n                                       (set-cell g2 r mc (if (zero? dr) color 1))\n                                       g2)))\n                               grid\n                               (range 0 col-h))))\n                   g\n                   markers))))",
