(rule!
  (let ((dummy 0))
    (let* ((src (first (find-color g 1)))
           (dst (first (find-color g 2)))
           (dr (- (first dst) (first src)))
           (dc (- (second dst) (second src)))
           (pointer (first (find-color g 8)))
           (selector-r (+ (first pointer) dr))
           (selector-c (+ (second pointer) dc))
           (selected-color (at g selector-r selector-c))
           (cargo (filter
                   (lambda (p) (= (at g (first p) (second p)) 9))
                   (grid-positions g))))
      (for/fold ((out (empty-grid (rows g) (cols g) 0))) ((p (in-list cargo)))
        (let ((r (+ (first p) dr))
              (c (+ (second p) dc)))
          (if (in-bounds? r c (rows g) (cols g))
              (set-cell out r c selected-color)
              out))))))
