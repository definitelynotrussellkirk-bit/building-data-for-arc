(rule!
  (let ((dummy 0))
    (define (colors-reading grid)
      (remove-duplicates
       (filter (lambda (v) (not (= v 0)))
               (map (lambda (p) (at grid (first p) (second p))) (grid-positions grid)))))
    (define (border-cells r0 c0 r1 c1)
      (for*/list ((r (in-range r0 (+ r1 1)))
                  (c (in-range c0 (+ c1 1)))
                  #:when (or (= r r0) (= r r1) (= c c0) (= c c1)))
        (list r c)))
    (define outlined
      (for/fold ((out (empty-grid (rows g) (cols g) 0)))
                ((color (in-list (colors-reading g))))
        (let ((pts (find-color g color)))
          (if (= (length pts) 2)
              (let ((bb (bbox-of-cells pts)))
                (paint-cells out (border-cells (first bb) (second bb) (third bb) (fourth bb)) color))
              out))))
    (define h (rows outlined))
    (define w (cols outlined))
    (define (touches-border? region)
      (any? (lambda (p)
              (or (= (first p) 0) (= (second p) 0)
                  (= (first p) (- h 1)) (= (second p) (- w 1))))
            region))
    (define holes (filter (lambda (region) (not (touches-border? region)))
                          (find-0-regions outlined 0)))
    (define chosen (first (sort holes (lambda (a b) (< (length a) (length b))))))
    (define dirs (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))
    (define colors
      (remove-duplicates
       (filter (lambda (v) (not (= v 0)))
               (for*/list ((p (in-list chosen))
                           (d (in-list dirs))
                           #:when (in-bounds? (+ (first p) (first d))
                                              (+ (second p) (second d)) h w))
                 (at outlined (+ (first p) (first d)) (+ (second p) (second d)))))))
    (paint-cells outlined chosen (first colors))))
