+"""One bounded retained-case replay for the NW-SE-only learnability rival."""
+from __future__ import annotations
+
+import hashlib
+import json
+import signal
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "shared/runtime"))
+from reviewer_support import load_selected_generator
+from arcpuzzles import Catalog
+
+TASK = "9e0cd377fa63"
+HOME = ROOT / "generators" / TASK
+OUT = ROOT.parent / "checks" / TASK
+RETAINED = HOME / "counterexamples/review-2c59567b97b3754e-v0001/retained/checks/audit" / TASK
+
+
+def nw_se_only(grid):
+    """Only northwest/southeast marker pairs draw an outline; others stay put."""
+    result = [row[:] for row in grid]
+    by_color = {}
+    for r, row in enumerate(grid):
+        for c, color in enumerate(row):
+            if color:
+                by_color.setdefault(color, []).append((r, c))
+    for color, points in by_color.items():
+        if len(points) != 2:
+            continue
+        (r1, c1), (r2, c2) = points
+        if r1 >= r2 or c1 >= c2:
+            continue
+        for r in range(r1, r2 + 1):
+            for c in range(c1, c2 + 1):
+                if r in (r1, r2) or c in (c1, c2):
+                    result[r][c] = color
+    return result
+
+
+def main():
+    signal.alarm(115)
+    OUT.mkdir(parents=True, exist_ok=True)
+    original = json.loads((ROOT / "shared/data/base/solutions/banks/e2825ca16ace/M64__9e0cd377fa63.json").read_text())
+    train = original["visible_context"]["train"]
+    canonical_test = [row["input"] for row in original["visible_context"]["test_inputs"]]
+    witness = json.loads((RETAINED / "counterexample.json").read_text())
+    query = witness["input"]
+    module, source, source_hash = load_selected_generator(TASK, root=ROOT)
+    assert source_hash == witness["generator_sha256"]
+    errors = module.self_check(query)
+    assert errors == [], errors
+    inputs = [pair["input"] for pair in train] + canonical_test + [query]
+    applied = Catalog(ROOT).apply(TASK, inputs, timeout=90)
+    (OUT / "racket.json").write_text(json.dumps(applied, indent=2) + "\n")
+    assert applied["generator_sha256"] == source_hash
+    assert applied["rule_hash_matches_catalog"]
+    assert applied["executed_rule_hash"] == witness["executed_rule_hash"]
+    assert all(row["valid_output"] and not row["error"] for row in applied["results"])
+    outputs = [row["output"] for row in applied["results"]]
+    demo_fits = [nw_se_only(pair["input"]) == out == pair["output"]
+                 for pair, out in zip(train, outputs[:len(train)], strict=True)]
+    original_query_fits = [nw_se_only(grid) == out for grid, out in
+                          zip(canonical_test, outputs[len(train):-1], strict=True)]
+    rival_query = nw_se_only(query)
+    differences = [{"row": r, "col": c, "rival": rival_query[r][c], "racket": value}
+                   for r, row in enumerate(outputs[-1]) for c, value in enumerate(row)
+                   if rival_query[r][c] != value]
+    assert all(demo_fits), demo_fits
+    assert outputs[-1] == witness["racket_output"]
+    assert len(differences) == 12, differences
+    summary = {
+        "schema": "bounded-peer-learnability-v1",
+        "task_id": TASK,
+        "generator_sha256": source_hash,
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "executed_rule_hash": applied["executed_rule_hash"],
+        "rule_text_sha256": applied["rule_text_sha256"],
+        "rival": "expand only NW-SE same-color marker pairs",
+        "retained_demo_fits": demo_fits,
+        "original_canonical_query_fits": original_query_fits,
+        "retained_adversarial_query_self_check_errors": errors,
+        "retained_query_label_reproduced": True,
+        "differing_cells": differences,
+        "racket_elapsed_seconds": applied["elapsed_seconds"],
+        "scope": "One rival, four retained demos, original canonical query, one retained lawful NE-SW query; no generation, seed search, battery, repair, or approval.",
+        "finding": "Existing diagonal coverage omission remains. Rival fits all retained demos and the original canonical query but fails the retained lawful adversarial query at 12 cells. Source inspection shows generated examples also use only NW-SE pairs.",
+        "proposal": "Include both diagonal orientations in future generated teaching contexts and queries; canonical Racket already handles both. Proposal only; no source or canonical change.",
+    }
+    (OUT / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps({k: summary[k] for k in ("task_id", "generator_sha256", "retained_demo_fits", "original_canonical_query_fits", "retained_query_label_reproduced", "racket_elapsed_seconds")}))
+    print("Retained adversarial query: 12 differing cells; one-rival scope only.")
+
+
+if __name__ == "__main__":
+    main()
