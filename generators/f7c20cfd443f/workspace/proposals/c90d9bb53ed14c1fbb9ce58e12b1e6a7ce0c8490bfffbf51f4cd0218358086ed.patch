+"""One bounded peer probe: corner priority is absent from ordinary demos.
+
+Run from the packet root through review.py run. No sampling search or repair.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import signal
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+
+def sha(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def main():
+    signal.alarm(110)
+    root = find_root(__file__)
+    tid = "9b2cd53e36fb"
+    generator, source, source_sha = load_selected_generator(tid, root=root)
+    with canonical_path(root).open() as handle:
+        records = [row for line in handle if line.strip()
+                   if (row := json.loads(line)).get("task_id") == tid]
+    assert records and len({r["program_solution"] for r in records}) == 1
+    program = records[0]["program_solution"]
+    vertical_clause = "((or touches-top touches-bot) 'rows)"
+    horizontal_clause = "((or touches-left touches-right) 'cols)"
+    assert program.count(vertical_clause) == program.count(horizontal_clause) == 1
+    rival = program.replace(vertical_clause, "__CORNER_CLAUSE__").replace(
+        horizontal_clause, vertical_clause).replace("__CORNER_CLAUSE__", horizontal_clause)
+    pairs = canonical_pairs(tid, root=root, variant=0, labeled_only=True)
+    assert len(pairs) == 4 and sum(p["split"] == "train" for p in pairs) == 3
+    kwargs = dict(difficulty="medium", grid_h=8, grid_w=10, edge="top",
+                  texture="corner_hole", hole_count=1, hole_len=2, hole_depth=2)
+    query = generator.generate(0, 0, **kwargs)
+    assert generator.self_check(query) == []
+    with RacketBridge(timeout=10.0) as bridge:
+        identity = bridge.runtime_identity
+        assert identity["backend"] == "racket" and identity["protected"] is True
+
+        def execute(src, grid):
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            return bridge.eval_text(f"({wrap_rule(src)} {literal})")
+
+        retained = []
+        for pair in pairs:
+            expected = pair["output"]
+            actual = execute(program, pair["input"])
+            alternate = execute(rival, pair["input"])
+            retained.append(dict(split=pair["split"], pair_index=pair["pair_index"],
+                                 canonical_matches_retained_label=actual == expected,
+                                 rival_matches_retained_label=alternate == expected))
+        canonical_query = execute(program, query)
+        rival_query = execute(rival, query)
+    assert all(p["canonical_matches_retained_label"] and p["rival_matches_retained_label"]
+               for p in retained)
+    differing = [[r, c] for r, row in enumerate(canonical_query)
+                 for c, v in enumerate(row) if v != rival_query[r][c]]
+    assert differing
+    report = dict(
+        schema="arcpuzzles-bounded-peer-learnability-v1", task_id=tid,
+        source_path=source.relative_to(root).as_posix(), source_sha256=source_sha,
+        canonical_variant=0,
+        rule_sha256=sha(program), rival_rule_sha256=sha(rival),
+        rival="Horizontal reflection takes priority when a zero component touches both a horizontal and a vertical edge; all other behavior is identical.",
+        program=program, rival_program=rival,
+        protected_racket={k: identity[k] for k in (
+            "schema", "backend", "protected", "binary_sha256", "prelude_sha256",
+            "bridge_sha256", "boot_script_sha256", "candidate_symbol_policy_sha256") if k in identity},
+        retained_cases=retained,
+        witness=dict(seed=0, seed_secondary=0, overrides=kwargs, input=query,
+                     canonical_output=canonical_query, rival_output=rival_query,
+                     differing_cells=differing),
+        conclusion="Conditional corner-query ambiguity: this one rival fits all three retained demonstrations and the retained canonical query, but disagrees on one supported degenerate corner query. No ordinary-domain counterexample found by this probe.",
+        recommendation="Keep corner_hole outside ordinary textures. If corners are exported as queries, include a corner-priority demonstration or explicitly establish the tie-break in the lesson.",
+        scope="One fixed rival, four retained labeled cases, one fixed generated degenerate query; ten protected Racket evaluations. No search, rerolls, broad tests, approval refresh, source repair or global learnability claim.",
+        passed=True,
+    )
+    out = root.parent / "checks" / tid / "corner-priority-probe.json"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"passed": True, "source_sha256": source_sha,
+                      "retained_cases": retained, "differing_cells": len(differing),
+                      "evidence": str(out), "conclusion": report["conclusion"]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
