+"""One source-bound finite scan-origin witness; no production edits or search.
+
+The five demos and original query are direct default generate() calls.  The
+alternative query is constructed, lawful, and never claimed to be sampled.
+Both exact programs must execute and fit every demo before query comparison.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+TASK = "11c53dabb028"
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator, public_challenge_bytes, public_challenge_id
+
+
+def sha(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def write_json(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+
+
+def run(out):
+    if out.exists() or out.is_symlink():
+        raise FileExistsError(f"Refusing existing output path: {out}")
+    out = out.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    (out / "private").mkdir()
+    (out / "public").mkdir()
+    catalog = Catalog(ROOT)
+    row = catalog.describe(TASK)
+    canonical = catalog._variants()[row.get("rule_task_id", TASK)][0]["program_solution"]
+    assert canonical.count("(range 0 w)") == 1
+    rival = canonical.replace("(range 0 w)", "(append (range 1 w) (list 0))")
+    ledger = ROOT / "shared/data/canonical/puzzles.jsonl"
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        gen, gen_path, gen_sha = load_selected_generator(TASK, root=ROOT)
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            # All five visible demos are fixed before any query comparison.
+            generated = [gen.generate(20261024, i, difficulty="easy") for i in range(6)]
+            assert all(not gen.self_check(g) for g in generated)
+            demos = [{"input": g, "output": apply(canonical, g)} for g in generated[:5]]
+            demo_checks = []
+            for i, pair in enumerate(demos):
+                actual = apply(rival, pair["input"])
+                fits = actual == pair["output"]
+                demo_checks.append({"index": i, "profile": gen.schedule_profile(20261024, i, "easy"), "rival_fits": fits})
+                assert fits, f"Rival refuted by demonstration {i}; no ambiguity finding"
+            # No query is evaluated until both programs have fit every demo.
+            original_query = generated[5]
+            original_canonical = apply(canonical, original_query)
+            original_rival = apply(rival, original_query)
+            stress_query = [[1, 2], [0, 0]]
+            assert not gen.self_check(stress_query)
+            canonical_answer = apply(canonical, stress_query)
+            rival_answer = apply(rival, stress_query)
+            assert canonical_answer != rival_answer
+        finally:
+            bridge.close()
+    source = {
+        "task_id": TASK,
+        "generator_path": str(gen_path.relative_to(ROOT)),
+        "generator_sha256": gen_sha,
+        "generator_rule_hash": gen.RULE_HASH,
+        "canonical_ledger_sha256": sha(ledger.read_bytes()),
+        "canonical_program_sha256": sha(canonical.encode()),
+        "rival_program_sha256": sha(rival.encode()),
+        "probe_sha256": sha(Path(__file__).read_bytes()),
+        "runtime_identity": identity,
+    }
+    for name, program in (("canonical", canonical), ("rival", rival)):
+        (out / "private" / f"{name}.rkt").write_text(program)
+    public_paths = {}
+    for name, query in (("original", original_query), ("stress", stress_query)):
+        challenge = {"train": demos, "test": [{"input": query}]}
+        public_id = public_challenge_id(challenge)
+        path = out / "public" / f"{public_id}.json"
+        data = public_challenge_bytes(challenge)
+        assert sha(data) == public_id
+        path.write_bytes(data)
+        public_paths[name] = {"path": str(path.relative_to(out)), "public_bytes_sha256": public_id}
+    write_json(out / "private/original-lesson.json", {
+        "source": source, "seed": 20261024, "difficulty": "easy", "sample_indices": list(range(6)),
+        "provenance": "Six direct default generate() calls; not a native lesson sampler run.",
+        "train": demos, "test": [{"input": original_query, "output": original_canonical, "rival_output": original_rival}],
+    })
+    write_json(out / "private/alternative-answer-candidate.json", {
+        "source": source, "query_origin": "constructed lawful 2x2 stress query; not a sampled production query",
+        "training_admitted": False,
+        "owner_acceptance": {"status": "pending", "performed": False},
+        "train": demos, "test": [{"input": stress_query, "output": canonical_answer, "rival_output": rival_answer}],
