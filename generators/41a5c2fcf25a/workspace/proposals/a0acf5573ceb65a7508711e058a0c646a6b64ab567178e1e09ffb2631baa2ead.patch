+"""Retain one production-sampled lesson ambiguous about a solid 2x2 piece.
+
+Run through the packet's review.py run wrapper. No generator or authority edits.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator, public_challenge_bytes, public_challenge_id
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+TASK = "f0f2806877da"
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def run(out):
+    if out.exists():
+        raise ValueError("Refusing to replace existing evidence")
+    generator, source, source_sha = load_selected_generator(TASK, root=ROOT)
+    catalog = Catalog(ROOT)
+    programs = {row["program_solution"] for row in catalog._variants()[TASK]}
+    if len(programs) != 1:
+        raise AssertionError("Expected one exact canonical program")
+    canonical = programs.pop()
+    old = "(if (zero? (at g 0 s)) 1 2)"
+    new = "(if (or (zero? (at g 0 s)) (and (= (at g 0 s) 2) (= (at g 0 e) 2) (= (at g 1 s) 2) (= (at g 1 e) 2))) 1 2)"
+    if canonical.count(old) != 1:
+        raise AssertionError("Canonical piece decoder changed")
+    rival = canonical.replace(old, new)
+    grids = [generator.generate(101, index) for index in range(4)]
+    if any(generator.self_check(grid) for grid in grids):
+        raise AssertionError("Production draw failed its admitted grammar")
+    executions = []
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            for index, grid in enumerate(grids):
+                actual = apply(canonical, grid)
+                alternative = apply(rival, grid)
+                if actual != generator.rule_mirror(grid):
+                    raise AssertionError("Production mirror disagrees with canonical Racket")
+                executions.append({"sample_index": index, "input": grid,
+                                   "canonical_output": actual, "rival_output": alternative,
+                                   "same_output": actual == alternative})
+        finally:
+            bridge.close()
+    if [row["same_output"] for row in executions] != [True, True, True, False]:
+        raise AssertionError("Expected three shared demonstrations and one disagreement")
+    challenge = {"train": [{"input": row["input"], "output": row["canonical_output"]}
+                           for row in executions[:3]],
+                 "test": [{"input": executions[3]["input"]}]}
+    identity_public = public_challenge_id(challenge)
+    binding = {"generator_path": source.relative_to(ROOT).as_posix(),
+               "generator_sha256": source_sha,
+               "canonical_program_sha256": sha(canonical.encode()),
+               "canonical_declared_rule_hash": generator.RULE_HASH,
+               "rival_program_sha256": sha(rival.encode()),
+               "probe_path": Path(__file__).resolve().relative_to(ROOT).as_posix(),
+               "probe_sha256": sha(Path(__file__).read_bytes())}
+    report = {"schema": "f0f2806877da-visible-texture-ambiguity-v1", "task_id": TASK,
+              "finding": "A solid 2x2 code piece is unseen in these three demos; assigning it left instead of canonical right fits every demo and changes the production-sampled query.",
+              "production_unchanged": True, "source": binding,
+              "selection": {"seed": 101, "difficulty": None, "demo_sample_indices": [0, 1, 2], "query_sample_indices": [3], "overrides": {}},
+              "racket": identity, "protected_evaluations": 8,
+              "demo_agreements": 3, "query_disagreements": 1,
+              "public_id": identity_public, "status": "findings_only_owner_review_pending",
+              "suggested_repair": "Select or replace one demonstration with a solid 2x2 piece whose rightward bend is visible, preserving the demo count.",
+              "discovery_scope": {"python_candidate_rivals": ["top_right", "bottom_left", "bottom_right", "full_square_left"], "seeds": [0, 17, 29, 101, 202, 303, 404, 505, 606, 707, 808, 909], "draws_per_seed": 4, "protected_rivals": ["full_square_left"]},
+              "limits": ["One retained three-demo/one-query production draw sequence; no prevalence or exhaustive-learning claim.", "Only the full-square-left rival was executed through protected Racket.", "No production generator, canonical authority, export controller, acceptance, or training-admission change.", "The alternative-answer lesson is retained privately; it is not admitted to a dataset."]}
+    private = {"public_id": identity_public, "source": binding,
+               "canonical_program": canonical, "rival_program": rival,
+               "canonical_query_answers": [executions[3]["canonical_output"]],
+               "alternative_query_answers": [executions[3]["rival_output"]],
+               "executions": executions, "training_admitted": False}
+    out.mkdir(parents=True)
+    (out / "public.json").write_bytes(public_challenge_bytes(challenge))
+    for name, data in (("report.json", report), ("private.json", private)):
+        (out / name).write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
+    return {key: report[key] for key in ("task_id", "status", "protected_evaluations", "demo_agreements", "query_disagreements", "public_id", "source")}
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    print(json.dumps(run(args.out.resolve()), indent=2, sort_keys=True))
