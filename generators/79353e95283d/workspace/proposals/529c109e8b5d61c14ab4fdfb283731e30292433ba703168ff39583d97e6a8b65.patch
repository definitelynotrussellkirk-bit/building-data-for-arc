diff --git a/repo/generators/75d4884529f6/workspace/peer_learnability_probe.py b/repo/generators/75d4884529f6/workspace/peer_learnability_probe.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/75d4884529f6/workspace/peer_learnability_probe.py
@@ -0,0 +1,65 @@
+"""Bounded source-bound teaching witness; execute with packet review.py run."""
+from pathlib import Path
+import hashlib
+import importlib.util
+import json
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from arcpuzzles import Catalog
+
+ROOT = Path(__file__).resolve().parents[3]
+GEN = ROOT / "generators/75d4884529f6/generator.py"
+RULE = ROOT / "shared/data/canonical/puzzles.jsonl"
+assert hashlib.sha256(GEN.read_bytes()).hexdigest() == "382e664c9d0d784b70ed72f2e5b25873e053745cc71fe2eb8bf33e491665a7e7"
+spec = importlib.util.spec_from_file_location("audited_generator_75d", GEN)
+gen = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(gen)
+metadata = Catalog(ROOT).describe("75d4884529f6")
+rule_task_id = metadata.get("rule_task_id", metadata["id"])
+with RULE.open() as handle:
+    selected = [row for line in handle if line.strip()
+                if (row := json.loads(line)).get("task_id") == rule_task_id]
+programs = {row["program_solution"] for row in selected}
+assert len(programs) == 1, "Selected canonical reference must be unambiguous"
+program = programs.pop()
+program_sha256 = hashlib.sha256(program.encode()).hexdigest()
+assert program_sha256 == "ac35f5632c11551fd859318df9d34de5f5817d83b6b54ff22155e9cbc10efa3f"
+# One fixed rival, selected before labels: color 6 draws an ordinary straight
+# connection, as the canonical program already does for colors 4, 5, and 9.
+rival = program.replace("(= color 6)", "(= color -1)")
+assert rival != program
+grids = None
+for seed in range(32):
+    candidate = [gen.generate(seed, i) for i in range(4)]
+    if all(all(row[1] != 6 for row in grid) for grid in candidate[:3]) and any(row[1] == 6 for row in candidate[3]):
+        grids = candidate
+        break
+assert grids is not None, "No witness in finite seed0..31 scope"
+assert all(not gen.self_check(grid) for grid in grids)
+with RacketBridge() as bridge:
+    assert bridge.runtime_identity["protected"] is True
+    def execute(source, grid):
+        literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+        return bridge.eval_text(f"({wrap_rule(source)} {literal})")
+    expected = [execute(program, g) for g in grids]
+    observed = [execute(rival, g) for g in grids]
+    assert expected[:3] == observed[:3]
+    assert expected[3] != observed[3]
+    differences = [[r, c, a, b] for r, (x, y) in enumerate(zip(expected[3], observed[3])) for c, (a, b) in enumerate(zip(x, y)) if a != b]
+    report = {
+        "task_id": "75d4884529f6", "status": "unresolved_learnability_witness",
+        "source_sha256": {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest() for p in (GEN, RULE, Path(__file__).resolve())},
+        "reference": "selected_canonical", "rule_task_id": rule_task_id,
+        "program_sha256": program_sha256, "selected_canonical_rows": len(selected),
+        "seed": seed, "sample_indices": [0, 1, 2, 3], "difficulty": None,
+        "program": program, "rival": rival, "rival_description": "Color6 has ordinary straight-line behavior, matching the existing generic color branch.",
+        "train": [{"input": g, "output": y} for g, y in zip(grids[:3], expected[:3])],
+        "query": {"input": grids[3], "output": expected[3], "rival_output": observed[3]},
+        "train_matches": 3, "query_different_cells": len(differences), "first_difference": differences[0],
+        "protected_racket_evaluations": 8, "racket": bridge.runtime_identity,
+        "limits": "Finite source-generation witness; no episode prevalence estimate, full battery, repair, or parametric claim."
+    }
+out = Path(__file__).with_name("peer_learnability_evidence.json")
+out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n")
+print(json.dumps({k: report[k] for k in ("status", "seed", "train_matches", "query_different_cells", "first_difference", "protected_racket_evaluations")}))
