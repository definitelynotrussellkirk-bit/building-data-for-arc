+#!/usr/bin/env python3
+"""Bounded replay of the documented query-rotation limitation; no source edits."""
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from reviewer_support import find_root, load_selected_generator
+
+TASK = "78f3cf31c4bf"
+root = find_root(__file__)
+gen, source, source_hash = load_selected_generator(TASK, root=root)
+assert source_hash == "788832612d5ab93e59f99522fd2b89e72e8d1d2ca7776779f272c13f22d08cf5"
+seed = 2546197209
+indices = [1, 2, 3, 4]
+inputs = [gen.generate(seed, i, difficulty="easy") for i in indices]
+reference = Catalog(root).apply(TASK, inputs, timeout=60)
+assert reference["rule_hash_matches_catalog"]
+assert reference["executed_rule_hash"] == gen.RULE_HASH
+assert all(row["error"] is None for row in reference["results"])
+pairs = [{"input": g, "output": row["output"]}
+         for g, row in zip(inputs, reference["results"], strict=True)]
+assert all(gen.rule_mirror(p["input"]) == p["output"] for p in pairs)
+normal = gen.lesson_identifiable(pairs[:3], pairs[3])
+rotated_demos = [pairs[i] for i in [0, 1, 3]]
+rotated_query = pairs[2]
+rotated = gen.lesson_identifiable(rotated_demos, rotated_query)
+survivors = {}
+for name, rival in gen.LESSON_COMPETITORS.items():
+    fits = all(rival(p["input"]) == p["output"] for p in rotated_demos)
+    wrong = rival(rotated_query["input"]) != rotated_query["output"]
+    if fits and wrong:
+        survivors[name] = rival(rotated_query["input"])
+assert not normal
+assert set(survivors) == {"component_bbox_completion", "ignore_colour_agreement", "repeat_until_stable"}
+report = {
+    "task_id": TASK, "generator_sha256": source_hash,
+    "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+    "rule_hash": gen.RULE_HASH, "seed": seed, "difficulty": "easy",
+    "sample_indices": indices,
+    "scope": "Four direct generator calls at the retained observation seed; mechanism replay, not a byte-identical production materialization replay.",
+    "normal_demo_indices": [1, 2, 3], "normal_query_index": 4,
+    "normal_reasons": normal,
+    "rotated_demo_indices": [1, 2, 4], "rotated_query_index": 3,
+    "rotated_reasons": rotated, "surviving_rival_outputs": survivors,
+    "pairs": pairs, "reference": reference,
+    "decision": "No new production issue. Existing optional query-rotation limitation reproduced; production source unchanged.",
+}
+out = Path(__file__).with_name("peer_rotation_evidence.json")
+out.write_text(json.dumps(report, indent=2) + "\n")
+print(json.dumps({"passed": True, "racket_pairs": len(pairs),
+                  "normal_reasons": normal, "rotated_survivors": sorted(survivors),
+                  "generator_sha256": source_hash, "evidence": str(out)}, indent=2))
