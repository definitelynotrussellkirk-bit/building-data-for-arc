+(rule! (let ((dummy 0))
+  (define (e8b-colors-reading grid)
+    (remove-duplicates
+      (filter (lambda (v) (not (= v 0)))
+        (map (lambda (p) (at grid (first p) (second p)))
+             (grid-positions grid)))))
+  (define (e8b-record grid color)
+    (let ((cells (find-color grid color)))
+      (if (= (length cells) 2)
+          (let* ((p1 (first cells)) (p2 (second cells))
+                 (r1 (first p1)) (c1 (second p1))
+                 (r2 (first p2)) (c2 (second p2)))
+            (cond
+              ((and (= r1 r2)
+                    (= (modulo (+ c1 c2) 2) 0)
+                    (= (at grid r1 (quotient (+ c1 c2) 2)) 0))
+               (list color r1 (quotient (+ c1 c2) 2) (abs (- c2 c1))))
+              ((and (= c1 c2)
+                    (= (modulo (+ r1 r2) 2) 0)
+                    (= (at grid (quotient (+ r1 r2) 2) c1) 0))
+               (list color (quotient (+ r1 r2) 2) c1 (abs (- r2 r1))))
+              (else #f)))
+          #f)))
+  (let* ((records
+           (filter (lambda (record) record)
+             (map (lambda (color) (e8b-record g color))
+                  (e8b-colors-reading g))))
+         (shortest
+           (for/fold ((best 1000)) ((record (in-list records)))
+             (min best (list-ref record 3)))))
+    (for/fold ((out g)) ((record (in-list records)))
+      (if (= (list-ref record 3) shortest)
+          (set-cell out (list-ref record 1) (list-ref record 2) (list-ref record 0))
+          out)))))
