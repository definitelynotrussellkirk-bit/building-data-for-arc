+#!/usr/bin/env python3
+"""Protected-Racket probe for a surviving equal-hole tie-break shortcut."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+TASK_ID = "da16b5bf7632"
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[2]
+RUNTIME = REPO / "shared" / "runtime"
+sys.path[:0] = [str(REPO / "src"), str(RUNTIME)]
+
+from arcpuzzles import Catalog  # noqa: E402
+from reviewer_support import load_selected_generator  # noqa: E402
+
+
+def _pack(gen: Any, records: list[dict[str, Any]]) -> list[list[int]]:
+    crops = [gen._crop_component(record) for record in records]
+    height = max(len(crop) for crop in crops)
+    width = sum(len(crop[0]) for crop in crops) + len(crops) - 1
+    output = gen.full_grid(height, width, 0)
+    left = 0
+    for crop in crops:
+        for row, values in enumerate(crop):
+            for col, value in enumerate(values):
+                if value != 0:
+                    output[row][left + col] = value
+        left += len(crop[0]) + 1
+    return output
+
+
+def column_tie_shortcut(gen: Any, grid: list[list[int]]) -> list[list[int]]:
+    """Sort by holes, but use column then row for equal-hole components."""
+    records = [
+        gen._component_record(color, cells)
+        for color, cells in gen._components(grid)
+    ]
+    records.sort(
+        key=lambda record: (
+            -record["holes"],
+            record["bbox"][1],
+            record["bbox"][0],
+        )
+    )
+    return _pack(gen, records)
+
+
+def _diff_cells(left: list[list[int]], right: list[list[int]]) -> int:
+    height = max(len(left), len(right))
+    width = max(len(left[0]), len(right[0]))
+    return sum(
+        (left[row][col] if row < len(left) and col < len(left[0]) else 0)
+        != (right[row][col] if row < len(right) and col < len(right[0]) else 0)
+        for row in range(height)
+        for col in range(width)
+    )
+
+
+def run(output: Path) -> dict[str, Any]:
+    gen, source_path, _ = load_selected_generator(TASK_ID, root=REPO)
+    grids = [gen.generate(0, index) for index in range(4)]
+    receipt = Catalog(REPO).apply(TASK_ID, grids, reference="canonical", timeout=180)
+    if not receipt.get("rule_hash_matches_catalog"):
+        raise RuntimeError("selected Racket rule does not match the catalog")
+    failures = [row for row in receipt["results"] if row.get("error") is not None]
+    if failures:
+        raise RuntimeError(f"protected-Racket failures: {failures}")
+    canonical = [row["output"] for row in receipt["results"]]
+    shortcut = [column_tie_shortcut(gen, grid) for grid in grids]
+    matches = [actual == wrong for actual, wrong in zip(canonical, shortcut, strict=True)]
+    if matches != [True, True, True, False]:
+        raise AssertionError(f"expected [true,true,true,false], got {matches}")
+
+    facts = []
+    for grid in grids:
+        records = [
+            gen._component_record(color, cells)
+            for color, cells in gen._components(grid)
+        ]
+        facts.append({
+            "holes_in_reading_order": [record["holes"] for record in records],
+            "bounding_boxes": [list(record["bbox"]) for record in records],
+            "colors": [record["color"] for record in records],
+            "input_shape": [len(grid), len(grid[0])],
+        })
+
+    variants = Catalog(REPO)._variants()[TASK_ID]
+    program = variants[0]["program_solution"]
+    report = {
+        "schema": "arcpuzzles-peer-shortcut-probe-v1",
+        "task_id": TASK_ID,
+        "status": "passed",
+        "shortcut": (
+            "Sort components by descending enclosed-hole count, but break equal-hole "
+            "ties by bounding-box column before row instead of input reading order."
+        ),
+        "lesson": {
+            "seed": 0,
+            "difficulty": None,
+            "demonstration_sample_indices": [0, 1, 2],
+            "query_sample_index": 3,
+            "protected_racket_matches": matches,
+            "query_changed_cells": _diff_cells(canonical[3], shortcut[3]),
+            "facts": facts,
+        },
+        "query_case": {
+            "input": grids[3],
+            "canonical_output": canonical[3],
+            "shortcut_output": shortcut[3],
+        },
+        "source_binding": {
+            "generator_path": str(source_path.relative_to(REPO)),
+            "generator_sha256": hashlib.sha256(source_path.read_bytes()).hexdigest(),
+            "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+            "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        },
+        "racket": {
+            "protected_evaluations": len(receipt["results"]),
+            "rule_hash_matches_catalog": receipt["rule_hash_matches_catalog"],
+        },
+        "recommended_repair": (
+            "Ensure the visible demonstrations contain an equal-hole pair whose row-major "
+            "and column-major orders disagree, or retain this rule as a lesson competitor."
+        ),
+        "production_source_modified": False,
+        "training_admitted": False,
+    }
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": report["status"],
+        "out": str(output.resolve()),
+        "protected_racket_matches": matches,
+        "query_changed_cells": report["lesson"]["query_changed_cells"],
+    }, sort_keys=True))
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    run(args.out)
+    return 0
+
