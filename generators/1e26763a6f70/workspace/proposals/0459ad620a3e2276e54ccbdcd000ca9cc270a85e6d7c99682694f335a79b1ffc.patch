+#!/usr/bin/env python3
+"""Protected-Racket probe for a surviving detour-only path shortcut."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+TASK_ID = "2006f915df8b"
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[2]
