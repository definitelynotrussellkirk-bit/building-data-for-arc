+def detour_only_shortcut(gen: Any, grid: list[list[int]]) -> list[list[int]]:
+    """Paint the shortest path only when it is longer than Manhattan distance."""
+    path, _count = gen._search(grid)
+    start, goal = gen._endpoints(grid)
+    manhattan = abs(start[0] - goal[0]) + abs(start[1] - goal[1])
+    if len(path) - 1 > manhattan:
+        return gen._paint(grid, path)
+    return [row[:] for row in grid]
