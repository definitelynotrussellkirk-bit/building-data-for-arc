+"""Task-local regression tests for the midpoint-pair sampler.
+
+The oracle below is intentionally independent of the production generator.  It
+implements the canonical prose rule directly and is also used to exercise the
+strongest canonical shortcut found during review: "only span-four pairs fire".
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+from reviewer_support import canonical_pairs, canonical_path, find_root
+
+TASK_ID = "1e26763a6f70"
+EXPECTED_RULE_HASH = "dffe1ada0168"
+ROOT = find_root(__file__)
+SOURCE = Path(
+    os.environ.get(
+        "GENERATOR_UNDER_TEST",
+        str(Path(__file__).resolve().parents[1] / "generator.py"),
+    )
+)
+SPEC = importlib.util.spec_from_file_location("reviewed_generator", SOURCE)
+GEN = importlib.util.module_from_spec(SPEC)
+assert SPEC.loader is not None
+SPEC.loader.exec_module(GEN)
+
+
+def _color_cells(grid: list[list[int]]) -> dict[int, list[tuple[int, int]]]:
+    cells: dict[int, list[tuple[int, int]]] = {}
+    for r, row in enumerate(grid):
+        for c, value in enumerate(row):
+            if value:
+                cells.setdefault(value, []).append((r, c))
+    return cells
+
+
+def midpoint_output(
+    grid: list[list[int]], *, allowed_spans: set[int] | None = None
+) -> list[list[int]]:
+    """Independent implementation of the selected Racket rule."""
+    out = deepcopy(grid)
+    for color, cells in _color_cells(grid).items():
+        if len(cells) != 2:
+            continue
+        (r1, c1), (r2, c2) = cells
+        if r1 == r2 and (c1 + c2) % 2 == 0:
+            span = abs(c2 - c1)
+            mr, mc = r1, (c1 + c2) // 2
+        elif c1 == c2 and (r1 + r2) % 2 == 0:
+            span = abs(r2 - r1)
+            mr, mc = (r1 + r2) // 2, c1
+        else:
+            continue
+        if span and grid[mr][mc] == 0 and (
+            allowed_spans is None or span in allowed_spans
+        ):
+            out[mr][mc] = color
+    return out
+
+
+def observed_pair_facts(grid: list[list[int]]) -> tuple[int, set[str], set[int]]:
+    orientations: set[str] = set()
+    spans: set[int] = set()
+    cells = _color_cells(grid)
+    for points in cells.values():
+        assert len(points) == 2
+        (r1, c1), (r2, c2) = points
+        if r1 == r2:
+            orientations.add("horizontal")
+            spans.add(abs(c2 - c1))
+        else:
+            assert c1 == c2
+            orientations.add("vertical")
+            spans.add(abs(r2 - r1))
+    return len(cells), orientations, spans
+
+
+def profile(grid: list[list[int]]) -> tuple[int, int, int]:
+    return len(grid), len(grid[0]), len({value for row in grid for value in row})
+
+
+def test_rule_pin_and_canonical_inputs_match_independent_oracle():
+    assert GEN.RULE_HASH == EXPECTED_RULE_HASH
+    assert canonical_path(ROOT).is_file()
+    pairs = canonical_pairs(TASK_ID, root=ROOT, labeled_only=True)
+    assert pairs
+    for pair in pairs:
+        assert GEN.self_check(pair["input"]) == []
+        assert midpoint_output(pair["input"]) == pair["output"]
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+@pytest.mark.parametrize(
+    "options",
+    [
+        {"grid_h": 5, "grid_w": 6, "pairs": 1},
+        {"grid_h": 5, "grid_w": 6, "pairs": 5},
+        {"grid_h": 12, "grid_w": 14, "pairs": 1},
+        {"grid_h": 12, "grid_w": 14, "pairs": 5},
+    ],
+)
+def test_exact_overrides_are_realized_without_dropped_pairs(band, options):
+    grid = GEN.generate(37, 11, difficulty=band, **options)
+    assert GEN.self_check(grid) == []
+    count, _orientations, spans = observed_pair_facts(grid)
+    assert (len(grid), len(grid[0]), count) == (
+        options["grid_h"],
+        options["grid_w"],
+        options["pairs"],
+    )
+    assert all(span > 0 and span % 2 == 0 for span in spans)
+    assert GEN.observe_overrides(grid) == options
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"__typo_axis": 1},
+        {"pairs": True},
+        {"pairs": 1.0},
+        {"pairs": "1"},
+        {"pairs": 0},
+        {"pairs": 6},
+        {"grid_h": True},
+        {"grid_h": 4},
+        {"grid_w": 15},
+    ],
+)
+def test_invalid_overrides_are_rejected(kwargs):
+    with pytest.raises((TypeError, ValueError, KeyError)):
+        GEN.generate(0, 0, **kwargs)
+
+
+@pytest.mark.parametrize("sample_index", [True, False, 1.0, "1", -1])
+def test_invalid_sample_index_is_rejected(sample_index):
+    with pytest.raises((TypeError, ValueError)):
+        GEN.generate(0, sample_index)
+
+
+@pytest.mark.parametrize(
+    "grid",
+    [
+        [],
+        [[]],
+        [[0], [0, 1]],
+        [[0, 0], [0, True]],
+        [[0] * 7 for _ in range(5)],
+        [[0, 0, 0, 0, 0], [0, 2, 0, 0, 2]],  # odd span
+        [[2, 0, 0], [0, 0, 0], [0, 0, 2]],  # diagonal pair
+        [[0, 2, 3, 0, 2], [0, 0, 0, 3, 0]],  # occupied midpoint
+        [[2, 0, 2], [0, 2, 0]],  # three occurrences
+    ],
+)
+def test_self_check_rejects_malformed_or_semantically_invalid_inputs(grid):
+    assert GEN.self_check(grid)
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_default_distribution_is_deterministic_lawful_and_teaches_non_four_span(band):
+    seen_orientations: set[str] = set()
+    seen_spans: set[int] = set()
+    seen_pair_counts: set[int] = set()
+    for index in range(96):
+        grid = GEN.generate(1000 + index, index, difficulty=band)
+        assert grid == GEN.generate(1000 + index, index, difficulty=band)
+        assert GEN.self_check(grid) == []
+        pair_count, orientations, spans = observed_pair_facts(grid)
+        seen_pair_counts.add(pair_count)
+        seen_orientations.update(orientations)
+        seen_spans.update(spans)
+        # The canonical demonstrations all use span four.  Every generated
+        # input must expose at least one legal counterexample to that shortcut.
+        assert any(span != 4 for span in spans)
+        assert midpoint_output(grid, allowed_spans={4}) != midpoint_output(grid)
+    assert seen_orientations == {"horizontal", "vertical"}
+    assert {2, 4} <= seen_spans
+    assert max(seen_pair_counts) >= 2
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_each_band_has_exact_canonical_profile_support_in_twenty_draws(band):
+    canonical_profiles = {
+        profile(pair["input"])
+        for pair in canonical_pairs(TASK_ID, root=ROOT, labeled_only=True)
+    }
+    generated_profiles = [
+        profile(GEN.generate(7000 + index, index, difficulty=band))
+        for index in range(20)
+    ]
+    assert sum(item in canonical_profiles for item in generated_profiles) >= 6
+
+
+def test_span_four_only_rival_fits_canonical_but_is_refuted_by_sampler():
+    pairs = canonical_pairs(TASK_ID, root=ROOT, labeled_only=True)
+    assert all(
+        midpoint_output(pair["input"], allowed_spans={4}) == pair["output"]
+        for pair in pairs
+    )
+    for index in range(32):
+        grid = GEN.generate(9000 + index, index, difficulty="hard")
+        before = deepcopy(grid)
+        witness = GEN.SEMANTIC_WITNESSES["non_four_span"](grid)
+        rival = GEN.SEMANTIC_RIVALS["span_four_only"](grid)
+        assert grid == before
+        assert witness
+        assert rival == midpoint_output(grid, allowed_spans={4})
+        assert rival != midpoint_output(grid)
+    assert GEN.WITNESS_RIVALS["non_four_span"] == ["span_four_only"]
+    assert GEN.CANONICAL_SHORTCUTS["span_four_only"] is GEN.SEMANTIC_RIVALS["span_four_only"]
+    assert GEN.LESSON_COMPETITORS["span_four_only"] is GEN.SEMANTIC_RIVALS["span_four_only"]
+
