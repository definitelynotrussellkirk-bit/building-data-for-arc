(rule! (lambda (g)
  (let* ((h (rows g)) (w (cols g)))
    (build-grid 3 3 (or oc)
      (let ((rs (if (= or 0) (list 0)
                    (if (= or 2) (list (- h 1)) (range 1 (- h 1)))))
            (cs (if (= oc 0) (list 0)
                    (if (= oc 2) (list (- w 1)) (range 1 (- w 1))))))
        (reduce (lambda (acc c)
                  (reduce (lambda (a r)
                            (let ((v (at g r c))) (if (and (= a 0) (!= v 0)) v a)))
                          acc rs))
                0 cs))))))