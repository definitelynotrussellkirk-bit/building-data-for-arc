+"""One source-bound peer audit: directional teaching rival and retained controls."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _real_evaluator
+from reviewer_support import find_root, load_selected_generator, normalize_grid
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    root = find_root(__file__)
+    task = "e2266501046d"
+    module, path, digest = load_selected_generator(task, root=root)
+    assert digest == "4a7b205c3f1323b976dce44ced0e7209c0d6ccfbc6a04b00e6e0a3b411b8fcff"
+    authority = root / "shared/data/base/solutions/banks/64addfdad75c/E152__e2266501046d.json"
+    program = json.loads(authority.read_text())["racket_target"]["target_code"]
+    # Plausible directional margin shortcut: top/bottom contact is permitted,
+    # but touching a lateral edge prevents filling the rectangle.
+    assert program.count("(paint-cells") == 1
+    rival = program.replace("(paint-cells", "(if (or (= (second bb) 0) (= (fourth bb) (- (cols g) 1))) g (paint-cells", 1)
+    rival = rival[:-1] + ")" + rival[-1:]
+    apply, identity, bridge = _real_evaluator(root / "shared/runtime")
+    pairs = []
+    try:
+        for index in range(7):
+            grid = module.generate(17, index)
+            output = normalize_grid(apply(program, grid))
+            wrong = normalize_grid(apply(rival, grid))
+            assert output == module.rule_mirror(grid)
+            pairs.append(dict(sample_index=index, input=grid, output=output,
+                rival_output=wrong, observed=module.observe_overrides(grid)))
+    finally:
+        bridge.close()
+    demos = [{k: pair[k] for k in ("input", "output")} for pair in pairs[:3]]
+    assert all(pair["output"] == pair["rival_output"] for pair in pairs[:3])
+    disagreements = [pair["sample_index"] for pair in pairs[3:]
+                     if pair["output"] != pair["rival_output"]]
+    assert disagreements == [4, 5]
+    verifier = [module.lesson_identifiable(demos, {"input": pair["input"]}) for pair in pairs[3:]]
+    assert verifier == [[], [], [], []]
+    named_rivals = {name: all(fn(d["input"]) == d["output"] for d in demos)
+                    for name, fn in module.LESSON_COMPETITORS.items()}
+    assert not any(named_rivals.values())
+    controls = []
+    for bad in (True, False, 1.0, 1.75, "1", None):
+        try:
+            grid = module.generate(bad, 0)
+            result = dict(accepted=True, valid_grid=not module.self_check(grid))
+        except Exception as exc:
+            result = dict(accepted=False, error=type(exc).__name__)
+        controls.append(dict(control="seed", value=bad, value_type=type(bad).__name__, **result))
+    for bad in (True, 1.75, "1", -1):
+        controls.append(dict(control="schedule_profile.sample_index", value=bad,
+            value_type=type(bad).__name__, observed=module.schedule_profile(17, bad)))
+    assert all(row.get("accepted", True) for row in controls)
+    receipt = dict(schema="arcpuzzles-bounded-peer-audit-v1", task_id=task,
+        outcome="teaching_shortcut_and_existing_control_defect_reproduced",
+        source_binding=dict(generator_path=path.relative_to(root).as_posix(), generator_sha256=digest,
+            authority_path=authority.relative_to(root).as_posix(),
+            authority_sha256=hashlib.sha256(authority.read_bytes()).hexdigest(),
+            program_sha256=hashlib.sha256(program.encode()).hexdigest(),
+            probe_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest()),
+        racket=identity, seed=17, demos=3, queries=4, canonical_program=program,
+        rival=dict(name="require_horizontal_zero_margins", program=rival,
+            interpretation="Fill interior and top/bottom-contact rectangles; preserve outlines touching left/right canvas edges.",
+            survives_all_visible_demos=True, disagreeing_query_sample_indices=disagreements),
+        named_rival_survivors=named_rivals, lesson_identifiable_results=verifier,
+        pairs=pairs, controls=controls,
+        limits=["One seed and one additional finite directional rival, plus the three declared rivals.",
+            "Constructed task-local 3-demo/4-query assembly, not a production exporter replay.",
+            "Default single query at sample_index 3 agrees; disagreements occur at later queries 4 and 5.",
+            "No production source, canonical program or approval changed; no global uniqueness claim."])
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(receipt, indent=2) + "\n")
+    print(json.dumps(dict(status=receipt["outcome"], protected_racket=identity["protected"],
+        programs=2, labeled_inputs=7, disagreeing_queries=disagreements, evidence=str(args.out))))
+
+
+if __name__ == "__main__":
+    main()
