(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g))
                (gray-cells (find-color g 5))
                (sr1 (min-of fst gray-cells))
                (sc1 (min-of snd gray-cells))
                (sr2 (max-of fst gray-cells))
                (sc2 (max-of snd gray-cells))
                (sh (+ 1 (- sr2 sr1)))
                (sw (+ 1 (- sc2 sc1)))
                (sep-row (find-first (lambda (r)
                                       (and
                                         (or (< r sr1) (> r sr2))
                                         (let* ((vals (filter (lambda (v) (!= v 0))
                                                              (map (lambda (c)
                                                                     (at g r c))
                                                                   (range 0 w)))))
                                           (and
                                             (> (length vals) 1)
                                             (= 1 (length (unique vals)))))))
                                     (range 0 h)))
                (sep-color (find-first (lambda (v) (!= v 0))
                                       (map (lambda (c) (at g sep-row c)) (range 0 w))))
                (key-row (if (and
                               (> sep-row 0)
                               (for/or ((c (range 0 w)))
                                       (and
                                         (!= (at g (- sep-row 1) c) 0)
                                         (!= (at g (- sep-row 1) c) sep-color))))
                             (- sep-row 1)
                             (+ sep-row 1)))
                (key-cells (filter (lambda (c) (!= (at g key-row c) 0)) (range 0 w)))
                (kc1 (min-list key-cells)))
           (build-grid sh
                       sw
                       (r c)
                       (if (= (at g (+ sr1 r) (+ sc1 c)) 5)
                           (at g key-row (+ kc1 c))
                           sep-color)))))