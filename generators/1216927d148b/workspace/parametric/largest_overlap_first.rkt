(rule! (let ((dummy 0))
  (define (gallery-paste grid pat top left)
    (for*/fold ((out grid))
               ((r (in-range (rows pat)))
                (c (in-range (cols pat))))
      (let ((v (at pat r c))
            (rr (+ top r))
            (cc (+ left c)))
        (if (and (not (= v 0))
                 (in-bounds? rr cc (rows out) (cols out)))
            (set-cell out rr cc v)
            out))))
  (define (gallery-hstack-center grids (gap 1))
    (if (empty? grids)
        (list (list))
        (let* ((h (apply max (map rows grids)))
               (w (+ (apply + (map cols grids))
                     (* gap (- (length grids) 1)))))
          (let loop ((xs grids) (left 0) (out (empty-grid h w 0)))
            (if (empty? xs)
                out
                (let* ((piece (first xs))
                       (top (quotient (- h (rows piece)) 2)))
                  (loop (rest xs)
                        (+ left (cols piece) gap)
                        (gallery-paste out piece top left))))))))
  (define (gallery-intersection a b)
    (grid-from-fn (rows a) (cols a)
      (lambda (r c)
        (if (and (not (= (at a r c) 0))
                 (not (= (at b r c) 0)))
            8
            0))))
  (define (occupied-count grid)
    (length
      (filter (lambda (v) (not (= v 0)))
              (apply append grid))))
  (define (ranked-before? a b)
    (let ((ac (third a))
          (bc (third b)))
      (if (= ac bc)
          (< (first a) (first b))
          (> ac bc))))
  (let* ((panels
           (for/list ((i (in-range 3)))
             (subgrid g 0 (* i 6) (- (rows g) 1) (+ (* i 6) 4))))
         (ab (gallery-intersection (first panels) (second panels)))
         (ac (gallery-intersection (first panels) (third panels)))
         (bc (gallery-intersection (second panels) (third panels)))
         (items
           (list (list 0 ab (occupied-count ab))
                 (list 1 ac (occupied-count ac))
                 (list 2 bc (occupied-count bc))))
         (ordered (sort items ranked-before?)))
    (gallery-hstack-center (map second ordered) 1))))
