+def _render_offsets(grid, offsets, *, clip=False):
+    """Render an anchored-offset answer on the canonical empty output canvas."""
+    target = _positions(grid, 8)
+    if len(target) != 1:
+        raise ValueError("expected exactly one cyan target anchor")
+    h = len(grid)
+    w = len(grid[0]) if h else 0
+    tr, tc = target[0]
+    output = full_grid(h, w, 0)
+    for dr, dc in offsets:
+        row, col = tr + dr, tc + dc
+        if not (0 <= row < h and 0 <= col < w):
+            if clip:
+                continue
+            raise ValueError("anchored stamp leaves the grid")
+        output[row][col] = 3
+    return output
+
+
+def rule_mirror(grid):
+    """Independent Python mirror of the selected anchored-XOR Racket rule."""
+    errors = self_check(grid)
+    if errors:
+        raise ValueError("invalid XOR-stamp input: " + "; ".join(errors))
+    red = _anchored_offsets(grid, 2)
+    blue = _anchored_offsets(grid, 1)
+    assert red is not None and blue is not None
+    return _render_offsets(grid, red ^ blue)
+
+
+def _rival_union(grid):
+    """Plausible wrong rule: stamp the union instead of symmetric difference."""
+    errors = self_check(grid)
+    if errors:
+        raise ValueError("invalid union-rival input: " + "; ".join(errors))
+    red = _anchored_offsets(grid, 2)
+    blue = _anchored_offsets(grid, 1)
+    assert red is not None and blue is not None
+    return _render_offsets(grid, red | blue, clip=True)
+
+
+SEMANTIC_RIVALS = {"union": _rival_union}
+LESSON_COMPETITORS = dict(SEMANTIC_RIVALS)
+CANONICAL_SHORTCUTS = dict(SEMANTIC_RIVALS)
+
+
+def lesson_identifiable(demos, query):
+    """Return concrete reasons when a declared competitor survives the lesson."""
+    if not isinstance(demos, (list, tuple)) or len(demos) < EXAMPLES_NEEDED:
+        return [f"need at least {EXAMPLES_NEEDED} demonstrations"]
+
+    reasons = []
+    refuted = {name: False for name in LESSON_COMPETITORS}
+    valid_demos = []
+    for index, pair in enumerate(demos):
+        if not isinstance(pair, dict) or not {"input", "output"} <= set(pair):
+            reasons.append(f"demo {index} must contain input and output")
+            continue
+        errors = self_check(pair["input"])
+        if errors:
+            reasons.append(f"demo {index} input invalid: {errors[0]}")
+            continue
+        truth = rule_mirror(pair["input"])
+        if pair["output"] != truth:
+            reasons.append(f"demo {index} output disagrees with the selected rule")
+            continue
+        valid_demos.append(pair)
+        for name, competitor in LESSON_COMPETITORS.items():
+            if competitor(pair["input"]) != truth:
+                refuted[name] = True
+
+    for name, was_refuted in refuted.items():
+        if not was_refuted:
+            reasons.append(f"demonstrations do not refute competitor {name!r}")
+
+    if not isinstance(query, dict) or "input" not in query:
+        reasons.append("query must contain an input grid")
+        return reasons
+    query_errors = self_check(query["input"])
+    if query_errors:
+        reasons.append(f"query input invalid: {query_errors[0]}")
+        return reasons
+    truth = rule_mirror(query["input"])
+    if query.get("output") is not None and query["output"] != truth:
+        reasons.append("query output disagrees with the selected rule")
+    for name, competitor in LESSON_COMPETITORS.items():
+        if (valid_demos
+                and all(competitor(pair["input"]) == pair["output"]
+                        for pair in valid_demos)
+                and competitor(query["input"]) != truth):
+            reasons.append(
+                f"competitor {name!r} fits every valid demo but changes the query answer"
+            )
+    return reasons
