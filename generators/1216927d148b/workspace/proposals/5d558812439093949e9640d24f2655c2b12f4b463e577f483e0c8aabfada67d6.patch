+#!/usr/bin/env python3
+"""Build/replay a bounded Racket-backed check for the repaired union teaching hole."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "109a03554ed3"
+BANDS = ("easy", "medium", "hard")
+SEEDS = (0, 17)
+START = 1
+
+
+def _raw(value) -> bytes:
+    return (json.dumps(value, sort_keys=True, ensure_ascii=False, indent=2) + "\n").encode()
+
+
+def _write(path: Path, value) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(_raw(value))
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def prepare(out: Path) -> None:
+    if out.exists():
+        raise FileExistsError(f"choose a fresh output directory: {out}")
+    root = find_root(__file__)
+    gen, source, source_sha = load_selected_generator(TASK_ID, root=root)
+    records = []
+    inputs = []
+    for band in BANDS:
+        for seed in SEEDS:
+            lesson = []
+            for index in range(START, START + gen.EXAMPLES_NEEDED + 1):
+                grid = gen.generate(seed, index, difficulty=band)
+                red = gen._anchored_offsets(grid, 2)
+                blue = gen._anchored_offsets(grid, 1)
+                if red is None or blue is None:
+                    raise AssertionError("generated source offsets are not recoverable")
+                lesson.append({
+                    "seed": seed,
+                    "difficulty": band,
+                    "sample_index": index,
+                    "role": "demo" if index < START + gen.EXAMPLES_NEEDED else "query",
+                    "input": grid,
+                    "self_check": gen.self_check(grid, difficulty=band),
+                    "overlap_count": len(red & blue),
+                    "rule_mirror": gen.rule_mirror(grid),
+                    "union_rival": gen.LESSON_COMPETITORS["union"](grid),
+                })
+                inputs.append(grid)
+            records.append({"difficulty": band, "seed": seed, "start": START, "pairs": lesson})
+    out.mkdir(parents=True)
+    _write(out / "source.json", {
+        "schema": "arc-union-lesson-repair-source-v1",
+        "task_id": TASK_ID,
+        "generator_path": source.relative_to(root).as_posix(),
+        "generator_sha256": source_sha,
+        "generator_version": gen.VERSION,
+        "examples_needed": gen.EXAMPLES_NEEDED,
+        "lesson_count": len(records),
+        "pair_count": len(inputs),
+        "scope": {"bands": list(BANDS), "seeds": list(SEEDS), "start": START},
+        "lessons": records,
+    })
+    _write(out / "inputs.json", inputs)
+    print(json.dumps({
+        "status": "prepared",
+        "lessons": len(records),
+        "inputs": len(inputs),
+        "generator_sha256": source_sha,
+    }))
+
+
+def compare(out: Path) -> None:
+    root = find_root(__file__)
+    gen, source, source_sha = load_selected_generator(TASK_ID, root=root)
+    source_record = json.loads((out / "source.json").read_bytes())
+    racket = json.loads((out / "racket.json").read_bytes())
+    if source_record["generator_sha256"] != source_sha:
+        raise AssertionError("generator changed after preparation")
+    if racket.get("generator_sha256") != source_sha:
+        raise AssertionError("Racket application used different generator bytes")
+    results = racket.get("results")
+    if not isinstance(results, list) or len(results) != source_record["pair_count"]:
+        raise AssertionError("Racket receipt has the wrong result count")
+
+    cursor = 0
+    failures = []
+    summarized = []
+    for lesson in source_record["lessons"]:
+        pairs = lesson["pairs"]
+        demos = []
+        actual_pairs = []
+        for pair in pairs:
+            result = results[cursor]
+            cursor += 1
+            actual = result.get("output")
+            if result.get("error") is not None or not result.get("valid_output"):
+                failures.append(f"invalid Racket label at {lesson['difficulty']}/{lesson['seed']}/{pair['sample_index']}")
+            if result.get("input") != pair["input"]:
+                failures.append("Racket receipt input mismatch")
+            if actual != pair["rule_mirror"]:
+                failures.append(f"Python XOR mirror differs from Racket at sample {pair['sample_index']}")
+            actual_pair = {"input": pair["input"], "output": actual}
+            actual_pairs.append(actual_pair)
+            if pair["role"] == "demo":
+                demos.append(actual_pair)
+        query = actual_pairs[-1]
+        overlap_demos = [pair["sample_index"] for pair in pairs[:-1] if pair["overlap_count"] > 0]
+        union_refuters = [pair["sample_index"] for pair, actual_pair in zip(pairs[:-1], actual_pairs[:-1], strict=True)
+                          if pair["union_rival"] != actual_pair["output"]]
+        reasons = gen.lesson_identifiable(demos, query)
+        if not overlap_demos:
+            failures.append(f"no overlap witness in {lesson['difficulty']}/{lesson['seed']}")
+        if not union_refuters:
+            failures.append(f"union rival survives {lesson['difficulty']}/{lesson['seed']}")
+        if reasons:
+            failures.append(f"lesson gate failed {lesson['difficulty']}/{lesson['seed']}: {reasons}")
+        summarized.append({
+            "difficulty": lesson["difficulty"],
+            "seed": lesson["seed"],
+            "demo_indices": [pair["sample_index"] for pair in pairs[:-1]],
+            "query_index": pairs[-1]["sample_index"],
+            "overlap_demo_indices": overlap_demos,
+            "union_refuting_demo_indices": union_refuters,
+            "lesson_identifiable_reasons": reasons,
+        })
+
+    report = {
+        "schema": "arc-union-lesson-repair-check-v1",
+        "task_id": TASK_ID,
+        "status": "passed" if not failures else "failed",
+        "source_binding": {
+            "path": source.relative_to(root).as_posix(),
+            "sha256": source_sha,
+            "version": gen.VERSION,
+        },
+        "scope": source_record["scope"],
+        "lesson_count": len(summarized),
+        "pair_count": source_record["pair_count"],
+        "racket_evaluations": len(results),
+        "checks": {
+            "all_inputs_self_check": all(pair["self_check"] == [] for lesson in source_record["lessons"] for pair in lesson["pairs"]),
+            "all_racket_labels_match_xor_mirror": not any("mirror differs" in failure for failure in failures),
+            "every_lesson_has_overlap_demo": all(row["overlap_demo_indices"] for row in summarized),
+            "every_lesson_refutes_union": all(row["union_refuting_demo_indices"] for row in summarized),
+            "every_lesson_gate_passes": all(not row["lesson_identifiable_reasons"] for row in summarized),
+        },
+        "lessons": summarized,
+        "failures": failures,
+        "racket_receipt_sha256": _sha(out / "racket.json"),
+        "limits": "Six fixed lessons only; no universal rival or all-seed claim.",
+    }
+    _write(out / "report.json", report)
+    print(json.dumps({"status": report["status"], "lessons": len(summarized), "racket_evaluations": len(results), "failures": failures}))
+    if failures or not all(report["checks"].values()):
+        raise AssertionError("bounded union lesson repair check failed")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("action", choices=("prepare", "compare"))
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.action == "prepare":
+        prepare(args.out)
+    else:
+        compare(args.out)
+
+
+if __name__ == "__main__":
+    main()
