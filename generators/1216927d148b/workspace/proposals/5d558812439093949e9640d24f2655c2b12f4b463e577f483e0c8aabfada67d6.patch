+"""Regression coverage for the union-versus-XOR teaching defect."""
+from __future__ import annotations
+
+from reviewer_support import find_root, load_selected_generator
+
+ROOT = find_root(__file__)
+GEN, _SOURCE, _SOURCE_SHA = load_selected_generator("109a03554ed3", root=ROOT)
+
+
+def _overlap_count(grid) -> int:
+    red = GEN._anchored_offsets(grid, 2)
+    blue = GEN._anchored_offsets(grid, 1)
+    assert red is not None and blue is not None
+    return len(red & blue)
+
+
+def _pair(seed: int, index: int, band: str) -> dict:
+    grid = GEN.generate(seed, index, difficulty=band)
+    return {"input": grid, "output": GEN.rule_mirror(grid)}
+
+
+def test_historical_four_demo_window_refutes_union_rival():
+    demos = [_pair(0, index, "medium") for index in range(1, 5)]
+    query = _pair(0, 5, "medium")
+
+    assert any(_overlap_count(pair["input"]) > 0 for pair in demos)
+    assert "union" in GEN.LESSON_COMPETITORS
+    assert GEN.lesson_identifiable(demos, query) == []
+
+
+def test_every_four_consecutive_indices_include_overlap_witness():
+    for band in ("easy", "medium", "hard"):
+        for seed in range(4):
+            for start in range(8):
+                grids = [GEN.generate(seed, index, difficulty=band)
+                         for index in range(start, start + GEN.EXAMPLES_NEEDED)]
+                assert any(_overlap_count(grid) > 0 for grid in grids), (
+                    band, seed, start
+                )
+
+
+def test_rule_and_union_rival_are_executable_and_distinct_on_overlap():
+    grid = GEN.generate(0, 4, difficulty="medium")
+    assert _overlap_count(grid) > 0
+    truth = GEN.rule_mirror(grid)
+    union = GEN.LESSON_COMPETITORS["union"](grid)
+    assert truth != union
+    assert GEN.self_check(grid, difficulty="medium") == []
