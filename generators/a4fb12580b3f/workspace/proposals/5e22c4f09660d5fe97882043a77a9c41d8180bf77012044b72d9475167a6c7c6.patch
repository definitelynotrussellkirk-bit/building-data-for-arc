+"""One bounded midpoint-tie teaching probe; no universal learnability claim."""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    home = Path(__file__).resolve().parent.parent
+    repo = home.parent.parent
+    authority = repo / 'shared/data/canonical/puzzles.jsonl'
+    row = next(json.loads(line) for line in authority.read_text().splitlines()
+               if json.loads(line).get('task_id') == home.name)
+    correct = row['program_solution']
+    # At an integer midpoint, shift its boundary up one row. Half-integer
+    # midpoints retain the original boundary. Thus equidistant rows belong to
+    # the lower marker; all other drawing behavior is unchanged.
+    needle = '(let* ((h (rows g))'
+    assert correct.count(needle) == 1
+    rival = correct.replace(needle,
+        '(let* ((floor (lambda (x) (floor (- x 1/2)))) (h (rows g))', 1)
+    spec = importlib.util.spec_from_file_location('reviewed_f5e7', home / 'generator.py')
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    paths = {'generator.py': home / 'generator.py', 'reviewer_probe.py': Path(__file__),
+             'canonical/puzzles.jsonl': authority}
+    before = {name: sha(path) for name, path in paths.items()}
+    generated = [generator.generate(0, index) for index in range(4)]
+    assert all(not generator.self_check(grid) for grid in generated)
+    episodes = [
+        {'name': 'canonical', 'train': [p['input'] for p in row['train']],
+         'test': [p['input'] for p in row['test']]},
+        {'name': 'default-seed-0', 'seed': 0, 'train_sample_indices': [0, 1],
+         'test_sample_indices': [2, 3], 'train': generated[:2], 'test': generated[2:]},
+    ]
+    bridge = RacketBridge()
+    identity = bridge.runtime_identity
+    assert identity['backend'] == 'racket' and identity['protected'] is True
+    executions = 0
+    try:
+        for episode in episodes:
+            for split in ('train', 'test'):
+                pairs = []
+                for grid in episode[split]:
+                    literal = "'(" + ' '.join('(' + ' '.join(map(str, r)) + ')' for r in grid) + ')'
+                    outputs = {}
+                    for label, program in [('correct', correct), ('rival', rival)]:
+                        value = bridge.eval_text(f'({wrap_rule(program)} {literal})')
+                        executions += 1
+                        assert isinstance(value, list) and len(value) == len(grid)
+                        assert all(isinstance(r, list) and len(r) == len(grid[0]) and
+                                   all(type(v) is int and 0 <= v <= 9 for v in r) for r in value)
+                        outputs[label] = value
+                    pairs.append({'input': grid, **outputs,
+                                  'matches': outputs['correct'] == outputs['rival']})
+                episode[split] = pairs
+            episode['survives_demos'] = all(p['matches'] for p in episode['train'])
+            episode['query_disagreements'] = [i for i, p in enumerate(episode['test']) if not p['matches']]
+            episode['harmful_survivor'] = episode['survives_demos'] and bool(episode['query_disagreements'])
+        assert [p['correct'] for p in episodes[0]['train']] == [p['output'] for p in row['train']]
+        assert [p['correct'] for p in episodes[0]['test']] == [p['output'] for p in row['test']]
+    finally:
+        bridge.close()
+    assert before == {name: sha(path) for name, path in paths.items()}
+    findings = [e['name'] for e in episodes if e['harmful_survivor']]
+    result = {'schema': 'f5e7cf8dc78d-bounded-peer-probe-v1',
+              'status': 'finding' if findings else 'no-finding-in-finite-scope',
+              'source_sha256': before, 'selected_rule_sha256': hashlib.sha256(correct.encode()).hexdigest(),
+              'rule_hash_pin': generator.RULE_HASH, 'review_index_present': (home / 'evidence/review_index.json').exists(),
+              'racket': identity, 'executions': executions,
+              'programs': {'correct': correct, 'rival_tie_to_lower': rival}, 'episodes': episodes,
+              'findings': findings,
+              'limits': 'One natural rival, canonical episode and seed-0 default 2-demo/2-query episode only; no exhaustive search, acceptance or training admission.'}
+    args.out.mkdir(parents=True, exist_ok=False)
+    (args.out / 'probe.json').write_text(json.dumps(result, indent=2) + '\n')
+    print(json.dumps({k: result[k] for k in ('status', 'source_sha256', 'executions', 'findings')}))
+    return int(bool(findings))
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
