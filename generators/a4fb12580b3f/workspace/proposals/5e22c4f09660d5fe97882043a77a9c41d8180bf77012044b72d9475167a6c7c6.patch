@@ -0,0 +1,108 @@
+"""Bounded replay of the retained first-pair-per-row support-gap witness."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+sys.path[:0] = [str(ROOT / 'src'), str(ROOT / 'shared/runtime')]
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def norm(grid):
+    return [[int(c) for c in row] for row in grid]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--out', required=True)
+    args = parser.parse_args()
+    out = Path(args.out).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    source = ROOT / 'generators/a0abd95c485b/generator.py'
+    evidence = source.parent / 'counterexamples/review-ab2afe82bde153e5-v0001/retained/checks/audit/a0abd95c485b/probe.json'
+    canonical = ROOT / 'shared/data/canonical/puzzles.jsonl'
+    rows = [json.loads(line) for line in canonical.read_text().splitlines() if line.strip()]
+    selected = [r for r in rows if r['task_id'] == 'a0abd95c485b']
+    assert len(selected) == 1
+    row = selected[0]
+    correct = row['program_solution']
+    trigger = '(and (= (at g r c) 4) (= (at g r (+ c 1)) 4))'
+    replacement = '''(and (= (at g r c) 4) (= (at g r (+ c 1)) 4)
+        (not (for/or ([k (in-range c)])
+               (and (= (at g r k) 4) (= (at g r (+ k 1)) 4)))))'''
+    assert correct.count(trigger) == 1
+    rival = correct.replace(trigger, replacement)
+    programs = {'correct': correct, 'first_pair_per_row': rival}
+    wrapped = {k: wrap_rule(p) for k, p in programs.items()}
+    for name, program in programs.items():
+        (out / f'{name}.rkt').write_text(program + '\n')
+        (out / f'{name}.wrapped.rkt').write_text(wrapped[name] + '\n')
+    spec = importlib.util.spec_from_file_location('bounded_a0abd95c485b', source)
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    old = json.loads(evidence.read_text())
+    assert sha(source) == old['generator_sha256']
+    cases = []
+    for i, pair in enumerate(row['train']):
+        cases.append({'kind': 'canonical_demo', 'index': i, 'input': norm(pair['input']), 'recorded_output': norm(pair['output'])})
+    pair = row['test']
+    cases.append({'kind': 'canonical_query', 'index': 0, 'input': norm(pair['input']), 'recorded_output': norm(pair['output'])})
+    for i in range(3):
+        cases.append({'kind': 'default_generated_demo', 'seed': 17, 'sample_index': i, 'input': generator.generate(17, i)})
+    cases.append({'kind': 'retained_validator_accepted_query', 'input': old['input']})
+    bridge = RacketBridge()
+    try:
+        identity = bridge.runtime_identity
+        assert identity.get('backend') == 'racket' and identity.get('protected') is True
+        for case in cases:
+            grid = case['input']
+            literal = "'(" + ' '.join('(' + ' '.join(map(str, r)) + ')' for r in grid) + ')'
+            case['outputs'] = {name: bridge.eval_text(f'({program} {literal})') for name, program in wrapped.items()}
+            case['self_check'] = generator.self_check(grid)
+            case['rival_agrees'] = case['outputs']['correct'] == case['outputs']['first_pair_per_row']
+            if 'recorded_output' in case:
+                assert case['outputs']['correct'] == case['recorded_output']
+        support = cases[:-1]
+        witness = cases[-1]
+        assert all(c['rival_agrees'] for c in support)
+        assert not witness['self_check'] and not witness['rival_agrees']
+        assert witness['outputs']['first_pair_per_row'] == old['rival_output']
+    finally:
+        bridge.close()
+    report = {
+        'schema': 'bounded-peer-learnability-review-v1',
+        'task_id': 'a0abd95c485b',
+        'result': 'existing_support_gap_independently_reproduced',
+        'source_binding': {
+            'generator_path': str(source.relative_to(ROOT)), 'generator_sha256': sha(source),
+            'canonical_path': str(canonical.relative_to(ROOT)), 'canonical_file_sha256': sha(canonical),
+            'canonical_row_sha256': hashlib.sha256(json.dumps(row, sort_keys=True, separators=(',', ':')).encode()).hexdigest(),
+            'canonical_rule_sha256': hashlib.sha256(correct.encode()).hexdigest(),
+            'retained_probe_path': str(evidence.relative_to(ROOT)), 'retained_probe_sha256': sha(evidence),
+            'reproducer_sha256': sha(Path(__file__)),
+        },
+        'runtime_identity': identity,
+        'programs': {name: {'source': f'{name}.rkt', 'file_sha256': sha(out / f'{name}.rkt'),
+                             'wrapped_source': f'{name}.wrapped.rkt', 'wrapped_file_sha256': sha(out / f'{name}.wrapped.rkt')}
+                     for name in programs},
+        'scope': 'One rival; all 3 canonical demos, 1 canonical query, 3 default draws (seed 17, indices 0..2), and one unchanged retained validator-accepted query. No exhaustive or parametric qualification claim.',
+        'interpretation': 'First pair per row is observationally identical across default generator support because generated pairs occupy distinct rows. The retained query lies outside default generated support but passes self_check. This confirms the already-open curriculum/validator-domain gap, not an ambiguity on a default generated query.',
+        'cases': cases,
+    }
+    (out / 'report.json').write_text(json.dumps(report, indent=2, sort_keys=True) + '\n')
+    print(json.dumps({'result': report['result'], 'report': str(out / 'report.json'), 'generator_sha256': sha(source), 'canonical_rule_sha256': report['source_binding']['canonical_rule_sha256'], 'cases': len(cases), 'protected': identity['protected']}))
+
+
+if __name__ == '__main__':
+    main()
