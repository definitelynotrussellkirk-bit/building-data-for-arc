@@ -0,0 +1,230 @@
+#!/usr/bin/env python3
+"""Bounded shortcut audit for the eab1349eed65 row-pack lesson.
+
+The audit asks a narrow, reproducible question: can one of several plausible
+wrong rules fit every visible demonstration yet disagree with a held-out query?
+It is intentionally finite; a clean report rules out only the competitors
+listed in :data:`RIVALS` over the requested seed window.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Callable, Iterable, Sequence
+
+
+def _load_generator():
+    try:
+        from puzzle_generators.per_puzzle.eab1349eed65 import generator as loaded
+        return loaded
+    except ModuleNotFoundError:
+        repo_root = Path(__file__).resolve().parents[3]
+        runtime_root = repo_root / "shared" / "runtime"
+        if str(runtime_root) not in sys.path:
+            sys.path.insert(0, str(runtime_root))
+        generator_path = repo_root / "generators" / "eab1349eed65" / "generator.py"
+        spec = importlib.util.spec_from_file_location(
+            "eab1349eed65_generator_for_audit", generator_path
+        )
+        if spec is None or spec.loader is None:
+            raise RuntimeError(f"cannot load generator from {generator_path}")
+        loaded = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(loaded)
+        return loaded
+
+
+generator = _load_generator()
+
+Grid = list[list[int]]
+RowRule = Callable[[list[int]], list[int]]
+
+
+def _pack(values: Sequence[int], width: int) -> list[int]:
+    packed = list(values)
+    return packed + [0] * (width - len(packed))
+
+
+def canonical_rule(grid: Grid) -> Grid:
+    return [_pack([value for value in row if value != 0], len(row)) for row in grid]
+
+
+def _apply_row_rule(grid: Grid, rule: RowRule) -> Grid:
+    result: Grid = []
+    for row in grid:
+        values = [value for value in row if value != 0]
+        result.append(_pack(rule(values), len(row)))
+    return result
+
+
+def sort_ascending(grid: Grid) -> Grid:
+    return _apply_row_rule(grid, sorted)
+
+
+def sort_descending(grid: Grid) -> Grid:
+    return _apply_row_rule(grid, lambda values: sorted(values, reverse=True))
+
+
+def reverse_each_row(grid: Grid) -> Grid:
+    return _apply_row_rule(grid, lambda values: list(reversed(values)))
+
+
+def deduplicate_each_row(grid: Grid) -> Grid:
+    return _apply_row_rule(grid, lambda values: list(dict.fromkeys(values)))
+
+
+RIVALS: dict[str, Callable[[Grid], Grid]] = {
+    "sort_ascending": sort_ascending,
+    "sort_descending": sort_descending,
+    "reverse_each_row": reverse_each_row,
+    "deduplicate_each_row": deduplicate_each_row,
+}
+
+
+def _difficulty_name(value: str | None) -> str:
+    return "medium" if value is None else value
+
+
+def audit(
+    *,
+    seeds: Iterable[int],
+    demonstration_count: int = 2,
+    query_count: int = 1,
+    difficulties: Sequence[str | None] = ("easy", None, "hard"),
+) -> dict:
+    if isinstance(demonstration_count, bool) or demonstration_count < 1:
+        raise ValueError("demonstration_count must be a positive integer")
+    if isinstance(query_count, bool) or query_count < 1:
+        raise ValueError("query_count must be a positive integer")
+
+    seed_values = list(seeds)
+    if any(isinstance(seed, bool) or not isinstance(seed, int) for seed in seed_values):
+        raise TypeError("seeds must contain only integers")
+
+    survivor_counts = {name: 0 for name in RIVALS}
+    examples: dict[str, dict] = {}
+    ambiguous_episodes = 0
+    episodes = 0
+
+    for difficulty in difficulties:
+        if difficulty not in ("easy", None, "hard"):
+            raise ValueError(f"unsupported difficulty: {difficulty!r}")
+        for seed in seed_values:
+            grids = [
+                generator.generate(seed, sample_index, difficulty=difficulty)
+                for sample_index in range(demonstration_count + query_count)
+            ]
+            expected = [canonical_rule(grid) for grid in grids]
+            demo_grids = grids[:demonstration_count]
+            demo_expected = expected[:demonstration_count]
+            query_grids = grids[demonstration_count:]
+            query_expected = expected[demonstration_count:]
+
+            survivors = []
+            for name, rival in RIVALS.items():
+                fits_demos = all(
+                    rival(grid) == answer
+                    for grid, answer in zip(demo_grids, demo_expected)
+                )
+                differs_on_query = any(
+                    rival(grid) != answer
+                    for grid, answer in zip(query_grids, query_expected)
+                )
+                if fits_demos and differs_on_query:
+                    survivors.append(name)
+                    survivor_counts[name] += 1
+                    examples.setdefault(
+                        name,
+                        {
+                            "difficulty": _difficulty_name(difficulty),
+                            "seed": seed,
+                            "demonstration_inputs": demo_grids,
+                            "query_input": query_grids[0],
+                            "canonical_query_output": query_expected[0],
+                            "rival_query_output": rival(query_grids[0]),
+                        },
+                    )
+
+            if survivors:
+                ambiguous_episodes += 1
+            episodes += 1
+
+    return {
+        "schema": "arcpuzzles-peer-learnability-audit-v1",
+        "task_id": generator.TASK_ID,
+        "finite_scope": {
+            "seed_count": len(seed_values),
+            "seeds": seed_values,
+            "difficulties": [_difficulty_name(value) for value in difficulties],
+            "demonstration_count": demonstration_count,
+            "query_count": query_count,
+            "rivals": list(RIVALS),
+        },
+        "episodes": episodes,
+        "ambiguous_episodes": ambiguous_episodes,
+        "surviving_rivals": {
+            name: count for name, count in survivor_counts.items() if count
+        },
+        "examples": examples,
+        "interpretation": (
+            "A clean result excludes only the listed finite rivals over this "
+            "seed window; it is not a proof of universal lesson uniqueness."
+        ),
+    }
+
+
+def _parse_seeds(text: str) -> list[int]:
+    text = text.strip()
+    if ":" in text:
+        pieces = text.split(":")
+        if len(pieces) not in (2, 3):
+            raise argparse.ArgumentTypeError("seed range must be START:STOP[:STEP]")
+        start, stop = int(pieces[0]), int(pieces[1])
+        step = int(pieces[2]) if len(pieces) == 3 else 1
+        if step == 0:
+            raise argparse.ArgumentTypeError("seed step cannot be zero")
+        return list(range(start, stop, step))
+    return [int(piece) for piece in text.split(",") if piece.strip()]
+
+
+def _parse_difficulties(text: str) -> tuple[str | None, ...]:
+    mapping = {"easy": "easy", "medium": None, "hard": "hard"}
+    try:
+        return tuple(mapping[piece.strip()] for piece in text.split(",") if piece.strip())
+    except KeyError as exc:
+        raise argparse.ArgumentTypeError(
+            "difficulties must be a comma-separated subset of easy,medium,hard"
+        ) from exc
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seeds", type=_parse_seeds, default=list(range(256)))
+    parser.add_argument("--demos", type=int, default=2)
+    parser.add_argument("--queries", type=int, default=1)
+    parser.add_argument(
+        "--difficulties",
+        type=_parse_difficulties,
+        default=("easy", None, "hard"),
+    )
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args()
+
+    report = audit(
+        seeds=args.seeds,
+        demonstration_count=args.demos,
+        query_count=args.queries,
+        difficulties=args.difficulties,
+    )
+    rendered = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(rendered, encoding="utf-8")
+    print(rendered, end="")
+    return 0 if report["ambiguous_episodes"] == 0 else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
