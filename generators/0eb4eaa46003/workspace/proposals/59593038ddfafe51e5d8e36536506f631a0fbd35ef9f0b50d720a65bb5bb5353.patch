+from __future__ import annotations
+
+import copy
+import importlib.util
+import os
+import random
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from puzzle_generators.per_puzzle.eab1349eed65 import generator
+from reviewer_support import canonical_pairs as load_canonical_pairs, find_root
+
+
+ROOT = find_root(__file__)
+
+
+def pack_left_preserving_order(grid):
+    result = []
+    for row in grid:
+        values = [value for value in row if value != 0]
+        result.append(values + [0] * (len(row) - len(values)))
+    return result
+
+
+def _row_transform(grid, transform):
+    result = []
+    for row in grid:
+        values = [value for value in row if value != 0]
+        values = transform(values)
+        result.append(values + [0] * (len(row) - len(values)))
+    return result
+
+
+def sort_ascending(grid):
+    return _row_transform(grid, sorted)
+
+
+def sort_descending(grid):
+    return _row_transform(grid, lambda values: sorted(values, reverse=True))
+
+
+def reverse_each_row(grid):
+    return _row_transform(grid, lambda values: list(reversed(values)))
+
+
+def deduplicate_each_row(grid):
+    return _row_transform(grid, lambda values: list(dict.fromkeys(values)))
+
+
+RIVALS = {
+    "sort_ascending": sort_ascending,
+    "sort_descending": sort_descending,
+    "reverse_each_row": reverse_each_row,
+    "deduplicate_each_row": deduplicate_each_row,
+}
+
+
+class Eab1349eed65GeneratorTests(unittest.TestCase):
+    def test_canonical_pairs_match_independent_rule_without_mutation(self):
+        pairs = load_canonical_pairs(generator.TASK_ID, root=ROOT)
+        self.assertEqual(len(pairs), 5)
+        for pair in pairs:
+            grid = copy.deepcopy(pair["input"])
+            before = copy.deepcopy(grid)
+            self.assertEqual(generator.self_check(grid), [])
+            self.assertEqual(pack_left_preserving_order(grid), pair["output"])
+            self.assertEqual(grid, before)
+
+    def test_each_normal_sample_refutes_order_and_dedup_shortcuts(self):
+        for difficulty in ("easy", None, "hard"):
+            for seed in range(64):
+                grid = generator.generate(
+                    seed,
+                    seed * 17 + 1,
+                    difficulty=difficulty,
+                )
+                expected = pack_left_preserving_order(grid)
+                self.assertEqual(generator.self_check(grid), [])
+                for name, rival in RIVALS.items():
+                    with self.subTest(
+                        difficulty=difficulty,
+                        seed=seed,
+                        rival=name,
+                    ):
+                        self.assertNotEqual(rival(grid), expected)
+
+
+    def test_reusable_audit_reports_no_surviving_rivals(self):
+        tool_path = (
+            ROOT
+            / "generators"
+            / generator.TASK_ID
+            / "workspace"
+            / "audit_learnability.py"
+        )
+        spec = importlib.util.spec_from_file_location(
+            "eab1349eed65_audit_learnability", tool_path
+        )
+        self.assertIsNotNone(spec)
+        self.assertIsNotNone(spec.loader)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        report = module.audit(
+            seeds=range(16),
+            demonstration_count=2,
+            query_count=1,
+            difficulties=("easy", None, "hard"),
+        )
+        self.assertEqual(report["episodes"], 48)
+        self.assertEqual(report["surviving_rivals"], {})
+        self.assertEqual(report["ambiguous_episodes"], 0)
+
+
+    def test_reusable_audit_cli_runs_from_the_repository(self):
+        tool_path = (
+            ROOT
+            / "generators"
+            / generator.TASK_ID
+            / "workspace"
+            / "audit_learnability.py"
+        )
+        with tempfile.TemporaryDirectory() as directory:
+            output_path = f"{directory}/report.json"
+            clean_env = os.environ.copy()
+            clean_env.pop("PYTHONPATH", None)
+            completed = subprocess.run(
+                [
+                    sys.executable,
+                    str(tool_path),
+                    "--seeds",
+                    "0:4",
+                    "--demos",
+                    "2",
+                    "--queries",
+                    "1",
+                    "--out",
+                    output_path,
+                ],
+                cwd=ROOT,
+                text=True,
+                capture_output=True,
+                check=False,
+                env=clean_env,
+            )
+            self.assertEqual(completed.returncode, 0, completed.stderr)
+            self.assertTrue(Path(output_path).is_file())
+
+    def test_replay_is_deterministic_fresh_and_global_rng_pure(self):
+        random.seed(9281)
+        state = random.getstate()
+        first = generator.generate(17, 29, difficulty="hard")
+        self.assertEqual(random.getstate(), state)
+        second = generator.generate(17, 29, difficulty="hard")
+        self.assertEqual(first, second)
+        self.assertIsNot(first, second)
+        self.assertTrue(all(a is not b for a, b in zip(first, second)))
+        first[0][0] = 99
+        self.assertNotEqual(first, second)
+
+
+if __name__ == "__main__":
+    unittest.main()
