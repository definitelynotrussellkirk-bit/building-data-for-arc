+def schedule_n_corners(seed, sample_index, difficulty=None):
+    """Return the four-slot lesson cardinality schedule.
+
+    Every period contains two incomplete orientation sets and two complete
+    sets. The seed rotates (but never changes) that cycle, restoring support
+    across fixed-index seed sweeps while keeping canonical-like dense examples.
+    Every three-demonstration holdout rotation therefore includes a
+    counterexample to ``complete_all_corners``.
+    """
+    if type(seed) is not int:
+        raise TypeError("seed must be an integer (not bool)")
+    if type(sample_index) is not int:
+        raise TypeError("sample_index must be an integer (not bool)")
+    if sample_index < 0:
+        raise ValueError("sample_index must be nonnegative")
+    if difficulty not in _LESSON_CARDINALITY_SCHEDULE:
+        raise ValueError("difficulty must be easy, medium, hard, or None")
+    phase = seed % LESSON_SCHEDULE_PERIOD
+    return _LESSON_CARDINALITY_SCHEDULE[difficulty][
+        (sample_index + phase) % LESSON_SCHEDULE_PERIOD
+    ]
 
 
