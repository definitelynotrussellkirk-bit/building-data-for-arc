(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((bg (mode g))
                  (k (quotient (- h 1) 2))
                  (objs (objects g bg))
                  (placements (map (lambda (obj)
                                     (let* ((color (obj-color obj))
                                            (r1 (obj-r1 obj))
                                            (c1 (obj-c1 obj))
                                            (r2 (obj-r2 obj))
                                            (c2 (obj-c2 obj))
                                            (tl (= (at g r1 c1) color))
                                            (tr (= (at g r1 c2) color))
                                            (bl (= (at g r2 c1) color))
                                            (br (= (at g r2 c2) color))
                                            (corner (cond
                                                      ((and tl tr bl) 'br)
                                                      ((and tl tr br) 'bl)
                                                      ((and tl bl br) 'tr)
                                                      (else 'tl))))
                                       (list corner color)))
                                   objs))
                  (covers? (lambda (p r c)
                             (let ((corner (first p)))
                               (cond
                                 ((eq? corner 'tl) (and (< r k) (< c k) (or (zero? r) (zero? c))))
                                 ((eq? corner 'tr) (and
                                     (< r k)
                                     (>= c (- w k))
                                     (or (zero? r) (= c (- w 1)))))
                                 ((eq? corner 'bl) (and
                                     (>= r (- h k))
                                     (< c k)
                                     (or (= r (- h 1)) (zero? c))))
                                 (else (and
                                         (>= r (- h k))
                                         (>= c (- w k))
                                         (or (= r (- h 1)) (= c (- w 1))))))))))
             (cellmap g
                      (r c v)
                      (let ((hit (find-first (lambda (p) (covers? p r c)) placements)))
                        (if hit (second hit) bg)))))))
