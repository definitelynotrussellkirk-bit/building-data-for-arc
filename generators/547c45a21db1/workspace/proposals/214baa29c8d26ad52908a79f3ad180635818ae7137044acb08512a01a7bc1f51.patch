+(rule!
+ (let ((dummy 0))
+   (define dirs4
+     (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))
+   (define (e11-active? grid p)
+     (and (in-bounds? (first p) (second p) (rows grid) (cols grid))
+          (member? (at grid (first p) (second p)) (list 1 2 3))))
+   (define (e11-nexts grid current previous)
+     (filter
+      (lambda (p)
+        (and (e11-active? grid p)
+             (or (empty? previous) (not (equal? p previous)))))
+      (map
+       (lambda (d)
+         (list (+ (first current) (first d))
+               (+ (second current) (second d))))
+       dirs4)))
+   (define (e11-path grid current previous fuel)
+     (if (= fuel 0)
+         (list current)
+         (let ((nexts (e11-nexts grid current previous)))
+           (if (empty? nexts)
+               (list current)
+               (cons current
+                     (e11-path grid (first nexts) current (- fuel 1)))))))
+   (define (e11-direction a b)
+     (list (- (first b) (first a))
+           (- (second b) (second a))))
+   (define (e11-first-turn-radius path)
+     (let loop ((remaining path) (index 1))
+       (if (< (length remaining) 3)
+           (- (length path) 1)
+           (if (equal? (e11-direction (first remaining) (second remaining))
+                       (e11-direction (second remaining) (third remaining)))
+               (loop (rest remaining) (+ index 1))
+               index))))
+   (define (e11-path-index path target)
+     (let loop ((remaining path) (index 0))
+       (if (empty? remaining)
+           -1
+           (if (equal? (first remaining) target)
+               index
+               (loop (rest remaining) (+ index 1))))))
+   (let* ((seed2 (first (find-color g 2)))
+          (path (e11-path g seed2 (list) (* (rows g) (cols g))))
+          (radius (e11-first-turn-radius path))
+          (final-index (- (length path) 1)))
+     (grid-from-fn
+      (rows g)
+      (cols g)
+      (lambda (r c)
+        (let ((v (at g r c)) (p (list r c)))
+          (cond
+            ((= v 2) 2)
+            ((= v 3) 3)
+            ((= v 1)
+             (let* ((index (e11-path-index path p))
+                    (distance-to-3 (- final-index index))
+                    (near-2 (<= index radius))
+                    (near-3 (<= distance-to-3 radius)))
+               (cond
+                 ((and near-2 near-3) 4)
+                 (near-2 2)
+                 (near-3 3)
+                 (else 1))))
+            (else v))))))))
