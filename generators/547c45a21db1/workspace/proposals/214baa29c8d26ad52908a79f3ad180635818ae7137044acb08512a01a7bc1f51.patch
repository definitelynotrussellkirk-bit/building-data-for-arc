+"""Bounded lesson-ambiguity probe for task 441c97bcdb07.
+
+This is reviewer tooling, not production label authority.  It loads the selected
+source by exact adjacent path, verifies each diagnostic rival against all
+canonical pairs, then checks all query rotations in finite four-pair windows.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any, Callable
+
+from reviewer_support import canonical_pairs, find_root
+
+
+TASK_ID = "441c97bcdb07"
+HOME = Path(__file__).resolve().parents[1]
+
+
+def load_generator():
+    source = HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location(
+        f"bounded_peer_probe_{TASK_ID}", source
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {source}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _identity(grid: list[list[int]]) -> list[list[int]]:
+    return copy.deepcopy(grid)
+
+
+def _input_color(grid: list[list[int]]) -> int:
+    colors = {value for row in grid for value in row if value != 0}
+    if len(colors) != 1:
+        raise ValueError(f"expected one nonzero color, found {sorted(colors)}")
+    return next(iter(colors))
+
+
+def _metadata(gen: Any, grid: list[list[int]]) -> dict[str, Any]:
+    profile = gen.semantic_profile(grid)
+    if not profile.get("valid"):
+        raise ValueError(f"generated input is not lawful: {profile.get('errors')}")
+    return {
+        "height": len(grid),
+        "width": len(grid[0]),
+        "color": _input_color(grid),
+        "shape_cells": profile["shape_cells"],
+        "shape_id": profile["shape_id"],
+        "row_span": profile["row_span"],
+        "col_span": profile["col_span"],
+    }
+
+
+def _competitors(gen: Any, canonical_palette: frozenset[int]) -> dict[str, Callable]:
+    def skip_cell_count(count: int):
+        def rival(grid: list[list[int]]) -> list[list[int]]:
+            profile = gen.semantic_profile(grid)
+            if not profile.get("valid"):
+                return _identity(grid)
+            return (
+                _identity(grid)
+                if profile["shape_cells"] == count
+                else gen.rule_mirror(grid)
+            )
+
+        return rival
+
+    def canonical_palette_only(grid: list[list[int]]) -> list[list[int]]:
+        return (
+            gen.rule_mirror(grid)
+            if _input_color(grid) in canonical_palette
+            else _identity(grid)
+        )
+
+    return {
+        "skip_three_cell_shapes": skip_cell_count(3),
+        "skip_five_cell_shapes": skip_cell_count(5),
+        "canonical_palette_only": canonical_palette_only,
+    }
+
+
+def build_report(*, starts: int, seeds: list[int]) -> dict[str, Any]:
+    if type(starts) is not int or starts < 1:
+        raise ValueError("starts must be a positive exact integer")
+    if not seeds or any(type(seed) is not int for seed in seeds):
+        raise ValueError("at least one exact integer seed is required")
+
+    gen = load_generator()
+    root = find_root(__file__)
+    canonical = canonical_pairs(TASK_ID, root=root, variant=0)
+    canonical_palette = frozenset(_input_color(pair["input"]) for pair in canonical)
+    competitors = _competitors(gen, canonical_palette)
+
+    canonical_fit: dict[str, bool] = {}
+    for name, rival in competitors.items():
+        canonical_fit[name] = all(
+            rival(pair["input"]) == pair["output"] for pair in canonical
+        )
+    if not all(canonical_fit.values()):
+        raise AssertionError(f"diagnostic rival failed canonical-fit gate: {canonical_fit}")
+
+    counts = {name: 0 for name in competitors}
+    first_findings: dict[str, dict[str, Any]] = {}
+    total_rotations = 0
+    for band in ("easy", "medium", "hard"):
+        for seed in seeds:
+            for start in range(starts):
+                grids = [
+                    gen.generate(seed, start + offset, difficulty=band)
+                    for offset in range(gen.EXAMPLES_NEEDED + 1)
+                ]
+                outputs = [gen.rule_mirror(grid) for grid in grids]
+                rival_outputs = {
+                    name: [rival(grid) for grid in grids]
+                    for name, rival in competitors.items()
+                }
+                for query_index in range(len(grids)):
+                    demo_indices = [
+                        index for index in range(len(grids)) if index != query_index
+                    ]
+                    total_rotations += 1
+                    for name in competitors:
+                        survives = all(
+                            rival_outputs[name][index] == outputs[index]
+                            for index in demo_indices
+                        )
+                        changes_query = (
+                            rival_outputs[name][query_index] != outputs[query_index]
+                        )
+                        if not (survives and changes_query):
+                            continue
+                        counts[name] += 1
+                        if name not in first_findings:
+                            first_findings[name] = {
+                                "band": band,
+                                "seed": seed,
+                                "start": start,
+                                "sample_indices": list(
+                                    range(start, start + len(grids))
+                                ),
+                                "query_index": query_index,
+                                "demo_indices": demo_indices,
+                                "pair_metadata": [
+                                    _metadata(gen, grid) for grid in grids
+                                ],
+                                "query": {
+                                    "input": grids[query_index],
+                                    "expected_output": outputs[query_index],
+                                    "rival_output": rival_outputs[name][query_index],
+                                },
+                            }
+
+    status = "finding" if any(counts.values()) else "pass"
+    return {
+        "schema": "441c97bcdb07-bounded-peer-probe-v1",
+        "task_id": TASK_ID,
+        "source_sha256": __import__("hashlib").sha256(
+            (HOME / "generator.py").read_bytes()
+        ).hexdigest(),
+        "scope": {
+            "bands": ["easy", "medium", "hard"],
+            "seeds": seeds,
+            "starts_per_band_seed": starts,
+            "pairs_per_window": gen.EXAMPLES_NEEDED + 1,
+            "all_query_rotations": True,
+            "total_rotations": total_rotations,
+        },
+        "canonical_palette": sorted(canonical_palette),
+        "canonical_fit": canonical_fit,
+        "ambiguous_rotations": counts,
+        "first_findings": first_findings,
+        "status": status,
+        "limits": [
+            "Finite diagnostic rival family and finite windows; not universal induction proof.",
+            "Labels use the selected source's Python diagnostic mirror; focused tests bind that mirror to all canonical pairs.",
+            "No production source or canonical Racket authority is modified by this probe.",
+        ],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--starts", type=int, default=64)
+    parser.add_argument("--seed", type=int, action="append", dest="seeds")
+    parser.add_argument("--out", type=Path)
+    parser.add_argument("--fail-on-finding", action="store_true")
+    args = parser.parse_args()
+    report = build_report(starts=args.starts, seeds=args.seeds or [0, 17])
+    text = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(text, encoding="utf-8")
+    else:
+        print(text, end="")
+    return 1 if args.fail_on_finding and report["status"] == "finding" else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
