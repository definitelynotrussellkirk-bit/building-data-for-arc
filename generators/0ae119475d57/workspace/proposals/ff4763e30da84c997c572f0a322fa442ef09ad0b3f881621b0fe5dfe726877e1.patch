+"""Bounded audit of fixed-source-corner shortcuts after the direction repair.
+
+All retained intended labels and rival predictions execute in protected Racket.
+The original source remains unchanged; the existing reverse-direction audit is
+not duplicated or resolved by this check.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import load_selected_generator
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = "d833a288bd7d"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+PIN = "a3a2b20673699178ba8acc6e8343d9660fbf788b0ebb8e414455dcadf34c124b"
+RULE_HASH = "67e977ce99e1"
+ROTATION = "(rot (remainder (+ 4 (- target-diag source-diag)) 4))"
+
+
+def sha(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def source_corner(grid):
+    points = [(r, c) for r, row in enumerate(grid) for c, v in enumerate(row) if v in (1, 8)]
+    r0, r1 = min(r for r, _ in points), max(r for r, _ in points)
+    c0, c1 = min(c for _, c in points), max(c for _, c in points)
+    corners = ((r0 - 1, c0 - 1), (r0 - 1, c1 + 1),
+               (r1 + 1, c1 + 1), (r1 + 1, c0 - 1))
+    sources = [i for i, (r, c) in enumerate(corners) if grid[r][c] == 4]
+    assert len(sources) == 1
+    return sources[0]
+
+
+def needs_source_corner_demo(demos, query):
+    """Visible-only proposed guard against the fixed-source hypothesis class."""
+    sources = {source_corner(g) for g in demos}
+    return len(sources) == 1 and source_corner(query) not in sources
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    gen, source, digest = load_selected_generator(TASK, root=ROOT)
+    assert digest == PIN, "Source changed; review this pinned audit"
+    rows = [json.loads(line) for line in
+            (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()]
+    selected = [row for row in rows if row.get("task_id") == TASK]
+    assert len({row["program_solution"] for row in selected}) == 1
+    canonical = next(row for row in selected if row.get("source") == "training")
+    program = canonical["program_solution"]
+    assert sha(" ".join(program.split()))[:12] == RULE_HASH
+    assert program.count(ROTATION) == 1
+    rivals = {k: program.replace(ROTATION,
+              f"(rot (remainder (+ 4 (- target-diag {k})) 4))", 1) for k in range(4)}
+    reverse = program.replace(ROTATION, "(rot (remainder (+ 4 (- source-diag target-diag)) 4))", 1)
+    samples = []
+    for seed in (0, 17):
+        for index in range(8):
+            grid = gen.generate(seed, index, difficulty="easy")
+            assert gen.self_check(grid) == []
+            facts = gen._analyze_scene(grid)
+            samples.append({"input": grid, "generation": {"seed": seed,
+                "sample_index": index, "difficulty": "easy", "overrides": {}},
+                "source_diag": source_corner(grid), "target_diag": facts["target_diag"],
+                "turn": (facts["target_diag"] - facts["source_diag"]) % 4})
+    demos = query = None
+    scope = None
+    for start in range(len(samples) - 3):
+        ds, q = samples[start:start + 3], samples[start + 3]
+        if (ds[0]["generation"]["seed"] == q["generation"]["seed"]
+                and len({p["source_diag"] for p in ds}) == 1
+                and ds[0]["source_diag"] != q["source_diag"]
+                and any(p["turn"] % 2 for p in ds)):
+            demos, query = ds, q
+            scope = "three consecutive ordinary generated demos and the next generated query"
+            break
+    if query is None:
+        for k in range(4):
+            group = [p for p in samples if p["source_diag"] == k]
+            odd = next((p for p in group if p["turn"] % 2), None)
+            q = next((p for p in samples if p["source_diag"] != k), None)
+            if len(group) >= 3 and odd is not None and q is not None:
+                ds = group[:3]
+                if not any(p["turn"] % 2 for p in ds):
+                    ds = ds[:2] + [odd]
+                demos, query = ds, q
+                scope = "assembled lesson from ordinary generated inputs"
+                break
+    report = {"schema": "arc-bounded-source-corner-review-v1", "task_id": TASK,
+        "status": "finding" if query else "finite_no_counterexample", "scope": scope,
+        "source_sha256": digest, "rule_hash": RULE_HASH,
+        "canonical_program_sha256": sha(program),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "rival_class": "four fixed-source-corner rotations: (target_diag - k) mod4",
+        "rival_program_sha256": {str(k): sha(p) for k, p in rivals.items()},
+        "sampled_inputs": [{key: value for key, value in p.items() if key != "input"} for p in samples],
+        "limits": "Four fixed-source hypotheses;16 ordinary easy inputs from seeds0/17; no frequency estimate, battery, source repair or approval.",
+        "prior_reverse_audit": "older source8863... remains needs_triage; current-case reverse elimination is recorded separately"}
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            report["runtime_identity"] = identity
+            evaluations = 0
+            canonical_checks = []
+            for pair in canonical["train"] + canonical["test"]:
+                actual = apply(program, pair["input"])
+                evaluations += 1
+                canonical_checks.append(actual == pair["output"])
+            assert all(canonical_checks)
+            report["canonical_replay_matches"] = canonical_checks
+            if query:
+                k = demos[0]["source_diag"]
+                fit = {str(i): [] for i in range(4)}
+                reverse_fit = []
+                for p in demos:
+                    p["output"] = apply(program, p["input"])
+                    evaluations += 1
+                    for i, rule in rivals.items():
+                        prediction = apply(rule, p["input"])
+                        evaluations += 1
+                        fit[str(i)].append(prediction == p["output"])
+                        if i == k:
+                            p["rival_output"] = prediction
+                    reverse_fit.append(apply(reverse, p["input"]) == p["output"])
+                    evaluations += 1
+                query["output"] = apply(program, query["input"])
+                query["rival_output"] = apply(rivals[k], query["input"])
+                evaluations += 2
+                assert fit[str(k)] == [True] * 3
+                assert query["output"] != query["rival_output"]
+                assert not all(reverse_fit)
+                assert gen.lesson_identifiable(demos, query) == []
+                assert needs_source_corner_demo([p["input"] for p in demos], query["input"])
+                report.update(train=demos, test=[query], selected_fixed_source=k,
+                    selected_rival_program=rivals[k], rival_demo_fits=fit,
+                    reverse_rotation_demo_fits=reverse_fit, current_lesson_hook_reasons=[],
+                    source_guard_rejects_original=True,
+                    self_check_errors=[gen.self_check(p["input"]) for p in demos + [query]],
+                    differing_query_cells=[[r, c, a, b]
+                        for r, (ar, br) in enumerate(zip(query["output"], query["rival_output"]))
+                        for c, (a, b) in enumerate(zip(ar, br)) if a != b])
+                repair = next((p for p in samples if p["source_diag"] != k and p["input"] != query["input"]), None)
+                if repair is not None:
+                    repair["output"] = apply(program, repair["input"])
+                    repair["rival_output"] = apply(rivals[k], repair["input"])
+                    evaluations += 2
+                    assert repair["output"] != repair["rival_output"]
+                    assert not needs_source_corner_demo([p["input"] for p in demos] + [repair["input"]], query["input"])
+                    report.update(distinguishing_demo=repair, distinct_source_demo_rejects_rival=True)
+            report["racket_evaluations"] = evaluations
+        finally:
+            bridge.close()
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == digest
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    summary = {key: report[key] for key in ("status", "scope", "source_sha256", "racket_evaluations")}
+    if query:
+        summary.update(fixed_source=k, demos=[p["generation"] for p in demos], query=query["generation"],
+            turns=[p["turn"] for p in demos], sources=[p["source_diag"] for p in demos + [query]],
+            reverse_rotation_demo_fits=reverse_fit, differing_query_cell_count=len(report["differing_query_cells"]))
+    print(json.dumps(summary))
+
+
+if __name__ == "__main__":
+    main()
