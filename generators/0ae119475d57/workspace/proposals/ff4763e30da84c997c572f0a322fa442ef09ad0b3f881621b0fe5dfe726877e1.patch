@@ -0,0 +1,193 @@
+"""Bounded audit of grown-area/box shortcuts, distinct from retained raw audits."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "src"))
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+TASK = "155fb684795d"
+SOURCE_SHA = "6e04a32f60c221025ade405f8509f5abd0e8888a3318d54ba6a75c85de8ee1a4"
+RULE_HASH = "76d51e40d80e"
+
+
+def sha(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def rival_programs(canonical):
+    old_key = "(define (grown-shape-key grid obj) (shape-key (normalize-cells (grow-from-centers grid (obj-cells obj) plus-offsets))))"
+    old_odd = "(odd (first (filter (lambda (info) (= (count-where (lambda (k) (equal? k (first info))) keys) 1)) infos)))"
+    assert canonical.count(old_key) == canonical.count(old_odd) == 1
+    keys = {
+        "grown_cell_count": "(define (grown-shape-key grid obj) (length (grow-from-centers grid (obj-cells obj) plus-offsets)))",
+        "grown_bounding_box": "(define (grown-shape-key grid obj) (let* ((bb (bbox-of-cells (grow-from-centers grid (obj-cells obj) plus-offsets))) (hh (+ 1 (- (third bb) (first bb)))) (ww (+ 1 (- (fourth bb) (second bb))))) (list (min hh ww) (max hh ww))))",
+    }
+    result = {}
+    for name, key in keys.items():
+        for direction in ("left", "right"):
+            select = "(first choices)" if direction == "left" else "(first (reverse choices))"
+            odd = "(odd (let* ((unique (filter (lambda (info) (= (count-where (lambda (k) (equal? k (first info))) keys) 1)) infos)) (choices (if (empty? unique) infos unique))) " + select + "))"
+            result[name + "_" + direction] = canonical.replace(old_key, key).replace(old_odd, odd)
+    return result
+
+
+def demo_only_survivors(demos, rivals, execute):
+    """Proposed bounded teaching guard; execution errors are never refutations."""
+    return [name for name, program in rivals.items()
+            if all(_grid(execute(program, pair["input"])) == pair["output"] for pair in demos)]
+
+
+def difference(left, right):
+    if (len(left), len(left[0])) != (len(right), len(right[0])):
+        return {"kind": "dimensions", "intended": [len(left), len(left[0])],
+                "rival": [len(right), len(right[0])]}
+    cells = [{"row": r, "col": c, "intended": value, "rival": right[r][c]}
+             for r, row in enumerate(left) for c, value in enumerate(row) if value != right[r][c]]
+    return {"kind": "cells", "count": len(cells), "first": cells[0] if cells else None}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    ledger = ROOT / "shared/data/canonical/puzzles.jsonl"
+    selected = [json.loads(line) for line in ledger.read_text().splitlines()
+                if json.loads(line).get("task_id") == TASK]
+    assert len(selected) == 1
+    selected = selected[0]
+    canonical = selected["program_solution"]
+    assert sha(" ".join(canonical.split()).encode())[:12] == RULE_HASH
+    rivals = rival_programs(canonical)
+    report = {
+        "schema": "arcpuzzles-bounded-peer-adversarial-probe-v1",
+        "task_id": TASK, "status": "running", "execution_errors": [],
+        "source_binding": {"generator_sha256": SOURCE_SHA, "rule_hash": RULE_HASH,
+                           "canonical_program_sha256": sha(canonical.encode()),
+                           "canonical_ledger_path": str(ledger.relative_to(ROOT)),
+                           "probe_sha256": sha(Path(__file__).read_bytes())},
+        "programs": {"intended": canonical, **rivals},
+        "sampling": {"seeds": [0, 1], "difficulty": None, "overrides": {},
+                     "generated_inputs": 16, "indices_per_seed": 8,
+                     "demo_indices": [0, 1, 2], "query_indices": [3, 4, 5, 6],
+                     "additional_candidate_index": 7},
+        "prior_open_audits": ["review-90dc3740fbd981e5:v0001", "review-12fa2f8760861c7c:v0001"],
+        "limits": ["Four finite rivals; no universal identifiability claim.",
+                   "All rivals retain plus-growth but discard the full grown silhouette.",
+                   "When no unique statistic exists, the stated left/right fallback selects a panel; this is not an execution error.",
+                   "Ordinary generated lessons and the saved canonical lesson are separate scopes.",
+                   "Prior raw-vocabulary and rightmost-raw-unique audits remain unresolved and are not re-audited.",
+                   "No production/canonical changes, acceptance or admission."]}
+    runtime = ROOT / "shared/runtime"
+    try:
+        with _local_imports(runtime, Path(__file__).resolve().parent):
+            from reviewer_support import load_selected_generator
+            gen, source, source_hash = load_selected_generator(TASK, root=ROOT)
+            assert source_hash == SOURCE_SHA
+            report["source_binding"]["generator_path"] = str(source.relative_to(ROOT))
+            apply, report["racket"], bridge = _real_evaluator(runtime)
+            cache = {}
+
+            def execute(program, grid):
+                key = (program, json.dumps(grid, separators=(",", ":")))
+                if key not in cache:
+                    cache[key] = _grid(apply(program, grid))
+                return cache[key]
+
+            def label(grid, origin):
+                errors = gen.self_check(grid)
+                assert not errors, errors
+                return {"origin": origin, "input": grid, "self_check": errors,
+                        "output": execute(canonical, grid),
+                        "rival_outputs": {name: execute(program, grid) for name, program in rivals.items()}}
+
+            def lesson(name, demos, queries):
+                alive = demo_only_survivors(demos, rivals, execute)
+                inputs = [json.dumps(pair["input"]) for pair in demos + queries]
+                return {"name": name, "demos": demos, "queries": queries,
+                        "distinct_input_count": len(set(inputs)),
+                        "survivors_from_demos_only": alive,
+                        "existing_lesson_hook": [gen.lesson_identifiable(demos, query) for query in queries],
+                        "query_disagreements": [{"origin": query["origin"], "rival": name,
+                            "difference": difference(query["output"], query["rival_outputs"][name])}
+                            for query in queries for name in alive
+                            if query["output"] != query["rival_outputs"][name]]}
+
+            try:
+                saved_tests = selected["test"] if isinstance(selected["test"], list) else [selected["test"]]
+                demos = [label(pair["input"], {"kind": "saved_canonical_demo", "index": i})
+                         for i, pair in enumerate(selected["train"])]
+                queries = [label(pair["input"], {"kind": "saved_canonical_query", "index": i})
+                           for i, pair in enumerate(saved_tests)]
+                for actual, saved in zip(demos + queries, selected["train"] + saved_tests):
+                    assert actual["output"] == saved["output"]
+                report["saved_canonical_lesson"] = lesson("saved_canonical", demos, queries)
+                report["generated_lessons"] = []
+                sampled = []
+                for seed in (0, 1):
+                    rows = [label(gen.generate(seed, index),
+                                  {"kind": "ordinary_generated", "seed": seed, "sample_index": index})
+                            for index in range(8)]
+                    sampled.extend(rows)
+                    item = lesson(f"generated_seed_{seed}", rows[:3], rows[3:7])
+                    item["additional_candidate"] = rows[7]
+                    report["generated_lessons"].append(item)
+                report["repair_proposals"] = []
+                all_lessons = [report["saved_canonical_lesson"], *report["generated_lessons"]]
+                for item in all_lessons:
+                    if not item["query_disagreements"]:
+                        continue
+                    original = {json.dumps(pair["input"]) for pair in item["demos"] + item["queries"]}
+                    demos = list(item["demos"])
+                    extras = []
+                    alive = list(item["survivors_from_demos_only"])
+                    for candidate in sampled:
+                        fingerprint = json.dumps(candidate["input"])
+                        if fingerprint in original or len(demos) >= 6:
+                            continue
+                        if any(candidate["output"] != candidate["rival_outputs"][name] for name in alive):
+                            demos.append(candidate)
+                            extras.append(candidate)
+                            original.add(fingerprint)
+                            alive = demo_only_survivors(demos, rivals, execute)
+                        if not alive:
+                            break
+                    report["repair_proposals"].append({"lesson": item["name"], "extra_demos": extras,
+                        "survivors_after": alive,
+                        "selection": "already sampled distinguishing inputs; original lesson inputs excluded; only demonstration disagreement used",
+                        "limit": "finite four-rival proposal; no production adoption"})
+                report["protected_evaluations"] = len(cache)
+                report["status"] = ("bounded_ambiguity_confirmed" if any(item["query_disagreements"] for item in all_lessons)
+                                    else "bounded_no_query_ambiguity_found")
+            finally:
+                bridge.close()
+            assert sha(source.read_bytes()) == SOURCE_SHA
+    except Exception as error:
+        report["status"] = "execution_error_not_refutation"
+        report["execution_errors"].append({"type": type(error).__name__, "message": str(error)})
+        (args.out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+        raise
+    (args.out / "report.json").write_text(json.dumps(report, separators=(",", ":")) + "\n")
+    summary = {key: report[key] for key in ("schema", "task_id", "status", "source_binding", "racket", "sampling", "prior_open_audits", "execution_errors", "protected_evaluations", "limits")}
+    summary["lessons"] = [{"name": item["name"], "distinct_input_count": item["distinct_input_count"],
+                           "survivors": item["survivors_from_demos_only"],
+                           "query_disagreements": item["query_disagreements"],
+                           "existing_lesson_hook": item["existing_lesson_hook"]}
+                          for item in all_lessons]
+    summary["repair_proposals"] = [{"lesson": item["lesson"],
+                                    "extra_origins": [row["origin"] for row in item["extra_demos"]],
+                                    "survivors_after": item["survivors_after"]}
+                                   for item in report["repair_proposals"]]
+    (args.out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
