+    assert checked["test"][-1]["output"] == [[7]]
+    original["test"][0]["output"] = [[9]]
+    with pytest.raises(ValueError, match="label"):
+        audit.verify_episode(original, "(rule! g)", execute_identity, demos=4, queries=4)
