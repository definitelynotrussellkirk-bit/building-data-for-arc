+    {"tile_width": 2, "order_mode": True},
+    {"tile_width": 2, "order_mode": "unknown"},
+    {"tile_width": 2, "order_mode": "reverse", "extra": 0}, None,
+])
+def test_invalid_settings_rejected_consistently(setting, family):
+    for call in (
+        lambda: family.program(setting),
