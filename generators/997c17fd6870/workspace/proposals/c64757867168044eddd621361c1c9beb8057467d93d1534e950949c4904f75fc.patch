+"""Bounded canonical-demo learnability probe; execute from WORK/repo via review.py.
+
+The rival expands the first two markers in row-major order and omits later ones.
+This is an object-count shortcut, not a claim about arbitrary possible solvers.
+"""
+from pathlib import Path
+import hashlib
+import importlib.util
+import json
+import sys
+
+ROOT = Path.cwd()
+sys.path.insert(0, str(ROOT / "shared/runtime"))
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+TASK = "8586bc0f2889"
+HOME = ROOT / "generators" / TASK
+EXPECTED_SOURCE = "9cd776cce4387fc0c2afe46e1a18ab06af17088a4ebd76c8efec645f338a6d4a"
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, separators=(",", ":"), sort_keys=True).encode()).hexdigest()
+
+
+def first_two_only(grid):
+    out = [[0] * len(grid[0]) for _ in grid]
+    markers = [(r, c, v) for r, row in enumerate(grid) for c, v in enumerate(row) if v]
+    for r, c, color in markers[:2]:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if (rr, cc) != (r, c) and 0 <= rr < len(out) and 0 <= cc < len(out[0]):
+                    out[rr][cc] = color
+    return out
+
+
+def main():
+    source_hash = hashlib.sha256((HOME / "generator.py").read_bytes()).hexdigest()
+    assert source_hash == EXPECTED_SOURCE, "source changed; reassess this finding"
+    rows = [json.loads(line) for line in (ROOT / "shared/data/canonical/puzzles.jsonl").open()]
+    records = [row for row in rows if row["task_id"] == TASK]
+    assert len(records) == 1
+    record = records[0]
+    rule = record["program_solution"]
+    spec = importlib.util.spec_from_file_location("audited_generator", HOME / "generator.py")
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    bridge = RacketBridge()
+    results = []
+    rival_path = Path(__file__).with_name("rival.rkt")
+    rival_rule = rival_path.read_text()
+    try:
+        identity = bridge.runtime_identity
+        assert identity["protected"] is True, identity
+        bridge.eval_text("(define __audit_rule " + wrap_rule(rule) + ")")
+        bridge.eval_text("(define __audit_rival " + wrap_rule(rival_rule) + ")")
+        for split in ("train", "test"):
+            for index, pair in enumerate(record[split]):
+                grid = pair["input"]
+                bridge.define_grid("__audit_input", grid)
+                output = bridge.eval_text("(__audit_rule __audit_input)")
+                assert output == pair["output"], (split, index, "authority/canonical disagreement")
+                rival = first_two_only(grid)
+                assert bridge.eval_text("(__audit_rival __audit_input)") == rival
+                differences = [[r, c, output[r][c], rival[r][c]] for r in range(len(grid))
+                               for c in range(len(grid[0])) if output[r][c] != rival[r][c]]
+                results.append({"split": split, "index": index, "input": grid,
+                                "authority_output": output, "rival_output": rival,
+                                "input_sha256": digest(grid), "authority_output_sha256": digest(output),
+                                "rival_output_sha256": digest(rival), "differences": differences,
+                                "marker_count": sum(v != 0 for row in grid for v in row),
+                                "generator_self_check": generator.self_check(grid)})
+        # A distinct lawful three-marker teaching input: reflect the query.
+        new_grid = [row[::-1] for row in record["test"][0]["input"]]
+        assert all(new_grid != pair["input"] for split in ("train", "test") for pair in record[split])
+        assert generator.self_check(new_grid) == []
+        markers = [(r, c) for r, row in enumerate(new_grid) for c, v in enumerate(row) if v]
+        assert len(markers) == 3
+        assert all(0 < r < len(new_grid)-1 and 0 < c < len(new_grid[0])-1 for r, c in markers)
+        assert all(abs(r-u) >= 3 or abs(c-v) >= 3 for i, (r, c) in enumerate(markers) for u, v in markers[i+1:])
+        bridge.define_grid("__audit_input", new_grid)
+        new_output = bridge.eval_text("(__audit_rule __audit_input)")
+        new_rival = bridge.eval_text("(__audit_rival __audit_input)")
+        assert new_rival == first_two_only(new_grid)
+        new_differences = [[r, c, new_output[r][c], new_rival[r][c]] for r in range(len(new_grid))
+                           for c in range(len(new_grid[0])) if new_output[r][c] != new_rival[r][c]]
+        assert len(new_differences) == 8
+        candidate_demo = {"input": new_grid, "output": new_output}
+        candidate_lesson = {"train": [candidate_demo] + record["train"][1:], "test": record["test"]}
+        assert len(candidate_lesson["train"]) == len(record["train"]) == 4
+        assert [first_two_only(pair["input"]) == pair["output"] for pair in candidate_lesson["train"]] == [False, True, True, True]
+    finally:
+        bridge.close()
+    demos = [row for row in results if row["split"] == "train"]
+    queries = [row for row in results if row["split"] == "test"]
+    assert len(demos) == 4 and all(row["marker_count"] == 2 and not row["differences"] for row in demos)
+    assert len(queries) == 1 and queries[0]["marker_count"] == 3 and len(queries[0]["differences"]) == 8
+    assert all(row["generator_self_check"] == [] for row in results)
+    report = {"schema": "arcpuzzles-bounded-learnability-probe-v1", "task_id": TASK,
+              "generator_sha256": source_hash,
+              "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "canonical_record_sha256": digest(record),
+              "rule_hash": hashlib.sha256(" ".join(rule.split()).encode()).hexdigest()[:12],
+              "rule_text_sha256": hashlib.sha256(rule.encode()).hexdigest(),
+              "rival_source_path": str(rival_path.relative_to(ROOT)),
+              "rival_source_sha256": hashlib.sha256(rival_path.read_bytes()).hexdigest(),
+              "rival_source": rival_rule,
+              "runtime_identity": identity,
+              "finding": "first-two-marker rival fits all four canonical demos and misses the third query ring",
+              "scope": "canonical lesson only; no claim that all generated lessons share this ambiguity",
+              "status": "reproduced_ambiguity_with_checked_unselected_teaching_proposal", "results": results,
+              "original_canonical_lesson": {"train": record["train"], "test": record["test"]},
+              "candidate_lesson": candidate_lesson,
+              "candidate_lesson_sha256": digest(candidate_lesson),
+              "candidate_demonstration": {"construction": "horizontal reflection of canonical query input",
+                  "replaces_original_train_index": 0, "input": new_grid, "authority_output": new_output,
+                  "rival_output": new_rival, "differences": new_differences,
+                  "marker_count": 3, "generator_self_check": [],
+                  "lawful_interior_disjoint_footprints": True, "distinct_from_all_original_inputs": True},
+              "racket_rival_python_agreement_count": 6,
+              "candidate_lesson_rival_demo_matches": 3,
+              "candidate_lesson_rival_refuted": True,
+              "proposal_status": "checked_example_unselected_no_canonical_or_generator_changes"}
+    target = ROOT.parent / "checks" / TASK / "learnability.json"
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"passed": True, "demos_matched": 4, "query_difference_cells": 8,
+                      "candidate_demo_difference_cells": 8, "candidate_lesson_demo_count": 4,
+                      "racket_python_rival_agreement_count": 6,
+                      "report": str(target.relative_to(ROOT.parent))}))
+
+
+if __name__ == "__main__":
+    main()
