+#!/usr/bin/env python3
+"""Bounded independent-axis midpoint rival check; no production changes."""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+ROOT = Path.cwd()
+PACKET = ROOT.parent.parent
+HOME = ROOT / 'generators/0a9e3d364bb3'
+SOURCE = HOME / 'generator.py'
+spec = importlib.util.spec_from_file_location('selected_axis_probe', SOURCE)
+g = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(g)
+
+def rival(grid, axis):
+    a = g._analyze(grid)
+    out = [r[:] for r in grid]
+    r1,c1,r2,c2 = a['bbox']
+    for r,c in a['marker_positions']:
+        qr = int(2*r > r1+r2) if axis == 'row' else int(2*r >= r1+r2)
+        qc = int(2*c > c1+c2) if axis == 'column' else int(2*c >= c1+c2)
+        out[r][c] = a['key_map'][qr,qc]
+    return out
+
+report = {'schema':'independent-midpoint-rival-probe/1', 'task_id':g.TASK_ID,
+          'generator_path':str(SOURCE.relative_to(PACKET)),
+          'generator_sha256':hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
+          'rule_hash':g.RULE_HASH, 'lessons_scanned':0,
+          'rivals':['row_midpoint_top_only','column_midpoint_left_only'],
+          'query_rival_checks':0, 'finding':None}
+for band in ('easy','medium','hard'):
+    for seed in range(2678160609,2678160673):
+        pairs = [{'input':g.generate(seed,i,difficulty=band)} for i in range(8)]
+        for p in pairs: p['output'] = g.rule_mirror(p['input'])
+        report['lessons_scanned'] += 1
+        for qi in (3,7):
+            demos = [p for i,p in enumerate(pairs) if i != qi]
+            for axis in ('row','column'):
+                report['query_rival_checks'] += 1
+                if all(rival(p['input'],axis)==p['output'] for p in demos) and rival(pairs[qi]['input'],axis)!=pairs[qi]['output']:
+                    report['finding']={'difficulty':band,'seed':seed,'sample_indices':list(range(8)),
+                        'query_index':qi,'axis':axis,'pairs':pairs,
+                        'rival_query_output':rival(pairs[qi]['input'],axis),
+                        'production_identifiability_reasons':g.lesson_identifiable(demos,pairs[qi]),
+                        'self_check_errors':[g.self_check(p['input']) for p in pairs]}
+                    break
+            if report['finding']: break
+        if report['finding']: break
+    if report['finding']: break
+if True:
+    checked_pairs = report['finding']['pairs'] if report['finding'] else pairs
+    report['racket_sample'] = {'difficulty':band,'seed':seed,'sample_indices':list(range(8)), 'scope':'found witness' if report['finding'] else 'last scanned lesson only'}
+    authority_path = ROOT / 'shared/data/base/solutions/training/58743b76__0a9e3d364bb3.json'
+    authority = json.loads(authority_path.read_text())['racket_target']['target_code']
+    report['authority_path'] = str(authority_path.relative_to(PACKET))
+    report['authority_file_sha256'] = hashlib.sha256(authority_path.read_bytes()).hexdigest()
+    report['authority_code_sha256'] = hashlib.sha256(authority.encode()).hexdigest()
+    bridge = RacketBridge()
+    try:
+        parity=[]
+        for p in checked_pairs:
+            literal="'("+' '.join('('+' '.join(map(str,row))+')' for row in p['input'])+')'
+            output=bridge.eval_text('('+wrap_rule(authority)+' '+literal+')')
+            parity.append(output==p['output'])
+            p['output']=output
+        report['racket_parity']=parity
+        assert all(parity), parity
+    finally: bridge.close()
+report['probe_path']=str(Path(__file__).resolve().relative_to(PACKET))
+report['probe_sha256']=hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+out=ROOT.parent/'checks/0a9e3d364bb3/axis-midpoint.json'
+out.write_text(json.dumps(report,indent=2,sort_keys=True)+'\n')
+print(json.dumps({k:v for k,v in report.items() if k!='finding'},sort_keys=True))
+print('finding:', None if not report['finding'] else {k:v for k,v in report['finding'].items() if k not in ('pairs','rival_query_output')})
