+"""Bounded protected-Racket peer probe for template-zero semantics.
+
+From the packet root:
+  WORK/.venv/bin/python review.py run python \
+    generators/e9399a9f5b3b/workspace/peer_wildcard_probe.py \
+    --out ../checks/e9399a9f5b3b/wildcard-peer.json
+
+This is a finite two-rule audit, not parametric qualification or acceptance.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+
+TASK_ID = "e9399a9f5b3b"
+ROOT = Path(__file__).resolve().parents[3]
+GENERATOR = ROOT / "generators" / TASK_ID / "generator.py"
+RUNTIME = ROOT / "shared/runtime"
+WINDOW_SEEDS = tuple(range(16))
+START_INDEX = 1200
+
+
+def digest_bytes(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    catalog = Catalog(ROOT)
+    selected = catalog.describe(TASK_ID)
+    rule_task_id = selected.get("rule_task_id", TASK_ID)
+    variants = catalog._variants()[rule_task_id]
+    programs = {variant["program_solution"] for variant in variants}
+    assert len(programs) == 1, "Canonical rule must be unambiguous"
+    canonical = next(iter(programs))
+    wildcard_clause = "(or (= tv 0) (= (at board (+ r (first p)) (+ c (second p))) tv))"
+    exact_clause = "(= (at board (+ r (first p)) (+ c (second p))) tv)"
+    assert canonical.count(wildcard_clause) == 1
+    exact_background = canonical.replace(wildcard_clause, exact_clause)
+    program_map = {"canonical_wildcard": canonical, "exact_background": exact_background}
+    report = {
+        "schema": "arcpuzzles-bounded-peer-probe-v1",
+        "task_id": TASK_ID,
+        "rule_task_id": rule_task_id,
+        "source": {
+            "generator_path": str(GENERATOR.relative_to(ROOT)),
+            "generator_sha256": digest_bytes(GENERATOR.read_bytes()),
+            "probe_path": str(Path(__file__).resolve().relative_to(ROOT)),
+            "probe_sha256": digest_bytes(Path(__file__).read_bytes()),
+            "canonical_program_sha256": digest_bytes(canonical.encode()),
+            "canonical_variant_identities": [
+                {key: variant.get(key) for key in
+                 ("task_id", "source", "bank", "original_id", "content_hash", "slug")}
+                for variant in variants
+            ],
+        },
+        "programs": {
+            name: {"program": program, "sha256": digest_bytes(program.encode())}
+            for name, program in program_map.items()
+        },
+        "scope": {
+            "rivals": ["exact_background"],
+            "canonical_variants": len(variants),
+            "generated_seed_budget": list(WINDOW_SEEDS),
+            "difficulty": "medium",
+            "demo_indices": list(range(START_INDEX, START_INDEX + 4)),
+            "query_index": START_INDEX + 4,
+            "stopping_rule": "Stop generated windows at the first demo-fit/query-disagreement witness, or after 16 seeds.",
+            "no_universal_identifiability_claim": True,
+            "acceptance_or_training_admission_performed": False,
+        },
+        "canonical_episodes": [],
+        "generated_episodes": [],
+    }
+    executions = 0
+    with _local_imports(RUNTIME, GENERATOR.parent):
+        spec = importlib.util.spec_from_file_location("peer_template_generator", GENERATOR)
+        gen = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(gen)
+        apply_program, identity, bridge = _real_evaluator(RUNTIME)
+        report["racket"] = identity
+        try:
+            def case(grid, *, split, index, expected=None):
+                nonlocal executions
+                outputs = {}
+                for name, program in program_map.items():
+                    outputs[name] = apply_program(program, grid)
+                    executions += 1
+                if expected is not None:
+                    assert outputs["canonical_wildcard"] == expected, "Stored label disagrees with canonical Racket"
+                return {
+                    "split": split, "index": index, "input": grid,
+                    "output": outputs["canonical_wildcard"],
+                    "outputs": outputs,
+                    "self_check": gen.self_check(grid),
+                    "rival_agrees": outputs["exact_background"] == outputs["canonical_wildcard"],
+                }
+
+            def episode(cases, metadata):
+                demos = [item for item in cases if item["split"] == "train"]
+                queries = [item for item in cases if item["split"] == "test"]
+                fit = all(item["rival_agrees"] for item in demos)
+                disagreements = [item["index"] for item in queries if not item["rival_agrees"]]
+                return {
+                    **metadata, "cases": cases,
+                    "rival_fits_all_demos": fit,
+                    "query_disagreement_indices": disagreements,
+                    "teaching_hole": fit and bool(disagreements),
+                    "existing_lesson_identifiable": gen.lesson_identifiable(
+                        [{"input": item["input"], "output": item["output"]} for item in demos],
+                        {"input": queries[0]["input"], "output": queries[0]["output"]},
+                    ),
+                }
+
+            for variant_index, variant in enumerate(variants):
+                cases = [case(pair["input"], split="train", index=index, expected=pair.get("output"))
+                         for index, pair in enumerate(variant["train"])]
+                tests = variant["test"] if isinstance(variant["test"], list) else [variant["test"]]
+                cases += [case(pair["input"], split="test", index=index, expected=pair.get("output"))
+                          for index, pair in enumerate(tests)]
+                report["canonical_episodes"].append(episode(cases, {"variant_index": variant_index}))
+
+            for seed in WINDOW_SEEDS:
+                cases = [
+                    case(gen.generate(seed, index, difficulty="medium"),
+                         split="train" if index < START_INDEX + 4 else "test", index=index)
+                    for index in range(START_INDEX, START_INDEX + 5)
+                ]
+                current = episode(cases, {"seed": seed, "difficulty": "medium"})
+                assert all(not item["self_check"] for item in cases)
+                report["generated_episodes"].append(current)
+                if current["teaching_hole"]:
+                    break
+        finally:
+            bridge.close()
+    holes = [
+        {"source": source, **{key: item[key] for key in ("seed", "variant_index") if key in item}}
+        for source in ("canonical_episodes", "generated_episodes")
+        for item in report[source] if item["teaching_hole"]
+    ]
+    report["summary"] = {
+        "outcome": "teaching_hole_found" if holes else "no_issue_within_finite_scope",
+        "teaching_holes": holes,
+        "generated_windows_executed": len(report["generated_episodes"]),
+        "racket_evaluations": executions,
+        "generator_source_unchanged_during_probe": digest_bytes(GENERATOR.read_bytes()) == report["source"]["generator_sha256"],
+    }
+    assert report["summary"]["generator_source_unchanged_during_probe"]
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"evidence": str(args.out), **report["summary"]}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
