+#!/usr/bin/env python3
+"""Replay one retained default episode against the border-only rotation rival."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK_ID = "88b8e6aaa49d"
+ROOT = Path(__file__).resolve().parents[3]
+HOME = ROOT / "generators" / TASK_ID
+RETAINED = HOME / "evidence/parametric-acceptance/3b01bb1c8999648b9e20523a3bf275dbeaa44238a1e352b8cda11fb9ac841318/execution.json"
+RIVAL = """(rule! (lambda (g)
+  (grid-from-fn (rows g) (cols g)
+    (lambda (r c)
+      (if (or (= r 0) (= c 0)
+              (= r (- (rows g) 1)) (= c (- (cols g) 1)))
+          (cell-at g (- (rows g) 1 r) (- (cols g) 1 c))
+          (cell-at g r c))))))"""
+
+
+def sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(f"Use a new evidence path: {args.out}")
+
+    catalog = Catalog(ROOT)
+    rule_task_id = catalog.describe(TASK_ID).get("rule_task_id", TASK_ID)
+    programs = {v["program_solution"] for v in catalog._variants()[rule_task_id]}
+    assert len(programs) == 1, "Canonical authority must be unambiguous"
+    canonical = programs.pop()
+    retained = json.loads(RETAINED.read_text())
+    episode = next(e for e in retained["episodes"]
+                   if e["seed"] == 0 and e["settings"] == {"quarter_turns": 2})
+    assert episode["program"] == canonical
+    pairs = episode["train"] + episode["test"][:1]
+    assert len(episode["train"]) == 3 and len(pairs) == 4
+
+    runtime = ROOT / "shared/runtime"
+    with _local_imports(runtime, HOME / "workspace"):
+        spec = importlib.util.spec_from_file_location("peer_rotation_generator", HOME / "generator.py")
+        generator = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(generator)
+        for index, pair in enumerate(pairs):
+            assert generator.generate(0, index) == pair["input"], "Retained inputs are stale"
+            assert generator.self_check(pair["input"]) == []
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            checks = []
+            for index, pair in enumerate(pairs):
+                actual = apply(canonical, pair["input"])
+                rival = apply(RIVAL, pair["input"])
+                assert actual == pair["output"], "Retained label differs from the live authority"
+                differing_cells = [
+                    [r, c] for r, row in enumerate(actual)
+                    for c, value in enumerate(row) if value != rival[r][c]
+                ]
+                checks.append({
+                    "split": "train" if index < 3 else "test",
+                    "index": index if index < 3 else 0,
+                    "sample_index": index,
+                    "shape": [len(pair["input"]), len(pair["input"][0])],
+                    "input": pair["input"],
+                    "canonical_output": actual,
+                    "rival_output": rival,
+                    "matches_canonical": not differing_cells,
+                    "differing_cells_zero_based": differing_cells,
+                })
+        finally:
+            bridge.close()
+
+    demo_fit = all(row["matches_canonical"] for row in checks[:3])
+    query_disagreement = not checks[3]["matches_canonical"]
+    assert demo_fit and query_disagreement, "The proposed teaching-gap witness did not reproduce"
+    paths = [HOME / "generator.py", HOME / "workspace/parametric/adapter.py",
+             HOME / "workspace/parametric/prototype.py", HOME / "workspace/parametric/promotion.json",
+             RETAINED, Path(__file__).resolve()]
+    result = {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "task_id": TASK_ID,
+        "outcome": "finding",
+        "finding": "Outer-border-only rotation fits every visible demo but disagrees on the first query.",
+        "source_sha256": sha((HOME / "generator.py").read_bytes()),
+        "source_inventory": {str(p.relative_to(ROOT)): sha(p.read_bytes()) for p in paths},
+        "episode": {"seed": 0, "settings": {"quarter_turns": 2}, "demos": 3,
+                    "query_index": 0, "sample_indices": [0, 1, 2, 3],
+                    "origin": str(RETAINED.relative_to(ROOT)), "fresh_generator_input_replay": True},
+        "canonical": {"rule_task_id": rule_task_id, "program": canonical,
+                      "program_sha256": sha(canonical.encode())},
+        "rival": {"name": "rotate_outer_border_180_keep_interior",
+                  "program": RIVAL, "program_sha256": sha(RIVAL.encode()),
+                  "fits_all_visible_demos": demo_fit, "disagrees_on_query": query_disagreement},
+        "racket": identity,
+        "protected_racket_evaluations": 8,
+        "checks": checks,
+        "explanation": "Every 3x3 cell is either on the border or the fixed center. The first 4x5 query has a 2x3 interior that the border-only rule incorrectly preserves.",
+        "recommended_repair": "Include an interior-distinguishing rectangular or larger-square demonstration before the first such query, retaining the demo count; explicitly check this rival.",
+        "limits": ["One retained default episode, one seed, one named rival, first query only.",
+                   "The finding does not claim universal ambiguity or assess other parameter settings.",
+                   "No generator, adapter, authority, acceptance record, or training-admission change."],
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"outcome": result["outcome"], "rival": result["rival"]["name"],
+                      "fits_all_visible_demos": demo_fit, "disagrees_on_query": query_disagreement,
+                      "query_differing_cells": checks[3]["differing_cells_zero_based"],
+                      "protected_racket_evaluations": 8, "evidence": str(args.out)}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
