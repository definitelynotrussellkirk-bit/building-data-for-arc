+"""Focused regressions for the retained seed-9 wildcard teaching hole."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+
+TASK_HOME = Path(__file__).resolve().parents[1]
+ROOT = TASK_HOME.parents[1]
+WITNESS = json.loads((TASK_HOME / "counterexamples/wildcard-lesson.json").read_text())
+
+
+@pytest.fixture(scope="module")
+def runtime():
+    runtime_path = ROOT / "shared/runtime"
+    with _local_imports(runtime_path, TASK_HOME):
+        spec = importlib.util.spec_from_file_location("wildcard_test_generator", TASK_HOME / "generator.py")
+        gen = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(gen)
+        apply_program, identity, bridge = _real_evaluator(runtime_path)
+        assert identity["backend"] == "racket" and identity["protected"] is True
+        try:
+            yield gen, apply_program
+        finally:
+            bridge.close()
+
+
+def test_seed9_scheduled_demos_exclude_exact_background_rule(runtime):
+    """Random marker placement must not leave all four demos ambiguous."""
+    gen, apply_program = runtime
+    canonical = WITNESS["programs"]["canonical_wildcard"]["program"]
+    rival = WITNESS["programs"]["exact_background"]["program"]
+    disagreements = []
+    for index in range(1200, 1204):
+        grid = gen.generate(9, index, difficulty="medium")
+        assert gen.self_check(grid) == []
+        truth = apply_program(canonical, grid)
+        assert gen.rule_mirror(grid) == truth
+        disagreements.append(apply_program(rival, grid) != truth)
+    assert any(disagreements), "Every demo still fits the exact-background rival"
+
+
+def test_lesson_checker_rejects_retained_wildcard_ambiguity(runtime):
+    """The checker must detect the omitted rival on the exact old grids."""
+    gen, _ = runtime
+    cases = WITNESS["episode"]["cases"]
+    demos = [{"input": case["input"], "output": case["output"]}
+             for case in cases if case["split"] == "train"]
+    query = next(case for case in cases if case["split"] == "test")
+    reasons = gen.lesson_identifiable(demos, query)
+    assert any("exact_template_background" in reason for reason in reasons), reasons
