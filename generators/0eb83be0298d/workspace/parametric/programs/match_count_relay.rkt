(rule!
  (let ((dummy 0))
    (define (split-cols-9 grid)
      (let loop ((c 0) (start 0) (acc (list)))
        (cond
          ((>= c (cols grid))
           (reverse
            (if (< start (cols grid))
                (cons (subgrid grid 0 start (- (rows grid) 1) (- (cols grid) 1)) acc)
                acc)))
          ((all? (lambda (r) (= (at grid r c) 9)) (range 0 (rows grid)))
           (let scan ((cc c))
             (if (and (< cc (cols grid))
                      (all? (lambda (r) (= (at grid r cc) 9)) (range 0 (rows grid))))
                 (scan (+ cc 1))
                 (loop cc cc
                       (if (< start c)
                           (cons (subgrid grid 0 start (- (rows grid) 1) (- c 1)) acc)
                           acc)))))
          (else (loop (+ c 1) start acc)))))
    (define (crop-nonzero grid)
      (let ((cells
             (filter
              (lambda (p)
                (let ((v (at grid (first p) (second p))))
                  (and (not (= v 0)) (not (= v 9)))))
              (grid-positions grid))))
        (if (empty? cells)
            (grid (list 0))
            (let ((bb (bbox-of-cells cells)))
              (subgrid grid (first bb) (second bb) (third bb) (fourth bb))))))
    (define (match-at? board template r c)
      (all?
       (lambda (p)
         (let ((tv (at template (first p) (second p))))
           (or (= tv 0)
               (= (at board (+ r (first p)) (+ c (second p))) tv))))
       (grid-positions template)))
    (define (find-matches board template)
      (for*/list
       ((r (in-range 0 (+ 1 (- (rows board) (rows template)))))
        (c (in-range 0 (+ 1 (- (cols board) (cols template)))))
        #:when (match-at? board template r c))
       (list r c template)))
    (define (render-board h w cells (color 8))
      (paint-cells
       (empty-grid h w 0)
       (filter (lambda (p) (in-bounds? (first p) (second p) h w))
               (remove-duplicates cells))
       color))
    (let* ((panels (split-cols-9 g))
           (template (crop-nonzero (first panels)))
           (board (second panels))
           (matches (find-matches board template))
           (out
            (render-board
             (rows board) (cols board)
             (map (lambda (m)
                    (list (+ (first m) (rows (third m)) -1)
                          (+ (second m) (cols (third m)) -1)))
                  matches)
             8))
           (anchors
            (filter (lambda (p) (= (at board (first p) (second p)) 6))
                    (grid-positions board)))
           (target (list-ref anchors (- (length matches) 1))))
      (set-cell out (first target) (second target) 8))))