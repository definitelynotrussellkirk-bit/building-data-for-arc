(rule!
 ;; Alternate order: frames (top-left order) choose the first unused
 ;; top-left loose shape that fits. Orientation preference and centering stay
 ;; identical to the canonical family.
 (lambda (g)
   (let ()
     (define (obj< a b)
       (if (= (obj-r1 a) (obj-r1 b))
           (< (obj-c1 a) (obj-c1 b))
           (< (obj-r1 a) (obj-r1 b))))
     (define (object-grid obj)
       (paint-cells (empty-grid (obj-h obj) (obj-w obj) 0)
                    (normalize-cells (obj-cells obj))
                    (obj-color obj)))
     (define (stamp out sub tr tc)
       (foldl (lambda (cell acc)
                (let ((r (+ tr (first cell))) (c (+ tc (second cell))))
                  (if (and (not (= (third cell) 0))
                           (in-bounds? r c (rows acc) (cols acc)))
                      (set-cell acc r c (third cell))
                      acc)))
              out (grid-cells sub)))
     (define (rect-frame? obj)
       (and (>= (obj-h obj) 3) (>= (obj-w obj) 3)
            (= (obj-size obj)
               (- (* 2 (+ (obj-h obj) (obj-w obj))) 4))
            (all? (lambda (c) (and (= (at g (obj-r1 obj) c)
                                      (obj-color obj))
                                   (= (at g (obj-r2 obj) c)
                                      (obj-color obj))))
                  (range (obj-c1 obj) (+ (obj-c2 obj) 1)))
            (all? (lambda (r) (and (= (at g r (obj-c1 obj))
                                      (obj-color obj))
                                   (= (at g r (obj-c2 obj))
                                      (obj-color obj))))
                  (range (obj-r1 obj) (+ (obj-r2 obj) 1)))))
     (define (fit-shape entry frame)
       ;; (shape-index oriented-shape) or #f. Original orientation wins.
       (let* ((obj (second entry))
              (og (object-grid obj))
              (rot (rotate-cw og))
              (ih (- (obj-h frame) 2))
              (iw (- (obj-w frame) 2))
              (fit (cond ((and (<= (rows og) ih) (<= (cols og) iw)) og)
                         ((and (<= (rows rot) ih) (<= (cols rot) iw)) rot)
                         (else #f))))
         (and fit (list (first entry) fit))))
     (define all-objs (objects g 0))
     (define frames (sort (filter rect-frame? all-objs) obj<))
     (define solids
       (sort (filter (lambda (o) (not (rect-frame? o))) all-objs) obj<))
     (define indexed-solids (enumerate-list solids))
     (define initial
       (for/fold ((o (empty-grid h w 0))) ((f (in-list frames)))
         (paint-cells o (obj-cells f) (obj-color f))))
     (let assign-frames ((remaining frames) (used (list)) (out initial))
       (if (empty? remaining)
           out
           (let* ((frame (first remaining))
                  (cands
                   (filter (lambda (x) x)
                           (map (lambda (entry)
                                  (and (not (member (first entry) used))
                                       (fit-shape entry frame)))
                                indexed-solids))))
             (if (empty? cands)
                 (assign-frames (rest remaining) used out)
                 (let* ((hit (first cands))
                        (sub (second hit))
                        (tr (+ (obj-r1 frame) 1
                               (quotient (- (- (obj-h frame) 2) (rows sub)) 2)))
                        (tc (+ (obj-c1 frame) 1
                               (quotient (- (- (obj-w frame) 2) (cols sub)) 2))))
                   (assign-frames (rest remaining) (cons (first hit) used)
                                  (stamp out sub tr tc))))))))))
