@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Reproduce a rectangle overwrite-order ambiguity with protected Racket labels."""
+from __future__ import annotations
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[3]
+TASK_ID = "cef69adb634e"
+GENERATOR = REPO / "generators" / TASK_ID / "generator.py"
+OUT = HERE / "evidence.json"
+
+spec = importlib.util.spec_from_file_location("peer_cef_generator", GENERATOR)
+assert spec and spec.loader
+module = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = module
+spec.loader.exec_module(module)
+
+canonical = Catalog(REPO)._variants()[TASK_ID][0]["program_solution"]
+needle = "(list 2 3 4)"
+assert needle in canonical
+rival = canonical.replace(needle, "(list 4 3 2)", 1)
+inputs = [module.generate(17, index) for index in range(5)]
+
+apply, racket, bridge = _real_evaluator(REPO / "shared" / "runtime")
+try:
+    canonical_outputs = [apply(canonical, grid) for grid in inputs]
+    rival_outputs = [apply(rival, grid) for grid in inputs]
+finally:
+    bridge.close()
+
+assert canonical_outputs[:4] == rival_outputs[:4]
+assert canonical_outputs[4] != rival_outputs[4]
+diffs = [
+    [row, col, canonical_outputs[4][row][col], rival_outputs[4][row][col]]
+    for row in range(len(canonical_outputs[4]))
+    for col in range(len(canonical_outputs[4][0]))
+    if canonical_outputs[4][row][col] != rival_outputs[4][row][col]
+]
+report = {
+    "schema": "arcpuzzles-peer-learnability-counterexample-v1",
+    "task_id": TASK_ID,
+    "finding": "Painting rectangle outlines in reverse color order (4,3,2 instead of 2,3,4) fits all four visible demonstrations but changes the query where outlines intersect.",
+    "scope": "One bounded seed-17, sample-index 0..4 lesson; this is not a universal audit.",
+    "generator_sha256": hashlib.sha256(GENERATOR.read_bytes()).hexdigest(),
+    "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+    "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+    "racket": racket,
+    "seed": 17,
+    "demo_sample_indices": [0, 1, 2, 3],
+    "query_sample_index": 4,
+    "canonical_program": canonical,
+    "rival_program": rival,
+    "train": [
+        {"input": grid, "canonical_output": c, "rival_output": r}
+        for grid, c, r in zip(inputs[:4], canonical_outputs[:4], rival_outputs[:4])
+    ],
+    "query": {
+        "input": inputs[4],
+        "canonical_output": canonical_outputs[4],
+        "rival_output": rival_outputs[4],
+        "different_cells": diffs,
+    },
+    "recommended_repair": "Guarantee at least one visible demonstration with intersecting outlines whose intersection exposes the 2→3→4 overwrite order; preserve four demonstrations if that is the lesson contract.",
+}
+OUT.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+print(json.dumps({"status": "reproduced", "task_id": TASK_ID, "out": str(OUT), "demo_fit": True, "query_diff_cells": len(diffs)}, indent=2))
