@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""Reproduce a command-map ambiguity with protected Racket labels."""
+from __future__ import annotations
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[3]
+TASK_ID = "c868b0210c96"
+GENERATOR = REPO / "generators" / TASK_ID / "generator.py"
+OUT = HERE / "evidence.json"
+
+spec = importlib.util.spec_from_file_location("peer_c868_generator", GENERATOR)
+assert spec and spec.loader
+module = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = module
+spec.loader.exec_module(module)
+
+canonical = Catalog(REPO)._variants()[TASK_ID][0]["program_solution"]
+needle = "[(= cmd 2) (rotate-180 grid)]"
+assert needle in canonical
+rival = canonical.replace(needle, "[(= cmd 2) (rotate-cw grid)]", 1)
+inputs = [module.generate(1, index) for index in range(4)]
+assert [grid[0][1] for grid in inputs] == [4, 4, 0, 2]
+
+apply, racket, bridge = _real_evaluator(REPO / "shared" / "runtime")
+try:
+    canonical_outputs = [apply(canonical, grid) for grid in inputs]
+    rival_outputs = [apply(rival, grid) for grid in inputs]
+finally:
+    bridge.close()
+
+assert canonical_outputs[:3] == rival_outputs[:3]
+assert canonical_outputs[3] != rival_outputs[3]
+report = {
+    "schema": "arcpuzzles-peer-learnability-counterexample-v1",
+    "task_id": TASK_ID,
+    "finding": "The three visible demonstrations use only commands 4, 4, and 0. A rival that interprets unseen command 2 as rotate-cw instead of rotate-180 fits every demonstration but changes the query.",
+    "scope": "One bounded seed-1, sample-index 0..3 lesson; this is not a universal audit.",
+    "generator_sha256": hashlib.sha256(GENERATOR.read_bytes()).hexdigest(),
+    "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+    "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+    "racket": racket,
+    "seed": 1,
+    "demo_sample_indices": [0, 1, 2],
+    "query_sample_index": 3,
+    "demo_commands": [grid[0][1] for grid in inputs[:3]],
+    "query_command": inputs[3][0][1],
+    "canonical_program": canonical,
+    "rival_program": rival,
+    "train": [
+        {"input": grid, "canonical_output": c, "rival_output": r}
+        for grid, c, r in zip(inputs[:3], canonical_outputs[:3], rival_outputs[:3])
+    ],
+    "query": {
+        "input": inputs[3],
+        "canonical_output": canonical_outputs[3],
+        "rival_output": rival_outputs[3],
+        "different": True,
+    },
+    "recommended_repair": "Assemble lessons so every query command is demonstrated on an asymmetric selected panel, or explicitly constrain/admit command-map alternatives rather than relying on an unseen numeric code.",
+}
+OUT.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+print(json.dumps({"status": "reproduced", "task_id": TASK_ID, "out": str(OUT), "demo_fit": True, "query_diff": True}, indent=2))
