+#!/usr/bin/env python3
+"""Reproducible curriculum/shortcut census and independent Racket parity probe.
+
+Normal checkout (from repo):
+  python generators/ee1c3a11982c/workspace/review_probe.py --out ../checks/census.json
+Use --generator to compare the immutable baseline without copying a repository.
+Use --runtime-root with a staged runtime to exercise an independent relocation.
+Reports bind the actual source, seed/index ranges, and unique-input denominator.
+Exit 1 means a real parity/validation error; baseline shortcut survival is data.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import itertools
+import json
+from pathlib import Path
+import random
+import sys
+import types
+
+TASK = 'ee1c3a11982c'
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def encode(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':')).encode()
+
+
+def sources(grid):
+    return [(r, c, v) for r, row in enumerate(grid) for c, v in enumerate(row) if v]
+
+
+def paint(grid):
+    """Source-centric oracle, independent of the generator's prefix scan."""
+    height, width = len(grid), len(grid[0])
+    out = [[0]*width for _ in range(height)]
+    for r, c, color in sources(grid):
+        for cc in range(c, width):
+            out[r][cc] = color
+        for rr in range(r, height):
+            out[rr][-1] = color
+    return out
+
+
+def rival(grid, kind):
+    if kind == 'right_only':
+        out = [[0]*len(row) for row in grid]
+        for r, c, v in sources(grid):
+            out[r][c:] = [v]*(len(grid[0])-c)
+        return out
+    seen = set()
+    pruned = [[0]*len(row) for row in grid]
+    for r, c, v in sources(grid):
+        key = r if kind == 'leftmost_source_per_row' else v
+        if key not in seen:
+            pruned[r][c] = v
+            seen.add(key)
+    return paint(pruned)
+
+
+RIVALS = ('leftmost_source_per_row', 'one_source_per_color', 'right_only')
+
+
+def compact(grid):
+    cells = sources(grid)
+    return (3 <= len(grid) <= 8 and 3 <= len(grid[0]) <= 8
+            and 1 <= len(cells) <= 3 and not any(grid[-1]) and not any(r[-1] for r in grid)
+            and len({r for r, c, v in cells}) == len(cells)
+            and len({v for r, c, v in cells}) == len(cells))
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--generator', type=Path)
+    parser.add_argument('--runtime-root', type=Path)
+    parser.add_argument('--canonical', type=Path)
+    parser.add_argument('--seeds', type=int, default=200)
+    parser.add_argument('--indices', type=int, default=12)
+    parser.add_argument('--racket-samples', type=int, default=0)
+    parser.add_argument('--exhaustive', action='store_true', help='also execute all 81 interior 3x3 ternary grids')
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.seeds < 1 or args.indices < 3 or args.racket_samples < 0:
+        parser.error('require seeds>=1, indices>=3, racket-samples>=0')
+    if args.runtime_root:
+        root = args.runtime_root.resolve()
+        support = [root, root/'scripts']
+        default_generator = root/f'puzzle_generators/per_puzzle/{TASK}/generator.py'
+        default_canonical = root/'data/canonical/puzzles.jsonl'
+    else:
+        root = Path(__file__).resolve().parents[3]
+        support = [root/'shared/runtime', root/'shared/tools']
+        default_generator = root/f'generators/{TASK}/generator.py'
+        default_canonical = root/'shared/data/canonical/puzzles.jsonl'
+    for path in support:
+        sys.path.insert(0, str(path))
+    if not args.runtime_root:
+        # Shared legacy helpers import scripts.*, while the source checkout
+        # stores them at shared/tools. A local-only namespace adapter avoids
+        # borrowing a sibling checkout or modifying shared code.
+        package = types.ModuleType('scripts')
+        package.__path__ = [str(root/'shared/tools')]
+        sys.modules.setdefault('scripts', package)
+    source = (args.generator or default_generator).resolve()
+    spec = importlib.util.spec_from_file_location('curriculum_subject', source)
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    canonical_path = args.canonical or default_canonical
+    record = next(json.loads(line) for line in canonical_path.open()
+                  if json.loads(line).get('task_id') == TASK)
+    pairs = record['train'] + record['test']
+    result = {
+        'schema': 'ee1c3a11982c-curriculum-probe-v1',
+        'task_id': TASK, 'generator_sha256': sha(source.read_bytes()),
+        'probe_sha256': sha(Path(__file__).read_bytes()),
+        'rule_sha256': sha(record['program_solution'].encode()),
+        'seed_range_inclusive': [0, args.seeds-1], 'sample_index_range_inclusive': [0, args.indices-1],
+        'bands': {}, 'failures': [], 'first_counterexamples': {},
+        'canonical_pairs': len(pairs),
+        'canonical_rival_matches': {name: sum(rival(p['input'], name) == p['output'] for p in pairs) for name in RIVALS},
+    }
+    pool = []
+    global_unique = set()
+    input_stream = hashlib.sha256()
+    for band in ('easy', 'medium', 'hard'):
+        stats = Counter()
+        shapes, palettes, counts, profile_counts = Counter(), Counter(), Counter(), Counter()
+        unique = set()
+        for seed in range(args.seeds):
+            grids = []
+            for index in range(args.indices):
+                stats['attempts'] += 1
+                try:
+                    grid = generator.generate(seed, index, difficulty=band)
+                    errors = generator.self_check(grid)
+                    if errors:
+                        result['failures'].append({'band': band, 'seed': seed, 'index': index, 'errors': errors, 'input': grid})
+                    if grid != generator.generate(seed, index, difficulty=band):
+                        result['failures'].append({'band': band, 'seed': seed, 'index': index, 'error': 'nondeterministic'})
+                except Exception as exc:
+                    result['failures'].append({'band': band, 'seed': seed, 'index': index, 'exception': repr(exc)})
+                    grids.append(None)
+                    continue
+                grids.append(grid)
+                pool.append((band, seed, index, grid))
+                digest = sha(encode(grid))
+                unique.add(digest)
+                global_unique.add(digest)
+                input_stream.update(encode([band, seed, index, digest])+b'\n')
+                stats['generated'] += 1
+                stats['compact_canonical_like'] += compact(grid)
+                stats['shape_3x3'] += len(grid) == len(grid[0]) == 3
+                cells = sources(grid)
+                counts[str(len(cells))] += 1
+                palettes[str(len({v for _, _, v in cells}))] += 1
+                shapes[f'{len(grid)}x{len(grid[0])}'] += 1
+                if hasattr(generator, 'schedule_profile'):
+                    profile_counts[generator.schedule_profile(seed, index, band)] += 1
+                expected = paint(grid)
+                for name in RIVALS:
+                    other = rival(grid, name)
+                    if other != expected:
+                        stats['refutes_'+name] += 1
+                        result['first_counterexamples'].setdefault(name, {'band': band, 'seed': seed, 'sample_index': index,
+                                                                          'input': grid, 'expected_python': expected, 'rival_output': other})
+            for start in range(args.indices-2):
+                lesson = grids[start:start+3]
+                stats['overlapping_three_demo_windows'] += 1
+                if any(grid is None for grid in lesson):
+                    continue
+                stats['windows_refuting_all_named_rivals'] += all(
+                    any(rival(grid, name) != paint(grid) for grid in lesson) for name in RIVALS)
+        result['bands'][band] = {**stats, 'unique_inputs': len(unique), 'shape_histogram': dict(sorted(shapes.items())),
+                                 'seed_count_histogram': dict(counts), 'palette_size_histogram': dict(palettes),
+                                 'profile_histogram': dict(profile_counts)}
+    result['total_draws'] = len(pool)
+    result['unique_inputs_across_bands'] = len(global_unique)
+    result['ordered_input_stream_sha256'] = input_stream.hexdigest()
+    result['denominator_note'] = 'Unique input counts deduplicate grids, not seed labels. Three-demo windows overlap and are not independent inputs.'
+    # Check the old edge-bias defect without a dimension/count override masking it.
+    result['edge_priority_min_distance'] = []
+    for seed in range(12):
+        r, c = generator._layout_cells('scattered', 7, 7, 'edge', random.Random(seed))[0]
+        result['edge_priority_min_distance'].append(min(r, c, 6-r, 6-c))
+    result['authority_checks'] = {'requested_generated': args.racket_samples, 'executed': 0, 'matched': 0}
+    if args.racket_samples or args.exhaustive:
+        from coder_synth_verify import ProgramVerifier
+        targets = [('canonical', i, p['input'], p['output']) for i, p in enumerate(pairs)]
+        count = min(args.racket_samples, len(pool))
+        for i in range(count):
+            band, seed, index, grid = pool[i*len(pool)//count]
+            targets.append(('generated', [band, seed, index], grid, paint(grid)))
+        if args.exhaustive:
+            for i, colors in enumerate(itertools.product(range(3), repeat=4)):
+                grid = [[colors[0], colors[1], 0], [colors[2], colors[3], 0], [0, 0, 0]]
+                targets.append(('exhaustive_interior_3x3', i, grid, paint(grid)))
+        # Explicit question fixtures are independent of default sampling frequency.
+        for name, grid in [('same_row', [[0,0,0,0],[1,0,2,0],[0,0,0,0],[0,0,0,0]]),
+                           ('repeated', [[0,3,0,0],[0,0,0,0],[3,0,0,0],[0,0,0,0]]),
+                           ('short_line', [[0]*5,[0,2,2,2,0],[0]*5,[0]*5,[0]*5]),
+                           ('solid_2x2', [[0]*5,[0,2,2,0,0],[0,2,2,0,0],[0]*5,[0]*5])]:
+            targets.append(('question_fixture', name, grid, paint(grid)))
+        checked = Counter()
+        with ProgramVerifier() as verifier:
+            for group, ident, grid, expected in targets:
+                try:
+                    actual = verifier.apply(record['program_solution'], grid)
+                except Exception as exc:
+                    result['failures'].append({'group': group, 'id': ident, 'input': grid, 'error': repr(exc)})
+                    continue
+                result['authority_checks']['executed'] += 1
+                checked[group] += 1
+                result['authority_checks']['matched'] += actual == expected
+                if actual != expected:
+                    result['failures'].append({'group': group, 'id': ident, 'input': grid, 'expected': expected, 'actual': actual})
+                if group == 'question_fixture':
+                    result.setdefault('question_fixtures', {})[ident] = {
+                        'input': grid, 'racket_output': actual, 'self_check_errors': generator.self_check(grid),
+                        'rival_outputs': {name: rival(grid, name) for name in RIVALS}}
+            # Save even failed parity runs before any later exception can occur.
+            args.out.parent.mkdir(parents=True, exist_ok=True)
+            args.out.write_text(json.dumps(result, indent=2)+'\n')
+            for example in result['first_counterexamples'].values():
+                example['racket_output'] = verifier.apply(record['program_solution'], example['input'])
+                example['racket_verified'] = example['racket_output'] == example['expected_python']
+                if not example['racket_verified']:
+                    result['failures'].append({'error': 'counterexample parity', 'example': example})
+            result['authority_checks']['runtime_identity'] = verifier.bridge.runtime_identity
+        result['authority_checks']['groups'] = dict(checked)
+        result['authority_checks']['extra_counterexample_executions'] = len(result['first_counterexamples'])
+    result['passed'] = not result['failures']
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2)+'\n')
+    print(json.dumps({key: result[key] for key in ('generator_sha256', 'total_draws', 'unique_inputs_across_bands', 'passed')}))
+    return 0 if result['passed'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
