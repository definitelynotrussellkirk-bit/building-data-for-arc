+#!/usr/bin/env python3
+"""Run all AFTER gates without hiding a failed stage, plus a relocated probe.
+
+The public check command fails fast in AFTER mode and exposes no --keep-going.
+This task-local wrapper stages the exact same runtime and invokes the existing
+battery's --keep-going flag. It does not change any gate or aggregate verdict.
+From the packet root:
+  python3 run_with_racket.py python3 generators/ee1c3a11982c/workspace/run_complete_battery.py --out ../checks/after-complete
+"""
+from __future__ import annotations
+import argparse
+import json
+from pathlib import Path
+import shutil
+import tempfile
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.runtime import prepare_runtime, run_process
+
+TASK = 'ee1c3a11982c'
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--timeout', type=float, default=4000)
+    parser.add_argument('--skip-relocation-probe', action='store_true')
+    args = parser.parse_args(argv)
+    output = args.out.resolve()
+    if output.exists():
+        parser.error(f'output already exists: {output}')
+    if args.timeout <= 0:
+        parser.error('timeout must be positive')
+    output.mkdir(parents=True)
+    repo = Path(__file__).resolve().parents[3]
+    with tempfile.TemporaryDirectory(prefix='arcpuzzles-review-full-') as directory:
+        runtime = Path(directory)
+        manifest = prepare_runtime(Catalog(repo), runtime, TASK)
+        command = ['bash', 'scripts/run_generator_battery.sh', TASK, 'after', '--fresh', '--keep-going']
+        result = run_process(command, runtime, timeout=args.timeout)
+        result.update({'schema': 'task-local-complete-battery-v1', 'runtime_cwd': str(runtime),
+                       'runtime_manifest': manifest, 'phase': 'after'})
+        summary = runtime/f'checks/{TASK}_after_battery_summary.json'
+        result['battery_summary'] = json.loads(summary.read_text()) if summary.is_file() else None
+        if not args.skip_relocation_probe:
+            shutil.copy2(Path(__file__).with_name('review_probe.py'), runtime/'review_probe.py')
+            probe_command = ['python3', '-E', '-s', 'review_probe.py', '--runtime-root', '.',
+                             '--seeds', '20', '--indices', '6', '--racket-samples', '36', '--exhaustive',
+                             '--out', 'checks/relocation-probe.json']
+            result['relocation'] = run_process(probe_command, runtime, timeout=240)
+            result['relocation']['cwd'] = str(runtime)
+        if (runtime/'checks').is_dir():
+            shutil.copytree(runtime/'checks', output/'checks')
+        (output/'result.json').write_text(json.dumps(result, indent=2)+'\n')
+        (output/'stdout.log').write_text(result['stdout'])
+        (output/'stderr.log').write_text(result['stderr'])
+    counts = (result['battery_summary'] or {}).get('counts', {})
+    print(json.dumps({'counts': counts, 'exit_code': result['exit_code'],
+                      'relocation_exit_code': result.get('relocation', {}).get('exit_code')}))
+    return 1 if result['exit_code'] or result['timed_out'] or result.get('relocation', {}).get('exit_code', 0) else 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
