+def _strict_int_scalar(name: str, value: object) -> int:
+    """Return *value* only when it is an exact built-in ``int`` scalar.
+
+    ``bool`` is deliberately rejected even though it subclasses ``int``.  This keeps
+    deterministic episode addressing source-stable and prevents silent truncation or
+    coercion of floats, strings, numpy scalars, and arbitrary ``__int__`` objects.
+    """
+    if type(value) is not int:
+        raise TypeError(f"{name} must be an exact built-in int, got {type(value).__name__}")
+    return value
 
