    "racket_text": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (let* ((cells (find-color g 3))\n                  (marks (find-color g 6))\n                  (r0 (min-of fst cells))\n                  (r1 (max-of fst cells))\n                  (c0 (min-of snd cells))\n                  (c1 (max-of snd cells))\n                  (above (filter (lambda (p)\n                                   (and (< (fst p) r0) (>= (snd p) c0) (<= (snd p) c1)))\n                                 marks))\n                  (below (filter (lambda (p)\n                                   (and (> (fst p) r1) (>= (snd p) c0) (<= (snd p) c1)))\n                                 marks))\n                  (lefts (filter (lambda (p) (< (snd p) c0)) marks))\n                  (rights (filter (lambda (p) (> (snd p) c1)) marks))\n                  (nr0 (if (empty? above) r0 (+ 1 (max-of fst above))))\n                  (nr1 (if (empty? below) r1 (- (min-of fst below) 1)))\n                  (nc0 (if (empty? lefts) c0 (+ 1 (max-of snd lefts))))\n                  (nc1 (if (empty? rights) c1 (- (min-of snd rights) 1)))\n                  (full-rows (filter (lambda (r)\n                                       (all? (lambda (c) (= (at g r c) 3))\n                                             (range c0 (+ c1 1))))\n                                     (range r0 (+ r1 1))))\n                  (full-cols (filter (lambda (c)\n                                       (all? (lambda (r) (= (at g r c) 3))\n                                             (range r0 (+ r1 1))))\n                                     (range c0 (+ c1 1))))\n                  (base (cellmap g (r c v) (if (= v 6) 6 0))))\n             (define (map-r r) (cond ((= r r0) nr0) ((= r r1) nr1) (else r)))\n             (define (map-c c) (cond ((= c c0) nc0) ((= c c1) nc1) (else c)))\n             (define (paint-h acc r)\n               (reduce (lambda (a c) (set-cell a r c 3)) acc (range nc0 (+ nc1 1