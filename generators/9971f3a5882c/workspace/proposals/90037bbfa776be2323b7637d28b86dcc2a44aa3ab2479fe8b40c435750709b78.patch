+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK = "9f362acbf729"
+ROOT = find_root(__file__)
+GEN, _, _ = load_selected_generator(TASK, root=ROOT)
+PROBE_PATH = Path(__file__).resolve().parents[1] / "workspace" / "lesson_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("probe_9f36", PROBE_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_fixed_corner_position_shortcut_survives_constant_key_order_demos():
+    probe = load_probe()
+    witness = probe.build_witness(apply_program=lambda program, grid: GEN.rule_mirror(grid))
+    assert witness["status"] == "finding"
+    assert witness["shortcut"] == "fixed_corner_positions_ignore_key_values"
+    assert len(witness["demonstrations"]) == 3
+    assert all(row["key_order"] == "1-2-3-4" for row in witness["demonstrations"])
+    assert witness["query"]["key_order"] == "4-3-2-1"
+    assert witness["rival_fits_all_demonstrations"] is True
+    assert witness["rival_changes_query"] is True
+    assert witness["changed_query_cells"] > 0
