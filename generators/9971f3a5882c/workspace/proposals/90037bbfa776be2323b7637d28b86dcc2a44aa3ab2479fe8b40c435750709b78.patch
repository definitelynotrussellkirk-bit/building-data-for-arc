+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK = "9e47b59d6afc"
+ROOT = find_root(__file__)
+GEN, _, _ = load_selected_generator(TASK, root=ROOT)
+PROBE_PATH = Path(__file__).resolve().parents[1] / "workspace" / "lesson_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("probe_9e47", PROBE_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_position_role_shortcut_survives_same_placement_demos_and_fails_query():
+    probe = load_probe()
+    witness = probe.build_witness(apply_program=lambda program, grid: GEN.expected_output(grid))
+    assert witness["status"] == "finding"
+    assert witness["shortcut"] == "northwest_object_is_red_role"
+    assert witness["lesson_checker_result"] == []
+    assert len(witness["demonstrations"]) == 3
+    assert all(row["placement"] == "red_nw" for row in witness["demonstrations"])
+    assert witness["query"]["placement"] == "red_se"
+    assert witness["rival_fits_all_demonstrations"] is True
+    assert witness["rival_changes_query"] is True
+    assert witness["changed_query_cells"] > 0
