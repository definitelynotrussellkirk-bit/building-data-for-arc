+#!/usr/bin/env python3
+"""Source-pinned lesson probe for a position-as-role shortcut.
+
+Three demonstrations keep the red object northwest.  A plausible wrong learner
+therefore treats the northwest object as the red role and ignores its color.
+The query flips placement, exposing the shortcut.  Correct labels are executed
+through protected Racket in CLI mode.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK_ID = "9e47b59d6afc"
+EXPECTED_SOURCE_SHA256 = "e350f01e1fbe0c029450c31a655409b0a995642a4812faa5a3c48eea8afcf07e"
+ROOT = find_root(__file__)
+GEN, SOURCE_PATH, SOURCE_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+if SOURCE_SHA256 != EXPECTED_SOURCE_SHA256:
+    raise ValueError(
+        f"assigned peer source changed: expected {EXPECTED_SOURCE_SHA256}, got {SOURCE_SHA256}"
+    )
+
+
+def _canonical_program() -> str:
+    programs = {
+        row.get("program_solution")
+        for row in Catalog(ROOT)._variants().get(TASK_ID, [])
+        if isinstance(row.get("program_solution"), str) and row["program_solution"].strip()
+    }
+    if len(programs) != 1:
+        raise ValueError("peer must have one exact canonical Racket program")
+    return next(iter(programs))
+
+
+def _normalize(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    top = min(row for row, _ in cells)
+    left = min(column for _, column in cells)
+    return {(row - top, column - left) for row, column in cells}
+
+
+def northwest_object_is_red_role(grid: list[list[int]]) -> list[list[int]]:
+    """Wrong rule: infer semantic roles from NW/SE position, not colors."""
+    objects = []
+    for color in (2, 3):
+        cells = {
+            (row, column)
+            for row, values in enumerate(grid)
+            for column, value in enumerate(values)
+            if value == color
+        }
+        if not cells:
+            raise ValueError(f"missing color-{color} object")
+        objects.append(cells)
+    objects.sort(key=lambda cells: (min(row for row, _ in cells), min(column for _, column in cells)))
+    red_role, green_role = map(_normalize, objects)
+    union = red_role | green_role
+    output = [
+        [0] * (max(column for _, column in union) + 1)
+        for _ in range(max(row for row, _ in union) + 1)
+    ]
+    for row, column in union:
+        if (row, column) in red_role and (row, column) in green_role:
+            output[row][column] = 8
+        elif (row, column) in red_role:
+            output[row][column] = 2
+        else:
+            output[row][column] = 3
+    return output
+
+
+def _changed_cells(left: list[list[int]], right: list[list[int]]) -> int:
+    height = max(len(left), len(right))
+    width = max(len(left[0]), len(right[0]))
+    return sum(
+        (left[row][column] if row < len(left) and column < len(left[0]) else None)
+        != (right[row][column] if row < len(right) and column < len(right[0]) else None)
+        for row in range(height)
+        for column in range(width)
+    )
+
+
+def build_witness(*, apply_program, runtime_identity: dict | None = None) -> dict:
+    program = _canonical_program()
+    demo_specs = (
+        (4101, 0, "easy"),
+        (4102, 17, "medium"),
+        (4103, 41, "hard"),
+    )
+    demonstrations = []
+    for seed, sample_index, difficulty in demo_specs:
+        grid = GEN.generate(
+            seed,
+            sample_index,
+            difficulty=difficulty,
+            placement="red_nw",
+        )
+        output = _grid(apply_program(program, deepcopy(grid)))
+        rival = northwest_object_is_red_role(grid)
+        demonstrations.append(
+            {
+                "seed": seed,
+                "sample_index": sample_index,
+                "difficulty": difficulty,
+                "placement": GEN.observe_overrides(grid)["placement"],
+                "input": grid,
+                "output": output,
+                "rival_output": rival,
+            }
+        )
+
+    query_grid = GEN.generate(
+        4201,
+        73,
+        difficulty="hard",
+        placement="red_se",
+    )
+    query_output = _grid(apply_program(program, deepcopy(query_grid)))
+    query_rival = northwest_object_is_red_role(query_grid)
+
+    fits = all(row["rival_output"] == row["output"] for row in demonstrations)
+    changes = query_rival != query_output
+    checker_demos = [
+        {"input": row["input"], "output": row["output"]}
+        for row in demonstrations
+    ]
+    checker_query = {"input": query_grid, "output": query_output}
+    checker_result = GEN.lesson_identifiable(checker_demos, checker_query)
+    if not fits or not changes:
+        raise RuntimeError("deterministic position-role witness no longer exposes the shortcut")
+
+    return {
+        "schema": "arcpuzzles-peer-lesson-probe-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "source_path": SOURCE_PATH.relative_to(ROOT).as_posix(),
+        "source_sha256": SOURCE_SHA256,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "runtime_identity": runtime_identity or {"backend": "injected", "protected": False},
+        "shortcut": "northwest_object_is_red_role",
+        "explanation": (
+            "All visible demonstrations place red northwest, so a learner can ignore colors and "
+            "assign red/green semantic roles by object position. The southeast-red query swaps "
+            "those roles while preserving the intended color-based rule."
+        ),
+        "demonstrations": demonstrations,
+        "query": {
+            "seed": 4201,
+            "sample_index": 73,
+            "difficulty": "hard",
+            "placement": GEN.observe_overrides(query_grid)["placement"],
+            "input": query_grid,
+            "output": query_output,
+            "rival_output": query_rival,
+        },
+        "rival_fits_all_demonstrations": fits,
+        "rival_changes_query": changes,
+        "changed_query_cells": _changed_cells(query_output, query_rival),
+        "lesson_checker_result": checker_result,
+        "repair": (
+            "Add this position-role rival to LESSON_COMPETITORS or require visible demonstrations "
+            "that reverse red/green placement before admitting a lesson."
+        ),
+        "limits": "One deterministic three-demo witness; no universal ambiguity claim.",
+    }
+
+
+def _write(path: Path, value: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args(argv)
+    runtime = ROOT / "shared" / "runtime"
+    with _local_imports(runtime, Path(__file__).resolve().parent):
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            witness = build_witness(apply_program=apply, runtime_identity=identity)
+        finally:
+            bridge.close()
+    if identity.get("backend") != "racket" or identity.get("protected") is not True:
+        raise RuntimeError("peer witness requires protected Racket labels")
+    _write(Path(args.out).resolve(), witness)
+    print(json.dumps({
+        "status": witness["status"],
+        "task_id": TASK_ID,
+        "shortcut": witness["shortcut"],
+        "changed_query_cells": witness["changed_query_cells"],
+        "lesson_checker_result": witness["lesson_checker_result"],
+        "out": str(Path(args.out).resolve()),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
