+++ b/repo/generators/d2a80a6f9495/workspace/peer_learnability_probe.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+"""Protected-Racket ambiguity witness for d2a80a6f9495.
+
+The canonical branch acts only on exactly-two-color objects.  This probe retains
+one deterministic three-demonstration lesson where that guard is never visible,
+followed by a query containing a three-color object.  A nearby rival that swaps
+the first two colors of every multicolor object fits every demonstration yet
+changes the query, proving that this particular visible lesson is under-taught.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root
+
+
+TASK_ID = "d2a80a6f9495"
+ROOT = find_root(__file__)
+_GENERATOR_PATH = ROOT / "generators" / TASK_ID / "generator.py"
+_GENERATOR_NAME = "_arc_d2_peer_generator_" + hashlib.sha256(str(_GENERATOR_PATH).encode()).hexdigest()
+_GENERATOR_SPEC = importlib.util.spec_from_file_location(_GENERATOR_NAME, _GENERATOR_PATH)
+if _GENERATOR_SPEC is None or _GENERATOR_SPEC.loader is None:
+    raise ImportError(f"cannot load adjacent generator: {_GENERATOR_PATH}")
+generator = importlib.util.module_from_spec(_GENERATOR_SPEC)
+sys.modules[_GENERATOR_NAME] = generator
+_GENERATOR_SPEC.loader.exec_module(generator)
+
+SEEDS = (19, 20, 21, 22)
+RIVAL_PROGRAM = """(rule! (lambda (g)
+         (let* ((objs (objects-multicolor g 0)))
+           (reduce (lambda (acc obj)
+                     (let* ((cells (obj-cells obj))
+                            (colors (unique (map (lambda (p) (at g (fst p) (snd p)))
+                                                 cells))))
+                       (if (< (length colors) 2)
+                           acc
+                           (let* ((ka (first colors))
+                                  (kb (nth colors 1)))
+                             (reduce (lambda (g2 p)
+                                       (let ((v (at g (fst p) (snd p))))
+                                         (set-cell g2
+                                                   (fst p)
+                                                   (snd p)
+                                                   (cond ((= v ka) kb)
+                                                         ((= v kb) ka)
+                                                         (else v)))))
+                                     acc
+                                     cells)))))
+                   g
+                   objs))))"""
+
+
+def _json_bytes(value: Any) -> bytes:
+    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _canonical_program() -> str:
+    programs: set[str] = set()
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                source = row.get("program_solution")
+                if isinstance(source, str):
+                    programs.add(source)
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program for {TASK_ID}, got {len(programs)}")
+    return next(iter(programs))
+
+
+def _object_color_counts(grid: list[list[int]]) -> list[int]:
+    return sorted(len(generator._obj_colors(grid, obj)) for obj in generator._objects_multicolor(grid))
+
+
+def _diff_cells(left: list[list[int]], right: list[list[int]]) -> int:
+    return sum(a != b for row_a, row_b in zip(left, right) for a, b in zip(row_a, row_b))
+
+
+def _source_binding() -> dict[str, str]:
+    paths = {
+        "generator": ROOT / "generators" / TASK_ID / "generator.py",
+        "probe": ROOT / "generators" / TASK_ID / "workspace" / "peer_learnability_probe.py",
+        "test": ROOT / "generators" / TASK_ID / "tests" / "test_peer_learnability_probe.py",
+    }
+    return {name: hashlib.sha256(path.read_bytes()).hexdigest() for name, path in paths.items()}
+
+
+def build_case(destination: str | Path) -> dict[str, Any]:
+    destination = Path(destination)
+    canonical_program = _canonical_program()
+    grids = [generator.generate(seed, seed) for seed in SEEDS]
+    observed = [generator.observe_overrides(grid) for grid in grids]
+    color_counts = [_object_color_counts(grid) for grid in grids]
+
+    if not all(row == [] for row in (generator.self_check(grid) for grid in grids)):
+        raise AssertionError("retained peer grids must satisfy the generator contract")
+    if not all(row["n_neg"] == 0 for row in observed[:3]):
+        raise AssertionError("retained demonstrations no longer hide the negative branch")
+    if observed[3]["n_neg"] != 1 or 3 not in color_counts[3]:
+        raise AssertionError("retained query no longer contains one three-color negative object")
+
+    wrapped = {
+        "canonical": wrap_rule(canonical_program),
+        "rival": wrap_rule(RIVAL_PROGRAM),
+    }
+    evaluations: list[dict[str, Any]] = []
+    with RacketBridge() as bridge:
+        runtime = bridge.runtime_identity
+        if runtime.get("backend") != "racket" or runtime.get("protected") is not True:
+            raise RuntimeError("protected Racket runtime required")
+        for index, (seed, grid, axes, counts) in enumerate(zip(SEEDS, grids, observed, color_counts)):
+            literal = _grid_literal(grid)
+            canonical_output = bridge.eval_text(f"({wrapped['canonical']} {literal})")
+            rival_output = bridge.eval_text(f"({wrapped['rival']} {literal})")
+            evaluations.append({
+                "index": index,
+                "seed": seed,
+                "input": grid,
+                "n_swap": axes["n_swap"],
+                "n_neg": axes["n_neg"],
+                "object_color_counts": counts,
+                "canonical_output": canonical_output,
+                "rival_output": rival_output,
+                "different_cells": _diff_cells(canonical_output, rival_output),
+            })
+
+    if any(row["different_cells"] != 0 for row in evaluations[:3]):
+        raise AssertionError("rival must fit all three visible demonstrations")
+    if evaluations[3]["different_cells"] == 0:
+        raise AssertionError("rival must disagree on the retained query")
+
+    report = {
+        "schema": "arcpuzzles-peer-learnability-case-v1",
+        "task_id": TASK_ID,
+        "status": "ambiguous_visible_demos",
+        "seeds": list(SEEDS),
+        "lesson_construction": "three consecutive default draws as demonstrations, followed by the fourth as query",
+        "canonical_rule": "swap colors only inside exactly-two-color 8-connected objects",
+        "rival_rule": "inside every object with at least two colors, swap the first two encountered colors and leave any additional colors unchanged",
+        "why_rival_is_plausible": "all visible demonstrations contain only two-color objects, so the exactly-two guard is unobserved",
+        "canonical_program_sha256": hashlib.sha256(canonical_program.encode()).hexdigest(),
+        "rival_program_sha256": hashlib.sha256(RIVAL_PROGRAM.encode()).hexdigest(),
+        "runtime": runtime,
+        "source_binding": _source_binding(),
+        "demonstrations": evaluations[:3],
+        "query": evaluations[3],
+        "repair_recommendation": (
+            "When a query contains a three-color negative object, require at least one visible "
+            "demonstration containing a three-color negative object (or otherwise teach the exact-two guard)."
+        ),
+        "limits": (
+            "One finite deterministic lesson and one executable rival; this does not prove all lesson "
+            "assembly is ambiguous or that this is the only plausible rival."
+        ),
+        "training_admitted": False,
+    }
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_bytes(_json_bytes(report))
+    return report
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = build_case(args.out)
+    print(json.dumps({
+        "status": report["status"],
+        "task_id": report["task_id"],
+        "different_query_cells": report["query"]["different_cells"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
