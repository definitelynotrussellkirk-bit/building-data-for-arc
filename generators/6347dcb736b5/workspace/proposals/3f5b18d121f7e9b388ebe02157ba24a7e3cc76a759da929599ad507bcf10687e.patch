+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import find_root
+
+
+TASK_ID = "d2a80a6f9495"
+ROOT = find_root(__file__)
+PROBE = ROOT / "generators" / TASK_ID / "workspace" / "peer_learnability_probe.py"
+
+
+def _load_probe():
+    assert PROBE.is_file(), f"missing peer probe: {PROBE}"
+    spec = importlib.util.spec_from_file_location("d2_peer_learnability_probe", PROBE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_consecutive_seed_lesson_exposes_unshown_three_color_branch(tmp_path: Path) -> None:
+    probe = _load_probe()
+    destination = tmp_path / "ambiguous-lesson.json"
+    report = probe.build_case(destination)
+
+    assert destination.is_file()
+    assert report["schema"] == "arcpuzzles-peer-learnability-case-v1"
+    assert report["task_id"] == TASK_ID
+    assert report["status"] == "ambiguous_visible_demos"
+    assert report["seeds"] == [19, 20, 21, 22]
+    assert report["runtime"]["backend"] == "racket"
+    assert report["runtime"]["protected"] is True
+    assert len(report["demonstrations"]) == 3
+    assert all(row["n_neg"] == 0 for row in report["demonstrations"])
+    assert all(row["canonical_output"] == row["rival_output"] for row in report["demonstrations"])
+    assert report["query"]["n_neg"] == 1
+    assert 3 in report["query"]["object_color_counts"]
+    assert report["query"]["canonical_output"] != report["query"]["rival_output"]
+    assert report["query"]["different_cells"] > 0
