+    for comp in gen._components(grid):
+        dr, dc = gen._shift(comp["color"], comp["shape_index"])
+        for r, c in comp["cells"]:
+            r, c = r + dr, c + dc
+            if 0 <= r < len(grid) and 0 <= c < len(grid[0]):
+                out[r][c] = 4 if comp["color"] == 5 else 3
+    return out
+
