+                                     {"special_period": 3, "extra": 0}])
+def test_invalid_settings_fail_closed(settings):
+    adapter = load_adapter()
+    with pytest.raises((TypeError, ValueError)):
+        adapter.program(settings)
+    with pytest.raises((TypeError, ValueError)):
+        adapter.generate(0, settings, 3, 4)
