+(rule! (lambda (g)
+         (let* ((h (rows g))
+                (w (cols g)))
+           (begin
+             (define bb (bbox-of-cells (find-color g 7)))
+             (define r0 (first bb))
+             (define c0 (second bb))
+             (define r1 (third bb))
+             (define c1 (fourth bb))
+             (define gh (+ 1 (- r1 r0)))
+             (define gw (+ 1 (- c1 c0)))
+             (define hstep (+ gw 1))
+             (define vstep (+ gh 1))
+             (define (mask? local-r local-c)
+               (= (safe-at g (+ r0 local-r) (+ c0 local-c) 0) 7))
+             (define (paint? r c)
+               (if (or (< r r0) (< c c0))
+                   #f
+                   (let* ((rr (- r r0))
+                          (cc (- c c0))
+                          (local-r (mod rr vstep))
+                          (local-c (mod cc hstep))
+                          (inst (quotient cc hstep))
+                          (row-rep (quotient rr vstep)))
+                     (and
+                       (< local-r gh)
+                       (< local-c gw)
+                       (mask? local-r local-c)
+                       (or (zero? row-rep) (= (mod inst 3) 2))))))
+             (cellmap g
+                      (r c v)
+                      (if (paint? r c)
+                          (if (= (mod (quotient (- c c0) hstep) 3) 2) 6 7)
+                          0))))))
\ No newline at end of file
