     "raw_code": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         ;; Find template row (row with most non-zero cells)\n         (template-row\n          (let loop ((r 0) (best-r 0) (best-cnt 0))\n            (cond\n              ((>= r h) best-r)\n              (else\n                (let ((cnt (length (filter (lambda (c) (not (= (cell-at g r c) 0)))\n                                          (range 0 w)))))\n                  (if (> cnt best-cnt)\n                      (loop (+ r 1) r cnt)\n                      (loop (+ r 1) best-r best-cnt)))))))\n         (template (for/list ((c (range 0 w))) (cell-at g template-row c))))\n    (grid-from-fn h w\n      (lambda (r c)\n        (cond\n          ((= r template-row) (cell-at g r c))\n          (else\n           ;; Check if this row has any non-zero cells\n           (let ((row-cells (for/list ((cc (range 0 w))) (cell-at g r cc))))\n             (cond\n               ((for/and ((v row-cells)) (= v 0)) 0)  ;; empty row\n               (else\n                ;; Build color mapping from first few cells\n                (let ((mapping (make-hash)))\n                  (for ((cc (range 0 w)))\n                    (when (not (= (cell-at g r cc) 0))\n                      (hash-set! mapping (list-ref template cc) (cell-at g r cc))))\n                  ;; Apply mapping to template\n                  (hash-ref mapping (list-ref template c) 0))))))))))))",
