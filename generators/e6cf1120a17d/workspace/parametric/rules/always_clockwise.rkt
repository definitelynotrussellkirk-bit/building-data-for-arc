(rule! (lambda (g)
  (define cf (color-frequency g))
  (define non-bg-colors (filter (lambda (c) (not (= c 0))) (grid-colors g)))
  (define rect-color
    (let loop ((cs non-bg-colors) (best (first non-bg-colors)) (best-cnt 0))
      (if (null? cs) best
          (let ((cnt (hash-ref cf (first cs))))
            (if (> cnt best-cnt) (loop (cdr cs) (first cs) cnt) (loop (cdr cs) best best-cnt))))))
  (define cells (find-color g rect-color))
  (define rs (map first cells)) (define cs (map second cells))
  (define r1 (apply min rs)) (define r2 (apply max rs))
  (define c1 (apply min cs)) (define c2 (apply max cs))
  (define tl-in (list (+ r1 1) (+ c1 1)))
  (define tr-in (list (+ r1 1) (- c2 1)))
  (define br-in (list (- r2 1) (- c2 1)))
  (define bl-in (list (- r2 1) (+ c1 1)))
  (define tl-c (cell-at g (first tl-in) (second tl-in)))
  (define tr-c (cell-at g (first tr-in) (second tr-in)))
  (define br-c (cell-at g (first br-in) (second br-in)))
  (define bl-c (cell-at g (first bl-in) (second bl-in)))
  (define tl-out (list (- r1 1) (- c1 1)))
  (define tr-out (list (- r1 1) (+ c2 1)))
  (define br-out (list (+ r2 1) (+ c2 1)))
  (define bl-out (list (+ r2 1) (- c1 1)))
  (define g1 (set-cell g (first tl-in) (second tl-in) 0))
  (define g2 (set-cell g1 (first tr-in) (second tr-in) 0))
  (define g3 (set-cell g2 (first br-in) (second br-in) 0))
  (define g4 (set-cell g3 (first bl-in) (second bl-in) 0))
  (define g5 (set-cell g4 (first tr-out) (second tr-out) tl-c))
  (define g6 (set-cell g5 (first br-out) (second br-out) tr-c))
  (define g7 (set-cell g6 (first bl-out) (second bl-out) br-c))
  (set-cell g7 (first tl-out) (second tl-out) bl-c)))
