      "program": "(rule!\n ;; A mosaic mirror-symmetric about an OFF-CENTER vertical and horizontal\n ;; axis is occluded by a solid rectangle of 8s. Find each axis as the\n ;; reflection (c -> al - c / r -> au - r) with the largest conflict-free\n ;; overlap on visible cells, then output the occluded rectangle's hidden\n ;; content, each cell recovered from its first visible mirror image.\n (lambda (g)\n   (let ()\n     (define h (rows g))\n     (define w (cols g))\n     (define hole 8)\n     (define bb (bbox-of-cells (find-color g hole)))\n     (define r1 (first bb))\n     (define c1 (second bb))\n     (define r2 (nth bb 2))\n     (define c2 (nth bb 3))\n     (define (axis-score a2 vert)\n       (for*/fold ((n 0)) ((r (in-range h)) (c (in-range w)))\n         (if (< n 0)\n             n\n             (let ((rr (if (= vert 1) r (- a2 r)))\n                   (cc (if (= vert 1) (- a2 c) c)))\n               (if (in-bounds? rr cc h w)\n                   (let ((v (at g r c)) (u (at g rr cc)))\n                     (cond ((or (= v hole) (= u hole)) n)\n                           ((= v u) (+ n 1))\n                           (else -1)))\n                   n)))))\n     (define (best-axis vert maxa)\n       (first (reduce (lambda (best a2)\n                        (let ((s (axis-score a2 vert)))\n                          (if (> s (second best)) (list a2 s) best)))\n                      (list 0 0)\n                      (range 1 maxa))))\n     (define al (best-axis 1 (- (* 2 w) 2)))\n     (define au (best-axis 0 (- (* 2 h) 2)))\n     (grid-from-fn (+ (- r2 r1) 1) (+ (- c2 c1) 1)\n       (lambda (i j)\n         (let* ((pr (+ r1 i))\n                (pc (+ c1 j))\n                (hits (filter (lambda (p)\n                                (and (in-bounds? (first p) (second p) h w)\n                                     (!= (at g (first p) (second p)) hole)))\n                              (list (list pr (- al pc))\n                                    (list (- au pr) pc)\n                                    (list (- au pr) (- al pc))))))\n           (at g (first (first hits)) (second (first hits)))))))))",
