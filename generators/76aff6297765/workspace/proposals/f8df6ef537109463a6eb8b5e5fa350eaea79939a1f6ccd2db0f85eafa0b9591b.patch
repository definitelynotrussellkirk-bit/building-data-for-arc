+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, sort_keys=True, separators=(",", ":")) + "\n")
+    print(json.dumps({key: report.get(key) for key in ("status", "input_sides", "racket_evaluations",
