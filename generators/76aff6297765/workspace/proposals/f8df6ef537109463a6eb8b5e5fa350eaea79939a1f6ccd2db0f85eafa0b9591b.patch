+"""Bounded whole-component-cancellation rival probe; no production mutation."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = "9a1459fe40d0"
+RIVAL = """(rule! (lambda (g)
+  (let* ([b (quotient (cols g) 2)]
+         [left (grid-from-fn (rows g) (cols g) (lambda (r c)
+           (if (and (> c b) (not (zero? (cell-at g r (- (* 2 b) c))))) 1 0)))]
+         [right (grid-from-fn (rows g) (cols g) (lambda (r c)
+           (if (and (> c b) (not (zero? (cell-at g r c)))) 1 0)))]
+         [keep-left (filter (lambda (o)
+           (all? (lambda (p) (zero? (cell-at right (first p) (second p)))) (obj-cells o))) (objects left 0))]
+         [keep-right (filter (lambda (o)
+           (all? (lambda (p) (zero? (cell-at left (first p) (second p)))) (obj-cells o))) (objects right 0))])
+    (paint-objects (empty-grid (rows g) (cols g) 0) (append keep-left keep-right) 7))))"""
+
+
+def components(points):
+    remaining = set(points)
+    while remaining:
+        first = remaining.pop()
+        component, stack = {first}, [first]
+        while stack:
+            r, c = stack.pop()
+            for neighbor in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if neighbor in remaining:
+                    remaining.remove(neighbor)
+                    component.add(neighbor)
+                    stack.append(neighbor)
+        yield component
+
+
+def rival(grid):
+    h, w = len(grid), len(grid[0])
+    b = w // 2
+    left = {(r, 2 * b - c) for r in range(h) for c in range(b) if grid[r][c]}
+    right = {(r, c) for r in range(h) for c in range(b + 1, w) if grid[r][c]}
+    keep = set()
+    for own, other in ((left, right), (right, left)):
+        for component in components(own):
+            if not component & other:
+                keep.update(component)
+    return [[7 if (r, c) in keep else 0 for c in range(w)] for r in range(h)]
+
+
+def main():
+    root = find_root(__file__)
+    generator, source, source_hash = load_selected_generator(TASK, root=root)
+    catalog = Catalog(root)
+    row = catalog.describe(TASK)
+    programs = {v["program_solution"] for v in catalog._variants()[row.get("rule_task_id", TASK)]}
+    assert len(programs) == 1
+    program = next(iter(programs))
+    found, lessons = None, 0
+    for seed in range(32):
+        for difficulty in ("easy", "medium", "hard"):
+            grids = [generator.generate(seed, index, difficulty=difficulty) for index in range(3)]
+            labels = [generator.rule_mirror(grid) for grid in grids]
+            predictions = [rival(grid) for grid in grids]
+            lessons += 1
+            if predictions[:2] == labels[:2] and predictions[2] != labels[2]:
+                found = (seed, difficulty, grids, labels, predictions)
+                break
+        if found:
+            break
+    evidence = {
+        "schema": "arcpuzzles-bounded-peer-probe-v1", "task_id": TASK,
+        "generator_sha256": source_hash, "rule_hash": row["rule_hash"],
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "command": "WORK/.venv/bin/python review.py run python3 generators/9a1459fe40d0/workspace/probe_optional.py",
+        "rival": "Cancel entire four-connected occupancy components that overlap after reflection; preserve wholly unmatched components.",
+        "scope": {"seed_range": [0, 31], "difficulties": ["easy", "medium", "hard"],
+                  "demo_indices": [0, 1], "query_index": 2, "lessons_examined": lessons,
+                  "search_stopped_at_first_finding": True},
+        "limits": "One plausible objectwise rival and bounded generated lessons only. No production repair, full battery, owner acceptance or training admission.",
+    }
+    if found:
+        seed, difficulty, grids, labels, predictions = found
+        runtime = root / "shared/runtime"
+        with _local_imports(runtime, runtime):
+            apply, identity, bridge = _real_evaluator(runtime)
+            try:
+                for grid, expected, alternative in zip(grids, labels, predictions):
+                    assert apply(program, grid) == expected
+                    assert apply(RIVAL, grid) == alternative
+            finally:
+                bridge.close()
+        evidence.update(status="finding", seed=seed, difficulty=difficulty,
+                        program=program, rival_program=RIVAL, racket=identity, evaluations=6,
+                        train=[{"input": g, "output": y, "rival_output": p}
+                               for g, y, p in zip(grids[:2], labels[:2], predictions[:2])],
+                        test={"input": grids[2], "output": labels[2], "rival_output": predictions[2]},
+                        self_check_errors=[generator.self_check(grid) for grid in grids],
+                        existing_lesson_identifiable=generator.lesson_identifiable(
+                            [{"input": g, "output": y} for g, y in zip(grids[:2], labels[:2])],
+                            {"input": grids[2], "output": labels[2]}))
+    else:
+        evidence.update(status="finite_no_issue", racket="not run: no retained counterexample")
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == source_hash
+    out = root / f"generators/{TASK}/counterexamples/optional-component-cancellation.json"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(evidence, sort_keys=True, separators=(",", ":")) + "\n")
+    print(json.dumps({"status": evidence["status"], "lessons_examined": lessons,
+                      "seed": evidence.get("seed"), "difficulty": evidence.get("difficulty"),
+                      "evidence": str(out.relative_to(root)), "source_sha256": source_hash}))
+
+
+if __name__ == "__main__":
+    main()
