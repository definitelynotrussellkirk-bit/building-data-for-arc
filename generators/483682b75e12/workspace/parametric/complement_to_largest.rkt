(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((visited (make-hash))
                  (result (make-hash))
                  (components (list))
                  (max-size 0))
             (for* ((r (range 0 h)) (c (range 0 w)))
                   (let ((v (at g r c))) (hash-set! result (list r c) (if (= v 8) 8 7))))
             (for* ((r (range 0 h)) (c (range 0 w)))
                   (when
                     (and
                       (!= (at g r c) 7)
                       (!= (at g r c) 8)
                       (not (hash-has-key? visited (list r c))))
                     (let ((cells (list))
                           (size 0))
                       (let bfs
                            ((q (list (list r c))))
                            (unless
                              (null? q)
                              (let ((cur (car q)))
                                (cond
                                  ((hash-has-key? visited cur) (bfs (cdr q)))
                                  ((or
                                     (< (first cur) 0)
                                     (>= (first cur) h)
                                     (< (second cur) 0)
                                     (>= (second cur) w)) (bfs (cdr q)))
                                  ((or
                                     (= (at g (first cur) (second cur)) 7)
                                     (= (at g (first cur) (second cur)) 8)) (bfs (cdr q)))
                                  (else (hash-set! visited cur #t)
                                        (set! cells (cons cur cells))
                                        (set! size (+ size 1))
                                        (let ((cr (first cur))
                                              (cc (second cur)))
                                          (bfs (append (cdr q)
                                                       (list (list (- cr 1) cc)
                                                             (list (+ cr 1) cc)
                                                             (list cr (- cc 1))
                                                             (list cr (+ cc 1)))))))))))
                       (when (> size max-size) (set! max-size size))
                       (set! components (cons (list cells size) components)))))
             (for ((component components))
               (let* ((cells (first component))
                      (size (second component))
                      (shift (+ 1 (- max-size size))))
                 (for ((cell cells))
                   (let ((nr (- (first cell) shift))
                         (nc (second cell))
                         (v (at g (first cell) (second cell))))
                     (when (>= nr 0) (hash-set! result (list nr nc) v))))))
             (cellmap g (r c v) (hash-ref result (list r c) 7))))))
