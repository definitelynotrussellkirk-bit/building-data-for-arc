+"""Source-pinned executable probe for a canvas-conditioned ring-stride rival.
+
+The accepted default lesson uses two non-square demonstrations and includes a
+30x30 square query.  A rival can therefore run the canonical stride-1 rule on
+non-square canvases but silently use stride 2 on square canvases.  The declared
+22-rival certificate omits canvas-conditioned parameter switches, so it reports
+one survivor while this executable rival also fits every visible demonstration
+and changes the square query.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "1d1cffd62646"
+ASSIGNMENT_ID = "review-b468dd0695d7139e"
+EXPECTED_GENERATOR_SHA256 = "c29c844c6fa26fe31931d2b86ad41e33bafd9615068ed4ca98c93d0b71934391"
+EXPECTED_PROTOTYPE_SHA256 = "4d3d815ef0c46de3c41a76a2e87eb90b8be23c1bbeb16643fdf0cef2bed379a5"
+HERE = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+PROTOTYPE_PATH = ROOT / "generators" / TASK_ID / "workspace" / "parametric" / "prototype.py"
+
+
+def _sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _json_bytes(value: Any) -> bytes:
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"),
+                       ensure_ascii=False, allow_nan=False) + "\n").encode("utf-8")
+
+
+def _load_prototype():
+    digest = _sha(PROTOTYPE_PATH.read_bytes())
+    if digest != EXPECTED_PROTOTYPE_SHA256:
+        raise ValueError("accepted parametric prototype differs from assigned source")
+    spec = importlib.util.spec_from_file_location("accepted_1d1cff_parametric", PROTOTYPE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("could not load accepted parametric prototype")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def materialize_rival(canonical: str) -> str:
+    """Use stride 2 only on square canvases and stride 1 elsewhere."""
+    target = "(range 0 (+ max-k 2))"
+    if canonical.count(target) != 1:
+        raise ValueError("canonical ring enumeration changed")
+    switched = (
+        "(if (= h w) "
+        "(filter (lambda (k) (or (= k 0) (= (mod k 2) 1))) " + target + ") "
+        + target + ")"
+    )
+    return canonical.replace(target, switched)
+
+
+def _execute(bridge, program: str, grid: list[list[int]], name: str) -> list[list[int]]:
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    body = wrap_rule(program)
+    if not body.lstrip().startswith("(lambda"):
+        raise ValueError("rule did not normalize to a callable lambda")
+    bridge.eval_text(f"(define {name} {body})")
+    bridge.define_grid(f"{name}_input", grid)
+    value = bridge.eval_text(f"({name} {name}_input)")
+    if not isinstance(value, list) or not value or not all(isinstance(row, list) for row in value):
+        raise ValueError("Racket rule returned a non-grid")
+    return value
+
+
+def build_case() -> dict[str, Any]:
+    _, generator_path, generator_sha256 = load_selected_generator(TASK_ID, root=ROOT)
+    if generator_sha256 != EXPECTED_GENERATOR_SHA256:
+        raise ValueError("peer generator differs from the assigned exact source")
+    prototype = _load_prototype()
+    demos, queries = prototype.sample_inputs(0, n_demo=2, n_query=4)
+    canonical = prototype.materialize_program(ring_stride=1)
+    rival = materialize_rival(canonical)
+
+    from arc_repl.racket_bridge import RacketBridge
+    with RacketBridge(timeout=20) as bridge:
+        canonical_demo_outputs = [
+            _execute(bridge, canonical, grid, f"canonical_demo_{index}")
+            for index, grid in enumerate(demos)
+        ]
+        rival_demo_outputs = [
+            _execute(bridge, rival, grid, f"rival_demo_{index}")
+            for index, grid in enumerate(demos)
+        ]
+        canonical_queries = [
+            _execute(bridge, canonical, grid, f"canonical_query_{index}")
+            for index, grid in enumerate(queries)
+        ]
+        rival_queries = [
+            _execute(bridge, rival, grid, f"rival_query_{index}")
+            for index, grid in enumerate(queries)
+        ]
+
+    lesson = {
+        "train": [
+            {"input": copy.deepcopy(grid), "output": copy.deepcopy(output)}
+            for grid, output in zip(demos, canonical_demo_outputs)
+        ],
+        "test": [{"input": copy.deepcopy(grid)} for grid in queries],
+    }
+    certificate = prototype.lesson_certificate(lesson)
+    square_indices = [
+        index for index, grid in enumerate(queries) if len(grid) == len(grid[0])
+    ]
+    if square_indices != [1]:
+        raise AssertionError(f"expected one square query at index 1, got {square_indices}")
+    square_index = square_indices[0]
+    square_diff = sum(
+        a != b
+        for row_a, row_b in zip(canonical_queries[square_index], rival_queries[square_index])
+        for a, b in zip(row_a, row_b)
+    )
+    all_query_diffs = [
+        sum(a != b for row_a, row_b in zip(canon, other) for a, b in zip(row_a, row_b))
+        for canon, other in zip(canonical_queries, rival_queries)
+    ]
+
+    return {
+        "schema": "arc-peer-shortcut-probe-v1",
+        "assignment_id": ASSIGNMENT_ID,
+        "task_id": TASK_ID,
+        "status": "finding",
+        "generator_path": str(generator_path.relative_to(ROOT)),
+        "generator_sha256": generator_sha256,
+        "prototype_path": str(PROTOTYPE_PATH.relative_to(ROOT)),
+        "prototype_sha256": _sha(PROTOTYPE_PATH.read_bytes()),
+        "canonical_program_sha256": _sha(canonical.encode("utf-8")),
+        "rival_program_sha256": _sha(rival.encode("utf-8")),
+        "shortcut": (
+            "Use canonical stride 1 on non-square canvases, but switch to "
+            "stride 2 when rows equal columns."
+        ),
+        "declared_certificate": certificate,
+        "rival_matches_all_demonstrations": rival_demo_outputs == canonical_demo_outputs,
+        "demonstration_shapes": [[len(grid), len(grid[0])] for grid in demos],
+        "query_shapes": [[len(grid), len(grid[0])] for grid in queries],
+        "query_diff_cells": all_query_diffs,
+        "square_query_index": square_index,
+        "square_query_shape": [len(queries[square_index]), len(queries[square_index][0])],
+        "square_query_diff_cells": square_diff,
+        "demonstrations": lesson["train"],
+        "queries": [
+            {
+                "input": grid,
+                "canonical_output": canonical_output,
+                "rival_output": rival_output,
+            }
+            for grid, canonical_output, rival_output in zip(
+                queries, canonical_queries, rival_queries
+            )
+        ],
+        "scope": (
+            "One exact accepted prototype and generator, seed 0 default two-demo/four-query "
+            "episode, two protected-Racket programs. No accepted or production source edit."
+        ),
+    }
+
+
+def main() -> int:
+    report = build_case()
+    if report["declared_certificate"]["survivors"] != ["stride-1"]:
+        raise AssertionError("declared certificate did not select canonical stride 1")
+    if not report["declared_certificate"]["identifiable"]:
+        raise AssertionError("declared certificate did not report identifiability")
+    if not report["rival_matches_all_demonstrations"]:
+        raise AssertionError("canvas-conditioned rival failed a visible demonstration")
+    if report["square_query_diff_cells"] <= 0:
+        raise AssertionError("canvas-conditioned rival did not change the square query")
+    prototype = _load_prototype()
+    canonical = prototype.materialize_program(ring_stride=1)
+    rival = materialize_rival(canonical)
+    (HERE / "canonical.rkt").write_text(canonical + "\n", encoding="utf-8")
+    (HERE / "rival.rkt").write_text(rival + "\n", encoding="utf-8")
+    (HERE / "evidence.json").write_bytes(_json_bytes(report))
+    print(json.dumps({
+        "status": report["status"],
+        "generator_sha256": report["generator_sha256"],
+        "prototype_sha256": report["prototype_sha256"],
+        "declared_survivors": report["declared_certificate"]["survivors"],
+        "rival_matches_all_demonstrations": report["rival_matches_all_demonstrations"],
+        "square_query_diff_cells": report["square_query_diff_cells"],
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
