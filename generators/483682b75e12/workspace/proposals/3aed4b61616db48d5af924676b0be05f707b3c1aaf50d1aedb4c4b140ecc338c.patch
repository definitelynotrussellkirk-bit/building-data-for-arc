+"""Source-pinned executable probe for a key/termination interaction shortcut.
+
+The four ordinary demonstrations teach each direction key and teach both wall
+and blocker termination globally.  For seed 0, however, key 1 appears only on
+blocked rays.  A rival may therefore behave canonically for key 1 when a
+blocker lies ahead, but suppress a key-1 wall ray.  The existing lesson gate
+checks the key and termination features separately and accepts the resulting
+query even though this rival fits every demonstration and changes its answer.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "7d09ccad28c8"
+EXPECTED_GENERATOR_SHA256 = "94ffcd1e01cd90e08b13a63b40965e58a805ebc1483a50249a960bcddd881ebe"
+ASSIGNMENT_ID = "review-b468dd0695d7139e"
+SHORTCUT_KEY = 1
+HERE = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+
+
+def _sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _json_bytes(value: Any) -> bytes:
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"),
+                       ensure_ascii=False, allow_nan=False) + "\n").encode("utf-8")
+
+
+def canonical_program() -> str:
+    programs = set()
+    for line in canonical_path(ROOT).read_text(encoding="utf-8").splitlines():
+        if line.strip():
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise ValueError("expected one canonical authority")
+    return programs.pop()
+
+
+def materialize_rival(program: str, *, shortcut_key: int = SHORTCUT_KEY) -> str:
+    """Suppress only an unblocked wall ray for one key; keep all else exact."""
+    if shortcut_key not in (1, 2, 3, 4):
+        raise ValueError("shortcut_key must be 1..4")
+    anchor = "(dir (e8b-dir key)) (base "
+    if program.count(anchor) != 1:
+        raise ValueError("canonical authority shape changed at direction binding")
+    blocker_bindings = (
+        "(dir (e8b-dir key)) "
+        "(blockerp (first (filter (lambda (p) (= (at g (first p) (second p)) 7)) inside))) "
+        "(blocker-ahead? "
+        "(cond ((= key 1) (and (= (second blockerp) (second emitter)) (< (first blockerp) (first emitter)))) "
+        "((= key 2) (and (= (first blockerp) (first emitter)) (> (second blockerp) (second emitter)))) "
+        "((= key 3) (and (= (second blockerp) (second emitter)) (> (first blockerp) (first emitter)))) "
+        "((= key 4) (and (= (first blockerp) (first emitter)) (< (second blockerp) (second emitter)))) "
+        "(else #f))) "
+        "(base "
+    )
+    changed = program.replace(anchor, blocker_bindings)
+    canonical_tail = (
+        "(let loop ((r (+ (first emitter) (first dir))) "
+        "(c (+ (second emitter) (second dir))) (out base)) "
+        "(cond ((not (and (> r r1) (< r r2) (> c c1) (< c c2))) out) "
+        "((= (at g r c) 7) out) "
+        "(else (loop (+ r (first dir)) (+ c (second dir)) "
+        "(if (= (at out r c) 0) (set-cell out r c 6) out)))))))))"
+    )
+    if changed.count(canonical_tail) != 1:
+        raise ValueError("canonical authority shape changed at ray loop")
+    rival_tail = (
+        f"(if (and (= key {shortcut_key}) (not blocker-ahead?)) base "
+        "(let loop ((r (+ (first emitter) (first dir))) "
+        "(c (+ (second emitter) (second dir))) (out base)) "
+        "(cond ((not (and (> r r1) (< r r2) (> c c1) (< c c2))) out) "
+        "((= (at g r c) 7) out) "
+        "(else (loop (+ r (first dir)) (+ c (second dir)) "
+        "(if (= (at out r c) 0) (set-cell out r c 6) out))))))))))"
+    )
+    return changed.replace(canonical_tail, rival_tail)
+
+
+def _execute(bridge, program: str, grid: list[list[int]], name: str) -> list[list[int]]:
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    body = wrap_rule(program)
+    if not body.lstrip().startswith("(lambda"):
+        raise ValueError("authority did not normalize to a lambda")
+    bridge.eval_text(f"(define {name} {body})")
+    bridge.define_grid(f"{name}_input", grid)
+    value = bridge.eval_text(f"({name} {name}_input)")
+    if not isinstance(value, list) or not value or not all(isinstance(row, list) for row in value):
+        raise ValueError("Racket rule returned a non-grid")
+    return value
+
+
+def _scene_summary(module, grid: list[list[int]]) -> list[dict[str, Any]]:
+    rows = []
+    for box in module._frame_boxes(grid):
+        scene = module._frame_scene(grid, box)
+        if scene is None:
+            raise ValueError("generated frame did not parse")
+        rows.append({
+            "box": list(box),
+            "key": scene["key"][2],
+            "blocked": scene["blocked"],
+            "paint_length": len(scene["paint_path"]),
+        })
+    return rows
+
+
+def build_case() -> dict[str, Any]:
+    module, source_path, source_sha256 = load_selected_generator(TASK_ID, root=ROOT)
+    if source_sha256 != EXPECTED_GENERATOR_SHA256:
+        raise ValueError("peer source differs from the assigned exact source")
+
+    demo_inputs = [module.generate(0, index, difficulty="medium") for index in range(4)]
+    query_input = module.generate(
+        0, 0, difficulty="medium", n_frames=1, n_blocked_rays=0
+    )
+    if module.self_check(query_input):
+        raise AssertionError("query is not a lawful generated scene")
+
+    canonical = canonical_program()
+    rival = materialize_rival(canonical)
+    from arc_repl.racket_bridge import RacketBridge
+
+    with RacketBridge(timeout=20) as bridge:
+        canonical_outputs = [
+            _execute(bridge, canonical, grid, f"canonical_demo_{index}")
+            for index, grid in enumerate(demo_inputs)
+        ]
+        rival_outputs = [
+            _execute(bridge, rival, grid, f"rival_demo_{index}")
+            for index, grid in enumerate(demo_inputs)
+        ]
+        canonical_query = _execute(bridge, canonical, query_input, "canonical_query")
+        rival_query = _execute(bridge, rival, query_input, "rival_query")
+
+    demos = [
+        {"input": copy.deepcopy(grid), "output": copy.deepcopy(output)}
+        for grid, output in zip(demo_inputs, canonical_outputs)
+    ]
+    reasons = module.lesson_identifiable(demos, {"input": copy.deepcopy(query_input)})
+    query_scenes = _scene_summary(module, query_input)
+    if len(query_scenes) != 1:
+        raise AssertionError("probe query must contain exactly one frame")
+    query_scene = query_scenes[0]
+    diff_cells = sum(
+        actual != rival_cell
+        for actual_row, rival_row in zip(canonical_query, rival_query)
+        for actual, rival_cell in zip(actual_row, rival_row)
+    )
+
+    return {
+        "schema": "arc-peer-shortcut-probe-v1",
+        "assignment_id": ASSIGNMENT_ID,
+        "task_id": TASK_ID,
+        "status": "finding",
+        "generator_path": str(source_path.relative_to(ROOT)),
+        "generator_sha256": source_sha256,
+        "canonical_program_sha256": _sha(canonical.encode("utf-8")),
+        "rival_program_sha256": _sha(rival.encode("utf-8")),
+        "shortcut_key": SHORTCUT_KEY,
+        "shortcut": (
+            "Behave canonically except suppress a wall-terminated ray for key 1; "
+            "blocked key-1 rays remain canonical."
+        ),
+        "lesson_identifiable": reasons,
+        "rival_matches_all_demonstrations": rival_outputs == canonical_outputs,
+        "demonstration_scenes": [
+            _scene_summary(module, grid) for grid in demo_inputs
+        ],
+        "query_scenes": query_scenes,
+        "query_key": query_scene["key"],
+        "query_blocked": query_scene["blocked"],
+        "query_diff_cells": diff_cells,
+        "demonstrations": demos,
+        "query": {
+            "input": query_input,
+            "canonical_output": canonical_query,
+            "rival_output": rival_query,
+        },
+        "scope": (
+            "One exact source, seed 0 ordinary four-demonstration schedule, one "
+            "lawful generated query, two protected-Racket programs. No production edit."
+        ),
+    }
+
+
+def main() -> int:
+    report = build_case()
+    if report["lesson_identifiable"] != []:
+        raise AssertionError("existing lesson gate rejected the retained query")
+    if not report["rival_matches_all_demonstrations"]:
+        raise AssertionError("rival failed a visible demonstration")
+    if report["query_diff_cells"] <= 0:
+        raise AssertionError("rival did not alter the query")
+    canonical = canonical_program()
+    rival = materialize_rival(canonical)
+    (HERE / "canonical.rkt").write_text(canonical + "\n", encoding="utf-8")
+    (HERE / "rival.rkt").write_text(rival + "\n", encoding="utf-8")
+    (HERE / "evidence.json").write_bytes(_json_bytes(report))
+    print(json.dumps({
+        "status": report["status"],
+        "generator_sha256": report["generator_sha256"],
+        "lesson_identifiable": report["lesson_identifiable"],
+        "rival_matches_all_demonstrations": report["rival_matches_all_demonstrations"],
+        "query_diff_cells": report["query_diff_cells"],
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
