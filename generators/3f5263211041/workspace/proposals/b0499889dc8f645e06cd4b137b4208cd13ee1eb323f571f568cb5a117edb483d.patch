+from __future__ import annotations
+
+import copy
+import pytest
+
+from reviewer_support import find_root, load_selected_generator
+
+ROOT = find_root(__file__)
+GEN, _SOURCE, _SOURCE_SHA256 = load_selected_generator("361d168ac72d", root=ROOT)
+
+
+def _components(grid: list[list[int]]) -> list[set[tuple[int, int]]]:
+    h, w = len(grid), len(grid[0])
+    unseen = {(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0}
+    result = []
+    while unseen:
+        start = unseen.pop()
+        color = grid[start[0]][start[1]]
+        todo = [start]
+        cells = {start}
+        while todo:
+            r, c = todo.pop()
+            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if (rr, cc) in unseen and grid[rr][cc] == color:
+                    unseen.remove((rr, cc))
+                    cells.add((rr, cc))
+                    todo.append((rr, cc))
+        result.append(cells)
+    return result
+
+
+def _orientation(cells: set[tuple[int, int]]) -> str:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    height = max(rows) - min(rows) + 1
+    width = max(cols) - min(cols) + 1
+    if height > width:
+        return "tall"
+    if width > height:
+        return "wide"
+    return "square"
+
+
+def test_reported_seed_contains_all_three_required_orientations() -> None:
+    grid = GEN.generate(0, 1, difficulty="easy")
+    assert GEN.self_check(grid) == []
+    assert {_orientation(cells) for cells in _components(grid)} == {
+        "tall",
+        "wide",
+        "square",
+    }
+
+
+@pytest.mark.parametrize("difficulty", ["easy", "medium", "hard"])
+def test_default_draws_preserve_requested_curriculum(difficulty: str) -> None:
+    for seed in range(64):
+        grid = GEN.generate(seed, seed % 7, difficulty=difficulty)
+        components = _components(grid)
+        assert 3 <= len(components) <= 5
+        assert {"tall", "wide", "square"} <= {
+            _orientation(cells) for cells in components
+        }
+        assert GEN.self_check(grid, difficulty=difficulty) == []
+
+
+def test_self_check_rejects_an_ordinary_grid_missing_a_required_class() -> None:
+    grid = GEN.generate(17, 3, difficulty="medium")
+    components = _components(grid)
+    wide = next(cells for cells in components if _orientation(cells) == "wide")
+    broken = copy.deepcopy(grid)
+    for r, c in wide:
+        broken[r][c] = 0
+    errors = GEN.self_check(broken, difficulty="medium")
+    assert errors
+    assert any("wide" in error for error in errors)
