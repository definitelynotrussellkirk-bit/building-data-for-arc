+#!/usr/bin/env python3
+"""Protected-Racket replay and bounded curriculum audit for d1bdd8b75ba4.
+
+The probe preserves the exact pre-repair counterexample, then checks the
+repaired source over a finite schedule.  It uses demonstration outputs only to
+adjudicate the declared distinct-column rival; query labels are checked only
+for authority parity, never for rival selection.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "d1bdd8b75ba4"
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parent
+COUNTEREXAMPLE = TASK_HOME / "counterexamples/review-b479175913430c66-v0001/most_columns_lesson.json"
+BANDS = ("easy", "medium", "hard")
+SEEDS = (0, 17)
+
+MOST_COLUMNS_RACKET = r'''(rule!
+  (let* ((colors (grid-colors g 0))
+         (column-count
+          (lambda (color)
+            (length
+             (remove-duplicates
+              (map second
+                   (filter (lambda (cell) (= (third cell) color))
+                           (grid-cells g)))))))
+         (best (first (sort colors
+                            (lambda (a b)
+                              (if (= (column-count a) (column-count b))
+                                  (< a b)
+                                  (> (column-count a) (column-count b)))))))
+         (n (column-count best)))
+    (for/fold ([out (empty-grid (rows g) (cols g) 0)])
+              ([c (in-range 0 (min n (cols g)))])
+      (set-cell out (- (rows g) 1) c best))))'''
+
+
+def _canonical_program(root: Path) -> str:
+    programs: set[str] = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                source = row.get("program_solution")
+                if not isinstance(source, str) or not source.strip():
+                    raise ValueError("canonical row has no program_solution")
+                programs.add(source)
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+class RacketEvaluator:
+    def __init__(self) -> None:
+        from arc_repl.racket_bridge import RacketBridge
+        from puzzle_generators.rule_wrap import wrap_rule
+
+        self._bridge = RacketBridge()
+        self._wrap_rule = wrap_rule
+        self._wrapped: dict[str, str] = {}
+        self.identity = self._bridge.runtime_identity
+        if self.identity.get("backend") != "racket" or self.identity.get("protected") is not True:
+            self._bridge.close()
+            raise RuntimeError("protected Racket backend is required")
+        self.evaluations = 0
+
+    def apply(self, source: str, grid: list[list[int]]) -> list[list[int]]:
+        self._wrapped.setdefault(source, self._wrap_rule(source))
+        literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+        self.evaluations += 1
+        value = self._bridge.eval_text(f"({self._wrapped[source]} {literal})")
+        if not isinstance(value, list) or any(not isinstance(row, list) for row in value):
+            raise TypeError("Racket program returned a non-grid value")
+        return value
+
+    def close(self) -> None:
+        self._bridge.close()
+
+
+def _sha(value: Any) -> str:
+    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def run(*, starts: int) -> dict[str, Any]:
+    if type(starts) is not int or not 1 <= starts <= 64:
+        raise ValueError("starts must be an exact integer in 1..64")
+    root = find_root(__file__)
+    generator, source_path, source_sha = load_selected_generator(TASK_ID, root=root)
+    canonical = _canonical_program(root)
+    pre = json.loads(COUNTEREXAMPLE.read_text())
+    evaluator = RacketEvaluator()
+    try:
+        pre_rows = []
+        for row in pre["pairs"]:
+            canonical_output = evaluator.apply(canonical, row["input"])
+            rival_output = evaluator.apply(MOST_COLUMNS_RACKET, row["input"])
+            pre_rows.append({
+                "sample_index": row["sample_index"],
+                "canonical_matches_retained": canonical_output == row["canonical_output"],
+                "rival_matches_retained": rival_output == row["most_columns_output"],
+                "rival_fits_canonical": rival_output == canonical_output,
+                "input_sha256": _sha(row["input"]),
+            })
+        pre_replay = {
+            "difficulty": pre["difficulty"],
+            "demo_indices": pre["demo_indices"],
+            "canonical_matches_retained": all(row["canonical_matches_retained"] for row in pre_rows),
+            "rival_matches_retained": all(row["rival_matches_retained"] for row in pre_rows),
+            "demos_all_fit": all(row["rival_fits_canonical"] for row in pre_rows[:-1]),
+            "query_disagrees": not pre_rows[-1]["rival_fits_canonical"],
+            "rows": pre_rows,
+        }
+
+        cases = []
+        failures = []
+        compact_witnesses = 0
+        for band in BANDS:
+            for seed in SEEDS:
+                for start in range(starts):
+                    pairs = []
+                    for offset in range(generator.EXAMPLES_NEEDED + 1):
+                        sample_index = start + offset
+                        grid = generator.generate(seed, sample_index, difficulty=band)
+                        errors = generator.self_check(deepcopy(grid))
+                        truth = generator.rule_mirror(deepcopy(grid))
+                        racket_truth = evaluator.apply(canonical, grid)
+                        rival = evaluator.apply(MOST_COLUMNS_RACKET, grid)
+                        analysis = generator._analysis(grid)
+                        if analysis.get("compact_runner"):
+                            compact_witnesses += 1
+                        pairs.append({
+                            "sample_index": sample_index,
+                            "profile": analysis.get("scene_profile"),
+                            "self_check": errors,
+                            "authority_matches": racket_truth == truth,
+                            "rival_matches": rival == truth,
+                            "winner_count": analysis.get("winner_count"),
+                            "winner_distinct_columns": analysis.get("winner_distinct_columns"),
+                            "winner_reuses_column": analysis.get("winner_reuses_column"),
+                            "input_sha256": _sha(grid),
+                        })
+                    demos = [
+                        {
+                            "input": generator.generate(seed, start + offset, difficulty=band),
+                            "output": generator.rule_mirror(generator.generate(seed, start + offset, difficulty=band)),
+                        }
+                        for offset in range(generator.EXAMPLES_NEEDED)
+                    ]
+                    query_grid = generator.generate(seed, start + generator.EXAMPLES_NEEDED, difficulty=band)
+                    query = {"input": query_grid, "output": generator.rule_mirror(query_grid)}
+                    reasons = generator.lesson_identifiable(deepcopy(demos), deepcopy(query))
+                    demo_survives = all(row["rival_matches"] for row in pairs[:-1])
+                    case = {
+                        "band": band,
+                        "seed": seed,
+                        "start": start,
+                        "demo_indices": list(range(start, start + generator.EXAMPLES_NEEDED)),
+                        "query_index": start + generator.EXAMPLES_NEEDED,
+                        "demo_survives": demo_survives,
+                        "lesson_reasons": reasons,
+                        "pairs": pairs,
+                    }
+                    cases.append(case)
+                    if any(row["self_check"] for row in pairs):
+                        failures.append(f"self_check failure: {band=} {seed=} {start=}")
+                    if not all(row["authority_matches"] for row in pairs):
+                        failures.append(f"Racket/Python mismatch: {band=} {seed=} {start=}")
+                    if demo_survives:
+                        failures.append(f"distinct-column rival survived demos: {band=} {seed=} {start=}")
+                    if reasons:
+                        failures.append(f"lesson gate rejected repaired lesson: {band=} {seed=} {start=} {reasons=}")
+                    compact = [row for row in pairs[:-1] if row["profile"].endswith("compact_runner")]
+                    if len(compact) != 1 or not compact[0]["winner_reuses_column"]:
+                        failures.append(f"missing constructive repeated-column witness: {band=} {seed=} {start=}")
+
+        pre_ok = all((
+            pre_replay["canonical_matches_retained"],
+            pre_replay["rival_matches_retained"],
+            pre_replay["demos_all_fit"],
+            pre_replay["query_disagrees"],
+        ))
+        if not pre_ok:
+            failures.append("pre-repair protected-Racket replay did not reproduce the retained defect")
+
+        return {
+            "schema": "d1bdd8b75ba4-most-distinct-columns-audit-v1",
+            "task_id": TASK_ID,
+            "status": "pass" if not failures else "fail",
+            "source": {
+                "path": source_path.relative_to(root).as_posix(),
+                "sha256": source_sha,
+                "version": generator.VERSION,
+                "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+                "rival_program_sha256": hashlib.sha256(MOST_COLUMNS_RACKET.encode()).hexdigest(),
+                "counterexample_sha256": hashlib.sha256(COUNTEREXAMPLE.read_bytes()).hexdigest(),
+            },
+            "scope": {
+                "bands": list(BANDS),
+                "seeds": list(SEEDS),
+                "starts_per_band_seed": starts,
+                "cases": len(cases),
+                "pairs": sum(len(case["pairs"]) for case in cases),
+                "claim": "finite source-bound protected-Racket audit of one declared shortcut",
+                "query_outputs_used_for_rival_selection": False,
+            },
+            "pre_repair_replay": pre_replay,
+            "post_repair": {
+                "cases": cases,
+                "constructive_compact_witness_occurrences": compact_witnesses,
+                "all_authority_labels_match": all(
+                    row["authority_matches"] for case in cases for row in case["pairs"]
+                ),
+                "all_lessons_reject_rival_from_demos": all(not case["demo_survives"] for case in cases),
+                "all_lesson_gates_pass": all(not case["lesson_reasons"] for case in cases),
+            },
+            "racket": {**evaluator.identity, "evaluations": evaluator.evaluations},
+            "failures": failures,
+        }
+    finally:
+        evaluator.close()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--starts", type=int, default=8)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run(starts=args.starts)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    temporary = args.out.with_name(args.out.name + ".tmp")
+    temporary.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    os.replace(temporary, args.out)
+    print(json.dumps({
+        "status": report["status"],
+        "source_sha256": report["source"]["sha256"],
+        "cases": report["scope"]["cases"],
+        "pairs": report["scope"]["pairs"],
+        "racket_evaluations": report["racket"]["evaluations"],
+        "failures": len(report["failures"]),
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0 if report["status"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
