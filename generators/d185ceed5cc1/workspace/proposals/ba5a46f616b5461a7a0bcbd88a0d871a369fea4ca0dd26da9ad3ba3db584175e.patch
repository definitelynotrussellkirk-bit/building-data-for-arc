+#!/usr/bin/env python3
+"""Finite protected-Racket recheck for the exact vertical-three curriculum."""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "17b0b2791dd2"
+BANDS = (None, "easy", "medium", "hard")
+SEEDS = (0, 17)
+
+RIVAL_VERTICAL_ANY_LENGTH = r'''(rule!
+  (let ((blue (filter (lambda (obj) (= (obj-color obj) 1)) (objects g 0))))
+    (for/fold ([out g]) ([obj (in-list blue)])
+      (let ([norm (normalize-cells (obj-cells obj))])
+        (if (and (pair? norm)
+                 (andmap (lambda (cell) (= (second cell) 0)) norm))
+            (paint-cells out (obj-cells obj) 2)
+            out)))))'''
+
+RIVAL_ANY_THREE_CELLS = r'''(rule!
+  (let ((blue (filter (lambda (obj) (= (obj-color obj) 1)) (objects g 0))))
+    (for/fold ([out g]) ([obj (in-list blue)])
+      (if (= (length (obj-cells obj)) 3)
+          (paint-cells out (obj-cells obj) 2)
+          out))))'''
+
+
+def canonical_program(root: Path) -> str:
+    programs = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            if line.strip():
+                row = json.loads(line)
+                if row.get("task_id") == TASK_ID:
+                    source = row.get("program_solution")
+                    if isinstance(source, str) and source.strip():
+                        programs.add(source)
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+class Evaluator:
+    def __init__(self) -> None:
+        from arc_repl.racket_bridge import RacketBridge
+        from puzzle_generators.rule_wrap import wrap_rule
+        self.bridge = RacketBridge()
+        self.wrap_rule = wrap_rule
+        self.wrapped: dict[str, str] = {}
+        self.identity = self.bridge.runtime_identity
+        if self.identity.get("backend") != "racket" or self.identity.get("protected") is not True:
+            self.bridge.close()
+            raise RuntimeError("protected Racket backend required")
+        self.evaluations = 0
+
+    def apply(self, source: str, grid: list[list[int]]) -> list[list[int]]:
+        self.wrapped.setdefault(source, self.wrap_rule(source))
+        literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+        self.evaluations += 1
+        result = self.bridge.eval_text(f"({self.wrapped[source]} {literal})")
+        if not isinstance(result, list) or any(not isinstance(row, list) for row in result):
+            raise TypeError("program returned non-grid")
+        return result
+
+    def close(self) -> None:
+        self.bridge.close()
+
+
+def digest(value: Any) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def run(starts: int) -> dict[str, Any]:
+    if type(starts) is not int or not 1 <= starts <= 32:
+        raise ValueError("starts must be exact integer in 1..32")
+    root = find_root(__file__)
+    generator, source_path, source_sha = load_selected_generator(TASK_ID, root=root)
+    canonical = canonical_program(root)
+    rivals = {
+        "recolor_every_vertical_line": RIVAL_VERTICAL_ANY_LENGTH,
+        "recolor_every_three_cell_component": RIVAL_ANY_THREE_CELLS,
+    }
+    evaluator = Evaluator()
+    cases: list[dict[str, Any]] = []
+    failures: list[str] = []
+    try:
+        for band in BANDS:
+            for seed in SEEDS:
+                for start in range(starts):
+                    pairs = []
+                    for offset in range(generator.EXAMPLES_NEEDED + 1):
+                        index = start + offset
+                        grid = generator.generate(seed, index, difficulty=band)
+                        truth = generator.rule_mirror(deepcopy(grid))
+                        authority = evaluator.apply(canonical, grid)
+                        rival_matches = {
+                            name: evaluator.apply(source, grid) == authority
+                            for name, source in rivals.items()
+                        }
+                        pairs.append({
+                            "sample_index": index,
+                            "input_sha256": digest(grid),
+                            "self_check": generator.self_check(deepcopy(grid)),
+                            "authority_matches_python_mirror": authority == truth,
+                            "rival_matches": rival_matches,
+                            "observed": generator.observe_overrides(deepcopy(grid)),
+                        })
+                    demos = pairs[:-1]
+                    survivors = [
+                        name for name in rivals
+                        if all(row["rival_matches"][name] for row in demos)
+                    ]
+                    demo_pairs = []
+                    for offset in range(generator.EXAMPLES_NEEDED):
+                        grid = generator.generate(seed, start + offset, difficulty=band)
+                        demo_pairs.append({"input": grid, "output": generator.rule_mirror(grid)})
+                    qgrid = generator.generate(seed, start + generator.EXAMPLES_NEEDED, difficulty=band)
+                    query = {"input": qgrid, "output": generator.rule_mirror(qgrid)}
+                    reasons = generator.lesson_identifiable(deepcopy(demo_pairs), deepcopy(query))
+                    case = {
+                        "band": band,
+                        "seed": seed,
+                        "start": start,
+                        "survivors": survivors,
+                        "lesson_reasons": reasons,
+                        "pairs": pairs,
+                    }
+                    cases.append(case)
+                    if any(row["self_check"] for row in pairs):
+                        failures.append(f"self_check failure: {band=} {seed=} {start=}")
+                    if not all(row["authority_matches_python_mirror"] for row in pairs):
+                        failures.append(f"authority mismatch: {band=} {seed=} {start=}")
+                    if survivors:
+                        failures.append(f"rivals survived: {band=} {seed=} {start=} {survivors=}")
+                    if reasons:
+                        failures.append(f"lesson gate failed: {band=} {seed=} {start=} {reasons=}")
+        return {
+            "schema": "17b0b2791dd2-protected-recheck-v1",
+            "task_id": TASK_ID,
+            "status": "pass" if not failures else "fail",
+            "source": {
+                "path": source_path.relative_to(root).as_posix(),
+                "sha256": source_sha,
+                "version": generator.VERSION,
+                "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+                "rivals": {name: hashlib.sha256(source.encode()).hexdigest() for name, source in rivals.items()},
+            },
+            "scope": {
+                "bands": list(BANDS),
+                "seeds": list(SEEDS),
+                "starts_per_band_seed": starts,
+                "cases": len(cases),
+                "pairs": sum(len(case["pairs"]) for case in cases),
+                "claim": "finite protected-Racket recheck of two declared rivals",
+                "query_outputs_used_for_rival_selection": False,
+            },
+            "cases": cases,
+            "summary": {
+                "all_authority_labels_match": all(
+                    row["authority_matches_python_mirror"] for case in cases for row in case["pairs"]
+                ),
+                "all_rivals_rejected_by_demos": all(not case["survivors"] for case in cases),
+                "all_lesson_gates_pass": all(not case["lesson_reasons"] for case in cases),
+            },
+            "racket": {**evaluator.identity, "evaluations": evaluator.evaluations},
+            "failures": failures,
+        }
+    finally:
+        evaluator.close()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--starts", type=int, default=4)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run(args.starts)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    temp = args.out.with_name(args.out.name + ".tmp")
+    temp.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    os.replace(temp, args.out)
+    print(json.dumps({
+        "status": report["status"],
+        "source_sha256": report["source"]["sha256"],
+        "cases": report["scope"]["cases"],
+        "pairs": report["scope"]["pairs"],
+        "racket_evaluations": report["racket"]["evaluations"],
+        "failures": len(report["failures"]),
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0 if report["status"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
