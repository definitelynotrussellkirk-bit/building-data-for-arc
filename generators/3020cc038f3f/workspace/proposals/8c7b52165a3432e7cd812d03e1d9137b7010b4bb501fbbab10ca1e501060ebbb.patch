+(rule!
+  (let ((dummy 0))
+    (define (first-two xs)
+      (cond [(empty? xs) (list)]
+            [(empty? (rest xs)) xs]
+            [else (list (first xs) (second xs))]))
+    (let ((cols-hit
+            (first-two
+              (filter (lambda (c) (= (at g 0 c) 1))
+                      (range 1 (cols g)))))
+          (rows-hit
+            (filter (lambda (r) (= (at g r 0) 2))
+                    (range 1 (rows g)))))
+      (for*/fold ((out g))
+                 ((r (in-list rows-hit))
+                  (c (in-list cols-hit)))
+        (set-cell out r c 4)))))
