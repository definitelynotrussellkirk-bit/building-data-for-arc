+"""Source-bound ambiguity probe for the two-leftmost-header shortcut."""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+TASK_ID = "47c6b843eaf0"
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[2]
+RIVAL_PATH = HERE / "two_leftmost_shortcut.rkt"
+
+
+def _grid(value: Any) -> list[list[int]]:
+    if type(value) is not list or not value:
+        raise ValueError("expected a nonempty grid")
+    if all(type(row) is str for row in value):
+        result = [[int(cell) for cell in row] for row in value]
+    else:
+        result = [list(row) for row in value]
+    if not result[0] or any(len(row) != len(result[0]) for row in result):
+        raise ValueError("grid must be rectangular")
+    return result
+
+
+def _variant() -> dict[str, Any]:
+    sys.path.insert(0, str(REPO / "src"))
+    from arcpuzzles import Catalog
+
+    variants = Catalog(REPO).get(TASK_ID)["variants"]
+    if len(variants) != 1:
+        raise ValueError(f"expected one selected variant, found {len(variants)}")
+    return variants[0]
+
+
+def apply_python(grid: list[list[int]], *, two_leftmost_only: bool) -> list[list[int]]:
+    result = copy.deepcopy(_grid(grid))
+    columns = [col for col in range(1, len(result[0])) if result[0][col] == 1]
+    if two_leftmost_only:
+        columns = columns[:2]
+    rows = [row for row in range(1, len(result)) if result[row][0] == 2]
+    for row in rows:
+        for col in columns:
+            result[row][col] = 4
+    return result
+
+
+def _diff_cells(first: list[list[int]], second: list[list[int]]) -> int:
+    return sum(a != b for row_a, row_b in zip(first, second) for a, b in zip(row_a, row_b))
+
+
+def python_characterization() -> dict[str, Any]:
+    variant = _variant()
+    train = [
+        {"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+        for pair in variant["train"]
+    ]
+    raw_test = variant["test"] if isinstance(variant["test"], list) else [variant["test"]]
+    test = [
+        {"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+        for pair in raw_test
+    ]
+    demo_predictions = [apply_python(pair["input"], two_leftmost_only=True) for pair in train]
+    query_predictions = [apply_python(pair["input"], two_leftmost_only=True) for pair in test]
+    return {
+        "demo_matches": [prediction == pair["output"] for prediction, pair in zip(demo_predictions, train)],
+        "query_matches": [prediction == pair["output"] for prediction, pair in zip(query_predictions, test)],
+        "query_different_cells": [
+            _diff_cells(prediction, pair["output"])
+            for prediction, pair in zip(query_predictions, test)
+        ],
+    }
+
+
+class RacketRunner:
+    def __enter__(self):
+        from arc_repl.racket_bridge import RacketBridge
+
+        self.bridge = RacketBridge()
+        self.identity = self.bridge.runtime_identity
+        if self.identity.get("backend") != "racket" or self.identity.get("protected") is not True:
+            self.bridge.close()
+            raise RuntimeError("protected Racket runtime required")
+        self.cache: dict[str, str] = {}
+        return self
+
+    def __call__(self, source: str, grid: list[list[int]]) -> list[list[int]]:
+        from puzzle_generators.rule_wrap import wrap_rule
+
+        if source not in self.cache:
+            self.cache[source] = wrap_rule(source)
+        literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+        return self.bridge.eval_text(f"({self.cache[source]} {literal})")
+
+    def __exit__(self, *_exc):
+        self.bridge.close()
+
+
+def protected_report() -> dict[str, Any]:
+    variant = _variant()
+    canonical = variant["program_solution"]
+    rival = RIVAL_PATH.read_text(encoding="utf-8")
+    train = [
+        {"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+        for pair in variant["train"]
+    ]
+    raw_test = variant["test"] if isinstance(variant["test"], list) else [variant["test"]]
+    test = [
+        {"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+        for pair in raw_test
+    ]
+    with RacketRunner() as execute:
+        demo_records = []
+        for index, pair in enumerate(train):
+            intended = execute(canonical, pair["input"])
+            shortcut = execute(rival, pair["input"])
+            demo_records.append(
+                {
+                    "index": index,
+                    "input": pair["input"],
+                    "published_output": pair["output"],
+                    "canonical_output": intended,
+                    "shortcut_output": shortcut,
+                    "canonical_matches": intended == pair["output"],
+                    "shortcut_matches": shortcut == pair["output"],
+                }
+            )
+        query_records = []
+        for index, pair in enumerate(test):
+            intended = execute(canonical, pair["input"])
+            shortcut = execute(rival, pair["input"])
+            query_records.append(
+                {
+                    "index": index,
+                    "input": pair["input"],
+                    "published_output": pair["output"],
+                    "canonical_output": intended,
+                    "shortcut_output": shortcut,
+                    "canonical_matches": intended == pair["output"],
+                    "shortcut_matches": shortcut == pair["output"],
+                    "different_cells": _diff_cells(intended, shortcut),
+                }
+            )
+        runtime_identity = execute.identity
+
+    if not all(record["canonical_matches"] and record["shortcut_matches"] for record in demo_records):
+        raise RuntimeError("shortcut does not fit every demonstration under protected Racket")
+    if not all(record["canonical_matches"] and not record["shortcut_matches"] for record in query_records):
+        raise RuntimeError("shortcut does not disagree on every query under protected Racket")
+    generator = REPO / f"generators/{TASK_ID}/generator.py"
+    return {
+        "schema": "arcpuzzles-peer-lesson-ambiguity-v1",
+        "task_id": TASK_ID,
+        "finding": (
+            "Both demonstrations contain exactly two top-row markers, so the plausible "
+            "shortcut 'use only the two leftmost top markers' fits them exactly. The query "
+            "contains three markers and the shortcut omits one full intersection column."
+        ),
+        "status": "reproduced",
+        "canonical_program": canonical,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "shortcut_program": rival,
+        "shortcut_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "generator_sha256": hashlib.sha256(generator.read_bytes()).hexdigest(),
+        "runtime_identity": runtime_identity,
+        "demonstrations": demo_records,
+        "queries": query_records,
+        "suggested_repair": (
+            "Include a visible demonstration with at least three top markers, or reject lessons "
+            "while a capped-two-column competitor survives the demonstrations."
+        ),
+        "limits": "One source-bound canonical lesson and one explicit shortcut; not a universal ambiguity proof.",
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = protected_report()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "task_id": TASK_ID,
+                "demo_matches": [r["shortcut_matches"] for r in report["demonstrations"]],
+                "query_different_cells": [r["different_cells"] for r in report["queries"]],
+                "out": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
