+"""Source-bound ambiguity probe for clamping zero marker count to one."""
+from __future__ import annotations
+
+import argparse
+from collections import deque
+import hashlib
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+TASK_ID = "49a0b77dcc7f"
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[2]
+RIVAL_PATH = HERE / "clamp_zero_to_one_shortcut.rkt"
+_CARDINAL = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _grid(value: Any) -> list[list[int]]:
+    if type(value) is not list or not value:
+        raise ValueError("expected a nonempty grid")
+    if all(type(row) is str for row in value):
+        result = [[int(cell) for cell in row] for row in value]
+    else:
+        result = [list(row) for row in value]
+    if not result[0] or any(len(row) != len(result[0]) for row in result):
+        raise ValueError("grid must be rectangular")
+    return result
+
+
+def _variant() -> dict[str, Any]:
+    sys.path.insert(0, str(REPO / "src"))
+    from arcpuzzles import Catalog
+
+    variants = Catalog(REPO).get(TASK_ID)["variants"]
+    if len(variants) != 1:
+        raise ValueError(f"expected one selected variant, found {len(variants)}")
+    return variants[0]
+
+
+def _components(grid: list[list[int]], color: int) -> list[frozenset[tuple[int, int]]]:
+    height, width = len(grid), len(grid[0])
+    unseen = {
+        (row, col)
+        for row in range(height)
+        for col in range(width)
+        if grid[row][col] == color
+    }
+    result = []
+    while unseen:
+        start = min(unseen)
+        todo = [start]
+        seen = {start}
+        unseen.remove(start)
+        while todo:
+            row, col = todo.pop()
+            for drow, dcol in _CARDINAL:
+                point = (row + drow, col + dcol)
+                if point in unseen:
+                    unseen.remove(point)
+                    seen.add(point)
+                    todo.append(point)
+        result.append(frozenset(seen))
+    return sorted(result, key=lambda cells: min(cells))
+
+
+def _bbox(cells: frozenset[tuple[int, int]]) -> tuple[int, int, int, int]:
+    return (
+        min(row for row, _col in cells),
+        min(col for _row, col in cells),
+        max(row for row, _col in cells),
+        max(col for _row, col in cells),
+    )
+
+
+def _hole_count(grid: list[list[int]], cells: frozenset[tuple[int, int]]) -> int:
+    r0, c0, r1, c1 = _bbox(cells)
+    zeros = {
+        (row, col)
+        for row in range(r0, r1 + 1)
+        for col in range(c0, c1 + 1)
+        if grid[row][col] == 0
+    }
+    holes = 0
+    while zeros:
+        start = min(zeros)
+        todo = deque([start])
+        seen = {start}
+        zeros.remove(start)
+        touches = start[0] in (r0, r1) or start[1] in (c0, c1)
+        while todo:
+            row, col = todo.popleft()
+            for drow, dcol in _CARDINAL:
+                point = (row + drow, col + dcol)
+                if point in zeros:
+                    zeros.remove(point)
+                    seen.add(point)
+                    todo.append(point)
+                    touches = touches or point[0] in (r0, r1) or point[1] in (c0, c1)
+        holes += not touches
+    return holes
+
+
+def apply_python(grid: list[list[int]], *, clamp_zero: bool) -> list[list[int]]:
+    grid = _grid(grid)
+    k = sum(value == 1 for value in grid[0])
+    target = max(1, k) if clamp_zero else k
+    candidates = [
+        cells for cells in _components(grid, 7) if _hole_count(grid, cells) == target
+    ]
+    if not candidates:
+        raise ValueError(f"no color-7 object has {target} holes")
+    r0, c0, r1, c1 = _bbox(candidates[0])
+    return [row[c0 : c1 + 1] for row in grid[r0 : r1 + 1]]
+
+
+def python_characterization() -> dict[str, Any]:
+    variant = _variant()
+    train = [
+        {"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+        for pair in variant["train"]
+    ]
+    raw_test = variant["test"] if isinstance(variant["test"], list) else [variant["test"]]
+    test = [
+        {"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+        for pair in raw_test
+    ]
+    demo_predictions = [apply_python(pair["input"], clamp_zero=True) for pair in train]
+    query_predictions = [apply_python(pair["input"], clamp_zero=True) for pair in test]
+    return {
+        "demo_matches": [prediction == pair["output"] for prediction, pair in zip(demo_predictions, train)],
+        "query_matches": [prediction == pair["output"] for prediction, pair in zip(query_predictions, test)],
+        "canonical_query_shape": [len(test[0]["output"]), len(test[0]["output"][0])],
+        "rival_query_shape": [len(query_predictions[0]), len(query_predictions[0][0])],
+    }
+
+
+class RacketRunner:
+    def __enter__(self):
+        from arc_repl.racket_bridge import RacketBridge
+
+        self.bridge = RacketBridge()
+        self.identity = self.bridge.runtime_identity
+        if self.identity.get("backend") != "racket" or self.identity.get("protected") is not True:
+            self.bridge.close()
+            raise RuntimeError("protected Racket runtime required")
+        self.cache: dict[str, str] = {}
+        return self
+
+    def __call__(self, source: str, grid: list[list[int]]) -> list[list[int]]:
+        from puzzle_generators.rule_wrap import wrap_rule
+
+        if source not in self.cache:
+            self.cache[source] = wrap_rule(source)
+        literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+        return self.bridge.eval_text(f"({self.cache[source]} {literal})")
+
+    def __exit__(self, *_exc):
+        self.bridge.close()
+
+
+def protected_report() -> dict[str, Any]:
+    variant = _variant()
+    canonical = variant["program_solution"]
+    rival = RIVAL_PATH.read_text(encoding="utf-8")
+    train = [
+        {"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+        for pair in variant["train"]
+    ]
+    raw_test = variant["test"] if isinstance(variant["test"], list) else [variant["test"]]
+    test = [
+        {"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+        for pair in raw_test
+    ]
+    with RacketRunner() as execute:
+        demo_records = []
+        for index, pair in enumerate(train):
+            intended = execute(canonical, pair["input"])
+            shortcut = execute(rival, pair["input"])
+            demo_records.append(
+                {
+                    "index": index,
+                    "marker_count": sum(value == 1 for value in pair["input"][0]),
+                    "input": pair["input"],
+                    "published_output": pair["output"],
+                    "canonical_output": intended,
+                    "shortcut_output": shortcut,
+                    "canonical_matches": intended == pair["output"],
+                    "shortcut_matches": shortcut == pair["output"],
+                }
+            )
+        query_records = []
+        for index, pair in enumerate(test):
+            intended = execute(canonical, pair["input"])
+            shortcut = execute(rival, pair["input"])
+            query_records.append(
+                {
+                    "index": index,
+                    "marker_count": sum(value == 1 for value in pair["input"][0]),
+                    "input": pair["input"],
+                    "published_output": pair["output"],
+                    "canonical_output": intended,
+                    "shortcut_output": shortcut,
+                    "canonical_matches": intended == pair["output"],
+                    "shortcut_matches": shortcut == pair["output"],
+                    "canonical_shape": [len(intended), len(intended[0])],
+                    "shortcut_shape": [len(shortcut), len(shortcut[0])],
+                }
+            )
+        runtime_identity = execute.identity
+
+    if not all(record["canonical_matches"] and record["shortcut_matches"] for record in demo_records):
+        raise RuntimeError("shortcut does not fit every demonstration under protected Racket")
+    if not all(record["canonical_matches"] and not record["shortcut_matches"] for record in query_records):
+        raise RuntimeError("shortcut does not disagree on every query under protected Racket")
+    generator = REPO / f"generators/{TASK_ID}/generator.py"
+    return {
+        "schema": "arcpuzzles-peer-lesson-ambiguity-v1",
+        "task_id": TASK_ID,
+        "finding": (
+            "The visible demonstrations use marker counts 1 and 2 only. Because the selected "
+            "generator declares k>=1 and rejects the canonical k=0 case, the plausible shortcut "
+            "max(1, marker_count) fits every demonstration but selects the one-hole object on the "
+            "zero-marker query instead of the canonical solid zero-hole object."
+        ),
+        "status": "reproduced",
+        "canonical_program": canonical,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "shortcut_program": rival,
+        "shortcut_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "generator_sha256": hashlib.sha256(generator.read_bytes()).hexdigest(),
+        "runtime_identity": runtime_identity,
+        "demonstrations": demo_records,
+        "queries": query_records,
+        "suggested_repair": (
+            "Add generator and validator support for k=0 with a unique zero-hole object, and "
+            "require a visible zero-marker demonstration or reject lessons while the clamp-to-one "
+            "competitor survives."
+        ),
+        "alternative_answer_stream": (
+            "The original lesson is a source-bound candidate for the optional alternate-answer "
+            "stream because both executable rules fit all demonstrations and disagree on the query."
+        ),
+        "limits": "One source-bound canonical lesson and one explicit shortcut; not a universal ambiguity proof.",
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = protected_report()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "task_id": TASK_ID,
+                "demo_matches": [r["shortcut_matches"] for r in report["demonstrations"]],
+                "query_shapes": [
+                    [r["canonical_shape"], r["shortcut_shape"]] for r in report["queries"]
+                ],
+                "out": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
