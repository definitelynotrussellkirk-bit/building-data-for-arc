+def test_rotation_before_reflection_precedence_is_visible_in_every_three_demo_window():
+    assert "reflection_before_rotation" in GEN.LESSON_COMPETITORS
+    witness = GEN.SEMANTIC_WITNESSES["rotation_reflection_overlap"]
+    rival = GEN.LESSON_COMPETITORS["reflection_before_rotation"]
+
+    for difficulty in ("easy", "medium", "hard"):
+        for start in range(8):
+            pairs = []
+            for sample_index in range(start, start + 4):
+                grid = GEN.generate(7300 + start, sample_index, difficulty=difficulty)
+                pairs.append({"input": grid, "output": GEN.rule_mirror(grid)})
+
+            demos, query = pairs[:3], pairs[3]
+            assert any(witness(pair["input"]) for pair in demos)
+            assert any(rival(pair["input"]) != pair["output"] for pair in demos)
+            assert GEN.lesson_identifiable(demos, query) == []
+
