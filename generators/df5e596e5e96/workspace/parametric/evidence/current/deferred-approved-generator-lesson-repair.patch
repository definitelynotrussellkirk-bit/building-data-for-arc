+    if errors:
+        raise ValueError("malformed input: " + "; ".join(errors))
+    panels = facts["panels"]
+    return [
+        [
+            8 if row == col else _relation_reflection_before_rotation(panels[row], panels[col])
+            for col in range(len(panels))
+        ]
+        for row in range(len(panels))
+    ]
