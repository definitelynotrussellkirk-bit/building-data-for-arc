+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+HERE = Path(__file__).resolve().parents[1]
+PROBE = HERE / "workspace" / "corner_box_lesson_probe.py"
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location("corner_box_lesson_probe", PROBE)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_corner_conditioned_shortcut_survives_demos_and_fails_query():
+    evidence = _load().probe()
+    assert evidence["task_id"] == "3143493b7c83"
+    assert evidence["source"]["generator_sha256"] == (
+        "d25c612ee0344b89343998c1ad3fd436eeea48607e2963e1735801ddca80fa7f"
+    )
+    assert evidence["lesson"]["seed"] == 9
+    assert evidence["lesson"]["corner_box"] == [True, True, True, False]
+    assert evidence["result"]["shortcut_matches_demonstrations"] == [True, True, True]
+    assert evidence["result"]["query_diff_cells"] == 10
+    assert evidence["runtime"]["backend"] == "racket"
+    assert evidence["runtime"]["protected"] is True
