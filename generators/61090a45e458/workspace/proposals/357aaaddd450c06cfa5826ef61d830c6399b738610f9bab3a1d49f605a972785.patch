+#!/usr/bin/env python3
+"""Replay a source-pinned nearest-template shortcut in protected Racket.
+
+The shortcut ignores exact normalized-shape identity and recolors each color-1
+object with the color of the template whose centroid is nearest in Manhattan
+distance.  Seed 163 yields three demonstrations that do not distinguish this
+shortcut from the canonical rule, followed by a four-template query that does.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared" / "runtime")]
+
+from arc_repl.racket_bridge import RacketBridge  # noqa: E402
+from arcpuzzles import Catalog  # noqa: E402
+from puzzle_generators.rule_wrap import wrap_rule  # noqa: E402
+from reviewer_support import load_selected_generator, normalize_grid  # noqa: E402
+
+
+TASK_ID = "51481963f4a3"
+SEED = 163
+EXPECTED_GENERATOR_SHA256 = (
+    "3dfa138fe7eea00abd096015c58e7969a90cc91277a6e0df6f051ed8c4da6239"
+)
+
+NEAREST_TEMPLATE_PROGRAM = r"""(rule! (lambda (g)
+         (let* ((objs (objects g 0))
+                (templates (filter (lambda (o) (!= (obj-color o) 1)) objs))
+                (ones (filter (lambda (o) (= (obj-color o) 1)) objs)))
+           (define (sum-rows o)
+             (apply + (map first (obj-cells o))))
+           (define (sum-cols o)
+             (apply + (map second (obj-cells o))))
+           (define (scaled-centroid-distance a b)
+             (+ (abs (- (* (sum-rows a) (obj-size b))
+                        (* (sum-rows b) (obj-size a))))
+                (abs (- (* (sum-cols a) (obj-size b))
+                        (* (sum-cols b) (obj-size a))))))
+           (paint-objects-by g
+                             ones
+                             (lambda (obj)
+                               (obj-color
+                                (argmin (lambda (template)
+                                          (scaled-centroid-distance obj template))
+                                        templates)))))))"""
+
+
+def _sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _execute(bridge: RacketBridge, program: str, grid: list[list[int]]) -> list[list[int]]:
+    literal = "'(" + " ".join(
+        "(" + " ".join(map(str, row)) + ")" for row in normalize_grid(grid)
+    ) + ")"
+    return normalize_grid(bridge.eval_text(f"({wrap_rule(program)} {literal})"))
+
+
+def _diff_cells(left: list[list[int]], right: list[list[int]]) -> int:
+    return sum(a != b for row_a, row_b in zip(left, right, strict=True)
+               for a, b in zip(row_a, row_b, strict=True))
+
+
+def probe() -> dict:
+    generator, source_path, source_sha256 = load_selected_generator(TASK_ID, root=ROOT)
+    if source_sha256 != EXPECTED_GENERATOR_SHA256:
+        raise RuntimeError(
+            f"selected generator changed: {source_sha256} != {EXPECTED_GENERATOR_SHA256}"
+        )
+    catalog = Catalog(ROOT)
+    canonical_program = catalog.get(TASK_ID)["variants"][0]["program_solution"]
+    grids = [generator.generate(SEED, index) for index in range(4)]
+    if grids != [generator.generate(SEED, index) for index in range(4)]:
+        raise RuntimeError("generator replay was not deterministic")
+    profiles = [generator.observe_overrides(grid).get("scene_profile") for grid in grids]
+    expected_profiles = ["two_bijection", "two_bijection", "single_match", "four_bijection"]
+    if profiles != expected_profiles:
+        raise RuntimeError(f"retained lesson profiles changed: {profiles}")
+
+    with RacketBridge(timeout=30, startup_timeout=60, max_calls_before_restart=64) as bridge:
+        identity = dict(bridge.runtime_identity)
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires the protected Racket backend")
+        canonical_outputs = [_execute(bridge, canonical_program, grid) for grid in grids]
+        shortcut_outputs = [_execute(bridge, NEAREST_TEMPLATE_PROGRAM, grid) for grid in grids]
+
+    mirror_outputs = [generator.rule_mirror(grid) for grid in grids]
+    if canonical_outputs != mirror_outputs:
+        raise RuntimeError("selected canonical Racket and generator rule_mirror disagree")
+    demo_matches = [shortcut_outputs[index] == canonical_outputs[index] for index in range(3)]
+    query_diff = _diff_cells(shortcut_outputs[3], canonical_outputs[3])
+    if demo_matches != [True, True, True] or query_diff != 17:
+        raise RuntimeError(
+            f"retained witness changed: demo_matches={demo_matches}, query_diff={query_diff}"
+        )
+
+    return {
+        "schema": "51481963f4a3-nearest-template-lesson-probe-v1",
+        "task_id": TASK_ID,
+        "source": {
+            "generator_path": str(source_path.relative_to(ROOT)),
+            "generator_sha256": source_sha256,
+            "probe_sha256": _sha_bytes(Path(__file__).read_bytes()),
+            "canonical_program_sha256": _sha_bytes(canonical_program.encode()),
+            "shortcut_program_sha256": _sha_bytes(NEAREST_TEMPLATE_PROGRAM.encode()),
+        },
+        "runtime": {
+            key: identity[key]
+            for key in ("schema", "backend", "protected", "binary_sha256", "prelude_sha256")
+            if key in identity
+        },
+        "lesson": {
+            "seed": SEED,
+            "sample_indices": [0, 1, 2, 3],
+            "demonstration_indices": [0, 1, 2],
+            "query_index": 3,
+            "profiles": profiles,
+        },
+        "shortcut": {
+            "name": "nearest_template_by_centroid_manhattan_distance",
+            "description": (
+                "Ignore shape identity and recolor each query with the nearest template's "
+                "color, using exact size-scaled centroid Manhattan distance."
+            ),
+        },
+        "result": {
+            "shortcut_matches_demonstrations": demo_matches,
+            "shortcut_matches_query": shortcut_outputs[3] == canonical_outputs[3],
+            "query_diff_cells": query_diff,
+        },
+        "witness": {
+            "query_input": deepcopy(grids[3]),
+            "canonical_output": canonical_outputs[3],
+            "shortcut_output": shortcut_outputs[3],
+        },
+        "scope": (
+            "One exact default seed and the consecutive sample window 0..3. "
+            "This is an executable counterexample, not a population prevalence estimate."
+        ),
+        "repair": (
+            "Include a demonstration where nearest-template position conflicts with exact "
+            "shape identity, or add this executable rival to lesson admission."
+        ),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--out",
+        type=Path,
+        default=HERE / "evidence" / "current" / "nearest-template-shortcut.json",
+    )
+    args = parser.parse_args()
+    evidence = probe()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(evidence, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": "witness_replayed",
+        "out": str(args.out),
+        "query_diff_cells": evidence["result"]["query_diff_cells"],
+    }))
+
+
+if __name__ == "__main__":
+    main()
