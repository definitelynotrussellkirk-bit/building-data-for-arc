+#!/usr/bin/env python3
+"""Replay a source-pinned corner-conditioned lesson shortcut in protected Racket.
+
+The shortcut applies the canonical rule only when the marker box occupies a
+canvas corner and otherwise returns the input unchanged.  Seed 9 exposes a
+three-demonstration lesson where every demonstration uses a corner box, while
+the next generated query uses a free interior box.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared" / "runtime")]
+
+from arc_repl.racket_bridge import RacketBridge  # noqa: E402
+from arcpuzzles import Catalog  # noqa: E402
+from puzzle_generators.rule_wrap import wrap_rule  # noqa: E402
+from reviewer_support import load_selected_generator, normalize_grid  # noqa: E402
+
+
+TASK_ID = "3143493b7c83"
+SEED = 9
+EXPECTED_GENERATOR_SHA256 = (
+    "d25c612ee0344b89343998c1ad3fd436eeea48607e2963e1735801ddca80fa7f"
+)
+
+CORNER_ONLY_PROGRAM = r"""(rule! (lambda (g)
+         (let* ((h (rows g))
+                (w (cols g))
+                (sp-color (find-first (lambda (v) (and (!= v 0) (!= v 1) (!= v 4)))
+                                      (grid-colors g)))
+                (sp-cells (find-color g sp-color))
+                (r0 (min-of first sp-cells))
+                (r1 (max-of first sp-cells))
+                (c0 (min-of second sp-cells))
+                (c1 (max-of second sp-cells))
+                (th (/ (+ 1 (- r1 r0)) 2))
+                (tw (/ (+ 1 (- c1 c0)) 2))
+                (rstarts (range 0 h 4))
+                (cstarts (range 0 w 4)))
+           (define (block-on? tr tc)
+             (for/or ((dr (range 0 2)))
+                     (for/or ((dc (range 0 2)))
+                             (= (at g (+ r0 (* tr 2) dr) (+ c0 (* tc 2) dc)) sp-color))))
+           (define template
+             (filter (lambda (p) (block-on? (first p) (second p)))
+                     (flatmap (lambda (tr)
+                                (map (lambda (tc) (list tr tc)) (range 0 tw)))
+                              (range 0 th))))
+           (define (contains-template? rs cs)
+             (all? (lambda (p)
+                     (let* ((r (+ rs (first p)))
+                            (c (+ cs (second p))))
+                       (and (< r h) (< c w) (= (at g r c) 1))))
+                   template))
+           (define corner-box?
+             (and (or (= r0 1) (= r0 (- h 7)))
+                  (or (= c0 1) (= c0 (- w 7)))))
+           (if corner-box?
+               (reduce (lambda (acc rs)
+                         (reduce (lambda (a cs)
+                                   (if (contains-template? rs cs)
+                                       (reduce (lambda (aa p)
+                                                 (set-cell aa
+                                                           (+ rs (first p))
+                                                           (+ cs (second p))
+                                                           sp-color))
+                                               a
+                                               template)
+                                       a))
+                                 acc
+                                 cstarts))
+                       g
+                       rstarts)
+               g))))"""
+
+
+def _sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _execute(bridge: RacketBridge, program: str, grid: list[list[int]]) -> list[list[int]]:
+    literal = "'(" + " ".join(
+        "(" + " ".join(map(str, row)) + ")" for row in normalize_grid(grid)
+    ) + ")"
+    return normalize_grid(bridge.eval_text(f"({wrap_rule(program)} {literal})"))
+
+
+def _diff_cells(left: list[list[int]], right: list[list[int]]) -> int:
+    return sum(a != b for row_a, row_b in zip(left, right, strict=True)
+               for a, b in zip(row_a, row_b, strict=True))
+
+
+def probe() -> dict:
+    generator, source_path, source_sha256 = load_selected_generator(TASK_ID, root=ROOT)
+    if source_sha256 != EXPECTED_GENERATOR_SHA256:
+        raise RuntimeError(
+            f"selected generator changed: {source_sha256} != {EXPECTED_GENERATOR_SHA256}"
+        )
+    catalog = Catalog(ROOT)
+    canonical_program = catalog.get(TASK_ID)["variants"][0]["program_solution"]
+    grids = [generator.generate(SEED, index) for index in range(4)]
+    replays = [generator.generate(SEED, index) for index in range(4)]
+    if grids != replays:
+        raise RuntimeError("generator replay was not deterministic")
+    corner_flags = [generator.observe_overrides(grid).get("corner_box") for grid in grids]
+    if corner_flags != [True, True, True, False]:
+        raise RuntimeError(f"retained lesson morphology changed: {corner_flags}")
+
+    with RacketBridge(timeout=30, startup_timeout=60, max_calls_before_restart=64) as bridge:
+        identity = dict(bridge.runtime_identity)
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires the protected Racket backend")
+        canonical_outputs = [_execute(bridge, canonical_program, grid) for grid in grids]
+        shortcut_outputs = [_execute(bridge, CORNER_ONLY_PROGRAM, grid) for grid in grids]
+
+    demo_matches = [shortcut_outputs[index] == canonical_outputs[index] for index in range(3)]
+    query_diff = _diff_cells(shortcut_outputs[3], canonical_outputs[3])
+    if demo_matches != [True, True, True] or query_diff != 10:
+        raise RuntimeError(
+            f"retained witness changed: demo_matches={demo_matches}, query_diff={query_diff}"
+        )
+
+    return {
+        "schema": "3143493b7c83-corner-box-lesson-probe-v1",
+        "task_id": TASK_ID,
+        "source": {
+            "generator_path": str(source_path.relative_to(ROOT)),
+            "generator_sha256": source_sha256,
+            "probe_sha256": _sha_bytes(Path(__file__).read_bytes()),
+            "canonical_program_sha256": _sha_bytes(canonical_program.encode()),
+            "shortcut_program_sha256": _sha_bytes(CORNER_ONLY_PROGRAM.encode()),
+        },
+        "runtime": {
+            key: identity[key]
+            for key in ("schema", "backend", "protected", "binary_sha256", "prelude_sha256")
+            if key in identity
+        },
+        "lesson": {
+            "seed": SEED,
+            "sample_indices": [0, 1, 2, 3],
+            "demonstration_indices": [0, 1, 2],
+            "query_index": 3,
+            "corner_box": corner_flags,
+            "observed_overrides": [generator.observe_overrides(grid) for grid in grids],
+        },
+        "shortcut": {
+            "name": "canonical_only_when_marker_box_is_in_a_canvas_corner",
+            "description": (
+                "Apply the canonical key-containment recoloring only for a corner marker box; "
+                "return the input unchanged for an interior marker box."
+            ),
+        },
+        "result": {
+            "shortcut_matches_demonstrations": demo_matches,
+            "shortcut_matches_query": shortcut_outputs[3] == canonical_outputs[3],
+            "query_diff_cells": query_diff,
+        },
+        "witness": {
+            "query_input": deepcopy(grids[3]),
+            "canonical_output": canonical_outputs[3],
+            "shortcut_output": shortcut_outputs[3],
+        },
+        "scope": (
+            "One exact default seed and the consecutive sample window 0..3. "
+            "This is an executable counterexample, not a population prevalence estimate."
+        ),
+        "repair": (
+            "Include at least one visible interior-box demonstration, or add this "
+            "canvas-position-conditioned rival to lesson admission."
+        ),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--out",
+        type=Path,
+        default=HERE / "evidence" / "current" / "corner-box-shortcut.json",
+    )
+    args = parser.parse_args()
+    evidence = probe()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(evidence, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": "witness_replayed",
+        "out": str(args.out),
+        "query_diff_cells": evidence["result"]["query_diff_cells"],
+    }))
+
+
+if __name__ == "__main__":
+    main()
