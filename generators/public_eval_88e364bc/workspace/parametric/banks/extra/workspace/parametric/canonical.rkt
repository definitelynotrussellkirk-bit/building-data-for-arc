(rule!
  (define halfway #f)
  (define directions (list (list -1 -1) (list -1 0) (list -1 1)
                          (list 0 -1) (list 0 1)
                          (list 1 -1) (list 1 0) (list 1 1)))
  (define (legend o)
    (define color (obj-color o))
    (define top (obj-r1 o)) (define bottom (obj-r2 o))
    (define left (obj-c1 o)) (define right (obj-c2 o))
    (define border-ok
      (and (not (member color (list 2 4))) (>= (- bottom top) 3) (>= (- right left) 3)
           (for/and ((p (positions-in-rect top left bottom right)))
             (or (and (> (first p) top) (< (first p) bottom)
                      (> (second p) left) (< (second p) right))
                 (= (at g (first p) (second p)) color)))))
    (if (not border-ok) #f
      (let* ((inner (positions-in-rect (+ top 1) (+ left 1) (- bottom 1) (- right 1)))
             (heads (filter (lambda (p) (= (at g (first p) (second p)) 2)) inner))
             (bodies (remove-duplicates
               (filter (lambda (v) (not (member v (list 0 2 4 color))))
                       (map (lambda (p) (at g (first p) (second p))) inner)))))
        (if (or (null? heads) (not (= (length bodies) 1))) #f
          (let ((ds (filter (lambda (d)
             (for*/and ((p heads) (k (list 1 2)))
               (define rr (- (first p) (* k (first d))))
               (define cc (- (second p) (* k (second d))))
               (and (> rr top) (< rr bottom) (> cc left) (< cc right)
                    (= (at g rr cc) (first bodies))))) directions)))
            (if (= (length ds) 1) (list color (first ds)) #f))))))
  (define legends (filter (lambda (x) x) (map legend (objects g 0))))
  (define free-mask (grid-from-fn h w (lambda (r c) (if (member (at g r c) (list 0 4)) 1 0))))
  (define regions (objects free-mask 0))
  (define (boundary-count cells color)
    (for*/sum ((p cells) (d cardinal-deltas))
      (if (= (safe-at g (+ (first p) (first d)) (+ (second p) (second d)) -1) color) 1 0)))
  (define (free? r c) (member (safe-at g r c -1) (list 0 4)))
  (define (run-length r c dr dc distance)
    (if (and (free? (+ r dr) (+ c dc)) (free? (+ r dr) c) (free? r (+ c dc)))
        (run-length (+ r dr) (+ c dc) dr dc (+ distance 1)) distance))
  (define particles
    (for/list ((p (find-color g 4)))
      (define room (find-first (lambda (o) (member p (obj-cells o))) regions))
      (define cells (obj-cells room))
      (define selected (pick-max legends (lambda (l)
        (- (* 1000 (boundary-count cells (first l))) (first l)))))
      (define direction (second selected))
      (define distance (run-length (first p) (second p) (first direction) (second direction) 0))
      (list p direction distance)))
  (define cleared (recolor-cells g (find-color g 4) 0))
  (for/fold ((out cleared)) ((particle particles))
    (define p (first particle))
    (define direction (second particle))
    (define distance (third particle))
    (define travel (if halfway (quotient (+ distance 1) 2) distance))
    (set-cell out (+ (first p) (* travel (first direction)))
                  (+ (second p) (* travel (second direction))) 4)))
