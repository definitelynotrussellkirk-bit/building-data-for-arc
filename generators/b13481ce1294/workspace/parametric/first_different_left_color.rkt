(rule! (let ((dummy 0))
  (define (split-full-sep-cols grid sep)
    (let* ((seps (filter (lambda (c)
                           (all? (lambda (r) (= (at grid r c) sep))
                                 (range (rows grid))))
                         (range (cols grid)))))
      (let loop ((cuts (append seps (list (cols grid)))) (start 0) (acc (list)))
        (if (empty? cuts)
            (reverse acc)
            (let ((c (first cuts)))
              (loop (rest cuts)
                    (+ c 1)
                    (cons (subgrid grid 0 start (- (rows grid) 1) (- c 1)) acc)))))))
  (let* ((panels (split-full-sep-cols g 8))
         (a (first panels))
         (b (second panels))
         (anchor
          (for*/first ((r (range (rows a)))
                       (c (range (cols a)))
                       #:when (let ((av (at a r c)) (bv (at b r c)))
                                (and (not (= av 0))
                                     (not (= bv 0))
                                     (not (= av bv)))))
            (at a r c))))
    (grid-from-fn (rows a) (cols a)
      (lambda (r c)
        (let ((av (at a r c)) (bv (at b r c)))
          (cond ((and (= av anchor) (= bv 0)) av)
                ((and (= av 0) (= bv anchor)) bv)
                (else 0))))))))
