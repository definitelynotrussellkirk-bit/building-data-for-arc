+"""Regression tests for the 709d506bd0aa lesson-identifiability repair."""
+from __future__ import annotations
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+TASK_ID = "709d506bd0aa"
+ROOT = find_root(__file__)
+GEN, _SOURCE, _SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _has_order_witness(grid: list[list[int]]) -> bool:
+    """A row where stable order differs from numeric sorting."""
+    for row in grid:
+        values = [value for value in row if value != 0]
+        if len(values) >= 2 and values != sorted(values):
+            return True
+    return False
+
+
+def test_known_ambiguous_seed_now_contains_an_order_sensitive_demo_witness():
+    demos = [GEN.generate(207, index, difficulty="easy") for index in range(3)]
+    assert any(_has_order_witness(grid) for grid in demos)
+
+
+def test_rule_mirror_matches_every_labeled_canonical_pair():
+    pairs = canonical_pairs(TASK_ID, root=ROOT, labeled_only=True)
+    assert pairs
+    for pair in pairs:
+        assert GEN.rule_mirror(pair["input"]) == pair["output"]
+
+
+def _pair(grid: list[list[int]]) -> dict[str, list[list[int]]]:
+    return {"input": grid, "output": GEN.rule_mirror(grid)}
+
+
+def test_lesson_gate_rejects_the_retained_sort_then_pack_shortcut():
+    demos = [
+        _pair([[0, 2, 0, 5]]),
+        _pair([[0, 3, 0, 3]]),
+        _pair([[0, 1, 0, 3]]),
+    ]
+    query = _pair([[0, 9, 0, 2]])
+    reasons = GEN.lesson_identifiable(demos, query)
+    assert any("sort_values_then_pack" in reason for reason in reasons)
+
+
+def test_helpful_generation_refutes_all_declared_semantic_rivals():
+    expected = {
+        "identity",
+        "sort_values_then_pack",
+        "right_pack",
+        "global_row0_pack",
+    }
+    assert set(GEN.SEMANTIC_RIVALS) == expected
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in (0, 1, 17, 207, 999):
+            for sample_index in range(8):
+                grid = GEN.generate(seed, sample_index, difficulty=difficulty)
+                truth = GEN.rule_mirror(grid)
+                assert _has_order_witness(grid), (difficulty, seed, sample_index)
+                for name, rival in GEN.SEMANTIC_RIVALS.items():
+                    assert rival(grid) != truth, (
+                        difficulty,
+                        seed,
+                        sample_index,
+                        name,
+                    )
+
+
+def test_exact_public_axes_are_consumed_observable_and_unknown_keys_rejected():
+    cases = ((5, 8, 2), (9, 13, 3), (13, 17, 4))
+    for index, (height, width, active_rows) in enumerate(cases):
+        requested = {
+            "grid_h": height,
+            "grid_w": width,
+            "active_rows": active_rows,
+        }
+        grid = GEN.generate(8800 + index, index, difficulty="medium", **requested)
+        assert GEN.observe_overrides(grid) == requested
+        assert GEN.self_check(grid, meta={"overrides": requested}) == []
+
+    with pytest.raises(ValueError, match="unknown override"):
+        GEN.generate(1, 0, bogus_axis=True)
