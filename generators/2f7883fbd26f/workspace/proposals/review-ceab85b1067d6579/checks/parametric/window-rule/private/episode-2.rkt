(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((n (for*/sum ((r (range 0 (- h 2))) (c (range 0 (- w 2))))
                               (if (and
                                     (= 1 (at g r c))
                                     (= 1 (at g r (+ c 1)))
                                     (= 1 (at g r (+ c 2)))
                                     (= 1 (at g (+ r 1) c))
                                     (= 1 (at g (+ r 1) (+ c 1)))
                                     (= 1 (at g (+ r 1) (+ c 2)))
                                     (= 1 (at g (+ r 2) c))
                                     (= 1 (at g (+ r 2) (+ c 1)))
                                     (= 1 (at g (+ r 2) (+ c 2))))
                                   1
                                   0))))
             (encode-bar n 5 1)))))