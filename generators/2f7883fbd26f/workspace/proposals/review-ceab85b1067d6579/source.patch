 SCHEDULE_PERIOD = len(SCHEDULE_ROLES)
 
 
+def _validate_replay_identity(seed: object, sample_index: object) -> None:
+    """Reject ambiguous replay keys before scheduling or keyed RNG use."""
+    if type(seed) is not int:
+        raise TypeError("seed must be an integer (not bool or a coercible value)")
+    if type(sample_index) is not int:
+        raise TypeError(
+            "sample_index must be an integer (not bool or a coercible value)"
+        )
+    if sample_index < 0:
+        raise ValueError("sample_index must be nonnegative")
+
+
 def schedule_profile(seed: int, sample_index: int, difficulty=None) -> str:
     """Three-slot role cycle; seed/difficulty affect scene content only."""
+    _validate_replay_identity(seed, sample_index)
     del seed, difficulty
     return SCHEDULE_ROLES[int(sample_index) % SCHEDULE_PERIOD]
 
