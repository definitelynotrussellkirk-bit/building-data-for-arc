(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (begin
             (define bg 0)
             (define objs (objects-8 g bg))
             (define (asym? obj)
               (let* ((cells (obj-cells obj))
                      (rs (map first cells))
                      (cs (map second cells))
                      (rmin (min-list rs))
                      (rmax (max-list rs))
                      (cmin (min-list cs))
                      (cmax (max-list cs))
                      (oh (+ (- rmax rmin) 1))
                      (norm (map (lambda (c)
                                   (list (- (first c) rmin) (- (second c) cmin)))
                                 cells)))
                 (not (andmap (lambda (c)
                                (any? (lambda (c2)
                                        (= c2 (list (- (- oh 1) (first c)) (second c))))
                                      norm))
                              norm))))
             (define target (find asym? objs))
             (let* ((cells (obj-cells target))
                    (rs (map first cells))
                    (cs (map second cells))
                    (rmin (min-list rs))
                    (rmax (max-list rs))
                    (cmin (min-list cs))
                    (cmax (max-list cs))
                    (oh (+ (- rmax rmin) 1))
                    (ow (+ (- cmax cmin) 1))
                    (color (obj-color target))
                    (base (empty-grid oh ow 0)))
               (reduce (lambda (gg c)
                         (set-cell gg (- (first c) rmin) (- (second c) cmin) color))
                       base
                       cells))))))