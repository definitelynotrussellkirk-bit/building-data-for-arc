    "bbox_alignment_only": "(rule! (lambda (g) (let* ([b (crop-to-content g 0)] [axis (if (> (rows b) (cols b)) \"lr\" \"ud\")]) (grid (list (list (if (let ([bb (bbox-of-cells (filter (lambda (p) (not (= (at g (first p) (second p)) 0))) (grid-positions g)))]) (if (equal? axis \"lr\") (= (+ (second bb) (fourth bb)) (- (cols g) 1)) (= (+ (first bb) (third bb)) (- (rows g) 1)))) 1 7)))))))",
    "bbox_major_axis": "(rule! (lambda (g) (let* ([b (crop-to-content g 0)] [axis (if (> (rows b) (cols b)) \"lr\" \"ud\")]) (grid (list (list (if (symmetric? g axis) 1 7)))))))",
    "bbox_minor_axis": "(rule! (lambda (g) (let* ([b (crop-to-content g 0)] [axis (if (> (rows b) (cols b)) \"lr\" \"ud\")]) (grid (list (list (if (symmetric? g (if (> (rows b) (cols b)) \"ud\" \"lr\")) 1 7)))))))",
    "bbox_tall_label": "(rule! (lambda (g) (let* ([b (crop-to-content g 0)] [axis (if (> (rows b) (cols b)) \"lr\" \"ud\")]) (grid (list (list (if (> (rows b) (cols b)) 1 7)))))))",
    "bottom_left_foreground": "(rule! (lambda (g) (grid (list (list (if (not (= (at g (- (rows g) 1) 0) 0)) 1 7))))))",
    "bottom_right_foreground": "(rule! (lambda (g) (grid (list (list (if (not (= (at g (- (rows g) 1) (- (cols g) 1)) 0)) 1 7))))))",
    "canvas_major_axis": "(rule! (lambda (g) (grid (list (list (if (symmetric? g (if (> (rows g) (cols g)) \"lr\" \"ud\")) 1 7))))))",
