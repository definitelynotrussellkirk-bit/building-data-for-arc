+def _orbit(h: int, w: int, r: int, c: int, symmetry: str) -> frozenset[tuple[int, int]]:
+    cells = {(r, c)}
+    if symmetry in ("lr", "all"):
+        cells |= {(r, w - 1 - c)}
+    if symmetry in ("tb", "all"):
+        cells |= {(h - 1 - r, c)}
+    if symmetry in ("rot", "all"):
+        cells |= {(h - 1 - r, w - 1 - c)}
+    return frozenset(cells)
