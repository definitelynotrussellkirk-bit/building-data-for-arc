+"""Bounded source-bound audit of within-segment duplicate-color teaching.
+
+Run through the packet's review.py run wrapper.  Full programs and labels are
+written only beneath the private evidence directory; stdout is a compact receipt.
+This probe leaves the production source and canonical rule untouched.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+
+TASK = "88fc4a5c8ebd"
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / "src"))
+sys.path.insert(0, str(REPO / "shared/runtime"))
+
+
+def raw(value):
+    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def duplicate_segments(grid):
+    count = 0
+    for row in grid:
+        start = 0
+        for end in range(len(row) + 1):
+            if end == len(row) or row[end] == 5:
+                values = [value for value in row[start:end] if value not in (0, 5)]
+                count += len(values) != len(set(values))
+                start = end + 1
+    return count
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed", type=int, default=5)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.seed < 0:
+        parser.error("seed must be nonnegative")
+    if args.out.exists():
+        parser.error("output must be a new directory")
+
+    from arcpuzzles.catalog import Catalog
+    from arcpuzzles.parametric_worker import _real_evaluator
+
+    source = REPO / "generators" / TASK / "generator.py"
+    spec = importlib.util.spec_from_file_location("peer_duplicate_color_88fc4a5c8ebd", source)
+    assert spec and spec.loader
+    generator = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = generator
+    spec.loader.exec_module(generator)
+    catalog = Catalog(REPO)
+    row = catalog.describe(TASK)
+    authority = row.get("rule_task_id", TASK)
+    programs = {v["program_solution"] for v in catalog._variants()[authority]}
+    assert len(programs) == 1, "Selected canonical authority must be unique"
+    canonical = next(iter(programs))
+    needle = "(vals (filter (lambda (v) (not (member? v (list 0 5)))) (map (lambda (cc) (at g r cc)) (range c j))))"
+    replacement = "(raw-vals (filter (lambda (v) (not (member? v (list 0 5)))) (map (lambda (cc) (at g r cc)) (range c j)))) (vals (remove-duplicates raw-vals))"
+    assert canonical.count(needle) == 1, "Canonical source changed; review the rival construction"
+    rival = canonical.replace(needle, replacement)
+
+    inputs = [generator.generate(args.seed, index) for index in range(5)]
+    assert all(not generator.self_check(grid) for grid in inputs)
+    assert len({json.dumps(grid) for grid in inputs}) == 5
+    duplicate_counts = [duplicate_segments(grid) for grid in inputs]
+    assert duplicate_counts[:4] == [0, 0, 0, 0]
+    assert duplicate_counts[4] > 0
+
+    apply, runtime, bridge = _real_evaluator(REPO / "shared/runtime")
+    assert runtime["backend"] == "racket" and runtime["protected"] is True
+    try:
+        labels = [apply(canonical, grid) for grid in inputs]
+        rival_labels = [apply(rival, grid) for grid in inputs]
+        assert labels[:4] == rival_labels[:4], "Rival fails a visible demonstration"
+        assert labels[4] != rival_labels[4], "Rival must disagree on the generated query"
+        minimal = [[0, 0, 0, 0, 0], [0, 2, 2, 5, 0], [0, 0, 0, 0, 0]]
+        minimal_label = apply(canonical, minimal)
+        minimal_rival = apply(rival, minimal)
+        assert minimal_label == [[0, 0, 0, 0, 0], [2, 2, 0, 5, 0], [0, 0, 0, 0, 0]]
+        assert minimal_rival == [[0, 0, 0, 0, 0], [2, 0, 0, 5, 0], [0, 0, 0, 0, 0]]
+    finally:
+        bridge.close()
+
+    private = args.out / "private"
+    private.mkdir(parents=True)
+    payloads = {
+        "lesson.json": {
+            "task_id": TASK, "seed": args.seed, "sample_indices": list(range(5)),
+            "difficulty": None,
+            "train": [{"input": grid, "output": label} for grid, label in zip(inputs[:4], labels[:4])],
+            "test": [{"input": inputs[4], "output": labels[4], "rival_output": rival_labels[4]}],
+        },
+        "programs.json": {"canonical": canonical, "deduplicate_within_segment": rival},
+        "minimal_counterexample.json": {"input": minimal, "output": minimal_label, "rival_output": minimal_rival},
+    }
+    files = []
+    for name, payload in payloads.items():
+        data = raw(payload)
+        path = private / name
+        path.write_bytes(data)
+        files.append({"path": "private/" + name, "sha256": digest(data), "bytes": len(data)})
+    receipt = {
+        "schema": "task-local-learnability-audit-v1", "task_id": TASK,
+        "outcome": "source_unchanged_finding_retained",
+        "finding": "Four generated demonstrations admit within-segment color deduplication; the generated query distinguishes it.",
+        "seed": args.seed, "demonstrations": 4, "queries": 1,
+        "sample_indices": list(range(5)), "difficulty": None,
+        "duplicate_segments_by_pair": duplicate_counts,
+        "rival_fits_all_demos": True, "rival_disagrees_on_query": True,
+        "generator_self_check_passed": 5,
+        "generator_sha256": digest(source.read_bytes()),
+        "selected_rule_hash": row["rule_hash"], "rule_task_id": authority,
+        "canonical_program_sha256": digest(canonical.encode()),
+        "rival_program_sha256": digest(rival.encode()),
+        "probe_sha256": digest(Path(__file__).read_bytes()),
+        "racket": runtime, "racket_applications": 12, "files": files,
+        "limits": "One retained seed and one rival, found by an exploratory search of six seeds. No prevalence estimate, production repair, complete battery, or approval change.",
+        "proposal": "Add a visible demonstration with repeated same-color values inside one blocker-separated segment; preserve their multiplicity and order.",
+    }
+    (args.out / "receipt.json").write_bytes(raw(receipt))
+    print(json.dumps({key: receipt[key] for key in ("task_id", "outcome", "seed", "rival_fits_all_demos", "rival_disagrees_on_query", "racket_applications", "generator_sha256", "selected_rule_hash")}))
+
+
+if __name__ == "__main__":
+    main()
