+"""Bounded private Racket probe for a palette-count repetition shortcut.
+
+Run through review.py run. This retains a finding or a bounded no-finding;
+it does not change source approval, labels, or training admission.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _grid, _real_evaluator
+from reviewer_support import load_selected_generator
+
+TASK_ID = "909cd6619a84"
+REPO = Path(__file__).resolve().parents[3]
+
+
+def digest(body):
+    return hashlib.sha256(body).hexdigest()
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
+
+
+def run(out):
+    if out.exists() or out.is_symlink():
+        raise FileExistsError("Use a new evidence directory")
+    out.mkdir(parents=True)
+    private = out / "private"
+    private.mkdir()
+    module, source, source_sha = load_selected_generator(TASK_ID, root=REPO)
+    records = []
+    for line in (REPO / "shared/data/canonical/puzzles.jsonl").open():
+        record = json.loads(line)
+        if record.get("task_id") == TASK_ID:
+            records.append(record)
+    if len(records) != 1:
+        raise ValueError("Expected exactly one selected canonical record")
+    canonical = records[0]
+    program = canonical["program_solution"]
+    needle = "(+ (* 2 ch) 3)"
+    if program.count(needle) != 1:
+        raise ValueError("Selected rule changed; inspect the height substitution")
+    rival = program.replace(needle, "(+ (* (length (filter (lambda (color) (not (= color 7))) (grid-colors g))) (+ ch 1)) 1)")
+    report = {"schema": "palette-copy-shortcut-audit-v1", "visibility": "private",
+              "task_id": TASK_ID, "source_sha256": source_sha,
+              "canonical_program_sha256": digest(program.encode()),
+              "rival_program_sha256": digest(rival.encode()),
+              "probe_sha256": digest(Path(__file__).read_bytes()),
+              "candidate_seeds": list(range(64)), "difficulty": "easy",
+              "demo_indices": [0, 1, 2], "query_index": 3,
+              "outcome": "bounded_no_finding", "training_admission": False,
+              "limits": ["One declared palette-dependent repetition rival.",
+                         "64 easy seeds; no medium/hard or broad battery.",
+                         "A demonstration-fitting rival establishes finite lesson ambiguity, not incorrect canonical labels.",
+                         "The minimized query uses the smallest declared input dimensions, not globally minimal pixel support."]}
+    candidates = []
+    for seed in range(64):
+        grids = [module.generate(seed, index, difficulty="easy") for index in range(4)]
+        counts = [len({cell for row in grid for cell in row} - {7}) for grid in grids]
+        if counts[:3] == [2, 2, 2] and counts[3] == 1:
+            candidates.append((seed, grids))
+    report["candidate_count"] = len(candidates)
+    report["candidate_generation_calls"] = 256
+    (private / "audited_generator.py").write_bytes(source.read_bytes())
+    (private / "canonical.rkt").write_text(program)
+    (private / "palette_count_rival.rkt").write_text(rival)
+    if not candidates:
+        write_json(out / "audit.json", report)
+        return report
+    seed, grids = candidates[0]
+    apply, identity, bridge = _real_evaluator(REPO / "shared/runtime")
+    evaluations = 0
+    def execute(text, grid):
+        nonlocal evaluations
+        evaluations += 1
+        return _grid(apply(text, _grid(grid)))
+    try:
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise ValueError("A protected Racket backend is required")
+        report["runtime"] = identity
+        canonical_checks = []
+        for split in ("train", "test"):
+            for index, pair in enumerate(canonical[split]):
+                actual = execute(program, pair["input"])
+                competing = execute(rival, pair["input"])
+                if actual != _grid(pair["output"]):
+                    raise ValueError("The selected reference disagrees with its retained label")
+                canonical_checks.append({"split": split, "index": index,
+                                         "canonical_label_matches": True,
+                                         "rival_matches": competing == actual})
+        report["canonical_checks"] = canonical_checks
+        episode = {"visibility": "private", "seed": seed, "difficulty": "easy",
+                   "train": [], "test": [], "program_solution": program,
+                   "rival_program": rival, "source_sha256": source_sha}
+        agreements = []
+        for index, grid in enumerate(grids):
+            findings = module.self_check(grid, difficulty="easy")
+            if findings:
+                raise ValueError(f"Candidate is outside current self_check: {findings}")
+            actual, competing = execute(program, grid), execute(rival, grid)
+            agreements.append(actual == competing)
+            episode["train" if index < 3 else "test"].append(
+                {"input": grid, "output": actual, "rival_output": competing})
+        if agreements != [True, True, True, False]:
+            raise ValueError("The candidate did not reproduce its claimed disagreement")
+        overrides = {"grid_h": 5, "grid_w": 3, "fg_palette_kind": "five_only", "fill_layout": "frame"}
+        minimal_grid = module.generate(seed, 3, difficulty="easy", **overrides)
+        if module.self_check(minimal_grid, difficulty="easy"):
+            raise ValueError("Minimal supported-size query failed self_check")
+        minimal_actual = execute(program, minimal_grid)
+        minimal_rival = execute(rival, minimal_grid)
+        if minimal_actual == minimal_rival:
+            raise ValueError("Minimal query did not distinguish the rival")
+        minimal = {"visibility": "private", "seed": seed, "sample_index": 3,
+                   "difficulty": "easy", "overrides": overrides, "input": minimal_grid,
+                   "output": minimal_actual, "rival_output": minimal_rival,
+                   "source_sha256": source_sha, "program_solution": program, "rival_program": rival}
+        write_json(private / "generated_lesson.json", episode)
+        write_json(private / "minimal_query.json", minimal)
+        report.update(outcome="lesson_shortcut_counterexample", seed=seed,
+                      generated_demo_agreements=agreements[:3], generated_query_agreement=agreements[3],
+                      generated_query_shape=[len(grids[3]), len(grids[3][0])],
+                      canonical_query_output_shape=[len(episode["test"][0]["output"]), len(episode["test"][0]["output"][0])],
+                      rival_query_output_shape=[len(episode["test"][0]["rival_output"]), len(episode["test"][0]["rival_output"][0])],
+                      minimal_query_shape=[5, 3], minimal_canonical_output_shape=[len(minimal_actual),len(minimal_actual[0])],
+                      minimal_rival_output_shape=[len(minimal_rival), len(minimal_rival[0])],
+                      proposed_repair="Ensure each three-demo lesson includes both one-foreground-color and two-foreground-color inputs, or add a lesson rival guard.")
+    finally:
+        bridge.close()
+    report["racket_evaluations"] = evaluations
+    if digest(source.read_bytes()) != source_sha:
+        raise ValueError("Audited source changed during the probe")
+    report["evidence_sha256"] = {p.relative_to(out).as_posix(): digest(p.read_bytes()) for p in sorted(private.iterdir())}
+    write_json(out / "audit.json", report)
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run(args.out)
+    print(json.dumps({key: report[key] for key in ("task_id", "outcome", "source_sha256", "candidate_count", "racket_evaluations") if key in report}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
