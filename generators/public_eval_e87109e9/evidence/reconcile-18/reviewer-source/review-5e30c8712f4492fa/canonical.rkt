(rule!
 ;; The six-row header contains one color instruction per 6-column box.
 ;; A bar at the left/right interior edge means turn left/right at that
 ;; color's axis-aligned rectangular target.  The color-8 square cursor starts
 ;; each instruction from home, paints its swept square footprint, and after
 ;; the instructed turn bounces around later rectangles toward their farther
 ;; extension until it leaves the body.  Missing/non-aligned targets trace
 ;; straight upward.  The header is removed.
 (lambda (g)
  (let ()
   (define highlight-shortest #f)
   (define wrong-first #f)
   (define gh (rows g))
   (define w (cols g))
   (define body (subgrid g 6 0 (- gh 1) (- w 1)))
   (define h (rows body))
   (define bg (mode body -1))
   (define source (find-color body 8))
   (define sb (bbox-of-cells source))
   (define size (+ 1 (- (third sb) (first sb))))
   (define source-pos (list (first sb) (second sb)))
   (define obstacles
    (filter (lambda (o) (!= (obj-color o) 8)) (objects body bg)))
   (define instructions
    (for/list ((i (range (quotient w 6))))
     (let* ((start (* i 6))
            (marks
             (for*/list ((r (range 1 5)) (c (range 1 5))
                         #:when (!= (at g r (+ start c)) 0))
              (list r c (at g r (+ start c)))))
            (mark (first marks)))
      (list (third mark) (if (= (second mark) 1) 'left 'right)))))
   (define (footprint pos)
    (for*/list ((dr (range size)) (dc (range size)))
     (list (+ (first pos) dr) (+ (second pos) dc))))
   (define (inside? pos)
    (and (<= 0 (first pos)) (<= 0 (second pos))
         (<= (+ (first pos) size) h) (<= (+ (second pos) size) w)))
   (define (hit-at pos)
    (let ((fp (footprint pos)))
     (find-first
      (lambda (o) (any? (lambda (p) (member p (obj-cells o))) fp))
      obstacles)))
   (define (advance pos d)
    (list (+ (first pos) (first d)) (+ (second pos) (second d))))
   (define (seek d)
    (let loop ((pos source-pos) (cells (footprint source-pos)) (fuel (* 4 h w)))
     (let* ((next (advance pos d))
            (inside (inside? next))
            (hit (if inside (hit-at next) #f)))
      (cond ((<= fuel 0) (list (remove-duplicates cells) pos #f))
            ((not inside) (list (remove-duplicates cells) pos #f))
            (hit (list (remove-duplicates cells) pos hit))
            (else (loop next (append cells (footprint next)) (- fuel 1)))))))
   (define (turn d hand)
    (let ((dr (first d)) (dc (second d)))
     (if (eq? hand 'left) (list (- dc) dr) (list dc (- dr)))))
   (define (bounce d pos obstacle)
    (let* ((bb (obj-bbox obstacle))
           (r (first pos)) (c (second pos))
           (dr (first d))
           (left (- c (second bb)))
           (right (- (fourth bb) (+ c size -1)))
           (up (- r (first bb)))
           (down (- (third bb) (+ r size -1))))
     (if (!= dr 0)
         (if (> left right) (list 0 -1) (list 0 1))
         (if (> up down) (list -1 0) (list 1 0)))))
   (define (post-run start-pos start-d)
    (let loop ((pos start-pos) (d start-d) (cells (footprint start-pos))
               (hits '()) (seen '()) (fuel (* 8 h w)))
     (let ((state (list pos d)))
      (if (or (<= fuel 0) (member state seen))
          (list (remove-duplicates cells) hits)
          (let* ((next (advance pos d))
                 (inside (inside? next))
                 (hit (if inside (hit-at next) #f)))
           (cond ((not inside) (list (remove-duplicates cells) hits))
                 (hit (loop pos (bounce d pos hit) cells
                            (append hits (list hit)) (cons state seen) (- fuel 1)))
                 (else (loop next d (append cells (footprint next)) hits
                             (cons state seen) (- fuel 1)))))))))
   (define (make-route instruction)
    (let* ((color (first instruction))
           (hand (second instruction))
           (candidates
            (filter
             (lambda (item)
              (let ((hit (third (second item))))
               (and hit (= (obj-color hit) color))))
             (map (lambda (d) (list d (seek d))) cardinal-deltas))))
     (if (null? candidates)
         (let ((fallback (seek (list -1 0))))
          (list color hand (first fallback) '() #t))
         (let* ((chosen (first candidates))
                (d (first chosen))
                (leg (second chosen))
                (pos (second leg))
                (target (third leg))
                (tail (post-run pos (turn d hand))))
          (list color hand
                (remove-duplicates (append (first leg) (first tail)))
                (cons target (second tail)) #f)))))
   (define routes (map make-route instructions))
   (define trail
    (remove-duplicates
     (append source (apply append (map third routes)))))
   (define painted
    (reduce
     (lambda (acc p)
      (let ((v (at acc (first p) (second p))))
       (if (or (= v bg) (= v 8))
           (set-cell acc (first p) (second p) 8)
           acc)))
     body trail))
   (define candidates (filter (lambda (route) (not (null? (fourth route)))) routes))
   (define (shorter-route? a b)
    (let* ((as (length (third a))) (bs (length (third b)))
           (ac (length (fourth a))) (bc (length (fourth b)))
           (acol (first a)) (bcol (first b)))
     (cond ((!= as bs) (< as bs))
           ((!= ac bc) (< ac bc))
           (else (< acol bcol)))))
   (if (not highlight-shortest)
       painted
       (let* ((selected (if wrong-first (first candidates)
                            (first (sort candidates shorter-route?))))
              (hits (fourth selected))
              (chosen-hit (first hits)))
        (recolor-cells painted (obj-cells chosen-hit) 9))))))
