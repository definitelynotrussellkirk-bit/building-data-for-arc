(rule!
 ;; The six-row header gives four target colors and relative turn sides.  Move
 ;; the square color-8 brush straight to each axis-aligned target, turn at the
 ;; target, then keep moving.  A turned run that meets an original rectangle
 ;; slides along the side on which that rectangle protrudes farther and
 ;; continues; routes are all traced against the unchanged input field.
 (lambda (g)
  (let ()
   (define opposite? #t)
   (define field (drop g 6))
   (define h (rows field))
   (define w (cols field))
   (define bg (mode field 8))
   (define specs
    (for/list ((box (range 4)))
     (define base (* 6 box))
     (define left-color (at g 1 (+ base 1)))
     (define right-color (at g 1 (+ base 4)))
     ;; The boolean is true for a left-side header marker.
     (if (= left-color 0)
         (list right-color #f)
         (list left-color #t))))
   (define cursor-box (bbox-of-cells (find-color field 8)))
   (define cursor-top (list (first cursor-box) (second cursor-box)))
   (define brush (+ 1 (- (third cursor-box) (first cursor-box))))

   (define (block top)
    (for*/list ((r (range (first top) (+ (first top) brush)))
                (c (range (second top) (+ (second top) brush))))
     (list r c)))
   (define (inside-top? top)
    (and (<= 0 (first top)) (<= 0 (second top))
         (<= (+ (first top) brush) h)
         (<= (+ (second top) brush) w)))
   (define (move top vector)
    (list (+ (first top) (first vector))
          (+ (second top) (second vector))))
   (define (overlap? a0 a1 b0 b1)
    (<= (max a0 b0) (min a1 b1)))
   (define (target-info color)
    (define cells (find-color field color))
    (and (not (null? cells)) (list (bbox-of-cells cells) cells)))
   (define (blocking-color top)
    (define colors
     (remove-duplicates
      (filter (lambda (v) (and (not (= v bg)) (not (= v 8))))
              (map (lambda (p) (at field (first p) (second p))) (block top)))))
    (if (null? colors) #f (first colors)))
   (define (approach-vector target)
    (define bb (first target))
    (define tr0 (first bb))
    (define tc0 (second bb))
    (define tr1 (third bb))
    (define tc1 (fourth bb))
    (define cr0 (first cursor-top))
    (define cc0 (second cursor-top))
    (define cr1 (+ cr0 brush -1))
    (define cc1 (+ cc0 brush -1))
    (define choices
     (filter values
      (list
       (and (< tc1 cc0) (overlap? tr0 tr1 cr0 cr1) (list 0 -1))
       (and (> tc0 cc1) (overlap? tr0 tr1 cr0 cr1) (list 0 1))
       (and (< tr1 cr0) (overlap? tc0 tc1 cc0 cc1) (list -1 0))
       (and (> tr0 cr1) (overlap? tc0 tc1 cc0 cc1) (list 1 0)))))
    (if (= (length choices) 1) (first choices) #f))
   (define (turn-vector vector left?)
    (define dr (first vector))
    (define dc (second vector))
    (if left?
        (list (- 0 dc) dr)
        (list dc (- 0 dr))))

   (define (straight-extension start vector)
    (let loop ((top start) (cells (block start)))
     (define next (move top vector))
     (if (or (not (inside-top? next)) (blocking-color next))
         cells
         (loop next (append (block next) cells)))))

   (define (bounce-vector top vector obstacle-box)
    (define r0 (first top))
    (define c0 (second top))
    (define r1 (+ r0 brush -1))
    (define c1 (+ c0 brush -1))
    (define or0 (first obstacle-box))
    (define oc0 (second obstacle-box))
    (define or1 (third obstacle-box))
    (define oc1 (fourth obstacle-box))
    (if (not (= (first vector) 0))
        (let ((low (max 0 (- c0 oc0)))
              (high (max 0 (- oc1 c1))))
         (cond ((> low high) (list 0 -1))
               ((> high low) (list 0 1))
               (else (error "ambiguous horizontal blocker extension"))))
        (let ((low (max 0 (- r0 or0)))
              (high (max 0 (- or1 r1))))
         (cond ((> low high) (list -1 0))
               ((> high low) (list 1 0))
               (else (error "ambiguous vertical blocker extension"))))))

   (define (bounce-extension start initial-vector)
    (let loop ((top start)
               (vector initial-vector)
               (cells (block start))
               (seen '())
               (fuel (+ 1 (* 4 h w))))
     (define state (list top vector))
     (when (or (= fuel 0) (member state seen))
      (error "cursor route entered a bounce cycle"))
     (define next (move top vector))
     (cond
      ((not (inside-top? next)) cells)
      (else
       (define blocker (blocking-color next))
       (if blocker
           (let* ((obstacle (target-info blocker))
                  (redirect (bounce-vector top vector (first obstacle))))
            (loop top redirect cells (cons state seen) (- fuel 1)))
           (loop next vector (append (block next) cells)
                 (cons state seen) (- fuel 1)))))))

   (define (route spec)
    (define color (first spec))
    (define marker-left? (second spec))
    (define target (target-info color))
    (define approach (and target (approach-vector target)))
    (if (not approach)
        (straight-extension cursor-top (list -1 0))
        (let ((target-cells (second target))
              (effective-left? (if opposite? (not marker-left?) marker-left?)))
         (let loop ((top cursor-top)
                    (cells (block cursor-top))
                    (fuel (+ h w 1)))
          (when (= fuel 0) (error "aligned target was not reached"))
          (define next (move top approach))
          (define next-block (block next))
          (if (ormap (lambda (p) (member p target-cells)) next-block)
              (append (bounce-extension top (turn-vector approach effective-left?))
                      cells)
              (loop next (append next-block cells) (- fuel 1)))))))

   (define painted (remove-duplicates (append-map route specs)))
   (build-grid h w (r c)
    (let ((v (at field r c)))
     (if (and (member (list r c) painted)
              (or (= v bg) (= v 8)))
         8
         v))))))
