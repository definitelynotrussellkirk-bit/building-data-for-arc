+"""Behavioral regressions for the opposite-corner rectangle family."""
+from __future__ import annotations
+
+from collections import Counter
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+TASK = "7a8926bd9d9f"
+ROOT = find_root(__file__)
+GEN, SOURCE, SOURCE_SHA256 = load_selected_generator(TASK, root=ROOT)
+
+EXPECTED_PALETTES = {
+    "default": {1, 2, 3, 4, 5, 6, 7, 8, 9},
+    "warm": {2, 4, 6, 7, 9},
+    "cool": {1, 3, 5, 8},
+    "varied": {1, 2, 3, 4, 5, 6, 7, 8, 9},
+}
+
+
+def active_colors(grid):
+    return {value for row in grid for value in row if value != 0}
+
+
+def rectangle_count(grid):
+    counts = Counter(value for row in grid for value in row if value != 0)
+    assert all(count == 2 for count in counts.values())
+    return len(counts)
+
+
+def independent_fill(grid):
+    points = {}
+    for r, row in enumerate(grid):
+        for c, value in enumerate(row):
+            if value:
+                points.setdefault(value, []).append((r, c))
+    out = [row[:] for row in grid]
+    for color, pair in points.items():
+        assert len(pair) == 2
+        (r1, c1), (r2, c2) = pair
+        assert r1 != r2 and c1 != c2
+        for r in range(min(r1, r2), max(r1, r2) + 1):
+            for c in range(min(c1, c2), max(c1, c2) + 1):
+                out[r][c] = color
