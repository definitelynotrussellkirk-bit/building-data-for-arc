+def _segments(total: int, parts: int) -> tuple[tuple[int, int], ...]:
+    """Partition ``range(total)`` into contiguous nearly-equal segments."""
+    base, extra = divmod(total, parts)
+    result = []
+    start = 0
+    for index in range(parts):
