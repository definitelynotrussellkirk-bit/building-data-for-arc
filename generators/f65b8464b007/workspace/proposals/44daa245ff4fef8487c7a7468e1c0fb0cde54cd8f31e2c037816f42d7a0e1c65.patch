+"""Source-bound protected-Racket audit for the 7a8926bd9d9f repair.
+
+This is intentionally reusable: future reviewers can rerun it after edits and
+compare exact-control coverage, validator behavior, and canonical labels.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+TASK_ID = "7a8926bd9d9f"
+
+
+def _literal(grid):
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _canonical_program(root: Path) -> str:
+    matches = []
+    for line in canonical_path(root).read_text(encoding="utf-8").splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            matches.append(row["program_solution"])
+    if len(matches) != 1:
+        raise RuntimeError(f"expected one canonical program, found {len(matches)}")
+    return matches[0]
+
+
+def _independent_fill(grid):
+    points = {}
+    for r, row in enumerate(grid):
+        for c, value in enumerate(row):
+            if value:
+                points.setdefault(value, []).append((r, c))
+    output = [row[:] for row in grid]
+    for color, pair in points.items():
+        if len(pair) != 2:
+            raise AssertionError(f"color {color} has {len(pair)} points")
+        (r1, c1), (r2, c2) = pair
+        if r1 == r2 or c1 == c2:
+            raise AssertionError(f"color {color} is not an opposite-corner pair")
+        for r in range(min(r1, r2), max(r1, r2) + 1):
+            for c in range(min(c1, c2), max(c1, c2) + 1):
+                output[r][c] = color
+    return output
+
+
+def _case(name, grid):
+    return {"name": name, "input": grid, "expected": _independent_fill(grid)}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args()
+
+    root = find_root(__file__)
+    generator, source, source_sha = load_selected_generator(TASK_ID, root=root)
+    cases = []
+    for count in range(1, 9):
+        cases.append(_case(
+            f"exact-count-{count}",
+            generator.generate(17, count, difficulty="hard", n_rects=count),
+        ))
+    for index, palette in enumerate(generator.PALETTE_KINDS):
+        direct = generator.generate(31, index, n_rects=3, palette_kind=palette)
+        alias = generator.generate(31, index, n_rects=3, texture=palette)
+        if direct != alias:
+            raise AssertionError(f"texture alias differs for {palette}")
+        cases.append(_case(f"palette-{palette}", direct))
+    cases.extend([
+        _case("minimum-grid", generator.generate(5, 9, grid_h=4, grid_w=4, n_rects=1)),
+        _case("maximum-grid-count", generator.generate(5, 10, grid_h=16, grid_w=16, n_rects=8)),
+    ])
+    for index, pair in enumerate(canonical_pairs(TASK_ID, root=root)):
+        cases.append(_case(f"canonical-{index}", pair["input"]))
+        if cases[-1]["expected"] != pair["output"]:
+            raise AssertionError(f"canonical Python oracle mismatch at pair {index}")
+
+    for case in cases:
+        errors = generator.self_check(case["input"])
+        if errors:
+            raise AssertionError(f"{case['name']} outside repaired grammar: {errors}")
+
+    degenerate_errors = {}
+    for texture in generator.DEGENERATE_TEXTURES:
+        grid = generator.generate(0, 0, texture=texture)
+        errors = generator.self_check(grid)
+        if not errors:
+            raise AssertionError(f"degenerate texture {texture} passed self_check")
+        degenerate_errors[texture] = errors
+
+    program = _canonical_program(root)
+    rule = wrap_rule(program)
+    labels = []
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("audit requires protected Racket")
+        for case in cases:
+            actual = bridge.eval_text(f"({rule} {_literal(case['input'])})")
+            if actual != case["expected"]:
+                raise AssertionError(f"protected Racket mismatch for {case['name']}")
+            labels.append({
+                "name": case["name"],
+                "input_shape": [len(case["input"]), len(case["input"][0])],
+                "active_colors": sorted({v for row in case["input"] for v in row if v}),
+                "input_sha256": hashlib.sha256(json.dumps(case["input"], separators=(",", ":")).encode()).hexdigest(),
+                "output_sha256": hashlib.sha256(json.dumps(actual, separators=(",", ":")).encode()).hexdigest(),
+            })
+
+    result = {
+        "schema": "arcpuzzles-generator-repair-audit-v1",
+        "task_id": TASK_ID,
+        "generator_sha256": source_sha,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "cases": labels,
+        "case_count": len(labels),
+        "racket_evaluations": len(labels),
+        "exact_counts_covered": list(range(1, 9)),
+        "palette_aliases_covered": list(generator.PALETTE_KINDS),
+        "degenerate_validator_rejections": degenerate_errors,
+        "racket": {
+            key: identity[key]
+            for key in (
+                "schema", "backend", "protected", "binary_sha256", "prelude_sha256",
+                "bridge_sha256", "boot_script_sha256", "candidate_symbol_policy_sha256",
+            )
+            if key in identity
+        },
+        "scope": (
+            "Finite source-bound check of exact counts 1..8, four palette aliases, "
+            "minimum/maximum control cases, and all canonical pairs. It does not "
+            "prove arbitrary learnability or distribution quality."
+        ),
+    }
+    target = Path(args.out)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "out": str(target),
+        "case_count": result["case_count"],
+        "racket_evaluations": result["racket_evaluations"],
+        "generator_sha256": source_sha,
+    }, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
