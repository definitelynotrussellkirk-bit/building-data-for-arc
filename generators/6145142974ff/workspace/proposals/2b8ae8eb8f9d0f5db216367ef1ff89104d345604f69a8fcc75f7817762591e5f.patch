+#!/usr/bin/env python3
+"""Portable source-bound replay of the fixed-bottom-right-key shortcut.
+
+The historical retained replay was authored for a different packet layout.  This
+probe resolves the current repository directly, verifies that the shortcut fits
+all canonical pairs, and executes the generated disagreement through protected
+Racket.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+HERE = Path(__file__).resolve().parent
+HOME = HERE.parent
+ROOT = HERE.parents[2]
+GENERATOR = HOME / "generator.py"
+TASK_ID = "694d3ee0b12a"
+EXPECTED_GENERATOR_SHA256 = "89c1d7b7cbc7ce45db5ba9c72040350c9ef1c3e329e4a507b8498eaa46401ddb"
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location("_694d3ee0b12a_portable_probe_generator", GENERATOR)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load {GENERATOR}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _selected_program() -> str:
+    from arcpuzzles import Catalog
+
+    record = Catalog(ROOT).get(TASK_ID)
+    programs = {
+        variant["program_solution"]
+        for variant in record["variants"]
+        if isinstance(variant.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise ValueError(f"expected one selected program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def _canonical_pairs() -> list[dict[str, Any]]:
+    from reviewer_support import canonical_pairs
+
+    return canonical_pairs(TASK_ID, root=ROOT)
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _execute_racket(program: str, grid: list[list[int]]):
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+    from reviewer_support import normalize_grid
+
+    with RacketBridge(max_calls_before_restart=48) as bridge:
+        identity = dict(bridge.runtime_identity)
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError(f"protected Racket required, got {identity}")
+        output = normalize_grid(bridge.eval_text(f"({wrap_rule(program)} {_grid_literal(grid)})"))
+    return identity, output
+
+
+def build_report(*, execute_racket: bool = True) -> dict[str, Any]:
+    generator = _load_generator()
+    generator_sha = hashlib.sha256(GENERATOR.read_bytes()).hexdigest()
+    if generator_sha != EXPECTED_GENERATOR_SHA256:
+        raise ValueError(f"generator source drift: {generator_sha}")
+    program = _selected_program()
+    pairs = _canonical_pairs()
+    rival = generator.CANONICAL_SHORTCUTS["fixed_bottom_right_key"]
+    shortcut_fits = [rival(pair["input"]) == pair["output"] for pair in pairs]
+    if not pairs or not all(shortcut_fits):
+        raise ValueError("fixed-key shortcut no longer fits every canonical pair")
+
+    generation = {
+        "seed": 0,
+        "sample_index": 0,
+        "difficulty": "medium",
+        "scene_profile": "pair_down_right",
+    }
+    grid = generator.generate(**generation)
+    intended = generator.rule_mirror(grid)
+    shortcut = rival(grid)
+    if intended is None or shortcut is None:
+        raise RuntimeError("current generator mirror or shortcut rejected witness")
+    differences = [
+        {"row": r, "col": c, "intended": intended[r][c], "shortcut": shortcut[r][c]}
+        for r in range(len(grid))
+        for c in range(len(grid[0]))
+        if intended[r][c] != shortcut[r][c]
+    ]
+    if not differences:
+        raise ValueError("generated scene does not refute fixed-key shortcut")
+
+    racket: dict[str, Any] = {"status": "not_requested", "evaluations": 0}
+    if execute_racket:
+        identity, actual = _execute_racket(program, grid)
+        if actual != intended:
+            raise RuntimeError("Python rule mirror differs from protected Racket")
+        racket = {**identity, "status": "passed", "evaluations": 1, "matches_python_mirror": True}
+
+    return {
+        "schema": "arcpuzzles-peer-shortcut-replay-v1",
+        "task_id": TASK_ID,
+        "status": "counterexample_replayed",
+        "generator_sha256": generator_sha,
+        "generator_version": generator.VERSION,
+        "rule_hash": generator.RULE_HASH,
+        "program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "shortcut": "Use local bottom-right interior cell (5,5) as every frame's fill key.",
+        "canonical_pairs_checked": len(pairs),
+        "shortcut_fits_all_canonical_pairs": all(shortcut_fits),
+        "generation": generation,
+        "observed_overrides": generator.observe_overrides(grid),
+        "input": grid,
+        "authoritative_output": intended,
+        "shortcut_output": shortcut,
+        "shortcut_refuted_by_generated_input": shortcut != intended,
+        "differing_cells": len(differences),
+        "differences": differences,
+        "racket": racket,
+        "recommendation": (
+            "Keep at least one visible frame whose key is not at local (5,5); the current generator "
+            "already enforces this in its first frame."
+        ),
+        "limits": "One retained shortcut and one generated witness; no claim against untested rivals.",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--no-racket", action="store_true")
+    args = parser.parse_args()
+    report = build_report(execute_racket=not args.no_racket)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "canonical_pairs_checked": report["canonical_pairs_checked"],
+                "differing_cells": report["differing_cells"],
+                "racket_evaluations": report["racket"]["evaluations"],
+                "out": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
