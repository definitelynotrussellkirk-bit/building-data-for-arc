+#!/usr/bin/env python3
+"""Find/replay a fixed-control-order teaching shortcut for task 5a215cef8bd1.
+
+The wrong solver learns the control-panel permutation from the demonstrations
+and reuses it for every query.  The probe retains a concrete three-demo window
+where that rule fits every visible label but fails the next lawful query.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+HERE = Path(__file__).resolve().parent
+HOME = HERE.parent
+GENERATOR = HOME / "generator.py"
+REFERENCE = HERE / "reference_probe.py"
+TASK_ID = "5a215cef8bd1"
+EXPECTED_GENERATOR_SHA256 = "49bc35a0a7bbd175ccca39ef864dd46f874d7d0f09f42030c8280ab9b60b8776"
+
+
+def _load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _modules():
+    reference = _load(REFERENCE, "_5a215cef8bd1_control_order_reference")
+    generator = reference.load_generator(GENERATOR)
+    return generator, reference
+
+
+def fixed_control_order_output(grid: list[list[int]], order_index: int, reference=None):
+    """Apply the query template but freeze panel positions to one learned order."""
+    if reference is None:
+        _, reference = _modules()
+    if type(order_index) is not int or not 0 <= order_index < len(reference.CONTROL_ORDERS):
+        raise ValueError("order_index must select CONTROL_ORDERS")
+    template = reference.crop_template(grid)
+    th, tw = len(template), len(template[0])
+    out = [[0] * (2 * tw + 1) for _ in range(2 * th + 1)]
+    transform = {
+        1: lambda value: deepcopy(value),
+        3: reference.rotate_cw,
+        4: reference.rotate_180,
+        6: reference.flip_lr,
+    }
+    for position, color in enumerate(reference.CONTROL_ORDERS[order_index]):
+        qr, qc = divmod(position, 2)
+        block = reference._recolor(transform[color](template))
+        reference._paste_clip(out, block, qr * (th + 1), qc * (tw + 1))
+    return out
+
+
+def find_window(*, demos: int = 3, difficulty: str = "hard", max_seed: int = 5000):
+    if type(demos) is not int or not 2 <= demos <= 6:
+        raise ValueError("demos must be an exact integer in 2..6")
+    if difficulty not in {"easy", "medium", "hard"}:
+        raise ValueError("difficulty must be easy, medium, or hard")
+    if type(max_seed) is not int or max_seed <= 0:
+        raise ValueError("max_seed must be a positive exact integer")
+    generator, reference = _modules()
+    for seed in range(max_seed):
+        grids = [generator.generate(seed, index, difficulty=difficulty) for index in range(demos + 1)]
+        orders = [reference.observed(grid)["control_order"] for grid in grids]
+        if len(set(orders[:demos])) == 1 and orders[demos] != orders[0]:
+            return {"seed": seed, "grids": grids, "control_orders": orders}
+    raise LookupError(f"no fixed-order window found below seed {max_seed}")
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _racket_labels(program: str, grids: list[list[list[int]]]):
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+    from reviewer_support import normalize_grid
+
+    with RacketBridge(max_calls_before_restart=48) as bridge:
+        identity = dict(bridge.runtime_identity)
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError(f"protected Racket required, got {identity}")
+        labels = [
+            normalize_grid(bridge.eval_text(f"({wrap_rule(program)} {_grid_literal(grid)})"))
+            for grid in grids
+        ]
+    return identity, labels
+
+
+def build_report(
+    *,
+    seed: int = 913,
+    demos: int = 3,
+    difficulty: str = "hard",
+    execute_racket: bool = True,
+) -> dict[str, Any]:
+    generator, reference = _modules()
+    generator_sha = hashlib.sha256(GENERATOR.read_bytes()).hexdigest()
+    if generator_sha != EXPECTED_GENERATOR_SHA256:
+        raise ValueError(f"generator source drift: {generator_sha}")
+    grids = [generator.generate(seed, index, difficulty=difficulty) for index in range(demos + 1)]
+    orders = [reference.observed(grid)["control_order"] for grid in grids]
+    learned_order = orders[0]
+    intended = [reference.panel_output(grid) for grid in grids]
+    rival = [fixed_control_order_output(grid, learned_order, reference) for grid in grids]
+    demo_matches = [a == b for a, b in zip(intended[:demos], rival[:demos])]
+    query_diff = intended[demos] != rival[demos]
+    differing = sum(
+        a != b
+        for row_a, row_b in zip(intended[demos], rival[demos])
+        for a, b in zip(row_a, row_b)
+    )
+    if not all(demo_matches) or not query_diff:
+        raise ValueError("requested lesson is not a fixed-control-order counterexample")
+
+    rule = reference.canonical_rule_source()
+    racket = {"status": "not_requested", "evaluations": 0}
+    if execute_racket:
+        identity, labels = _racket_labels(rule, grids)
+        mismatches = [index for index, (actual, expected) in enumerate(zip(labels, intended)) if actual != expected]
+        if mismatches:
+            raise RuntimeError(f"Python oracle differs from canonical Racket at {mismatches}")
+        racket = {**identity, "status": "passed", "evaluations": len(labels), "mismatches": []}
+
+    return {
+        "schema": "arcpuzzles-peer-lesson-shortcut-v1",
+        "task_id": TASK_ID,
+        "status": "counterexample",
+        "generator_sha256": generator_sha,
+        "rule_sha256": hashlib.sha256(rule.encode()).hexdigest(),
+        "rule_hash": generator.RULE_HASH,
+        "difficulty": difficulty,
+        "seed": seed,
+        "sample_indices": list(range(demos + 1)),
+        "demos": demos,
+        "control_orders": orders,
+        "learned_fixed_order": learned_order,
+        "shortcut": "Freeze the demonstrations' control permutation and ignore the query control positions.",
+        "shortcut_fits_demonstrations": all(demo_matches),
+        "shortcut_fails_query": query_diff,
+        "differing_query_cells": differing,
+        "train": [
+            {"input": grid, "output": output, "shortcut_output": wrong}
+            for grid, output, wrong in zip(grids[:demos], intended[:demos], rival[:demos])
+        ],
+        "query": {"input": grids[demos], "output": intended[demos], "shortcut_output": rival[demos]},
+        "racket": racket,
+        "recommendation": (
+            "When assembling a three-demonstration lesson, require at least two control_order values "
+            "or otherwise include a demonstration whose panel permutation differs from the first."
+        ),
+        "limits": (
+            "One concrete consecutive-sample lesson and one explicit rival; this is not a universal "
+            "ambiguity claim over all lesson assemblers."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed", type=int, default=913)
+    parser.add_argument("--demos", type=int, default=3)
+    parser.add_argument("--difficulty", choices=("easy", "medium", "hard"), default="hard")
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--no-racket", action="store_true")
+    parser.add_argument("--find", action="store_true", help="search the first matching seed below --max-seed")
+    parser.add_argument("--max-seed", type=int, default=5000)
+    args = parser.parse_args()
+    seed = args.seed
+    if args.find:
+        seed = find_window(demos=args.demos, difficulty=args.difficulty, max_seed=args.max_seed)["seed"]
+    report = build_report(
+        seed=seed,
+        demos=args.demos,
+        difficulty=args.difficulty,
+        execute_racket=not args.no_racket,
+    )
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "seed": report["seed"],
+                "control_orders": report["control_orders"],
+                "differing_query_cells": report["differing_query_cells"],
+                "racket_evaluations": report["racket"]["evaluations"],
+                "out": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
