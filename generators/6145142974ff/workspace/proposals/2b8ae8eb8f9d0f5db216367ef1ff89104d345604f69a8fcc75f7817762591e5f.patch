+"""Regression for the portable fixed-bottom-right-key shortcut replay."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+
+HOME = Path(__file__).resolve().parents[1]
+PROBE = HOME / "workspace" / "fixed_key_shortcut_probe.py"
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location("_fixed_key_shortcut_probe", PROBE)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {PROBE}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_portable_probe_replays_source_bound_shortcut_without_racket():
+    probe = _load()
+    report = probe.build_report(execute_racket=False)
+    assert report["status"] == "counterexample_replayed"
+    assert report["shortcut_fits_all_canonical_pairs"] is True
+    assert report["shortcut_refuted_by_generated_input"] is True
+    assert report["differing_cells"] == 9
+    assert report["generator_sha256"] == probe.EXPECTED_GENERATOR_SHA256
