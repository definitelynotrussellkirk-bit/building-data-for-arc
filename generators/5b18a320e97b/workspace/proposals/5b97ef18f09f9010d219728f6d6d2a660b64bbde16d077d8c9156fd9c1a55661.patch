+#!/usr/bin/env python3
+"""Protected-Racket probe for a height-4-only shortcut in a3fcfe29ef7e."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from arcpuzzles import Catalog
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator, normalize_grid
+
+TASK_ID = "a3fcfe29ef7e"
+PREDICATE = "(if (and (zero? (at g r c)) (zero? (at g r (+ c 4)))) 3 0)"
+
+
+def _canonical_program(root: Path) -> str:
+    found = set()
+    for line in canonical_path(root).read_text(encoding="utf-8").splitlines():
+        if not line.strip():
+            continue
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID and isinstance(row.get("program_solution"), str):
+            found.add(row["program_solution"])
+    if len(found) != 1:
+        raise ValueError(f"expected one canonical program, got {len(found)}")
+    return found.pop()
+
+
+def _shortcut_program(canonical: str) -> str:
+    if canonical.count(PREDICATE) != 1:
+        raise ValueError("canonical cell predicate changed")
+    return canonical.replace(PREDICATE, f"(if (= h 4) {PREDICATE} 0)", 1)
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _execute(bridge: RacketBridge, wrapped: str, grid: list[list[int]]) -> list[list[int]]:
+    return normalize_grid(bridge.eval_text(f"({wrapped} {_literal(grid)})"))
+
+
+def _disagreement(left: list[list[int]], right: list[list[int]]) -> int:
+    if len(left) != len(right) or len(left[0]) != len(right[0]):
+        raise ValueError("shape mismatch")
+    return sum(a != b for row_a, row_b in zip(left, right, strict=True) for a, b in zip(row_a, row_b, strict=True))
+
+
+def probe(root: Path | str | None = None) -> dict[str, Any]:
+    root = find_root(__file__) if root is None else Path(root).resolve()
+    generator, source, generator_sha256 = load_selected_generator(TASK_ID, root=root)
+    meta = Catalog(root).describe(TASK_ID)
+    canonical = _canonical_program(root)
+    shortcut = _shortcut_program(canonical)
+    demos = [pair for pair in canonical_pairs(TASK_ID, root=root, labeled_only=True) if pair["split"] == "train"]
+    query = generator.generate(
+        17,
+        1,
+        grid_h=6,
+        both_zero_count=2,
+        left_color=7,
+        right_color=5,
+        sep_color=1,
+        layout="random",
+    )
+    query_errors = generator.self_check(query)
+    if query_errors:
+        raise AssertionError(query_errors)
+
+    with RacketBridge(timeout=30) as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires protected Racket")
+        wrapped = [wrap_rule(program) for program in (canonical, shortcut)]
+        visible = []
+        for pair in demos:
+            correct = _execute(bridge, wrapped[0], pair["input"])
+            rival = _execute(bridge, wrapped[1], pair["input"])
+            visible.append(
+                {
+                    "pair_index": pair["pair_index"],
+                    "input_height": len(pair["input"]),
+                    "canonical_matches": correct == pair["output"],
+                    "shortcut_matches": rival == pair["output"],
+                }
+            )
+        correct_query = _execute(bridge, wrapped[0], query)
+        shortcut_query = _execute(bridge, wrapped[1], query)
+
+    if not all(row["canonical_matches"] and row["shortcut_matches"] for row in visible):
+        raise AssertionError("shortcut did not fit every visible demonstration")
+    disagreement = _disagreement(correct_query, shortcut_query)
+    if disagreement == 0:
+        raise AssertionError("height-six query did not separate shortcut")
+    return {
+        "schema": "arcpuzzles-peer-shortcut-probe-v1",
+        "status": "shortcut_survives_visible_demos",
+        "task_id": TASK_ID,
+        "finding": "Every visible canonical demonstration has height 4, so a rule that applies occupancy-NOR only at height 4 fits them but fails a lawful height-6 query.",
+        "shortcut": "if input height is four apply the canonical rule, otherwise emit zeros",
+        "generator_path": source.relative_to(root).as_posix(),
+        "generator_sha256": generator_sha256,
+        "rule_hash": meta["rule_hash"],
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "shortcut_program_sha256": hashlib.sha256(shortcut.encode()).hexdigest(),
+        "visible_demonstrations": visible,
+        "query": {
+            "input": query,
+            "input_shape": [len(query), len(query[0])],
+            "self_check": query_errors,
+            "canonical_output": correct_query,
+            "shortcut_output": shortcut_query,
+            "disagreement_cells": disagreement,
+        },
+        "racket": {key: identity[key] for key in ("backend", "protected", "binary_sha256", "prelude_sha256", "bridge_sha256") if key in identity},
+        "recommendation": "Keep a non-height-4 demonstration in any lesson whose query may vary height; the current generated curriculum already spans heights, but the canonical visible lesson alone does not.",
+        "limits": "One canonical lesson and one lawful generated counterexample; no universal shortcut census.",
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = probe()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({"status": report["status"], "demos": len(report["visible_demonstrations"]), "disagreement": report["query"]["disagreement_cells"], "out": str(args.out)}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
