+"""Native marker-normalized kaleidoscope family for 196a7ec58bbc."""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+from pathlib import Path
+import random
+
+HERE = Path(__file__).resolve().parent
+TASK_ID = "196a7ec58bbc"
+SETTINGS = ("canonical", "marker_to_top_left")
+DEMO_SIZES = (2, 3, 4, 5, 6, 7)
+QUERY_SIZES = (8, 10, 12, 15)
+DEMO_CORNERS = ("top_right", "bottom_left", "bottom_right", "top_right", "bottom_left", "bottom_right")
+QUERY_CORNERS = ("top_right", "bottom_right", "bottom_left", "top_right")
+
+
+def _read(name: str) -> str:
+    return (HERE / name).read_text(encoding="utf-8")
+
+
+def _setting(settings) -> str:
+    if type(settings) is not dict or set(settings) != {"layout_rule"}:
+        raise ValueError("settings must name exactly layout_rule")
+    value = settings["layout_rule"]
+    if type(value) is not str or value not in SETTINGS:
+        raise ValueError(f"layout_rule must be one of {SETTINGS}")
+    return value
+
+
+def program(settings) -> str:
+    value = _setting(settings)
+    return _read("canonical.rkt" if value == "canonical" else "marker_to_top_left.rkt")
+
+
+def _rotate_cw(grid):
+    return [list(row) for row in zip(*grid[::-1])]
+
+
+def _rotations(grid):
+    r0 = [list(row) for row in grid]
+    r1 = _rotate_cw(r0)
+    r2 = _rotate_cw(r1)
+    r3 = _rotate_cw(r2)
+    return r0, r1, r2, r3
+
+
+def _tile(grid):
+    original, clockwise, half_turn, counterclockwise = _rotations(grid)
+    top = [left + right for left, right in zip(original, clockwise)]
+    bottom = [left + right for left, right in zip(counterclockwise, half_turn)]
+    return top + bottom
+
+
+def marker_corner(grid) -> str:
+    h, w = len(grid), len(grid[0])
+    corners = {
+        "top_left": grid[0][0],
+        "top_right": grid[0][w - 1],
+        "bottom_right": grid[h - 1][w - 1],
+        "bottom_left": grid[h - 1][0],
+    }
+    hits = [name for name, value in corners.items() if value == 9]
+    if len(hits) != 1 or sum(value == 9 for row in grid for value in row) != 1:
+        raise ValueError("expected one unique color-9 corner marker")
+    return hits[0]
+
+
+def _normalize_to(grid, target: str):
+    current = marker_corner(grid)
+    order = ("top_left", "top_right", "bottom_right", "bottom_left")
+    if target not in order:
+        raise ValueError("invalid target corner")
+    turns = (order.index(target) - order.index(current)) % 4
+    # Clockwise rotation advances a corner one step through the order.
+    result = [list(row) for row in grid]
+    for _ in range(turns):
+        result = _rotate_cw(result)
+    return result
+
+
+def transform(grid, layout_rule: str):
+    if layout_rule == "canonical":
+        return _tile(grid)
+    if layout_rule == "marker_to_top_left":
+        return _tile(_normalize_to(grid, "top_left"))
+    raise ValueError("unknown layout rule")
+
+
+def rival_transform(grid, target_corner: str):
+    return _tile(_normalize_to(grid, target_corner))
+
+
+def _rng(seed: int, split: str, index: int) -> random.Random:
+    digest = hashlib.sha256(f"{TASK_ID}:native-v1:{seed}:{split}:{index}".encode()).digest()
+    return random.Random(int.from_bytes(digest[:16], "big"))
+
+
+def _input(seed: int, split: str, index: int):
+    sizes = DEMO_SIZES if split == "train" else QUERY_SIZES
+    corners = DEMO_CORNERS if split == "train" else QUERY_CORNERS
+    n, corner = sizes[index], corners[index]
+    rng = _rng(seed, split, index)
+    palette_size = 3 + ((seed + index + (0 if split == "train" else 1)) % 3)
+    palette = rng.sample(list(range(0, 9)), palette_size)
+    rng.shuffle(palette)
+    grid = []
+    for r in range(n):
+        row = []
+        for c in range(n):
+            jitter = rng.randrange(palette_size)
+            row.append(palette[(r * 3 + c * 5 + r * c + jitter) % palette_size])
+        grid.append(row)
+    positions = {
+        "top_left": (0, 0),
+        "top_right": (0, n - 1),
+        "bottom_right": (n - 1, n - 1),
+        "bottom_left": (n - 1, 0),
+    }
+    r, c = positions[corner]
+    grid[r][c] = 9
+    return grid
+
+
+def _integer(name: str, value: int, low: int, high: int) -> int:
+    if type(value) is not int or not low <= value <= high:
+        raise ValueError(f"{name} must be an exact integer in {low}..{high}")
+    return value
+
+
+def generate(seed, settings, demos, queries):
+    _integer("seed", seed, 0, 2**63 - 1)
+    _integer("demos", demos, 2, 6)
+    _integer("queries", queries, 1, 4)
+    selected = _setting(settings)
+    train = []
+    test = []
+    for split, count, target in (("train", demos, train), ("test", queries, test)):
+        for index in range(count):
+            grid = _input(seed, split, index)
+            target.append({"input": grid, "output": transform(grid, selected)})
+    return {"train": train, "test": test, "program_solution": program(settings)}
+
+
+def public_turn(episode, query_index: int):
+    if type(query_index) is not int or not 0 <= query_index < len(episode.get("test", [])):
+        raise ValueError("query_index is outside the episode")
+    return {
+        "train": deepcopy(episode["train"]),
+        "test": [{"input": deepcopy(episode["test"][query_index]["input"])}],
+    }
