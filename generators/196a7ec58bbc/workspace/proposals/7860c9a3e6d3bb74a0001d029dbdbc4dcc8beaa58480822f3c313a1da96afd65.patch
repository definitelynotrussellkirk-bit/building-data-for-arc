+from __future__ import annotations
+
+import hashlib
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+HERE = Path(__file__).resolve()
+NATIVE = HERE.parents[1] / "workspace" / "parametric" / "native.py"
+
+
+def load_native():
+    spec = importlib.util.spec_from_file_location("_native_196_test", NATIVE)
+    module = importlib.util.module_from_spec(spec)
+    assert spec and spec.loader
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_default_program_is_exact_canonical_and_alternative_is_distinct():
+    native = load_native()
+    canonical = native.program({"layout_rule": "canonical"})
+    alternate = native.program({"layout_rule": "marker_to_top_left"})
+    assert hashlib.sha256(canonical.encode()).hexdigest() == (
+        "b8c0009358927f3fbcfb6bf93fa8a19e3b5e80a76efeca70034cff45562abd78"
+    )
+    assert alternate != canonical
+
+
+def test_matched_inputs_prefixes_and_four_query_stress():
+    native = load_native()
+    canonical = native.generate(17, {"layout_rule": "canonical"}, 2, 4)
+    alternate = native.generate(17, {"layout_rule": "marker_to_top_left"}, 2, 4)
+    assert [p["input"] for p in canonical["train"] + canonical["test"]] == [
+        p["input"] for p in alternate["train"] + alternate["test"]
+    ]
+    assert all(a["output"] != b["output"] for a, b in zip(canonical["train"], alternate["train"]))
+    assert all(a["output"] != b["output"] for a, b in zip(canonical["test"], alternate["test"]))
+    assert len(canonical["test"]) == 4
+    assert len(canonical["test"][-1]["input"]) == 15
+    assert len(canonical["test"][-1]["output"]) == 30
+    assert len(canonical["test"][-1]["output"][0]) == 30
+
+    longer_demos = native.generate(17, {"layout_rule": "canonical"}, 6, 4)
+    fewer_queries = native.generate(17, {"layout_rule": "canonical"}, 2, 1)
+    assert canonical["train"] == longer_demos["train"][:2]
+    assert canonical["test"] == longer_demos["test"]
+    assert canonical["train"] == fewer_queries["train"]
+    assert canonical["test"][:1] == fewer_queries["test"]
+
+
+def test_public_turn_is_single_query_masked_and_first_turn_stable():
+    native = load_native()
+    episode = native.generate(3, {"layout_rule": "marker_to_top_left"}, 3, 4)
+    one_query = native.generate(3, {"layout_rule": "marker_to_top_left"}, 3, 1)
+    turn = native.public_turn(episode, 0)
+    assert turn == native.public_turn(one_query, 0)
+    assert set(turn) == {"train", "test"}
+    assert len(turn["test"]) == 1
+    assert set(turn["test"][0]) == {"input"}
+    visible = repr(turn).lower()
+    for forbidden in ("layout_rule", "program_solution", "seed", "queries", "answer"):
+        assert forbidden not in visible
+
+
+def test_strict_inputs_and_counts_fail_closed():
+    native = load_native()
+    bad_calls = [
+        lambda: native.generate(True, {"layout_rule": "canonical"}, 2, 4),
+        lambda: native.generate(-1, {"layout_rule": "canonical"}, 2, 4),
+        lambda: native.generate(0, {"layout_rule": "canonical"}, 1, 4),
+        lambda: native.generate(0, {"layout_rule": "canonical"}, 2, 5),
+        lambda: native.generate(0, {"layout_rule": "unknown"}, 2, 4),
+        lambda: native.generate(0, {"layout_rule": "canonical", "extra": 1}, 2, 4),
+    ]
+    for call in bad_calls:
+        with pytest.raises(ValueError):
+            call()
+
+
+def test_two_demonstrations_reject_fixed_corner_normalization_rivals():
+    native = load_native()
+    candidates = {
+        "canonical": lambda grid: native.transform(grid, "canonical"),
+        "top_left": lambda grid: native.rival_transform(grid, "top_left"),
+        "top_right": lambda grid: native.rival_transform(grid, "top_right"),
+        "bottom_right": lambda grid: native.rival_transform(grid, "bottom_right"),
+        "bottom_left": lambda grid: native.rival_transform(grid, "bottom_left"),
+    }
+    chosen_name = {"canonical": "canonical", "marker_to_top_left": "top_left"}
+    for seed in (0, 17):
+        for setting in ("canonical", "marker_to_top_left"):
+            episode = native.generate(seed, {"layout_rule": setting}, 2, 4)
+            for name, rival in candidates.items():
+                if name == chosen_name[setting]:
+                    continue
+                assert not all(rival(pair["input"]) == pair["output"] for pair in episode["train"])
