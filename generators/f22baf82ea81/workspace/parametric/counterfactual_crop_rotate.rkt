(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((cells (for*/list ((r (range 0 h)) (c (range 0 w)) #:when (!= (at g r c) 0))
                           (list r c (at g r c))))
                  (r1 (min-of first cells))
                  (r2 (max-of first cells))
                  (c1 (min-of second cells))
                  (c2 (max-of second cells))
                  (base
                   (build-grid (+ 1 (- r2 r1))
                               (+ 1 (- c2 c1))
                               (r c)
                               (at g (+ r1 r) (+ c1 c)))))
             (build-grid (cols base)
                         (rows base)
                         (r c)
                         (at base (- (rows base) 1 c) r))))))
