(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((cells (for*/list ((r (range 0 h)) (c (range 0 w)) #:when (!= (at g r c) 0))
                           (list r c (at g r c))))
                  (r1 (min-of first cells))
                  (r2 (max-of first cells))
                  (c1 (min-of second cells))
                  (c2 (max-of second cells))
                  (outer-color (at g r1 c1))
                  (inner-color (let find
                                    ((cs cells))
                                    (cond
                                      ((null? cs) 0)
                                      ((!= (third (car cs)) outer-color) (third (car cs)))
                                      (else (find (cdr cs))))))
                  (base
                   (build-grid (+ 1 (- r2 r1))
                               (+ 1 (- c2 c1))
                               (r c)
                               (let ((v (at g (+ r1 r) (+ c1 c))))
                                 (cond
                                   ((= v outer-color) inner-color)
                                   ((= v inner-color) outer-color)
                                   (else v))))))
             (build-grid (cols base)
                         (rows base)
                         (r c)
                         (at base (- (rows base) 1 c) r))))))
