  "shortcut_program": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (let* ((cells (filter (lambda (p) (!= (at g (fst p) (snd p)) 0))\n                                 (grid-positions g)))\n                  (color (at g (fst (fst cells)) (snd (fst cells))))\n                  (r0 (min-of fst cells))\n                  (c0 (min-of snd cells))\n                  (r1 (max-of fst cells))\n                  (c1 (max-of snd cells))\n                  (bh (+ 1 (- r1 r0)))\n                  (bw (+ 1 (- c1 c0)))\n                  (n (+ (* 2 bw) bh))\n                  (norm (map (lambda (p) (list (- (fst p) r0) (- (snd p) c0))) cells)))\n             (define (stamp acc cs tr tc)\n               (reduce (lambda (a p) (set-cell a (+ tr (fst p)) (+ tc (snd p)) color))\n                       acc\n                       cs))\n             (let* ((cw (map (lambda (p) (list (snd p) (fst p))) norm))\n                    (ccw (map (lambda (p) (list (- bw 1 (snd p)) (- bh 1 (fst p)))) norm))\n                    (flr (map (lambda (p) (list (- bh 1 (fst p)) (- bw 1 (snd p)))) norm))\n                    (blank (build-grid n n (r c) 0))\n                    (top (stamp blank cw 0 bw))\n                    (left (stamp top norm bw 0))\n                    (right (stamp left flr bw (+ bw bh))))\n               (stamp right ccw (+ bw bh) bw))))))",
