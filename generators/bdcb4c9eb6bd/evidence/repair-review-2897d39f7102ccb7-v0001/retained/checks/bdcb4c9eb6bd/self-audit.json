    "program": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (let* ((hh (rows g))\n                  (ww (cols g))\n                  (bg (mode g -1))\n                  (objs (objects g bg))\n                  (selected (pick-max objs (lambda (o) (* (- (obj-h o) 2) (- (obj-w o) 2)))))\n                  (result g))\n             (for ((obj objs))\n               (when\n                 (and (= (obj-color obj) 1) (equal? obj selected))\n                 (with-bbox obj\n                            (r1 c1 r2 c2)\n                            (let* ((top-full (for/and ((c (range c1 (+ c2 1))))\n                                                      (= (at g r1 c) 1)))\n                                   (bot-full (for/and ((c (range c1 (+ c2 1))))\n                                                      (= (at g r2 c) 1)))\n                                   (lft-full (for/and ((r (range r1 (+ r2 1))))\n                                                      (= (at g r c1) 1)))\n                                   (rgt-full (for/and ((r (range r1 (+ r2 1))))\n                                                      (= (at g r c2) 1)))\n                                   (open-dir (cond\n                                               ((not top-full) 'up)\n                                               ((not bot-full) 'down)\n                                               ((not lft-full) 'left)\n                                               ((not rgt-full) 'right)\n                                               (else 'none))))\n                              (begin\n                                (for* ((r (range (+ r1 1) r2)) (c (range (+ c1 1) c2)))\n                                      (when\n                                        (= (at result r c) bg)\n                                        (set! result (set-cell result r c 2))))\n                                (cond\n                                  ((equal? open-dir 'left) (for ((r (range (+ r1 1) r2)))\n                                      (when\n                                        (!= (at g r c1) 1)\n                                        (for ((c (range 0 (+ c1 1))))\n                                          (when\n                                            (= (at result r c) bg)\n                                            (set! result (set-cell result r c 2)))))))\n                                  ((equal? open-dir 'right) (for ((r (range (+ r1 1) r2)))\n                                      (when\n                                        (!= (at g r c2) 1)\n                                        (for ((c (range c2 ww)))\n                                          (when\n                                            (= (at result r c) bg)\n                                            (set! result (set-cell result r c 2)))))))\n                                  ((equal? open-dir 'up) (for ((c (range (+ c1 1) c2)))\n                                      (when\n                                        (!= (at g r1 c) 1)\n                                        (for ((r (range 0 (+ r1 1))))\n                                          (when\n                                            (= (at result r c) bg)\n                                            (set! result (set-cell result r c 2)))))))\n                                  ((equal? open-dir 'down) (for ((c (range (+ c1 1) c2)))\n                                      (when\n                                        (!= (at g r2 c) 1)\n                                        (for ((r (range r2 hh)))\n                                          (when\n                                            (= (at result r c) bg)\n                                            (set! result (set-cell result r c 2)))))))))))))\n             result))))",
