+"""Focused contract for the retained fixed-template shortcut probe."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+
+
+def load_probe():
+    path = HOME / "workspace" / "learnability_probe.py"
+    assert path.is_file(), "fixed-template learnability probe has not been built"
+    spec = importlib.util.spec_from_file_location("_test_285_probe", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_known_three_demo_window_exposes_fixed_template_shortcut():
+    probe = load_probe()
+    case = probe.find_candidate(seed_stop=2, start_stop=11)
+    assert (case["seed"], case["start"]) == (1, 7)
+    assert case["shape_indices"] == [3, 3, 3, 0]
+    frozen = {tuple(tuple(pair) for pair in shape) for shape in case["offsets"][:3]}
+    assert len(frozen) == 1
+    assert case["offsets"][3] != case["offsets"][0]
+
+    fixed = [probe.fixed_shape_output(grid, case["offsets"][0]) for grid in case["inputs"]]
+    intended = [probe.input_conditioned_output(grid) for grid in case["inputs"]]
+    assert fixed[:3] == intended[:3]
+    assert fixed[3] != intended[3]
+
+
+@pytest.mark.parametrize("seed_stop,start_stop", [(0, 1), (1, 7)])
+def test_invalid_or_too_small_search_bounds_are_rejected(seed_stop, start_stop):
+    probe = load_probe()
+    with pytest.raises(ValueError):
+        probe.find_candidate(seed_stop=seed_stop, start_stop=start_stop)
