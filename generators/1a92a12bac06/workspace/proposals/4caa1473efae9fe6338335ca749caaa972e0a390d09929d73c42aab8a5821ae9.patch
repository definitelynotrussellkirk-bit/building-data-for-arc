@@ -0,0 +1,206 @@
+#!/usr/bin/env python3
+"""Find and Racket-verify a fixed-template shortcut for task 2855283336a4.
+
+The intended rule reads the color-2 template independently in every input. This
+probe searches three-demo windows where all visible templates happen to match
+but the held-out query template changes. A solver that memorizes the visible
+shape then fits every demonstration and fails the query.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+TASK_ID = "2855283336a4"
+EXPECTED_GENERATOR_SHA256 = "37c7a144060d5d9dcf2e2939554cdfa5ea4d4db582d040a89fcbdca28f6d919a"
+
+
+def _repo_root() -> Path:
+    here = Path(__file__).resolve()
+    for parent in here.parents:
+        if (parent / "shared/runtime/reviewer_support.py").is_file():
+            return parent
+    raise RuntimeError("could not locate repository root")
+
+
+def _load_generator():
+    from reviewer_support import load_selected_generator
+
+    module, source, source_sha = load_selected_generator(TASK_ID)
+    if source_sha != EXPECTED_GENERATOR_SHA256:
+        raise ValueError(
+            f"peer source drift: expected {EXPECTED_GENERATOR_SHA256}, observed {source_sha}"
+        )
+    return module, Path(source), source_sha
+
+
+def template_offsets(grid: list[list[int]]) -> tuple[tuple[int, int], ...]:
+    cells = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 2]
+    if not cells:
+        raise ValueError("input has no color-2 template")
+    top = min(r for r, _ in cells)
+    left = min(c for _, c in cells)
+    return tuple(sorted((r - top, c - left) for r, c in cells))
+
+
+def fixed_shape_output(
+    grid: list[list[int]], offsets: tuple[tuple[int, int], ...] | list[list[int]]
+) -> list[list[int]]:
+    """Stamp one memorized offset set at every color-1 marker on a blank canvas."""
+    height = len(grid)
+    width = len(grid[0])
+    normalized = tuple((int(dr), int(dc)) for dr, dc in offsets)
+    output = [[0 for _ in range(width)] for _ in range(height)]
+    markers = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 1]
+    if not markers:
+        raise ValueError("input has no color-1 markers")
+    for anchor_r, anchor_c in markers:
+        for dr, dc in normalized:
+            row, col = anchor_r + dr, anchor_c + dc
+            if not (0 <= row < height and 0 <= col < width):
+                raise ValueError("stamp leaves the canvas")
+            output[row][col] = 8
+    return output
+
+
+def input_conditioned_output(grid: list[list[int]]) -> list[list[int]]:
+    return fixed_shape_output(grid, template_offsets(grid))
+
+
+def _shape_index(generator, offsets: tuple[tuple[int, int], ...]) -> int:
+    shapes = [tuple(sorted((int(r), int(c)) for r, c in shape)) for shape in generator._SHAPES]
+    return shapes.index(offsets)
+
+
+def find_candidate(*, seed_stop: int = 64, start_stop: int = 32) -> dict[str, Any]:
+    if type(seed_stop) is not int or type(start_stop) is not int or seed_stop < 2 or start_stop < 8:
+        raise ValueError("search bounds must be exact integers with seed_stop>=2 and start_stop>=8")
+    generator, source, source_sha = _load_generator()
+    for seed in range(seed_stop):
+        for start in range(start_stop):
+            inputs = [generator.generate(seed, start + offset) for offset in range(4)]
+            offsets = [template_offsets(grid) for grid in inputs]
+            if len(set(offsets[:3])) == 1 and offsets[3] != offsets[0]:
+                return {
+                    "seed": seed,
+                    "start": start,
+                    "inputs": inputs,
+                    "offsets": [list(map(list, shape)) for shape in offsets],
+                    "shape_indices": [_shape_index(generator, shape) for shape in offsets],
+                    "generator_path": source.relative_to(_repo_root()).as_posix(),
+                    "generator_sha256": source_sha,
+                }
+    raise LookupError("no fixed-template shortcut found inside bounded search")
+
+
+def _canonical_program(root: Path) -> tuple[str, str]:
+    path = root / "shared/data/canonical/puzzles.jsonl"
+    for line in path.read_text(encoding="utf-8").splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            program = row.get("program_solution")
+            if not isinstance(program, str) or not program.strip():
+                raise ValueError("canonical row has no program")
+            return program, hashlib.sha256(program.encode()).hexdigest()
+    raise LookupError("canonical task row missing")
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def run(out: Path, *, seed_stop: int, start_stop: int) -> dict[str, Any]:
+    if out.exists() or out.is_symlink():
+        raise FileExistsError(f"choose a fresh output path: {out}")
+    root = _repo_root()
+    case = find_candidate(seed_stop=seed_stop, start_stop=start_stop)
+    program, program_sha = _canonical_program(root)
+
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    wrapped = wrap_rule(program)
+    with RacketBridge(max_calls_before_restart=32) as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("protected Racket backend required")
+        labels = [bridge.eval_text(f"({wrapped} {_grid_literal(grid)})") for grid in case["inputs"]]
+
+    intended = [input_conditioned_output(grid) for grid in case["inputs"]]
+    memorized = tuple(tuple(pair) for pair in case["offsets"][0])
+    rival = [fixed_shape_output(grid, memorized) for grid in case["inputs"]]
+    if intended != labels:
+        raise AssertionError("input-conditioned Python mirror differs from protected Racket")
+    if rival[:3] != labels[:3] or rival[3] == labels[3]:
+        raise AssertionError("candidate does not establish the claimed shortcut")
+
+    report = {
+        "schema": "2855283336a4-fixed-template-shortcut-v1",
+        "task_id": TASK_ID,
+        "status": "finding",
+        "generator_path": case["generator_path"],
+        "generator_sha256": case["generator_sha256"],
+        "canonical_program_sha256": program_sha,
+        "racket": identity,
+        "search": {
+            "seed_stop_exclusive": seed_stop,
+            "start_stop_exclusive": start_stop,
+            "selected_seed": case["seed"],
+            "selected_start": case["start"],
+        },
+        "shortcut": (
+            "Memorize the template offsets shown in the demonstrations instead of reading "
+            "the color-2 template independently from each input."
+        ),
+        "shape_indices": case["shape_indices"],
+        "demonstrations": [
+            {"input": deepcopy(case["inputs"][i]), "output": labels[i], "rival_output": rival[i]}
+            for i in range(3)
+        ],
+        "query": {
+            "input": deepcopy(case["inputs"][3]),
+            "output": labels[3],
+            "rival_output": rival[3],
+        },
+        "repair_recommendation": (
+            "Schedule at least two distinct color-2 template offset sets in every visible "
+            "three-example lesson, preferably by a sample-index shape cycle; retain the "
+            "query with a third or otherwise changed template."
+        ),
+        "limits": (
+            "One bounded fixed-shape rival and one protected-Racket witness; no exhaustive "
+            "learnability claim, source repair, approval, or training admission."
+        ),
+    }
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--seed-stop", type=int, default=64)
+    parser.add_argument("--start-stop", type=int, default=32)
+    args = parser.parse_args()
+    try:
+        report = run(args.out, seed_stop=args.seed_stop, start_stop=args.start_stop)
+    except Exception as exc:
+        print(f"learnability_probe: {type(exc).__name__}: {exc}")
+        return 1
+    print(json.dumps({
+        "status": report["status"],
+        "seed": report["search"]["selected_seed"],
+        "start": report["search"]["selected_start"],
+        "shape_indices": report["shape_indices"],
+        "out": str(args.out),
+    }, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
