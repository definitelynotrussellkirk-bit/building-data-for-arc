+#!/usr/bin/env python3
+"""Source-bound query-rotation and Racket-parity probe for 9536d5aef3f6."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "9536d5aef3f6"
+HERE = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+BANDS = ("easy", "medium", "hard")
+STARTS = 12
+
+
+def _canonical_program() -> str:
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(ROOT).read_text().splitlines()
+        if (row := json.loads(line)).get("task_id") == TASK_ID
+        and isinstance(row.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise ValueError(f"expected one exact canonical program, found {len(programs)}")
+    return programs.pop()
+
+
+def _pair(grid: list[list[int]], output: list[list[int]]) -> dict[str, Any]:
+    return {"input": grid, "output": output}
+
+
+def build_report(*, execute_racket: bool = True) -> dict[str, Any]:
+    generator, source, source_sha256 = load_selected_generator(TASK_ID, root=ROOT)
+    program = _canonical_program()
+    apply = None
+    identity: dict[str, Any] = {"backend": "python-claim", "protected": False}
+    bridge = None
+    context = None
+    if execute_racket:
+        runtime = ROOT / "shared/runtime"
+        context = _local_imports(runtime, HERE)
+        context.__enter__()
+        try:
+            apply, identity, bridge = _real_evaluator(runtime)
+        except Exception:
+            context.__exit__(*__import__("sys").exc_info())
+            raise
+
+    findings: list[dict[str, Any]] = []
+    rotations: list[dict[str, Any]] = []
+    racket_mismatches: list[dict[str, Any]] = []
+    racket_evaluations = 0
+    repaired_witness = None
+    try:
+        for band in BANDS:
+            for start in range(STARTS):
+                seed = 23_000 + start
+                grids = [
+                    generator.generate(seed, start + offset, difficulty=band)
+                    for offset in range(4)
+                ]
+                outputs = []
+                for offset, grid in enumerate(grids):
+                    claim = generator.rule_mirror(grid)
+                    actual = apply(program, grid) if apply is not None else claim
+                    if apply is not None:
+                        racket_evaluations += 1
+                        if actual != claim:
+                            racket_mismatches.append(
+                                {"band": band, "start": start, "offset": offset}
+                            )
+                    outputs.append(actual)
+                pairs = [_pair(grid, output) for grid, output in zip(grids, outputs)]
+                profiles = [
+                    generator.schedule_profile(seed, start + offset, band)
+                    for offset in range(4)
+                ]
+                for query_index, query in enumerate(pairs):
+                    demos = [pair for index, pair in enumerate(pairs) if index != query_index]
+                    demo_profiles = [
+                        profile for index, profile in enumerate(profiles) if index != query_index
+                    ]
+                    reasons = generator.lesson_identifiable(demos, query)
+                    conflict_demo_indices = [
+                        index
+                        for index, pair in enumerate(demos)
+                        if generator.SEMANTIC_WITNESSES["unequal_conflict"](pair["input"])
+                    ]
+                    row = {
+                        "band": band,
+                        "start": start,
+                        "seed": seed,
+                        "query_index": query_index,
+                        "profiles": profiles,
+                        "demo_profiles": demo_profiles,
+                        "conflict_demonstrations": len(conflict_demo_indices),
+                        "reasons": reasons,
+                    }
+                    rotations.append(row)
+                    if reasons or not conflict_demo_indices:
+                        findings.append(row)
+                    if band == "easy" and start == 0 and query_index == 2:
+                        rival = generator._rival_fill_empty_only(query["input"])
+                        decisive = [
+                            {
+                                "demo_index": index,
+                                "profile": demo_profiles[index],
+                                "rival_disagrees": (
+                                    generator._rival_fill_empty_only(pair["input"])
+                                    != pair["output"]
+                                ),
+                            }
+                            for index, pair in enumerate(demos)
+                        ]
+                        repaired_witness = {
+                            "schema": "9536d5aef3f6-rotation-repair-witness-v1",
+                            "band": band,
+                            "seed": seed,
+                            "start": start,
+                            "query_index": query_index,
+                            "profiles": profiles,
+                            "demo_profiles": demo_profiles,
+                            "lesson_reasons": reasons,
+                            "decisive_demonstrations": decisive,
+                            "query_input": query["input"],
+                            "selected_output": query["output"],
+                            "fill_empty_only_output": rival,
+                            "rival_disagrees_on_query": rival != query["output"],
+                        }
+    finally:
+        if bridge is not None:
+            bridge.close()
+        if context is not None:
+            context.__exit__(None, None, None)
+
+    if repaired_witness is None:
+        raise RuntimeError("failed to retain the exact repaired rotation witness")
+    status = "pass" if not findings and not racket_mismatches else "fail"
+    return {
+        "schema": "9536d5aef3f6-rotation-probe-v1",
+        "task_id": TASK_ID,
+        "status": status,
+        "generator_version": generator.VERSION,
+        "generator_source": source.relative_to(ROOT).as_posix(),
+        "generator_sha256": source_sha256,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "bands": list(BANDS),
+        "starts_per_band": STARTS,
+        "rotations_checked": len(rotations),
+        "findings": findings,
+        "racket": identity,
+        "racket_evaluations": racket_evaluations,
+        "python_racket_mismatches": racket_mismatches,
+        "minimum_conflict_demonstrations": min(
+            row["conflict_demonstrations"] for row in rotations
+        ),
+        "repaired_witness": repaired_witness,
+        "scope": (
+            "Finite six-slot schedule probe over three bands, twelve starts per band, "
+            "and all four query rotations; not universal learnability proof."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--no-racket", action="store_true")
+    args = parser.parse_args()
+    report = build_report(execute_racket=not args.no_racket)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "rotations_checked": report["rotations_checked"],
+                "minimum_conflict_demonstrations": report[
+                    "minimum_conflict_demonstrations"
+                ],
+                "racket_evaluations": report["racket_evaluations"],
+                "python_racket_mismatches": len(report["python_racket_mismatches"]),
+                "findings": len(report["findings"]),
+                "out": str(args.out),
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+    return 0 if report["status"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
