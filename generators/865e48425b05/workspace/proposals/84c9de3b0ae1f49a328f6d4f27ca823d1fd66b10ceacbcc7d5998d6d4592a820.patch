+#!/usr/bin/env python3
+"""Bounded protected-Racket lesson audit for 95b47c355ae4."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "95b47c355ae4"
+HERE = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+BANDS = ("easy", "medium", "hard")
+STARTS = 20
+
+
+def _canonical_program() -> str:
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(ROOT).read_text().splitlines()
+        if (row := json.loads(line)).get("task_id") == TASK_ID
+        and isinstance(row.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise ValueError(f"expected one exact canonical program, found {len(programs)}")
+    return programs.pop()
+
+
+def build_report(*, execute_racket: bool = True) -> dict[str, Any]:
+    generator, source, source_sha256 = load_selected_generator(TASK_ID, root=ROOT)
+    program = _canonical_program()
+    apply = None
+    identity: dict[str, Any] = {"backend": "python-claim", "protected": False}
+    bridge = None
+    context = None
+    if execute_racket:
+        runtime = ROOT / "shared/runtime"
+        context = _local_imports(runtime, HERE)
+        context.__enter__()
+        try:
+            apply, identity, bridge = _real_evaluator(runtime)
+        except Exception:
+            context.__exit__(*__import__("sys").exc_info())
+            raise
+
+    findings: list[dict[str, Any]] = []
+    parity: list[dict[str, Any]] = []
+    rotations: list[dict[str, Any]] = []
+    racket_evaluations = 0
+    rival_refutations = {name: 0 for name in generator.LESSON_COMPETITORS}
+    topology_profiles: set[tuple[int, ...]] = set()
+    try:
+        for band in BANDS:
+            for start in range(STARTS):
+                seed = 61_000 + start
+                grids = [
+                    generator.generate(seed, start + offset, difficulty=band)
+                    for offset in range(4)
+                ]
+                pairs = []
+                for offset, grid in enumerate(grids):
+                    errors = generator.self_check(grid, difficulty=band)
+                    if errors:
+                        findings.append(
+                            {"band": band, "start": start, "offset": offset, "errors": errors}
+                        )
+                    claim = generator._reference_output(grid)
+                    actual = apply(program, grid) if apply is not None else claim
+                    if apply is not None:
+                        racket_evaluations += 1
+                        if actual != claim:
+                            parity.append({"band": band, "start": start, "offset": offset})
+                    pairs.append({"input": grid, "output": actual})
+                    gray = {
+                        (r, c)
+                        for r, row in enumerate(grid)
+                        for c, value in enumerate(row)
+                        if value == 5
+                    }
+                    sizes = []
+                    while gray:
+                        stack = [gray.pop()]
+                        size = 0
+                        while stack:
+                            r, c = stack.pop()
+                            size += 1
+                            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                                nxt = (r + dr, c + dc)
+                                if nxt in gray:
+                                    gray.remove(nxt)
+                                    stack.append(nxt)
+                        sizes.append(size)
+                    topology_profiles.add(tuple(sorted(sizes)))
+
+                for query_index, query in enumerate(pairs):
+                    demos = [pair for index, pair in enumerate(pairs) if index != query_index]
+                    reasons = generator.lesson_identifiable(demos, query)
+                    survivors = []
+                    for name, rival in generator.LESSON_COMPETITORS.items():
+                        fits = all(rival(pair["input"]) == pair["output"] for pair in demos)
+                        if fits:
+                            survivors.append(name)
+                        else:
+                            rival_refutations[name] += 1
+                    row = {
+                        "band": band,
+                        "start": start,
+                        "seed": seed,
+                        "query_index": query_index,
+                        "surviving_rivals": survivors,
+                        "reasons": reasons,
+                    }
+                    rotations.append(row)
+                    if reasons or survivors:
+                        findings.append(row)
+    finally:
+        if bridge is not None:
+            bridge.close()
+        if context is not None:
+            context.__exit__(None, None, None)
+
+    status = "pass" if not findings and not parity else "fail"
+    return {
+        "schema": "95b47c355ae4-lesson-probe-v1",
+        "task_id": TASK_ID,
+        "status": status,
+        "generator_version": generator.VERSION,
+        "generator_source": source.relative_to(ROOT).as_posix(),
+        "generator_sha256": source_sha256,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "bands": list(BANDS),
+        "starts_per_band": STARTS,
+        "rotations_checked": len(rotations),
+        "racket": identity,
+        "racket_evaluations": racket_evaluations,
+        "python_racket_mismatches": parity,
+        "findings": findings,
+        "rival_refutations": rival_refutations,
+        "gray_topology_profiles": len(topology_profiles),
+        "scope": (
+            "Finite three-band census over twenty starts and all four holdouts "
+            "against the generator's six declared rivals; not universal uniqueness."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--no-racket", action="store_true")
+    args = parser.parse_args()
+    report = build_report(execute_racket=not args.no_racket)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "rotations_checked": report["rotations_checked"],
+                "racket_evaluations": report["racket_evaluations"],
+                "python_racket_mismatches": len(report["python_racket_mismatches"]),
+                "findings": len(report["findings"]),
+                "gray_topology_profiles": report["gray_topology_profiles"],
+                "out": str(args.out),
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+    return 0 if report["status"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
