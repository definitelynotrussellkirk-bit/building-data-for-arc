@@ -0,0 +1,139 @@
+"""Native exemplar-stamping family: as drawn versus clockwise quarter turn."""
+from __future__ import annotations
+
+import copy
+import importlib.util
+from pathlib import Path
+
+import pytest
+from reviewer_support import find_root
+
+
+def adapter():
+    path = find_root(__file__) / "generators/e250cb77a62e/workspace/parametric/adapter.py"
+    assert path.is_file(), "native stamping adapter is missing"
+    spec = importlib.util.spec_from_file_location("_stamp_native_test", path)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_program_preserves_exact_canonical_bytes_and_has_distinct_alternative():
+    a = adapter()
+    canonical = (Path(a.__file__).parent / "canonical.rkt").read_text()
+    assert a.program({"pattern_transform": "as_drawn"}) == canonical
+    alternate = a.program({"pattern_transform": "quarter_turn"})
+    assert alternate != canonical
+    assert alternate.count("(rule!") == 1
+
+
+def test_extracted_pattern_is_consumed_by_distinct_stamping_transforms():
+    a = adapter()
+    episode = a.generate(0, {"pattern_transform": "as_drawn"}, demos=2, queries=4)
+    grid = episode["train"][0]["input"]
+    info = a.analyze(grid)
+    assert info["pattern"] != info["quarter_turn_pattern"]
+    assert len(info["seeds"]) >= 2
+    assert a.claim(grid, "as_drawn") == episode["train"][0]["output"]
+    assert a.claim(grid, "as_drawn") != a.claim(grid, "quarter_turn")
+    assert all(episode["train"][0]["output"][r][c] == 8 for r, c in info["seeds"])
+
+
+def test_bad_requests_and_malformed_inputs_fail_closed():
+    a = adapter()
+    base = dict(seed=0, settings={"pattern_transform": "as_drawn"}, demos=3, queries=4)
+    for change in (
+        {"seed": True}, {"seed": -1}, {"demos": 1}, {"demos": 7},
+        {"queries": True}, {"queries": 0}, {"queries": 5}, {"demos": 2.0},
+        {"settings": {}}, {"settings": {"pattern_transform": "bad"}},
+        {"settings": {"pattern_transform": "as_drawn", "extra": 1}},
+    ):
+        args = dict(base)
+        args.update(change)
+        with pytest.raises(ValueError):
+            a.generate(**args)
+    episode = a.generate(**base)
+    bad = copy.deepcopy(episode["train"][0]["input"])
+    bad[0][0] = True
+    with pytest.raises(ValueError):
+        a.analyze(bad)
+    for grid in ([], [[]], [[0] * 4 for _ in range(4)], [[7] * 4 for _ in range(4)]):
+        with pytest.raises(ValueError):
+            a.analyze(grid)
+
+
+@pytest.mark.parametrize("seed", [0, 17, 63])
+def test_prefixes_matched_settings_distinct_inputs_and_finite_teaching(seed):
+    a = adapter()
+    e2 = a.generate(seed, {"pattern_transform": "quarter_turn"}, demos=2, queries=4)
+    e6 = a.generate(seed, {"pattern_transform": "quarter_turn"}, demos=6, queries=4)
+    assert e2["train"] == e6["train"][:2]
+    assert e2["test"] == e6["test"]
+    assert len({str(p["input"]) for p in e6["train"] + e6["test"]}) == 10
+    for mode in a.SETTINGS:
+        episode = a.generate(seed, {"pattern_transform": mode}, demos=2, queries=4)
+        assert [p["input"] for p in episode["train"] + episode["test"]] == [
+            p["input"] for p in e2["train"] + e2["test"]
+        ]
+        assert a.teaching_check(episode) == []
+    assert a.generate(seed, {"pattern_transform": "quarter_turn"}, 2, 1)["test"] == e2["test"][:1]
+
+
+def test_exact_thirty_by_thirty_stress_has_large_exemplar_and_boundary_stamps():
+    a = adapter()
+    episode = a.generate(17, {"pattern_transform": "quarter_turn"}, demos=3, queries=4)
+    pair = episode["test"][-1]
+    grid = pair["input"]
+    info = a.analyze(grid)
+    assert len(grid) == len(grid[0]) == 30
+    assert len(info["pattern"]) >= 30
+    assert len(info["seeds"]) == 3
+    assert info["frame_bbox"][0] == 0 and info["frame_bbox"][1] == 0
+    assert max(r for r, _ in info["quarter_turn_targets"]) == 29
+    assert max(c for _, c in info["as_drawn_targets"]) == 29
+    assert sum(v != 0 for row in grid for v in row) >= 75
+    assert sum(v == 8 for row in pair["output"] for v in row) >= 90
+
+
+def test_public_projection_hides_settings_program_answers_and_future_queries():
+    a = adapter()
+    episode = a.generate(0, {"pattern_transform": "quarter_turn"}, demos=3, queries=4)
+    visible = a.public_turn(episode, 0)
+    assert set(visible) == {"train", "test"}
+    assert len(visible["test"]) == 1 and set(visible["test"][0]) == {"input"}
+    changed = copy.deepcopy(episode)
+    changed["settings"] = {"secret": 4}
+    changed["program_solution"] = "secret"
+    for pair in changed["test"]:
+        pair["output"] = [[1]]
+    changed["test"][1]["input"] = [[2]]
+    assert a.public_turn(changed, 0) == visible
+    assert a.public_turn(a.generate(0, {"pattern_transform": "quarter_turn"}, 3, 1), 0) == visible
+    for index in (True, -1, 4):
+        with pytest.raises(ValueError):
+            a.public_turn(episode, index)
+
+
+def test_counterfactual_substitutes_unrotated_pattern_and_changes_retained_case():
+    a = adapter()
+    episode = a.generate(17, {"pattern_transform": "quarter_turn"}, demos=3, queries=4)
+    grid = episode["test"][0]["input"]
+    assert a.claim(grid, "quarter_turn") != a.claim(grid, "as_drawn")
+    assert a.counterfactual_program() == a.program({"pattern_transform": "as_drawn"})
+
+
+def test_reusable_audit_covers_all_demo_counts_and_settings():
+    root = find_root(__file__)
+    path = root / "generators/e250cb77a62e/workspace/parametric/audit.py"
+    assert path.is_file(), "reusable stamping audit is missing"
+    spec = importlib.util.spec_from_file_location("_stamp_audit_test", path)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    result = module.run_audit(seeds=range(4))
+    assert result["status"] == "passed"
+    assert result["episodes"] == 40
+    assert result["demo_counts"] == [2, 3, 4, 5, 6]
+    assert result["settings"] == ["as_drawn", "quarter_turn"]
+    assert result["failures"] == []
