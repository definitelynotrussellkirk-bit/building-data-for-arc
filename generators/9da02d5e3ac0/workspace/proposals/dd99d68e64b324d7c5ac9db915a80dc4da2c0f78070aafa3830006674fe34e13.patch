+def _ensure_biaxial_asymmetry(grid, palette, rng):
+    """Make one mirrored row pair and column pair visibly unequal.
+
+    A single-axis mirror followed by repetition is indistinguishable from the
+    canonical four-quadrant rule on an input symmetric about the other axis.
+    Three deterministic edits at a sampled mirrored coordinate refute both
+    shortcuts while retaining the requested size and palette envelope.
+    """
+    h, w = len(grid), len(grid[0])
+    if h < 2 or w < 2:
+        return grid
+    r = rng.randrange(h // 2)
+    c = rng.randrange(w // 2)
+    rr, cc = h - 1 - r, w - 1 - c
+    first = palette[0]
+    second = next((color for color in palette if color != first), (first + 1) % 10)
+    grid[r][c] = first
+    grid[r][cc] = second
+    grid[rr][c] = second
+    return grid
+
