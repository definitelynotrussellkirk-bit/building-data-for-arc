+    assert all(row["competitor_output"] == row["output"] for row in case["demos"])
+    assert case["query"]["competitor_output"] != case["query"]["output"]
+
+    demos = [GENERATOR.generate(seed, index) for index in range(3)]
+    assert any(
+        competitor(grid) != kaleidoscope(grid)
+        for grid in demos
+    ), "the current three visible demonstrations must reject the shortcut"
