@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""Bounded lesson audit for the two single-axis kaleidoscope shortcuts.
+
+The canonical transformation mirrors the input across both axes.  Two tempting
+rules become equivalent on symmetric demonstrations:
+
+* vertically mirror the input, then repeat each row horizontally;
+* horizontally mirror the input, then repeat the top half vertically.
+
+This probe checks consecutive three-demonstration windows plus the following
+query across all difficulty bands.  It is finite structural evidence; the
+focused task test separately checks the independent canonical mirror against the
+saved ARC pairs.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+HOME = HERE.parent
+TASK_ID = "8725a034f163"
+
+
+def _load_generator():
+    path = HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location("_probe_8725a034f163", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def kaleidoscope(grid):
+    top = [row + list(reversed(row)) for row in grid]
+    return top + [row + list(reversed(row)) for row in reversed(grid)]
+
+
+def repeat_columns_after_vertical_mirror(grid):
+    return [row + row for row in grid + list(reversed(grid))]
+
+
+def repeat_rows_after_horizontal_mirror(grid):
+    top = [row + list(reversed(row)) for row in grid]
+    return top + [row[:] for row in top]
+
+
+COMPETITORS = {
+    "repeat_columns_after_vertical_mirror": repeat_columns_after_vertical_mirror,
+    "repeat_rows_after_horizontal_mirror": repeat_rows_after_horizontal_mirror,
+}
+DIFFICULTIES = (None, "easy", "medium", "hard")
+
+
+def _positive(name: str, value: int) -> int:
+    if type(value) is not int or value < 1:
+        raise ValueError(f"{name} must be a positive exact integer")
+    return value
+
+
+def audit(*, seed_count: int = 256, start_count: int = 10) -> dict:
+    seed_count = _positive("seed_count", seed_count)
+    start_count = _positive("start_count", start_count)
+    generator = _load_generator()
+    survivors = []
+    harmful = []
+    lessons = 0
+    checks = 0
+
+    for difficulty in DIFFICULTIES:
+        for seed in range(seed_count):
+            for start in range(start_count):
+                demos = [
+                    generator.generate(seed, start + offset, difficulty=difficulty)
+                    for offset in range(3)
+                ]
+                query = generator.generate(seed, start + 3, difficulty=difficulty)
+                lessons += 1
+                for name, competitor in COMPETITORS.items():
+                    checks += 1
+                    survives = all(
+                        competitor(grid) == kaleidoscope(grid)
+                        for grid in demos
+                    )
+                    changes_query = competitor(query) != kaleidoscope(query)
+                    if survives:
+                        row = {
+                            "difficulty": difficulty,
+                            "seed": seed,
+                            "start": start,
+                            "competitor": name,
+                            "changes_query": changes_query,
+                        }
+                        survivors.append(row)
+                        if changes_query:
+                            harmful.append(row)
+
+    source = HOME / "generator.py"
+    return {
+        "schema": "arcpuzzles-kaleidoscope-shortcut-probe-v1",
+        "status": "passed" if not survivors else "failed",
+        "task_id": TASK_ID,
+        "generator_version": generator.VERSION,
+        "generator_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+        "seed_count": seed_count,
+        "start_count": start_count,
+        "difficulties": list(DIFFICULTIES),
+        "lessons": lessons,
+        "competitors": sorted(COMPETITORS),
+        "competitor_checks": checks,
+        "demo_survivors": len(survivors),
+        "harmful_survivors": len(harmful),
+        "survivors": survivors[:20],
+        "limits": (
+            "Finite consecutive three-demo windows and two declared structural "
+            "shortcuts. Labels use an independent Python mirror; canonical pair "
+            "parity is enforced by the focused task test."
+        ),
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seeds", type=int, default=256)
+    parser.add_argument("--starts", type=int, default=10)
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args(argv)
+    output = Path(args.out)
+    if output.exists() or output.is_symlink():
+        raise FileExistsError(output)
+    report = audit(seed_count=args.seeds, start_count=args.starts)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": report["status"],
+        "lessons": report["lessons"],
+        "competitor_checks": report["competitor_checks"],
+        "demo_survivors": report["demo_survivors"],
+        "harmful_survivors": report["harmful_survivors"],
+        "out": str(output.resolve()),
+    }, sort_keys=True))
+    return 0 if report["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
