+        (578, "repeat_columns_after_vertical_mirror", repeat_columns_after_vertical_mirror),
+        (742, "repeat_rows_after_horizontal_mirror", repeat_rows_after_horizontal_mirror),
+    ],
+)
+def test_preserved_old_counterexample_and_current_lesson_repair(
