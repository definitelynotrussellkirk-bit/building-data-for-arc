+"""Focused teaching regressions for the four-quadrant kaleidoscope generator."""
+from __future__ import annotations
+
+from copy import deepcopy
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root
+
+TASK_ID = "8725a034f163"
+HOME = Path(__file__).resolve().parents[1]
+_SPEC = importlib.util.spec_from_file_location("reviewed_8725a034f163", HOME / "generator.py")
+assert _SPEC is not None and _SPEC.loader is not None
+GENERATOR = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(GENERATOR)
+
+
+def kaleidoscope(grid):
+    """Independent mirror of the canonical 2h x 2w transformation."""
+    top = [row + list(reversed(row)) for row in grid]
+    return top + [row + list(reversed(row)) for row in reversed(grid)]
+
+
+def repeat_columns_after_vertical_mirror(grid):
+    """Wrong rule: mirror vertically, but repeat each row instead of LR-mirroring it."""
+    return [row + row for row in grid + list(reversed(grid))]
+
+
+def repeat_rows_after_horizontal_mirror(grid):
+    """Wrong rule: mirror horizontally, but repeat the top half instead of UD-mirroring it."""
+    top = [row + list(reversed(row)) for row in grid]
+    return top + deepcopy(top)
+
+
+@pytest.mark.parametrize(
+    "pair",
+    canonical_pairs(TASK_ID, root=find_root(__file__)),
+    ids=lambda pair: f"{pair['split']}{pair['pair_index']}",
+)
