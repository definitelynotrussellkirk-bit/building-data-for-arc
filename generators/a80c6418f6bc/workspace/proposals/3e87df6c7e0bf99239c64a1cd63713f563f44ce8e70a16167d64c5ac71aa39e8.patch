+#!/usr/bin/env python3
+"""Find and replay a fixed-transform lesson shortcut for b9f4d27421cb.
+
+The tool searches ordinary production draws for three visible demonstrations
+whose top pair all encode the same transform, followed by a query with a
+different transform.  It then executes both the selected canonical Racket rule
+and an executable fixed-transform rival in the protected reference runtime.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+
+TASK_ID = "b9f4d27421cb"
+HERE = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+GENERATOR, SOURCE_PATH, SOURCE_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+DEMO_COUNT = 3
+FIXED_CODE = 1
+_TRANSFORM_FRAGMENT = (
+    "(tmp (cond ((equal? topL topR) botL) "
+    "((equal? (rotate-cw topL) topR) (rotate-cw botL)) "
+    "((equal? (rotate-180 topL) topR) (rotate-180 botL)) "
+    "((equal? (rotate-ccw topL) topR) (rotate-ccw botL)) "
+    "((equal? (flip-lr topL) topR) (flip-lr botL)) "
+    "((equal? (flip-ud topL) topR) (flip-ud botL)) (else botL)))"
+)
+_FIXED_FRAGMENT = "(tmp (rotate-cw botL))"
+
+
+def _sha_text(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def canonical_program() -> str:
+    for line in canonical_path(ROOT).open(encoding="utf-8"):
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            program = row.get("program_solution")
+            if not isinstance(program, str) or not program.strip():
+                raise ValueError("canonical program_solution is missing")
+            return program
+    raise KeyError(TASK_ID)
+
+
+def fixed_clockwise_program() -> str:
+    program = canonical_program()
+    if program.count(_TRANSFORM_FRAGMENT) != 1:
+        raise ValueError("canonical transform branch is not uniquely replaceable")
+    rival = program.replace(_TRANSFORM_FRAGMENT, _FIXED_FRAGMENT)
+    if rival == program:
+        raise AssertionError("fixed-transform rival did not change the program")
+    return rival
+
+
+def transform_code(grid) -> int:
+    height, width = len(grid), len(grid[0])
+    separator_rows = [r for r in range(height) if all(v == 9 for v in grid[r])]
+    separator_cols = [c for c in range(width) if all(grid[r][c] == 9 for r in range(height))]
+    if len(separator_rows) != 2 or len(separator_cols) != 1:
+        raise ValueError("grid does not expose the documented six-panel separators")
+    n, csep = separator_rows[0], separator_cols[0]
+    left = {(r, c) for r in range(n) for c in range(n) if grid[r][c] != 0}
+    right = {
+        (r, c)
+        for r in range(n)
+        for c in range(n)
+        if grid[r][csep + 1 + c] != 0
+    }
+    matches = [
+        code
+        for code in range(1, 6)
+        if set(GENERATOR._xform(left, n, code)) == right
+    ]
+    if len(matches) != 1:
+        raise ValueError(f"top transform is not unique: {matches}")
+    return matches[0]
+
+
+def find_witness(*, max_seed: int = 10000, difficulty: str = "medium") -> dict:
+    if type(max_seed) is not int or max_seed <= 0:
+        raise ValueError("max_seed must be a positive literal integer")
+    for seed in range(max_seed):
+        grids = [
+            GENERATOR.generate(seed, index, difficulty=difficulty)
+            for index in range(DEMO_COUNT + 1)
+        ]
+        codes = [transform_code(grid) for grid in grids]
+        if len(set(codes[:DEMO_COUNT])) == 1 and codes[0] == FIXED_CODE and codes[-1] != FIXED_CODE:
+            return {
+                "seed": seed,
+                "difficulty": difficulty,
+                "transform_codes": codes,
+                "grids": grids,
+            }
+    raise LookupError(f"no fixed-clockwise witness below seed {max_seed}")
+
+
+def _changed_cells(left, right) -> int:
+    return sum(a != b for lrow, rrow in zip(left, right, strict=True)
+               for a, b in zip(lrow, rrow, strict=True))
+
+
+def _execute(programs: tuple[str, str], grids: list[list[list[int]]]):
+    from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+    runtime = ROOT / "shared/runtime"
+    with _local_imports(runtime, HERE):
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            rows = []
+            for grid in grids:
+                rows.append(tuple(_grid(apply(program, grid)) for program in programs))
+            return rows, identity
+        finally:
+            bridge.close()
+
+
+def build_report(*, max_seed: int = 10000, difficulty: str = "medium") -> dict:
+    witness = find_witness(max_seed=max_seed, difficulty=difficulty)
+    canonical = canonical_program()
+    rival = fixed_clockwise_program()
+    evaluated, racket = _execute((canonical, rival), witness["grids"])
+    canonical_outputs = [pair[0] for pair in evaluated]
+    rival_outputs = [pair[1] for pair in evaluated]
+    matches = [left == right for left, right in zip(canonical_outputs, rival_outputs, strict=True)]
+    if matches != [True, True, True, False]:
+        raise AssertionError(f"unexpected fixed-transform fit vector: {matches}")
+    query_changed = _changed_cells(canonical_outputs[-1], rival_outputs[-1])
+    if query_changed <= 0:
+        raise AssertionError("rival does not change the query")
+    return {
+        "schema": "arcpuzzles-b9f4d27421cb-fixed-transform-probe-v1",
+        "status": "shortcut_witness",
+        "task_id": TASK_ID,
+        "generator_path": SOURCE_PATH.relative_to(ROOT).as_posix(),
+        "generator_sha256": SOURCE_SHA256,
+        "canonical_program_sha256": _sha_text(canonical),
+        "rival_program_sha256": _sha_text(rival),
+        "rival": "ignore the top-pair relation and always rotate the bottom-left query clockwise, while still learning the visible recolor map",
+        "seed": witness["seed"],
+        "difficulty": witness["difficulty"],
+        "transform_codes": witness["transform_codes"],
+        "demo_rival_matches": matches[:DEMO_COUNT],
+        "query_rival_matches": matches[-1],
+        "query_changed_cells": query_changed,
+        "racket": racket,
+        "racket_evaluations": 2 * len(witness["grids"]),
+        "lesson": {
+            "train": [
+                {"input": grid, "output": output}
+                for grid, output in zip(witness["grids"][:DEMO_COUNT], canonical_outputs[:DEMO_COUNT], strict=True)
+            ],
+            "test": [{
+                "input": witness["grids"][-1],
+                "output": canonical_outputs[-1],
+                "rival_output": rival_outputs[-1],
+            }],
+        },
+        "repair": "During lesson assembly, require visible transform variation or reject a lesson while any fixed-transform rival fits every demonstration.",
+        "limits": "One deterministic ordinary lesson and one executable rival; this is not universal ambiguity evidence or an owner acceptance decision.",
+        "production_changed": False,
+        "training_admitted": False,
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--max-seed", type=int, default=10000)
+    parser.add_argument("--difficulty", default="medium", choices=("easy", "medium", "hard"))
+    args = parser.parse_args(argv)
+    if args.out.exists() or args.out.is_symlink():
+        parser.error(f"choose a new output path: {args.out}")
+    report = build_report(max_seed=args.max_seed, difficulty=args.difficulty)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"],
+        "seed": report["seed"],
+        "transform_codes": report["transform_codes"],
+        "query_changed_cells": report["query_changed_cells"],
+        "racket_evaluations": report["racket_evaluations"],
+        "out": str(args.out.resolve()),
+    }, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
