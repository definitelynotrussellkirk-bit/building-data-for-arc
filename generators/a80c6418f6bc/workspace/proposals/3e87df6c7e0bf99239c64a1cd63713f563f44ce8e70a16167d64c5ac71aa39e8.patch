+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+PROBE = Path(__file__).resolve().parents[1] / "workspace" / "lesson_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("b9f4d27421cb_lesson_probe", PROBE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_search_retains_fixed_clockwise_lesson_witness():
+    probe = load_probe()
+    witness = probe.find_witness(max_seed=21)
+    assert witness["seed"] == 20
+    assert witness["transform_codes"] == [1, 1, 1, 5]
+
+
+def test_protected_racket_proves_fixed_transform_fits_demos_and_fails_query():
+    probe = load_probe()
+    report = probe.build_report(max_seed=21)
+    assert report["status"] == "shortcut_witness"
+    assert report["demo_rival_matches"] == [True, True, True]
+    assert report["query_rival_matches"] is False
+    assert report["query_changed_cells"] > 0
+    assert report["racket"]["protected"] is True
