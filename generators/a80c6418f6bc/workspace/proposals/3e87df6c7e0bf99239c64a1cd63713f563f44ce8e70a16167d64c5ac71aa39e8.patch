@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""Find and replay a top-to-bottom ordering shortcut for b6ba2d176fe8.
+
+The tool searches ordinary production draws for three demonstrations where
+sorting rectangles by top row accidentally agrees with the canonical
+left-to-right order, followed by a query where those orders differ.  Both rules
+are then executed in the protected reference Racket runtime.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+
+TASK_ID = "b6ba2d176fe8"
+HERE = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+GENERATOR, SOURCE_PATH, SOURCE_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+DEMO_COUNT = 3
+_LEFT_SORT = "(sorted (sort-by objs (lambda (o) (second (obj-bbox o)))))"
+_TOP_SORT = "(sorted (sort-by objs (lambda (o) (first (obj-bbox o)))))"
+
+
+def _sha_text(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def canonical_program() -> str:
+    for line in canonical_path(ROOT).open(encoding="utf-8"):
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            program = row.get("program_solution")
+            if not isinstance(program, str) or not program.strip():
+                raise ValueError("canonical program_solution is missing")
+            return program
+    raise KeyError(TASK_ID)
+
+
+def top_to_bottom_program() -> str:
+    program = canonical_program()
+    if program.count(_LEFT_SORT) != 1:
+        raise ValueError("canonical left-order sort is not uniquely replaceable")
+    rival = program.replace(_LEFT_SORT, _TOP_SORT)
+    if rival == program:
+        raise AssertionError("top-order rival did not change the program")
+    return rival
+
+
+def order_signature(grid) -> dict:
+    rectangles = [
+        component
+        for component in GENERATOR._components(grid)
+        if GENERATOR._is_solid_rectangle(grid, component)
+    ]
+    if len(rectangles) < 2:
+        raise ValueError("expected at least two solid rectangles")
+    left = sorted(rectangles, key=lambda item: item["bbox"][1])
+    top = sorted(rectangles, key=lambda item: item["bbox"][0])
+    return {
+        "left_to_right": [item["color"] for item in left],
+        "top_to_bottom": [item["color"] for item in top],
+        "rectangles": [
+            {"color": item["color"], "bbox": list(item["bbox"])}
+            for item in rectangles
+        ],
+    }
+
+
+def find_witness(*, max_seed: int = 10000, difficulty: str = "medium") -> dict:
+    if type(max_seed) is not int or max_seed <= 0:
+        raise ValueError("max_seed must be a positive literal integer")
+    for seed in range(max_seed):
+        grids = [
+            GENERATOR.generate(seed, index, difficulty=difficulty)
+            for index in range(DEMO_COUNT + 1)
+        ]
+        signatures = [order_signature(grid) for grid in grids]
+        agrees = [row["left_to_right"] == row["top_to_bottom"] for row in signatures]
+        if agrees == [True, True, True, False]:
+            return {
+                "seed": seed,
+                "difficulty": difficulty,
+                "order_agrees": agrees,
+                "signatures": signatures,
+                "grids": grids,
+            }
+    raise LookupError(f"no top-order witness below seed {max_seed}")
+
+
+def _changed_cells(left, right) -> int:
+    return sum(a != b for lrow, rrow in zip(left, right, strict=True)
+               for a, b in zip(lrow, rrow, strict=True))
+
+
+def _execute(programs: tuple[str, str], grids: list[list[list[int]]]):
+    from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+    runtime = ROOT / "shared/runtime"
+    with _local_imports(runtime, HERE):
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            rows = []
+            for grid in grids:
+                rows.append(tuple(_grid(apply(program, grid)) for program in programs))
+            return rows, identity
+        finally:
+            bridge.close()
+
+
+def build_report(*, max_seed: int = 10000, difficulty: str = "medium") -> dict:
+    witness = find_witness(max_seed=max_seed, difficulty=difficulty)
+    canonical = canonical_program()
+    rival = top_to_bottom_program()
+    evaluated, racket = _execute((canonical, rival), witness["grids"])
+    canonical_outputs = [pair[0] for pair in evaluated]
+    rival_outputs = [pair[1] for pair in evaluated]
+    matches = [left == right for left, right in zip(canonical_outputs, rival_outputs, strict=True)]
+    if matches != [True, True, True, False]:
+        raise AssertionError(f"unexpected top-order fit vector: {matches}")
+    query_changed = _changed_cells(canonical_outputs[-1], rival_outputs[-1])
+    if query_changed <= 0:
+        raise AssertionError("rival does not change the query")
+    return {
+        "schema": "arcpuzzles-b6ba2d176fe8-top-order-probe-v1",
+        "status": "shortcut_witness",
+        "task_id": TASK_ID,
+        "generator_path": SOURCE_PATH.relative_to(ROOT).as_posix(),
+        "generator_sha256": SOURCE_SHA256,
+        "canonical_program_sha256": _sha_text(canonical),
+        "rival_program_sha256": _sha_text(rival),
+        "rival": "sort solid rectangles by their top row instead of their left column, then build the same later-corner-owned staircase",
+        "seed": witness["seed"],
+        "difficulty": witness["difficulty"],
+        "order_agrees": witness["order_agrees"],
+        "order_signatures": witness["signatures"],
+        "demo_rival_matches": matches[:DEMO_COUNT],
+        "query_rival_matches": matches[-1],
+        "query_changed_cells": query_changed,
+        "racket": racket,
+        "racket_evaluations": 2 * len(witness["grids"]),
+        "lesson": {
+            "train": [
+                {"input": grid, "output": output}
+                for grid, output in zip(witness["grids"][:DEMO_COUNT], canonical_outputs[:DEMO_COUNT], strict=True)
+            ],
+            "test": [{
+                "input": witness["grids"][-1],
+                "output": canonical_outputs[-1],
+                "rival_output": rival_outputs[-1],
+            }],
+        },
+        "repair": "During lesson assembly, include a visible demonstration where top-to-bottom and left-to-right object order differ, or reject while this executable rival survives.",
+        "limits": "One deterministic ordinary lesson and one executable rival; this does not alter the accepted sort-order family or establish universal ambiguity.",
+        "production_changed": False,
+        "training_admitted": False,
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--max-seed", type=int, default=10000)
+    parser.add_argument("--difficulty", default="medium", choices=("easy", "medium", "hard"))
+    args = parser.parse_args(argv)
+    if args.out.exists() or args.out.is_symlink():
+        parser.error(f"choose a new output path: {args.out}")
+    report = build_report(max_seed=args.max_seed, difficulty=args.difficulty)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"],
+        "seed": report["seed"],
+        "order_agrees": report["order_agrees"],
+        "query_changed_cells": report["query_changed_cells"],
+        "racket_evaluations": report["racket_evaluations"],
+        "out": str(args.out.resolve()),
