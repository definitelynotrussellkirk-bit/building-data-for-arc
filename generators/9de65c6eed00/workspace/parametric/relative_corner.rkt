(rule!
  (let ((dummy 0))
    (define (e8b-list< a b)
      (cond
        ((empty? a) #f)
        ((< (first a) (first b)) #t)
        ((> (first a) (first b)) #f)
        (else (e8b-list< (rest a) (rest b)))))
    (define (f4-norm-info cells)
      (let* ((bb (bbox-of-cells cells))
             (r0 (first bb))
             (c0 (second bb))
             (r1 (third bb))
             (c1 (fourth bb))
             (normalized
               (map (lambda (p)
                      (list (- (first p) r0) (- (second p) c0)))
                    cells)))
        (list normalized (+ 1 (- r1 r0)) (+ 1 (- c1 c0)))))
    (define (f4-anchor info h w bottom? right?)
      (let* ((cells (first info))
             (ih (second info))
             (iw (third info))
             (dr (if bottom? (- h ih) 0))
             (dc (if right? (- w iw) 0)))
        (map (lambda (p)
               (list (+ dr (first p)) (+ dc (second p))))
             cells)))
    (let* ((sorted
             (sort
               (objects g 0)
               (lambda (a b)
                 (let ((ba (obj-bbox a)) (bb (obj-bbox b)))
                   (e8b-list<
                     (list (- (obj-size a)) (first ba) (second ba))
                     (list (- (obj-size b)) (first bb) (second bb)))))))
           (a (first sorted))
           (b (second sorted))
           (ba (obj-bbox a))
           (bb (obj-bbox b))
           (bottom? (> (+ (first bb) (third bb))
                       (+ (first ba) (third ba))))
           (right? (> (+ (second bb) (fourth bb))
                      (+ (second ba) (fourth ba))))
           (ia (f4-norm-info (obj-cells a)))
           (ib (f4-norm-info (obj-cells b)))
           (h (max (second ia) (second ib)))
           (w (max (third ia) (third ib)))
           (aa (f4-anchor ia h w bottom? right?))
           (ab (f4-anchor ib h w bottom? right?))
           (diff (filter (lambda (p) (not (member? p ab))) aa)))
      (paint-cells (empty-grid h w 0) diff (obj-color a)))))
