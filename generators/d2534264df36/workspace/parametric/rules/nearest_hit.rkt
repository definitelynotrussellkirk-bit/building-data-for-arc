(rule! (lambda (g)
  (let* ((base ((lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (begin
             (define cells
               (filter (lambda (rc) (> (at g (nth rc 0) (nth rc 1)) 0))
                       (apply append
                              (map (lambda (r)
                                     (map (lambda (c) (list r c)) (range 0 w)))
                                   (range 0 h)))))
             (reduce (lambda (gg rc)
                       (let* ((r (nth rc 0))
                              (c (nth rc 1))
                              (color (at g r c))
                              (k (min r c (- (- h 1) r) (- (- w 1) c)))
                              (k2 (- (- h 1) k))
                              (is-corner (and
                                           (or (= r k) (= r k2))
                                           (or (= c k) (= c k2)))))
                         (if is-corner
                             (reduce (lambda (gx cc)
                                       (set-cell gx (nth cc 0) (nth cc 1) color))
                                     gg
                                     (list (list k k)
                                           (list k k2)
                                           (list k2 k)
                                           (list k2 k2)))
                             (let ((side-cells (apply append
                                                      (list (map (lambda (cc)
                                                                   (list k cc))
                                                                 (range (+ k 2)
                                                                        (- k2 1)
                                                                        2))
                                                            (map (lambda (cc)
                                                                   (list k2 cc))
                                                                 (range (+ k 2)
                                                                        (- k2 1)
                                                                        2))
                                                            (map (lambda (rr)
                                                                   (list rr k))
                                                                 (range (+ k 2)
                                                                        (- k2 1)
                                                                        2))
                                                            (map (lambda (rr)
                                                                   (list rr k2))
                                                                 (range (+ k 2)
                                                                        (- k2 1)
                                                                        2))))))
                               (reduce (lambda (gx cc)
                                         (set-cell gx (nth cc 0) (nth cc 1) color))
                                       gg
                                       side-cells)))))
                     g
                     cells)))) g))
         (h (rows base))
         (w (cols base))
         (hub (quotient h 2))
         (hits (filter (lambda (r) (> (at base r hub) 0))
                       (range 0 hub))))
    (if (empty? hits)
        base
        (let* ((hit (nth hits (- (length hits) 1)))
               (color (at base hit hub))
               (far (- (- h 1) hit))
               (cross-cells
                 (apply append
                        (list
                          (map (lambda (r) (list r hub))
                               (range (+ hit 1) far))
                          (map (lambda (c) (list hub c))
                               (range (+ hit 1) far))))))
          (reduce (lambda (out rc)
                    (let ((r (nth rc 0))
                          (c (nth rc 1)))
                      (if (= (at out r c) 0)
                          (set-cell out r c color)
                          out)))
                  base
                  cross-cells))))))