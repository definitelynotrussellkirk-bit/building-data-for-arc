(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (begin
             (define bg 7)
             (define colors
               (filter (lambda (c) (and (!= c bg) (!= c 8))) (grid-colors g)))
             (define empty-g (cellmap g (r c v) bg))
             (define (process-color c)
               (let* ((cells (find-color g c))
                      (rs (map first cells))
                      (cs (map second cells))
                      (br1 (min-list rs))
                      (br2 (max-list rs))
                      (bc1 (min-list cs))
                      (bc2 (max-list cs))
                      (corners (list (list br1 bc1)
                                     (list br1 bc2)
                                     (list br2 bc1)
                                     (list br2 bc2)))
                      (missing-corner (find (lambda (corner)
                                              (not (any? (lambda (p)
                                                           (and
                                                             (= (first p)
                                                                (first corner))
                                                             (= (second p)
                                                                (second corner))))
                                                         cells)))
                                            corners))
                      (mr (first missing-corner))
                      (mc (second missing-corner))
                      (dr (if (= mr br1) -2 2))
                      (dc (if (= mc bc1) -2 2)))
                 (list c br1 bc1 br2 bc2 dr dc)))
             (define processed (map process-color colors))
             (reduce (lambda (gg p)
                       (let* ((c (nth p 0))
                              (r1 (+ (nth p 1) (nth p 5)))
                              (c1 (+ (nth p 2) (nth p 6)))
                              (r2 (+ (nth p 3) (nth p 5)))
                              (c2 (+ (nth p 4) (nth p 6)))
                              (cells (apply append
                                            (map (lambda (r)
                                                   (map (lambda (cc) (list r cc))
                                                        (range c1 (+ c2 1))))
                                                 (range r1 (+ r2 1))))))
                         (reduce (lambda (gx pp)
                                   (if (and
                                         (>= (first pp) 0)
                                         (< (first pp) h)
                                         (>= (second pp) 0)
                                         (< (second pp) w))
                                       (set-cell gx (first pp) (second pp) c)
                                       gx))
                                 gg
                                 cells)))
                     empty-g
                     processed)))))