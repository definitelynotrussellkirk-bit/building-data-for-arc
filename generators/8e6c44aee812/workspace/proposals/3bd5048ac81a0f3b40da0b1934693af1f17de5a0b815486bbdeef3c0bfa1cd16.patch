diff --git a/repo/generators/8e6c44aee812/workspace/parametric/export.py b/repo/generators/8e6c44aee812/workspace/parametric/export.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/8e6c44aee812/workspace/parametric/export.py
@@ -0,0 +1,103 @@
+"""Task-local public/private export for verified parametric episodes.
+
+Reference execution belongs to the caller. This module only validates visible
+grid syntax and transports already-verified labels; it never runs Racket.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+from typing import Any, Iterable
+
+
+REPO = Path(__file__).resolve().parents[4]
+RUNTIME = REPO / "shared/runtime"
+if str(RUNTIME) not in sys.path:
+    sys.path.insert(0, str(RUNTIME))
+
+from reviewer_support import public_challenge_bytes, public_challenge_id
+
+
+def public_turn(episode: dict[str, Any], query_index: int = 0) -> dict[str, Any]:
+    """Return the current demonstrations and exactly one masked query.
+
+    No future query is inspected, and neither query labels nor private metadata
+    can affect this projection. The result shares no mutable grids with the
+    stored episode. Sequencing and answer history remain the caller's concern.
+    """
+    if type(query_index) is not int or query_index < 0:
+        raise ValueError("query_index must be a nonnegative exact integer")
+    if not isinstance(episode, dict) or type(episode.get("test")) is not list:
+        raise ValueError("episode must contain train/test lists")
+    queries = episode["test"]
+    if query_index >= len(queries):
+        raise ValueError("query_index is outside the episode query list")
+    projection = {"train": episode.get("train"), "test": [queries[query_index]]}
+    return json.loads(public_challenge_bytes(projection))
+
+
+def write_batch(episodes: Iterable[dict[str, Any]], out_dir: str | Path) -> dict[str, Any]:
+    """Write a deterministic batch to a fresh directory after complete preflight.
+
+    ``public/<id>.json`` stores all query inputs for controller use. Each
+    ``turns/<id>.json`` contains only the demonstrations and one current query;
+    give actors that single payload rather than a directory or batch index.
+    ``private/metadata.jsonl`` preserves each full episode and its ordered turn
+    IDs. Public filenames are SHA-256 identifiers of the shared canonical
+    visible bytes, and all files/metadata rows are ordered by those identifiers.
+
+    Duplicate controller payloads or single-query payloads, invalid visible
+    grids, and non-JSON private metadata fail before any destination is created.
+    Existing destinations are never overwritten. The writer supports a
+    nonempty query list; admission callers materialize four distinct queries.
+    """
+    public_payloads: dict[str, bytes] = {}
+    turn_payloads: dict[str, bytes] = {}
+    metadata_lines: dict[str, str] = {}
+    for episode in episodes:
+        payload = public_challenge_bytes(episode)
+        identifier = public_challenge_id(episode)
+        if identifier in public_payloads:
+            raise ValueError("duplicate public challenge payload")
+        public_payloads[identifier] = payload
+        ordered_turn_ids = []
+        for query_index in range(len(episode["test"])):
+            visible = public_turn(episode, query_index)
+            turn_payload = public_challenge_bytes(visible)
+            turn_id = public_challenge_id(visible)
+            if turn_id in turn_payloads:
+                raise ValueError("duplicate single-query public challenge payload")
+            turn_payloads[turn_id] = turn_payload
+            ordered_turn_ids.append(turn_id)
+        metadata_lines[identifier] = json.dumps(
+            {"public_id": identifier, "turn_ids": ordered_turn_ids, "episode": episode},
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        ) + "\n"
+    if not public_payloads:
+        raise ValueError("episodes must contain at least one episode")
+
+    destination = Path(out_dir)
+    destination.mkdir(parents=True, exist_ok=False)
+    public_ids = sorted(public_payloads)
+    turn_ids = sorted(turn_payloads)
+    for name, payloads in (("public", public_payloads), ("turns", turn_payloads)):
+        directory = destination / name
+        directory.mkdir()
+        for identifier in sorted(payloads):
+            (directory / f"{identifier}.json").write_bytes(payloads[identifier])
+    private = destination / "private"
+    private.mkdir()
+    metadata_path = private / "metadata.jsonl"
+    metadata_path.write_text(
+        "".join(metadata_lines[identifier] for identifier in public_ids),
+        encoding="utf-8",
+    )
+    return {
+        "public_ids": public_ids,
+        "turn_ids": turn_ids,
+        "metadata_path": str(metadata_path),
+    }
diff --git a/repo/generators/8e6c44aee812/workspace/parametric/make_examples.py b/repo/generators/8e6c44aee812/workspace/parametric/make_examples.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/8e6c44aee812/workspace/parametric/make_examples.py
@@ -0,0 +1,138 @@
+"""Execute all declared native settings and export private labels with isolated turns.
+
+These task-local examples remain owner-pending. Protected reference execution
+checks labels and finite setting identification; it does not grant acceptance
+or training admission.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import hashlib
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[3]
+TASK_ID = HERE.parents[1].name
+PROMOTION_PATH = HERE / "promotion.json"
+
+for source in (REPO / "src", REPO / "shared/runtime"):
+    if str(source) not in sys.path:
+        sys.path.insert(0, str(source))
+
+from arcpuzzles.parametric_promotion import settings_space
+from arcpuzzles.parametric_worker import evaluate_contract
+
+
+def _exporter():
+    """Load this task's transport code without a generic module-name cache."""
+    path = HERE / "export.py"
+    spec = importlib.util.spec_from_file_location(f"_{TASK_ID}_native_export", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load exporter from {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+
+def _source_binding() -> dict[str, str]:
+    """Hash task generation/export code and native Python execution helpers.
+
+    This is a concrete snapshot for these examples, not an acceptance inventory.
+    Racket's binary, parser policy, prelude and bridge have their own live identity.
+    """
+    sources = {HERE.parents[1] / "generator.py"}
+    for path in HERE.rglob("*"):
+        if (path.is_file() and path.suffix in {".py", ".rkt", ".json"}
+                and not any(part in {"evidence", "examples", "__pycache__"}
+                            for part in path.relative_to(HERE).parts)):
+            sources.add(path)
+    sources.update(REPO / "src/arcpuzzles" / name for name in (
+        "parametric_worker.py", "parametric_promotion.py", "catalog.py", "runtime.py"
+    ))
+    sources.add(REPO / "shared/runtime/reviewer_support.py")
+    return {path.relative_to(REPO).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
+            for path in sorted(sources)}
+
+
+def build_examples(
+    out_dir: str | Path, *, seed: int = 0, demos: int = 3, queries: int = 4
+) -> dict[str, Any]:
+    """Replay every declared setting through protected Racket, then export.
+
+    Identical seeds/counts are passed to every setting. The native worker
+    independently executes each declared program on demonstrations and checks
+    all selected query labels before any public or private file is written.
+    """
+    destination = Path(out_dir)
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError(destination)
+    if type(seed) is not int or not 0 <= seed < 2**63:
+        raise ValueError("seed must be an exact integer in 0..2**63-1")
+    contract = json.loads(PROMOTION_PATH.read_text(encoding="utf-8"))
+    for name, value in (("demos", demos), ("queries", queries)):
+        lower, upper = contract["limits"][name]
+        if type(value) is not int or not lower <= value <= upper:
+            raise ValueError(f"{name} must be an exact integer in {lower}..{upper}")
+    jobs = [
+        {"seed": seed, "settings": setting, "demos": demos, "queries": queries}
+        for setting in settings_space(contract)
+    ]
+    source_binding = _source_binding()
+    execution = evaluate_contract(REPO, TASK_ID, contract, jobs)
+    identity = execution.get("racket", {})
+    if identity.get("backend") != "racket" or identity.get("protected") is not True:
+        raise ValueError("example export requires live protected Racket execution")
+    if _source_binding() != source_binding:
+        raise ValueError("example generation source changed during protected execution")
+
+    episodes = []
+    for episode, certificate in zip(execution["episodes"], execution["checks"], strict=True):
+        episodes.append(
+            {
+                **episode,
+                "reference": "protected_racket_pending_acceptance",
+                "private": {
+                    "racket": identity,
+                    "demo_only_certificate": certificate,
+                    "native_acceptance": "owner_pending",
+                    "training_admitted": False,
+                    "source_sha256": source_binding,
+                    "certificate_scope": "Declared settings only; extra rivals are audited separately.",
+                },
+            }
+        )
+    report = _exporter().write_batch(episodes, destination)
+    return {
+        **report,
+        "task_id": TASK_ID,
+        "settings": [job["settings"] for job in jobs],
+        "demos": demos,
+        "queries": queries,
+        "racket": identity,
+        "racket_evaluations": execution["racket_evaluations"],
+        "source_sha256": source_binding,
+        "native_acceptance": "owner_pending",
+        "training_admitted": False,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--demos", type=int, default=3)
+    parser.add_argument("--queries", type=int, default=4)
+    args = parser.parse_args()
+    report = build_examples(args.out, seed=args.seed, demos=args.demos, queries=args.queries)
+    print(json.dumps(report, sort_keys=True))
+    return 0
+
+
