+#!/usr/bin/env python3
+"""Fixed seed-0 lessons, three bands, finite edge rivals; no seed search.
+
+Reference labels come from the selected canonical Racket program. Rivals reuse
+the task's component parser/directions and vary only out-of-bounds behavior.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+from reviewer_support import load_selected_generator
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+
+TASK = "e99db71ae23d"
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def edge_rival(gen, grid, *, policy, only_color=None):
+    """Suppress an entire clipped copy, or wrap targets, globally/per color."""
+    height, width = len(grid), len(grid[0])
+    output = [row[:] for row in grid]
+    for color, fill in ((5, 4), (2, 3)):
+        for component in gen._components(grid):
+            if component["color"] != color:
+                continue
+            dr, dc = gen._shift(color, component["shape_index"])
+            targets = [(r + dr, c + dc) for r, c in component["cells"]]
+            inside = lambda r, c: 0 <= r < height and 0 <= c < width
+            active = only_color is None or color == only_color
+            if active and policy == "suppress" and not all(inside(r, c) for r, c in targets):
+                continue
+            for r, c in targets:
+                if active and policy == "wrap":
+                    output[r % height][c % width] = fill
+                elif inside(r, c):
+                    output[r][c] = fill
+    return output
+
+
+def main():
+    gen, source, source_hash = load_selected_generator(TASK, root=ROOT)
+    programs = {row["program_solution"] for row in Catalog(ROOT)._variants()[TASK]}
+    assert len(programs) == 1
+    program = programs.pop()
+    rivals = {f"{policy}_{color or 'both'}": {"policy": policy, "only_color": color}
+              for policy in ("suppress", "wrap") for color in (None, 2, 5)}
+    apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+    report = {
+        "task_id": TASK, "schema": "bounded-edge-rival-audit-v1",
+        "generator_sha256": source_hash,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "existing_probe_sha256": hashlib.sha256((Path(__file__).parent / "lesson_distribution_probe.py").read_bytes()).hexdigest(),
+        "canonical_program": program, "runtime_identity": identity,
+        "cwd": str(Path.cwd()), "invocation": sys.argv,
+        "bounds": {"seeds": [0], "bands": ["easy", "medium", "hard"],
+                   "sample_indices": [0, 1, 2, 3], "rivals": rivals,
+                   "racket_label_limit": 12, "held_out_positions": [0, 1, 2, 3]},
+        "lessons": [], "ambiguities": [], "labels_checked": 0,
+        "mirror_disagreements": 0,
+        "limitations": ["Finite six-rival check, not universal identifiability.",
+                        "Only held-out index 3 is the ordered production query.",
+                        "No generator change or rule change; no random reroll or census.",
+                        "Rivals are executable Python; canonical labels use protected Racket."]}
+    try:
+        for band in report["bounds"]["bands"]:
+            pairs = []
+            for index in range(4):
+                grid = gen.generate(0, index, difficulty=band)
+                assert gen.self_check(grid) == []
+                label = apply(program, grid)
+                report["labels_checked"] += 1
+                report["mirror_disagreements"] += label != gen.rule_mirror(grid)
+                pairs.append({"input": grid, "output": label,
+                              "facts": gen.semantic_observables(grid)})
+            predictions = {name: [edge_rival(gen, pair["input"], **config) for pair in pairs]
+                           for name, config in rivals.items()}
+            report["lessons"].append({"band": band, "seed": 0, "pairs": pairs,
+                                       "rival_predictions": predictions})
+            for query_index in range(4):
+                for name, outputs in predictions.items():
+                    fits = all(outputs[index] == pair["output"] for index, pair in enumerate(pairs)
+                               if index != query_index)
+                    if fits and outputs[query_index] != pairs[query_index]["output"]:
+                        report["ambiguities"].append({"band": band, "seed": 0,
+                            "query_index": query_index, "rival": name,
+                            "production": query_index == 3,
+                            "differing_cells": [[r, c] for r, row in enumerate(outputs[query_index])
+                                for c, value in enumerate(row) if value != pairs[query_index]["output"][r][c]]})
+    finally:
+        bridge.close()
+    report["production_ambiguities"] = sum(row["production"] for row in report["ambiguities"])
+    report["rival_holdout_checks"] = 3 * 4 * len(rivals)
+    report["status"] = "ambiguity_found" if report["ambiguities"] else "no_ambiguity_in_bound"
+    output = ROOT.parent / "checks" / TASK / "bounded-edge-rivals.json"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({key: report[key] for key in ("status", "labels_checked", "mirror_disagreements", "production_ambiguities", "rival_holdout_checks", "ambiguities")}, indent=2))
+    return int(bool(report["mirror_disagreements"]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
