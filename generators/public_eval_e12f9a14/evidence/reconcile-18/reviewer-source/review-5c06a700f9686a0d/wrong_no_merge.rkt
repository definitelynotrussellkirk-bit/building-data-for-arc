(rule!
 (let ()
  ;; Uniform local ray hypothesis; parent train[2] still has a six-cell discrepancy.
  (define mark-mode #t)
  (define disable-merging #t)
  (define unitize #f)
  (define emission 0)
  (define mark-style 0)
  (define bg (mode g -1))
  (define (sgn n) (cond ((< n 0) -1) ((> n 0) 1) (else 0)))
  (define (frame r c)
    (filter (lambda (p) (and (in-bounds? (first p) (second p) h w)
       (not (and (<= r (first p) (+ r 1)) (<= c (second p) (+ c 1))))))
       (positions-in-rect (- r 1) (- c 1) (+ r 2) (+ c 2))))
  (define (core? r c)
    (define co (at g r c))
    (and (not (= co bg))
       (for*/and ((a (range 2)) (b (range 2))) (= (at g (+ r a) (+ c b)) co))
       (for/and ((p (frame r c))) (not (= (at g (first p) (second p)) co)))
       (>= (count-if (lambda (p) (not (= (at g (first p) (second p)) bg))) (frame r c)) 4)))
  (define cores (for*/list ((r (range (- h 1))) (c (range (- w 1))) #:when (core? r c)) (list r c (at g r c))))
  (define initial
    (apply append (for/list ((core cores))
      (define r (first core)) (define c (second core))
      (for/list ((p (frame r c)) #:when (= (at g (first p) (second p)) bg))
        (define dr (cond ((< (first p) r) -1) ((> (first p) (+ r 1)) 1) (else 0)))
        (define dc (cond ((< (second p) c) -1) ((> (second p) (+ c 1)) 1) (else 0)))
        (list (list (list (first p) (second p) (third core))) dr dc)))))
  (define groups (filter (lambda (a)
     (or (= emission 0) (and (= emission 1) (or (= (second a) 0) (= (third a) 0)))
         (and (= emission 2) (not (= (second a) 0)) (not (= (third a) 0))))) initial))
  (define (magnitude a) (max (abs (second a)) (abs (third a))))
  (define (point p a n)
    (list (+ (first p) (quotient (* n (second a)) (magnitude a)))
          (+ (second p) (quotient (* n (third a)) (magnitude a))) (third p)))
  (define (segment a k)
    (list (apply append (for/list ((p (first a))) (for/list ((n (range (+ k 1)))) (point p a n))))
          (length (remove-duplicates (map third (first a))))))
  (define (collision p a q b i j)
    (define det (- (* (second a) (third b)) (* (third a) (second b))))
    (if (= det 0) #f
      (let* ((sign (sgn det)) (den (abs det))
             (dy (- (first q) (first p))) (dx (- (second q) (second p)))
             (tn (* sign (- (* dy (third b)) (* dx (second b)))))
             (sn (* sign (- (* dy (third a)) (* dx (second a)))))
             (yy (+ (* (first p) den) (* tn (second a))))
             (xx (+ (* (second p) den) (* tn (third a)))))
        (if (and (> tn 0) (> sn 0) (<= 0 yy) (< yy (* h den)) (<= 0 xx) (< xx (* w den)))
          (let ((ka (- (quotient (+ (* tn (magnitude a)) den -1) den) 1))
                (kb (- (quotient (+ (* sn (magnitude b)) den -1) den) 1)))
            (list (max ka kb) (+ ka kb) i j ka kb)) #f))))
  (define (lex< a b)
    (cond ((null? a) #f) ((< (first a) (first b)) #t)
          ((> (first a) (first b)) #f) (else (lex< (rest a) (rest b)))))
  (define (earliest? e candidates)
    (for/and ((f candidates))
      (and (or (not (= (third f) (third e))) (>= (fifth f) (fifth e)))
           (or (not (= (fourth f) (third e))) (>= (sixth f) (fifth e)))
           (or (not (= (third f) (fourth e))) (>= (fifth f) (sixth e)))
           (or (not (= (fourth f) (fourth e))) (>= (sixth f) (sixth e))))))
  (define (divisor a b) (if (= b 0) (abs a) (divisor b (remainder a b))))
  (define segments
    (let loop ((gs groups) (done '()) (budget 128))
      (define cs (if disable-merging '()
        (filter (lambda (x) x)
         (for*/list ((i (range (length gs))) (j (range i))
                     (p (first (list-ref gs i))) (q (first (list-ref gs j))))
           (collision p (list-ref gs i) q (list-ref gs j) i j)))))
      (if (or (null? cs) (= budget 0))
        (append done (map (lambda (a) (segment a (* 2 (max h w)))) gs))
        (let* ((eligible (filter (lambda (e) (earliest? e cs)) cs))
               (e (first (sort (if (null? eligible) cs eligible) lex<)))
               (i (third e)) (j (fourth e)) (ka (fifth e)) (kb (sixth e))
               (a (list-ref gs i)) (b (list-ref gs j))
               (vr (+ (* (second a) (magnitude b)) (* (second b) (magnitude a))))
               (vc (+ (* (third a) (magnitude b)) (* (third b) (magnitude a))))
               (div (max 1 (divisor vr vc)))
               (dr (if unitize (sgn vr) (quotient vr div)))
               (dc (if unitize (sgn vc) (quotient vc div)))
               (fronts (append (map (lambda (p) (point p a ka)) (first a))
                               (map (lambda (p) (point p b kb)) (first b))))
               (remaining (for/list ((idx (range (length gs))) #:when (and (not (= idx i)) (not (= idx j)))) (list-ref gs idx))))
          (loop (append remaining (list (list fronts dr dc)))
                (append done (list (segment a ka) (segment b kb))) (- budget 1))))))
  (for/fold ((out g)) ((seg segments))
    (define mark (and mark-mode (cond ((= mark-style 1) #t) ((= mark-style 2) (= (second seg) 2)) (else (>= (second seg) 2)))))
    (for/fold ((a out)) ((p (first seg)))
      (define r (first p)) (define c (second p)) (define co (third p))
      (if (and (in-bounds? r c h w) (or (= (at g r c) bg) (= (at g r c) co)))
          (set-cell a r c (if mark 5 co)) a)))))
