+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+TASK_HOME = Path(__file__).resolve().parents[1]
+PROBE_PATH = TASK_HOME / "workspace" / "learnability_probe.py"
+GENERATOR_PATH = TASK_HOME / "generator.py"
+
+
+def _load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_independent_rule_output_uses_absolute_height_gap_and_rightmost_bar():
+    probe = _load(PROBE_PATH, "b34_probe")
+    grid = [
+        [7, 7, 7, 7, 7, 7, 7],
+        [7, 7, 7, 2, 7, 7, 7],
+        [7, 7, 7, 2, 7, 7, 7],
+        [7, 7, 7, 2, 7, 5, 7],
+        [7, 8, 7, 2, 7, 5, 7],
+        [7, 8, 7, 2, 7, 5, 7],
+    ]
+    source = [row[:] for row in grid]
+    for row in source:
+        row[5] = 7
+    assert probe.rule_output(source) == grid
+
+
+def test_small_audit_is_deterministic_and_labels_every_pair():
+    probe = _load(PROBE_PATH, "b34_probe_audit")
+    generator = _load(GENERATOR_PATH, "b34_generator")
+
+    def local_labeler(inputs):
+        return [probe.rule_output(grid) for grid in inputs]
+
+    first = probe.build_report(
+        generator=generator,
+        seed_count=2,
+        starts_per_seed=2,
+        difficulties=(None,),
+        labeler=local_labeler,
+    )
+    second = probe.build_report(
+        generator=generator,
+        seed_count=2,
+        starts_per_seed=2,
+        difficulties=(None,),
+        labeler=local_labeler,
+    )
+    assert first == second
+    assert first["schema"] == "b34d330a5426-learnability-probe-v1"
+    assert first["counts"]["lessons"] == 4
+    assert first["counts"]["labeled_pairs"] == 20
+    assert first["counts"]["oracle_mismatches"] == 0
+    assert first["counts"]["generation_failures"] == 0
+    assert "fixed_height_1" in first["rivals"]
+    assert "max_height" in first["rivals"]
+
+
+def test_catalog_labeler_batches_inputs_at_runtime_limit():
+    probe = _load(PROBE_PATH, "b34_probe_batching")
+
+    class FakeCatalog:
+        def __init__(self):
+            self.calls = []
+
+        def apply(self, task_id, inputs, **options):
+            assert task_id == probe.TASK_ID
+            assert len(inputs) <= 3
+            self.calls.append(len(inputs))
+            return {
+                "schema": "arcpuzzles-apply-v1",
+                "reference": "canonical",
+                "rule_file": "fixture",
+                "executed_rule_hash": "abc123",
+                "catalog_rule_hash": "abc123",
+                "rule_hash_matches_catalog": True,
+                "rule_text_sha256": "f" * 64,
+                "generator_sha256": "e" * 64,
+                "catalog_approved": False,
+                "train_safety": "unverified",
+                "results": [
+                    {
+                        "output": grid,
+                        "error": None,
+                        "valid_output": True,
+                        "generator_domain": {"status": "valid", "errors": []},
+                    }
+                    for grid in inputs
+                ],
+            }
+
+    fake = FakeCatalog()
+    labeler = probe.catalog_labeler(fake, batch_size=3)
+    grids = [[[index]] for index in range(7)]
+    receipt = labeler(grids)
+    assert fake.calls == [3, 3, 1]
+    assert [item["output"] for item in receipt["results"]] == grids
+    assert receipt["batch_count"] == 3
+
+
+def test_natural_four_demo_windows_force_sign_order_difference_and_position_contrasts():
+    probe = _load(PROBE_PATH, "b34_probe_schedule")
+    generator = _load(GENERATOR_PATH, "b34_generator_schedule")
+    for difficulty in (None, "easy", "hard"):
+        for seed in range(5):
+            for start in range(8):
+                grids = [
+                    generator.generate(seed, start + offset, difficulty=difficulty)
+                    for offset in range(generator.EXAMPLES_NEEDED + 1)
+                ]
+                facts = [probe._bar_facts(grid) for grid in grids]
+                demos = facts[: generator.EXAMPLES_NEEDED]
+                assert {item["sum_8"] > item["sum_2"] for item in demos} == {False, True}
+                assert {
+                    item["color_8_cols"][-1] > item["color_2_cols"][-1]
+                    for item in demos
+                } == {False, True}
+                assert len({abs(item["sum_8"] - item["sum_2"]) for item in demos}) >= 2
+                assert len({item["rightmost"] + 2 for item in demos}) >= 2
+
+                outputs = [probe.rule_output(grid) for grid in grids]
+                harmful = []
+                for name, rival in probe.RIVALS.items():
+                    if all(rival(grid) == output for grid, output in zip(grids[:4], outputs[:4])):
+                        if rival(grids[4]) != outputs[4]:
+                            harmful.append(name)
+                assert harmful == []
+
+
+def test_schedule_profile_is_a_four_slot_cycle():
+    generator = _load(GENERATOR_PATH, "b34_generator_profiles")
+    assert len(generator.SCHEDULE_PROFILES) == generator.EXAMPLES_NEEDED == 4
+    assert [generator.schedule_profile(999, index) for index in range(8)] == [
+        *generator.SCHEDULE_PROFILES,
+        *generator.SCHEDULE_PROFILES,
+    ]
+
+
+def test_explicit_columns_allow_color8_to_be_rightmost():
+    probe = _load(PROBE_PATH, "b34_probe_override")
+    generator = _load(GENERATOR_PATH, "b34_generator_override")
+    grid = generator.generate(
+        3,
+        0,
+        difficulty="easy",
+        grid_h=7,
+        grid_w=9,
+        col_8=5,
+        col_2=1,
+        bar_h_8=5,
+        bar_h_2=2,
+    )
+    facts = probe._bar_facts(grid)
+    assert facts["color_8_cols"] == [5]
+    assert facts["color_2_cols"] == [1]
+    assert facts["rightmost"] == 5
+    assert generator.self_check(grid) == []
