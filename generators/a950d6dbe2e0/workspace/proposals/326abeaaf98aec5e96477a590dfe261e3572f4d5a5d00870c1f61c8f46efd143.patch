+#!/usr/bin/env python3
+"""Protected-label learnability probe for ARC task ``b34d330a5426``.
+
+The selected generator has no task-local regression suite.  This reusable probe
+therefore builds natural four-demo/one-query lessons, labels every pair with the
+canonical Racket authority, checks an independent Python oracle, and searches a
+finite family of arithmetic, placement, and fixed-answer rivals for harmful
+survivors.
+
+Run from the packet root through the supplied wrapper::
+
+    python3 review.py run python3 \
+      generators/b34d330a5426/workspace/learnability_probe.py \
+      --seed-count 16 --starts-per-seed 4 \
+      --out ../checks/b34d330a5426/learnability.json
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from typing import Any, Callable, Iterable
+
+TASK_ID = "b34d330a5426"
+EXAMPLES_NEEDED = 4
+HERE = Path(__file__).resolve().parent
+GENERATOR_PATH = HERE.parent / "generator.py"
+
+Grid = list[list[int]]
+Labeler = Callable[[list[Grid]], Any]
+
+
+def _load_generator(path: Path = GENERATOR_PATH):
+    spec = importlib.util.spec_from_file_location(f"probe_{TASK_ID}_generator", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load generator from {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _bar_facts(grid: Grid) -> dict[str, Any]:
+    if not grid or not grid[0]:
+        raise ValueError("grid must be non-empty")
+    height = len(grid)
+    width = len(grid[0])
+    if any(len(row) != width for row in grid):
+        raise ValueError("grid must be rectangular")
+    bar_cols = [col for col in range(width) if grid[-1][col] != 7]
+    if not bar_cols:
+        raise ValueError("bottom row has no bars")
+    sum_8 = sum(
+        sum(grid[row][col] != 7 for row in range(height))
+        for col in bar_cols
+        if grid[-1][col] == 8
+    )
+    sum_2 = sum(
+        sum(grid[row][col] != 7 for row in range(height))
+        for col in bar_cols
+        if grid[-1][col] == 2
+    )
+    color_8_cols = [col for col in bar_cols if grid[-1][col] == 8]
+    color_2_cols = [col for col in bar_cols if grid[-1][col] == 2]
+    return {
+        "height": height,
+        "width": width,
+        "bar_cols": bar_cols,
+        "sum_8": sum_8,
+        "sum_2": sum_2,
+        "rightmost": bar_cols[-1],
+        "leftmost": bar_cols[0],
+        "color_8_cols": color_8_cols,
+        "color_2_cols": color_2_cols,
+    }
+
+
+def _paint(grid: Grid, *, gray_height: int, gray_col: int) -> Grid:
+    out = deepcopy(grid)
+    height = len(out)
+    width = len(out[0])
+    if not 0 <= gray_col < width:
+        return out
+    gray_height = max(0, min(height, int(gray_height)))
+    for row in range(height - gray_height, height):
+        out[row][gray_col] = 5
+    return out
+
+
+def rule_output(grid: Grid) -> Grid:
+    """Independent implementation of the canonical bar-difference rule."""
+    facts = _bar_facts(grid)
+    return _paint(
+        grid,
+        gray_height=abs(facts["sum_8"] - facts["sum_2"]),
+        gray_col=facts["rightmost"] + 2,
+    )
+
+
+def _rival_builders() -> dict[str, Callable[[Grid], Grid]]:
+    def by_height(name: str, fn: Callable[[dict[str, Any]], int]):
+        return name, lambda grid: _paint(
+            grid,
+            gray_height=fn(_bar_facts(grid)),
+            gray_col=_bar_facts(grid)["rightmost"] + 2,
+        )
+
+    def by_column(name: str, fn: Callable[[dict[str, Any]], int]):
+        return name, lambda grid: _paint(
+            grid,
+            gray_height=abs(_bar_facts(grid)["sum_8"] - _bar_facts(grid)["sum_2"]),
+            gray_col=fn(_bar_facts(grid)),
+        )
+
+    rivals: dict[str, Callable[[Grid], Grid]] = dict(
+        [
+            by_height("max_height", lambda f: max(f["sum_8"], f["sum_2"])),
+            by_height("min_height", lambda f: min(f["sum_8"], f["sum_2"])),
+            by_height("sum_height", lambda f: f["sum_8"] + f["sum_2"]),
+            by_height("height_8", lambda f: f["sum_8"]),
+            by_height("height_2", lambda f: f["sum_2"]),
+            by_height("signed_8_minus_2", lambda f: max(0, f["sum_8"] - f["sum_2"])),
+            by_height("signed_2_minus_8", lambda f: max(0, f["sum_2"] - f["sum_8"])),
+            by_column("leftmost_plus2", lambda f: f["leftmost"] + 2),
+            by_column("rightmost_plus1", lambda f: f["rightmost"] + 1),
+            by_column("rightmost_plus3", lambda f: f["rightmost"] + 3),
+            by_column(
+                "color8_rightmost_plus2",
+                lambda f: (f["color_8_cols"][-1] if f["color_8_cols"] else -2) + 2,
+            ),
+            by_column(
+                "color2_rightmost_plus2",
+                lambda f: (f["color_2_cols"][-1] if f["color_2_cols"] else -2) + 2,
+            ),
+        ]
+    )
+    for gray_height in range(1, 15):
+        rivals[f"fixed_height_{gray_height}"] = (
+            lambda grid, value=gray_height: _paint(
+                grid,
+                gray_height=value,
+                gray_col=_bar_facts(grid)["rightmost"] + 2,
+            )
+        )
+    for gray_col in range(16):
+        rivals[f"fixed_col_{gray_col}"] = (
+            lambda grid, value=gray_col: _paint(
+                grid,
+                gray_height=abs(
+                    _bar_facts(grid)["sum_8"] - _bar_facts(grid)["sum_2"]
+                ),
+                gray_col=value,
+            )
+        )
+    return rivals
+
+
+RIVALS = _rival_builders()
+
+
+def catalog_labeler(catalog, *, batch_size: int = 64) -> Labeler:
+    """Return a canonical labeler that respects the runtime input cap."""
+    if type(batch_size) is not int or batch_size < 1:
+        raise ValueError("batch_size must be a positive integer")
+
+    def label(inputs: list[Grid]) -> dict[str, Any]:
+        if not inputs:
+            raise ValueError("inputs must not be empty")
+        merged: dict[str, Any] | None = None
+        total_elapsed = 0.0
+        batch_count = 0
+        identity_fields = (
+            "schema",
+            "task_id",
+            "rule_task_id",
+            "reference",
+            "rule_file",
+            "executed_rule_hash",
+            "catalog_rule_hash",
+            "rule_hash_matches_catalog",
+            "rule_text_sha256",
+            "generator_sha256",
+            "catalog_approved",
+            "approved",
+            "train_safety",
+        )
+        for start in range(0, len(inputs), batch_size):
+            receipt = catalog.apply(
+                TASK_ID,
+                inputs[start : start + batch_size],
+                reference="canonical",
+                check_generator_domain=True,
+                timeout=180,
+            )
+            batch_count += 1
+            total_elapsed += float(receipt.get("elapsed_seconds") or 0.0)
+            if merged is None:
+                merged = dict(receipt)
+                merged["results"] = list(receipt.get("results", []))
+            else:
+                for field in identity_fields:
+                    if merged.get(field) != receipt.get(field):
+                        raise RuntimeError(
+                            f"catalog receipt changed {field} across batches: "
+                            f"{merged.get(field)!r} != {receipt.get(field)!r}"
+                        )
+                merged["results"].extend(receipt.get("results", []))
+        assert merged is not None
+        merged["elapsed_seconds"] = total_elapsed
+        merged["batch_count"] = batch_count
+        merged["batch_size"] = batch_size
+        return merged
+
+    return label
+
+
+def _normalise_labels(raw: Any, expected: int) -> tuple[list[Grid], dict[str, Any]]:
+    if isinstance(raw, dict):
+        results = raw.get("results")
+        if not isinstance(results, list):
+            raise ValueError("label receipt has no results list")
+        outputs: list[Grid] = []
+        domain_errors = 0
+        invalid_outputs = 0
+        for result in results:
+            if result.get("error") is not None:
+                raise RuntimeError(f"canonical label failed: {result['error']}")
+            outputs.append(result["output"])
+            domain_errors += result.get("generator_domain", {}).get("status") != "valid"
+            invalid_outputs += not bool(result.get("valid_output", False))
+        metadata = {
+            "schema": raw.get("schema"),
+            "reference": raw.get("reference"),
+            "rule_file": raw.get("rule_file"),
+            "executed_rule_hash": raw.get("executed_rule_hash"),
+            "catalog_rule_hash": raw.get("catalog_rule_hash"),
+            "rule_hash_matches_catalog": raw.get("rule_hash_matches_catalog"),
+            "rule_text_sha256": raw.get("rule_text_sha256"),
+            "generator_sha256": raw.get("generator_sha256"),
+            "catalog_approved": raw.get("catalog_approved"),
+            "train_safety": raw.get("train_safety"),
+            "domain_errors": domain_errors,
+            "invalid_outputs": invalid_outputs,
+        }
+    else:
+        outputs = list(raw)
+        metadata = {"labeler": "injected", "domain_errors": 0, "invalid_outputs": 0}
+    if len(outputs) != expected:
+        raise ValueError(f"labeler returned {len(outputs)} outputs for {expected} inputs")
+    return outputs, metadata
+
+
+def _grid_digest(grid: Grid) -> str:
+    return hashlib.sha256(json.dumps(grid, separators=(",", ":")).encode()).hexdigest()
+
+
+def build_report(
+    *,
+    generator,
+    seed_count: int = 16,
+    starts_per_seed: int = 4,
+    difficulties: Iterable[str | None] = (None, "easy", "hard"),
+    labeler: Labeler,
+    canonical_pairs: list[dict[str, Grid]] | None = None,
+) -> dict[str, Any]:
+    """Build a deterministic bounded learnability report."""
+    if type(seed_count) is not int or seed_count < 1:
+        raise ValueError("seed_count must be a positive integer")
+    if type(starts_per_seed) is not int or starts_per_seed < 1:
+        raise ValueError("starts_per_seed must be a positive integer")
+    bands = tuple(difficulties)
+    if not bands:
+        raise ValueError("difficulties must not be empty")
+
+    lessons: list[dict[str, Any]] = []
+    flat_inputs: list[Grid] = []
+    generation_failures: list[dict[str, Any]] = []
+    self_check_failures: list[dict[str, Any]] = []
+    distinct_inputs: set[str] = set()
+
+    for difficulty in bands:
+        band = "default" if difficulty is None else str(difficulty)
+        for seed_offset in range(seed_count):
+            seed = 41_000 + seed_offset
+            for start in range(starts_per_seed):
+                inputs: list[Grid] = []
+                indices = [start * (EXAMPLES_NEEDED + 1) + offset for offset in range(EXAMPLES_NEEDED + 1)]
+                try:
+                    for sample_index in indices:
+                        grid = generator.generate(seed, sample_index, difficulty=difficulty)
+                        errors = generator.self_check(deepcopy(grid), difficulty=difficulty)
+                        if errors:
+                            self_check_failures.append(
+                                {
+                                    "difficulty": band,
+                                    "seed": seed,
+                                    "sample_index": sample_index,
+                                    "errors": list(errors),
+                                }
+                            )
+                        inputs.append(grid)
+                        distinct_inputs.add(_grid_digest(grid))
+                except Exception as exc:  # retained in report; probe continues
+                    generation_failures.append(
+                        {
+                            "difficulty": band,
+                            "seed": seed,
+                            "start": start,
+                            "error": f"{type(exc).__name__}: {exc}",
+                        }
+                    )
+                    continue
+                begin = len(flat_inputs)
+                flat_inputs.extend(inputs)
+                lessons.append(
+                    {
+                        "difficulty": band,
+                        "seed": seed,
+                        "start": start,
+                        "indices": indices,
+                        "slice": [begin, begin + len(inputs)],
+                    }
+                )
+
+    labels, label_metadata = _normalise_labels(labeler(flat_inputs), len(flat_inputs))
+    oracle_mismatches = [
+        {
+            "pair_index": index,
+            "input_sha256": _grid_digest(grid),
+            "racket_output_sha256": _grid_digest(labels[index]),
+            "oracle_output_sha256": _grid_digest(rule_output(grid)),
+        }
+        for index, grid in enumerate(flat_inputs)
+        if rule_output(grid) != labels[index]
+    ]
+
+    canonical = list(canonical_pairs or [])
+    rival_stats: dict[str, dict[str, Any]] = {}
+    harmful_examples: list[dict[str, Any]] = []
+    for name, rival in RIVALS.items():
+        sampled_matches = sum(
+            rival(grid) == output for grid, output in zip(flat_inputs, labels, strict=True)
+        )
+        canonical_matches = sum(
+            rival(pair["input"]) == pair["output"] for pair in canonical
+        )
+        demo_fit_lessons = 0
+        harmful_survivals = 0
+        first_harmful: dict[str, Any] | None = None
+        for lesson in lessons:
+            begin, end = lesson["slice"]
+            lesson_inputs = flat_inputs[begin:end]
+            lesson_outputs = labels[begin:end]
+            fits_demos = all(
+                rival(grid) == output
+                for grid, output in zip(
+                    lesson_inputs[:EXAMPLES_NEEDED],
+                    lesson_outputs[:EXAMPLES_NEEDED],
+                    strict=True,
+                )
+            )
+            if not fits_demos:
+                continue
+            demo_fit_lessons += 1
+            if rival(lesson_inputs[-1]) != lesson_outputs[-1]:
+                harmful_survivals += 1
+                if first_harmful is None:
+                    query_facts = _bar_facts(lesson_inputs[-1])
+                    first_harmful = {
+                        "difficulty": lesson["difficulty"],
+                        "seed": lesson["seed"],
+                        "start": lesson["start"],
+                        "query_index": lesson["indices"][-1],
+                        "query_facts": {
+                            "sum_8": query_facts["sum_8"],
+                            "sum_2": query_facts["sum_2"],
+                            "rightmost": query_facts["rightmost"],
+                            "intended_height": abs(query_facts["sum_8"] - query_facts["sum_2"]),
+                            "intended_col": query_facts["rightmost"] + 2,
+                        },
+                    }
+                    harmful_examples.append({"rival": name, **first_harmful})
+        rival_stats[name] = {
+            "sampled_pair_matches": sampled_matches,
+            "sampled_pair_count": len(flat_inputs),
+            "canonical_pair_matches": canonical_matches,
+            "canonical_pair_count": len(canonical),
+            "demo_fit_lessons": demo_fit_lessons,
+            "harmful_survivals": harmful_survivals,
+            "sampled_domain_equivalent": sampled_matches == len(flat_inputs),
+            "canonical_equivalent": bool(canonical) and canonical_matches == len(canonical),
+            "first_harmful": first_harmful,
+        }
+
+    return {
+        "schema": "b34d330a5426-learnability-probe-v1",
+        "task_id": TASK_ID,
+        "generator_version": getattr(generator, "VERSION", None),
+        "generator_sha256": hashlib.sha256(Path(generator.__file__).read_bytes()).hexdigest(),
+        "configuration": {
+            "seed_count": seed_count,
+            "starts_per_seed": starts_per_seed,
+            "difficulties": ["default" if item is None else str(item) for item in bands],
+            "examples_needed": EXAMPLES_NEEDED,
+            "rival_count": len(RIVALS),
+            "finite_scope": "arithmetic formulas, placement formulas, fixed heights 1..14, and fixed columns 0..15",
+        },
+        "counts": {
+            "lessons": len(lessons),
+            "labeled_pairs": len(flat_inputs),
+            "distinct_inputs": len(distinct_inputs),
+            "canonical_pairs": len(canonical),
+            "generation_failures": len(generation_failures),
+            "self_check_failures": len(self_check_failures),
+            "oracle_mismatches": len(oracle_mismatches),
+            "harmful_rivals": sum(item["harmful_survivals"] > 0 for item in rival_stats.values()),
+            "harmful_survival_windows": sum(item["harmful_survivals"] for item in rival_stats.values()),
+        },
+        "label_receipt": label_metadata,
+        "generation_failures": generation_failures,
+        "self_check_failures": self_check_failures,
+        "oracle_mismatches": oracle_mismatches,
+        "rivals": rival_stats,
+        "harmful_examples": harmful_examples,
+        "domain_aliases": [
+            name
+            for name, item in rival_stats.items()
+            if item["sampled_domain_equivalent"]
+        ],
+        "status": "passed"
+        if not generation_failures
+        and not self_check_failures
+        and not oracle_mismatches
+        else "failed",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed-count", type=int, default=16)
+    parser.add_argument("--starts-per-seed", type=int, default=4)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+
+    generator = _load_generator()
+    from arcpuzzles import Catalog
+    from reviewer_support import canonical_pairs, find_root
+
+    root = find_root(__file__)
+    catalog = Catalog(root)
+    labeler = catalog_labeler(catalog)
+
+    report = build_report(
+        generator=generator,
+        seed_count=args.seed_count,
+        starts_per_seed=args.starts_per_seed,
+        labeler=labeler,
+        canonical_pairs=canonical_pairs(TASK_ID, root=root),
+    )
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"out": str(args.out), "status": report["status"], **report["counts"]}, sort_keys=True))
+    return 0 if report["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
