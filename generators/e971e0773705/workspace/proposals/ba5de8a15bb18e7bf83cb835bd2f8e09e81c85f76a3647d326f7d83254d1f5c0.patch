+"""One bounded independent check: completed-component perimeter versus area.
+
+Run through review.py run from the outer packet. This is review evidence only;
+it does not change accepted sources, admission, or the task's finite rival set.
+"""
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+HOME = Path(__file__).resolve().parent / 'parametric'
+TASK = HOME.parents[1]
+ROOT = HOME.parents[3]
+RUNTIME = ROOT / 'shared/runtime'
+sys.path[:0] = [str(ROOT / 'src'), str(RUNTIME)]
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+
+def load(path):
+    spec = importlib.util.spec_from_file_location('peer_rectangle_' + path.stem, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def source_hashes():
+    paths = [TASK/'generator.py', HOME/'prototype.py', HOME/'adapter.py', HOME/'racket_rules.py',
+             HOME/'canonical.rkt', HOME/'promotion.json', TASK/'parametric/accepted.json',
+             TASK/'evidence/parametric-admission-current.json', Path(__file__)]
+    return {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+
+
+def complete_and_group(grid):
+    colors = {}
+    for r,row in enumerate(grid):
+        for c,v in enumerate(row):
+            if v: colors.setdefault(v,[]).append((r,c))
+    filled = deepcopy(grid)
+    for color,cells in colors.items():
+        for r in range(min(r for r,c in cells),max(r for r,c in cells)+1):
+            for c in range(min(c for r,c in cells),max(c for r,c in cells)+1):
+                filled[r][c] = color
+    todo = {(r,c) for r,row in enumerate(filled) for c,v in enumerate(row) if v}
+    groups = []
+    while todo:
+        p=min(todo); todo.remove(p); group={p}; stack=[p]
+        while stack:
+            r,c=stack.pop()
+            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
+                q=(r+dr,c+dc)
+                if q in todo: todo.remove(q); group.add(q); stack.append(q)
+        groups.append(group)
+    return filled,groups
+
+
+def perimeter(cells):
+    return sum((r+dr,c+dc) not in cells for r,c in cells for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)))
+
+
+def oracle(grid,kind):
+    filled,groups=complete_and_group(grid)
+    selected=max(groups,key=len if kind=='area' else perimeter)
+    return [[v if (r,c) in selected else 0 for c,v in enumerate(row)] for r,row in enumerate(filled)]
+
+
+def main():
+    out=Path(sys.argv[1]).resolve(); out.mkdir(parents=True,exist_ok=False)
+    before=source_hashes(); bridge=None
+    report={'schema':'89c85768abe1-perimeter-peer-check-v1','status':'running','task_id':'89c85768abe1',
+            'training_admitted':False,'visibility':'controller_private','source_sha256':before,
+            'seeds':[0,17,101],'demos':2,'queries':4,'episodes':[],
+            'limits':'One extra natural interpretation on three minimum-demo episodes of the accepted largest_component mode. Fits use demonstrations only; rejected rivals never inspect query labels. No full battery, source repair, accepted-source rebuild, or admission decision.'}
+    try:
+        with _local_imports(RUNTIME,HOME):
+            adapter=load(HOME/'adapter.py'); rules=load(HOME/'racket_rules.py')
+            rule=adapter.program({'mode':'largest_component'})
+            rival=rules._program('''
+    (define (edge-perimeter cells)
+      (for/sum ([p (in-list cells)])
+        (for/sum ([d (in-list (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))])
+          (if (member (list (+ (first p) (first d)) (+ (second p) (second d))) cells) 0 1))))
+    (let* ([completed (complete-corners g)]
+           [groups (components-any-nonzero completed)]
+           [selected (for/fold ([best '()]) ([cells (in-list groups)])
+                       (if (> (edge-perimeter cells) (edge-perimeter best)) cells best))])
+      (keep-component completed selected))
+''')
+            apply,identity,bridge=_real_evaluator(RUNTIME)
+            assert identity['backend']=='racket' and identity['protected'] is True
+            report.update({'racket':identity,'programs':{'area':rule,'perimeter':rival},'racket_evaluations':0})
+            for seed in report['seeds']:
+                e=adapter.generate(seed,{'mode':'largest_component'},2,4)
+                outputs={name:[] for name in ('area','perimeter')}
+                for name,program in [('area',rule),('perimeter',rival)]:
+                    for pair in e['train']:
+                        result=apply(program,pair['input']); report['racket_evaluations']+=1
+                        assert result==oracle(pair['input'],name),name
+                        if name=='area': assert result==pair['output']
+                        outputs[name].append(result)
+                rejected=[i for i in range(2) if outputs['area'][i]!=outputs['perimeter'][i]]
+                queries=[]
+                if not rejected:
+                    for pair in e['test']:
+                        actual=apply(rule,pair['input']); alternative=apply(rival,pair['input'])
+                        report['racket_evaluations']+=2
+                        assert actual==pair['output']==oracle(pair['input'],'area')
+                        assert alternative==oracle(pair['input'],'perimeter')
+                        queries.append({'input':pair['input'],'area':actual,'perimeter':alternative,'disagrees':actual!=alternative})
+                measures=[]
+                for pair in e['train']:
+                    _,groups=complete_and_group(pair['input'])
+                    measures.append([{'area':len(g),'perimeter':perimeter(g),'first_cell':list(min(g))} for g in groups])
+                report['episodes'].append({'seed':seed,'settings':{'mode':'largest_component'},'train':e['train'],
+                    'demo_outputs':outputs,'demo_component_measures':measures,'rejected_by_demo_indices':rejected,
+                    'fit_frozen_before_query':True,'query_checks':queries})
+            assert source_hashes()==before,'Reviewed source changed'
+            report['status']='bounded_no_finding' if not any(q['disagrees'] for e in report['episodes'] for q in e['query_checks']) else 'teaching_ambiguity_found'
+    except Exception as error:
+        report.update({'status':'execution_failure','error':repr(error)})
+    finally:
+        if bridge is not None: bridge.close()
+        (out/'report.json').write_text(json.dumps(report,indent=2,sort_keys=True)+'\n')
+    print(json.dumps({'status':report['status'],'racket_evaluations':report.get('racket_evaluations'),
+                     'demo_rejections':[e['rejected_by_demo_indices'] for e in report['episodes']]},sort_keys=True))
+    return 0 if report['status']=='bounded_no_finding' else 1
+
+if __name__=='__main__': raise SystemExit(main())
