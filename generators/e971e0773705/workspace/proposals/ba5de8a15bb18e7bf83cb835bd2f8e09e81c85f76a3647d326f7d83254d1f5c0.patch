+            "query_difference_cells": sum(a != b for ra, rb in zip(query_outputs["cancel_opposites"], query_outputs["cap_before_cancel"]) for a, b in zip(ra, rb)),
+            "facts": {"train": [facts(g) for g in demos], "query": facts(query)},
