+
+@pytest.mark.parametrize("bad", [[], [[0]], [[True, 2, 2], [0, 2, 0]], [[2, 2], [2, 2]], [[2, 2, 2], [0, 2]], [[1, 1, 1], [0, 1, 0]]])
+def test_strict_exact_t_grammar(bad):
