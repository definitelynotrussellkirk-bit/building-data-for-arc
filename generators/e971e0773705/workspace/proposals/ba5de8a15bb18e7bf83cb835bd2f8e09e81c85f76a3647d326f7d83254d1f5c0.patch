+"""Find one bounded default-lesson bbox-area shortcut and replay it in Racket.
+
+This reviewer probe does not change generation, canonical semantics, approval,
+or the retained audit index. Python selects a candidate; protected Racket
+supplies every retained reference and rival output.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+
+HOME = Path(__file__).resolve().parents[1]
+REPO = HOME.parents[1]
+
+
+def components(grid):
+    pending = {(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value}
+    result = []
+    while pending:
+        start = min(pending)
+        pending.remove(start)
+        stack, cells = [start], []
+        color = grid[start[0]][start[1]]
+        while stack:
+            r, c = stack.pop()
+            cells.append((r, c))
+            for point in ((r-1, c), (r+1, c), (r, c-1), (r, c+1)):
+                if point in pending and grid[point[0]][point[1]] == color:
+                    pending.remove(point)
+                    stack.append(point)
+        rows, cols = zip(*cells)
+        bbox = (min(rows), min(cols), max(rows), max(cols))
+        result.append({"color": color, "size": len(cells), "bbox": bbox,
+                       "bbox_area": (bbox[2]-bbox[0]+1)*(bbox[3]-bbox[1]+1),
+                       "cells": sorted(cells)})
+    return result
+
+
+def selected(facts, measure):
+    return min(facts, key=lambda item: (-item[measure], item["bbox"]))["cells"]
+
+
+def run():
+    catalog = Catalog(REPO)
+    description = catalog.describe(HOME.name)
+    canonical = {variant["program_solution"] for variant in catalog.get(HOME.name)["variants"]
+                 if isinstance(variant.get("program_solution"), str)}
+    assert len(canonical) == 1
+    canonical = canonical.pop()
+    rival = canonical.replace("(obj-size a)", "(* (obj-h a) (obj-w a))").replace(
+        "(obj-size b)", "(* (obj-h b) (obj-w b))")
+    assert rival != canonical
+    source = HOME / "generator.py"
+    source_hash = hashlib.sha256(source.read_bytes()).hexdigest()
+    report = {
+        "task_id": HOME.name,
+        "source_sha256": source_hash,
+        "rule_hash": description["rule_hash"],
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "programs": {"canonical": canonical, "largest_bbox_area": rival},
+        "bounded_search": {"maximum_seeds": 32, "sample_indices": list(range(7)),
+                           "demonstrations": [0, 1, 2], "queries": [3, 4, 5, 6],
+                           "difficulty": None, "overrides": {}},
+        "seeds_screened": 0, "grids_screened": 0,
+        "status": "no_witness_in_bound", "racket_evaluations": 0,
+        "scope": "One natural-rival teaching witness; no claim of incorrect canonical labels, exhaustive coverage, or acceptance.",
+    }
+    runtime = REPO / "shared/runtime"
+    with _local_imports(runtime, HOME):
+        from puzzle_generators.rule_wrap import wrap_rule
+        spec = importlib.util.spec_from_file_location("peer_largest_blob_generator", source)
+        generator = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(generator)
+        for seed in range(32):
+            grids = [generator.generate(seed, index) for index in range(7)]
+            facts = [components(grid) for grid in grids]
+            report["seeds_screened"] += 1
+            report["grids_screened"] += len(grids)
+            messages = [generator.self_check(grid) for grid in grids]
+            if any(messages) or len({json.dumps(grid) for grid in grids}) != 7:
+                continue
+            matches = [selected(items, "size") == selected(items, "bbox_area") for items in facts]
+            if not all(matches[:3]) or all(matches[3:]):
+                continue
+            assert wrap_rule(canonical) and wrap_rule(rival)
+            apply, identity, bridge = _real_evaluator(runtime)
+            try:
+                assert identity["backend"] == "racket" and identity["protected"] is True
+                pairs = []
+                for index, (grid, details) in enumerate(zip(grids, facts)):
+                    correct = apply(canonical, grid)
+                    wrong = apply(rival, grid)
+                    report["racket_evaluations"] += 2
+                    assert (correct == wrong) == matches[index]
+                    pairs.append({"sample_index": index, "input": grid, "reference_output": correct,
+                                  "rival_output": wrong, "matches": correct == wrong,
+                                  "component_facts": details, "self_check_messages": messages[index]})
+                report.update({"status": "witness_reproduced", "seed": seed,
+                               "racket": identity, "train": pairs[:3], "test": pairs[3:],
+                               "rival_fits_all_demonstrations": all(pair["matches"] for pair in pairs[:3]),
+                               "disagreeing_query_indices": [pair["sample_index"] for pair in pairs[3:] if not pair["matches"]]})
+            finally:
+                bridge.close()
+            break
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == source_hash
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    report = run()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({key: value for key, value in report.items() if key not in ("programs", "racket", "train", "test")}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
