+"""Bounded peer learnability probe; all labels come from protected Racket."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+
+
+ROOT = Path(__file__).resolve().parents[3]
+TASK = "994f16f93144"
+
+
+def rivals():
+    main = "(and (= (at g (- r 1) (- c 1)) v) (= (at g (+ r 1) (+ c 1)) v))"
+    anti = "(and (= (at g (- r 1) (+ c 1)) v) (= (at g (+ r 1) (- c 1)) v))"
+    horizontal = "(and (= (at g r (- c 1)) v) (= (at g r (+ c 1)) v))"
+    vertical = "(and (= (at g (- r 1) c) v) (= (at g (+ r 1) c) v))"
+    longer_main = "(or (same? (- r 2) (- c 2) v) (same? (+ r 2) (+ c 2) v))"
+    longer_anti = "(or (same? (- r 2) (+ c 2) v) (same? (+ r 2) (- c 2) v))"
+    predicates = {
+        "main_slope_only": main,
+        "anti_slope_only": anti,
+        "ignore_neighbor_colors": "(or (and (> (at g (- r 1) (- c 1)) 0) (> (at g (+ r 1) (+ c 1)) 0)) (and (> (at g (- r 1) (+ c 1)) 0) (> (at g (+ r 1) (- c 1)) 0)))",
+        "include_axis_aligned_triples": f"(or {main} {anti} {horizontal} {vertical})",
+        "isolated_exact_three_only": f"(or (and {main} (not {longer_main})) (and {anti} (not {longer_anti})))",
+        "read_updated_cells": f"(or {main} {anti})",
+        "exclude_border_touching_triples": f"(and (> r 1) (> c 1) (< r (- (rows g) 2)) (< c (- (cols g) 2)) (or {main} {anti}))",
+    }
+    programs = {}
+    for name, predicate in predicates.items():
+        source = "out" if name == "read_updated_cells" else "g"
+        if name == "read_updated_cells":
+            predicate = predicate.replace("(at g ", "(at out ")
+        programs[name] = f"""(rule! (let ()
+          (define (same? rr cc v)
+            (and (<= 0 rr) (< rr (rows g)) (<= 0 cc) (< cc (cols g))
+                 (= (at g rr cc) v)))
+          (for*/fold ((out g)) ((r (in-range 1 (- (rows g) 1)))
+                                (c (in-range 1 (- (cols g) 1))))
+            (let ((v (at {source} r c)))
+              (if (and (not (= v 0)) {predicate}) (set-cell out r c 8) out)))))"""
+    return programs
+
+
+def main():
+    source = ROOT / "generators" / TASK / "generator.py"
+    spec = importlib.util.spec_from_file_location("peer_diagonal_target", source)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    entries = Catalog(ROOT).get(TASK)["variants"]
+    authorities = {entry["program_solution"] for entry in entries}
+    assert len(authorities) == 1
+    rule = next(iter(authorities))
+    candidates = rivals()
+    apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+    episodes, findings, survivors = [], [], []
+    try:
+        for band in ("easy", "medium", "hard"):
+            for seed in (0, 14, 17):
+                pairs = []
+                for index in range(4):
+                    grid = module.generate(seed, index, difficulty=band)
+                    assert module.self_check(grid) == []
+                    pairs.append({"sample_index": index, "input": grid,
+                                  "output": apply(rule, grid),
+                                  "rival_outputs": {name: apply(program, grid)
+                                                    for name, program in candidates.items()}})
+                for query_index in range(4):
+                    demos = [pair for index, pair in enumerate(pairs) if index != query_index]
+                    query = pairs[query_index]
+                    for name in candidates:
+                        if all(pair["rival_outputs"][name] == pair["output"] for pair in demos):
+                            row = {"difficulty": band, "seed": seed,
+                                   "query_sample_index": query_index, "rival": name}
+                            survivors.append(row)
+                            if query["rival_outputs"][name] != query["output"]:
+                                row["demo_sample_indices"] = [pair["sample_index"] for pair in demos]
+                                row["lesson_hook_reasons"] = module.lesson_identifiable(demos, query)
+                                row["disagreements"] = [
+                                    {"row": r, "column": c, "reference": value,
+                                     "rival": query["rival_outputs"][name][r][c]}
+                                    for r, line in enumerate(query["output"])
+                                    for c, value in enumerate(line)
+                                    if value != query["rival_outputs"][name][r][c]]
+                                findings.append(row)
+                episodes.append({"difficulty": band, "seed": seed, "pairs": pairs})
+    finally:
+        bridge.close()
+    record = {
+        "schema": "arcpuzzles-bounded-peer-learnability-probe-v1", "task_id": TASK,
+        "generator_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+        "rule_hash": hashlib.sha256(" ".join(rule.split()).encode()).hexdigest()[:12],
+        "rule_text_sha256": hashlib.sha256(rule.encode()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "program": rule, "rival_programs": candidates, "racket": identity,
+        "command": "WORK/.venv/bin/python review.py run python generators/994f16f93144/workspace/peer_probe.py",
+        "scope": {"seeds": [0, 14, 17], "bands": ["easy", "medium", "hard"],
+                  "sample_indices": [0, 1, 2, 3], "input_count": 36,
+                  "rivals": 7, "three_demo_one_query_rotations": 36},
+        "findings": findings, "demo_consistent_rivals": survivors, "episodes": episodes,
+        "status": "finding" if findings else "no_finding_in_bounded_probe",
+        "limits": "Only seven named local-rule shortcuts, three seeds and four consecutive sample indices per band were tested. Surviving rivals may be equivalent on this support. No universal identifiability or approval claim follows.",
+    }
+    output = ROOT.parent / "checks" / TASK / "peer_probe.json"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(record, separators=(",", ":")) + "\n")
+    print(json.dumps({"path": str(output), "status": record["status"],
+                      "findings": findings, "surviving_rotations": len(survivors),
+                      "generator_sha256": record["generator_sha256"],
+                      "rule_hash": record["rule_hash"]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
