+"""Bounded demo-only audit of two panel-color shortcuts; labels use Racket."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _grid, _real_evaluator
+from reviewer_support import find_root, load_selected_generator
+
+
+def run(output):
+    root = find_root(__file__)
+    task_id = "8862d66fbb3d"
+    catalog = Catalog(root)
+    row = catalog.describe(task_id)
+    programs = {v["program_solution"] for v in catalog._variants()[row.get("rule_task_id", task_id)]}
+    assert len(programs) == 1
+    canonical = programs.pop()
+    generator, source, source_sha = load_selected_generator(task_id, root=root)
+    ignore_orange = canonical.replace("(not (= (at left r c) 0))", "(and (not (= (at left r c) 0)) (not (= (at left r c) 7)))").replace("(not (= (at tr r c) 0))", "(and (not (= (at tr r c) 0)) (not (= (at tr r c) 7)))")
+    first_color = canonical.replace("(tr (transform-code right cmd)))", "(tr (transform-code right cmd)) (lc (first (filter (lambda (v) (not (= v 0))) (apply append left)))) (rc (first (filter (lambda (v) (not (= v 0))) (apply append tr)))))").replace("(not (= (at left r c) 0))", "(= (at left r c) lc)").replace("(not (= (at tr r c) 0))", "(= (at tr r c) rc)")
+    rivals = {"ignore_orange_occupancy": ignore_orange, "first_visible_color_per_panel": first_color}
+    assert all(value != canonical for value in rivals.values())
+    apply, identity, bridge = _real_evaluator(root / "shared/runtime")
+    episodes, findings, evaluations = [], [], 0
+    try:
+        for seed in range(8):
+            pairs = []
+            for index in range(7):
+                grid = generator.generate(seed, index)
+                assert not generator.self_check(grid)
+                outputs = {name: _grid(apply(program, grid)) for name, program in {"canonical": canonical, **rivals}.items()}
+                evaluations += len(outputs)
+                pairs.append({"sample_index": index, "input": grid, "outputs": outputs})
+            episode = {"seed": seed, "train": pairs[:3], "test": pairs[3:]}
+            episodes.append(episode)
+            for name in rivals:
+                fits = all(pair["outputs"][name] == pair["outputs"]["canonical"] for pair in episode["train"])
+                different = [i for i, pair in enumerate(episode["test"]) if pair["outputs"][name] != pair["outputs"]["canonical"]]
+                if fits and different:
+                    findings.append({"seed": seed, "rival": name, "query_indices": different})
+            if findings:
+                break
+    finally:
+        bridge.close()
+    report = {"schema": "arcpuzzles-bounded-peer-probe-v1", "task_id": task_id,
+              "status": "finding" if findings else "no_finding_in_finite_probe",
+              "generator_path": source.relative_to(root).as_posix(), "generator_sha256": source_sha,
+              "rule_task_id": row.get("rule_task_id", task_id), "rule_hash": row["rule_hash"],
+              "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+              "programs": {"canonical": canonical, **rivals}, "racket": identity,
+              "racket_evaluations": evaluations, "episodes": episodes, "findings": findings,
+              "scope": "At most seeds 0..7; sample indices 0..2 are demos and 3..6 are queries. Two color shortcuts only; no universal uniqueness or training admission.",
+              "reproducer_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}
+    output = Path(output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("x") as handle:
+        json.dump(report, handle, indent=2, sort_keys=True, allow_nan=False)
+        handle.write("\n")
+    print(json.dumps({"status": report["status"], "seeds": len(episodes), "racket_evaluations": evaluations, "findings": findings, "output": str(output)}))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    run(parser.parse_args().out)
