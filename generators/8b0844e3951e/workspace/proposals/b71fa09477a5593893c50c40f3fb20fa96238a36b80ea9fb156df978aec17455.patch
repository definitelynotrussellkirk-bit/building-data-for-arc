+"""Bounded review: a visited-cell loop guard can fit a scheduled lesson's demos.
+
+Run from the packet through review.py run. This writes private audit evidence;
+it does not modify the generator, reference rule, approval, or existing audits.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import time
+
+
+ROOT = Path(__file__).resolve().parents[3]
+HOME = Path(__file__).resolve().parents[1]
+TASK = "928c39acebe3"
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
+
+from arcpuzzles import Catalog
+from arc_repl.racket_bridge import RacketBridge
