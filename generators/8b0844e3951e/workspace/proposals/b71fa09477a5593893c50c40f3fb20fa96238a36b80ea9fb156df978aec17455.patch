+
+
+def stop_on_visited_cell(reference, grid):
+    """Natural but incorrect loop guard: treat any repeated cell as a loop."""
+    output = [[0] * len(grid[0]) for _ in grid]
+    seen = set()
+    for r, c in reference.trace_details(grid)["path"]:
+        if (r, c) in seen:
+            break
+        seen.add((r, c))
+        output[r][c] = 8
+    return output
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    path = args.out / "crossing_guard_witness.json"
+    if path.exists():
+        raise FileExistsError(path)
+    started = time.monotonic()
+    generator, source_path, source_hash = load_selected_generator(TASK, root=ROOT)
+    spec = importlib.util.spec_from_file_location(
+        "crossing_guard_independent_reference", HOME / "workspace/reference_probe.py"
+    )
+    reference = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(reference)
+    catalog = Catalog(root=ROOT)
+    selected = catalog.get(TASK)
+    canonical = selected["variants"][0]["program_solution"]
+    needle = "(if (or (= v 6) (= v 2)) acc"
+    assert canonical.count(needle) == 1
+    counterfactual = canonical.replace(
+        needle, "(if (or (= v 6) (= v 2) (= (at acc nr nc) 8)) acc"
+    )
+    recipes = [
+        {"seed": 0, "sample_index": index, "difficulty": "medium"}
+        for index in (1, 2, 3, 4)
+    ]
+    grids = [generator.generate(**recipe) for recipe in recipes]
+    assert all(generator.self_check(grid) == [] for grid in grids)
+    expected = [reference.official_output(grid) for grid in grids]
+    rival = [stop_on_visited_cell(reference, grid) for grid in grids]
+    assert all(a == b for a, b in zip(expected[:3], rival[:3]))
+    assert expected[3] != rival[3]
+
+    def execute(bridge, program, grid):
+        literal = "'(" + " ".join(
+            "(" + " ".join(map(str, row)) + ")" for row in grid
+        ) + ")"
+        return bridge.eval_text(f"({wrap_rule(program)} {literal})")
+
+    with RacketBridge(timeout=8.0, startup_timeout=30.0) as bridge:
+        identity = bridge.runtime_identity
+        assert identity["backend"] == "racket" and identity["protected"] is True
+        identity = {key: identity[key] for key in (
+            "schema", "backend", "protected", "binary_sha256", "prelude_sha256",
+            "bridge_sha256", "boot_script_sha256", "candidate_symbol_policy_sha256",
+        ) if key in identity}
+        labels = [execute(bridge, canonical, grid) for grid in grids]
+        rival_labels = [execute(bridge, counterfactual, grid) for grid in grids]
+    assert labels == expected, "Independent Python reference disagrees with protected Racket"
+    assert rival_labels == rival, "Python rival disagrees with its protected Racket program"
+    assert hashlib.sha256(source_path.read_bytes()).hexdigest() == source_hash
+    pairs = []
+    for recipe, grid, output, rival_output in zip(recipes, grids, labels, rival_labels):
+        path_cells = reference.trace_details(grid)["path"]
+        pairs.append({
+            "recipe": recipe,
+            "profile": generator.observe_overrides(grid)["scene_profile"],
+            "input": grid, "output": output, "rival_output": rival_output,
+            "rival_fits": output == rival_output,
+            "repeated_position_count": len(path_cells) - len(set(path_cells)),
+            "different_cells": reference.differs_at(output, rival_output),
+        })
+    report = {
+        "schema": "arcpuzzles-bounded-review-witness-v1",
+        "task_id": TASK, "status": "finding", "generator_sha256": source_hash,
+        "rule_hash": selected["rule_hash"], "source_modified": False,
+        "rival": "stop_on_previously_visited_cell",
+        "finding": (
+            "The default scheduled window at indices 1..4 has three non-crossing "
+            "demonstrations followed by a self-crossing query. Stopping at any "
+            "previously traversed cell fits every demonstration but truncates the query."
+        ),
+        "canonical_program": canonical, "rival_program": counterfactual,
+        "racket": identity, "protected_evaluations": 8,
+        "train": pairs[:3], "test": pairs[3:],
+        "demonstrations_fitted": 3, "query_disagreements": len(pairs[3]["different_cells"]),
+        "elapsed_seconds": round(time.monotonic() - started, 3),
+        "limits": (
+            "One rival, one seed, medium band, one lawful scheduled 3-demo/1-query "
+            "window. This demonstrates a teaching gap, not a wrong canonical label "
+            "or a universal ambiguity claim. Existing audits and approval are unchanged."
+        ),
+    }
+    args.out.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "status": report["status"], "generator_sha256": source_hash,
+        "demos_fitted": 3, "query_disagreements": report["query_disagreements"],
+        "protected_evaluations": 8, "racket": identity,
+        "evidence": str(path), "elapsed_seconds": report["elapsed_seconds"],
+    }, indent=2))
+
+
+if __name__ == "__main__":
+    main()
