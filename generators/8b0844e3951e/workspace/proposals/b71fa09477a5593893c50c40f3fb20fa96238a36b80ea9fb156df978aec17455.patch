+"""One bounded corner-source teaching probe; no repair or approval is performed.
+
+From the packet root:
+python3 review.py run python3 generators/959992fc8fa9/workspace/adversarial_probe.py \
+  --out ../checks/959992fc8fa9/current-review
+"""
+from __future__ import annotations
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import shlex
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+TASK = "959992fc8fa9"
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
+from reviewer_support import load_selected_generator
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator, _grid
+
+
+def raw(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+def rival(grid, name):
+    h, w = len(grid), len(grid[0])
+    pixels = [(r, c, v) for r, row in enumerate(grid) for c, v in enumerate(row) if v]
+    if name == "ignore_corner":
+        pixels = [(r, c, v) for r, c, v in pixels
+                  if not (r in (0, h - 1) and c in (0, w - 1))]
+    if name == "ignore_border":
+        pixels = [(r, c, v) for r, c, v in pixels if r not in (0, h - 1) and c not in (0, w - 1)]
+    answer = []
+    for r in range(h):
+        row = []
+        for c in range(w):
+            reached = [v for rr, cc, v in pixels if rr == r or cc == c]
+            colors = set(reached)
+            row.append(2 if len(reached if name == "all_crossings_red" else colors) > 1
+                       else reached[0] if reached else 0)
+        answer.append(row)
+    return answer
+
+
+RIVAL_PROGRAM = """(rule! (lambda (g)
+  (let* ([h (rows g)] [w (cols g)]
+         [pixels (for*/list ([r (in-range h)] [c (in-range w)]
+                   #:when (and (not (= (at g r c) 0))
+                     (not (and (or (= r 0) (= r (- h 1)))
+                               (or (= c 0) (= c (- w 1)))))))
+                   (list r c (at g r c)))])
+    (grid-from-fn h w (lambda (r c)
+      (let ([colors (remove-duplicates
+              (for/list ([p (in-list pixels)]
+                         #:when (or (= r (first p)) (= c (second p))))
+                (third p)))])
+        (cond [(empty? colors) 0] [(= (length colors) 1) (first colors)] [else 2])))))))"""
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    out = args.out.absolute()
+    if out.exists():
+        raise FileExistsError("Choose a new output directory")
+    gen, source, digest = load_selected_generator(TASK, root=ROOT)
+    catalog = Catalog(ROOT)
+    authority = catalog.describe(TASK).get("rule_task_id", TASK)
+    programs = {row["program_solution"] for row in catalog._variants()[authority]}
+    if len(programs) != 1:
+        raise ValueError("Expected one selected canonical program")
+    program = next(iter(programs))
+    rows, counts, first = [], {name: Counter() for name in
+                            ("ignore_corner", "ignore_border", "all_crossings_red")}, None
+    for seed in (0, 17, 23):
+        for difficulty in ("easy", "medium", "hard"):
+            for start in (0, 1, 2):
+                inputs = [gen.generate(seed, start + i, difficulty=difficulty) for i in range(7)]
+                labels = [gen.rule_mirror(grid) for grid in inputs]
+                for name in counts:
+                    agreement = [rival(grid, name) == label for grid, label in zip(inputs, labels)]
+                    status = ("demo_refuted" if not all(agreement[:3]) else
+                              "query_ambiguous" if not all(agreement[3:]) else "support_equivalent")
+                    counts[name][status] += 1
+                    rows.append({"seed": seed, "difficulty": difficulty, "sample_index": start,
+                                 "rival": name, "status": status,
+                                 "demo_agreement": agreement[:3], "query_agreement": agreement[3:]})
+                    if name == "ignore_corner" and status == "query_ambiguous" and first is None:
+                        first = {"seed": seed, "difficulty": difficulty, "start": start,
+                                 "inputs": inputs, "labels": labels}
+    if first is None:
+        raise ValueError("The proposed corner-source lead was not reproduced")
+    cache = {}
+    with _local_imports(ROOT / "shared/runtime", source.parent):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            def execute(text, grid):
+                key = (text, raw(grid))
+                if key not in cache:
+                    cache[key] = _grid(apply(text, grid))
+                return cache[key]
+
+            def labeled_case(inputs, description):
+                gold = [execute(program, grid) for grid in inputs]
+                alternative = [execute(RIVAL_PROGRAM, grid) for grid in inputs]
+                if gold != [gen.rule_mirror(grid) for grid in inputs]:
+                    raise ValueError("Racket canonical labels differ from the Python screen")
+                if alternative != [rival(grid, "ignore_corner") for grid in inputs]:
+                    raise ValueError("Racket rival differs from independently stated Python rival")
+                if gold[:3] != alternative[:3]:
+                    raise ValueError("The rival was refuted by a demonstration")
+                failures = [i for i in range(3, len(inputs)) if gold[i] != alternative[i]]
+                if not failures:
+                    raise ValueError("No differing query")
+                query = failures[0]
+                return {"description": description,
+                        "train": [{"input": g, "output": y} for g, y in zip(inputs[:3], gold[:3])],
+                        "test": [{"input": inputs[query], "output": gold[query],
+                                  "rival_output": alternative[query]}],
+                        "query_index_within_four": query - 3,
+                        "program": program, "rival_program": RIVAL_PROGRAM,
+                        "demonstrations_fitted": 3, "different_query": True}
+
+            original = labeled_case(first["inputs"], {key: first[key] for key in
+                                                       ("seed", "difficulty", "start")})
+            minimum_inputs = [gen.generate(0, i, difficulty="easy", grid_h=6, grid_w=6,
+                                           n_pixels=3) for i in range(7)]
+            minimum = labeled_case(minimum_inputs, {
+                "seed": 0, "difficulty": "easy", "sample_index": 0,
+                "overrides": {"grid_h": 6, "grid_w": 6, "n_pixels": 3},
+                "minimization": "Smallest admitted canvas; retain all three distinct demonstrations and only the first failing query. No claim of globally minimal pixel count.",
+            })
+        finally:
+            bridge.close()
+    if hashlib.sha256(source.read_bytes()).hexdigest() != digest:
+        raise ValueError("Generator source changed during probe")
+    out.mkdir(parents=True)
+    (out / "witness.json").write_bytes(raw({
+        "schema": "arcpuzzles-corner-source-teaching-witness-v1", "task_id": TASK,
+        "source_sha256": digest, "racket": identity,
+        "default_episode": original, "small_admitted_episode": minimum,
+    }))
+    (out / "screen.json").write_bytes(raw(rows))
+    report = {"schema": "arcpuzzles-bounded-peer-adversarial-v1", "task_id": TASK,
+              "outcome": "teaching_counterexample", "source_sha256": digest,
+              "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "command": shlex.join([sys.executable, *sys.argv]), "episodes_screened_python": 27,
+              "demos": 3, "queries": 4, "rivals": {k: dict(v) for k, v in counts.items()},
+              "actual_racket_evaluations": len(cache), "racket": identity,
+              "finding": "A corner-ignoring cross rule fits all three visible demos at starts 0/1 and disagrees when sample index4 introduces a corner source.",
+              "recommendation": "Teach a corner source within visible demonstrations when later queries may use one; review an episode-level coverage contract or a shorter corner schedule.",
+              "generator_changed": False, "owner_acceptance": "not_performed", "training_admitted": False,
+              "limits": "27 Python-screened lessons and two protected-Racket-labeled witnesses; finite rivals only. Existing unresolved profile-floor, semantic-contract, authority-sync and portability findings were not replayed or resolved."}
+    (out / "report.json").write_bytes(raw(report))
+    print(json.dumps({"outcome": report["outcome"], "episodes": 27, "rivals": report["rivals"],
+                      "racket_evaluations": len(cache), "report": str(out / "report.json")}, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
