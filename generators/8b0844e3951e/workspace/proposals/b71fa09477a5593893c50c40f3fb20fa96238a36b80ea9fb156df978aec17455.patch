+"""Focused Python contract tests for the separate modal-row prototype.
+
+Protected-Racket label execution and native acceptance are separate gates.
+The literal fixtures here are hand-counted, not generated by the sampler.
+"""
+from __future__ import annotations
+
+from collections import Counter
+from functools import lru_cache
+import importlib.util
+from pathlib import Path
+import random
+import sys
+
+import pytest
+
+
+TASK_HOME = Path(__file__).resolve().parents[1]
+REPO = TASK_HOME.parents[1]
+PROTOTYPE_PATH = TASK_HOME / "workspace/parametric/prototype.py"
+
+CAUSAL_INPUT = [
+    [7, 2, 2, 3, 5],
+    [7, 2, 3, 3, 5],
+    [7, 7, 4, 4, 2],
+    [7, 2, 4, 5, 0],
+    [7, 3, 4, 0, 0],
+]
+
+ZERO_DOMINANT_INPUT = [
+    [0, 0, 0, 2, 8],
+    [0, 0, 2, 3, 3],
+    [2, 6, 6, 8, 3],
+    [0, 2, 8, 8, 3],
+    [0, 0, 2, 2, 6],
+]
+
+REQUIRED_RIVALS = {
+    "global_runner_up", "overall_mode", "first_row", "last_row",
+    "modal_column", "local_including_zero", "local_including_mode",
+    "rarest_nonzero", "min_color", "max_color", "first_nonzero",
+    "global", "modal_row",
+} | {f"constant_{color}" for color in range(1, 10)}
+
+
+@lru_cache(maxsize=None)
+def _load_source(path: Path, module_name: str):
+    assert path.is_file(), f"Required prototype source is missing: {path}"
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _prototype():
+    return _load_source(PROTOTYPE_PATH, "_test_modal_row_8b0844e3951e")
+
+
+def test_input_dependent_row_changes_answer_without_changing_global_counts():
+    """A histogram-only, fixed-row or global-runner-up solver must fail here."""
+    prototype = _prototype()
+    first = [row[:] for row in CAUSAL_INPUT]
+    moved = [row[:] for row in CAUSAL_INPUT]
+    moved[2][1], moved[0][3] = moved[0][3], moved[2][1]
+    assert Counter(v for row in first for v in row) == {
+        7: 6, 2: 5, 3: 4, 4: 4, 5: 3, 0: 3,
+    }
+    assert Counter(v for row in moved for v in row) == Counter(
+        v for row in first for v in row
+    )
+    for grid, expected_row, expected_local in ((first, 2, 4), (moved, 0, 2)):
+        facts = prototype.analyze(grid)
+        assert facts["global_mode"] == 7
+        assert facts["selected_row"] == expected_row
+        assert facts["local_mode"] == expected_local
+        rivals = prototype.rival_colors(grid)
+        assert rivals["global"] == 7
+        assert rivals["modal_row"] == expected_local
+    assert prototype.rival_colors(first)["global_runner_up"] == 2
+
+
+def test_zero_is_excluded_at_both_frequency_stages():
+    """Counting zero or retaining the global mode in the local pool is wrong."""
+    prototype = _prototype()
+    assert Counter(v for row in ZERO_DOMINANT_INPUT for v in row) == {
+        0: 8, 2: 6, 8: 4, 3: 4, 6: 3,
+    }
+    facts = prototype.analyze(ZERO_DOMINANT_INPUT)
+    assert facts["global_mode"] == 2
+    assert facts["selected_row"] == 4
+    assert facts["local_mode"] == 6
+    rivals = prototype.rival_colors(ZERO_DOMINANT_INPUT)
+    assert rivals["overall_mode"] == 0
+    assert rivals["local_including_zero"] == 0
+    assert rivals["local_including_mode"] == 2
+    assert rivals["modal_row"] == 6
+
+
+def test_row_reordering_tracks_selected_content_instead_of_fixed_index():
+    prototype = _prototype()
+    permuted = [CAUSAL_INPUT[i][:] for i in (2, 4, 1, 0, 3)]
+    facts = prototype.analyze(permuted)
+    assert facts["selected_row"] == 0
+    assert facts["global_mode"] == 7
+    assert facts["local_mode"] == 4
+
+
+def test_default_program_preserves_exact_catalog_authority():
+    from arcpuzzles import Catalog
+
+    prototype = _prototype()
+    canonical = Catalog(root=REPO).get("8b0844e3951e")
+    expected = canonical["variants"][0]["program_solution"]
+    assert prototype.program({"scope": "global"}) == expected
+    assert prototype.program({"scope": "modal_row"}) != expected
+
+
+@pytest.mark.parametrize("settings", [
+    None, "global", {}, {"scope": "unknown"}, {"scope": True},
+    {"scope": 1}, {"scope": "global", "extra": 1},
+])
+def test_unknown_or_malformed_settings_fail_closed(settings):
+    prototype = _prototype()
+    with pytest.raises((TypeError, ValueError)):
+        prototype.program(settings)
+    with pytest.raises((TypeError, ValueError)):
+        prototype.generate(seed=0, settings=settings, demos=3, queries=4)
+
+
+@pytest.mark.parametrize("field,value", [
+    ("seed", True), ("seed", False), ("seed", 1.0),
+    ("seed", "1"), ("seed", None),
+    ("demos", 1), ("demos", 7), ("demos", True), ("demos", 2.0),
+    ("demos", "2"), ("demos", None),
+    ("queries", 0), ("queries", 5), ("queries", True), ("queries", 1.0),
+    ("queries", "1"), ("queries", None),
+])
+def test_seed_and_count_contract_rejects_bool_and_invalid_requests(field, value):
+    args = {"seed": 0, "settings": {"scope": "global"}, "demos": 3, "queries": 4}
+    args[field] = value
+    with pytest.raises((TypeError, ValueError)):
+        _prototype().generate(**args)
+
+
+def _assert_episode_contract(episode, settings, demos, queries):
+    assert len(episode["train"]) == demos
+    assert len(episode["test"]) == queries
+    assert episode["program_solution"] == _prototype().program(settings)
+    inputs = []
+    for pair in episode["train"] + episode["test"]:
+        grid, output = pair["input"], pair["output"]
+        assert type(grid) is list and 3 <= len(grid) <= 30
+        width = len(grid[0])
+        assert 3 <= width <= 30
+        assert all(type(row) is list and len(row) == width for row in grid)
+        assert all(type(v) is int and 0 <= v <= 9 for row in grid for v in row)
+        assert type(output) is list and len(output) == len(grid)
+        assert all(type(row) is list and len(row) == width for row in output)
+        assert all(type(v) is int and 1 <= v <= 9 for row in output for v in row)
+        assert len({v for row in output for v in row}) == 1
+
+        # Independently check the admitted grammar; do not trust sampler metadata.
+        frequencies = Counter(v for row in grid for v in row if v)
+        ranked = frequencies.most_common()
+        assert len(ranked) >= 3 and ranked[0][1] > ranked[1][1]
+        global_color = ranked[0][0]
+        row_counts = [row.count(global_color) for row in grid]
+        assert row_counts.count(max(row_counts)) == 1
+        selected_row = row_counts.index(max(row_counts))
+        local_counts = Counter(v for v in grid[selected_row] if v not in (0, global_color))
+        assert local_counts
+        local_ranked = local_counts.most_common()
+        assert len(local_ranked) == 1 or local_ranked[0][1] > local_ranked[1][1]
+        expected = global_color if settings["scope"] == "global" else local_ranked[0][0]
+        assert output[0][0] == expected
+        inputs.append(tuple(tuple(row) for row in grid))
+    assert len(set(inputs)) == demos + queries
+
+
+@pytest.mark.parametrize("scope,demos,queries", [
+    ("global", 2, 1), ("modal_row", 2, 4),
+    ("global", 6, 4), ("modal_row", 6, 1),
+])
+def test_demo_and_query_count_boundaries_are_independent(scope, demos, queries):
+    settings = {"scope": scope}
+    episode = _prototype().generate(17, settings, demos, queries)
+    _assert_episode_contract(episode, settings, demos, queries)
+
+
+@pytest.mark.parametrize("scope", ["global", "modal_row"])
+@pytest.mark.parametrize("seed", [0, 17])
+def test_two_demonstrations_alone_reject_declared_shortcuts(seed, scope):
+    """No query labels are used to eliminate a plausible competing rule."""
+    prototype = _prototype()
+    episode = prototype.generate(seed, {"scope": scope}, 2, 4)
+    predictions = []
+    for pair in episode["train"]:
+        rivals = prototype.rival_colors(pair["input"])
+        assert REQUIRED_RIVALS <= set(rivals)
+        assert all(type(rivals[name]) is int and 0 <= rivals[name] <= 9 for name in REQUIRED_RIVALS)
+        predictions.append((rivals, pair["output"][0][0]))
+    survivors = {
+        name for name in REQUIRED_RIVALS
+        if all(rivals[name] == target for rivals, target in predictions)
+    }
+    assert survivors == {scope}
+
+
+def test_settings_share_inputs_and_query_count_does_not_change_first_turn():
+    prototype = _prototype()
+    global_episode = prototype.generate(17, {"scope": "global"}, 3, 4)
+    row_episode = prototype.generate(17, {"scope": "modal_row"}, 3, 4)
+    short_episode = prototype.generate(17, {"scope": "modal_row"}, 3, 1)
+    for split in ("train", "test"):
+        assert [p["input"] for p in global_episode[split]] == [p["input"] for p in row_episode[split]]
+    assert short_episode["train"] == row_episode["train"]
+    assert short_episode["test"] == row_episode["test"][:1]
+    assert any(a["output"] != b["output"] for a, b in zip(global_episode["train"], row_episode["train"]))
+
+
+@pytest.mark.parametrize("scope", ["global", "modal_row"])
+def test_fourth_query_uses_substantive_content_across_30_by_30_canvas(scope):
+    episode = _prototype().generate(17, {"scope": scope}, 3, 4)
+    grid = episode["test"][3]["input"]
+    assert len(grid) == 30 and all(len(row) == 30 for row in grid)
+    assert sum(v != 0 for row in grid for v in row) >= 180
+    for start_r, start_c in ((0, 0), (0, 15), (15, 0), (15, 15)):
+        values = [grid[r][c] for r in range(start_r, start_r + 15) for c in range(start_c, start_c + 15)]
+        assert sum(v != 0 for v in values) >= 20
+        assert len(set(values) - {0}) >= 3
+
+
+def test_generation_is_deterministic_fresh_and_global_rng_pure():
+    prototype = _prototype()
+    previous_state = random.getstate()
+    try:
+        random.seed(13051)
+        state = random.getstate()
+        first = prototype.generate(17, {"scope": "modal_row"}, 3, 4)
+        second = prototype.generate(17, {"scope": "modal_row"}, 3, 4)
+        assert random.getstate() == state
+        assert first == second
+        first["train"][0]["input"][0][0] = 99
+        assert second["train"][0]["input"][0][0] != 99
+        assert prototype.generate(17, {"scope": "modal_row"}, 3, 4) == second
+    finally:
+        random.setstate(previous_state)
+
+
+@pytest.mark.parametrize("kind", [
+    "empty", "ragged", "bool", "float", "color_out_of_range",
+    "global_tie", "row_tie", "local_tie", "empty_local_pool",
+])
+def test_analysis_rejects_malformed_or_underidentified_inputs(kind):
+    grid = [row[:] for row in CAUSAL_INPUT]
+    if kind == "empty":
+        grid = []
+    elif kind == "ragged":
+        grid[0].pop()
+    elif kind == "bool":
+        grid[0][0] = True
+    elif kind == "float":
+        grid[0][0] = 7.0
+    elif kind == "color_out_of_range":
+        grid[0][0] = 10
+    elif kind == "global_tie":
+        grid = [[1, 1, 2], [2, 3, 4], [5, 0, 0]]
+    elif kind == "row_tie":
+        grid[3][0], grid[0][4] = grid[0][4], grid[3][0]
+    elif kind == "local_tie":
+        grid[2] = [7, 7, 4, 3, 2]
+    elif kind == "empty_local_pool":
+        grid[2] = [7, 7, 7, 7, 7]
+    with pytest.raises((TypeError, ValueError)):
+        _prototype().analyze(grid)
