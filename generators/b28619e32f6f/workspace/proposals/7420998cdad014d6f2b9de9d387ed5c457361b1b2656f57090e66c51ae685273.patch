+"""Behavioral tests for the opt-in island/area family (not canonical repairs)."""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import random
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+
+
+def load_adapter():
+    path = HOME / "workspace/parametric/adapter.py"
+    assert path.is_file(), "Native island-policy adapter has not been built"
+    spec = importlib.util.spec_from_file_location("_test_b286_adapter", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def framed(inner):
+    """A red frame touching top/left and an exterior bottom/right corridor."""
+    w = len(inner[0]) + 2
+    return [[2] * w + [0], *[[2, *row, 2, 0] for row in inner],
+            [2] * w + [0], [0] * (w + 1)]
+
+
+def test_island_absorption_recomputes_thresholds():
+    a = load_adapter()
+    for side, old_color, new_color in ((3, 8, 4), (5, 4, 3)):
+        inner = [[0] * side for _ in range(side)]
+        inner[side // 2][side // 2] = 2
+        grid = framed(inner)
+        keep = a.prototype.solve(grid, "keep")
+        absorb = a.prototype.solve(grid, "absorb")
+        assert keep[1][1] == old_color
+        assert keep[side // 2 + 1][side // 2 + 1] == 2
+        assert absorb == framed([[new_color] * side for _ in range(side)])
+
+
+def test_absorption_merges_four_pockets_before_measuring_area():
+    a = load_adapter()
+    inner = [[2 if r == c or r + c == 4 else 0 for c in range(5)] for r in range(5)]
+    grid = framed(inner)
+    expected_inner = [[2 if (r, c) in {(0, 0), (0, 4), (4, 0), (4, 4)} else 4
+                       for c in range(5)] for r in range(5)]
+    assert a.prototype.solve(grid, "absorb") == framed(expected_inner)
+    assert a.prototype.solve(grid, "keep") == framed(
+        [[8 if value == 0 else 2 for value in row] for row in inner])
+
+
+def test_singletons_use_four_neighbors_and_leave_dominoes():
+    a = load_adapter()
+    inner = [[0] * 5 for _ in range(5)]
+    inner[0][0] = inner[1][1] = 2  # diagonal contact is not 4-connection
+    got = a.prototype.solve(framed(inner), "absorb")
+    assert got[1][1] == 2 and got[2][2] == 4
+    inner = [[0] * 5 for _ in range(5)]
+    inner[2][2] = inner[2][3] = 2
+    got = a.prototype.solve(framed(inner), "absorb")
+    assert got[3][3:5] == [2, 2]
+    assert got[1][1] == 4
+
+
+def test_counts_matched_inputs_rng_purity_and_query_prefix():
+    a = load_adapter()
+    random.seed(713)
+    before = random.getstate()
+    for demos in range(2, 7):
+        keep = a.generate(17, {"island_policy": "keep"}, demos, 4)
+        absorb = a.generate(17, {"island_policy": "absorb"}, demos, 4)
+        assert len(keep["train"]) == demos and len(keep["test"]) == 4
+        assert [p["input"] for p in keep["train"] + keep["test"]] == [
+            p["input"] for p in absorb["train"] + absorb["test"]]
+        inputs = [json.dumps(p["input"]) for p in keep["train"] + keep["test"]]
+        assert len(set(inputs)) == len(inputs)
+        assert keep["program_solution"] == a.program({"island_policy": "keep"})
+        single = a.generate(17, {"island_policy": "keep"}, demos, 1)
+        assert single["train"] == keep["train"] and single["test"] == keep["test"][:1]
+        assert any(x["output"] != y["output"] for x, y in zip(keep["train"], absorb["train"]))
+    assert random.getstate() == before
+    repeat = a.generate(17, {"island_policy": "keep"}, 3, 4)
+    saved = copy.deepcopy(repeat)
+    repeat["train"][0]["input"][0][0] = 9
+    assert a.generate(17, {"island_policy": "keep"}, 3, 4) == saved
+
+
+def test_two_demos_teach_boundaries_and_declared_shortcuts():
+    a = load_adapter()
+    for seed in (0, 17, 91):
+        for policy in ("keep", "absorb"):
+            ep = a.generate(seed, {"island_policy": policy}, 2, 4)
+            assert a.prototype.teaching_failures(ep["train"], ep["test"], policy) == []
+            areas = {len(region) for p in ep["train"]
+                     for region in a.prototype.regions(p["input"]) if not a.prototype.exterior(p["input"], region)}
+            assert {7, 8, 9, 23, 24, 25} <= areas
+
+
+def test_stress_is_substantive_and_small_profile_is_reachable():
+    a = load_adapter()
+    small = a.generate(0, {"island_policy": "absorb"}, 2, 4)["test"][0]["input"]
+    assert (len(small), len(small[0])) == (4, 4)
+    for seed in (0, 17, 91):
+        stress = a.generate(seed, {"island_policy": "absorb"}, 2, 4)["test"][-1]["input"]
+        assert (len(stress), len(stress[0])) == (30, 30)
+        changed = sum(x != y for row, out in zip(stress, a.prototype.solve(stress, "absorb"))
+                      for x, y in zip(row, out))
+        assert changed >= 200
+        assert all(any(stress[r][c] == 2 for r in range(r0, r0 + 15) for c in range(c0, c0 + 15))
+                   for r0 in (0, 15) for c0 in (0, 15))
+
+
+@pytest.mark.parametrize("field,value", [("demos", 1), ("demos", 7), ("demos", True),
+    ("queries", 0), ("queries", 5), ("queries", 1.0), ("seed", -1), ("seed", True)])
+def test_invalid_counts_and_seed_are_rejected(field, value):
+    a = load_adapter()
+    args = {"seed": 0, "settings": {"island_policy": "keep"}, "demos": 3, "queries": 4}
+    args[field] = value
+    with pytest.raises(ValueError):
+        a.generate(**args)
+
+
+@pytest.mark.parametrize("settings", [{}, {"island_policy": "other"},
+    {"island_policy": "keep", "unknown": 1}, {"island_policy": True}, None])
+def test_invalid_settings_are_rejected(settings):
+    with pytest.raises(ValueError):
+        load_adapter().program(settings)
