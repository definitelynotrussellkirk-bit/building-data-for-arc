+"""Thin exact-path native adapter for the recolor-scope family."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+from pathlib import Path
+import sys
+
+_path = Path(__file__).resolve().with_name("native.py")
+_name = "_native_69cab6228fdc_" + hashlib.sha256(str(_path).encode()).hexdigest()
+_spec = importlib.util.spec_from_file_location(_name, _path)
+if _spec is None or _spec.loader is None:
+    raise ImportError(_path)
+_native = importlib.util.module_from_spec(_spec)
+sys.modules[_name] = _native
+_spec.loader.exec_module(_native)
+
+program = _native.program
+generate = _native.generate
+analyze = _native.analyze
+transform = _native.transform
+public_turn = _native.public_turn
+rival_program = _native.rival_program
+rival_transform = _native.rival_transform
+RIVALS = _native.RIVALS
diff --git a/repo/generators/69cab6228fdc/workspace/parametric/audit.py b/repo/generators/69cab6228fdc/workspace/parametric/audit.py
