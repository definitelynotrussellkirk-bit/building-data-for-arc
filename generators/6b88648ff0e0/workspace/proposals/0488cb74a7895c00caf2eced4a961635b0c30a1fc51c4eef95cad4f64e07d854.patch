+"""Native adapter contract and boundary regressions for 6b88648ff0e0."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+from arcpuzzles import Catalog
+from reviewer_support import find_root
+
+TASK_ID = "6b88648ff0e0"
+ROOT = find_root(__file__)
+HOME = ROOT / "generators" / TASK_ID / "workspace" / "parametric"
+
+
+def load_adapter():
+    path = HOME / "adapter.py"
+    assert path.is_file(), "native adapter is missing"
+    spec = importlib.util.spec_from_file_location("native_6b88648ff0e0_test", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_default_program_is_exact_selected_canonical_source():
+    module = load_adapter()
+    programs = {row["program_solution"] for row in Catalog(ROOT).get(TASK_ID)["variants"]}
+    assert programs == {module.program({"stack_order": "top_to_bottom"})}
+    assert module.program({"stack_order": "bottom_to_top"}) not in programs
+
+
+def test_settings_share_inputs_and_reverse_whole_strips_only():
+    module = load_adapter()
+    canonical = module.generate(17, {"stack_order": "top_to_bottom"}, 3, 4)
+    reverse = module.generate(17, {"stack_order": "bottom_to_top"}, 3, 4)
+    for split in ("train", "test"):
+        assert [pair["input"] for pair in canonical[split]] == [pair["input"] for pair in reverse[split]]
+    for left, right in zip(canonical["train"], reverse["train"], strict=True):
+        blocks = [left["output"][index:index + 2] for index in range(0, len(left["output"]), 2)]
+        assert right["output"] == [row for block in reversed(blocks) for row in block]
+        assert left["output"] != right["output"]
+
+
+def test_counts_are_prefix_stable_and_fourth_query_is_substantive_30x30():
+    module = load_adapter()
+    settings = {"stack_order": "bottom_to_top"}
+    small = module.generate(91, settings, 2, 1)
+    large = module.generate(91, settings, 6, 4)
+    assert small["train"] == large["train"][:2]
+    assert small["test"] == large["test"][:1]
+    assert len({repr(pair["input"]) for pair in large["train"] + large["test"]}) == 10
+    stress = large["test"][3]["input"]
+    assert (len(stress), len(stress[0])) == (30, 30)
+    assert sum(cell != 0 for row in stress for cell in row) >= 300
+    facts = module.analyze(stress)
+    assert facts["group_count"] == 4
+    assert facts["content_width"] == 7
+
+
+def test_public_turn_reveals_one_query_and_no_private_fields():
+    module = load_adapter()
+    episode = module.generate(3, {"stack_order": "top_to_bottom"}, 2, 4)
+    visible = module.public_turn(episode, 0)
+    assert set(visible) == {"train", "test"}
+    assert len(visible["test"]) == 1
+    assert set(visible["test"][0]) == {"input"}
+    assert visible["test"][0]["input"] == episode["test"][0]["input"]
+    assert "program_solution" not in visible
+
+
+def test_invalid_typed_requests_fail_closed():
+    module = load_adapter()
+    with pytest.raises(ValueError):
+        module.generate(True, {"stack_order": "top_to_bottom"}, 2, 4)
+    with pytest.raises(ValueError):
+        module.generate(0, {"stack_order": "sideways"}, 2, 4)
+    with pytest.raises(ValueError):
+        module.generate(0, {"stack_order": "top_to_bottom"}, 1, 4)
+    with pytest.raises(ValueError):
+        module.generate(0, {"stack_order": "top_to_bottom"}, 2, 5)
