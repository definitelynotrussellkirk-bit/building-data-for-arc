+"""Native stack-order family for ARC task 6b88648ff0e0."""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+from pathlib import Path
+import random
+from typing import Any
+
+HOME = Path(__file__).resolve().parent
+SETTINGS = ("top_to_bottom", "bottom_to_top")
+RIVALS = ("reverse_all_rows", "first_group_only", "last_group_only")
+DEMO_PROFILES = (
+    (12, 14, 2, 3),
+    (16, 18, 3, 4),
+    (20, 22, 4, 5),
+    (14, 20, 2, 6),
+    (22, 24, 3, 7),
+    (26, 28, 4, 4),
+)
+QUERY_PROFILES = (
+    (13, 16, 2, 5),
+    (19, 23, 3, 6),
+    (27, 29, 4, 3),
+    (30, 30, 4, 7),
+)
+NON_CYAN = (0, 1, 2, 3, 4, 5, 6, 7, 9)
+
+
+def _read_exact(name: str) -> str:
+    value = (HOME / name).read_text(encoding="utf-8")
+    if not value.strip():
+        raise ValueError(f"empty Racket source: {name}")
+    return value
+
+
+CANONICAL_PROGRAM = _read_exact("canonical.rkt")
+BOTTOM_TO_TOP_PROGRAM = _read_exact("bottom_to_top.rkt")
+
+
+def _setting(settings: Any) -> str:
+    if type(settings) is not dict or set(settings) != {"stack_order"}:
+        raise ValueError("settings must contain exactly stack_order")
+    value = settings["stack_order"]
+    if type(value) is not str or value not in SETTINGS:
+        raise ValueError(f"stack_order must be one of {SETTINGS}")
+    return value
+
+
+def program(settings: Any) -> str:
+    return CANONICAL_PROGRAM if _setting(settings) == "top_to_bottom" else BOTTOM_TO_TOP_PROGRAM
+
+
+def _integer(name: str, value: Any, low: int, high: int) -> int:
+    if type(value) is not int or not low <= value <= high:
+        raise ValueError(f"{name} must be an integer in {low}..{high}; bool is forbidden")
+    return value
+
+
+def _validate_grid(grid: Any) -> tuple[int, int]:
+    if type(grid) is not list or not 8 <= len(grid) <= 30 or type(grid[0]) is not list:
+        raise ValueError("grid must have 8..30 rows")
+    width = len(grid[0])
+    if not 8 <= width <= 30:
+        raise ValueError("grid must have 8..30 columns")
+    if any(
+        type(row) is not list
+        or len(row) != width
+        or any(type(cell) is not int or not 0 <= cell <= 9 for cell in row)
+        for row in grid
+    ):
+        raise ValueError("grid must be rectangular with exact integer colors 0..9")
+    return len(grid), width
+
+
+def analyze(grid: Any) -> dict[str, Any]:
+    height, width = _validate_grid(grid)
+    by_row: dict[int, list[int]] = {}
+    for row in range(height - 1):
+        for col in range(width - 1):
+            if all(grid[r][c] == 8 for r in (row, row + 1) for c in (col, col + 1)):
+                by_row.setdefault(row, []).append(col)
+    if not 1 <= len(by_row) <= 4:
+        raise ValueError("expected one through four marker groups")
+    groups = []
+    marker_cells: set[tuple[int, int]] = set()
+    widths: set[int] = set()
+    for top in sorted(by_row):
+        cols = sorted(by_row[top])
+        if len(cols) != 2:
+            raise ValueError("each marker row must contain exactly two 2x2 cyan blocks")
+        left, right = cols
+        content_width = right - left - 2
+        if not 3 <= content_width <= 7:
+            raise ValueError("marker pairs must enclose three through seven columns")
+        widths.add(content_width)
+        for start in (left, right):
+            marker_cells.update((r, c) for r in (top, top + 1) for c in (start, start + 1))
+        groups.append({"top": top, "left": left, "right": right, "content_width": content_width})
+    if len(widths) != 1:
+        raise ValueError("all marker groups must have one shared content width")
+    cyan = {(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 8}
+    if cyan != marker_cells:
+        raise ValueError("cyan may occur only in the exact marker blocks")
+    if any(b["top"] - a["top"] < 3 for a, b in zip(groups, groups[1:], strict=False)):
+        raise ValueError("marker groups must be vertically separated")
+    strips = [
+        [list(grid[row][group["left"] + 2:group["right"]]) for row in (group["top"], group["top"] + 1)]
+        for group in groups
+    ]
+    return {
+        "height": height,
+        "width": width,
+        "group_count": len(groups),
+        "content_width": next(iter(widths)),
+        "groups": groups,
+        "strips": strips,
+    }
+
+
+def transform(grid: Any, stack_order: str) -> list[list[int]]:
+    if type(stack_order) is not str or stack_order not in SETTINGS:
+        raise ValueError(f"stack_order must be one of {SETTINGS}")
+    strips = analyze(grid)["strips"]
+    if stack_order == "bottom_to_top":
+        strips = list(reversed(strips))
+    return [row[:] for strip in strips for row in strip]
+
+
+def rival_transform(grid: Any, name: str) -> list[list[int]]:
+    if name not in RIVALS:
+        raise ValueError(f"unknown rival: {name}")
+    strips = analyze(grid)["strips"]
+    if name == "reverse_all_rows":
+        return [row[:] for row in reversed([row for strip in strips for row in strip])]
+    chosen = strips[0] if name == "first_group_only" else strips[-1]
+    return [row[:] for row in chosen]
+
+
+def rival_program(name: str) -> str:
+    if name not in RIVALS:
+        raise ValueError(f"unknown rival: {name}")
+    anchor = "(all-rows (apply append strips))"
+    if CANONICAL_PROGRAM.count(anchor) != 1:
+        raise ValueError("canonical all-rows anchor changed")
+    replacement = {
+        "reverse_all_rows": "(all-rows (reverse (apply append strips)))",
+        "first_group_only": "(all-rows (first strips))",
+        "last_group_only": "(all-rows (first (reverse strips)))",
+    }[name]
+    return CANONICAL_PROGRAM.replace(anchor, replacement)
+
+
+def _rng(seed: int, split: str, index: int, label: str) -> random.Random:
+    raw = f"6b88648ff0e0|{seed}|{split}|{index}|{label}".encode()
+    return random.Random(int.from_bytes(hashlib.sha256(raw).digest()[:16], "big"))
+
+
+def _tops(height: int, count: int) -> list[int]:
+    if count == 1:
+        return [(height - 2) // 2]
+    tops = [round(index * (height - 2) / (count - 1)) for index in range(count)]
+    if any(right - left < 3 for left, right in zip(tops, tops[1:], strict=False)):
+        raise ValueError("profile cannot separate marker groups")
+    return tops
+
+
+def _make_input(seed: int, split: str, index: int) -> list[list[int]]:
+    profiles = DEMO_PROFILES if split == "train" else QUERY_PROFILES
+    height, width, group_count, content_width = profiles[index]
+    noise = _rng(seed, split, index, "noise")
+    grid = [[noise.choice(NON_CYAN) for _ in range(width)] for _ in range(height)]
+    max_left = width - content_width - 4
+    layouts: list[tuple[int, int, int]] = []
+    for group_index, top in enumerate(_tops(height, group_count)):
+        if split == "test" and index == 3:
+            left = 0 if group_index % 2 == 0 else max_left
+        else:
+            left = _rng(seed, split, index, f"left:{group_index}").randint(0, max_left)
+        right = left + content_width + 2
+        layouts.append((top, left, right))
+        for row_offset, row in enumerate((top, top + 1)):
+            for col_offset, col in enumerate(range(left + 2, right)):
+                signature = (seed + 3 * index + 5 * group_index + 2 * row_offset + col_offset) % len(NON_CYAN)
+                grid[row][col] = NON_CYAN[signature]
+        # Force visible group identity and within-strip row order.
+        grid[top][left + 2] = (2 * group_index + 1) % 8
+        grid[top + 1][left + 2] = (2 * group_index + 2) % 8
+    for top, left, right in layouts:
+        for row in (top, top + 1):
+            for start in (left, right):
+                grid[row][start] = 8
+                grid[row][start + 1] = 8
+    facts = analyze(grid)
+    if facts["group_count"] != group_count or facts["content_width"] != content_width:
+        raise AssertionError("constructed marker geometry changed")
+    return grid
+
+
+def generate(seed: Any, settings: Any, demos: Any, queries: Any) -> dict[str, Any]:
+    _integer("seed", seed, 0, 2**63 - 1)
+    _integer("demos", demos, 2, 6)
+    _integer("queries", queries, 1, 4)
+    stack_order = _setting(settings)
+    train_inputs = [_make_input(seed, "train", index) for index in range(demos)]
+    test_inputs = [_make_input(seed, "test", index) for index in range(queries)]
+    all_inputs = train_inputs + test_inputs
+    if len({repr(grid) for grid in all_inputs}) != len(all_inputs):
+        raise AssertionError("generated inputs must be distinct")
+
+    def pair(grid: list[list[int]]) -> dict[str, list[list[int]]]:
+        return {"input": deepcopy(grid), "output": transform(grid, stack_order)}
+
+    return {
+        "train": [pair(grid) for grid in train_inputs],
+        "test": [pair(grid) for grid in test_inputs],
+        "program_solution": program(settings),
+    }
+
+
+def public_turn(episode: Any, query_index: Any) -> dict[str, Any]:
+    if type(query_index) is not int or type(episode) is not dict:
+        raise ValueError("query_index must be an exact integer")
+    train, test = episode.get("train"), episode.get("test")
+    if type(train) is not list or type(test) is not list or not 0 <= query_index < len(test):
+        raise ValueError("query_index is outside the available queries")
+    try:
+        return {
+            "train": [{"input": deepcopy(pair["input"]), "output": deepcopy(pair["output"])} for pair in train],
+            "test": [{"input": deepcopy(test[query_index]["input"])}],
+        }
+    except (KeyError, TypeError) as error:
+        raise ValueError("episode pairs are malformed") from error
