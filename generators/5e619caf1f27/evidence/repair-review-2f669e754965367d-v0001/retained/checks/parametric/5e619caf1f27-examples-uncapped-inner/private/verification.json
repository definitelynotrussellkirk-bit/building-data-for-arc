      "text": "(rule! (lambda (g)\n  (let* ((h (rows g))\n         (w (cols g))\n         ;; The non-zero bounding box is the original outer rectangle.\n         (cells (positions-of g (lambda (v) (!= v 0))))\n         (bb (bbox-of-cells cells))\n         (r1 (first bb))\n         (c1 (second bb))\n         (r2 (third bb))\n         (c2 (fourth bb))\n         (outer (at g r1 c1))\n         ;; The other non-zero color forms the solid inner rectangle.\n         (inner-cells\n           (filter (lambda (p)\n             (!= (at g (first p) (second p)) outer))\n             cells))\n         (ibb (bbox-of-cells inner-cells))\n         (ir1 (first ibb))\n         (ic1 (second ibb))\n         (ir2 (third ibb))\n         (ic2 (fourth ibb))\n         (inner (at g ir1 ic1))\n         (inner-h (+ 1 (- ir2 ir1)))\n         (inner-w (+ 1 (- ic2 ic1)))\n         ;; Expand uniformly, capped by both inner size and every grid edge.\n         (thick (min inner-h inner-w r1 c1\n                     (- (- h 1) r2) (- (- w 1) c2)))\n         (nr1 (- r1 thick))\n         (nc1 (- c1 thick))\n         (nr2 (+ r2 thick))\n         (nc2 (+ c2 thick)))\n    (cellmap g\n      (r c v)\n      (if (and (>= r nr1) (<= r nr2)\n               (>= c nc1) (<= c nc2)\n               (not (and (>= r r1) (<= r r2)\n                         (>= c c1) (<= c c2))))\n          inner\n          v)))))"
    },
    "uncapped_inner": {
