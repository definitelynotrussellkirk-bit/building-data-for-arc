+"""Bounded source-bound audit of corner-conditioned D4 teaching evidence."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        parser.error("choose a new evidence path")
+    root = Path(__file__).resolve().parents[3]
+    sys.path[:0] = [str(root / "src"), str(root / "shared/runtime")]
+    from arcpuzzles.catalog import Catalog
+    from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+    from reviewer_support import load_selected_generator
+
+    tid = "ec1c917f8de0"
+    catalog = Catalog(root)
+    row = catalog.describe(tid)
+    canonical = catalog._variants()[row.get("rule_task_id", tid)][0]
+    program = canonical["program_solution"]
+    generator, source, source_hash = load_selected_generator(tid, root=root)
+    transforms = {"identity": "obj", "cw": "(rotate-cw obj)", "180": "(rotate-180 obj)",
+                  "ccw": "(rotate-cw (rotate-180 obj))", "lr": "(flip-lr obj)",
+                  "cw_lr": "(rotate-cw (flip-lr obj))", "180_lr": "(rotate-180 (flip-lr obj))",
+                  "ccw_lr": "(rotate-cw (rotate-180 (flip-lr obj)))"}
+    original = {"TL": "identity", "TR": "cw", "BL": "lr", "BR": "180"}
+    conditions = {"TL": "((and (= (first marker) 0) (= (second marker) 0)) ",
+                  "TR": "((and (= (first marker) 0) (= (second marker) (- w 1))) ",
+                  "BL": "((and (= (first marker) (- h 1)) (= (second marker) 0)) ", "BR": "(else "}
+    rivals = {}
+    for corner, intended in original.items():
+        old_action = "obj" if corner == "TL" else f"(crop-nz {transforms[intended]})"
+        old = conditions[corner] + old_action + ")"
+        if program.count(old) != 1:
+            raise ValueError("canonical branch syntax changed; review the audit before rerunning")
+        for name, expression in transforms.items():
+            if name != intended:
+                rivals[corner + ":" + name] = program.replace(old, conditions[corner] + f"(crop-nz {expression}))")
+    report = {"schema": "ec1c917f8de0-d4-teaching-audit-v1", "task_id": tid,
+              "source_binding": {"generator_path": source.relative_to(root).as_posix(),
+                  "generator_sha256": source_hash, "rule_hash": row["rule_hash"],
+                  "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+                  "audit_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()},
+              "command": [sys.executable, *sys.argv], "canonical_program": program,
+              "rivals": {name: {"program": text, "sha256": hashlib.sha256(text.encode()).hexdigest()}
+                         for name, text in rivals.items()}, "generated_lessons": [], "findings": [],
+              "limits": "Two seeds, medium difficulty, aligned four-demo lessons and four queries; 28 one-branch D4 alternatives only. No universal uniqueness, non-D4 shortcut audit, generator approval, or training admission."}
+    evaluations = 0
+    with _local_imports(root / "shared/runtime", root / "shared/runtime"):
+        apply, identity, bridge = _real_evaluator(root / "shared/runtime")
+        report["racket"] = identity
+        cache = {}
+
+        def execute(text, grid):
+            nonlocal evaluations
+            key = (text, json.dumps(grid))
+            if key not in cache:
+                evaluations += 1
+                cache[key] = _grid(apply(text, _grid(grid)))
+            return cache[key]
+
+        try:
+            pairs = canonical["train"] + canonical["test"]
+            for pair in pairs:
+                if execute(program, pair["input"]) != pair["output"]:
+                    raise ValueError("canonical stored label differs from protected Racket")
+            counterfactual = rivals["BR:identity"]
+            matches = [execute(counterfactual, pair["input"]) == pair["output"] for pair in canonical["train"]]
+            query = canonical["test"][0]
+            alternative = execute(counterfactual, query["input"])
+            report["canonical_omitted_branch_witness"] = {
+                "status": "inherited_canonical_teaching_limit",
+                "description": "Canonical demonstrations omit BR; BR identity fits all three but disagrees on the canonical query. Current generated four-corner lessons are audited separately.",
+                "rival": "BR:identity", "demo_matches": matches,
+                "train": canonical["train"], "query_input": query["input"],
+                "canonical_output": query["output"], "rival_output": alternative,
+                "query_differs": alternative != query["output"]}
+            if not all(matches) or alternative == query["output"]:
+                raise ValueError("expected canonical omitted-branch witness was not reproduced")
+            for seed in (0, 17):
+                inputs = [generator.generate(seed, index, difficulty="medium") for index in range(8)]
+                labeled = [{"input": grid, "output": execute(program, grid)} for grid in inputs]
+                demos, queries = labeled[:4], labeled[4:]
+                lesson = {"seed": seed, "difficulty": "medium", "demos": 4, "queries": 4,
+                          "train": demos, "test": queries, "demo_only_rival_fits": {}, "findings": []}
+                for pair in labeled:
+                    if pair["output"] != generator.rule_mirror(pair["input"]):
+                        lesson["findings"].append("Python mirror disagrees with protected Racket")
+                lesson["lesson_identifiable"] = [generator.lesson_identifiable(demos, query) for query in queries]
+                for name, text in rivals.items():
+                    fits = [execute(text, pair["input"]) == pair["output"] for pair in demos]
+                    lesson["demo_only_rival_fits"][name] = fits
+                    if all(fits):
+                        differences = [execute(text, query["input"]) != query["output"] for query in queries]
+                        if any(differences):
+                            lesson["findings"].append({"rival": name, "query_disagreements": differences})
+                lesson["surviving_rivals"] = [name for name, fits in lesson["demo_only_rival_fits"].items() if all(fits)]
+                if any(lesson["lesson_identifiable"]):
+                    lesson["findings"].append("generator lesson_identifiable rejected a query")
+                report["generated_lessons"].append(lesson)
+                report["findings"].extend({"seed": seed, "finding": finding} for finding in lesson["findings"])
+        finally:
+            bridge.close()
+    if hashlib.sha256(source.read_bytes()).hexdigest() != source_hash:
+        raise ValueError("generator changed during audit")
+    report.update(status="finding" if report["findings"] else "bounded_no_current_generated_finding",
+                  racket_evaluations=evaluations, training_admitted=False,
+                  owner_next_action="Retain the four-corner demonstration requirement; this bounded audit alone does not establish reviewed_safe or justify reducing demo count.")
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n")
+    print(json.dumps({"status": report["status"], "generated_lessons": len(report["generated_lessons"]),
+                      "rivals_per_lesson": len(rivals), "racket_evaluations": evaluations,
+                      "output": str(args.out), "findings": report["findings"]}))
+    return 1 if report["findings"] else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
