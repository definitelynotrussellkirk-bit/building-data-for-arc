+"""Replay one finite outer/inner-swap ambiguity through protected Racket.
+
+Run from the packet root:
+WORK/.venv/bin/python review.py run python3 \
+  generators/f7c6c7bbc781/workspace/review_learnability.py \
+  --out ../checks/f7c6c7bbc781/learnability.json
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+
+TASK = "f7c6c7bbc781"
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def _sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    helper_path = ROOT / "shared/runtime/reviewer_support.py"
+    spec = importlib.util.spec_from_file_location("selected_peer_support", helper_path)
+    helper = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(helper)
+    generator, source, source_sha = helper.load_selected_generator(TASK, root=ROOT)
+    canonical = Catalog(ROOT)._variants()[TASK][0]["program_solution"]
+    fragment = "(nth colors (- max-d d))"
+    assert canonical.count(fragment) == 1
+    rival = canonical.replace(
+        fragment,
+        "(nth colors (if (= d 0) max-d (if (= d max-d) 0 d)))",
+    )
+
+    # This is a lawful directly assembled lesson, not a measured export census.
+    grids = [generator.generate(2, index, difficulty="easy") for index in range(4)]
+    repair = generator.generate(2, 4, difficulty="easy", grid_h=8, grid_w=8)
+    assert all(not generator.self_check(grid) for grid in grids + [repair])
+    assert all(repair != grid for grid in grids)
+    counts = [min(len(grid), len(grid[0])) // 2 for grid in grids]
+    assert counts == [3, 2, 2, 4]
+    records = []
+    runtime = ROOT / "shared/runtime"
+    with _local_imports(runtime, runtime):
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            for index, grid in enumerate(grids + [repair]):
+                intended = _grid(apply(canonical, grid))
+                alternative = _grid(apply(rival, grid))
+                assert intended == generator.rule_mirror(grid)
+                records.append({
+                    "role": "demo" if index < 3 else "query" if index == 3 else "replacement_demo",
+                    "sample_index": index,
+                    "overrides": {"grid_h": 8, "grid_w": 8} if index == 4 else {},
+                    "input": grid,
+                    "canonical_output": intended,
+                    "rival_output": alternative,
+                    "outputs_equal": intended == alternative,
+                })
+        finally:
+            bridge.close()
+    assert all(record["outputs_equal"] for record in records[:3])
+    assert records[3]["outputs_equal"] is False
+    assert records[4]["outputs_equal"] is False
+    report = {
+        "schema": "arcpuzzles-peer-learnability-audit-v1",
+        "task_id": TASK,
+        "outcome": "unchanged",
+        "finding": "outer_inner_only_rival_survives_three_easy_demos",
+        "generator_source": source.relative_to(ROOT).as_posix(),
+        "generator_sha256": source_sha,
+        "generator_version": generator.VERSION,
+        "canonical_rule_hash": generator.RULE_HASH,
+        "canonical_program_sha256": _sha(canonical.encode()),
+        "rival_program_sha256": _sha(rival.encode()),
+        "audit_source_sha256": _sha(Path(__file__).read_bytes()),
+        "canonical_program": canonical,
+        "rival_program": rival,
+        "rival_description": "Exchange only the outermost and innermost ring colors; retain every other ring.",
+        "seed": 2,
+        "difficulty": "easy",
+        "assembly": "Consecutive generator samples 0,1,2 are demonstrations; sample3 is the query.",
+        "ring_counts": counts,
+        "racket": identity,
+        "evaluations": 10,
+        "cases": records,
+        "original_rival_survives_demos": True,
+        "original_rival_changes_query": True,
+        "proposed_same_count_repair": {
+            "demo_sample_indices": [0, 1, 4],
+            "query_sample_index": 3,
+            "rival_survives_demos": False,
+            "status": "Racket-labeled teaching proposal; production assembly unchanged",
+        },
+        "limits": [
+            "One lawful assembled lesson and one rival; no production-lesson prevalence estimate.",
+            "Replacement demonstration refutes this rival only, not every possible ARC interpretation.",
+            "Canonical generator, task tests, authority, approval and lesson assembly were not modified.",
+            "Existing task-test portability finding was inspected statically but not re-executed.",
+        ],
+    }
+    assert _sha(source.read_bytes()) == source_sha
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"out": str(args.out), "finding": report["finding"],
+                      "protected": identity["protected"], "evaluations": 10,
+                      "original_demo_matches": 3, "query_disagrees": True,
+                      "same_count_replacement_refutes": True}))
+
+
+if __name__ == "__main__":
+    main()
