+
+TASK = "c53c24435976"
+ROOT = find_root(__file__)
+SOURCE = ROOT / "generators" / TASK / "generator.py"
+SPEC = importlib.util.spec_from_file_location("c53c24435976_peer_under_test", SOURCE)
+assert SPEC and SPEC.loader
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
+
+
+def _manual(code: int, cells: list[tuple[int, int]], color: int = 6) -> list[list[int]]:
+    grid = [[0] * 8 for _ in range(8)]
+    grid[0][0] = code
+    for row, col in cells:
+        grid[row + 2][col + 2] = color
+    return grid
+
+
+def test_code_override_is_honored_and_rejects_nonintegers():
+    for code in range(1, 5):
+        grid = GEN.generate(0, 0, code=code)
+        assert grid[0][0] == code
+        assert GEN.self_check(grid) == []
+    for bad in (True, 1.0, "1", 0, 5):
+        with pytest.raises((TypeError, ValueError)):
+            GEN.generate(0, 0, code=bad)
+
+
+def test_constant_transform_shortcut_is_declared_and_rejected_by_lesson_check():
+    shapes = [
+        [(0, 0), (1, 0), (2, 0), (2, 1)],
+        [(0, 0), (0, 1), (1, 0), (2, 0), (2, 1)],
+        [(0, 0), (1, 0), (1, 1), (1, 2), (2, 2)],
+        [(0, 0), (0, 1), (0, 2), (1, 0), (2, 0), (2, 1)],
+    ]
+    demo_inputs = [_manual(1, shape) for shape in shapes[:3]]
+    query_input = _manual(2, shapes[3])
+    demos = [{"input": grid, "output": GEN._solve(grid)} for grid in demo_inputs]
+    query = {"input": query_input, "output": GEN._solve(query_input)}
+
+    reasons = GEN.lesson_identifiable(demos, query)
+    assert any("always_code_1" in reason for reason in reasons)
+    assert GEN.LESSON_COMPETITORS["always_code_1"](query_input) != query["output"]
