+def _pair(grid: list[list[int]]) -> dict[str, list[list[int]]]:
+    return {
+        "input": grid,
+        "output": GEN._apply_variant(grid, blue_mode="away", red_mode="toward"),
+    }
+
+
+def _digest(value: Any) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def sweep(seed_count: int = 20) -> dict[str, Any]:
+    if type(seed_count) is not int or not 1 <= seed_count <= 1000:
+        raise ValueError("seed_count must be an exact integer in 1..1000")
+    failures = []
+    lessons = []
+    profiles = set()
+    for seed in range(seed_count):
+        for difficulty in ("easy", "medium", "hard"):
+            grids = [GEN.generate(seed, index, difficulty=difficulty) for index in range(3)]
+            pairs = [_pair(grid) for grid in grids]
+            reasons = GEN.lesson_identifiable(pairs[:2], pairs[2])
+            survivors = []
+            for name, rival in GEN.LESSON_COMPETITORS.items():
+                fits = all(rival(pair["input"]) == pair["output"] for pair in pairs[:2])
+                changes = rival(pairs[2]["input"]) != pairs[2]["output"]
+                if fits:
+                    survivors.append({"name": name, "changes_query": changes})
+            context = {"seed": seed, "difficulty": difficulty}
+            if reasons or any(row["changes_query"] for row in survivors):
+                failures.append({**context, "reasons": reasons, "survivors": survivors})
+            lessons.append(
+                {
+                    **context,
+                    "input_sha256": [_digest(pair["input"]) for pair in pairs],
+                    "survivors": survivors,
+                    "lesson_reasons": reasons,
+                }
+            )
+            profiles.update((len(grid), len(grid[0])) for grid in grids)
+    return {
+        "schema": "91ba301501c5-bounded-learnability-sweep-v1",
+        "task_id": TASK,
+        "seed_count": seed_count,
+        "difficulties": ["easy", "medium", "hard"],
+        "lesson_count": len(lessons),
+        "examples_per_lesson": 3,
+        "demonstrations": 2,
+        "queries": 1,
+        "declared_rivals": sorted(GEN.LESSON_COMPETITORS),
+        "grid_profiles_seen": [list(value) for value in sorted(profiles)],
+        "lessons": lessons,
+        "failures": failures,
+        "scope": "Finite generated lessons and declared rivals only; no universal identifiability claim.",
+    }
+
+
+def _canonical_program() -> str:
+    programs = set()
+    with (ROOT / "shared/data/canonical/puzzles.jsonl").open(encoding="utf-8") as stream:
+        for line in stream:
+            row = json.loads(line)
+            if row.get("task_id") == TASK:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def protected_spot_check() -> dict[str, Any]:
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    program = _canonical_program()
+    pairs = [_pair(GEN.generate(0, index, difficulty="medium")) for index in range(3)]
+    wrapped = wrap_rule(program)
+    outputs = []
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("protected Racket backend required")
+        for pair in pairs:
+            literal = "'(" + " ".join(
+                "(" + " ".join(map(str, row)) + ")" for row in pair["input"]
+            ) + ")"
+            outputs.append(bridge.eval_text(f"({wrapped} {literal})"))
+    mismatches = [index for index, (actual, pair) in enumerate(zip(outputs, pairs))
+                  if actual != pair["output"]]
+    if mismatches:
+        raise RuntimeError(f"Racket/Python mismatches at {mismatches}")
+    return {
+        "program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "pairs": len(pairs),
+        "input_sha256": [_digest(pair["input"]) for pair in pairs],
+        "output_sha256": [_digest(output) for output in outputs],
+        "runtime_identity": identity,
+        "protected_racket": True,
+        "mismatches": mismatches,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seeds", type=int, default=20)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = {
+        "schema": "91ba301501c5-peer-review-v1",
+        "task_id": TASK,
+        "source_sha256": hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
+        "learnability": sweep(args.seeds),
+        "protected_racket": protected_spot_check(),
+        "strict_override_repair": {
+            "axes": ["n_blue", "n_red"],
+            "rejected_types": ["float", "bool", "str"],
+            "tests": "generators/91ba301501c5/tests/test_generator_91ba301501c5.py",
+        },
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n")
+    print(json.dumps({
+        "status": "pass" if not report["learnability"]["failures"] else "fail",
+        "lessons": report["learnability"]["lesson_count"],
+        "failures": len(report["learnability"]["failures"]),
+        "racket_pairs": report["protected_racket"]["pairs"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    if report["learnability"]["failures"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
