+TASK = "c53c24435976"
+ROOT = find_root(__file__)
+SOURCE = ROOT / "generators" / TASK / "generator.py"
+SPEC = importlib.util.spec_from_file_location("c53_peer_probe_generator", SOURCE)
+assert SPEC and SPEC.loader
+GEN = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = GEN
+SPEC.loader.exec_module(GEN)
+
+
+def _canonical_program() -> str:
+    programs = set()
+    with (ROOT / "shared/data/canonical/puzzles.jsonl").open(encoding="utf-8") as stream:
+        for line in stream:
+            row = json.loads(line)
+            if row.get("task_id") == TASK:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def _manual(code: int, cells: list[tuple[int, int]], color: int = 6) -> list[list[int]]:
+    grid = [[0] * 8 for _ in range(8)]
+    grid[0][0] = code
+    for row, col in cells:
+        grid[row + 2][col + 2] = color
+    return grid
+
+
+def _digest(value) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def _execute(program: str, grids: list[list[list[int]]]):
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    wrapped = wrap_rule(program)
+    results = []
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("protected Racket backend required")
+        for grid in grids:
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            results.append(bridge.eval_text(f"({wrapped} {literal})"))
+    return identity, results
+
+
+def build_report() -> dict:
+    shapes = [
+        [(0, 0), (1, 0), (2, 0), (2, 1)],
+        [(0, 0), (0, 1), (1, 0), (2, 0), (2, 1)],
+        [(0, 0), (1, 0), (1, 1), (1, 2), (2, 2)],
+        [(0, 0), (0, 1), (0, 2), (1, 0), (2, 0), (2, 1)],
+    ]
+    inputs = [_manual(1, shape) for shape in shapes[:3]] + [_manual(2, shapes[3])]
+    canonical = _canonical_program()
+    rival = canonical.replace("(cmd (at g 0 0))", "(cmd 1)", 1)
+    if rival == canonical:
+        raise RuntimeError("failed to materialize fixed-code rival")
+    identity, intended = _execute(canonical, inputs)
+    rival_identity, rival_outputs = _execute(rival, inputs)
+    if identity != rival_identity:
+        raise RuntimeError("protected runtime identity changed between programs")
+    fits_demos = intended[:3] == rival_outputs[:3]
+    changes_query = intended[3] != rival_outputs[3]
+    reasons = GEN.lesson_identifiable(
+        [{"input": grid, "output": output} for grid, output in zip(inputs[:3], intended[:3])],
+        {"input": inputs[3], "output": intended[3]},
+    )
+    if not fits_demos or not changes_query or not any("always_code_1" in x for x in reasons):
+        raise RuntimeError("shortcut witness or integrated lesson guard did not reproduce")
+    return {
+        "schema": "c53c24435976-fixed-transform-shortcut-v1",
+        "task_id": TASK,
+        "source_sha256": hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "rival": "ignore the marker and always apply code 1 / clockwise rotation",
+        "demonstration_codes": [1, 1, 1],
+        "query_code": 2,
+        "fits_all_demonstrations": fits_demos,
+        "changes_query": changes_query,
+        "lesson_guard_reasons": reasons,
+        "inputs": inputs,
+        "intended_outputs": intended,
+        "rival_outputs": rival_outputs,
+        "input_sha256": [_digest(grid) for grid in inputs],
+        "protected_racket": True,
+        "runtime_identity": identity,
+        "scope": "One source-bound constructed lesson; no claim about all schedules or all rival programs.",
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = build_report()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n")
+    print(json.dumps({"status": "pass", "fits_demos": True, "changes_query": True,
+                      "out": str(args.out)}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
