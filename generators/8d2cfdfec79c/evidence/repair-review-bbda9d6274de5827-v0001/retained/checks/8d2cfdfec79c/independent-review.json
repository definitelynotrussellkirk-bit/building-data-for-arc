  "reviewer_probe_source": "import importlib.util,json,hashlib\nfrom pathlib import Path\nroot=Path('generators/8d2cfdfec79c/workspace/parametric')\np=root/'prototype.py';s=importlib.util.spec_from_file_location('p',p);m=importlib.util.module_from_spec(s);s.loader.exec_module(m)\ndef rival(g,name):\n st=m.intermediate(g);colors=st['reading_order'];bb=st['boxes'];cnt=st['visible_counts'];out=[r[:] for r in st['outlines']]\n perimeter=lambda c:len(m._border(bb[c]));area=lambda c:(bb[c][2]-bb[c][0]+1)*(bb[c][3]-bb[c][1]+1)\n elig=[c for c in colors if bb[c][2]-bb[c][0]>1 and bb[c][3]-bb[c][1]>1]\n if name=='fillable_only': win=max(elig,key=lambda c:cnt[c]) if elig else colors[0]\n elif name=='visible_fraction_fillable': win=max(elig,key=lambda c:cnt[c]/perimeter(c)) if elig else colors[0]\n elif name=='max_zero_interior': win=max(colors,key=lambda c:sum(out[r][col]==0 for r in range(bb[c][0]+1,bb[c][2]) for col in range(bb[c][1]+1,bb[c][3])))\n elif name=='last_visible_tie': win=max(reversed(colors),key=lambda c:cnt[c])\n elif name=='bbox_from_visible':\n  win=st['winner'];bb={c:m._box([(r,col) for r,row in enumerate(out) for col,v in enumerate(row) if v==c]) for c in colors if cnt[c]}\n elif name=='restore_clues': win=st['winner']\n elif name=='fill_over_border': win=st['winner']\n elif name=='smallest_fillable': win=min(elig,key=area) if elig else colors[0]\n elif name=='second_last_tie':\n  best=max(cnt.values());cs=[c for c in colors if cnt[c]==best];win=cs[-2] if len(cs)>1 else cs[0]\n r0,c0,r1,c1=bb[win]\n for r in range(r0+1,r1):\n  for col in range(c0+1,c1):\n   if out[r][col]==0 or name=='fill_over_border':out[r][col]=win\n if name=='restore_clues':\n  for r,row in enumerate(g):\n   for col,v in enumerate(row):\n    if v:out[r][col]=v\n return out\nnames=['fillable_only','visible_fraction_fillable','max_zero_interior','last_visible_tie','bbox_from_visible','restore_clues','fill_over_border','smallest_fillable','second_last_tie']\nseeds=[0,1,17,33,55,60];counts=[2,3,6];rows=[];issues=[]\nfor seed in seeds:\n for demos in counts:\n  eps={mode:m.generate(seed,{'mode':mode},demos,4) for mode in m.MODES}\n  for mode,e in eps.items():\n   keys=[repr(pair['input']) for split in ('train','test') for pair in e[split]]\n   if len(keys)!=len(set(keys)):issues.append({'kind':'duplicate','seed':seed,'demos':demos,'mode':mode})\n   for split in ('train','test'):\n    for pair in e[split]:m.validate_input(pair['input'])\n   if len(e['train'])!=demos or len(e['test'])!=4:issues.append({'kind':'counts','seed':seed})\n  if any([p['input'] for p in eps['outline'][split]]!=[p['input'] for p in eps['fill_most_visible'][split]] for split in ('train','test')):issues.append({'kind':'mode_stream','seed':seed})\n  filled=eps['fill_most_visible']\n  if not any(a['output']!=b['output'] for a,b in zip(eps['outline']['train'],filled['train'])):issues.append({'kind':'mode_ambiguous','seed':seed})\n  rival_results={}\n  for name in names:\n   rejected=[i for i,pair in enumerate(filled['train']) if rival(pair['input'],name)!=pair['output']]\n   differing=[i for i,pair in enumerate(filled['test']) if rival(pair['input'],name)!=pair['output']]\n   rival_results[name]={'demo_rejections':rejected,'query_differences':differing}\n   if not rejected and differing:issues.append({'kind':'supported_wrong_rival','seed':seed,'demos':demos,'rival':name,'queries':differing})\n  q=filled['test'][2];occupied=[(r,c) for r,row in enumerate(q['input']) for c,v in enumerate(row) if v]\n  stress={'shape':[len(q['input']),len(q['input'][0])],'nonzero_output':sum(bool(v) for row in q['output'] for v in row),'row_span':max(r for r,c in occupied)-min(r for r,c in occupied),'column_span':max(c for r,c in occupied)-min(c for r,c in occupied)}\n  rows.append({'seed':seed,'demos':demos,'queries':4,'settings':[{'mode':x} for x in m.MODES],'stress_query_2':stress,'rivals':rival_results})\nresult={'schema':'task-local-independent-parametric-review-v1','task_id':'8d2cfdfec79c','status':'no_remaining_finding_in_bounded_recheck' if not issues else 'findings','source_sha256':{str(root/f):hashlib.sha256((root/f).read_bytes()).hexdigest() for f in ['prototype.py','adapter.py','promotion.json','canonical.rkt','public_export.py']},'executed_command':'WORK/.venv/bin/python review.py run python3 -c <bounded reviewer probe>','racket_executed':False,'method':'Python diagnostic mirror; exact rival implementations included as reviewer_probe_source for reproducibility. Demo fit assessed before interpreting query differences.','seeds':seeds,'demo_counts':counts,'query_count':4,'episode_count':36,'rival_names':names,'issues':issues,'observations':rows,'superseded_before_findings':{'source_sha256':'f339fae64008bf292b337bbe83dd06679c99998f754c9d11edf135a3b20f734c','status':'superseded_by_current_source_recheck','findings':[{'rival':'fillable_only','seed':33,'demos':6,'query_index':0,'explanation':'Thin first-tied visible winner3 causes no fill; eligible-only rival fills6.'},{'rival':'smallest_fillable','seed':0,'demos':2,'query_indices':[0,1,2,3]},{'rival':'visible_fraction_fillable','seed':1,'demos':2,'query_index':1},{'rival':'fill_over_border','seed':0,'demos':2,'query_indices':[0,1,2,3],'origin':'also independently found by parent'}]},'limits':['Only six listed seeds, demo counts2,3,6 and four queries rechecked; no universal identifiability claim.','Only nine listed rival rules, no unbounded program search.','No new protected-Racket execution or label-equivalence verification; parent handles qualification.','No native qualification, acceptance, manifest or production authority operation performed.','Public export reviewed by source/test inspection, not independently executed in this recheck.']}\nprint(json.dumps({'status':result['status'],'issues':issues,'source_sha256':result['source_sha256'],'rejections':{n:sum(bool(row['rivals'][n]['demo_rejections']) for row in rows) for n in names}},indent=2))\nout=Path('../checks/8d2cfdfec79c/independent-review.json');ou