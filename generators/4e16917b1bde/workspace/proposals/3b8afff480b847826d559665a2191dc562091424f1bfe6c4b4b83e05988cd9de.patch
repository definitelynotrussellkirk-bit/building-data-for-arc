+Cell = tuple[int, int]
+_CARDINAL = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _neighbors4(cell: Cell):
+    r, c = cell
+    for dr, dc in _CARDINAL:
+        yield r + dr, c + dc
+
+
+def _is_connected(cells: set[Cell]) -> bool:
+    if not cells:
+        return False
+    seen = {next(iter(cells))}
+    stack = list(seen)
+    while stack:
+        cell = stack.pop()
+        for neighbor in _neighbors4(cell):
+            if neighbor in cells and neighbor not in seen:
+                seen.add(neighbor)
+                stack.append(neighbor)
+    return seen == cells
+
+
+def _grow_blob_in_allowed(
+    rng,
+    allowed: set[Cell],
+    target_size: int,
+    *,
+    max_starts: int = 96,
+) -> set[Cell] | None:
+    """Grow an exact-size connected blob entirely inside ``allowed``.
+
+    The candidate frontier is recomputed from the current blob, so every added
+    cell is orthogonally adjacent to the blob and the result is connected.
+    Multiple shuffled starts avoid getting trapped in a narrow local pocket.
+    """
+    if target_size < 1 or len(allowed) < target_size:
+        return None
+    starts = sorted(allowed)
+    rng.shuffle(starts)
+    for start in starts[:max_starts]:
+        cells = {start}
+        while len(cells) < target_size:
+            frontier = sorted({
+                neighbor
+                for cell in cells
+                for neighbor in _neighbors4(cell)
+                if neighbor in allowed and neighbor not in cells
+            })
+            if not frontier:
+                break
+            cells.add(frontier[rng.randrange(len(frontier))])
+        if len(cells) == target_size:
+            return cells
+    return None
+
 
