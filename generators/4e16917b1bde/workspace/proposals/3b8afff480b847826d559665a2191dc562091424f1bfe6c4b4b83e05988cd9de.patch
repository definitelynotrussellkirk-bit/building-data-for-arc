+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+from reviewer_support import canonical_path, find_root
+
+TASK_ID = "327c3478236b"
+TASK_DIR = Path(__file__).resolve().parents[1]
+ROOT = find_root(__file__)
+
+
+def _load_generator():
+    path = TASK_DIR / "generator.py"
+    spec = importlib.util.spec_from_file_location("generator_327c3478236b_repair", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _facts(grid):
+    h, w = len(grid), len(grid[0])
+    src = next((r, c) for r in range(h) for c in range(w) if grid[r][c] == 3)
+    dst = next((r, c) for r in range(h) for c in range(w) if grid[r][c] == 4)
+    template = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]
+    vector = (dst[0] - src[0], dst[1] - src[1])
+    translated = [(r + vector[0], c + vector[1]) for r, c in template]
+    return src, dst, template, vector, translated
+
+
+def _canonical_program():
+    rows = [json.loads(line) for line in canonical_path(ROOT).read_text().splitlines() if line.strip()]
+    matches = [row for row in rows if row.get("task_id") == TASK_ID]
+    assert len(matches) == 1
+    return matches[0]["program_solution"]
+
+
+def test_default_seed_zero_no_longer_clips_the_translated_template():
+    generator = _load_generator()
+    grid = generator.generate(0, 0)
+    _, _, template, _, translated = _facts(grid)
+
+    assert generator.self_check(grid) == []
+    assert len(template) in (3, 4)
+    assert all(0 <= r < len(grid) and 0 <= c < len(grid[0]) for r, c in translated)
+
+
+def test_self_check_rejects_the_retained_clipping_counterexample():
+    generator = _load_generator()
+    path = TASK_DIR / "counterexamples" / "review-c5fe8719feedc568-v0001" / "retained" / "checks" / "audit" / TASK_ID / "input.json"
+    payload = json.loads(path.read_text())
+    grid = payload["input"] if isinstance(payload, dict) else payload
+
+    errors = generator.self_check(grid)
+    assert any("out of bounds" in error for error in errors)
+
+
+def test_generated_census_is_connected_and_every_translation_is_in_bounds():
+    generator = _load_generator()
+    checked = 0
+    for difficulty in (None, "easy", "hard"):
+        for seed in range(40):
+            for sample_index in range(4):
+                grid = generator.generate(seed, sample_index, difficulty=difficulty)
+                src, dst, template, vector, translated = _facts(grid)
+                assert generator.self_check(grid) == []
+                assert src != dst
+                assert len(template) >= 2
+                assert all(0 <= r < len(grid) and 0 <= c < len(grid[0]) for r, c in translated)
+                remaining = set(template)
+                stack = [remaining.pop()]
+                seen = set(stack)
+                while stack:
+                    r, c = stack.pop()
+                    for nxt in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                        if nxt in remaining:
+                            remaining.remove(nxt)
+                            seen.add(nxt)
+                            stack.append(nxt)
+                assert len(seen) == len(template)
+                checked += 1
+    assert checked == 480
+
+
+def test_blob_size_override_two_and_six_remains_exact_and_lawful():
+    generator = _load_generator()
+    for blob_size in (2, 6):
+        for seed in range(12):
+            grid = generator.generate(seed, 0, blob_size=blob_size)
+            _, _, template, _, translated = _facts(grid)
+            assert len(template) == blob_size
+            assert generator.self_check(grid) == []
+            assert all(0 <= r < len(grid) and 0 <= c < len(grid[0]) for r, c in translated)
+
+
+def test_protected_racket_emits_one_cyan_cell_per_template_cell():
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    generator = _load_generator()
+    grids = [generator.generate(0, 0), generator.generate(17, 3, difficulty="hard", blob_size=6)]
+    with RacketBridge(timeout=30, max_calls_before_restart=8) as bridge:
+        callable_source = wrap_rule(_canonical_program())
+        for index, grid in enumerate(grids):
+            name = f"g{index}"
+            bridge.define_grid(name, grid)
+            output = bridge.eval_text(f"({callable_source} {name})")
+            template_count = sum(cell == 2 for row in grid for cell in row)
+            assert sum(cell == 8 for row in output for cell in row) == template_count
+            assert sum(cell == 4 for row in output for cell in row) == 1
+        assert bridge.runtime_identity["protected"] is True
+
+
+def test_declared_dimension_endpoints_are_exact_and_lawful():
+    generator = _load_generator()
+    for grid_h, grid_w in ((7, 8), (14, 14)):
+        grid = generator.generate(23, 2, grid_h=grid_h, grid_w=grid_w, blob_size=6)
+        assert (len(grid), len(grid[0])) == (grid_h, grid_w)
+        assert generator.self_check(grid) == []
+
+
+def test_unknown_and_non_integer_overrides_are_rejected():
+    import pytest
+
+    generator = _load_generator()
+    with pytest.raises(ValueError, match="unknown override"):
+        generator.generate(0, 0, mystery_axis=1)
+    for name, value in (("grid_h", True), ("grid_w", 9.5), ("blob_size", "3")):
+        with pytest.raises((TypeError, ValueError)):
+            generator.generate(0, 0, **{name: value})
+
+
+def test_difficulty_accepts_only_none_easy_medium_or_hard():
+    import pytest
+
+    generator = _load_generator()
+    for difficulty in (None, "easy", "medium", "hard"):
+        assert generator.self_check(generator.generate(5, 1, difficulty=difficulty)) == []
+    for difficulty in (True, False, 0, 1.0, "__invalid_difficulty__"):
+        with pytest.raises((TypeError, ValueError)):
