+#!/usr/bin/env python3
+"""Bounded source-pinned learnability probe for stable row compaction.
+
+The probe exercises sliding four-demonstration lessons across three difficulty
+bands, three seeds, and sixteen starting indices.  It checks the generator's
+named semantic rivals plus two additional structural rivals, then executes one
+representative lesson through the protected Racket reference runtime.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Callable
+
+
+TASK_ID = "260f488cb5a8"
+PINNED_GENERATOR_SHA256 = "81356bc5319aa8c3381fadbb4fbb2a032464890ae3dc6aec3d227ae04c17682c"
+SEEDS = (0, 17, 991)
+DIFFICULTIES = ("easy", "medium", "hard")
+STARTS = tuple(range(16))
+
+
+def _pack_rows_right(grid: Any) -> list[list[int]]:
+    """Preserve row order but pack each row against the right edge."""
+    output: list[list[int]] = []
+    for row in grid:
+        values = [value for value in row if value != 0]
+        output.append([0] * (len(row) - len(values)) + values)
+    return output
+
+
+def _compact_columns_top(grid: Any) -> list[list[int]]:
+    """Compact each column upward, preserving top-to-bottom color order."""
+    height, width = len(grid), len(grid[0])
+    output = [[0 for _ in range(width)] for _ in range(height)]
+    for col in range(width):
+        values = [grid[row][col] for row in range(height) if grid[row][col] != 0]
+        for row, value in enumerate(values):
+            output[row][col] = value
+    return output
+
+
+def _write_json(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def _canonical_program(root: Path) -> str:
+    from reviewer_support import canonical_path
+
+    programs: set[str] = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return programs.pop()
+
+
+def _pair(generator: Any, grid: list[list[int]]) -> dict[str, list[list[int]]]:
+    return {"input": grid, "output": generator.rule_mirror(grid)}
+
+
+def build(output: Path) -> dict[str, Any]:
+    if output.exists():
+        raise FileExistsError(output)
+
+    from reviewer_support import find_root, load_selected_generator
+
+    root = find_root(__file__)
+    generator, source, source_sha256 = load_selected_generator(TASK_ID, root=root)
+    if source_sha256 != PINNED_GENERATOR_SHA256:
+        raise ValueError(f"generator source drifted: {source_sha256}")
+
+    rivals: dict[str, Callable[[Any], list[list[int]]]] = dict(generator.SEMANTIC_RIVALS)
+    rivals.update(
+        {
+            "pack_each_row_right": _pack_rows_right,
+            "compact_each_column_top": _compact_columns_top,
+        }
+    )
+
+    failures: list[dict[str, Any]] = []
+    profile_counts: dict[str, int] = {}
+    lessons = 0
+    grids_checked = 0
+    rival_checks = 0
+    for difficulty in DIFFICULTIES:
+        for seed in SEEDS:
+            for start in STARTS:
+                grids = [
+                    generator.generate(seed, start + offset, difficulty=difficulty)
+                    for offset in range(5)
+                ]
+                demos = [_pair(generator, grid) for grid in grids[:4]]
+                query = _pair(generator, grids[4])
+                lessons += 1
+                grids_checked += len(grids)
+                for grid in grids[:4]:
+                    profile = generator.observe_overrides(grid)["scene_profile"]
+                    profile_counts[profile] = profile_counts.get(profile, 0) + 1
+                reasons = generator.lesson_identifiable(demos, query)
+                if reasons:
+                    failures.append(
+                        {
+                            "kind": "lesson_identifiable",
+                            "difficulty": difficulty,
+                            "seed": seed,
+                            "start": start,
+                            "reasons": reasons,
+                        }
+                    )
+                for name, rival in rivals.items():
+                    rival_checks += 1
+                    if all(rival(pair["input"]) == pair["output"] for pair in demos):
+                        failures.append(
+                            {
+                                "kind": "surviving_rival",
+                                "difficulty": difficulty,
+                                "seed": seed,
+                                "start": start,
+                                "rival": name,
+                            }
+                        )
+
+    canonical = _canonical_program(root)
+    representative_grids = [
+        generator.generate(17, offset, difficulty="medium") for offset in range(5)
+    ]
+    from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+    runtime = root / "shared/runtime"
+    with _local_imports(runtime, runtime):
+        apply, racket, bridge = _real_evaluator(runtime)
+        try:
+            racket_outputs = [apply(canonical, grid) for grid in representative_grids]
+        finally:
+            bridge.close()
+    expected_outputs = [generator.rule_mirror(grid) for grid in representative_grids]
+    racket_matches = [left == right for left, right in zip(racket_outputs, expected_outputs, strict=True)]
+    if not all(racket_matches):
+        failures.append(
+            {
+                "kind": "racket_parity",
+                "matching_cases": sum(racket_matches),
+                "total_cases": len(racket_matches),
+            }
+        )
+
+    representative = {
+        "schema": "arcpuzzles-peer-learnability-representative-v1",
+        "task_id": TASK_ID,
+        "generator_path": source.relative_to(root).as_posix(),
+        "generator_sha256": source_sha256,
+        "program_solution": canonical,
+        "program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "seed": 17,
+        "difficulty": "medium",
+        "sample_indices": list(range(5)),
+        "pairs": [
+            {"input": grid, "output": output}
+            for grid, output in zip(representative_grids, racket_outputs, strict=True)
+        ],
+        "racket": racket,
+        "racket_evaluations": len(representative_grids),
+        "all_outputs_match_rule_mirror": all(racket_matches),
+    }
+    _write_json(output / "representative.json", representative)
+
+    result = {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "status": "completed" if not failures else "finding",
+        "task_id": TASK_ID,
+        "summary": (
+            "No tested learnability ambiguity: every sliding four-demo lesson defeated "
+            "all eight declared rivals plus row-right and column-top compaction."
+            if not failures
+            else f"The bounded probe found {len(failures)} learnability or Racket-parity failures."
+        ),
+        "generator_path": source.relative_to(root).as_posix(),
+        "generator_sha256": source_sha256,
+        "difficulties": list(DIFFICULTIES),
+        "seeds": list(SEEDS),
+        "start_indices": list(STARTS),
+        "lessons_checked": lessons,
+        "grids_checked": grids_checked,
+        "demonstrations_per_lesson": 4,
+        "queries_per_lesson": 1,
+        "rivals": sorted(rivals),
+        "rival_checks": rival_checks,
+        "profile_counts_in_demonstrations": dict(sorted(profile_counts.items())),
+        "racket_evaluations": len(representative_grids),
+        "representative_path": "representative.json",
+        "failures": failures,
+        "limits": (
+            "Finite source-pinned probe over 144 generated lessons and ten specified rivals; "
+            "it does not prove uniqueness against every possible transformation. Production source unchanged."
+        ),
+    }
+    _write_json(output / "result.json", result)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    result = build(args.out)
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0 if result["status"] == "completed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
