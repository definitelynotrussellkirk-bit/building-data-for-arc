+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+HERE = Path(__file__).resolve().parent
+MODULE_PATH = HERE / "learnability_probe.py"
+
+
+def _load_module():
+    spec = importlib.util.spec_from_file_location("peer_260_learnability_probe", MODULE_PATH)
+    if spec is None or spec.loader is None:
+        raise AssertionError("probe module cannot be loaded")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_extra_rivals_are_semantically_distinct_from_stable_left_compaction() -> None:
+    probe = _load_module()
+    grid = [
+        [0, 3, 0, 1, 0, 2],
+        [0, 0, 0, 0, 0, 0],
+        [4, 0, 5, 0, 4, 0],
+        [0, 7, 0, 8, 9, 0],
+    ]
+    expected = [
+        [3, 1, 2, 0, 0, 0],
+        [0, 0, 0, 0, 0, 0],
+        [4, 5, 4, 0, 0, 0],
+        [7, 8, 9, 0, 0, 0],
+    ]
+    assert probe._pack_rows_right(grid) != expected
+    assert probe._compact_columns_top(grid) != expected
+
+
+def test_build_rejects_existing_output_directory(tmp_path: Path) -> None:
+    probe = _load_module()
+    output = tmp_path / "existing"
+    output.mkdir()
+    try:
+        probe.build(output)
+    except FileExistsError as error:
+        assert error.args[0] == output
+    else:
+        raise AssertionError("expected an existing output directory to be rejected")
