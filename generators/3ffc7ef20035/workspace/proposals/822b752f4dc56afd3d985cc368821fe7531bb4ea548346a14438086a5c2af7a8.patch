+#!/usr/bin/env python3
+"""Build a protected-Racket alternative-answer witness for 2e9bbcd910a7.
+
+The retained lesson has four non-tie demonstrations followed by a tie query.
+The canonical and reversed within-direction column tie-break rules therefore fit
+all visible demonstrations but disagree on the query.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import canonical_path, find_root, load_selected_generator, public_challenge_bytes
+
+
+TASK_ID = "2e9bbcd910a7"
+PINNED_GENERATOR_SHA256 = "9301977697af1a47c63f609e71c4485d90002a7d15c32eb6f2470fc03ac1d8d6"
+SEED = 0
+START = 9
+DIFFICULTY = "medium"
+
+ALTERNATE_PROGRAM = r'''(rule! (lambda (g)
+         (let* ((h (rows g))
+                (w (cols g)))
+           (let* ((runs (straight-runs g
+                                       (lambda (v) (zero? v))
+                                       (list (list 1 1) (list 1 -1)))))
+             (define (score run)
+               (let* ((cells (fst run))
+                      (dir (snd run))
+                      (start (fst cells))
+                      (dc (snd dir)))
+                 (+ (* (length cells) 10000)
+                    (- (* (fst start) 100))
+                    (if (= dc -1) (- w (snd start)) (snd start)))))
+             (let ((best (fst (sort runs (lambda (a b) (> (score a) (score b)))))))
+               (paint-cells g (fst best) 8))))))'''
+
+
+def _canonical_program(root: Path) -> str:
+    programs = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise ValueError("expected one canonical program")
+    return programs.pop()
+
+
+def _write_json(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def build(output: Path) -> dict:
+    if output.exists():
+        raise FileExistsError(output)
+    root = find_root(__file__)
+    generator, source, source_sha256 = load_selected_generator(TASK_ID, root=root)
+    if source_sha256 != PINNED_GENERATOR_SHA256:
+        raise ValueError(f"generator source drifted: {source_sha256}")
+    canonical = _canonical_program(root)
+    grids = [
+        generator.generate(SEED, START + offset, difficulty=DIFFICULTY)
+        for offset in range(5)
+    ]
+    families = [generator.observe_overrides(grid)["scene_family"] for grid in grids]
+    facts = [generator._analysis(grid)["facts"] for grid in grids]
+    if not all(item["max_run_count"] == 1 for item in facts[:4]):
+        raise ValueError("retained demonstrations unexpectedly contain a tie")
+    if facts[4]["max_run_count"] < 2:
+        raise ValueError("retained query unexpectedly lacks a tie")
+
+    from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+    runtime = root / "shared/runtime"
+    with _local_imports(runtime, runtime):
+        apply, racket, bridge = _real_evaluator(runtime)
+        try:
+            canonical_outputs = [apply(canonical, grid) for grid in grids]
+            alternate_outputs = [apply(ALTERNATE_PROGRAM, grid) for grid in grids]
+        finally:
+            bridge.close()
+
+    demo_fit = [
+        canonical_outputs[index] == alternate_outputs[index] == generator.rule_mirror(grids[index])
+        for index in range(4)
+    ]
+    query_diff = sum(
+        left != right
+        for left_row, right_row in zip(canonical_outputs[4], alternate_outputs[4], strict=True)
+        for left, right in zip(left_row, right_row, strict=True)
+    )
+    if not all(demo_fit) or query_diff == 0:
+        raise ValueError("retained ambiguity no longer reproduces")
+
+    public = {
+        "train": [
+            {"input": grids[index], "output": canonical_outputs[index]}
+            for index in range(4)
+        ],
+        "test": [{"input": grids[4]}],
+    }
+    visible = public_challenge_bytes(public)
+    visible_sha256 = hashlib.sha256(visible).hexdigest()
+    public_path = output / "public" / f"challenge-{visible_sha256}.json"
+    public_path.parent.mkdir(parents=True)
+    public_path.write_bytes(visible)
+
+    private = {
+        "schema": "arcpuzzles-alternative-answer-witness-v1",
+        "task_id": TASK_ID,
+        "generator_path": source.relative_to(root).as_posix(),
+        "generator_sha256": source_sha256,
+        "seed": SEED,
+        "sample_indices": list(range(START, START + 5)),
+        "difficulty": DIFFICULTY,
+        "families": families,
+        "canonical_program": canonical,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "alternate_program": ALTERNATE_PROGRAM,
+        "alternate_program_sha256": hashlib.sha256(ALTERNATE_PROGRAM.encode()).hexdigest(),
+        "canonical_query_output": canonical_outputs[4],
+        "alternate_query_output": alternate_outputs[4],
+        "demo_fit": demo_fit,
+        "query_different_cells": query_diff,
+        "racket": racket,
+        "racket_evaluations": 10,
+        "public_sha256": visible_sha256,
+        "limits": "One deterministic four-demo lesson and one reversed column tie-break rival; not a universal ambiguity claim.",
+    }
+    _write_json(output / "private.json", private)
+    result = {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "finding": "Four visible non-tie demonstrations do not teach the canonical within-direction column tie-break.",
+        "families": families,
+        "demo_count": 4,
+        "query_family": families[4],
+        "demo_fit_both_rules": all(demo_fit),
+        "query_different_cells": query_diff,
+        "racket_evaluations": 10,
+        "public_path": public_path.relative_to(output).as_posix(),
+        "private_path": "private.json",
+        "suggested_repair": "Ensure every four-demo lesson includes at least one exact tie whose winner depends on the canonical column tie-break, or certify lesson assembly against this rival.",
+        "limits": private["limits"],
+    }
+    _write_json(output / "result.json", result)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    result = build(args.out)
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
