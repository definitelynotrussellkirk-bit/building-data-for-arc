(rule!
  (let ((dummy 0))
    (define (paint grid cells color)
      (for/fold ((out grid)) ((p (in-list cells)))
        (if (in-bounds? (first p) (second p) (rows out) (cols out))
            (set-cell out (first p) (second p) color)
            out)))
    (define cleaned
      (for/fold ((out (empty-grid (rows g) (cols g) 0)))
                ((obj (in-list (objects g 0))))
        (if (> (obj-size obj) 1)
            (paint out (obj-cells obj) (obj-color obj))
            out)))
    (define (row-eligible? r c color)
      (let ((positions
             (filter (lambda (cc) (= (at cleaned r cc) color))
                     (range (cols cleaned)))))
        (if (< (length positions) 4)
            #f
            (let ((lo (apply min positions))
                  (hi (apply max positions)))
              (and (<= lo c)
                   (<= c hi)
                   (for/or ((cc (in-range lo (+ hi 1))))
                     (= (at cleaned r cc) 0))
                   (for/and ((cc (in-range lo (+ hi 1))))
                     (let ((v (at cleaned r cc)))
                       (or (= v 0) (= v color)))))))))
    (define (col-eligible? r c color)
      (let ((positions
             (filter (lambda (rr) (= (at cleaned rr c) color))
                     (range (rows cleaned)))))
        (if (< (length positions) 4)
            #f
            (let ((lo (apply min positions))
                  (hi (apply max positions)))
              (and (<= lo r)
                   (<= r hi)
                   (for/or ((rr (in-range lo (+ hi 1))))
                     (= (at cleaned rr c) 0))
                   (for/and ((rr (in-range lo (+ hi 1))))
                     (let ((v (at cleaned rr c)))
                       (or (= v 0) (= v color)))))))))
    (define (first-row-color r c)
      (find (lambda (color) (row-eligible? r c color)) (range 1 10)))
    (define (first-col-color r c)
      (find (lambda (color) (col-eligible? r c color)) (range 1 10)))
    (build-grid
      (rows cleaned)
      (cols cleaned)
      (r c)
      (let ((row-color (first-row-color r c))
            (col-color (first-col-color r c)))
        (cond
          (row-color row-color)
          (col-color col-color)
          (else (at cleaned r c)))))))
