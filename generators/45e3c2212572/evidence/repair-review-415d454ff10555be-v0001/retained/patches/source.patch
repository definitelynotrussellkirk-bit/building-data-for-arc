+#!/usr/bin/env python3
+"""Bounded protected-Racket audit of one predetermined contact-graph lesson.
+
+The first three consecutive draws are demonstrations and the next four are
+queries.  No labels or rival outcomes influence which inputs are selected.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles.parametric_worker import _real_evaluator
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK = "28ba67946524"
+
+
+def sha(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def candidate(program, operation):
+    """Restrict the first hop to all tied maximum/minimum-area neighbors."""
+    marker = "(define dist (distances g objs seed))"
+    old_selection = "(and (hash-has-key? dist i) (= (hash-ref dist i) 2))"
+    assert program.count(marker) == program.count(old_selection) == 1
+    additions = f"""{marker}
+ (define first-hop (neighbors g objs seed))
+ (define area-bound
+   (apply {operation} (map (lambda (j) (length (obj-cells (list-ref objs j)))) first-hop)))
+ (define permitted
+   (filter (lambda (j) (= (length (obj-cells (list-ref objs j))) area-bound)) first-hop))"""
+    selection = """(and (hash-has-key? dist i) (= (hash-ref dist i) 2)
+   (any? (lambda (j) (adjacent? g (list-ref objs j) (list-ref objs i))) permitted))"""
+    return program.replace(marker, additions).replace(old_selection, selection)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=17)
+    args = parser.parse_args()
+    if args.out.exists():
+        parser.error("output must be new")
+    root = find_root(__file__)
+    generator, source, source_sha = load_selected_generator(TASK, root=root)
+    row = next(json.loads(line) for line in
+               (root / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()
+               if json.loads(line).get("task_id") == TASK)
+    program = row["program_solution"]
+    rivals = {"largest_first_hop": candidate(program, "max"),
+              "smallest_first_hop": candidate(program, "min")}
+    programs = {"canonical": program, **rivals}
+    inputs = [generator.generate(args.seed, index, difficulty="medium") for index in range(7)]
+    assert all(not generator.self_check(grid) for grid in inputs)
+    assert len({json.dumps(grid) for grid in inputs}) == 7
+    execute, identity, bridge = _real_evaluator(root / "shared/runtime")
+    try:
+        predictions = {name: [execute(code, grid) for grid in inputs]
+                       for name, code in programs.items()}
+    finally:
+        bridge.close()
+    canonical = predictions["canonical"]
+    comparisons = {}
+    for name in rivals:
+        outputs = predictions[name]
+        comparisons[name] = {
+            "demonstration_matches": [outputs[i] == canonical[i] for i in range(3)],
+            "fits_every_demonstration": all(outputs[i] == canonical[i] for i in range(3)),
+            "query_matches": [outputs[i] == canonical[i] for i in range(3, 7)],
+            "changed_query_indices": [i - 3 for i in range(3, 7) if outputs[i] != canonical[i]],
+        }
+    findings = [name for name, result in comparisons.items()
+                if result["fits_every_demonstration"] and result["changed_query_indices"]]
+    features = []
+    for grid in inputs:
+        components, neighbors, distances = generator._graph(grid)
+        seed = next(i for i, distance in distances.items() if distance == 0)
+        features.append({
+            "first_hop_components": [
+                {"color": components[i][0], "area": len(components[i][1]),
+                 "touches_distance_two_target": any(distances.get(j) == 2 for j in neighbors[i])}
+                for i in sorted(neighbors[seed])],
+            "target_component_count": sum(value == 2 for value in distances.values()),
+        })
+    lesson = {"train": [{"input": inputs[i], "output": canonical[i]} for i in range(3)],
+              "test": [{"input": inputs[i], "output": canonical[i]} for i in range(3, 7)]}
+    result = {
+        "schema": "arcpuzzles-bounded-peer-learnability-v1",
+        "task_id": TASK,
+        "status": "finding" if findings else "no_finding_for_tested_rivals",
+        "generator_sha256": source_sha,
+        "generator_path": str(source.relative_to(root)),
+        "probe_sha256": sha(Path(__file__).read_bytes()),
+        "canonical_program_sha256": sha(program.encode()),
+        "declared_rule_hash": generator.RULE_HASH,
+        "selection": {"seed": args.seed, "difficulty": "medium", "sample_indices": list(range(7)),
+                      "demonstration_indices": [0, 1, 2], "query_indices": [3, 4, 5, 6],
+                      "policy": "One seed fixed before evaluation; consecutive inputs; no answer-based selection or retry."},
+        "racket": identity,
+        "protected_executions": len(programs) * len(inputs),
+        "programs": programs,
+        "program_sha256": {name: sha(code.encode()) for name, code in programs.items()},
+        "private_original_lesson": lesson,
+        "private_predictions": predictions,
+        "input_features": features,
+        "rivals": comparisons,
+        "finding_rivals": findings,
+        "scope": "Two new first-hop area rivals on one fixed seven-pair episode; no production or canonical change, no exhaustive claim.",
+        "alternative_answer_candidate": {
+            "available": bool(findings),
+            "rivals": findings,
+            "description": "Original demonstrations, all four queries, both executable interpretations and their exact protected-Racket predictions are retained here; alternative predictions are candidates, not official gold labels.",
+        },
+        "command": [sys.executable, *sys.argv],
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps({"status": result["status"], "findings": findings,
+                      "rivals": comparisons, "executions": result["protected_executions"],
+                      "out": str(args.out)}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
