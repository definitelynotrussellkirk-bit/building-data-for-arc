+"""Reproduce the retained public-demo ambiguity and its current curriculum guard.
+
+This is a bounded, private reviewer probe. It does not approve this generator,
+change its canonical rule, or admit either answer stream to training.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles.parametric_worker import _real_evaluator
+
+TASK_ID = "45e3c2212572"
+HOME = Path(__file__).resolve().parents[1]
+ROOT = HOME.parents[1]
+
+VERTICAL_RANK = """(rule! (lambda (g)
+  (define objs
+    (filter (lambda (obj)
+      (and (not (= (obj-color obj) 0)) (= (length (obj-cells obj)) 3)))
+      (objects g 0)))
+  (define ordered
+    (sort objs (lambda (a b)
+      (let ((aa (obj-bbox a)) (bb (obj-bbox b)))
+        (or (< (first aa) (first bb))
+            (and (= (first aa) (first bb)) (< (second aa) (second bb))))))))
+  (for/fold ([out (empty-grid 4 4 0)]) ([rank (range (length ordered))])
+    (let* ((obj (list-ref ordered rank))
+           (norm (normalize-cells (obj-cells obj)))
+           (has? (lambda (rr cc) (member? (list rr cc) norm)))
+           (base-r (if (< rank 2) 0 2))
+           (base-c (if (and (has? 0 0) (has? 1 0)) 0 2)))
+      (for/fold ([acc out]) ([p norm])
+        (set-cell acc (+ base-r (first p)) (+ base-c (second p)) (obj-color obj)))))))"""
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def write_json(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, sort_keys=True, indent=2) + "\n")
+
+
+def run(out, summary_path):
+    spec = importlib.util.spec_from_file_location("_peer_45e3c2212572", HOME / "generator.py")
+    generator = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = generator
+    spec.loader.exec_module(generator)
+    rows = [json.loads(line) for line in
+            (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()]
+    canonical = [row for row in rows if row.get("task_id") == TASK_ID]
+    assert len(canonical) == 1
+    canonical = canonical[0]
+    program = canonical["program_solution"]
+    assert len(canonical["train"]) == 2 and len(canonical["test"]) == 1
+    source_hashes = {
+        "generator_sha256": sha((HOME / "generator.py").read_bytes()),
+        "probe_sha256": sha(Path(__file__).read_bytes()),
+        "canonical_program_sha256": sha(program.encode()),
+        "canonical_row_sha256": sha(json.dumps(canonical, sort_keys=True, separators=(",", ":")).encode()),
+        "rival_program_sha256": sha(VERTICAL_RANK.encode()),
+    }
+    apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+    assert identity["backend"] == "racket" and identity["protected"] is True
+    evaluations = 0
+
+    def pair(grid, expected=None):
+        nonlocal evaluations
+        reference = apply(program, grid)
+        alternative = apply(VERTICAL_RANK, grid)
+        evaluations += 2
+        for result in (reference, alternative):
+            assert type(result) is list and len(result) == 4
+            assert all(type(row) is list and len(row) == 4 and
+                       all(type(cell) is int and 0 <= cell <= 9 for cell in row) for row in result)
+        assert reference == generator.rule_mirror(grid)
+        assert alternative == generator.rival_vertical_rank(grid)
+        if expected is not None:
+            assert reference == expected
+        return {"input": grid, "output": reference, "rival_output": alternative,
+                "rival_matches": reference == alternative}
+
+    try:
+        public_train = [pair(p["input"], p["output"]) for p in canonical["train"]]
+        public_test = [pair(p["input"], p["output"]) for p in canonical["test"]]
+        assert all(p["rival_matches"] for p in public_train)
+        assert not public_test[0]["rival_matches"]
+
+        # The seed and full index window are fixed before executing any labels.
+        # Four demos respect the generator's existing declared minimum.
+        generated = [pair(generator.generate(271828, index, difficulty="medium"))
+                     for index in range(8)]
+        demos, queries = generated[:4], generated[4:]
+        assert len({json.dumps(p["input"]) for p in generated}) == 8
+        assert not all(p["rival_matches"] for p in demos)
+        for query in queries:
+            assert generator.lesson_identifiable(demos, query) == []
+    finally:
+        bridge.close()
+
+    changed_cells = sum(a != b for aa, bb in zip(public_test[0]["output"], public_test[0]["rival_output"])
+                        for a, b in zip(aa, bb))
+    result = {
+        "schema": "arcpuzzles-task-local-rival-audit-v1",
+        "task_id": TASK_ID,
+        "status": "known_public_lesson_ambiguity_reproduced",
+        "source_hashes": source_hashes,
+        "racket": identity,
+        "racket_evaluations": evaluations,
+        "canonical_program": program,
+        "rival_name": "vertical_rank",
+        "rival_program": VERTICAL_RANK,
+        "rival_description": "Sort source objects by bbox top row then left column; put the first two in the top output row and the last two in the bottom, while retaining the canonical left/right orientation rule. Later objects overwrite cells if two are assigned the same quadrant.",
+        "selection": "Reproduce the exact canonical two-demo/one-query lesson and the vertical_rank hypothesis already retained in associated notes. No example or query search was performed. Separately inspect the predeclared seed 271828, medium difficulty, indices 0..7: demos 0..3 and queries 4..7.",
+        "canonical_lesson": {"train": public_train, "test": public_test},
+        "canonical_query_changed_cells": changed_cells,
+        "generated_lesson": {"seed": 271828, "difficulty": "medium", "demo_indices": [0, 1, 2, 3],
+            "query_indices": [4, 5, 6, 7], "train": demos, "test": queries,
+            "demo_refutation_indices": [i for i, p in enumerate(demos) if not p["rival_matches"]],
+            "declared_lesson_guard": "passed for each of the four queries"},
+        "alternative_answer_stream": {"original_lesson_retained": True,
+            "two_executable_rules_fit_all_visible_demonstrations": True,
+            "query_answers_differ": True,
+            "status": "proposal_only; no export or training admission performed"},
+        "interpretation": "Fresh executable recovery of an existing public-example ambiguity, not a new defect in the current generated four-demo curriculum. The inspected generated lesson refutes the rival before queries. Preserve the four-demo minimum and source-position permutation coverage.",
+        "limits": "One declared rival, one canonical lesson, and one generated four-demo/four-query window. This does not prove universal learnability, all-seed coverage, generator approval, or training admission.",
+        "approval_changed": False,
+        "training_admitted": False,
+    }
+    write_json(out, result)
+    summary = {"task_id": TASK_ID, "status": result["status"], "source_hashes": source_hashes,
+               "evidence": str(out.relative_to(ROOT)), "evidence_sha256": sha(out.read_bytes()),
+               "racket": identity, "racket_evaluations": evaluations,
+               "canonical_demos_fit": 2, "canonical_query_changed_cells": changed_cells,
+               "generated_demo_refutations": result["generated_lesson"]["demo_refutation_indices"],
+               "generated_queries_checked": 4, "limits": result["limits"]}
+    write_json(summary_path, summary)
+    print(json.dumps({k: summary[k] for k in ("status", "racket_evaluations", "canonical_demos_fit",
+          "canonical_query_changed_cells", "generated_demo_refutations", "generated_queries_checked")}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, default=HOME / "workspace/evidence/vertical-rank-current.json")
+    parser.add_argument("--summary", type=Path, required=True)
+    arguments = parser.parse_args()
+    run(arguments.out, arguments.summary)
