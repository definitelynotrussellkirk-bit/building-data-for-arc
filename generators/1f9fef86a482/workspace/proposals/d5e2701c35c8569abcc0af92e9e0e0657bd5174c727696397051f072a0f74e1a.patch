+#!/usr/bin/env python3
+"""Source-bound finite-rival lesson audit for ``fd3920f7cc99``.
+
+The intended rule top-left-aligns each cropped color-2 shape inside a global
+slot.  This probe asks whether plausible alignment/order/packing rivals fit all
+visible demonstrations yet disagree on the next query.  It is deliberately a
+finite audit, not a uniqueness proof.
+
+Run from the packet root so the bundled Racket authority is available::
+
+    python3 review.py run python3 \
+      generators/fd3920f7cc99/workspace/learnability_probe.py \
+      --lessons 256 --demos 3 --out ../checks/fd3920f7cc99/learnability.json
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Callable
+
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+TASK_ID = "fd3920f7cc99"
+EXPECTED_GENERATOR_SHA256 = "50d56d456a9327798fc4aece3381315a09559d7fc996ec1daba826be2378568c"
+DEFAULT_DIFFICULTY = "hard"
+
+Grid = list[list[int]]
+Shape = dict[str, Any]
+
+
+def _root() -> Path:
+    return find_root(__file__)
+
+
+def _generator():
+    module, path, digest = load_selected_generator(TASK_ID, root=_root())
+    if digest != EXPECTED_GENERATOR_SHA256:
+        raise ValueError(
+            f"peer source changed: expected {EXPECTED_GENERATOR_SHA256}, got {digest}"
+        )
+    return module, path, digest
+
+
+def _components(grid: Grid, color: int = 2) -> list[list[tuple[int, int]]]:
+    height = len(grid)
+    width = len(grid[0])
+    seen: set[tuple[int, int]] = set()
+    result: list[list[tuple[int, int]]] = []
+    for start_row in range(height):
+        for start_col in range(width):
+            start = (start_row, start_col)
+            if grid[start_row][start_col] != color or start in seen:
+                continue
+            pending = [start]
+            seen.add(start)
+            component: list[tuple[int, int]] = []
+            while pending:
+                row, col = pending.pop()
+                component.append((row, col))
+                for delta_row, delta_col in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    neighbor = (row + delta_row, col + delta_col)
+                    if (
+                        0 <= neighbor[0] < height
+                        and 0 <= neighbor[1] < width
+                        and neighbor not in seen
+                        and grid[neighbor[0]][neighbor[1]] == color
+                    ):
+                        seen.add(neighbor)
+                        pending.append(neighbor)
+            result.append(component)
+    return result
+
+
+def _shape(component: list[tuple[int, int]]) -> Shape:
+    top = min(row for row, _ in component)
+    left = min(col for _, col in component)
+    bottom = max(row for row, _ in component)
+    right = max(col for _, col in component)
+    return {
+        "top": top,
+        "left": left,
+        "height": bottom - top + 1,
+        "width": right - left + 1,
+        "area": len(component),
+        "cells": {(row - top, col - left) for row, col in component},
+    }
+
+
+def _extract(
+    grid: Grid,
+    *,
+    shape_order: str = "top",
+    color_order: str = "left",
+) -> tuple[list[int], list[Shape]]:
+    swatches = [(col, value) for col, value in enumerate(grid[0]) if value not in (0, 2)]
+    if color_order == "left":
+        swatches.sort(key=lambda item: item[0])
+    elif color_order == "right":
+        swatches.sort(key=lambda item: -item[0])
+    elif color_order == "value":
+        swatches.sort(key=lambda item: (item[1], item[0]))
+    else:
+        raise ValueError(f"unknown color order: {color_order}")
+
+    shapes = [_shape(component) for component in _components(grid)]
+    order_keys: dict[str, Callable[[Shape], tuple[int, ...]]] = {
+        "top": lambda shape: (shape["top"], shape["left"]),
+        "bottom": lambda shape: (-shape["top"], shape["left"]),
+        "left": lambda shape: (shape["left"], shape["top"]),
+        "area_ascending": lambda shape: (shape["area"], shape["top"], shape["left"]),
+        "area_descending": lambda shape: (-shape["area"], shape["top"], shape["left"]),
+    }
+    if shape_order not in order_keys:
+        raise ValueError(f"unknown shape order: {shape_order}")
+    shapes.sort(key=order_keys[shape_order])
+    return [value for _, value in swatches], shapes
+
+
+def render_gallery(
+    grid: Grid,
+    *,
+    shape_order: str = "top",
+    color_order: str = "left",
+    alignment: str = "top_left",
+    vertical_pack: str = "fixed",
+    horizontal_pack: str = "fixed",
+) -> Grid:
+    """Independent Python expression of the canonical rule and finite rivals."""
+    colors, shapes = _extract(grid, shape_order=shape_order, color_order=color_order)
+    if not colors or not shapes:
+        return [[0]]
+
+    slot_height = max(shape["height"] for shape in shapes)
+    slot_width = max(shape["width"] for shape in shapes)
+
+    if vertical_pack == "fixed":
+        top_offsets = [index * (slot_height + 1) for index in range(len(shapes))]
+        output_height = len(shapes) * slot_height + len(shapes) - 1
+    elif vertical_pack == "tight":
+        top_offsets = []
+        cursor = 0
+        for shape in shapes:
+            top_offsets.append(cursor)
+            cursor += shape["height"] + 1
+        output_height = cursor - 1
+    else:
+        raise ValueError(f"unknown vertical packing: {vertical_pack}")
+
+    if horizontal_pack == "fixed":
+        output_width = len(colors) * slot_width + len(colors) - 1
+    elif horizontal_pack == "tight":
+        output_width = max(
+            len(colors) * shape["width"] + len(colors) - 1 for shape in shapes
+        )
+    else:
+        raise ValueError(f"unknown horizontal packing: {horizontal_pack}")
+
+    output = [[0] * output_width for _ in range(output_height)]
+    for shape_index, shape in enumerate(shapes):
+        for color_index, color in enumerate(colors):
+            if horizontal_pack == "fixed":
+                left = color_index * (slot_width + 1)
+            else:
+                left = color_index * (shape["width"] + 1)
+
+            if alignment == "top_left":
+                row_shift = col_shift = 0
+            elif alignment == "center":
+                row_shift = (slot_height - shape["height"]) // 2 if vertical_pack == "fixed" else 0
+                col_shift = (slot_width - shape["width"]) // 2 if horizontal_pack == "fixed" else 0
+            elif alignment == "bottom_right":
+                row_shift = slot_height - shape["height"] if vertical_pack == "fixed" else 0
+                col_shift = slot_width - shape["width"] if horizontal_pack == "fixed" else 0
+            else:
+                raise ValueError(f"unknown alignment: {alignment}")
+
+            for row, col in shape["cells"]:
+                output[top_offsets[shape_index] + row_shift + row][left + col_shift + col] = color
+    return output
+
+
+RIVALS: dict[str, Callable[[Grid], Grid]] = {
+    "colors_by_value": lambda grid: render_gallery(grid, color_order="value"),
+    "colors_right_to_left": lambda grid: render_gallery(grid, color_order="right"),
+    "shapes_left_to_right": lambda grid: render_gallery(grid, shape_order="left"),
+    "shapes_area_ascending": lambda grid: render_gallery(grid, shape_order="area_ascending"),
+    "shapes_area_descending": lambda grid: render_gallery(grid, shape_order="area_descending"),
+    "shapes_bottom_to_top": lambda grid: render_gallery(grid, shape_order="bottom"),
+    "center_in_slots": lambda grid: render_gallery(grid, alignment="center"),
+    "bottom_right_in_slots": lambda grid: render_gallery(grid, alignment="bottom_right"),
+    "tight_vertical_pack": lambda grid: render_gallery(grid, vertical_pack="tight"),
+    "tight_horizontal_pack": lambda grid: render_gallery(grid, horizontal_pack="tight"),
+}
+
+
+def check_canonical_pairs() -> dict[str, Any]:
+    pairs = canonical_pairs(TASK_ID, root=_root(), labeled_only=True)
+    mismatches = []
+    for pair in pairs:
+        predicted = render_gallery(pair["input"])
+        if predicted != pair["output"]:
+            mismatches.append(
+                {
+                    "variant": pair["variant"],
+                    "split": pair["split"],
+                    "pair_index": pair["pair_index"],
+                }
+            )
+    return {"pair_count": len(pairs), "mismatches": mismatches}
+
+
+def _shape_summary(grid: Grid) -> list[dict[str, int]]:
+    _, shapes = _extract(grid)
+    return [
+        {
+            "top": shape["top"],
+            "left": shape["left"],
+            "height": shape["height"],
+            "width": shape["width"],
+            "area": shape["area"],
+        }
+        for shape in shapes
+    ]
+
+
+def _difference_cells(left: Grid, right: Grid) -> list[list[int]]:
+    max_rows = max(len(left), len(right))
+    max_cols = max(len(left[0]), len(right[0]))
+    return [
+        [row, col]
+        for row in range(max_rows)
+        for col in range(max_cols)
+        if (left[row][col] if row < len(left) and col < len(left[0]) else None)
+        != (right[row][col] if row < len(right) and col < len(right[0]) else None)
+    ]
+
+
+def scan_lessons(
+    lessons: int,
+    *,
+    demos: int = 3,
+    difficulty: str = DEFAULT_DIFFICULTY,
+    retain: int = 20,
+) -> dict[str, Any]:
+    if type(lessons) is not int or lessons < 1:
+        raise ValueError("lessons must be a positive integer")
+    if type(demos) is not int or demos < 1:
+        raise ValueError("demos must be a positive integer")
+    if type(retain) is not int or retain < 1:
+        raise ValueError("retain must be a positive integer")
+
+    generator, source_path, source_sha256 = _generator()
+    fit_counts: Counter[str] = Counter()
+    query_difference_counts: Counter[str] = Counter()
+    ambiguity_counts: Counter[str] = Counter()
+    ambiguous_lesson_count = 0
+    ambiguities: list[dict[str, Any]] = []
+    failures: list[dict[str, Any]] = []
+
+    for seed in range(lessons):
+        grids: list[Grid] = []
+        try:
+            for sample_index in range(demos + 1):
+                grid = generator.generate(seed, sample_index, difficulty=difficulty)
+                validation_errors = generator.self_check(grid, difficulty=difficulty)
+                if validation_errors:
+                    raise ValueError(
+                        f"sample {sample_index} failed self_check: {validation_errors}"
+                    )
+                if grid != generator.generate(seed, sample_index, difficulty=difficulty):
+                    raise AssertionError(f"sample {sample_index} is not deterministic")
+                grids.append(grid)
+        except Exception as error:  # Retain exact generation failures; do not shrink scope silently.
+            failures.append({"seed": seed, "error": f"{type(error).__name__}: {error}"})
+            continue
+
+        labels = [render_gallery(grid) for grid in grids]
+        survivors: list[str] = []
+        for name, rival in RIVALS.items():
+            fits_demos = all(rival(grids[index]) == labels[index] for index in range(demos))
+            differs_on_query = rival(grids[-1]) != labels[-1]
+            fit_counts[name] += int(fits_demos)
+            query_difference_counts[name] += int(differs_on_query)
+            if fits_demos and differs_on_query:
+                survivors.append(name)
+                ambiguity_counts[name] += 1
+
+        if survivors:
+            ambiguous_lesson_count += 1
+        if survivors and len(ambiguities) < retain:
+            rival_outputs = {name: RIVALS[name](grids[-1]) for name in survivors}
+            ambiguities.append(
+                {
+                    "seed": seed,
+                    "difficulty": difficulty,
+                    "demo_sample_indices": list(range(demos)),
+                    "query_sample_index": demos,
+                    "surviving_query_rivals": survivors,
+                    "demo_inputs": grids[:demos],
+                    "demo_outputs": labels[:demos],
+                    "query_input": grids[-1],
+                    "canonical_query_output": labels[-1],
+                    "rival_query_outputs": rival_outputs,
+                    "query_difference_cells": {
+                        name: _difference_cells(labels[-1], output)
+                        for name, output in rival_outputs.items()
+                    },
+                    "demo_shape_summaries": [_shape_summary(grid) for grid in grids[:demos]],
+                    "query_shape_summary": _shape_summary(grids[-1]),
+                }
+            )
+
+    return {
+        "schema": "fd3920f7cc99-finite-learnability-probe-v1",
+        "task_id": TASK_ID,
+        "source_path": source_path.relative_to(_root()).as_posix(),
+        "generator_sha256": source_sha256,
+        "difficulty": difficulty,
+        "lessons": lessons,
+        "demos_per_lesson": demos,
+        "query_sample_offset": demos,
+        "tested_rivals": list(RIVALS),
+        "fit_counts": dict(fit_counts),
+        "query_difference_counts": dict(query_difference_counts),
+        "ambiguity_counts": dict(ambiguity_counts),
+        "ambiguous_lesson_count": ambiguous_lesson_count,
+        "ambiguous_rival_occurrences": sum(ambiguity_counts.values()),
+        "retained_ambiguities": len(ambiguities),
+        "ambiguities": ambiguities,
+        "generation_failures": failures,
+        "limit": "Finite declared rivals and deterministic seed windows only; not a universal uniqueness proof.",
+    }
+
+
+def _canonical_program() -> str:
+    matches = []
+    with canonical_path(_root()).open(encoding="utf-8") as stream:
+        for raw in stream:
+            row = json.loads(raw)
+            if row.get("task_id") == TASK_ID:
+                matches.append(row["program_solution"])
+    if len(matches) != 1:
+        raise RuntimeError(f"expected one canonical row for {TASK_ID}, found {len(matches)}")
+    return matches[0]
+
+
+def _racket_literal(value: Any) -> str:
+    if isinstance(value, list):
+        return "(" + " ".join(_racket_literal(item) for item in value) + ")"
+    if type(value) is not int or not 0 <= value <= 9:
+        raise ValueError(f"not an ARC literal: {value!r}")
+    return str(value)
+
+
+def racket_replay(witness: dict[str, Any]) -> dict[str, Any]:
+    """Replay the retained witness with the exact canonical Racket source."""
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    inputs = [*witness["demo_inputs"], witness["query_input"]]
+    expected = [*witness["demo_outputs"], witness["canonical_query_output"]]
+    source = _canonical_program()
+    with RacketBridge() as bridge:
+        bridge.eval_text(f"(define fd392-probe-rule {wrap_rule(source)})")
+        actual = bridge.eval_text(
+            f"(map fd392-probe-rule '{_racket_literal(inputs)})"
+        )
+    return {
+        "protected_racket": True,
+        "program_sha256": hashlib.sha256(source.encode()).hexdigest(),
+        "evaluation_count": len(inputs),
+        "matches_independent_mirror": actual == expected,
+        "outputs": actual,
+    }
+
+
+def build_report(lessons: int, demos: int, difficulty: str) -> dict[str, Any]:
+    report = scan_lessons(lessons, demos=demos, difficulty=difficulty)
+    canonical = check_canonical_pairs()
+    report["canonical_pair_check"] = canonical
+    report["status"] = "finding" if report["ambiguities"] else "bounded_no_finding"
+    report["representative_racket_replay"] = None
+    if report["ambiguities"]:
+        report["representative_racket_replay"] = racket_replay(report["ambiguities"][0])
+    report["ok"] = (
+        not report["generation_failures"]
+        and not canonical["mismatches"]
+        and (
+            report["representative_racket_replay"] is None
+            or report["representative_racket_replay"]["matches_independent_mirror"]
+        )
+    )
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--lessons", type=int, default=256)
+    parser.add_argument("--demos", type=int, default=3)
+    parser.add_argument("--difficulty", default=DEFAULT_DIFFICULTY)
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args()
+    report = build_report(args.lessons, args.demos, args.difficulty)
+    rendered = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(rendered, encoding="utf-8")
+    else:
+        print(rendered, end="")
+    return 0 if report["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
