+"""Focused regression for the optional fd3920f7cc99 learnability probe."""
+from __future__ import annotations
+import hashlib
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import find_root
+
+TASK_ID = "fd3920f7cc99"
+EXPECTED_SOURCE_SHA256 = "50d56d456a9327798fc4aece3381315a09559d7fc996ec1daba826be2378568c"
+
+
+def _load_probe():
+    root = find_root(__file__)
+    path = root / "generators" / TASK_ID / "workspace" / "learnability_probe.py"
+    assert path.is_file(), f"missing reusable probe: {path}"
+    spec = importlib.util.spec_from_file_location(
+        f"_test_{TASK_ID}_{hashlib.sha256(str(path).encode()).hexdigest()}", path
+    )
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_seed_31_reproduces_center_alignment_query_ambiguity():
+    probe = _load_probe()
+    report = probe.scan_lessons(40, demos=3)
+    assert report["generator_sha256"] == EXPECTED_SOURCE_SHA256
+    witness = next(row for row in report["ambiguities"] if row["seed"] == 31)
+    assert report["ambiguous_lesson_count"] == 1
+    assert witness["surviving_query_rivals"] == ["center_in_slots"]
+    assert witness["demo_sample_indices"] == [0, 1, 2]
+    assert witness["query_sample_index"] == 3
+    assert witness["canonical_query_output"] != witness["rival_query_outputs"]["center_in_slots"]
+
+
+def test_independent_mirror_matches_every_retained_canonical_label():
+    probe = _load_probe()
+    report = probe.check_canonical_pairs()
+    assert report["pair_count"] >= 4
+    assert report["mismatches"] == []
