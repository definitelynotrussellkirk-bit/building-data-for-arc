+"""Replay one source-bound collision-marker teaching ambiguity.
+
+The five retained inputs are ordinary generator draws, selected from the
+bounded 16-input prefilter documented in the review checks.  The three-demo
+lesson is reviewer-assembled; this tool does not invoke a public worker.
+"""
+
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+
+TASK = "ae4c21eef1dc"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+EXPECTED_GENERATOR_SHA256 = "2c2c9c59a505cf117633ec73bf6de6ac9928042d55098eb4b511f82e99fff912"
+EXPECTED_PROGRAM_SHA256 = "98390401e3a673721c8fedbc91f1368755e24512c3a25c30cdacac3b96609900"
+DRAW_SPECS = (
+    ("demo_0", 0, 4),
+    ("demo_1", 0, 5),
+    ("demo_2", 0, 6),
+    ("query", 0, 7),
+    ("guard", 17, 4),
+)
+
+
+def _sha(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def _differences(left, right):
+    if len(left) != len(right) or any(len(a) != len(b) for a, b in zip(left, right)):
+        raise AssertionError("the overlap rival must preserve output dimensions")
+    return [{"row": r, "column": c, "intended": a, "rival": b}
+            for r, (row_a, row_b) in enumerate(zip(left, right))
+            for c, (a, b) in enumerate(zip(row_a, row_b)) if a != b]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+
+    generator, generator_path, generator_sha = load_selected_generator(TASK, root=ROOT)
+    if generator_sha != EXPECTED_GENERATOR_SHA256:
+        raise AssertionError("selected generator bytes differ from this retained finding")
+    canonical_path = ROOT / "shared/data/canonical/puzzles.jsonl"
+    record = next(record for record in map(json.loads, canonical_path.read_text().splitlines())
+                  if record.get("task_id") == TASK)
+    intended_program = record["program_solution"]
+    if _sha(intended_program) != EXPECTED_PROGRAM_SHA256:
+        raise AssertionError("canonical rule bytes differ from this retained finding")
+    collision_clause = "((and (not (= a 0)) (not (= b 0))) 8)"
+    if intended_program.count(collision_clause) != 1:
+        raise AssertionError("expected exactly one canonical collision clause")
+    rival_program = intended_program.replace(collision_clause,
+                                             "((and (not (= a 0)) (not (= b 0))) a)")
+
+    cases = {}
+    for name, seed, sample_index in DRAW_SPECS:
+        grid = generator.generate(seed, sample_index, difficulty="medium")
+        errors = generator.self_check(grid, difficulty="medium")
+        if errors:
+            raise AssertionError(f"retained ordinary input failed self_check: {name}: {errors}")
+        cases[name] = {
+            "provenance": {"origin": "ordinary_generator_draw", "seed": seed,
+                           "sample_index": sample_index, "difficulty": "medium", "overrides": {}},
+            "input": grid,
+            "self_check": errors,
+            "source_panel_overlaps": [
+                {"row": r, "column": c, "left_color": grid[r][c], "middle_color": grid[r][c + 6]}
+                for r in range(5) for c in range(5) if grid[r][c] and grid[r][c + 6]],
+        }
+
+    canonical_checks = []
+    evaluations = 0
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            if identity.get("backend") != "racket" or identity.get("protected") is not True:
+                raise AssertionError(f"protected real Racket evaluator required: {identity}")
+            for split in ("train", "test"):
+                for index, pair in enumerate(record[split]):
+                    actual = apply(intended_program, pair["input"])
+                    evaluations += 1
+                    if actual != pair["output"]:
+                        raise AssertionError(f"canonical fixture label mismatch: {split}/{index}")
+                    canonical_checks.append({"split": split, "index": index, "matches_saved_output": True})
+            for case in cases.values():
+                case["intended_output"] = apply(intended_program, case["input"])
+                evaluations += 1
+                case["rival_output"] = apply(rival_program, case["input"])
+                evaluations += 1
+                case["changed_cells"] = _differences(case["intended_output"], case["rival_output"])
+                case["outputs_agree"] = not case["changed_cells"]
+        finally:
+            bridge.close()
+
+    demo_names = ["demo_0", "demo_1", "demo_2"]
+    if not all(cases[name]["outputs_agree"] for name in demo_names):
+        raise AssertionError("the retained rival must fit every original demonstration")
+    if cases["query"]["outputs_agree"] or cases["guard"]["outputs_agree"]:
+        raise AssertionError("the retained query and independent guard must separate the rules")
+
+    def pair(name):
+        return {"input": deepcopy(cases[name]["input"]),
+                "output": deepcopy(cases[name]["intended_output"])}
+
+    report = {
+        "task_id": TASK,
+        "finding": "left_precedence_fits_overlap_free_demonstrations",
+        "source": {"generator_path": str(generator_path.relative_to(ROOT)),
+                   "generator_sha256": generator_sha,
+                   "canonical_path": str(canonical_path.relative_to(ROOT)),
+                   "canonical_program_sha256": _sha(intended_program),
+                   "probe_path": str(Path(__file__).resolve().relative_to(ROOT)),
+                   "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()},
+        "scope": {
+            "discovery": "one rival; 16 ordinary medium inputs, seeds 0 and 17, sample indices 0..7",
+            "replayed_unique_generated_inputs": len(cases),
+            "ordinary_inputs_regenerated_without_overrides": True,
+            "lesson_origin": "reviewer-assembled consecutive seed-0 ordinary draws 4,5,6 then query 7",
+            "public_worker_executed": False,
+            "public_worker_episode_admission": "not assessed",
+            "task_specific_lesson_identifiable_hook_present": hasattr(generator, "lesson_identifiable"),
+            "authored_inputs": 0,
+        },
+        "evaluator": identity,
+        "protected_racket_evaluations": evaluations,
+        "canonical_fixture_checks": canonical_checks,
+        "programs": {
+            "intended": {"sha256": _sha(intended_program), "source": intended_program},
+            "left_precedence_rival": {"sha256": _sha(rival_program), "source": rival_program,
+                                      "description": "Use the left color at overlapping source cells; retain all other exact canonical behavior."},
+        },
+        "cases": cases,
+        "original_ambiguous_lesson": {
+            "train": [pair(name) for name in demo_names], "test": [pair("query")],
+            "rival_query_output": deepcopy(cases["query"]["rival_output"]),
+            "rival_fits_all_visible_demonstrations": True,
+        },
+        "guard_proposal": {
+            "description": "Replace demo_0 with the separate ordinary guard input; keep demo_1, demo_2 and the original query.",
+            "guard_case": "guard", "rival_refuted": True,
+            "repaired_lesson": {"train": [pair(name) for name in ("guard", "demo_1", "demo_2")],
+                                "test": [pair("query")]},
+            "claim_limit": "This guard refutes the one retained rival; it does not prove universal identifiability.",
+        },
+        "retained_prior_limitations": {
+            "task_review_index_present": (ROOT / "generators" / TASK / "evidence/review_index.json").exists(),
+            "associated_notes_bytes": (ROOT / "generators" / TASK / "evidence/associated_notes.jsonl").stat().st_size,
+            "existing_summary_warning": "The production scattered-motif grammar does not match the canonical three-panel overlay grammar.",
+            "documentation_correction_needed": "SUMMARY calls the separators color 5; the exact canonical program and saved pairs use color 9.",
+            "disposition": "No historical disposition, production source, canonical source, or approval was changed.",
+        },
+    }
+    out = args.out.resolve()
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"out": str(out), "source_sha256": generator_sha,
+                      "canonical_program_sha256": _sha(intended_program),
+                      "rival_program_sha256": _sha(rival_program),
+                      "protected_racket_evaluations": evaluations,
+                      "query_changed_cells": cases["query"]["changed_cells"],
+                      "guard_changed_cells": cases["guard"]["changed_cells"]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
