+"""Bounded source-pinned movement review and demo-only finite-rival guard.
+
+At most sixteen ordinary draws, seeds 0/17, and three executable rivals.
+Lessons are assembled here from consecutive unique draws, not exported by the
+public worker. No overrides, authored inputs, source edits, or approval steps.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = "ac4b61e7b230"
+ROOT = Path(__file__).resolve().parents[3]
+HOME = ROOT / "generators" / TASK
+RUNTIME = ROOT / "shared/runtime"
+SOURCE_SHA = "7472decbbed2b49988fa904d58283f5cafb85897b6e131000f6fcd2fd7a9270e"
+RULE_SHA = "0fbd7ecdde31d31ec3a38099ee14cc5f97a84c514aa7f4f0f20d06c8a9e61c29"
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def bbox(cells):
+    return [min(r for r, _ in cells), min(c for _, c in cells),
+            max(r for r, _ in cells), max(c for _, c in cells)]
+
+
+def facts(grid):
+    red = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 2]
+    cyan = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 8]
+    a, b = bbox(red), bbox(cyan)
+    dr = b[0] - a[2] - 1 if a[2] < b[0] else b[2] + 1 - a[0] if a[0] > b[2] else 0
+    dc = b[1] - a[3] - 1 if a[3] < b[1] else b[3] + 1 - a[1] if a[1] > b[3] else 0
+    out = [[0] * len(grid[0]) for _ in grid]
+    for r, c in cyan:
+        out[r][c] = 8
+    for r, c in red:
+        out[r + dr][c + dc] = 2
+    return {"shape": [len(grid), len(grid[0])], "red_size": len(red), "cyan_size": len(cyan),
+            "red_bbox": a, "cyan_bbox": b, "red_translation": [dr, dc]}, out
+
+
+def rival_program(name):
+    move_red = {"largest_object_moves": "(>= (obj-size red) (obj-size cyan))",
+                "smallest_object_moves": "(<= (obj-size red) (obj-size cyan))",
+                "one_axis_larger_gap": "#t"}[name]
+    dr = "(if (>= (abs raw-dr) (abs raw-dc)) raw-dr 0)" if name == "one_axis_larger_gap" else "raw-dr"
+    dc = "(if (< (abs raw-dr) (abs raw-dc)) raw-dc 0)" if name == "one_axis_larger_gap" else "raw-dc"
+    return f"""(rule! (lambda (g)
+      (define (axis-shift lo hi target-lo target-hi)
+        (cond ((< hi target-lo) (- target-lo hi 1))
+              ((> lo target-hi) (- (+ target-hi 1) lo))
+              (else 0)))
+      (let* ((objs (objects g 0))
+             (red (find (lambda (o) (= (obj-color o) 2)) objs))
+             (cyan (find (lambda (o) (= (obj-color o) 8)) objs))
+             (move-red? {move_red})
+             (mover (if move-red? red cyan))
+             (anchor (if move-red? cyan red))
+             (a (obj-bbox mover)) (b (obj-bbox anchor))
+             (raw-dr (axis-shift (first a) (third a) (first b) (third b)))
+             (raw-dc (axis-shift (second a) (fourth a) (second b) (fourth b)))
+             (dr {dr}) (dc {dc})
+             (base (recolor-cells (empty-grid (rows g) (cols g) 0)
+                                  (obj-cells anchor) (obj-color anchor))))
+        (for/fold ((out base)) ((cell (in-list (obj-cells mover))))
+          (set-cell out (+ (first cell) dr) (+ (second cell) dc) (obj-color mover))))))"""
+
+
+def changed_cells(a, b):
+    assert len(a) == len(b) and all(len(ar) == len(br) for ar, br in zip(a, b))
+    return sum(x != y for ar, br in zip(a, b) for x, y in zip(ar, br))
+
+
+def demo_only_guard(demonstrations, apply_program, rivals):
+    """No query/seed metadata argument; execution errors propagate as failures."""
+    refutations = {name: [i for i, pair in enumerate(demonstrations)
+                          if apply_program(program, pair["input"]) != pair["output"]]
+                   for name, program in rivals.items()}
+    return {"surviving_rivals": [name for name, indices in refutations.items() if not indices],
+            "refutations_by_demo_index": refutations}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    source = HOME / "generator.py"
+    assert sha(source.read_bytes()) == SOURCE_SHA
+    canonical_path = ROOT / "shared/data/canonical/puzzles.jsonl"
+    canonical = next(row for line in canonical_path.read_text().splitlines()
+                     if (row := json.loads(line))["task_id"] == TASK)
+    intended = canonical["program_solution"]
+    assert sha(intended.encode()) == RULE_SHA
+    rivals = {name: rival_program(name) for name in
+              ("largest_object_moves", "smallest_object_moves", "one_axis_larger_gap")}
+    report = {
+        "schema": "ac4b61e7b230-movement-review-v1", "task_id": TASK,
+        "source_sha256": SOURCE_SHA, "rule_sha256": RULE_SHA,
+        "normalized_rule_hash": sha(" ".join(intended.split()).encode())[:12],
+        "probe_sha256": sha(Path(__file__).read_bytes()),
+        "scope": {"seed_budget": [0, 17], "maximum_ordinary_draws": 16, "rival_count": 3,
+                  "difficulty": None, "overrides": {}, "demo_counts": [3, 2, 4, 5, 6],
+                  "query_count": "up to four following unique draws within eight draws per seed",
+                  "assembly": "reviewer-assembled consecutive unique ordinary draws; no public worker/export invocation",
+                  "size_tie_policy": "red moves", "single_axis_tie_policy": "row axis"},
+        "historical_finding": {"return_id": "review-e1761e6b26a45a91:v0001", "resolution": "needs_triage",
+                               "note": "Authority-text divergence/portable-test finding remains unchanged and is not reaudited here."},
+        "rivals": {name: {"program": program, "sha256": sha(program.encode())} for name, program in rivals.items()},
+        "canonical": [], "generated": [], "witness": None,
+    }
+    (args.out / "intended.rkt").write_text(intended)
+    for name, program in rivals.items():
+        (args.out / f"{name}.rkt").write_text(program)
+    calls = 0
+    with _local_imports(RUNTIME, HOME / "workspace"):
+        from reviewer_support import load_selected_generator
+        module, selected, source_sha = load_selected_generator(TASK, root=ROOT)
+        assert Path(selected).resolve() == source.resolve() and source_sha == SOURCE_SHA
+        evaluator, identity, bridge = _real_evaluator(RUNTIME)
+        report["runtime"] = identity
+
+        def apply_program(program, grid):
+            nonlocal calls
+            calls += 1
+            return evaluator(program, grid)
+
+        def label(grid):
+            assert module.self_check(grid) == []
+            feature, independent = facts(grid)
+            actual = apply_program(intended, grid)
+            assert actual == independent
+            outputs = {name: apply_program(program, grid) for name, program in rivals.items()}
+            return {"input": grid, "output": actual, "features": feature,
+                    "rival_outputs": outputs,
+                    "changed_cells": {name: changed_cells(actual, out) for name, out in outputs.items()}}
+
+        try:
+            for split in ("train", "test"):
+                for index, pair in enumerate(canonical[split]):
+                    row = label(pair["input"])
+                    assert row["output"] == pair["output"]
+                    report["canonical"].append({"split": split, "index": index, **row})
+            report["canonical_demo_guard"] = demo_only_guard(canonical["train"], apply_program, rivals)
+            report["canonical_query_disagreements_by_surviving_rival"] = {
+                name: [row["index"] for row in report["canonical"]
+                       if row["split"] == "test" and row["changed_cells"][name]]
+                for name in report["canonical_demo_guard"]["surviving_rivals"]}
+            for seed in (0, 17):
+                records, seen = [], {}
+                for index in range(8):
+                    grid = module.generate(seed=seed, sample_index=index)
+                    row = {"seed": seed, "sample_index": index, **label(grid)}
+                    row["scene_profile"] = module.observe_overrides(grid)["scene_profile"]
+                    key = json.dumps(grid)
+                    row["duplicate_of"] = seen.get(key)
+                    report["generated"].append(row)
+                    if key not in seen:
+                        records.append(row)
+                        seen[key] = index
+                for demo_count in (3, 2, 4, 5, 6):
+                    demos, queries = records[:demo_count], records[demo_count:demo_count + 4]
+                    if len(demos) != demo_count or not queries:
+                        continue
+                    for name in rivals:
+                        if not all(row["changed_cells"][name] == 0 for row in demos):
+                            continue
+                        wrong = [row["sample_index"] for row in queries if row["changed_cells"][name]]
+                        if wrong:
+                            visible = [{"input": row["input"], "output": row["output"]} for row in demos]
+                            report["witness"] = {
+                                "scope": report["scope"]["assembly"], "seed": seed, "difficulty": None, "overrides": {},
+                                "demo_indices": [row["sample_index"] for row in demos],
+                                "query_indices": [row["sample_index"] for row in queries],
+                                "rival_name": name, "differing_query_indices": wrong,
+                                "train": visible,
+                                "test": [{"input": row["input"], "output": row["output"]} for row in queries],
+                                "protected_rival_train_outputs": [row["rival_outputs"][name] for row in demos],
+                                "protected_rival_test_outputs": [row["rival_outputs"][name] for row in queries],
+                                "query_changed_cells": [row["changed_cells"][name] for row in queries],
+                                "demo_only_guard": demo_only_guard(visible, apply_program, rivals),
+                            }
+                            assert name in report["witness"]["demo_only_guard"]["surviving_rivals"]
+                            break
+                    if report["witness"]:
+                        break
+                if report["witness"]:
+                    break
+        except Exception as error:
+            report["execution_error"] = {"type": type(error).__name__, "message": str(error)}
+            report["status"] = "execution_failed_not_refutation"
+            raise
+        finally:
+            bridge.close()
+            report["protected_evaluations"] = calls
+            report["ordinary_inputs_drawn"] = len(report["generated"])
+            report.setdefault("status", "finite_movement_ambiguity" if report["witness"] else "bounded_no_finding")
+            (args.out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    assert sha(source.read_bytes()) == SOURCE_SHA
+    assert len(report["generated"]) <= 16
+    if report["witness"]:
+        (args.out / "witness.json").write_text(json.dumps(report["witness"], indent=2) + "\n")
+    print(json.dumps({"status": report["status"], "ordinary_inputs_drawn": report["ordinary_inputs_drawn"],
+                      "protected_evaluations": calls,
+                      "witness": None if not report["witness"] else {key: report["witness"][key] for key in
+                          ("seed", "demo_indices", "query_indices", "rival_name", "query_changed_cells")}}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
