(rule!
  (let ((dummy 0))
    (define (split-panel-row grid count)
      (let ((pw (quotient (- (cols grid) (- count 1)) count)))
        (for/list ((i (in-range count)))
          (let ((left (* i (+ pw 1))))
            (grid-from-fn (rows grid) pw
              (lambda (r c) (at grid r (+ left c))))))))
    (define (nonzero-cells grid)
      (filter (lambda (p) (not (= (at grid (first p) (second p)) 0)))
              (grid-positions grid)))
    (let* ((panels (split-panel-row g 3))
           (a (first panels))
           (b (second panels))
           (cgrid (third panels))
           (cells-a (nonzero-cells a))
           (cells-b (nonzero-cells b))
           (cells-c (nonzero-cells cgrid))
           (bb-a (bbox-of-cells cells-a))
           (bb-c (bbox-of-cells cells-c))
           (removed
             (map (lambda (p)
                    (list (- (first p) (first bb-a))
                          (- (second p) (second bb-a))))
                  (filter (lambda (p) (not (member? p cells-b))) cells-a)))
           (c-color (at cgrid (first (first cells-c)) (second (first cells-c))))
           (repaired
             (grid-from-fn (rows cgrid) (cols cgrid)
               (lambda (r c)
                 (if (and (>= r (first bb-c)) (<= r (third bb-c))
                          (>= c (second bb-c)) (<= c (fourth bb-c)))
                     c-color
                     (at cgrid r c))))))
      (for/fold ((out repaired)) ((p (in-list removed)))
        (let ((rr (+ (first bb-c) (first p)))
              (cc (+ (second bb-c) (second p))))
          (if (in-bounds? rr cc (rows out) (cols out))
              (set-cell out rr cc 0)
              out))))))
