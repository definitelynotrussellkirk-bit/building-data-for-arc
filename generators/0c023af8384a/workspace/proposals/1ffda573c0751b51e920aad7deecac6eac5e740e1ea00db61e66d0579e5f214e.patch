+"""Unit tests for the reusable lesson-analysis portion of the review probe."""
+from copy import deepcopy
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def probe():
+    path = Path(__file__).resolve().parents[1] / "workspace/review_probe.py"
+    assert path.is_file(), "Missing reference-checked review probe"
+    spec = importlib.util.spec_from_file_location("review_probe_under_test", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def pair(g):
+    return {"input": g, "output": [[b or a] for [a], [b] in zip(g, reversed(g))]}
+
+
+def preserve(g):
+    return [[a or b] for [a], [b] in zip(g, reversed(g))]
+
+
+def test_lesson_audit_separates_ambiguity_from_surviving_harmless_rivals(probe):
+    lessons = [
+        {"band": "easy", "seed": 0, "sample_index": 0,
+         "demos": [pair([[1], [0]])], "query": pair([[1], [2]])},
+        {"band": "easy", "seed": 1, "sample_index": 0,
+         "demos": [pair([[1], [0]])], "query": pair([[2], [0]])},
+        {"band": "easy", "seed": 2, "sample_index": 0,
+         "demos": [pair([[1], [2]])], "query": pair([[3], [4]])},
+    ]
+    saved = deepcopy(lessons)
+    result = probe.analyze_lessons(lessons, {"preserve occupied": preserve})
+    assert result["total_lessons"] == 3
+    assert result["ambiguous_lessons"] == 1
+    assert result["rivals"]["preserve occupied"] == {
+        "refuted": 1, "survived_same_query": 1, "survived_wrong_query": 1}
+    assert result["examples"][0]["seed"] == 0
+    assert lessons == saved
+
+
+def test_lesson_audit_records_rival_errors_as_failures(probe):
+    def broken(g):
+        raise ValueError("bad rival")
+    lesson = {"band": "easy", "seed": 0, "sample_index": 0,
+              "demos": [pair([[1], [0]])], "query": pair([[1], [2]])}
+    with pytest.raises(ValueError, match="bad rival"):
+        probe.analyze_lessons([lesson], {"broken": broken})
+
+
+def test_profile_recovers_mirror_structure(probe):
+    p = probe.profile([[1, 4, 0], [0, 2, 0], [3, 4, 5]])
+    assert p["marks"] == 6
+    assert p["conflicting_pairs"] == 1
+    assert p["same_color_pairs"] == 1
+    assert p["axis_marks"] == 1
+    assert p["lone_sources"] == 1
+
+
+def test_oracle_cases_include_all_ordered_pairs_and_axis_colors(probe):
+    grids = probe.exhaustive_orbit_cases()
+    assert len(grids) == 1100
+    assert [[0], [0]] in grids
+    assert [[9], [1]] in grids
+    assert [[1], [9], [2]] in grids
