+"""Task-local contract regressions; run from any working directory with pytest."""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import importlib.util
+import itertools
+import json
+from pathlib import Path
+import sys
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+REPO = HOME.parents[1]
+sys.path.insert(0, str(REPO / "shared/runtime"))
+spec = importlib.util.spec_from_file_location("mirror_generator_under_test", HOME / "generator.py")
+gen = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(gen)
+
+
+def reference(grid):
+    """Independent cellwise expression for overlay(g, flip_ud(g))."""
+    return [[b or a for a, b in zip(row, mirrored)]
+            for row, mirrored in zip(grid, reversed(grid))]
+
+
+def canonical():
+    with (REPO / "shared/data/canonical/puzzles.jsonl").open() as stream:
+        return next(row for line in stream
+                    if (row := json.loads(line))["task_id"] == gen.TASK_ID)
+
+
+def nonzeros(grid):
+    return sum(value != 0 for row in grid for value in row)
+
+
+def collisions(grid):
+    return [(r, c) for r in range(len(grid) // 2) for c in range(len(grid[0]))
+            if grid[r][c] and grid[-1-r][c] and grid[r][c] != grid[-1-r][c]]
+
+
+def pair(grid):
+    return {"input": grid, "output": reference(grid)}
+
+
+def test_reference_pin_and_every_canonical_pair():
+    row = canonical()
+    assert getattr(gen, "RULE_HASH", None) == hashlib.sha256(
+        " ".join(row["program_solution"].split()).encode()).hexdigest()[:12]
+    for example in row["train"] + row["test"]:
+        assert gen.self_check(example["input"]) == []
+        assert reference(example["input"]) == example["output"]
+        assert gen._mirror(example["input"]) == example["output"]
+
+
+@pytest.mark.parametrize("overrides", [{"texture": "typo"}, {"mark": 3}, {"grid_heigth": 6}])
+def test_unknown_overrides_fail_loudly(overrides):
+    with pytest.raises((TypeError, ValueError)):
+        gen.generate(0, 0, **overrides)
+
+
+@pytest.mark.parametrize("name", ["grid_h", "grid_w", "marks"])
+@pytest.mark.parametrize("value", [True, 6.5, "6"])
+def test_integer_axes_do_not_silently_coerce(name, value):
+    with pytest.raises((TypeError, ValueError)):
+        gen.generate(0, 0, **{name: value})
+
+
+@pytest.mark.parametrize("difficulty", [None, "easy", "medium", "hard"])
+def test_single_axis_overrides_are_exact_in_every_band(difficulty):
+    for name, values in {"grid_h": range(4, 17), "grid_w": range(5, 19),
+                         "marks": range(1, 21)}.items():
+        for value in values:
+            for seed in (0, 1, 17):
+                grid = gen.generate(seed, 0, difficulty=difficulty, **{name: value})
+                actual = {"grid_h": len(grid), "grid_w": len(grid[0]), "marks": nonzeros(grid)}
+                assert actual[name] == value, (difficulty, seed, name, value, actual)
+                assert gen.self_check(grid) == []
+
+
+@pytest.mark.parametrize("texture,minimum", [("plain", 1), ("dense", 1),
+                                            ("swap_pair", 2), ("on_axis", 2),
+                                            ("same_pair", 3)])
+def test_texture_count_is_total_occupied_cells(texture, minimum):
+    for count in range(minimum, 21):
+        grid = gen.generate(0, count, texture=texture, marks=count)
+        assert nonzeros(grid) == count
+        assert gen.self_check(grid) == []
+        if texture == "on_axis":
+            assert len(grid) % 2 and any(grid[len(grid) // 2])
+        elif texture == "swap_pair":
+            assert collisions(grid)
+        elif texture == "same_pair":
+            assert any(grid[r][c] and grid[r][c] == grid[-1-r][c]
+                       for r in range(len(grid) // 2) for c in range(len(grid[0])))
+
+
+@pytest.mark.parametrize("overrides,axes", [
+    ({"texture": "on_axis", "grid_h": 6}, {"texture", "grid_h"}),
+    ({"texture": "on_axis", "marks": 1}, {"texture", "marks"}),
+    ({"texture": "swap_pair", "marks": 1}, {"texture", "marks"}),
+    ({"texture": "same_pair", "marks": 2}, {"texture", "marks"}),
+    ({"texture": "plain", "grid_h": 4, "grid_w": 5, "marks": 20},
+     {"grid_h", "grid_w", "marks"}),
+])
+def test_incompatible_pins_are_rejected_not_changed(overrides, axes):
+    with pytest.raises(ValueError) as caught:
+        gen.generate(0, 0, **overrides)
+    assert set(getattr(caught.value, "incompatible_axes", ())) == axes
+
+
+@pytest.mark.parametrize("grid", [None, [], [[]], [[1], [0, 0]], [[10], [0]],
+                                   [[-1], [0]], [[True], [0]], [[1.5], [0]],
+                                   [["1"], [0]], ["10", "00"]])
+def test_self_check_rejects_malformed_grids_without_crashing(grid):
+    assert gen.self_check(grid)
+
+
+def test_lawful_small_shapes_remain_accepted():
+    for grid in ([[1], [0]], [[1, 1, 1], [0, 0, 0]],
+                 [[2, 2, 0], [2, 2, 0], [0, 0, 0], [0, 0, 0]]):
+        assert gen.self_check(grid) == []
+        assert gen._mirror(grid) == reference(grid)
+
+
+@pytest.mark.parametrize("texture", ["empty_grid", "already_symmetric"])
+def test_negative_fixtures_stay_outside_ordinary_domain(texture):
+    assert texture not in gen.AXES["texture"]["valid"].split("|")
+    for seed in range(12):
+        grid = gen.generate(seed, 0, texture=texture)
+        assert reference(grid) == grid
+        assert gen.self_check(grid)
+
+
+def test_pairwise_reference_exhaustive_and_non_mutating():
+    for a, b in itertools.product(range(10), repeat=2):
+        grid = [[a, 0], [0, 7], [b, 0]]
+        saved = deepcopy(grid)
+        assert gen._mirror(grid) == reference(grid)
+        assert grid == saved
+
+
+def test_rivals_fit_canonical_but_swap_counterexample_refutes_them():
+    shortcuts = getattr(gen, "CANONICAL_SHORTCUTS", {})
+    assert shortcuts, "Missing executable canonical-surviving rival rules"
+    row = canonical()
+    for name, rival in shortcuts.items():
+        assert all(rival(p["input"]) == p["output"] for p in row["train"] + row["test"]), name
+        grid = [[1], [2]]
+        assert rival(grid) != reference(grid), name
+
+
+def test_identifiability_detects_insufficient_demonstrations():
+    hook = getattr(gen, "lesson_identifiable", None)
+    assert callable(hook), "Missing lesson-identifiability hook"
+    demos = [pair([[1], [0]]), pair([[0], [2]])]
+    assert any("preserve occupied" in reason for reason in hook(demos, pair([[1], [2]])))
+    assert hook(demos + [pair([[1], [2]])], pair([[3], [4]])) == []
+    bad = pair([[1], [2]])
+    bad["output"] = [[1], [2]]
+    assert hook([bad], pair([[3], [4]]))
+
+
+@pytest.mark.parametrize("difficulty", [None, "easy", "medium", "hard"])
+def test_every_three_consecutive_default_demos_refute_declared_rivals(difficulty):
+    hook = getattr(gen, "lesson_identifiable", None)
+    assert callable(hook), "Missing lesson-identifiability hook"
+    for seed in (0, 1, 17, 731):
+        grids = [gen.generate(seed, i, difficulty=difficulty) for i in range(21)]
+        for start in range(18):
+            demos = [pair(g) for g in grids[start:start+3]]
+            query = pair(grids[start+3])
+            assert hook(demos, query) == [], (seed, start, difficulty)
+            for name, rival in gen.LESSON_COMPETITORS.items():
+                assert any(rival(p["input"]) != p["output"] for p in demos), (seed, start, name)
+
+
+def test_observer_reports_realized_counts_and_determinism():
+    observer = getattr(gen, "observe_overrides", None)
+    assert callable(observer), "Missing realized-axis observer"
+    for seed in range(20):
+        g = gen.generate(seed, 2)
+        assert gen.generate(seed, 2) == g
+        assert observer(g) == {"grid_h": len(g), "grid_w": len(g[0]), "marks": nonzeros(g)}
+
+
+def test_sequence_rows_are_accepted_without_mutation():
+    grid = ((1,), (0,))
+    assert gen.self_check(grid) == []
+    assert gen._mirror(grid) == [[1], [1]]
+    assert grid == ((1,), (0,))
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_every_nine_default_draws_retain_three_canonical_scale_examples(band):
+    # This is an independent distribution contract, not the battery's pinned
+    # seeds or marginal threshold. Keep the original scale in every band.
+    for seed in (101, 987, 31415):
+        for start in (0, 11, 100):
+            grids = [gen.generate(seed, start + i, difficulty=band) for i in range(9)]
+            anchored = [g for g in grids if 7 <= len(g) <= 10 and 8 <= len(g[0]) <= 12
+                        and 3 <= nonzeros(g) <= 4
+                        and 4 <= len({v for row in g for v in row}) <= 5]
+            assert len(anchored) >= 3, (seed, start, band, len(anchored))
