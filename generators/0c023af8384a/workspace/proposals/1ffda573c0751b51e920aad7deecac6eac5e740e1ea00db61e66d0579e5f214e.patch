+        if not isinstance(example, dict) or "input" not in example or "output" not in example:
+            errors.append(f"pair {index} must contain input and output")
+        elif _grid_errors(example["input"]) or _grid_errors(example["output"]):
+            errors.append(f"pair {index} contains an invalid grid")
+        elif _mirror(example["input"]) != example["output"]:
+            errors.append(f"pair {index} output disagrees with the pinned mirror-overlay rule")
+    if errors:
+        return errors
+    return [f"demonstrations do not refute rival: {name}"
+            for name, rival in LESSON_COMPETITORS.items()
+            if all(rival(p["input"]) == p["output"] for p in demos)
+            and rival(query["input"]) != query["output"]]
+
+
+def mutation_fixtures():
+    return [("blank", [[0, 0], [0, 0]]), ("same-color mirror partners", [[1], [1]]),
+            ("axis-only", [[0], [2], [0]]), ("out-of-palette", [[10], [0]]),
+            ("ragged", [[1], [0, 0]])]
