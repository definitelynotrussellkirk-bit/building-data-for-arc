+"""Collect every strict battery stage without editing or relaxing shared gates.
+
+From the packet root:
+  python3 run_with_racket.py python3 generators/0c023af8384a/workspace/run_battery.py \
+      --task-id 0c023af8384a --phase after --out ../checks/after-full
+
+The optional --task-id makes this useful to subsequent generator reviewers.
+Output must be new. A failed gate remains a nonzero exit and failed receipt.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+
+REPO = Path(__file__).resolve().parents[3]
+
+
+def battery_command(task_id: str, phase: str) -> list[str]:
+    return ["bash", "scripts/run_generator_battery.sh", task_id, phase, "--fresh", "--keep-going"]
+
+
+def check_output(path: Path) -> None:
+    if path.exists():
+        raise FileExistsError(f"Evidence destination must be new: {path}")
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--task-id", default=Path(__file__).resolve().parents[1].name)
+    parser.add_argument("--phase", choices=("before", "after"), default="after")
+    parser.add_argument("--timeout", type=float, default=1200)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.timeout <= 0:
+        parser.error("--timeout must be positive")
+    out = args.out.resolve()
+    check_output(out)
+    sys.path.insert(0, str(REPO / "src"))
+    from arcpuzzles.catalog import Catalog
+    from arcpuzzles.runtime import prepare_runtime, run_process
+    catalog = Catalog(REPO)
+    task_id = catalog.resolve(args.task_id)
+    with tempfile.TemporaryDirectory(prefix="arc-review-all-stages-") as directory:
+        stage = Path(directory)
+        manifest = prepare_runtime(catalog, stage, task_id)
+        run = run_process(battery_command(task_id, args.phase), stage, timeout=args.timeout)
+        summary_path = stage / f"checks/{task_id}_{args.phase}_battery_summary.json"
+        summary = json.loads(summary_path.read_text()) if summary_path.is_file() else None
+        # Exclusive directory creation also protects against a competing writer
+        # that created the destination after check_output().
+        out.mkdir(parents=True, exist_ok=False)
+        if (stage / "checks").is_dir():
+            shutil.copytree(stage / "checks", out / "checks")
+        result = {**run, "schema": "arcpuzzles-task-review-battery-v1", "task_id": task_id,
+                  "phase": args.phase, "keep_going": True, "runtime_manifest": manifest,
+                  "battery_summary": summary,
+                  "passed": run["exit_code"] == 0 and not run["timed_out"] and summary is not None}
+        (out / "result.json").write_text(json.dumps(result, indent=2) + "\n")
+        print(json.dumps({key: result[key] for key in
+                          ("task_id", "phase", "exit_code", "timed_out", "passed")}))
+    return 0 if result["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
