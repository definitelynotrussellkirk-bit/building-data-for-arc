+"""Reference-checked mirror census and finite-rival lesson audit.
+
+Run from the packet root (outputs must be new):
+  python3 run_with_racket.py python3 generators/0c023af8384a/workspace/review_probe.py \
+      --baseline ../.review/baseline/repo/generators/0c023af8384a/generator.py \
+      --out ../checks/mirror-probe
+
+The lesson analysis is reusable with arbitrary callable rivals. Mirror-specific
+profiles and exhaustive cases are intentionally task-local. ALL recorded labels
+come from the selected Racket rule through the repository's own rule wrapper.
+Python mirrors/rivals are audited against those labels, never used as teachers.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import importlib.util
+import itertools
+import json
+from pathlib import Path
+import sys
+import tempfile
+import time
+import traceback
+from typing import Callable, Any
+
+HOME = Path(__file__).resolve().parents[1]
+REPO = HOME.parents[1]
+TASK_ID = HOME.name
+Grid = list[list[int]]
+
+
+def analyze_lessons(lessons: list[dict], rivals: dict[str, Callable], *,
+                    max_examples: int = 12) -> dict:
+    """Distinguish a refuted rival from a surviving harmless/harmful one.
+
+    Rivals receive isolated copies. Errors are failures, never evidence of
+    refutation. A lesson is ambiguous only when the SAME rival fits every
+    demonstration and predicts a DIFFERENT query output.
+    """
+    counts = {name: {"refuted": 0, "survived_same_query": 0, "survived_wrong_query": 0}
+              for name in rivals}
+    examples, ambiguous = [], 0
+    for lesson in lessons:
+        if not lesson.get("demos"):
+            raise ValueError("A lesson must contain at least one demonstration")
+        wrong = {}
+        for name, rival in rivals.items():
+            if not all(rival(deepcopy(p["input"])) == p["output"] for p in lesson["demos"]):
+                counts[name]["refuted"] += 1
+                continue
+            predicted = rival(deepcopy(lesson["query"]["input"]))
+            same = predicted == lesson["query"]["output"]
+            counts[name]["survived_same_query" if same else "survived_wrong_query"] += 1
+            if not same:
+                wrong[name] = predicted
+        if wrong:
+            ambiguous += 1
+            if len(examples) < max_examples:
+                examples.append({**deepcopy(lesson), "wrong_predictions": wrong})
+    return {"total_lessons": len(lessons), "ambiguous_lessons": ambiguous,
+            "rivals": counts, "examples": examples}
+
+
+def profile(grid: Grid) -> dict[str, int]:
+    h, w = len(grid), len(grid[0])
+    pairs = [(grid[r][c], grid[-1-r][c]) for r in range(h // 2) for c in range(w)]
+    return {"height": h, "width": w, "marks": sum(bool(v) for row in grid for v in row),
+            "palette_size": len({v for row in grid for v in row}),
+            "conflicting_pairs": sum(bool(a and b and a != b) for a, b in pairs),
+            "same_color_pairs": sum(bool(a and b and a == b) for a, b in pairs),
+            "lone_sources": sum(bool(a) != bool(b) for a, b in pairs),
+            "axis_marks": sum(bool(v) for v in grid[h // 2]) if h % 2 else 0}
+
+
+def exhaustive_orbit_cases() -> list[Grid]:
+    return ([[[a], [b]] for a, b in itertools.product(range(10), repeat=2)]
+            + [[[a], [c], [b]] for a, b, c in itertools.product(range(10), repeat=3)])
+
+
+def cellwise_reference(grid: Grid) -> Grid:
+    """Independent expression, not a call to the generator's Python helper."""
+    return [[b or a for a, b in zip(row, mirrored)]
+            for row, mirrored in zip(grid, reversed(grid))]
+
+
+def load_generator(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Cannot load generator: {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def stable_seed(kind: str, band: str | None, index: int) -> int:
+    text = f"mirror-review-v1:{kind}:{band}:{index}"
+    return int(hashlib.sha256(text.encode()).hexdigest()[:12], 16)
+
+
+def digest(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def grid_key(grid: Grid) -> str:
+    return json.dumps(grid, separators=(",", ":"))
+
+
+def racket_data(value: Any) -> str:
+    # Never interpolate source text from grids. Only bounded ARC integers and
+    # literal lists enter the quoted data expression.
+    if type(value) is int and 0 <= value <= 9:
+        return str(value)
+    if isinstance(value, (list, tuple)) and value:
+        return "(" + " ".join(racket_data(v) for v in value) + ")"
+    raise ValueError(f"Not nonempty ARC grid data: {value!r}")
+
+
+class RacketLabels:
+    """Deduplicated batched reference calls, with a replayable JSONL receipt."""
+    def __init__(self, bridge, wrapped_rule: str, stream, batch_size: int = 25):
+        self.bridge, self.wrapped_rule = bridge, wrapped_rule
+        self.stream, self.batch_size = stream, batch_size
+        self.cache: dict[str, Grid] = {}
+        self.calls = 0
+
+    def label(self, grids: list[Grid]) -> list[dict[str, Grid]]:
+        missing = list({grid_key(g): g for g in grids if grid_key(g) not in self.cache}.values())
+        for start in range(0, len(missing), self.batch_size):
+            batch = missing[start:start + self.batch_size]
+            # Inline the callable in EACH batch; bridge restart cannot silently
+            # lose a previously defined variable and invalidate later evidence.
+            expression = f"(map {self.wrapped_rule} '{racket_data(batch)})"
+            outputs = self.bridge.eval_text(expression)
+            self.calls += 1
+            if not isinstance(outputs, list) or len(outputs) != len(batch):
+                raise RuntimeError("Racket returned an invalid batch shape")
+            for grid, output in zip(batch, outputs):
+                if cellwise_reference(grid) != output:
+                    raise AssertionError({"input": grid, "racket_output": output,
+                                          "cellwise_output": cellwise_reference(grid)})
+                key = grid_key(grid)
+                self.cache[key] = output
+                self.stream.write(json.dumps({"input_sha256": hashlib.sha256(key.encode()).hexdigest(),
+                                               "input": grid, "output": output}, separators=(",", ":")) + "\n")
+        return [{"input": deepcopy(g), "output": deepcopy(self.cache[grid_key(g)])} for g in grids]
+
+
+def summarize_profiles(grids: list[Grid], canonical: list[dict]) -> dict:
+    profiles = [profile(g) for g in grids]
+    canonical_profiles = [profile(p["input"]) for p in canonical]
+    exact = {(p["height"], p["width"], p["palette_size"]) for p in canonical_profiles}
+    ranges = {k: (min(p[k] for p in canonical_profiles), max(p[k] for p in canonical_profiles))
+              for k in ("height", "width", "palette_size")}
+    return {"inputs": len(grids), "unique_inputs": len({grid_key(g) for g in grids}),
+            "distributions": {k: dict(sorted(Counter(p[k] for p in profiles).items())) for k in profiles[0]},
+            "canonical_exact_profile_hits": sum((p["height"], p["width"], p["palette_size"]) in exact for p in profiles),
+            "canonical_envelope_hits": sum(all(lo <= p[k] <= hi for k, (lo, hi) in ranges.items()) for p in profiles),
+            "collision_inputs": sum(p["conflicting_pairs"] > 0 for p in profiles),
+            "multiple_collision_inputs": sum(p["conflicting_pairs"] > 1 for p in profiles),
+            "same_color_pair_inputs": sum(p["same_color_pairs"] > 0 for p in profiles),
+            "axis_inputs": sum(p["axis_marks"] > 0 for p in profiles)}
+
+
+def run(args, output: Path) -> dict:
+    sys.path.insert(0, str(REPO / "src"))
+    from arcpuzzles.catalog import Catalog
+    from arcpuzzles.runtime import prepare_runtime
+    with tempfile.TemporaryDirectory(prefix="arc-mirror-probe-") as directory:
+        stage = Path(directory)
+        manifest = prepare_runtime(Catalog(REPO), stage, TASK_ID)
+        sys.path.insert(0, str(stage))
+        from arc_repl.racket_bridge import RacketBridge
+        from puzzle_generators.rule_wrap import wrap_rule
+        from scripts.canonical_profile_gate import canonical_pairs, canonical_rule_source, normalized_rule_hash
+        canonical, source = canonical_pairs(TASK_ID), canonical_rule_source(TASK_ID)
+        current_path = HOME / "generator.py"
+        current = load_generator(current_path, "mirror_review_current")
+        subjects = {"current": (current, current_path)}
+        if args.baseline:
+            baseline = args.baseline.resolve()
+            if baseline == current_path.resolve():
+                raise ValueError("Baseline must be a separate immutable source file")
+            subjects = {"baseline": (load_generator(baseline, "mirror_review_baseline"), baseline), **subjects}
+        report = {"schema": "arc-mirror-review-v1", "task_id": TASK_ID,
+                  "generator_sha256": digest(current_path), "probe_sha256": digest(Path(__file__)),
+                  "rule_hash": normalized_rule_hash(source),
+                  "rule_source_sha256": hashlib.sha256(source.encode()).hexdigest(),
+                  "configuration": {"inputs_per_band": args.per_band, "lessons_per_band": args.lessons,
+                                    "demos_per_lesson": 3, "bands": [None, "easy", "medium", "hard"],
+                                    "seed_scheme": "mirror-review-v1; sha256(kind,band,index)",
+                                    "counterexample_orbits": 1100},
+                  "limitations": ["Finite named rival set, not universal rule identifiability.",
+                                  "Sample counts are not trained-model accuracy measurements.",
+                                  "Three-demo guarantee applies only to consecutive default draws.",
+                                  "Fixed-seed before/after source comparison changes VERSION RNG streams; not a same-grid ablation."],
+                  "runtime_manifest": manifest, "subjects": {}, "errors": []}
+        with RacketBridge() as bridge, (output / "racket-cases.jsonl").open("w") as stream:
+            oracle = RacketLabels(bridge, wrap_rule(source), stream)
+            canon_checked = oracle.label([p["input"] for p in canonical])
+            if canon_checked != canonical:
+                raise AssertionError("Racket authority disagrees with canonical pairs")
+            report["canonical_pairs_verified"] = len(canonical)
+            exhaustive = oracle.label(exhaustive_orbit_cases())
+            for pair in exhaustive:
+                if current._mirror(pair["input"]) != pair["output"]:
+                    raise AssertionError("Generator audit mirror disagrees with Racket")
+            report["exhaustive_orbit_cases_verified"] = len(exhaustive)
+            counterexample = oracle.label([[[1], [2]]])[0]
+            report["counterexample"] = {**counterexample,
+                "rivals": {name: {"fits_all_canonical_pairs": all(fn(p["input"]) == p["output"] for p in canonical),
+                                    "prediction": fn(counterexample["input"])}
+                           for name, fn in current.CANONICAL_SHORTCUTS.items()}}
+            shapes = {"singleton": [[1], [0]], "short_line": [[1, 1, 1], [0, 0, 0]],
+                      "solid_2x2": [[2, 2, 0], [2, 2, 0], [0, 0, 0], [0, 0, 0]]}
+            report["lawful_tiny_shapes"] = {}
+            for name, grid in shapes.items():
+                pair = oracle.label([grid])[0]
+                report["lawful_tiny_shapes"][name] = {**pair, "self_check": current.self_check(grid),
+                                                       "output_changes": pair["input"] != pair["output"]}
+            for subject, (module, path) in subjects.items():
+                all_lessons, band_reports = [], {}
+                for band in (None, "easy", "medium", "hard"):
+                    grids = []
+                    for i in range(args.per_band):
+                        seed = stable_seed("draw", band, i)
+                        grid = module.generate(seed, seed % 7919 + i, difficulty=band)
+                        errors = module.self_check(grid)
+                        if errors:
+                            raise AssertionError({"subject": subject, "band": band, "seed": seed,
+                                                  "index": i, "self_check": errors, "input": grid})
+                        grids.append(grid)
+                    for pair in oracle.label(grids):
+                        if module._mirror(pair["input"]) != pair["output"]:
+                            raise AssertionError("Subject Python mirror disagrees with Racket")
+                    lessons = []
+                    for i in range(args.lessons):
+                        seed = stable_seed("lesson", band, i)
+                        start = seed % 7919 + 7 * i
+                        pairs = oracle.label([module.generate(seed, start + j, difficulty=band) for j in range(4)])
+                        lessons.append({"band": band, "seed": seed, "sample_index": start,
+                                        "demos": pairs[:3], "query": pairs[3]})
+                    all_lessons.extend(lessons)
+                    band_reports[str(band)] = {"profiles": summarize_profiles(grids, canonical),
+                                               "lessons": analyze_lessons(lessons, current.SEMANTIC_RIVALS)}
+                report["subjects"][subject] = {"version": module.VERSION, "sha256": digest(path),
+                                               "bands": band_reports,
+                                               "lessons": analyze_lessons(all_lessons, current.SEMANTIC_RIVALS)}
+            report["unique_racket_inputs_verified"] = len(oracle.cache)
+            report["racket_batch_calls"] = oracle.calls
+        if report["subjects"]["current"]["lessons"]["ambiguous_lessons"]:
+            report["errors"].append("Current default lessons leave named rivals ambiguous")
+        report["passed"] = not report["errors"]
+        return report
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline", type=Path)
+    parser.add_argument("--per-band", type=int, default=200)
+    parser.add_argument("--lessons", type=int, default=100)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.per_band < 1 or args.lessons < 1:
+        parser.error("--per-band and --lessons must be positive")
+    output = args.out.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    start = time.monotonic()
+    try:
+        report = run(args, output)
+    except Exception as exc:
+        report = {"schema": "arc-mirror-review-v1", "task_id": TASK_ID, "passed": False,
+                  "errors": [repr(exc)], "traceback": traceback.format_exc()}
+    report["elapsed_seconds"] = time.monotonic() - start
+    (output / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({key: report.get(key) for key in
+                      ("task_id", "passed", "unique_racket_inputs_verified", "errors", "elapsed_seconds")}))
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
