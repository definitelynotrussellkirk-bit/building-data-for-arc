+"""Bounded demonstration-first probe for omitted dihedral transforms."""
+from __future__ import annotations
+from pathlib import Path
+import argparse, hashlib, importlib.util, json
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+HOME=Path(__file__).resolve().parent.parent
+ROOT=HOME.parent.parent
+PIN='d0703017a6f37690e590d87bf214dacd16e33fa65b46b6805445db5750b226ed'
+RULE='b36e2b403189'
+RIVALS=('orthogonal_reflections','rotation_only','connectivity8')
+
+
+def norm(cells):
+    r0=min(r for r,c in cells);c0=min(c for r,c in cells)
+    return tuple(sorted((r-r0,c-c0) for r,c in cells))
+
+
+def variants(cells):
+    funcs=(lambda r,c:(r,c),lambda r,c:(c,-r),lambda r,c:(-r,-c),
+           lambda r,c:(-c,r),lambda r,c:(r,-c),lambda r,c:(-c,-r),
+           lambda r,c:(-r,c),lambda r,c:(c,r))
+    return [norm([f(r,c) for r,c in cells]) for f in funcs]
+
+
+def parts(g,diagonal=False):
+    seen=set();out=[]
+    ds=[(r,c) for r in (-1,0,1) for c in (-1,0,1) if (r or c) and (diagonal or abs(r)+abs(c)==1)]
+    for r,row in enumerate(g):
+        for c,value in enumerate(row):
+            if not value or (r,c) in seen:continue
+            todo=[(r,c)];seen.add((r,c));cells=[]
+            while todo:
+                rr,cc=todo.pop();cells.append((rr,cc))
+                for dr,dc in ds:
+                    p=(rr+dr,cc+dc)
+                    if 0<=p[0]<len(g) and 0<=p[1]<len(row) and g[p[0]][p[1]] and p not in seen:
+                        seen.add(p);todo.append(p)
+            out.append(cells)
+    return sorted(out,key=lambda cs:(min(r for r,c in cs),min(c for r,c in cs)))
+
+
+def reference(g,name=None):
+    objects=parts(g,name=='connectivity8')
+    indices=(0,1,2,3,4,6) if name=='orthogonal_reflections' else range(4) if name=='rotation_only' else range(8)
+    return [[2 if norm(b) in [variants(a)[i] for i in indices] else 0 for b in objects] for a in objects]
+
+
+def rival_program(canonical,name):
+    if name=='connectivity8':return canonical.replace('(objects mask 0)','(objects-8 mask 0)')
+    old='(match-transform (obj-cells (nth objs r)) (obj-cells (nth objs c)))'
+    assert canonical.count(old)==1
+    indices='0 1 2 3 4 6' if name=='orthogonal_reflections' else '0 1 2 3'
+    new="""(let* ((transforms (all-transforms (obj-cells (nth objs r))))
+                      (target (first (all-transforms (obj-cells (nth objs c))))))
+                 (ormap (lambda (i) (equal? (list-ref transforms i) target))
+                        '(%s)))"""%indices
+    return canonical.replace(old,new)
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--out',type=Path,required=True);args=parser.parse_args()
+    source=(HOME/'generator.py').read_bytes();assert hashlib.sha256(source).hexdigest()==PIN
+    spec=importlib.util.spec_from_file_location('peer397_generator',HOME/'generator.py');module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    record=Catalog(ROOT).get('397767b9f88c')
+    ps={v['program_solution'] for v in record['variants']};assert len(ps)==1;canonical=ps.pop()
+    assert hashlib.sha256(' '.join(canonical.split()).encode()).hexdigest()[:12]==RULE
+    original=[{k:[list(map(int,row)) for row in pair[k]] for k in ('input','output')} for pair in record['variants'][0]['train']]
+    assert all(reference(p['input'])==p['output'] for p in original)
+    original_fit={name:[reference(p['input'],name)==p['output'] for p in original] for name in RIVALS}
+    search=[];hit=None
+    for seed in range(32):
+        demos=[module.generate(seed,i) for i in range(3)]
+        assert all(not module.self_check(g) for g in demos)
+        fit={name:[reference(g,name)==reference(g) for g in demos] for name in RIVALS}
+        survivors=[name for name in RIVALS if all(fit[name])]
+        search.append({'seed':seed,'demo_fit':fit,'frozen_survivors':survivors})
+        if not survivors:continue
+        queries=[module.generate(seed,i) for i in range(3,7)]
+        assert all(not module.self_check(g) for g in queries)
+        for name in survivors:
+            differences=[i for i,g in enumerate(queries) if reference(g,name)!=reference(g)]
+            if differences:
+                hit={'seed':seed,'rival':name,'demos':demos,'queries':queries,'query_disagreements':differences};break
+        if hit:break
+    report={'schema':'arc-bounded-teaching-probe-v1','task_id':'397767b9f88c','source_sha256':PIN,'version':module.VERSION,'rule_hash':RULE,
+            'canonical_program_sha256':hashlib.sha256(canonical.encode()).hexdigest(),'probe_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+            'canonical_demo_fit':original_fit,'search_budget_seeds':[0,31],'rivals':list(RIVALS),'search':search,
+            'scope':'Default direct-draw grouping: samples0..2 demos,3..6 queries. No issued episode or native export claim.',
+            'limits':['Not a full battery or general failure-rate estimate.','No handcrafted query or validator-only extension used.','No production/canonical/index changes.'],
+            'imported_status':{k:record.get(k) for k in ('approved','approval_reasons','audit_unresolved')},'source_index_file_present':(HOME/'evidence/review_index.json').exists(),
+            'associated_notes_bytes':(HOME/'evidence/associated_notes.jsonl').stat().st_size}
+    if hit:
+        bad=rival_program(canonical,hit['rival'])
+        raw=hit['demos']+hit['queries'];assert len({json.dumps(g) for g in raw})==7
+        outputs=[];original_outputs=[]
+        runtime=ROOT/'shared/runtime'
+        with _local_imports(runtime,Path(__file__).parent):
+            apply,identity,bridge=_real_evaluator(runtime)
+            try:
+                # Replay every original demonstration before any generated query.
+                for p in original:
+                    a=apply(canonical,p['input']);b=apply(bad,p['input'])
+                    assert a==p['output'];assert b==reference(p['input'],hit['rival'])
+                    original_outputs.append({'input':p['input'],'canonical_output':a,'rival_output':b,'equal':a==b})
+                for i,g in enumerate(raw):
+                    a=apply(canonical,g);b=apply(bad,g)
+                    assert a==reference(g);assert b==reference(g,hit['rival'])
+                    outputs.append({'role':'demo' if i<3 else 'query','sample_index':i,'input':g,'canonical_output':a,'rival_output':b,'equal':a==b,
+                                    'self_check_errors':module.self_check(g),'strict_canonical_like_errors':module.strict_canonical_like(g),
+                                    'observed_profile':module.observe_overrides(g)})
+            finally:bridge.close()
+        assert all(p['equal'] for p in outputs[:3]) and any(not p['equal'] for p in outputs[3:])
+        report.update(status='reproduced_direct_draw_teaching_ambiguity',seed=hit['seed'],rival=hit['rival'],query_disagreements=hit['query_disagreements'],
+                      demo_fit_frozen_before_queries=True,protected_calls=2*(len(original)+7),runtime=identity,canonical_program=canonical,rival_program=bad,
+                      rival_program_sha256=hashlib.sha256(bad.encode()).hexdigest(),canonical_replay=original_outputs,pairs=outputs)
+        args.out.parent.mkdir(parents=True,exist_ok=True)
+        (args.out.parent/'canonical.rkt').write_text(canonical);(args.out.parent/'rival.rkt').write_text(bad)
+    else:report.update(status='no_witness_in_bounded_search',protected_calls=0)
+    assert hashlib.sha256((HOME/'generator.py').read_bytes()).hexdigest()==PIN
+    args.out.parent.mkdir(parents=True,exist_ok=True);args.out.write_text(json.dumps(report,indent=2)+'\n')
+    print(json.dumps({k:report.get(k) for k in ('status','seed','rival','query_disagreements','protected_calls')}))
+
+if __name__=='__main__':main()
