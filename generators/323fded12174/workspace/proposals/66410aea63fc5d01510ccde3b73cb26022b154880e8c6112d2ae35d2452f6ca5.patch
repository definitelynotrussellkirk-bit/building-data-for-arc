+"""Bounded native proof: retain a motif source even when its copy is clipped."""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+REPO = Path(__file__).resolve().parents[3]
+RUNTIME = REPO / "shared/runtime"
+sys.path[:0] = [str(REPO / "src"), str(RUNTIME)]
+from reviewer_support import canonical_pairs, canonical_path, load_selected_generator
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+TASK = "306513227c6e"
+SOURCE_SHA = "c53d61b9cea82522c91351bd5734bc84a9e48fbbab1253fadfb94b974e696084"
+RULE_HASH = "a9d7b3e0132a"
+RIVAL = """(rule!
+  (let* ((src (first (find-color g 2)))
+         (dst (first (find-color g 3)))
+         (dr (- (first dst) (first src)))
+         (dc (- (second dst) (second src)))
+         (kept (filter (lambda (p)
+                  (in-bounds? (+ (first p) dr) (+ (second p) dc) (rows g) (cols g)))
+                (find-color g 4))))
+    (for/fold ([out (paint-cells (empty-grid (rows g) (cols g) 0) kept 4)])
+              ([p (in-list kept)])
+      (set-cell out (+ (first p) dr) (+ (second p) dc) 8))))"""
+
+
+def facts(grid):
+    positions = {color: [(r, c) for r, row in enumerate(grid) for c, v in enumerate(row) if v == color]
+                 for color in (2, 3, 4)}
+    src, dst = positions[2][0], positions[3][0]
+    dr, dc = dst[0]-src[0], dst[1]-src[1]
+    clipped = [[r, c] for r, c in positions[4]
+               if not (0 <= r+dr < len(grid) and 0 <= c+dc < len(grid[0]))]
+    return {"vector": [dr, dc], "source_cells": positions[4], "clipped_source_cells": clipped,
+            "marker_cells": positions[2]+positions[3], "motif_count": len(positions[4])}
+
+
+def reference(grid, discard_clipped_sources=False):
+    info = facts(grid)
+    dr, dc = info["vector"]
+    out = [[0]*len(grid[0]) for _ in grid]
+    kept = [(r, c) for r, c in info["source_cells"]
+            if not discard_clipped_sources or [r, c] not in info["clipped_source_cells"]]
+    for r, c in kept:
+        out[r][c] = 4
+    for r, c in kept:
+        if 0 <= r+dr < len(grid) and 0 <= c+dc < len(grid[0]):
+            out[r+dr][c+dc] = 8
+    return out
+
+
+def run(out):
+    gen, source, source_sha = load_selected_generator(TASK, root=REPO)
+    assert source_sha == SOURCE_SHA
+    canonical_row = next(row for row in map(json.loads, canonical_path(REPO).read_text().splitlines())
+                         if row.get("task_id") == TASK)
+    program = canonical_row["program_solution"]
+    assert hashlib.sha256(" ".join(program.split()).encode()).hexdigest()[:12] == RULE_HASH
+    pairs = canonical_pairs(TASK, root=REPO, labeled_only=True)
+    train = [pair for pair in pairs if pair["split"] == "train"]
+    queries = [pair for pair in pairs if pair["split"] == "test"]
+    programs = {"canonical": program, "discard_clipped_sources": RIVAL}
+    report = {"schema": "306513227c6e-native-clipping-shortcut-v1", "task_id": TASK,
+              "generator_sha256": source_sha, "rule_hash": RULE_HASH, "programs": programs,
+              "status": "running", "train": train, "test": queries, "native_evaluations": 0,
+              "demonstration_fits": {}, "query_results": [], "training_admitted": False,
+              "visibility": "controller_private"}
+    with _local_imports(RUNTIME, source.parent):
+        apply, identity, bridge = _real_evaluator(RUNTIME)
+        report["racket"] = identity
+        try:
+            def evaluate(code, grid):
+                report["native_evaluations"] += 1
+                return _grid(apply(code, grid))
+            for name, code in programs.items():
+                outputs = [evaluate(code, pair["input"]) for pair in train]
+                assert outputs == [pair["output"] for pair in train]
+                assert outputs == [reference(pair["input"], name != "canonical") for pair in train]
+                report["demonstration_fits"][name] = {"fits_all": True, "outputs": outputs}
+            report["fit_frozen_before_query"] = True
+            for pair in queries:
+                values = {name: evaluate(code, pair["input"]) for name, code in programs.items()}
+                assert values["canonical"] == pair["output"] == reference(pair["input"])
+                assert values["discard_clipped_sources"] == reference(pair["input"], True)
+                differences = [{"row": r, "column": c, "canonical": value,
+                                "rival": values["discard_clipped_sources"][r][c]}
+                               for r, row in enumerate(values["canonical"]) for c, value in enumerate(row)
+                               if value != values["discard_clipped_sources"][r][c]]
+                report["query_results"].append({"outputs": values, "differences": differences,
+                                                "facts": facts(pair["input"]),
+                                                "production_self_check_errors": gen.self_check(pair["input"])})
+        finally:
+            bridge.close()
+    assert any(result["differences"] for result in report["query_results"])
+    draws = []
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in (0, 17):
+            grid = gen.generate(seed, 0, difficulty=difficulty)
+            assert not gen.self_check(grid, difficulty=difficulty)
+            assert not facts(grid)["clipped_source_cells"]
+            assert reference(grid) == reference(grid, True)
+            draws.append({"seed": seed, "sample_index": 0, "difficulty": difficulty,
+                          "input": grid, "facts": facts(grid), "rival_matches": True})
+    report["generated_python_census"] = draws
+    report["source_files_sha256"] = {
+        p.relative_to(REPO).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
+        for p in (source, Path(__file__).resolve())}
+    report["canonical_row_sha256"] = hashlib.sha256(json.dumps(canonical_row, sort_keys=True).encode()).hexdigest()
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == SOURCE_SHA
+    report["status"] = "reproduced_canonical_query_shortcut"
+    report["limits"] = "One rival; four canonical demonstrations fitted before one canonical query; ten protected Racket evaluations. Six ordinary generated draws checked only in independent Python. No direct-draw lesson grouping, handcrafted validator case, full battery, or universal coverage claim."
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2, sort_keys=True)+"\n")
+    print(json.dumps({"status": report["status"], "native_evaluations": report["native_evaluations"],
+                      "canonical_demos": len(train), "canonical_queries": len(queries),
+                      "query_differences": [result["differences"] for result in report["query_results"]],
+                      "generated_python_draws": len(draws)}))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    run(parser.parse_args().out)
