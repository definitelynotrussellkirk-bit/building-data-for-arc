+"""Bounded, source-bound peer audit; run through review.py run.
+
+Checks 17 named rivals on canonical demos and a deliberately selected boundary
+lesson. This is finite evidence, not an incidence estimate or approval gate.
+All labels come from the public canonical Racket runner.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import itertools
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK = "1216927d148b"
+EXPECTED_SOURCE = "466e0590bf7046e6d0df179f37992e8096ec2f246419d723a6e5a601599f32b9"
+PAIRS = ((0, 1), (0, 2), (1, 2))
+
+
+def masks(grid):
+    return [{(r, c) for r in range(len(grid)) for c in range(5)
+             if grid[r][start + c]} for start in (0, 6, 12)]
+
+
+def gallery(grid, pieces):
+    out = [[0] * 17 for _ in grid]
+    for start, piece in zip((0, 6, 12), pieces):
+        for r, c in piece:
+            out[r][start + c] = 8
+    return out
+
+
+def predictions(grid):
+    a, b, c = panel = masks(grid)
+    pairwise = [panel[i] & panel[j] for i, j in PAIRS]
+    triple = a & b & c
+    values = {
+        "triple_intersection_repeated": [triple] * 3,
+        "pairwise_union": [panel[i] | panel[j] for i, j in PAIRS],
+        "pairwise_xor": [panel[i] ^ panel[j] for i, j in PAIRS],
+        "copy_earlier_panel": [a, a, b],
+        "copy_later_panel": [b, c, c],
+        "exactly_two_panel_intersection": [s - triple for s in pairwise],
+        "same_color_overlap": [set()] * 3,
+    }
+    for i, name in enumerate(("AB", "AC", "BC")):
+        values[f"repeat_{name}"] = [pairwise[i]] * 3
+    for perm in itertools.permutations(range(3)):
+        if perm != (0, 1, 2):
+            values["pair_order_" + "".join(map(str, perm))] = [pairwise[i] for i in perm]
+    colors = [next(grid[r][start + col] for r, col in part)
+              for start, part in zip((0, 6, 12), panel)]
+    ordered = [panel[i] for i in sorted(range(3), key=colors.__getitem__)]
+    values["sort_panels_by_color"] = [ordered[i] & ordered[j] for i, j in PAIRS]
+    boxes = [{(r, col) for r in range(min(x[0] for x in s), max(x[0] for x in s) + 1)
+              for col in range(min(x[1] for x in s), max(x[1] for x in s) + 1)}
+             for s in panel]
+    values["bounding_box_intersection"] = [boxes[i] & boxes[j] for i, j in PAIRS]
+    return {name: gallery(grid, pieces) for name, pieces in values.items()}
+
+
+def evaluate(demos, queries):
+    names = sorted(predictions(demos[0]["input"]))
+    survivors = [name for name in names
+                 if all(predictions(p["input"])[name] == p["output"] for p in demos)]
+    return {"named_rivals": names, "fits_all_demonstrations": survivors,
+            "query_disagreements": {name: [i for i, p in enumerate(queries)
+                                              if predictions(p["input"])[name] != p["output"]]
+                                    for name in survivors}}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    root = find_root(__file__)
+    gen, source, digest = load_selected_generator(TASK, root=root)
+    assert digest == EXPECTED_SOURCE, "Source changed; re-review before rebinding this audit."
+    rows = [json.loads(line) for line in canonical_path(root).read_text().splitlines()
+            if json.loads(line).get("task_id") == TASK]
+    assert len(rows) == 1
+    canonical = rows[0]
+    records = [{"input": p["input"], "recorded_output": p["output"],
+                "role": "canonical_" + split, "index": i}
+               for split in ("train", "test") for i, p in enumerate(canonical[split])]
+    # Explicit small boundary selection, not a random or default-episode census.
+    for index, count in [(i, 1) for i in range(8)] + [(100 + i, 5) for i in range(4)]:
+        recipe = {"seed": 0, "sample_index": index, "difficulty": "easy",
+                  "grid_h": 5, "panel_cell_count": count}
+        grid = gen.generate(**recipe)
+        assert gen.self_check(grid) == []
+        records.append({"input": grid, "recipe": recipe,
+                        "role": "boundary_demo_candidate" if count == 1 else "boundary_query_candidate"})
+    receipt = Catalog(root).apply(TASK, [r["input"] for r in records],
+                                  reference="canonical", timeout=120)
+    assert receipt["generator_sha256"] == digest
+    assert receipt["rule_hash_matches_catalog"] is True
+    assert len(receipt["results"]) == len(records)
+    for record, result in zip(records, receipt["results"]):
+        assert result["error"] is None, result
+        record["output"] = result["output"]
+        expected = gallery(record["input"], [masks(record["input"])[i] & masks(record["input"])[j]
+                                             for i, j in PAIRS])
+        assert record["output"] == expected
+        if "recorded_output" in record:
+            assert record.pop("recorded_output") == record["output"]
+    canonical_demos = [r for r in records if r["role"] == "canonical_train"]
+    canonical_queries = [r for r in records if r["role"] == "canonical_test"]
+    rival = "triple_intersection_repeated"
+    demos, seen = [], set()
+    for r in records:
+        if r["role"] != "boundary_demo_candidate":
+            continue
+        key = json.dumps(r["input"])
+        if key not in seen and predictions(r["input"])[rival] == r["output"]:
+            demos.append(r)
+            seen.add(key)
+    queries = [r for r in records if r["role"] == "boundary_query_candidate"
+               and predictions(r["input"])[rival] != r["output"]]
+    assert len(demos) >= 3 and queries, "Bounded selection did not produce the intended witness."
+    demos, queries = demos[:3], queries[:1]
+    boundary = evaluate(demos, queries)
+    assert boundary["query_disagreements"][rival] == [0]
+    report = {
+        "schema": "task-bounded-learnability-audit-v1", "task_id": TASK,
+        "generator_sha256": digest,
+        "canonical_program_text_sha256": hashlib.sha256(canonical["program_solution"].encode()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "review_index_present": (source.parent / "evidence/review_index.json").exists(),
+        "reference_labeled_input_count": len(records),
+        "canonical_lesson": evaluate(canonical_demos, canonical_queries),
+        "selected_boundary_lesson": boundary,
+        "finding": "Three lawful, distinct generated singleton-panel demonstrations fit the simpler repeated triple-intersection rule, but a lawful five-cell query refutes it.",
+        "status": "open_source_bound_teaching_evidence; selected generator unchanged; no approval",
+        "limits": ["17 named rivals only; no universal identifiability claim.",
+                   "Boundary lesson is deliberately selected using explicit input controls; default episode incidence unmeasured.",
+                   "No generator, reference rule, shared runtime or owner approval metadata changed."]}
+    public = {"train": [{k: r[k] for k in ("input", "output")} for r in demos],
+              "test": [{"input": r["input"]} for r in queries]}
+    private = {"demonstrations": demos, "queries": queries,
+               "rival": rival, "rival_query_output": predictions(queries[0]["input"])[rival]}
+    for name, data in (("report.json", report), ("racket_receipt.json", receipt),
+                       ("inputs.json", records), ("boundary.public.json", public),
+                       ("boundary.private.json", private)):
+        (args.out / name).write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"task_id": TASK, "labeled_inputs": len(records),
+                      "canonical": report["canonical_lesson"], "boundary": boundary,
+                      "evidence": str(args.out)}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
