+#!/usr/bin/env python3
+"""Bounded peer review: protected-Racket labels, six named geometric rivals.
+
+Run from the packet outer root:
+WORK/.venv/bin/python review.py run python3 \
+  generators/0a1bba9e3d93/workspace/peer_rival_probe.py \
+  --out ../checks/0a1bba9e3d93/peer_rival_probe.json
+
+This is optional reviewer evidence, not owner approval or a universal proof.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from lesson_probe import _materialize_lesson
+from reference_probe import cells, load_generator, normalize, split_panels
+
+HOME = Path(__file__).resolve().parents[1]
+REPO = HOME.parents[1]
+TASK = "0a1bba9e3d93"
+
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def alternative(grid, mode):
+    before, after, query = split_panels(grid)
+    bc, ac, qc = map(cells, (before, after, query))
+    bn, an = normalize(bc), normalize(ac)
+    qrow, qcol = min(r for r, c in qc), min(c for r, c in qc)
+    color = query[qc[0][0]][qc[0][1]]
+    out = [row[:] for row in query]
+    if mode == "overlay_after":
+        stamps = [(qrow + r, qcol + c) for r, c in an]
+    elif mode == "panel_absolute_delta":
+        brow, bcol = min(r for r, c in bc), min(c for r, c in bc)
+        stamps = [(qrow + r - brow, qcol + c - bcol)
+                  for r, c in set(ac) - set(bc)]
+    elif mode == "after_absolute_delta":
+        arow, acol = min(r for r, c in ac), min(c for r, c in ac)
+        stamps = [(arow + r, acol + c) for r, c in an - bn]
+    else:
+        stamps = [(qrow + r, qcol + c) for r, c in an - bn]
+    for r, c in stamps:
+        if mode == "clamp_outside":
+            r, c = min(max(r, 0), len(out) - 1), min(max(c, 0), len(out[0]) - 1)
+        if 0 <= r < len(out) and 0 <= c < len(out[0]):
+            out[r][c] = color
+    return out
+
+
+def hybrid_clip_query():
+    """Small accepted input combining different QUERY support and clipping.
+
+    The selected generator's clip branch always uses QUERY == BEFORE support,
+    so it never draws this valid combination. It is not a generated query.
+    """
+    grid = [[0] * 11 for _ in range(3)]
+    for row in grid:
+        row[3] = row[7] = 8
+    for r, c in {(0, 0), (0, 1), (1, 0)}:
+        grid[r][c] = 2
+    for r, c in {(0, 0), (0, 1), (1, 0), (1, 1), (2, 0)}:
+        grid[r][4 + c] = 2
+    for c in range(3):
+        grid[1][8 + c] = 5
+    return grid
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    generator = load_generator()
+    ledger = REPO / "shared/data/canonical/puzzles.jsonl"
+    row = next(json.loads(line) for line in ledger.read_text().splitlines()
+               if json.loads(line).get("task_id") == TASK)
+    program = row["program_solution"]
+    assert program.startswith("(rule! ") and program.endswith(")")
+    rivals = dict(generator.LESSON_COMPETITORS)
+    for name in ("overlay_after", "panel_absolute_delta", "after_absolute_delta", "clamp_outside"):
+        rivals[name] = lambda grid, mode=name: alternative(grid, mode)
+    counts = {name: {"demo_surviving_lessons": 0, "surviving_query_disagreements": 0}
+              for name in rivals}
+    cache = {}
+    bridge = RacketBridge()
+    try:
+        bridge.eval_text("(define (peer-rule g) " + program[len("(rule! "):-1] + ")")
+
+        def label(grid):
+            key = json.dumps(grid, separators=(",", ":"))
+            if key not in cache:
+                bridge.define_grid("peer-grid", grid)
+                cache[key] = bridge.eval_text("(peer-rule peer-grid)")
+                assert cache[key] == generator.rule_mirror(grid)
+            return cache[key]
+
+        canonical = [*row["train"], row["test"]]
+        canonical_fit = {name: all(fn(pair["input"]) == pair["output"] for pair in canonical)
+                         for name, fn in rivals.items()}
+        assert all(canonical_fit.values())
+        assert all(label(pair["input"]) == pair["output"] for pair in canonical)
+        lessons = []
+        for band in ("easy", "medium", "hard"):
+            for seed in range(4):
+                demos, query, meta = _materialize_lesson(generator, label, seed=seed, band=band, start=0)
+                assert not generator.lesson_identifiable(demos, query)
+                survivors = [name for name, fn in rivals.items()
+                             if all(fn(pair["input"]) == pair["output"] for pair in demos)]
+                disagreements = [name for name in survivors
+                                 if rivals[name](query["input"]) != query["output"]]
+                for name in survivors:
+                    counts[name]["demo_surviving_lessons"] += 1
+                for name in disagreements:
+                    counts[name]["surviving_query_disagreements"] += 1
+                lessons.append({"band": band, "seed": seed, **meta,
+                                "survivors": survivors, "query_disagreements": disagreements})
+        witness = hybrid_clip_query()
+        assert not generator.self_check(witness)
+        expected = label(witness)
+        clamped = rivals["clamp_outside"](witness)
+        assert expected != clamped
+        report = {
+            "schema": "arcpuzzles-peer-rival-probe-v1", "task_id": TASK,
+            "status": "no_generated_query_counterexample_in_bounded_probe",
+            "approval_status": "optional_reviewer_evidence_only",
+            "generator_sha256": digest(HOME / "generator.py"),
+            "probe_sha256": digest(__file__),
+            "reference_probe_sha256": digest(Path(__file__).with_name("reference_probe.py")),
+            "lesson_probe_sha256": digest(Path(__file__).with_name("lesson_probe.py")),
+            "canonical_ledger_sha256": digest(ledger),
+            "rule_hash": generator.RULE_HASH,
+            "program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+            "racket_runtime": bridge.runtime_identity,
+            "racket_labeled_unique_inputs": len(cache),
+            "lesson_count": len(lessons), "demo_count_per_lesson": 4,
+            "canonical_fit": canonical_fit, "rivals": counts, "lessons": lessons,
+            "coverage_witness": {"kind": "accepted_but_not_sampler_generated_input",
+                "input": witness, "racket_output": expected, "clamp_rival_output": clamped,
+                "self_check": [], "reason": "QUERY support differs from BEFORE while growth clips"},
+            "limits": "Only six rivals, seeds 0..3, three bands, production start 0. Clamp survives but agrees on every sampled generated query; the retained mismatch is manually constructed, not a generated-lesson defect. No generator, canonical rule, or approval metadata changed."
+        }
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+        print(json.dumps({"status": report["status"], "lessons": len(lessons),
+                          "racket_labels": len(cache), "rivals": counts, "out": str(args.out)}, indent=2))
+    finally:
+        bridge.shutdown()
+    assert not any(value["surviving_query_disagreements"] for value in counts.values())
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
