+_SPEC.loader.exec_module(_IMPL)
+
+
+def program(settings: dict[str, Any]) -> str:
+    return _IMPL.program(settings)
+
+
+def generate(
+    seed: int,
+    settings: dict[str, Any],
+    demos: int = 3,
+    queries: int = 4,
+) -> dict[str, Any]:
