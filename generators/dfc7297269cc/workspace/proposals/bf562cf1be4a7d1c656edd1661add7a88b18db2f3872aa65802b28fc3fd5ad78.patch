+#!/usr/bin/env python3
+"""Find a generated signed-vector case that rejects an absolute-delta shortcut."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK = "dd47ca15f98a"
+ROOT = find_root(__file__)
+GEN, SOURCE, SOURCE_SHA256 = load_selected_generator(TASK, root=ROOT)
+
+
+def marker_vector(grid):
+    one = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 1]
+    two = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 2]
+    if len(one) != 1 or len(two) != 1:
+        raise ValueError("expected one marker of each color")
+    return one[0], (two[0][0] - one[0][0], two[0][1] - one[0][1])
+
+
+def apply_repeat(grid, *, absolute=False):
+    h, w = len(grid), len(grid[0])
+    _, (dr, dc) = marker_vector(grid)
+    if absolute:
+        dr, dc = abs(dr), abs(dc)
+    motif = [
+        (r, c, value)
+        for r, row in enumerate(grid)
+        for c, value in enumerate(row)
+        if value not in (0, 1, 2)
+    ]
+    out = [[0 for _ in range(w)] for _ in range(h)]
+    k = 0
+    while True:
+        shifted = [(r + k * dr, c + k * dc, value) for r, c, value in motif]
+        if not all(0 <= r < h and 0 <= c < w for r, c, _ in shifted):
+            return out
+        for r, c, value in shifted:
+            out[r][c] = value
+        k += 1
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--limit", type=int, default=512)
+    args = parser.parse_args()
+    if args.limit < 1:
+        raise SystemExit("--limit must be positive")
+
+    for index in range(args.limit):
+        seed = 30_000 + index
+        sample_index = index * 13
+        grid = GEN.generate(seed, sample_index)
+        marker, vector = marker_vector(grid)
+        intended = apply_repeat(grid)
+        rival = apply_repeat(grid, absolute=True)
+        if (vector[0] < 0 or vector[1] < 0) and intended != rival:
+            args.out.mkdir(parents=True, exist_ok=False)
+            (args.out / "input.json").write_text(json.dumps(grid) + "\n", encoding="utf-8")
+            report = {
+                "schema": "dd47ca15f98a-signed-direction-probe-v1",
+                "task_id": TASK,
+                "source_path": str(SOURCE.relative_to(ROOT)),
+                "source_sha256": SOURCE_SHA256,
+                "seed": seed,
+                "sample_index": sample_index,
+                "blue_marker": marker,
+                "vector": vector,
+                "intended_output": intended,
+                "absolute_delta_rival_output": rival,
+                "disagrees": True,
+                "limits": f"first witness in a deterministic search of at most {args.limit} generated cases",
+            }
+            (args.out / "probe.json").write_text(
+                json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+            )
+            print(json.dumps(report, indent=2, sort_keys=True))
+            return 0
+    raise SystemExit("no signed-direction disagreement found")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
