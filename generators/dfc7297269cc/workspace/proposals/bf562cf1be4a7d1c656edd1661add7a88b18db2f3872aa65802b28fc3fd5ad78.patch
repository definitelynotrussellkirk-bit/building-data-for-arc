+"""Regression tests for signed marker-vector coverage in dd47ca15f98a."""
+from __future__ import annotations
+
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK = "dd47ca15f98a"
+ROOT = find_root(__file__)
+GEN, _, _ = load_selected_generator(TASK, root=ROOT)
+
+
+def marker_vector(grid):
+    one = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 1]
+    two = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 2]
+    assert len(one) == len(two) == 1
+    return one[0], (two[0][0] - one[0][0], two[0][1] - one[0][1])
+
+
+def apply_repeat(grid, *, absolute=False):
+    height, width = len(grid), len(grid[0])
+    marker, vector = marker_vector(grid)
+    del marker
+    dr, dc = vector
+    if absolute:
+        dr, dc = abs(dr), abs(dc)
+    motif = [
+        (r, c, value)
+        for r, row in enumerate(grid)
+        for c, value in enumerate(row)
+        if value not in (0, 1, 2)
+    ]
+    out = [[0 for _ in range(width)] for _ in range(height)]
+    k = 0
+    while True:
+        shifted = [(r + k * dr, c + k * dc, value) for r, c, value in motif]
+        if not all(0 <= r < height and 0 <= c < width for r, c, _ in shifted):
+            return out
+        for r, c, value in shifted:
+            out[r][c] = value
+        k += 1
+
+
+def test_generated_vectors_cover_both_signs_and_all_marker_corners():
+    row_signs = set()
+    col_signs = set()
+    marker_corners = set()
+    for index in range(256):
+        grid = GEN.generate(1000 + index, index * 17 + 3)
+        assert GEN.self_check(grid) == []
+        marker, (dr, dc) = marker_vector(grid)
+        row_signs.add((dr > 0) - (dr < 0))
+        col_signs.add((dc > 0) - (dc < 0))
+        height, width = len(grid), len(grid[0])
+        assert marker[0] in (0, height - 1)
+        assert marker[1] in (0, width - 1)
+        marker_corners.add((marker[0] == height - 1, marker[1] == width - 1))
+    assert {-1, 1} <= row_signs
+    assert {-1, 1} <= col_signs
+    assert marker_corners == {(False, False), (False, True), (True, False), (True, True)}
+
+
+def test_signed_generation_is_deterministic_and_lawful():
+    for index in range(128):
+        seed = 20_000 + index * 31
+        first = GEN.generate(seed, index, difficulty=("easy", "medium", "hard")[index % 3])
+        second = GEN.generate(seed, index, difficulty=("easy", "medium", "hard")[index % 3])
+        assert first == second
+        assert GEN.self_check(first) == []
+
+
+def test_negative_vector_refutes_absolute_direction_shortcut():
+    witness = None
+    for index in range(256):
+        grid = GEN.generate(30_000 + index, index * 13)
+        _, (dr, dc) = marker_vector(grid)
+        if dr < 0 or dc < 0:
+            intended = apply_repeat(grid)
+            rival = apply_repeat(grid, absolute=True)
+            if intended != rival:
+                witness = (grid, intended, rival)
+                break
+    assert witness is not None
