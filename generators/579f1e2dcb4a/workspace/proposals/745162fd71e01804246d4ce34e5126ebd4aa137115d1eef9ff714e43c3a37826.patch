+"""Replay a whole-panel-versus-row/column-count analogy counterexample.
+
+Discovery was bounded to 16 ordinary medium inputs and four feature rivals.
+This source-pinned reproducer retains one consecutive four-demo lesson, its
+next query, and a distinct guard. All retained labels execute protected Racket.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+
+TASK = "5f8ebdb4bd9c"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+SOURCE_SHA = "67e83a7965329ac7be920d38120a4c2e0d0b9bb5e4762c7434e41bf5f6ae8f32"
+RULE_HASH = "bfccb7008cc6"
+PROGRAM_SHA = "160884894de1c29319010bf414e855bf3b4cf1211bf4311ecf2c7b5c42d69e03"
+MATCH = "(equal? (apply-transform a t) b)"
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def grid(value):
+    if value and isinstance(value[0], str):
+        return [[int(cell) for cell in row] for row in value]
+    return deepcopy(value)
+
+
+def projections(panel):
+    return [[sum(value != 0 for value in row) for row in panel],
+            [sum(panel[r][c] != 0 for r in range(3)) for c in range(3)]]
+
+
+def projection_rule(program):
+    def feature(panel):
+        return f"""(list
+          (for/list ((r (range 0 3)))
+            (for/sum ((c (range 0 3))) (if (= (at {panel} r c) 0) 0 1)))
+          (for/list ((c (range 0 3)))
+            (for/sum ((r (range 0 3))) (if (= (at {panel} r c) 0) 0 1))))"""
+    replacement = ("(let ((x (apply-transform a t)) (y b)) "
+                   f"(equal? {feature('x')} {feature('y')}))")
+    if program.count(MATCH) != 1:
+        raise ValueError("canonical transform matcher changed")
+    return program.replace(MATCH, replacement)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError("output must be new")
+    gen, source_path, source_hash = load_selected_generator(TASK, root=ROOT)
+    if source_hash != SOURCE_SHA:
+        raise ValueError("selected generator differs from the retained source")
+    canonical_rows = [row for line in (ROOT / "shared/data/canonical/puzzles.jsonl").open()
+                      if (row := json.loads(line)).get("task_id") == TASK]
+    programs = {row["program_solution"] for row in canonical_rows}
+    if len(programs) != 1:
+        raise ValueError("ambiguous canonical program")
+    program = programs.pop()
+    if (sha(program.encode()) != PROGRAM_SHA
+            or sha(" ".join(program.split()).encode())[:12] != RULE_HASH):
+        raise ValueError("canonical program differs from the retained source")
+    alternative = projection_rule(program)
+    inputs = {i: gen.generate(0, i, difficulty="medium") for i in range(2, 8)}
+    if any(gen.self_check(value) for value in inputs.values()):
+        raise ValueError("a retained input fails the current self check")
+    evaluations = 0
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            bridge.close()
+            raise ValueError("real protected Racket is required")
+
+        def execute(source, value):
+            nonlocal evaluations
+            result = apply(source, deepcopy(value))
+            evaluations += 1
+            return result
+
+        try:
+            canonical_checks = []
+            for row in canonical_rows:
+                for split in ("train", "test"):
+                    pairs = row[split] if isinstance(row[split], list) else [row[split]]
+                    for index, pair in enumerate(pairs):
+                        actual = execute(program, grid(pair["input"]))
+                        if actual != grid(pair["output"]):
+                            raise ValueError("canonical replay failed")
+                        canonical_checks.append({"source": row["source"], "split": split,
+                                                 "index": index, "matches": True})
+            expected = {i: execute(program, value) for i, value in inputs.items()}
+            alternatives = {i: execute(alternative, value) for i, value in inputs.items()}
+        finally:
+            bridge.close()
+    demos = [{"input": inputs[i], "output": expected[i]} for i in (2, 3, 4, 5)]
+    query = {"input": inputs[6], "output": expected[6]}
+    demo_fits = [alternatives[i] == expected[i] for i in (2, 3, 4, 5)]
+    differences = [{"row": r, "column": c, "intended": expected[6][r][c],
+                    "alternative": alternatives[6][r][c]}
+                   for r in range(3) for c in range(3) if expected[6][r][c] != alternatives[6][r][c]]
+    if not all(demo_fits) or not differences or expected[7] == alternatives[7]:
+        raise ValueError("the retained ambiguity or guard failed execution")
+    observations = []
+    for i, value in inputs.items():
+        facts = gen._analyze(value)["facts"]
+        projected_matches = [command for command in gen.ORACLE_TCODES
+                             if projections(gen._apply(facts["a"], command)) == projections(facts["b"])]
+        observations.append({"seed": 0, "sample_index": i, "command": facts["command"],
+                             "projection_matching_commands": projected_matches,
+                             "projection_selected_command": projected_matches[0],
+                             "a_projections": projections(facts["a"]),
+                             "b_projections": projections(facts["b"]),
+                             "self_check": gen.self_check(value)})
+    if sha(Path(source_path).read_bytes()) != SOURCE_SHA:
+        raise ValueError("production source changed during replay")
+    report = {
+        "schema": "arc-protected-projection-analogy-counterexample-v1", "task_id": TASK,
+        "status": "finding", "source_path": f"generators/{TASK}/generator.py",
+        "source_sha256": SOURCE_SHA, "canonical_source_path": "shared/data/canonical/puzzles.jsonl",
+        "canonical_rule_hash": RULE_HASH, "canonical_program_sha256": PROGRAM_SHA,
+        "probe_sha256": sha(Path(__file__).read_bytes()), "evaluator": identity,
+        "protected_racket_evaluations": evaluations, "canonical_replays": canonical_checks,
+        "discovery_scope": {"unique_ordinary_inputs": 16, "seeds": [0, 17],
+                            "sample_indices_per_seed": list(range(8)), "difficulty": "medium",
+                            "overrides": {}, "features": ["centroid", "bbox", "projections", "corners"],
+                            "receipt": "checks/5f8ebdb4bd9c/feature-prefilter-command.json"},
+        "retained_scope": "four consecutive ordinary generator draws and the next query; "
+                          "native episode export was not invoked",
+        "case_provenance": {"seed": 0, "difficulty": "medium", "overrides": {},
+                            "demo_sample_indices": [2, 3, 4, 5], "query_sample_index": 6},
+        "program": program, "rival_program": alternative,
+        "rival_program_sha256": sha(alternative.encode()),
+        "rival_description": "infer the first transform matching A/B row and column occupied-cell "
+                             "counts instead of their complete pixels, then transform C normally",
+        "original_lesson": {"train": demos, "test": [query]},
+        "alternative_demo_outputs": [alternatives[i] for i in (2, 3, 4, 5)],
+        "alternative_query_output": alternatives[6], "demo_fits": demo_fits,
+        "query_differences": differences, "query_different_cell_count": len(differences),
+        "current_lesson_identifiable_reasons": gen.lesson_identifiable(demos, query),
+        "sample_observations": observations,
+        "guard_demonstration": {"seed": 0, "sample_index": 7, "difficulty": "medium",
+                                "overrides": {}, "input": inputs[7], "output": expected[7],
+                                "alternative_output": alternatives[7], "rejects_selected_rival": True},
+        "limits": ["The screen covered four feature summaries, two seeds and one difficulty band.",
+                   "This is a lesson-identifiability finding, not a canonical-label discrepancy.",
+                   "The retained clean audit remains needs_triage; its accepted triage metadata "
+                   "and reviewer-reported scope are not changed by this probe.",
+                   "Execution errors abort; they are never counted as rival refutations.",
+                   "No production edit, approval, audit disposition or training admission is made."]}
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"status": "finding", "out": str(args.out), "sha256": sha(args.out.read_bytes()),
+                      "racket_evaluations": evaluations, "demo_fits": demo_fits,
+                      "query_different_cells": len(differences)}))
+
+
+if __name__ == "__main__":
+    main()
