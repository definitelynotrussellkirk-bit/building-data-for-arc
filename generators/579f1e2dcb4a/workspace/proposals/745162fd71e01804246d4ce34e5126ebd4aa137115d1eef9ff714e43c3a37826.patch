@@ -0,0 +1,198 @@
+"""Bounded, source-pinned parity-origin review; no production mutation.
+
+The retained lesson uses consecutive ordinary generator draws, assembled here.
+It is not an end-to-end public generation/export invocation. At most two seeds,
+eight inputs per seed, and two complete executable rivals are considered.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = "59c41de367b5"
+ROOT = Path(__file__).resolve().parents[3]
+HOME = ROOT / "generators" / TASK
+RUNTIME = ROOT / "shared/runtime"
+SOURCE_SHA = "7eed2703eb31dc83cef2bca5ef406ef8a44a4562e9ed842b05436baac7e53f74"
+RULE_SHA = "bcd3d3f50818a4ad2f068c73301672f826d581267962bf8d678b3b4f880f7d7f"
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def features(grid):
+    counts = Counter(value for row in grid for value in row if value)
+    assert len(counts) == 2
+    frame_color, seed_color = [color for color, _ in counts.most_common()]
+    assert counts[seed_color] == 1
+    frame = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row)
+             if value == frame_color]
+    seed = next((r, c) for r, row in enumerate(grid) for c, value in enumerate(row)
+                if value == seed_color)
+    top, left = min(r for r, _ in frame), min(c for _, c in frame)
+    bottom, right = max(r for r, _ in frame), max(c for _, c in frame)
+    assert set(frame) == {(r, c) for r in range(top, bottom + 1)
+                          for c in range(left, right + 1)
+                          if r in (top, bottom) or c in (left, right)}
+    assert top < seed[0] < bottom and left < seed[1] < right
+    return {"shape": [len(grid), len(grid[0])], "frame_bbox": [top, left, bottom, right],
+            "frame_color": frame_color, "seed_color": seed_color, "seed": list(seed),
+            "seed_phase_from_inner_corner": (seed[0] - top - 1 + seed[1] - left - 1) % 2}
+
+
+def independent_claim(grid):
+    f = features(grid)
+    top, left, bottom, right = f["frame_bbox"]
+    sr, sc = f["seed"]
+    out = [row[:] for row in grid]
+    for r in range(top + 1, bottom):
+        for c in range(left + 1, right):
+            if grid[r][c] == 0:
+                out[r][c] = f["seed_color"] if (abs(r - sr) + abs(c - sc)) % 2 == 0 else f["frame_color"]
+    return out
+
+
+def difference(a, b):
+    assert len(a) == len(b) and all(len(x) == len(y) for x, y in zip(a, b))
+    return sum(x != y for ar, br in zip(a, b) for x, y in zip(ar, br))
+
+
+def demo_only_guard(demonstrations, apply_program, rivals):
+    """Reject either finite fixed-origin rival using demonstration labels only.
+
+    Query inputs/answers and generator metadata are not arguments. Execution
+    errors propagate; an error is never treated as a rival refutation.
+    """
+    refutations = {}
+    for name, source in rivals.items():
+        refutations[name] = [i for i, pair in enumerate(demonstrations)
+                             if apply_program(source, pair["input"]) != pair["output"]]
+    return {"surviving_rivals": [name for name, indices in refutations.items() if not indices],
+            "refutations_by_demo_index": refutations}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    source_path = HOME / "generator.py"
+    assert digest(source_path.read_bytes()) == SOURCE_SHA
+    canonical = next(row for line in (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()
+                     if (row := json.loads(line))["task_id"] == TASK)
+    intended = canonical["program_solution"]
+    assert digest(intended.encode()) == RULE_SHA
+    origin = "(+ (abs (- r (first seed))) (abs (- c (second seed))))"
+    assert intended.count(origin) == 1
+    corner = "(+ (- r (+ (first bb) 1)) (- c (+ (second bb) 1)))"
+    rivals = {
+        "inner_corner_seed_even": intended.replace(origin, corner),
+        "inner_corner_frame_even": intended.replace(origin, f"(+ 1 {corner})"),
+    }
+    report = {
+        "schema": "59c41de367b5-fixed-origin-review-v1", "task_id": TASK,
+        "source_sha256": SOURCE_SHA, "rule_sha256": RULE_SHA,
+        "normalized_rule_hash": digest(" ".join(intended.split()).encode())[:12],
+        "probe_sha256": digest(Path(__file__).read_bytes()),
+        "scope": {"seeds": [0, 17], "maximum_ordinary_inputs": 16, "rival_count": 2,
+                  "difficulty": None, "overrides": {}, "demo_prefixes_checked": [3, 2, 4, 5, 6],
+                  "queries": "up to four immediately following draws, within indices 0..7",
+                  "assembly": "reviewer-assembled consecutive ordinary draws; no public worker/export invocation"},
+        "rivals": {name: {"program": source, "sha256": digest(source.encode())}
+                   for name, source in rivals.items()},
+        "saved_canonical": [], "generated": [], "witness": None,
+    }
+    (args.out / "intended.rkt").write_text(intended)
+    for name, program in rivals.items():
+        (args.out / f"{name}.rkt").write_text(program)
+    calls = 0
+    with _local_imports(RUNTIME, HOME / "workspace"):
+        from reviewer_support import load_selected_generator
+        module, selected_path, selected_sha = load_selected_generator(TASK, root=ROOT)
+        assert Path(selected_path).resolve() == source_path.resolve() and selected_sha == SOURCE_SHA
+        apply_raw, identity, bridge = _real_evaluator(RUNTIME)
+        report["runtime"] = identity
+
+        def apply_program(program, grid):
+            nonlocal calls
+            calls += 1
+            return apply_raw(program, grid)
+
+        try:
+            for split in ("train", "test"):
+                for index, pair in enumerate(canonical[split]):
+                    actual = apply_program(intended, pair["input"])
+                    assert actual == pair["output"] == independent_claim(pair["input"])
+                    report["saved_canonical"].append({"split": split, "index": index,
+                                                       **pair, "protected_output": actual})
+            report["saved_canonical_demo_guard"] = demo_only_guard(canonical["train"], apply_program, rivals)
+            assert report["saved_canonical_demo_guard"]["surviving_rivals"] == []
+            for seed in (0, 17):
+                records = []
+                for index in range(8):
+                    grid = module.generate(seed=seed, sample_index=index)
+                    assert module.self_check(grid) == []
+                    intended_out = apply_program(intended, grid)
+                    assert intended_out == independent_claim(grid)
+                    outputs = {name: apply_program(program, grid) for name, program in rivals.items()}
+                    records.append({"seed": seed, "sample_index": index, "input": grid,
+                                    "output": intended_out, "features": features(grid),
+                                    "rival_outputs": outputs,
+                                    "changed_cells": {name: difference(intended_out, result)
+                                                      for name, result in outputs.items()}})
+                assert len({json.dumps(row["input"]) for row in records}) == len(records)
+                report["generated"].extend(records)
+                for demo_count in (3, 2, 4, 5, 6):
+                    demos, queries = records[:demo_count], records[demo_count:demo_count + 4]
+                    for name in rivals:
+                        if all(row["changed_cells"][name] == 0 for row in demos):
+                            different = [row["sample_index"] for row in queries if row["changed_cells"][name]]
+                            if different:
+                                pairs = [{"input": row["input"], "output": row["output"]} for row in demos]
+                                guard = demo_only_guard(pairs, apply_program, rivals)
+                                assert name in guard["surviving_rivals"]
+                                report["witness"] = {
+                                    "scope": report["scope"]["assembly"], "seed": seed, "difficulty": None,
+                                    "overrides": {}, "demo_indices": [row["sample_index"] for row in demos],
+                                    "query_indices": [row["sample_index"] for row in queries],
+                                    "rival_name": name, "differing_query_indices": different,
+                                    "train": pairs,
+                                    "test": [{"input": row["input"], "output": row["output"]} for row in queries],
+                                    "protected_rival_train_outputs": [row["rival_outputs"][name] for row in demos],
+                                    "protected_rival_test_outputs": [row["rival_outputs"][name] for row in queries],
+                                    "query_changed_cells": [row["changed_cells"][name] for row in queries],
+                                    "demo_only_guard": guard,
+                                }
+                                break
+                    if report["witness"]:
+                        break
+                if report["witness"]:
+                    break
+        except Exception as error:
+            report["execution_error"] = {"type": type(error).__name__, "message": str(error)}
+            report["status"] = "execution_failed_not_refutation"
+            raise
+        finally:
+            bridge.close()
+            report["protected_evaluations"] = calls
+            report["ordinary_inputs_drawn"] = len(report["generated"])
+            report.setdefault("status", "finite_fixed_origin_ambiguity" if report["witness"] else "bounded_no_finding")
+            (args.out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    assert digest(source_path.read_bytes()) == SOURCE_SHA
+    assert len(report["generated"]) <= 16
+    if report["witness"]:
+        (args.out / "witness.json").write_text(json.dumps(report["witness"], indent=2) + "\n")
+    print(json.dumps({"status": report["status"], "ordinary_inputs_drawn": report["ordinary_inputs_drawn"],
+                      "protected_evaluations": calls,
+                      "witness": None if not report["witness"] else {key: report["witness"][key] for key in
+                          ("seed", "demo_indices", "query_indices", "rival_name", "query_changed_cells")}}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
