+#!/usr/bin/env python3
+"""Reproduce one source-bound teaching ambiguity for 43d815d17b54."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "43d815d17b54"
+EXPECTED_SOURCE_SHA256 = "3ada0e528f84bef3c39c655d22b716702305bc09430016385cbeb2f31d6d24f7"
+SEED = 0
+DEMO_INDICES = (4, 5, 6, 7)
+QUERY_INDEX = 8
+
+
+def _sha(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def _canonical_program(root: Path) -> str:
+    sources = {
+        row["program_solution"]
+        for line in canonical_path(root).read_text(encoding="utf-8").splitlines()
+        if (row := json.loads(line)).get("task_id") == TASK_ID
+    }
+    if len(sources) != 1:
+        raise ValueError(f"expected one canonical source, got {len(sources)}")
+    return sources.pop()
+
+
+def _rival_program(canonical: str) -> str:
+    """Place the right wall directly after the rightmost pipe, not after the segment."""
+    old_wall = "(vline out1 (+ r2 1) bar-row)"
+    new_wall = "(vline out1 (+ (max-list seg8) 1) bar-row)"
+    old_cap = "(range (max-list seg8) (+ r2 2))"
+    new_cap = "(range (max-list seg8) (+ (max-list seg8) 2))"
+    if canonical.count(old_wall) != 1 or canonical.count(old_cap) != 1:
+        raise ValueError("canonical source no longer has the pinned right-wall expressions")
+    return canonical.replace(old_wall, new_wall, 1).replace(old_cap, new_cap, 1)
+
+
+def _rival_python(grid: list[list[int]]) -> list[list[int]]:
+    h, w = len(grid), len(grid[0])
+    eight_cols = [c for c in range(w) if grid[0][c] == 8]
+    two_row = next(r for r in range(h) if any(grid[r][c] == 2 for c in range(w)))
+    bar_row = two_row - 1
+    segments: list[tuple[int, int]] = []
+    c = 0
+    while c < w:
+        if grid[two_row][c] != 2:
+            c += 1
+            continue
+        cc = c
+        while cc < w and grid[two_row][cc] == 2:
+            cc += 1
+        segments.append((c, cc - 1))
+        c = cc
+    out = [row[:] for row in grid]
+    for col in eight_cols:
+        for r in range(bar_row, h):
+            out[r][col] = 8
+    for left, right in segments:
+        seg8 = [c for c in eight_cols if left <= c <= right]
+        has_left = bool(seg8) and min(seg8) == left
+        has_right = bool(seg8) and any(c > left for c in seg8)
+        if has_left:
+            wall = left - 1
+            for r in range(bar_row, h):
+                out[r][wall] = 8
+            for c in range(wall, min(seg8) + 1):
+                out[bar_row][c] = 8
+        if has_right:
+            wall = max(seg8) + 1
+            for r in range(bar_row, h):
+                out[r][wall] = 8
+            for c in range(max(seg8), wall + 1):
+                out[bar_row][c] = 8
+        for col in seg8:
+            out[two_row][col] = 2
+            for r in range(two_row + 1, h):
+                out[r][col] = 0
+        for col in range(left, right + 1):
+            if grid[two_row][col] == 2:
+                out[two_row][col] = 2
+    return out
+
+
+def build() -> dict[str, object]:
+    module, source_path, source_sha256 = load_selected_generator(TASK_ID)
+    if source_sha256 != EXPECTED_SOURCE_SHA256:
+        raise ValueError("peer source differs from assigned source binding")
+    root = find_root(__file__)
+    canonical = _canonical_program(root)
+    rival = _rival_program(canonical)
+    grids = [module.generate(SEED, index, difficulty=None) for index in (*DEMO_INDICES, QUERY_INDEX)]
+    if any(module.self_check(grid) for grid in grids):
+        raise AssertionError("retained generated input failed its source validator")
+
+    runtime_root = root / "shared/runtime"
+    with _local_imports(runtime_root, source_path.parent):
+        apply, runtime, bridge = _real_evaluator(runtime_root)
+        try:
+            actual = [apply(canonical, grid) for grid in grids]
+            alternatives = [apply(rival, grid) for grid in grids]
+        finally:
+            bridge.close()
+
+    mirrors = [module._apply(grid) for grid in grids]
+    if actual != mirrors:
+        raise AssertionError("selected Python mirror differs from protected canonical Racket")
+    rival_mirrors = [_rival_python(grid) for grid in grids]
+    if alternatives != rival_mirrors:
+        raise AssertionError("rival Python mirror differs from protected rival Racket")
+    if any(actual[i] != alternatives[i] for i in range(len(DEMO_INDICES))):
+        raise AssertionError("rival does not fit all four demonstrations")
+    if actual[-1] == alternatives[-1]:
+        raise AssertionError("rival does not disagree on the query")
+
+    differing = [
+        {"row": r, "col": c, "selected": actual[-1][r][c], "rival": alternatives[-1][r][c]}
+        for r in range(len(actual[-1]))
+        for c in range(len(actual[-1][0]))
+        if actual[-1][r][c] != alternatives[-1][r][c]
+    ]
+    return {
+        "schema": "arcpuzzles-peer-teaching-counterexample-v1",
+        "task_id": TASK_ID,
+        "source": {"path": str(source_path.relative_to(root)), "sha256": source_sha256},
+        "lesson": {
+            "seed": SEED,
+            "difficulty": None,
+            "demonstration_indices": list(DEMO_INDICES),
+            "query_index": QUERY_INDEX,
+        },
+        "selected_rule": {
+            "program_sha256": _sha(canonical),
+            "description": "Place a pierced segment's right wall one column after the segment's right edge.",
+        },
+        "rival_rule": {
+            "program_sha256": _sha(rival),
+            "description": "Place the right wall immediately after the rightmost pipe inside the segment.",
+        },
+        "protected_racket": runtime,
+        "demonstrations": [
+            {"input": grids[i], "output": actual[i], "rival_output": alternatives[i]}
+            for i in range(len(DEMO_INDICES))
+        ],
+        "query": {
+            "input": grids[-1],
+            "output": actual[-1],
+            "rival_output": alternatives[-1],
+            "differing_cells": differing,
+        },
+        "result": {
+            "rival_matches_all_demonstrations": True,
+            "rival_changes_query": True,
+            "query_differing_cell_count": len(differing),
+        },
+        "limits": "One deterministic five-pair generated lesson and one explicit rival; not a universal ambiguity claim or owner acceptance.",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists() or args.out.is_symlink():
+        raise FileExistsError(f"choose a new output path: {args.out}")
+    result = build()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "task_id": TASK_ID,
+        "source_sha256": result["source"]["sha256"],
+        "demonstrations": len(result["demonstrations"]),
+        "query_differing_cells": result["result"]["query_differing_cell_count"],
+        "out": str(args.out),
+    }, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
