(rule!
  (let* ((greens (filter (lambda (obj) (= (obj-color obj) 3)) (objects g 0)))
         (target (first (sort-by greens (lambda (obj) (obj-size obj)))))
         (bb (obj-bbox target))
         (r0 (first bb))
         (c0 (second bb))
         (r1 (third bb))
         (c1 (fourth bb)))
    (reduce (lambda (out r)
      (reduce (lambda (out2 c)
        (if (and (= (cell-at g r c) 3)
                 (or (= r r0) (= r r1) (= c c0) (= c c1)))
          (set-cell out2 r c 8)
          out2))
        out (range c0 (+ c1 1))))
      g (range r0 (+ r1 1)))))
