+#!/usr/bin/env python3
+"""Protected-Racket probe for a foreground-size shortcut in ``1e07c169ac61``.
+
+A deterministic medium-band window has four demonstrations containing at most
+six foreground cells, followed by a seven-cell query.  The rival rotates small
+foregrounds clockwise around the color-9 anchor but leaves larger foregrounds
+unchanged.  It therefore fits every visible demonstration and changes the
+query, revealing a lesson-identifiability gap not covered by the declared
+pivot/color/connectivity rivals.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Sequence
+
+TASK_ID = "1e07c169ac61"
+EXPECTED_GENERATOR_SHA256 = "e343c884bfc5aed2f048c0c4a9492e70602aaf04e6df004cbee35f505b917174"
+RIVAL_NAME = "rotate_clockwise_only_when_foreground_at_most_threshold"
+_NEEDLE = "(r (+ (first anchor) dc)) (c (- (second anchor) dr))"
+
+
+def _intended(module, grid: list[list[int]]) -> list[list[int]]:
+    return module._rotate_selected(grid)
+
+
+def _require_expected_source(source_sha256: str) -> None:
+    if source_sha256 != EXPECTED_GENERATOR_SHA256:
+        raise ValueError(
+            f"source drift for {TASK_ID}: expected {EXPECTED_GENERATOR_SHA256}, got {source_sha256}"
+        )
+
+
+def _foreground_size(module, grid: list[list[int]]) -> int:
+    return int(module.observe_overrides(grid)["foreground_size"])
+
+
+def _rival_python(module, grid: list[list[int]], threshold: int) -> list[list[int]]:
+    if _foreground_size(module, grid) <= threshold:
+        return _intended(module, grid)
+    return copy.deepcopy(grid)
+
+
+def build_case(
+    module,
+    *,
+    seed: int = 0,
+    band: str = "medium",
+    start: int = 3,
+    threshold: int = 6,
+) -> dict[str, Any]:
+    demo_indices = list(range(start, start + int(module.EXAMPLES_NEEDED)))
+    query_index = start + int(module.EXAMPLES_NEEDED)
+    demos: list[dict[str, Any]] = []
+    demo_sizes: list[int] = []
+    demo_matches: list[bool] = []
+
+    for sample_index in demo_indices:
+        grid = module.generate(seed, sample_index, difficulty=band)
+        expected = _intended(module, grid)
+        demos.append({"input": grid, "output": expected})
+        demo_sizes.append(_foreground_size(module, grid))
+        demo_matches.append(_rival_python(module, grid, threshold) == expected)
+
+    query_grid = module.generate(seed, query_index, difficulty=band)
+    query_output = _intended(module, query_grid)
+    query_size = _foreground_size(module, query_grid)
+    query_rival = _rival_python(module, query_grid, threshold)
+
+    if not all(size <= threshold for size in demo_sizes):
+        raise AssertionError("selected demonstrations are not all below the size threshold")
+    if query_size <= threshold:
+        raise AssertionError("selected query does not cross the size threshold")
+    if not all(demo_matches):
+        raise AssertionError("size-threshold rival does not fit every demonstration")
+    if query_rival == query_output:
+        raise AssertionError("size-threshold rival does not change the query")
+
+    return {
+        "seed": seed,
+        "band": band,
+        "threshold": threshold,
+        "demo_indices": demo_indices,
+        "query_index": query_index,
+        "demo_foreground_sizes": demo_sizes,
+        "query_foreground_size": query_size,
+        "rival_demo_matches": demo_matches,
+        "rival_query_matches": query_rival == query_output,
+        "demonstrations": demos,
+        "query": {
+            "input": query_grid,
+            "intended_output": query_output,
+            "rival_output": query_rival,
+        },
+    }
+
+
+def census(
+    module,
+    *,
+    seeds: Sequence[int] = tuple(range(16)),
+    starts: range = range(12),
+    thresholds: Sequence[int] = (3, 4, 5, 6, 7),
+) -> dict[str, Any]:
+    opportunities: list[dict[str, Any]] = []
+    windows = 0
+    for band in ("easy", "medium", "hard"):
+        for seed in seeds:
+            for start in starts:
+                windows += 1
+                grids = [
+                    module.generate(seed, start + offset, difficulty=band)
+                    for offset in range(int(module.EXAMPLES_NEEDED) + 1)
+                ]
+                sizes = [_foreground_size(module, grid) for grid in grids]
+                for threshold in thresholds:
+                    if all(size <= threshold for size in sizes[:-1]) and sizes[-1] > threshold:
+                        opportunities.append(
+                            {
+                                "band": band,
+                                "seed": seed,
+                                "start": start,
+                                "threshold": threshold,
+                                "sizes": sizes,
+                            }
+                        )
+    return {
+        "windows": windows,
+        "thresholds": list(thresholds),
+        "opportunity_count": len(opportunities),
+        "examples": opportunities[:12],
+        "limits": (
+            "Finite Python census over seeds 0..15 and starts 0..11; each recorded "
+            "window is guaranteed to change its query because generated foregrounds "
+            "are not rotation-invariant."
+        ),
+    }
+
+
+def _canonical_program(root: Path) -> str:
+    from reviewer_support import canonical_path
+
+    programs: set[str] = set()
+    with canonical_path(root).open("r", encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID and isinstance(row.get("program_solution"), str):
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise ValueError(
+            f"expected one distinct canonical Racket source for {TASK_ID}, found {len(programs)}"
+        )
+    return next(iter(programs))
+
+
+def rival_program(canonical_program: str, threshold: int) -> str:
+    if canonical_program.count(_NEEDLE) != 1:
+        raise ValueError("canonical Racket source no longer has the expected coordinate block")
+    replacement = (
+        f"(r (if (<= (length objs) {threshold}) (+ (first anchor) dc) (first p))) "
+        f"(c (if (<= (length objs) {threshold}) (- (second anchor) dr) (second p)))"
+    )
+    return canonical_program.replace(_NEEDLE, replacement, 1)
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join(
+        "(" + " ".join(str(value) for value in row) + ")" for row in grid
+    ) + ")"
+
+
+def _runtime_summary(identity: dict[str, Any]) -> dict[str, Any]:
+    keys = (
+        "schema",
+        "backend",
+        "protected",
+        "binary_sha256",
+        "prelude_sha256",
+        "bridge_sha256",
+        "boot_script_sha256",
+        "candidate_symbol_policy_sha256",
+    )
+    return {key: identity[key] for key in keys if key in identity}
+
+
+def racket_probe(case: dict[str, Any], *, root: Path) -> dict[str, Any]:
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    canonical = _canonical_program(root)
+    rival = rival_program(canonical, int(case["threshold"]))
+    wrapped_canonical = wrap_rule(canonical)
+    wrapped_rival = wrap_rule(rival)
+    pairs = list(case["demonstrations"]) + [
+        {"input": case["query"]["input"], "output": case["query"]["intended_output"]}
+    ]
+    canonical_matches: list[bool] = []
+    rival_matches: list[bool] = []
+    rival_outputs: list[list[list[int]]] = []
+
+    with RacketBridge(max_calls_before_restart=32) as bridge:
+        identity = dict(bridge.runtime_identity)
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires the protected Racket backend")
+        for pair in pairs:
+            literal = _grid_literal(pair["input"])
+            canonical_output = bridge.eval_text(f"({wrapped_canonical} {literal})")
+            rival_output = bridge.eval_text(f"({wrapped_rival} {literal})")
+            canonical_matches.append(canonical_output == pair["output"])
+            rival_matches.append(rival_output == pair["output"])
+            rival_outputs.append(rival_output)
+
+    expected_pattern = [True] * len(case["demonstrations"]) + [False]
+    if not all(canonical_matches):
+        raise AssertionError("canonical Racket authority disagrees with generated labels")
+    if rival_matches != expected_pattern:
+        raise AssertionError(
+            f"Racket rival match pattern changed: expected {expected_pattern}, got {rival_matches}"
+        )
+    if rival_outputs[-1] != case["query"]["rival_output"]:
+        raise AssertionError("Python and Racket rival outputs disagree on the query")
+
+    return {
+        "runtime": _runtime_summary(identity),
+        "evaluations": len(pairs) * 2,
+        "canonical_matches": canonical_matches,
+        "rival_matches": rival_matches,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
+        "rival_program_sha256": hashlib.sha256(rival.encode("utf-8")).hexdigest(),
+        "rival_program": rival,
+    }
+
+
+def build_report(
+    *,
+    seed: int = 0,
+    band: str = "medium",
+    start: int = 3,
+    threshold: int = 6,
+    root: Path | None = None,
+) -> dict[str, Any]:
+    from reviewer_support import find_root, load_selected_generator
+
+    selected_root = Path(root or find_root(__file__)).resolve()
+    module, source, source_sha256 = load_selected_generator(TASK_ID, root=selected_root)
+    _require_expected_source(source_sha256)
+    case = build_case(
+        module,
+        seed=seed,
+        band=band,
+        start=start,
+        threshold=threshold,
+    )
+    return {
+        "schema": "arcpuzzles-peer-learnability-counterexample-v1",
+        "task_id": TASK_ID,
+        "status": "counterexample_confirmed",
+        "finding": (
+            "The visible demonstrations contain only foreground sizes at or below "
+            f"{threshold}, while the query has a larger foreground. A rule that rotates "
+            "only small foregrounds fits every demo and leaves the query unchanged."
+        ),
+        "recommended_repair": (
+            "Cover the query's size regime in at least one demonstration, or add a "
+            "foreground-size-gated rival family to lesson_identifiable and resample "
+            "windows that leave the query's regime unseen."
+        ),
+        "limits": (
+            "One protected-Racket counterexample plus a finite Python census; this is "
+            "not a universal characterization of all possible size-conditioned rules."
+        ),
+        "source": {
+            "generator": str(source.relative_to(selected_root)),
+            "generator_sha256": source_sha256,
+        },
+        "case": case,
+        "census": census(module),
+        "racket": racket_probe(case, root=selected_root),
+    }
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--band", choices=("easy", "medium", "hard"), default="medium")
+    parser.add_argument("--start", type=int, default=3)
+    parser.add_argument("--threshold", type=int, default=6)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+
+    report = build_report(
+        seed=args.seed,
+        band=args.band,
+        start=args.start,
+        threshold=args.threshold,
+    )
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "task_id": TASK_ID,
+                "evaluations": report["racket"]["evaluations"],
+                "rival_matches": report["racket"]["rival_matches"],
+                "census_opportunities": report["census"]["opportunity_count"],
+                "out": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
