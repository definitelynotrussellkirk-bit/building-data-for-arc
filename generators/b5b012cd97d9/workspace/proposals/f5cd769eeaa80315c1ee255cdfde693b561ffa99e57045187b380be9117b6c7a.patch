+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib.util
+import json
+import random
+import sys
+from pathlib import Path
+
+import pytest
+
+from arcpuzzles import Catalog
+from reviewer_support import public_challenge_bytes, public_challenge_id
+
+
+TASK_ID = "b5b012cd97d9"
+TASK_HOME = Path(__file__).resolve().parents[1]
+REPO_ROOT = Path(__file__).resolve().parents[3]
+PARAMETRIC = TASK_HOME / "workspace" / "parametric"
+PROTOTYPE = PARAMETRIC / "prototype.py"
+ADAPTER = PARAMETRIC / "adapter.py"
+PROMOTION = PARAMETRIC / "promotion.json"
+DEFAULT = {"placement": "canonical"}
+ALTERNATE = {"placement": "preserve_vertical"}
+
+
+def _load(name: str, path: Path):
+    assert path.is_file(), f"missing parametric source: {path}"
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _prototype():
+    return _load("_b5b012cd97d9_parametric_test_prototype", PROTOTYPE)
+
+
+def _adapter():
+    return _load("_b5b012cd97d9_parametric_test_adapter", ADAPTER)
+
+
+def _canonical_program() -> str:
+    record = Catalog(REPO_ROOT).get(TASK_ID)
+    programs = {
+        variant["program_solution"]
+        for variant in record["variants"]
+        if isinstance(variant.get("program_solution"), str)
+    }
+    assert len(programs) == 1
+    return next(iter(programs))
+
+
+def _inputs(episode: dict) -> list[list[list[int]]]:
+    return [pair["input"] for split in ("train", "test") for pair in episode[split]]
+
+
+def test_default_program_is_exact_authority_and_alternate_is_distinct():
+    adapter = _adapter()
+    canonical = adapter.program(DEFAULT)
+    alternate = adapter.program(ALTERNATE)
+
+    assert canonical == _canonical_program()
+    assert (PARAMETRIC / "canonical.rkt").read_bytes() == canonical.encode("utf-8")
+    assert alternate == (PARAMETRIC / "preserve_vertical.rkt").read_text()
+    assert alternate != canonical
+    assert alternate.strip().startswith("(rule!")
+    assert "bbox-of-cells" in alternate
+    assert "rotate-180" in alternate
+
+
+def test_promotion_contract_and_thin_adapter_support_required_counts():
+    adapter = _adapter()
+    contract = json.loads(PROMOTION.read_text())
+    assert contract == {
+        "schema": "arcpuzzles-parametric-adapter-v1",
+        "adapter": "generators/b5b012cd97d9/workspace/parametric/adapter.py",
+        "parameters": {"placement": ["canonical", "preserve_vertical"]},
+        "default": {"placement": "canonical"},
