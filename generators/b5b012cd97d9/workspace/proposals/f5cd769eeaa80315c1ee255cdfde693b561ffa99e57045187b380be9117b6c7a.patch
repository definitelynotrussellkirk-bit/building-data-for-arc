+#!/usr/bin/env python3
+"""Protected-Racket probe for a five-cell-only shortcut in ``fc41c9b3a565``.
+
+The production schedule emits four generalized scenes at sample indices 1..4,
+where every object has five cells, followed by a canonical anchor at index 5,
+where the kept objects have four cells.  A rival can therefore implement the
+intended 180-degree symmetry test only for five-cell objects, fit every visible
+demonstration, and erase the canonical query's correct four-cell objects.
+
+This tool leaves the production generator unchanged.  It binds the case to the
+selected generator and canonical Racket source, executes both rules through the
+protected Racket bridge, and writes a compact JSON counterexample.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Sequence
+
+TASK_ID = "fc41c9b3a565"
+EXPECTED_GENERATOR_SHA256 = "23dce83c22deae4bd08d1c08552143a1eeca2ac037b04f6467501c41b4d400c1"
+RIVAL_NAME = "keep_180_symmetric_only_when_size_5"
+_DEMO_INDICES = (1, 2, 3, 4)
+_QUERY_INDEX = 5
+_RIVAL_NEEDLE = "(if (shape-180-symmetric? shape)"
+_RIVAL_REPLACEMENT = (
+    "(if (and (= (length (obj-cells obj)) 5) "
+    "(shape-180-symmetric? shape))"
+)
+
+
+def _require_expected_source(source_sha256: str) -> None:
+    if source_sha256 != EXPECTED_GENERATOR_SHA256:
+        raise ValueError(
+            f"source drift for {TASK_ID}: expected {EXPECTED_GENERATOR_SHA256}, got {source_sha256}"
+        )
+
+
+def _object_sizes(module, grid: list[list[int]]) -> list[int]:
+    errors, analysis = module._analyze_grid(grid)
+    if errors or analysis is None:
+        raise ValueError("probe received an invalid generated grid: " + "; ".join(errors))
+    return sorted(int(obj["cell_count"]) for obj in analysis["objects"])
+
+
+def _rival_python(module, grid: list[list[int]]) -> list[list[int]]:
+    result = module._paint_selected(
+        grid,
+        lambda obj: obj["rot180_symmetric"] and obj["cell_count"] == 5,
+    )
+    if result is None:
+        raise ValueError("probe rival received an invalid grid")
+    return result
+
+
+def build_case(module, *, seed: int = 0, band: str = "medium") -> dict[str, Any]:
+    demos: list[dict[str, Any]] = []
+    demo_sizes: list[list[int]] = []
+    rival_demo_matches: list[bool] = []
+    for sample_index in _DEMO_INDICES:
+        grid = module.generate(seed, sample_index, difficulty=band)
+        expected = module.rule_mirror(grid)
+        demos.append({"input": grid, "output": expected})
+        sizes = _object_sizes(module, grid)
+        demo_sizes.append(sizes)
+        rival_demo_matches.append(_rival_python(module, grid) == expected)
+
+    query_grid = module.generate(seed, _QUERY_INDEX, difficulty=band)
+    query_output = module.rule_mirror(query_grid)
+    query_sizes = _object_sizes(module, query_grid)
+    rival_query = _rival_python(module, query_grid)
+
+    if not all(rival_demo_matches):
+        raise AssertionError("size-gated rival does not fit every demonstration")
+    if rival_query == query_output:
+        raise AssertionError("size-gated rival does not change the query")
+    if not all(sizes and set(sizes) == {5} for sizes in demo_sizes):
+        raise AssertionError("ordinary demonstrations are no longer all five-cell scenes")
+    if set(query_sizes) == {5}:
+        raise AssertionError("scheduled canonical query no longer exposes non-five-cell objects")
+
+    return {
+        "seed": seed,
+        "band": band,
+        "demo_indices": list(_DEMO_INDICES),
+        "query_index": _QUERY_INDEX,
+        "demo_object_sizes": demo_sizes,
+        "query_object_sizes": query_sizes,
+        "rival_demo_matches": rival_demo_matches,
+        "rival_query_matches": rival_query == query_output,
+        "demonstrations": demos,
+        "query": {
+            "input": query_grid,
+            "intended_output": query_output,
+            "rival_output": rival_query,
+        },
+    }
+
+
+def _canonical_program(root: Path) -> str:
+    from reviewer_support import canonical_path
+
+    matches: list[str] = []
+    with canonical_path(root).open("r", encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                program = row.get("program_solution")
+                if isinstance(program, str):
+                    matches.append(program)
+    if len(matches) != 1:
+        raise ValueError(f"expected one canonical Racket source for {TASK_ID}, found {len(matches)}")
+    return matches[0]
+
+
+def rival_program(canonical_program: str) -> str:
+    if canonical_program.count(_RIVAL_NEEDLE) != 1:
+        raise ValueError("canonical Racket source no longer has the expected symmetry branch")
+    return canonical_program.replace(_RIVAL_NEEDLE, _RIVAL_REPLACEMENT, 1)
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join(
+        "(" + " ".join(str(value) for value in row) + ")" for row in grid
+    ) + ")"
+
+
+def _runtime_summary(identity: dict[str, Any]) -> dict[str, Any]:
+    keys = (
+        "schema",
+        "backend",
+        "protected",
+        "binary_sha256",
+        "prelude_sha256",
+        "bridge_sha256",
+        "boot_script_sha256",
+        "candidate_symbol_policy_sha256",
+    )
+    return {key: identity[key] for key in keys if key in identity}
+
+
+def racket_probe(module, case: dict[str, Any], *, root: Path) -> dict[str, Any]:
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    canonical = _canonical_program(root)
+    rival = rival_program(canonical)
+    wrapped = {
+        "canonical": wrap_rule(canonical),
+        RIVAL_NAME: wrap_rule(rival),
+    }
+    pairs = list(case["demonstrations"]) + [
+        {"input": case["query"]["input"], "output": case["query"]["intended_output"]}
+    ]
+    intended_matches: list[bool] = []
+    rival_matches: list[bool] = []
+    rival_outputs: list[list[list[int]]] = []
+
+    with RacketBridge(max_calls_before_restart=32) as bridge:
+        identity = dict(bridge.runtime_identity)
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires the protected Racket backend")
+        for pair in pairs:
+            literal = _grid_literal(pair["input"])
+            intended = bridge.eval_text(f"({wrapped['canonical']} {literal})")
+            rival_output = bridge.eval_text(f"({wrapped[RIVAL_NAME]} {literal})")
+            intended_matches.append(intended == pair["output"])
+            rival_matches.append(rival_output == pair["output"])
+            rival_outputs.append(rival_output)
+
+    expected_pattern = [True] * len(case["demonstrations"]) + [False]
+    if not all(intended_matches):
+        raise AssertionError("canonical Racket authority disagrees with generated labels")
+    if rival_matches != expected_pattern:
+        raise AssertionError(
+            f"Racket rival match pattern changed: expected {expected_pattern}, got {rival_matches}"
+        )
+    if rival_outputs[-1] != case["query"]["rival_output"]:
+        raise AssertionError("Python and Racket rival outputs disagree on the query")
+
+    return {
+        "runtime": _runtime_summary(identity),
+        "evaluations": len(pairs) * 2,
+        "canonical_matches": intended_matches,
+        "rival_matches": rival_matches,
+        "canonical_program_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
+        "rival_program_sha256": hashlib.sha256(rival.encode("utf-8")).hexdigest(),
+        "rival_program": rival,
+    }
+
+
+def build_report(*, seed: int = 0, band: str = "medium", root: Path | None = None) -> dict[str, Any]:
+    from reviewer_support import find_root, load_selected_generator
+
+    selected_root = Path(root or find_root(__file__)).resolve()
+    module, source, source_sha256 = load_selected_generator(TASK_ID, root=selected_root)
+    _require_expected_source(source_sha256)
+    case = build_case(module, seed=seed, band=band)
+    racket = racket_probe(module, case, root=selected_root)
+    return {
+        "schema": "arcpuzzles-peer-learnability-counterexample-v1",
+        "task_id": TASK_ID,
+        "status": "counterexample_confirmed",
+        "finding": (
+            "Four ordinary demonstrations expose only five-cell objects; the next "
+            "scheduled canonical query contains four-cell kept objects. A size-gated "
+            "180-degree-symmetry rule fits every demo and changes the query."
+        ),
+        "recommended_repair": (
+            "Do not place a canonical anchor only in the query. Include at least one "
+            "canonical/non-five-cell demonstration whenever such a query is possible, "
+            "or add this size-gated competitor to lesson_identifiable."
+        ),
+        "limits": (
+            "One deterministic source-bound lesson (seed 0, medium, indices 1..5); "
+            "this demonstrates a real ambiguity but is not a census of every lesson."
+        ),
+        "source": {
+            "generator": str(source.relative_to(selected_root)),
+            "generator_sha256": source_sha256,
+        },
+        "case": case,
+        "racket": racket,
+    }
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--band", choices=("easy", "medium", "hard"), default="medium")
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+
+    report = build_report(seed=args.seed, band=args.band)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "task_id": TASK_ID,
+                "evaluations": report["racket"]["evaluations"],
+                "rival_matches": report["racket"]["rival_matches"],
+                "out": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
