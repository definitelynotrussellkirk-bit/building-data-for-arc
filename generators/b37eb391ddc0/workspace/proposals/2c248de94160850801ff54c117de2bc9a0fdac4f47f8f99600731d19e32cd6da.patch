+"""Native parametric regressions for b37eb391ddc0."""
+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import random
+import sys
+
+import pytest
+
+from reviewer_support import canonical_path, find_root, public_challenge_bytes, public_challenge_id
+
+
+TASK_ID = "b37eb391ddc0"
+ROOT = find_root(__file__)
+HOME = ROOT / "generators" / TASK_ID
+PARAMETRIC = HOME / "workspace" / "parametric"
+CANONICAL = {"completion": "all_colors"}
+RAREST = {"completion": "rarest_active_color"}
+
+
+def load(name: str):
+    path = PARAMETRIC / name
+    assert path.is_file(), f"missing parametric source: {path}"
+    module_name = f"_{TASK_ID}_{name.replace('.', '_')}"
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def canonical_record() -> dict:
+    for line in canonical_path(ROOT).read_text(encoding="utf-8").splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            return row
+    raise AssertionError("canonical record missing")
+
+
+def inputs(episode: dict) -> list[list[list[int]]]:
+    return [pair["input"] for split in ("train", "test") for pair in episode[split]]
+
+
+def test_contract_and_programs_preserve_exact_canonical_default():
+    adapter = load("adapter.py")
+    contract = json.loads((PARAMETRIC / "promotion.json").read_text())
+    assert contract == {
+        "schema": "arcpuzzles-parametric-adapter-v1",
+        "adapter": f"generators/{TASK_ID}/workspace/parametric/adapter.py",
+        "parameters": {"completion": ["all_colors", "rarest_active_color"]},
+        "default": CANONICAL,
+        "limits": {"demos": [2, 6], "queries": [1, 4]},
+        "qualification_demos": 3,
+        "resources": [
+            f"generators/{TASK_ID}/workspace/parametric/canonical.rkt",
+            f"generators/{TASK_ID}/workspace/parametric/rarest_active.rkt",
+        ],
+    }
+    assert adapter.program(CANONICAL) == canonical_record()["program_solution"]
+    assert adapter.program(RAREST) != adapter.program(CANONICAL)
+
+
+@pytest.mark.parametrize("seed", [0, 17])
+@pytest.mark.parametrize("demos", [2, 3, 6])
+def test_matched_inputs_identify_settings_and_supply_four_distinct_queries(seed, demos):
+    adapter = load("adapter.py")
+    canonical = adapter.generate(seed, CANONICAL, demos, 4)
+    rarest = adapter.generate(seed, RAREST, demos, 4)
+    assert inputs(canonical) == inputs(rarest)
+    assert len(canonical["train"]) == demos
+    assert len(canonical["test"]) == 4
+    serialized = [json.dumps(grid, separators=(",", ":")) for grid in inputs(canonical)]
+    assert len(serialized) == len(set(serialized)) == demos + 4
+    assert all(a["output"] != b["output"] for a, b in zip(canonical["train"], rarest["train"]))
+
+    for settings, episode in ((CANONICAL, canonical), (RAREST, rarest)):
+        assert episode["program_solution"] == adapter.program(settings)
+        for pair in episode["train"] + episode["test"]:
+            facts = adapter.analyze(pair["input"])
+            assert len(facts["active_colors"]) == 3
+            assert facts["rarest_active_color"] in facts["active_colors"]
+            assert len(set(facts["active_counts"].values())) == 3
+            assert pair["output"] == adapter.solve(pair["input"], settings["completion"])
+
+    # The minimum lesson changes the input-derived selected color and its count,
+    # defeating a fixed-color or fixed-count interpretation.
+    first_two = [adapter.analyze(pair["input"]) for pair in canonical["train"][:2]]
+    assert len({row["rarest_active_color"] for row in first_two}) == 2
+    assert len({row["active_counts"][row["rarest_active_color"]] for row in first_two}) == 2
+
+    assert [(len(pair["input"]), len(pair["input"][0])) for pair in canonical["test"]] == [
+        (10, 12), (17, 19), (30, 30), (25, 29)
+    ]
+    stress = canonical["test"][2]["input"]
+    assert sum(value != 0 for row in stress for value in row) >= 75
+    occupied_rows = {r for r, row in enumerate(stress) if any(row)}
+    occupied_cols = {c for c in range(30) if any(stress[r][c] for r in range(30))}
+    assert min(occupied_rows) == 0 and max(occupied_rows) == 29
+    assert min(occupied_cols) == 0 and max(occupied_cols) == 29
+
+
+@pytest.mark.parametrize("completion", ["all_colors", "rarest_active_color"])
+def test_programs_execute_through_protected_racket_and_match_claims(completion):
+    adapter = load("adapter.py")
+    from arc_repl.racket_bridge import RacketBridge
+    from puzzle_generators.rule_wrap import wrap_rule
+
+    episode = adapter.generate(17, {"completion": completion}, 2, 4)
+    source = wrap_rule(adapter.program({"completion": completion}))
+    with RacketBridge() as bridge:
+        assert bridge.runtime_identity["backend"] == "racket"
+        assert bridge.runtime_identity["protected"] is True
+        for pair in episode["train"] + episode["test"]:
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in pair["input"]) + ")"
+            assert bridge.eval_text(f"({source} {literal})") == pair["output"]
+
+
+def test_public_turn_is_prefix_stable_and_hashes_visible_bytes_only():
+    adapter = load("adapter.py")
+    one = adapter.generate(17, RAREST, 3, 1)
+    four = adapter.generate(17, RAREST, 3, 4)
+    assert public_challenge_bytes(adapter.public_turn(one)) == public_challenge_bytes(adapter.public_turn(four))
+    public = adapter.public_turn(four, 2)
+    assert set(public) == {"train", "test"}
+    assert len(public["test"]) == 1
+    assert all(set(pair) == {"input", "output"} for pair in public["train"])
+    assert all(set(pair) == {"input"} for pair in public["test"])
+    before = copy.deepcopy(four)
+    payload = public_challenge_bytes(public)
+    assert public_challenge_id(public) == hashlib.sha256(payload).hexdigest()
+    assert b"rarest_active_color" not in payload and b"program_solution" not in payload
+    assert four == before
+
+
+@pytest.mark.parametrize("completion", ["all_colors", "rarest_active_color"])
+def test_generation_is_deterministic_fresh_prefix_stable_and_rng_isolated(completion):
+    adapter = load("adapter.py")
+    settings = {"completion": completion}
+    state = random.getstate()
+    full = adapter.generate(2**63 - 1, settings, 6, 4)
+    again = adapter.generate(2**63 - 1, settings, 6, 4)
+    assert full == again and full is not again
+    assert random.getstate() == state
+    for demos, queries in ((2, 1), (3, 4), (6, 1)):
+        small = adapter.generate(2**63 - 1, settings, demos, queries)
+        assert small["train"] == full["train"][:demos]
+        assert small["test"] == full["test"][:queries]
+    full["train"][0]["input"][0][0] = 8
+    assert adapter.generate(2**63 - 1, settings, 6, 4) == again
+
+
+@pytest.mark.parametrize(
+    "args",
+    [
+        (True, CANONICAL, 3, 4), (-1, CANONICAL, 3, 4), (2**63, CANONICAL, 3, 4),
+        (0, CANONICAL, 1, 4), (0, CANONICAL, 7, 4),
+        (0, CANONICAL, 3, 0), (0, CANONICAL, 3, 5),
+        (0, {}, 3, 4), (0, {"completion": "unknown"}, 3, 4),
+        (0, {"completion": "all_colors", "extra": 1}, 3, 4),
+    ],
+)
+def test_invalid_controls_fail_loudly(args):
+    adapter = load("adapter.py")
+    with pytest.raises((TypeError, ValueError)):
+        adapter.generate(*args)
+
+
+def test_finite_demo_only_self_audit_rejects_plausible_shortcuts():
+    adapter = load("adapter.py")
+    rivals = load("rivals.py")
+    for seed in (0, 17, 31):
+        for demos in (2, 3, 6):
+            for setting in (CANONICAL, RAREST):
+                episode = adapter.generate(seed, setting, demos, 4)
+                correct = setting["completion"]
+                survivors = [
+                    name for name in rivals.RIVAL_NAMES
+                    if all(rivals.predict(pair["input"], name) == pair["output"] for pair in episode["train"])
+                ]
+                assert survivors == [correct]
+                assert all(
+                    rivals.predict(pair["input"], correct) == pair["output"]
+                    for pair in episode["test"]
+                )
+
+
+def test_two_demo_rarest_lesson_is_not_first_or_last_active_across_a_seed_sweep():
+    """Catch seed-dependent row-major aliases of the input-derived rare color."""
+    adapter = load("adapter.py")
+    rivals = load("rivals.py")
+    for seed in range(32):
+        episode = adapter.generate(seed, RAREST, 2, 1)
+        for rival in ("first_active_color", "last_active_color"):
+            assert any(
+                rivals.predict(pair["input"], rival) != pair["output"]
+                for pair in episode["train"]
+            ), (seed, rival)
