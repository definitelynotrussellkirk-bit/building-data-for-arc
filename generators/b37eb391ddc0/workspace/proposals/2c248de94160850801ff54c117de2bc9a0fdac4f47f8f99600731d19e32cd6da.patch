+TASK_ID = "be6269bef667"
+ROOT = find_root(__file__)
+HOME = ROOT / "generators" / TASK_ID
+PARAMETRIC = HOME / "workspace" / "parametric"
+CANONICAL = {"weighting": "unit"}
