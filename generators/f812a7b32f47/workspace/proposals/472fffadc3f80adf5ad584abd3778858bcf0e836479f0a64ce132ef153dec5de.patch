+"""Bounded ordinary-lesson audit: gray objects survive but cast no beam shadow.
+Run from WORK/repo through the outer review.py run launcher. No production edits.
+"""
+from pathlib import Path
+import hashlib, importlib.util, json, re, sys, time
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+ROOT=Path(__file__).resolve().parents[3]
+TASK='0b8ba9bb3c63'
+OUT=ROOT.parent/'checks'/TASK/'color-exception-peer'
+
+def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()
+def rival(g,m):
+    obs=m._components(g); cyan=next(o for o in obs if o['color']==8)
+    opaque=[o for o in obs if o['color'] not in (2,8)]
+    out=m._paint_cross(g,cyan,[o for o in opaque if o['color']!=5])
+    for o in opaque:
+        for r,c in o['cells']: out[r][c]=o['color']
+    return out
+
+def main():
+    began=time.monotonic(); OUT.mkdir(parents=True,exist_ok=False)
+    source=ROOT/'generators'/TASK/'generator.py'
+    selected_hash=sha(source)
+    runtime=ROOT/'shared/runtime'
+    with _local_imports(runtime,runtime):
+        spec=importlib.util.spec_from_file_location('peer_target',source)
+        m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
+        search=[]; found=None
+        for seed in range(10):
+            if time.monotonic()-began>70: break
+            cases=[]
+            for i in range(4):
+                g=m.generate(seed,i); problems=m.self_check(g)
+                assert not problems,problems
+                expected=m.rule_mirror(g); predicted=rival(g,m)
+                cases.append({'sample_index':i,'input':g,'mirror':expected,'rival_mirror':predicted,
+                              'family':m.canonical_profile_signature(g),'self_check':problems})
+            flags=[c['mirror']!=c['rival_mirror'] for c in cases]
+            search.append({'seed':seed,'mismatches':flags})
+            if not any(flags[:3]) and flags[3]: found=(seed,cases); break
+        report={'schema':'bounded-color-exception-peer-v1','task_id':TASK,'generator_sha256':selected_hash,
+                'probe_sha256':sha(Path(__file__)),'search':search,'found':found is not None,
+                'limits':'At most ten ordinary seeds, four consecutive default draws each; fixed gray(5) exception rival. Finite directed search, no prevalence or universal-identifiability claim.'}
+        if found:
+            seed,cases=found
+            catalog=Catalog(ROOT); desc=catalog.describe(TASK); rule_id=desc.get('rule_task_id',TASK)
+            variants=catalog._variants()[rule_id]
+            programs={v['program_solution'] for v in variants}; assert len(programs)==1
+            program=next(iter(programs))
+            # Four clipping reductions use shadow-blockers; restoration keeps original blockers.
+            pattern=r'(?<![\w-])blockers(?=\))'
+            assert len(re.findall(pattern,program))==5
+            alt=re.sub(pattern,'shadow-blockers',program,count=4)
+            marker='                                        objs))'
+            assert alt.count(marker)==1
+            alt=alt.replace(marker,marker+'\n                      (shadow-blockers (filter (lambda (o) (!= (obj-color o) 5)) blockers))')
+            (OUT/'canonical.rkt').write_text(program)
+            (OUT/'gray-no-shadow.rkt').write_text(alt)
+            apply,identity,bridge=_real_evaluator(runtime)
+            try:
+                report.update(seed=seed,rule_task_id=rule_id,declared_rule_hash=m.RULE_HASH,
+                              canonical_program_sha256=hashlib.sha256(program.encode()).hexdigest(),
+                              rival_program_sha256=hashlib.sha256(alt.encode()).hexdigest(),runtime_identity=identity)
+                for c in cases:
+                    c['output']=apply(program,c['input']); c['rival_output']=apply(alt,c['input'])
+                    assert c['output']==c.pop('mirror')
+                    assert c['rival_output']==c.pop('rival_mirror')
+                    c['difference_cells']=[{'row':r,'col':j,'canonical':v,'rival':c['rival_output'][r][j]}
+                                           for r,row in enumerate(c['output']) for j,v in enumerate(row) if v!=c['rival_output'][r][j]]
+                report.update(cases=cases,rival_fits_all_demos=all(not c['difference_cells'] for c in cases[:3]),
+                              query_difference_count=len(cases[3]['difference_cells']),
+                              current_lesson_identifiable=m.lesson_identifiable(cases[:3],cases[3]))
+                assert report['rival_fits_all_demos'] and report['query_difference_count']>0
+            finally: bridge.close()
+        assert sha(source)==selected_hash
+        report['elapsed_seconds']=round(time.monotonic()-began,3)
+        (OUT/'evidence.json').write_text(json.dumps(report,indent=2)+'\n')
+        print(json.dumps({k:v for k,v in report.items() if k not in ('cases','runtime_identity')},sort_keys=True))
+    return 0
+if __name__=='__main__': raise SystemExit(main())
