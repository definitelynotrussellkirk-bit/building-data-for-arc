+#!/usr/bin/env python3
+"""Bounded finite-rival check; canonical visible train demos + retained generated query.
+No solve-private files, no parameter qualification, no approval changes.
+"""
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+WORK = ROOT.parent
+TASK = '7c2a3ec6c4fb'
+sys.path.insert(0, str(ROOT / 'src'))
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def orthogonal_rival(grid):
+    """Scan-order 4-connected foreground bbox crops; first exact singleton."""
+    unseen = {(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value}
+    crops = []
+    while unseen:
+        start = min(unseen)
+        unseen.remove(start)
+        todo, cells = [start], {start}
+        while todo:
+            r, c = todo.pop()
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                pos = (r + dr, c + dc)
+                if pos in unseen:
+                    unseen.remove(pos)
+                    cells.add(pos)
+                    todo.append(pos)
+        r0, r1 = min(r for r, c in cells), max(r for r, c in cells)
+        c0, c1 = min(c for r, c in cells), max(c for r, c in cells)
+        crops.append(tuple(tuple(row[c0:c1 + 1]) for row in grid[r0:r1 + 1]))
+    counts = Counter(crops)
+    return [list(row) for row in next((p for p in crops if counts[p] == 1), ())]
+
+
+def main():
+    task = ROOT / 'generators' / TASK
+    out = WORK / 'checks' / TASK
+    out.mkdir(parents=True, exist_ok=True)
+    canonical = Catalog(ROOT)._variants()[TASK]
+    assert len(canonical) == 1
+    canonical = canonical[0]
+    program = canonical['program_solution']
+    retained_path = task / 'counterexamples/current-shortcut/checks/question-counterexample.json'
+    retained = json.loads(retained_path.read_text())
+    generator = task / 'generator.py'
+    runtime = ROOT / 'shared/runtime'
+    with _local_imports(runtime, runtime):
+        spec = importlib.util.spec_from_file_location('peer_selected_generator', generator)
+        gen = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(gen)
+        query = gen.generate(retained['seed'], retained['sample_index'], difficulty=retained['difficulty'], **retained['overrides'])
+        assert query == retained['input']
+        assert not gen.self_check(query)
+        apply, identity, bridge = _real_evaluator(runtime)
+        try:
+            demos = []
+            for index, pair in enumerate(canonical['train']):
+                actual = apply(program, pair['input'])
+                rival = orthogonal_rival(pair['input'])
+                assert actual == pair['output'] == rival
+                demos.append({'index': index, 'input': pair['input'], 'label': actual, 'rival_output': rival})
+            actual = apply(program, query)
+            rival = orthogonal_rival(query)
+            assert actual == retained['actual_racket_output'] == gen.rule_mirror(query)
+            assert rival == retained['rival_output'] and rival != actual
+        finally:
+            bridge.close()
+    report = {
+        'schema': 'bounded-peer-learnability-v1', 'task_id': TASK,
+        'result': 'finite_rival_survives_visible_demos_disagrees_generated_query',
+        'scope': 'Canonical public train demonstrations; retained generator query. Not a masked solve episode or model-training experiment.',
+        'interpretation': 'Existing four-neighbor shortcut confirmed; current v3.2.0 generator already emits its counterexample. No new uncovered defect or approval.',
+        'generator_sha256': digest(generator), 'generator_version': gen.VERSION,
+        'canonical_program': program, 'canonical_program_sha256': hashlib.sha256(program.encode()).hexdigest(),
+        'racket_identity': identity,
+        'rival': {'description': orthogonal_rival.__doc__, 'source_path': str(Path(__file__).relative_to(WORK)), 'source_sha256': digest(__file__), 'entrypoint': 'orthogonal_rival'},
+        'retained_evidence': {'path': str(retained_path.relative_to(WORK)), 'sha256': digest(retained_path)},
+        'demonstrations': demos,
+        'query': {'input': query, 'label': actual, 'rival_output': rival, 'seed': retained['seed'], 'sample_index': retained['sample_index'], 'difficulty': retained['difficulty'], 'overrides': retained['overrides'], 'validator_errors': []},
+        'counts': {'demos': len(demos), 'racket_evaluations': len(demos) + 1, 'rival_demo_matches': len(demos), 'query_disagreements': 1},
+        'remaining_failures': [],
+        'command': 'WORK/.venv/bin/python review.py run python3 generators/7c2a3ec6c4fb/workspace/peer_learnability_probe.py',
+    }
+    (out / 'peer-learnability.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps({'task_id': TASK, 'result': report['result'], **report['counts'], 'generator_sha256': report['generator_sha256'], 'racket_identity': identity}))
+
+
+if __name__ == '__main__':
+    main()
