(rule! (lambda (g)
  (let* ((h (length g))
         (w (length (first g)))
         (scale 2)
         (oh (* h scale))
         (ow (* w scale))
         (pixels (filter (lambda (p) (!= (at g (fst p) (snd p)) 0))
                         (grid-positions g))))
    (reduce (lambda (acc p)
              (let* ((color (at g (fst p) (snd p)))
                     (sr (- (* scale (fst p)) scale))
                     (sc (- (* scale (snd p)) scale)))
                (reduce (lambda (gg q)
                          (let ((nr (fst q))
                                (nc (snd q)))
                            (if (in-bounds? nr nc oh ow)
                                (set-cell gg nr nc color)
                                gg)))
                        acc
                        (positions-in-rect sr sc
                                           (+ sr 3)
                                           (+ sc 3)))))
            (empty-grid oh ow 0)
            pixels))))
