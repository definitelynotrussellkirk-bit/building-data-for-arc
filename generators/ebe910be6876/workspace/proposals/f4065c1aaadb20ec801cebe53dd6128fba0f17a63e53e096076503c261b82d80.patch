+                                (grid-positions g))))
+           (reduce (lambda (acc p)
+                     (let* ((color (at g (fst p) (snd p)))
+                            (sr (- (* 2 (fst p)) 2))
+                            (sc (- (* 2 (snd p)) 2)))
+                       (reduce (lambda (gg q)
+                                 (let ((nr (fst q))
+                                       (nc (snd q)))
+                                   (if (in-bounds? nr nc oh ow)
+                                       (set-cell gg nr nc color)
+                                       gg)))
