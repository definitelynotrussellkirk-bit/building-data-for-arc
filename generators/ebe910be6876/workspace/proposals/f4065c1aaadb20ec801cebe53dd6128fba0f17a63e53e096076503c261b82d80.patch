+from reviewer_support import canonical_pairs, canonical_path, find_root
+
+TASK_ID = "329f699c3e09"
+ROOT = find_root(__file__)
+HOME = ROOT / "generators" / TASK_ID
+
+
+def _load_generator():
+    path = HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location("review_329f699c3e09", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+gen = _load_generator()
+
+
+def _load_collision_probe():
+    path = HOME / "workspace" / "collision_probe.py"
+    spec = importlib.util.spec_from_file_location("review_329f699c3e09_collision_probe", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_program() -> str:
+    programs = {
+        row["program_solution"]
+        for row in map(json.loads, canonical_path(ROOT).read_text().splitlines())
+        if row.get("task_id") == TASK_ID
+    }
+    assert len(programs) == 1
+    return programs.pop()
+
+
+def _literal(grid):
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _destinations(grid):
+    h, w = len(grid), len(grid[0])
+    div_row = next((r for r in range(h) if all(grid[r][c] == 7 for c in range(w))), None)
+    div_col = next((c for c in range(w) if all(grid[r][c] == 7 for r in range(h))), None)
+    assert div_row is not None or div_col is not None
+    result = []
+    for r in range(h):
+        for c in range(w):
+            if grid[r][c] != 6:
+                continue
+            nr, nc = (r, 2 * div_col - c) if div_col is not None else (2 * div_row - r, c)
+            if 0 <= nr < h and 0 <= nc < w:
+                result.append((r, c, nr, nc))
+    return result
+
+
+def test_rule_mirror_matches_every_canonical_label_and_protected_racket():
+    pairs = canonical_pairs(TASK_ID, root=ROOT, labeled_only=True)
+    assert len(pairs) == 5
+    bridge = RacketBridge()
+    try:
+        wrapped = wrap_rule(_canonical_program())
+        for pair in pairs:
+            source = deepcopy(pair["input"])
+            assert gen.self_check(source) == []
+            assert gen.rule_mirror(source) == pair["output"]
+            assert bridge.eval_text(f"({wrapped} {_literal(source)})") == pair["output"]
+            assert source == pair["input"]
+    finally:
+        bridge.close()
+
