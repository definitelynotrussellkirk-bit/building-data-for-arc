+#!/usr/bin/env python3
+"""Source-bound collision audit for ARC task 329f699c3e09.
+
+The generator's rule paints cyan cells at reflected destinations.  This probe
+verifies that generated distractors never occupy those destinations before the
+rule runs, replays the two historical collision seeds, and optionally compares
+representative Python labels with protected Racket execution.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+TASK_ID = "329f699c3e09"
+BANDS = ("easy", "medium", "hard")
+KNOWN_WITNESSES = ((21, 0, "easy"), (26, 26, "easy"))
+
+
+def _repo_root() -> Path:
+    here = Path(__file__).resolve()
+    for parent in here.parents:
+        if (parent / "shared" / "runtime" / "reviewer_support.py").is_file():
+            return parent
+    raise RuntimeError("could not locate repository root from collision_probe.py")
+
+
+ROOT = _repo_root()
+RUNTIME = ROOT / "shared" / "runtime"
+if str(RUNTIME) not in sys.path:
+    sys.path.insert(0, str(RUNTIME))
+
+
+def _load_generator():
+    path = ROOT / "generators" / TASK_ID / "generator.py"
+    spec = importlib.util.spec_from_file_location(f"collision_probe_{TASK_ID}", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"could not load generator from {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_program() -> str:
+    path = ROOT / "shared" / "data" / "canonical" / "puzzles.jsonl"
+    programs = {
+        row["program_solution"]
+        for row in (json.loads(line) for line in path.read_text().splitlines())
+        if row.get("task_id") == TASK_ID
+    }
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one canonical program, found {len(programs)}")
+    return programs.pop()
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _collision_count(generator: Any, grid: list[list[int]]) -> int:
+    return len(generator.semantic_observables(grid)["occupied_reflection_destinations"])
+
+
+def audit(*, samples_per_band: int = 1000, protected_racket: bool = True) -> dict[str, Any]:
+    if samples_per_band < 1:
+        raise ValueError("samples_per_band must be at least 1")
+
+    generator = _load_generator()
+    collisions: list[dict[str, Any]] = []
+    self_check_failures: list[dict[str, Any]] = []
+    band_counts: dict[str, int] = {}
+
+    for band_index, band in enumerate(BANDS):
+        band_counts[band] = 0
+        for sample_index in range(samples_per_band):
+            seed = 1_000_000 * (band_index + 1) + sample_index
+            grid = generator.generate(seed, sample_index, difficulty=band)
+            band_counts[band] += 1
+            occupied = generator.semantic_observables(grid)["occupied_reflection_destinations"]
+            if occupied:
+                collisions.append({
+                    "difficulty": band,
+                    "seed": seed,
+                    "sample_index": sample_index,
+                    "occupied_reflection_destinations": occupied,
+                })
+            errors = generator.self_check(grid, difficulty=band)
+            if errors:
+                self_check_failures.append({
+                    "difficulty": band,
+                    "seed": seed,
+                    "sample_index": sample_index,
+                    "errors": errors,
+                })
+
+    known_witnesses = []
+    for seed, sample_index, difficulty in KNOWN_WITNESSES:
+        grid = generator.generate(seed, sample_index, difficulty=difficulty)
+        known_witnesses.append({
+            "seed": seed,
+            "sample_index": sample_index,
+            "difficulty": difficulty,
+            "collision_count": _collision_count(generator, grid),
+        })
+
+    racket_checks: list[dict[str, Any]] = []
+    if protected_racket:
+        from arc_repl.racket_bridge import RacketBridge
+        from puzzle_generators.rule_wrap import wrap_rule
+
+        bridge = RacketBridge()
+        try:
+            wrapped = wrap_rule(_canonical_program())
+            for band_index, band in enumerate(BANDS):
+                seed = 9_000_000 + band_index
+                sample_index = samples_per_band + band_index
+                grid = generator.generate(seed, sample_index, difficulty=band)
+                python_output = generator.rule_mirror(grid)
+                racket_output = bridge.eval_text(f"({wrapped} {_literal(grid)})")
+                racket_checks.append({
+                    "difficulty": band,
+                    "seed": seed,
+                    "sample_index": sample_index,
+                    "matched": python_output == racket_output,
+                })
+        finally:
+            bridge.close()
+
+    generator_path = ROOT / "generators" / TASK_ID / "generator.py"
+    report = {
+        "schema_version": 1,
+        "task_id": TASK_ID,
+        "generator_version": generator.VERSION,
+        "generator_sha256": hashlib.sha256(generator_path.read_bytes()).hexdigest(),
+        "samples_per_band": samples_per_band,
+        "generated_cases": sum(band_counts.values()),
+        "band_counts": band_counts,
+        "collision_count": len(collisions),
+        "collisions": collisions,
+        "self_check_failure_count": len(self_check_failures),
+        "self_check_failures": self_check_failures,
+        "known_witnesses": known_witnesses,
+        "protected_racket_enabled": protected_racket,
+        "protected_racket_checks": racket_checks,
+    }
+    racket_clear = all(check["matched"] for check in racket_checks)
+    witnesses_clear = all(item["collision_count"] == 0 for item in known_witnesses)
+    report["status"] = (
+        "clear"
+        if not collisions and not self_check_failures and racket_clear and witnesses_clear
+        else "findings"
+    )
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--samples-per-band", type=int, default=1000)
+    parser.add_argument("--no-racket", action="store_true", help="skip protected-Racket parity checks")
+    parser.add_argument("--output", type=Path, help="write JSON report to this path")
+    args = parser.parse_args()
+
+    report = audit(
+        samples_per_band=args.samples_per_band,
+        protected_racket=not args.no_racket,
+    )
+    text = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(text)
+    print(text, end="")
+    return 0 if report["status"] == "clear" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
