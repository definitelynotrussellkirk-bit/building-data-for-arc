(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g))
                (objs (objects g 7))
                (colors (unique (map obj-color objs)))
                (singletons
                 (filter (lambda (color)
                           (= (length (filter (lambda (o) (= (obj-color o) color)) objs)) 1))
                         colors))
                (cue-color (if (empty? singletons) 0 (first singletons)))
                (stage-a
                 (reduce (lambda (acc color)
                           (let* ((co (filter (lambda (o) (= (obj-color o) color)) objs)))
                             (if (!= (length co) 2)
                                 acc
                                 (let* ((c1 (obj-cells (first co)))
                                        (c2 (obj-cells (second co)))
                                        (r1a (min-of fst c1))
                                        (r1b (max-of fst c1))
                                        (c1a (min-of snd c1))
                                        (c1b (max-of snd c1))
                                        (r2a (min-of fst c2))
                                        (r2b (max-of fst c2))
                                        (c2a (min-of snd c2))
                                        (c2b (max-of snd c2))
                                        (dr (if (> (+ r2a r2b) (+ r1a r1b)) 1 -1))
                                        (dc (if (> (+ c2a c2b) (+ c1a c1b)) 1 -1))
                                        (sr (if (> dr 0) r1b r1a))
                                        (sc (if (> dc 0) c1b c1a))
                                        (er (if (> dr 0) r2a r2b)))
                                   (let loop
                                     ((r (+ sr dr)) (c (+ sc dc)) (grid acc))
                                     (if (= r er)
                                         grid
                                         (loop (+ r dr) (+ c dc)
                                               (set-cell grid r c color))))))))
                         g
                         colors)))
           (cellmap stage-a
             (r c v)
             (if (and (> r 0)
                      (< r (- h 1))
                      (> c 0)
                      (< c (- w 1))
                      (!= (at stage-a (- r 1) (- c 1)) 7)
                      (!= (at stage-a (- r 1) (+ c 1)) 7)
                      (= (at stage-a (- r 1) (- c 1))
                         (at stage-a (+ r 1) (+ c 1)))
                      (= (at stage-a (- r 1) (+ c 1))
                         (at stage-a (+ r 1) (- c 1)))
                      (!= (at stage-a (- r 1) (- c 1))
                          (at stage-a (- r 1) (+ c 1))))
                 cue-color
                 v)))))
