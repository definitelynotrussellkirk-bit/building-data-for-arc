+"""One bounded protected-Racket probe of candidate-first versus transform-first.
+
+From the packet root:
+  WORK/.venv/bin/python review.py run python3 \
+    generators/312fb4bdff00/workspace/transform_priority_probe.py \
+    --seed 2 --query-index 1 --out ../checks/312fb4bdff00/transform-priority.json
+
+This authoring probe executes one six-pair default lesson and all three canonical
+pairs. It does not repair the generator, establish frequency, or grant approval.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _grid, _real_evaluator
+from reviewer_support import canonical_path, find_root
+
+TASK_ID = '312fb4bdff00'
+HOME = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def load_oracle():
+    spec = importlib.util.spec_from_file_location('_312f_priority_oracle', HOME / 'review_probe.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def rival_program(canonical):
+    """Change only the final search nesting, preserving all source helpers."""
+    marker = '(let outer ((xs cands))'
+    if canonical.count(marker) != 1:
+        raise ValueError('Canonical search form changed; review the rival before using it')
+    start = canonical.index(marker)
+    depth = 0
+    for end in range(start, len(canonical)):
+        depth += (canonical[end] == '(') - (canonical[end] == ')')
+        if depth == 0:
+            break
+    else:
+        raise ValueError('Unbalanced canonical search expression')
+    replacement = '''(let outer ((ts transform-names))
+  (if (empty? ts) (list (list 0))
+    (let ((hit (filter (lambda (candidate)
+                        (equal? (transform-support-name (first ts) candidate) q-support)) cands)))
+      (if (empty? hit) (outer (rest ts))
+        (recolor-grid (apply-transform-name (first ts) (first hit)) target)))))'''
+    return canonical[:start] + replacement + canonical[end + 1:]
+
+
+def python_rival(grid, oracle):
+    panels = oracle.panels(grid)
+    query = oracle.support(panels[0])
+    target = next(value for value in grid[0] if value)
+    for transform in range(8):
+        for candidate in panels[1:]:
+            transformed = oracle.transforms(candidate)[transform]
+            if oracle.support(transformed) == query:
+                return [[target if value else 0 for value in row] for row in transformed]
+    return [[0]]
+
+
+def probe(seed, query_index):
+    oracle = load_oracle()
+    generator = oracle.load_generator()
+    canonical_rules = {record['program_solution'] for line in canonical_path(ROOT).open()
+                       if (record := json.loads(line)).get('task_id') == TASK_ID}
+    if len(canonical_rules) != 1:
+        raise ValueError('Expected exactly one canonical program')
+    canonical = canonical_rules.pop()
+    rival = rival_program(canonical)
+    paths = [Path(generator.__file__), HOME / 'review_probe.py', Path(__file__)]
+    report = {
+        'schema': '312f-transform-priority-peer-probe-v1',
+        'task_id': TASK_ID,
+        'generator_version': generator.VERSION,
+        'rule_hash': generator.RULE_HASH,
+        'sources': [{'path': str(path.relative_to(ROOT)), 'sha256': digest(path.read_bytes())}
+                    for path in paths],
+        'canonical_program': canonical,
+        'canonical_program_sha256': digest(canonical.encode()),
+        'rival_program': rival,
+        'rival_program_sha256': digest(rival.encode()),
+        'rival_meaning': 'For each transform in canonical D4 order, try candidates left to right; return the first match. The authority instead chooses the first candidate before choosing its first successful transform.',
+        'seed': seed, 'difficulty': 'easy', 'start_index': 0, 'query_index': query_index,
+        'canonical_pairs': [], 'lesson_pairs': [],
+        'limits': ['One default six-pair lesson and the three canonical pairs only.',
+                   'No frequency estimate, universal uniqueness claim, generator repair, approval, or training admission.',
+                   'Existing declared competitors are Python predictions compared with protected Racket labels.'],
+    }
+    execute, identity, bridge = _real_evaluator(ROOT / 'shared/runtime')
+    report['racket'] = identity
+    if identity.get('backend') != 'racket' or identity.get('protected') is not True:
+        bridge.close()
+        raise ValueError('A live protected Racket evaluator is required')
+    try:
+        for index, pair in enumerate(oracle.canonical_pairs()):
+            actual = _grid(execute(canonical, pair['input']))
+            wrong = _grid(execute(rival, pair['input']))
+            if actual != pair['output'] or wrong != python_rival(pair['input'], oracle):
+                raise ValueError('Canonical label or independent rival semantics disagree')
+            report['canonical_pairs'].append({'index': index, 'input': pair['input'],
+                'output': actual, 'rival_output': wrong, 'rival_fits': wrong == actual})
+        for index in range(6):
+            grid = generator.generate(seed, index, difficulty='easy')
+            failures = generator.self_check(grid)
+            if failures:
+                raise ValueError(f'Generated input failed self_check: {failures}')
+            actual = _grid(execute(canonical, grid))
+            wrong = _grid(execute(rival, grid))
+            if actual != oracle.oracle(grid) or wrong != python_rival(grid, oracle):
+                raise ValueError('Protected Racket and independent whole-grid semantics disagree')
+            report['lesson_pairs'].append({'sample_index': index,
+                'role': 'query' if index == query_index else 'demo',
+                'input': grid, 'output': actual, 'rival_output': wrong,
+                'rival_fits': wrong == actual, 'self_check': failures,
+                'matching_candidate_first_transform': [[hit[0], hit[1]] for hit in oracle.matches(grid)]})
+    finally:
+        bridge.close()
+    demos = [pair for pair in report['lesson_pairs'] if pair['role'] == 'demo']
+    query = report['lesson_pairs'][query_index]
+    report['canonical_fits'] = all(pair['rival_fits'] for pair in report['canonical_pairs'])
+    report['fits_all_demonstrations'] = all(pair['rival_fits'] for pair in demos)
+    report['changes_query'] = not query['rival_fits']
+    report['declared_python_rival_survivors'] = [
+        name for name, predict in generator.LESSON_COMPETITORS.items()
+        if all(predict(pair['input']) == pair['output'] for pair in demos)]
+    report['status'] = ('reproduced_teaching_defect' if report['canonical_fits']
+                        and report['fits_all_demonstrations'] and report['changes_query']
+                        else 'no_finding_in_selected_lesson')
+    report['protected_racket_evaluations'] = 2 * (len(report['canonical_pairs']) + 6)
+    report['training_admitted'] = False
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--seed', type=int, default=2)
+    parser.add_argument('--query-index', type=int, choices=range(6), default=1)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    result = probe(args.seed, args.query_index)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, sort_keys=True, indent=2) + '\n')
+    print(json.dumps({key: result[key] for key in ('status', 'seed', 'query_index',
+        'canonical_fits', 'fits_all_demonstrations', 'changes_query',
+        'declared_python_rival_survivors', 'protected_racket_evaluations')}, indent=2))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
