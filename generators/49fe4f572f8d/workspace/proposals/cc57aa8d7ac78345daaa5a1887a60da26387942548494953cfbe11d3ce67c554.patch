+"""Replay one known row-compaction teaching gap with live protected Racket.
+
+This is a bounded reproduction, not a search, repair, approval or frequency study.
+Run from the packet root with review.py run; select a fresh --out directory.
+"""
+from __future__ import annotations
+
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles.parametric_worker import _grid, _real_evaluator
+from reviewer_support import (canonical_path, find_root, load_selected_generator,
+                              public_challenge_bytes, public_challenge_id)
+
+TASK_ID = '23c3ab5fa55f'
+ROOT = find_root(__file__)
+KNOWN_SOURCE = '1cce6cc32439d1eefebb7d8faa9a128b6788b39a8c31e933e8d72fe954702800'
+RIVAL = '''(rule! (lambda (g)
+  (map (lambda (row)
+    (let ((values (remove-duplicates (filter (lambda (v) (not (= v 0))) row))))
+      (append values (make-list (- (cols g) (length values)) 0)))) g)))'''
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def compact(grid, *, deduplicate=False):
+    result = []
+    for row in grid:
+        values = [value for value in row if value]
+        if deduplicate:
+            values = list(dict.fromkeys(values))
+        result.append(values + [0] * (len(row) - len(values)))
+    return result
+
+
+def differences(correct, rival):
+    return [{'row': r, 'column': c, 'correct': correct[r][c], 'rival': rival[r][c]}
+            for r in range(len(correct)) for c in range(len(correct[0]))
+            if correct[r][c] != rival[r][c]]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    module, source, sha = load_selected_generator(TASK_ID, root=ROOT)
+    canonical = [row for line in canonical_path(ROOT).open()
+                 if (row := json.loads(line)).get('task_id') == TASK_ID]
+    programs = {row['program_solution'] for row in canonical}
+    if len(programs) != 1:
+        raise ValueError('Expected one exact canonical authority')
+    program = programs.pop()
+    canonical_pairs = [pair for row in canonical for split in ('train', 'test')
+                       for pair in row[split] if 'output' in pair]
+    inputs = [module.generate(26, index, difficulty='easy') for index in range(5)]
+    checks = [module.self_check(grid, difficulty='easy') for grid in inputs]
+    if any(checks):
+        raise ValueError(f'Generated input failed the current domain check: {checks!r}')
+    apply, identity, bridge = _real_evaluator(ROOT / 'shared/runtime')
+    if identity.get('backend') != 'racket' or identity.get('protected') is not True:
+        bridge.close()
+        raise ValueError('A live protected Racket runtime is required')
+    executions = 0
+    def execute_pair(grid):
+        nonlocal executions
+        _grid(grid)
+        correct, rival = _grid(apply(program, grid)), _grid(apply(RIVAL, grid))
+        executions += 2
+        if correct != compact(grid) or rival != compact(grid, deduplicate=True):
+            raise ValueError('Executed programs disagree with the declared meanings')
+        return {'input': grid, 'output': correct, 'rival_output': rival,
+                'rival_matches': correct == rival, 'differences': differences(correct, rival)}
+    try:
+        canonical_results = []
+        for pair in canonical_pairs:
+            result = execute_pair(pair['input'])
+            if result['output'] != pair['output']:
+                raise ValueError('Current Racket authority disagrees with a canonical label')
+            canonical_results.append({'input_sha256': digest(json.dumps(pair['input']).encode()),
+                                      'rival_matches': result['rival_matches']})
+        lesson = [execute_pair(grid) for grid in inputs]
+        minimal = execute_pair([[4, 0, 4]])
+    finally:
+        bridge.close()
+    if digest(source.read_bytes()) != sha:
+        raise ValueError('Audited source changed during execution')
+    reproduced = (all(row['rival_matches'] for row in canonical_results)
+                  and all(row['rival_matches'] for row in lesson[:4])
+                  and not lesson[4]['rival_matches'])
+    episode = {'train': [{'input': row['input'], 'output': row['output']} for row in lesson[:4]],
+               'test': [{'input': lesson[4]['input'], 'output': lesson[4]['output']}]}
+    key = public_challenge_id(episode)
+    report = {
+        'schema': '23c3-multiplicity-replay-v1', 'task_id': TASK_ID,
+        'created_utc': datetime.now(timezone.utc).isoformat(),
+        'status': 'confirmed_existing_issue' if reproduced else 'known_case_not_reproduced',
+        'command': [sys.executable, *sys.argv], 'cwd': str(Path.cwd()),
+        'source': {'path': str(source.relative_to(ROOT)), 'sha256': sha,
+                   'matches_existing_audit_source': sha == KNOWN_SOURCE,
+                   'probe_sha256': digest(Path(__file__).read_bytes())},
+        'authority': {'rule_hash': module.RULE_HASH, 'program': program,
+                      'program_sha256': digest(program.encode())},
+        'rival': {'description': 'Keep only the first occurrence of each nonzero color in each row, preserving encounter order, then pack left.',
+                  'program': RIVAL, 'program_sha256': digest(RIVAL.encode())},
+        'racket': identity, 'protected_racket_evaluations': executions,
+        'canonical_results': canonical_results,
+        'sampling': {'seed': 26, 'difficulty': 'easy', 'sample_indices': list(range(5)),
+                     'overrides': {}, 'source': 'selected generator.generate, direct bounded calls'},
+        'generated_inputs_self_check': checks,
+        'train': lesson[:4], 'test': lesson[4:], 'minimal_semantic_distinction': minimal,
+        'minimal_fixture_in_generator_domain': False,
+        'public_challenge': f'public/{key}.json',
+        'finding': {'demo_matches': [row['rival_matches'] for row in lesson[:4]],
+                    'query_matches': lesson[4]['rival_matches'],
+                    'query_difference_cells': len(lesson[4]['differences']),
+                    'query_difference_rows': sorted({row['row'] for row in lesson[4]['differences']})},
+        'limits': ['Exactly one known five-draw sequence; no sweep or frequency estimate.',
+                   'Direct selected-generator replay; no fresh public lesson CLI materialization.',
+                   'Existing unresolved issue confirmed; source and audit statuses not changed.',
+                   'Minimal 1x3 fixture is outside the calibrated domain; the full generated query is inside.',
+                   'No owner acceptance, training admission, override probe or full battery.'],
+    }
+    (args.out / 'public').mkdir(parents=True)
+    (args.out / 'public' / f'{key}.json').write_bytes(public_challenge_bytes(episode))
+    (args.out / 'replay.json').write_text(json.dumps(report, indent=2, sort_keys=True) + '\n')
+    print(json.dumps({'status': report['status'], 'report': str(args.out / 'replay.json'),
+                      'source_sha256': sha, 'racket_evaluations': executions,
+                      'canonical_matches': len(canonical_results), **report['finding']}, indent=2))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
