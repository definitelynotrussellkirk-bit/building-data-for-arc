+    changed = deepcopy(first)
+    changed["metadata"]["input_seed"] = 999
+    changed["metadata"]["parameters"] = {"coarse_placement": "arbitrary private annotation"}
+    for pair in changed["test"]:
+        pair["output"] = [[9]]
