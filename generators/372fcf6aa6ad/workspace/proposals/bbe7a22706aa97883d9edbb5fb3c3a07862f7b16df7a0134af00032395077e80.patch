new file mode 100644
--- /dev/null
+++ b/repo/generators/5dc10de63325/workspace/parametric/adapter.py
@@ -0,0 +1,30 @@
+"""Native promotion adapter for the bucket-color relay family."""
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+
+_spec = spec_from_file_location("_family_5dc10de63325", Path(__file__).with_name("family.py"))
+_family = module_from_spec(_spec)
+assert _spec.loader is not None
+_spec.loader.exec_module(_family)
+
+
+def _mode(settings):
+    if type(settings) is not dict or set(settings) != {"mode"}:
+        raise ValueError("settings must contain exactly mode")
+    return _family._mode(settings["mode"])
+
+
+def program(settings):
+    return _family.program_for(_mode(settings))
+
+
+def generate(seed, settings, demos, queries):
+    return _family.build_episode(seed, _mode(settings), demos, queries)
+
+
+transform = _family.transform
+certificate = _family.certificate
+explain_dependency = _family.explain_dependency
+counterfactual_program = _family.counterfactual_program
+HYPOTHESES = _family.HYPOTHESES
+MODES = _family.MODES
diff --git a/repo/generators/5dc10de63325/workspace/parametric/bucket_color_relay.rkt b/repo/generators/5dc10de63325/workspace/parametric/bucket_color_relay.rkt
new file mode 100644
--- /dev/null
+++ b/repo/generators/5dc10de63325/workspace/parametric/bucket_color_relay.rkt
@@ -0,0 +1,33 @@
+(rule! (lambda (g)
+         (let* ((count (length (find-color g 8)))
+                (per-quad (quotient count 4))
+                (markers
+                 (sort
+                  (filter (lambda (p)
+                            (let ((v (at g (first p) (second p))))
+                              (and (not (= v 0)) (not (= v 8)))))
+                          (grid-positions g))
+                  (lambda (a b)
+                    (or (< (first a) (first b))
+                        (and (= (first a) (first b))
+                             (< (second a) (second b)))))))
+                (selected (list-ref markers (- per-quad 1)))
+                (selected-color (at g (first selected) (second selected)))
+                (tile (cond
+                        ((= per-quad 4) (list (list 8 8) (list 8 8)))
+                        ((= per-quad 3) (list (list 0 8) (list 8 8)))
+                        ((= per-quad 2) (list (list 0 0) (list 8 8)))
+                        ((= per-quad 1) (list (list 0 0) (list 0 8)))
+                        (else (list (list 0 0) (list 0 0)))))
+                (base
+                 (build-grid 5
+                             5
+                             (r c)
+                             (cond
+                               ((= r 2) 0)
+                               ((= c 2) 0)
+                               (else
+                                (let ((tr (remainder (if (> r 2) (- r 3) r) 2))
+                                      (tc (remainder (if (> c 2) (- c 3) c) 2)))
+                                  (list-ref (list-ref tile tr) tc)))))))
+           (set-cell base 2 2 selected-color))))
