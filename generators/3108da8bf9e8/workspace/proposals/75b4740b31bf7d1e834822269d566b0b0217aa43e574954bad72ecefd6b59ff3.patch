+"""Regression for a source-bound prototype teaching counterexample."""
+from collections import Counter
+import importlib.util
+from pathlib import Path
+
+HOME = Path(__file__).resolve().parents[1]
+S = importlib.util.spec_from_file_location("occurrence_position_probe", HOME / "workspace/occurrence_position_probe.py")
+P = importlib.util.module_from_spec(S)
+S.loader.exec_module(P)
+
+
+def test_counterlayout_preserves_exact_component_multiset_and_multiplicities():
+    source = P.prototype.input_for(20261024, 3)
+    query = P.counterlayout(source)
+    a = Counter(P.prototype._component_crops(source))
+    b = Counter(P.prototype._component_crops(query))
+    assert a == b
+    assert sorted(b.values()) == [1, 1, 2, 3]
+    assert source != query
+    assert len(query) == 25 and len(query[0]) == 22
+    crops = P.prototype._component_crops(query)
+    assert max(i for i, crop in enumerate(crops) if b[crop] == 3) < min(i for i, crop in enumerate(crops) if b[crop] == 2)
+
+
+def test_position_rivals_fit_visible_demos_but_fail_novel_layout():
+    for threshold in (2, 3):
+        episode = P.prototype.build_episode(20261024, minimum_occurrences=threshold, n_train=3, n_test=4)
+        for pair in episode["train"] + episode["test"]:
+            assert P.position_prediction(pair["input"], threshold) == pair["output"]
+        query = P.counterlayout(episode["test"][0]["input"])
+        assert P.position_prediction(query, threshold) != P.prototype.apply_python(query, threshold)
+
+
+def test_rivals_keep_canonical_extractor_but_remove_counting():
+    from puzzle_generators.rule_wrap import wrap_rule
+    for threshold in (2, 3):
+        source = P.rival_program(threshold)
+        assert "count-if" not in source
+        assert "(let bfs" in source
+        assert wrap_rule(source)
