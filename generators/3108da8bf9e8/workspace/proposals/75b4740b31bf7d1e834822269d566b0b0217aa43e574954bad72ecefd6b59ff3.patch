+#!/usr/bin/env python3
+"""Bounded executable witness for fixed-position leakage in the retained prototype.
+
+This reviews workspace/parametric/prototype.py only. It does not alter the
+production generator, canonical rule, approval, or prototype acceptance state.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+
+HERE = Path(__file__).resolve()
+TASK_HOME = HERE.parents[1]
+ROOT = TASK_HOME.parents[1]
+_path = HERE.parent / "parametric/prototype.py"
+_spec = importlib.util.spec_from_file_location("occurrence_threshold_peer", _path)
+prototype = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(prototype)
+
+
+def _hash(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def position_prediction(grid, threshold):
+    crops = prototype._component_crops(grid)
+    if threshold not in (2, 3):
+        raise ValueError("threshold must be 2 or 3")
+    crop = crops[-1] if threshold == 2 else crops[0]
+    return [list(row) for row in crop]
+
+
+def rival_program(threshold):
+    """Preserve the exact four-neighbor extractor, replace count/selection only."""
+    canonical = prototype.program_for(2)
+    marker = "             (let ((n (length obj-grids)))"
+    if canonical.count(marker) != 1 or threshold not in (2, 3):
+        raise ValueError("canonical extraction boundary or threshold changed")
+    prefix = canonical.split(marker, 1)[0]
+    # obj-grids is consed during row-major traversal, hence reversed.
+    selector = "(first obj-grids)" if threshold == 2 else "(last obj-grids)"
+    return prefix + selector + ")" * (prefix.count("(") - prefix.count(")"))
+
+
+def counterlayout(grid):
+    """Move the two unique crops to the extremes; keep exact crop multiplicities."""
+    counts = Counter(prototype._component_crops(grid))
+    if sorted(counts.values()) != [1, 1, 2, 3]:
+        raise ValueError("expected exactly one pair, one triple, two unique crops")
+    pair = next(crop for crop, n in counts.items() if n == 2)
+    triple = next(crop for crop, n in counts.items() if n == 3)
+    unique = [crop for crop, n in counts.items() if n == 1]
+    # Retain the README's pair-after-triple discovery order. Only the unique
+    # distractors move outside the constructor's fixed middle-row placement.
+    ordered = [unique[0], triple, triple, triple, pair, pair, unique[1]]
+    positions = ((1, 1), (5, 9), (9, 16), (13, 2), (13, 14), (18, 4), (22, 13))
+    output = [[0] * 22 for _ in range(25)]
+    for crop, (top, left) in zip(ordered, positions):
+        for dr, row in enumerate(crop):
+            for dc, value in enumerate(row):
+                output[top + dr][left + dc] = value
+    if Counter(prototype._component_crops(output)) != counts:
+        raise AssertionError("counterlayout changed component multiplicities")
+    return output
+
+
+def run(seed):
+    from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+    source_paths = [TASK_HOME / "generator.py", _path, HERE]
+    source_hashes = {str(path.relative_to(ROOT)): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_paths}
+    canonical = prototype.program_for(2)
+    cases, execution = [], []
+    runtime = ROOT / "shared/runtime"
+    with _local_imports(runtime, _path.parent):
+        apply, identity, bridge = _real_evaluator(runtime)
+        def checked(program, grid, expected, purpose):
+            actual = apply(program, grid)
+            if actual != expected:
+                raise AssertionError(f"protected Racket/Python mismatch: {purpose}")
+            execution.append({"purpose": purpose, "program_sha256": hashlib.sha256(program.encode()).hexdigest(), "input_sha256": _hash(grid), "output_sha256": _hash(actual)})
+            return actual
+        try:
+            for threshold in (2, 3):
+                episode = prototype.build_episode(seed, minimum_occurrences=threshold, n_train=3, n_test=4)
+                program, rival = episode["program"], rival_program(threshold)
+                # Fit every visible demo before examining either query.
+                demo_fits = []
+                for index, pair in enumerate(episode["train"]):
+                    gold = checked(program, pair["input"], pair["output"], f"t{threshold}/demo{index}/gold")
+                    prediction = checked(rival, pair["input"], position_prediction(pair["input"], threshold), f"t{threshold}/demo{index}/rival")
+                    demo_fits.append(gold == prediction)
+                if not all(demo_fits):
+                    raise AssertionError("position rival did not fit visible demonstrations")
+                emitted_fits = []
+                for index, emitted in enumerate(episode["test"]):
+                    emitted_gold = checked(program, emitted["input"], emitted["output"], f"t{threshold}/emitted_query{index}/gold")
+                    emitted_rival = checked(rival, emitted["input"], position_prediction(emitted["input"], threshold), f"t{threshold}/emitted_query{index}/rival")
+                    emitted_fits.append(emitted_gold == emitted_rival)
+                emitted = episode["test"][0]
+                query = counterlayout(emitted["input"])
+                query_gold = checked(program, query, prototype.apply_python(query, threshold), f"t{threshold}/novel_query/gold")
+                query_rival = checked(rival, query, position_prediction(query, threshold), f"t{threshold}/novel_query/rival")
+                repair = counterlayout(prototype.input_for(seed, 7))
+                repair_gold = checked(program, repair, prototype.apply_python(repair, threshold), f"t{threshold}/replacement_demo/gold")
+                repair_rival = checked(rival, repair, position_prediction(repair, threshold), f"t{threshold}/replacement_demo/rival")
+                assert query_gold != query_rival and repair_gold != repair_rival
+                assert all(query != p["input"] for p in episode["train"])
+                assert repair != query and all(repair != p["input"] for p in episode["train"])
+                cases.append({"minimum_occurrences": threshold,
+                    "rival": "last row-major component" if threshold == 2 else "first row-major component",
+                    "program": program, "rival_program": rival,
+                    "visible_demo_fits": demo_fits,
+                    "emitted_queries_also_fit": emitted_fits,
+                    "train": episode["train"],
+                    "emitted_queries": episode["test"],
+                    "novel_query": {"input": query, "gold": query_gold, "rival": query_rival, "origin": "Relocate exact crops from input_for(seed,3): unique distractors first and last, all triple copies before both pair copies. Outside the fixed-position sampler; preserves documented multiplicity and pair-after-triple semantics."},
+                    "replacement_demo": {"input": repair, "gold": repair_gold, "rival": repair_rival, "origin": "Same relocation applied to independent input_for(seed,7); proposed teaching example, not current sampler output."},
+                    "same_crop_multiset_as_emitted_query": True,
+                    "component_multiplicities": [1, 1, 2, 3]})
+        finally:
+            bridge.close()
+    fit_count = 0
+    for bounded_seed in range(24):
+        for threshold in (2, 3):
+            episode = prototype.build_episode(bounded_seed, minimum_occurrences=threshold, n_train=3, n_test=4)
+            for pair in episode["train"] + episode["test"]:
+                assert position_prediction(pair["input"], threshold) == pair["output"]
+                fit_count += 1
+    return {"schema": "occurrence-position-leak-review-v1", "status": "finding_confirmed",
+        "task_id": prototype.TASK_ID, "seed": seed, "source_sha256": source_hashes,
+        "canonical_rule_hash": "4fc872f50360", "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "runtime_identity": identity, "protected_racket_calls": len(execution),
+        "python_only_additional_fits": {"seeds": list(range(24)), "pair_predictions": fit_count},
+        "cases": cases, "execution": execution,
+        "finding": "Retained threshold prototype teaches fixed first/last object selection. Both executable rivals fit all visible demos, also fit the emitted query, and disagree on novel layouts with unchanged exact component multiplicities.",
+        "recommended_repair": "Vary component role positions and include at least one distinguishing demonstration with unique crops at both scan-order extremes; test first/last selectors in demo-only teaching checks before native qualification.",
+        "scope": "Prototype support/teaching gap only. All four normal queries also fit the position rival; no emitted-query disagreement is claimed. The novel counterlayout preserves the documented seven-component multiset and pair-after-triple ordering, but moves unique distractors outside the constructor's fixed middle positions. This is a proposed semantic generalization, not conflicting labels within emitted support, and does not reopen the separate canonical production repair.",
+        "production_changed": False, "acceptance_claimed": False, "training_admitted": False}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed", type=int, default=20261024)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.out.exists():
+        raise SystemExit("refusing to overwrite existing evidence")
+    report = run(args.seed)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"status": report["status"], "protected_racket_calls": report["protected_racket_calls"], "settings_with_surviving_position_rival": len(report["cases"]), "out": str(args.out)}))
+
+
+if __name__ == "__main__":
+    main()
