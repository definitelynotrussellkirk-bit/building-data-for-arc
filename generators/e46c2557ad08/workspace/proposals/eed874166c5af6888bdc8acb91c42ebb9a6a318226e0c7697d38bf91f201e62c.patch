+#!/usr/bin/env python3
+"""Bounded source-bound audit of a missing emitter-direction teaching case.
+
+From the packet root:
+  WORK/.venv/bin/python review.py run --receipt checks/e410357cf67e/direction-command.json python3 generators/e410357cf67e/workspace/direction_launch_audit.py
+
+Six generated inputs, one original lesson with five rotations, and one bounded
+four-demonstration teaching proposal. Reference labels come from the canonical
+program executed by the protected Racket bridge. Production is never modified.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK = "e410357cf67e"
+EXPECTED_SOURCE = "b84e46e019265b259448dd0004d140a77ce7734166223b403e62dea818392a10"
+EXPECTED_RULE = "ca02c94ead8c"
+
+
+def launch_downward(grid):
+    """Plausible rival: every emitter shoots down, then obeys mirror physics."""
+    out = [row[:] for row in grid]
+    h, w = len(grid), len(grid[0])
+    r, c = next((r, c) for r in range(h) for c in range(w) if grid[r][c] == 2)
+    dr, dc = 1, 0
+    for _ in range(4 * h * w):
+        r, c = r + dr, c + dc
+        if not (0 <= r < h and 0 <= c < w):
+            break
+        cell = grid[r][c]
+        if cell == 8:
+            break
+        if cell == 4:
+            dr, dc = -dc, -dr
+        elif cell == 5:
+            dr, dc = dc, dr
+        elif cell == 0:
+            out[r][c] = 7
+    return out
+
+
+def main():
+    root = find_root(__file__)
+    gen, source_path, source_sha = load_selected_generator(TASK, root=root)
+    assert source_sha == EXPECTED_SOURCE, "source changed; reassess rather than reuse finding"
+    ledger = canonical_path(root)
+    records = [json.loads(line) for line in ledger.read_text().splitlines()
+               if json.loads(line).get("task_id") == TASK]
+    programs = {record["program_solution"] for record in records}
+    assert len(programs) == 1
+    program = programs.pop()
+    rule_hash = hashlib.sha256(" ".join(program.split()).encode()).hexdigest()[:12]
+    assert rule_hash == EXPECTED_RULE
+    seed, start, difficulty = 0, 0, "medium"
+    pairs, cases = [], []
+    bridge = RacketBridge()
+    try:
+        runtime = bridge.runtime_identity
+        assert runtime["protected"], "protected Racket is required"
+        bridge.eval_text(f"(define audited_rule {wrap_rule(program)})")
+        for index in range(start, start + 5):
+            grid = gen.generate(seed, index, difficulty=difficulty)
+            bridge.define_grid("audit_grid", grid)
+            truth = bridge.eval_text("(audited_rule audit_grid)")
+            rival = launch_downward(grid)
+            pair = {"input": grid, "output": truth}
+            pairs.append(pair)
+            cases.append({
+                "sample_index": index, "axes": gen.observe_overrides(grid),
+                "source": gen._analysis(grid)["source"],
+                "input": grid, "racket_output": truth, "rival_output": rival,
+                "rival_matches": rival == truth,
+                "python_mirror_matches_racket": gen.rule_mirror(grid) == truth,
+                "self_check": gen.self_check(grid),
+            })
+        # Predeclared teaching choice: a fresh side-launch case, not the failed
+        # query or its label recycled as a demonstration. No seed sweep.
+        fresh_input = gen.generate(1, 4, difficulty=difficulty)
+        assert all(fresh_input != pair["input"] for pair in pairs)
+        bridge.define_grid("audit_grid", fresh_input)
+        fresh_output = bridge.eval_text("(audited_rule audit_grid)")
+        fresh_pair = {"input": fresh_input, "output": fresh_output}
+        assert gen.self_check(fresh_input) == []
+        assert gen.rule_mirror(fresh_input) == fresh_output
+        assert launch_downward(fresh_input) != fresh_output
+    finally:
+        bridge.close()
+    rotations = []
+    for qi, query in enumerate(pairs):
+        demos = [pair for i, pair in enumerate(pairs) if i != qi]
+        rotations.append({
+            "query_index": qi,
+            "declared_checker_findings": gen.lesson_identifiable(demos, query),
+            "downward_rival_fits_demos": all(launch_downward(p["input"]) == p["output"] for p in demos),
+            "downward_rival_differs_query": launch_downward(query["input"]) != query["output"],
+        })
+    assert all(case["python_mirror_matches_racket"] and not case["self_check"] for case in cases)
+    assert [case["rival_matches"] for case in cases] == [True, True, True, True, False]
+    assert rotations[4]["declared_checker_findings"] == []
+    # Replace the first top-edge demo, keeping four demos and the unchanged
+    # original side-edge query. This checks one teaching selection, not a new
+    # production schedule or its other query rotations.
+    proposed_demos = [fresh_pair, *pairs[1:4]]
+    proposed_query = pairs[4]
+    proposal_findings = gen.lesson_identifiable(proposed_demos, proposed_query)
+    assert proposal_findings == []
+    proposal_rival_fits = all(launch_downward(p["input"]) == p["output"] for p in proposed_demos)
+    assert not proposal_rival_fits
+    teaching_proposal = {
+        "status": "tested_rival_rejected_from_demonstrations",
+        "selection": "Replace original demo index 0 with seed 1, sample index 4, difficulty medium.",
+        "fresh_example": {"seed": 1, "sample_index": 4, "difficulty": difficulty,
+                          "axes": gen.observe_overrides(fresh_input),
+                          "source": gen._analysis(fresh_input)["source"],
