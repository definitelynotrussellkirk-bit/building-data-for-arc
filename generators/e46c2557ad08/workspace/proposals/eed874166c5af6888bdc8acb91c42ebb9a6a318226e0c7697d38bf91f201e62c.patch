@@ -0,0 +1,118 @@
+"""Bounded canonical-domain audit; execute through the packet review.py run wrapper.
+
+This is an audit reproducer, not a replacement label authority. The rival is an
+explicitly wrong hypothesis; all authoritative outputs come from canonical Racket.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+
+from arcpuzzles import Catalog
+
+TASK = "de45fc71c193"
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def output_only_eight_rival(grid):
+    """Ignore 8 as an input color; otherwise intersect the two color boxes."""
+    colors = sorted({v for row in grid for v in row} - {0, 8})
+    out = [[0] * len(grid[0]) for _ in grid]
+    if len(colors) != 2:
+        return out
+    boxes = []
+    for color in colors:
+        cells = [(r, c) for r, row in enumerate(grid) for c, v in enumerate(row) if v == color]
+        boxes.append((min(r for r, c in cells), min(c for r, c in cells),
+                      max(r for r, c in cells), max(c for r, c in cells)))
+    for r in range(max(b[0] for b in boxes), min(b[2] for b in boxes) + 1):
+        for c in range(max(b[1] for b in boxes), min(b[3] for b in boxes) + 1):
+            out[r][c] = 8
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    source = ROOT / "generators" / TASK / "generator.py"
+    canonical_path = ROOT / "shared/data/canonical/puzzles.jsonl"
+    records = [json.loads(line) for line in canonical_path.read_text().splitlines()]
+    canonical = next(row for row in records if row["task_id"] == TASK)
+    spec = importlib.util.spec_from_file_location("audited_generator", source)
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    cases = [
+        {"name": f"canonical-train-{i}", "role": "demonstration", "input": p["input"],
+         "recorded_output": p["output"]}
+        for i, p in enumerate(canonical["train"])
+    ] + [
+        {"name": f"canonical-test-{i}", "role": "query", "input": p["input"],
+         "recorded_output": p["output"]}
+        for i, p in enumerate(canonical["test"])
+    ]
+    for i, difficulty in enumerate(("easy", "medium", "hard")):
+        cases.append({"name": f"generated-{difficulty}", "role": "generated-control",
+                      "seed": 17, "sample_index": i, "difficulty": difficulty,
+                      "input": generator.generate(17, i, difficulty=difficulty)})
+    (args.out / "inputs.json").write_text(json.dumps({"inputs": [c["input"] for c in cases]}, indent=2) + "\n")
+    public = {"train": canonical["train"], "test": [{"input": p["input"]} for p in canonical["test"]]}
+    (args.out / "public_challenge.json").write_text(json.dumps(public, indent=2) + "\n")
+    applied = Catalog(ROOT).apply(TASK, [c["input"] for c in cases],
+                                  reference="canonical", timeout=120,
+                                  check_generator_domain=True)
+    (args.out / "racket.json").write_text(json.dumps(applied, indent=2) + "\n")
+    for case, result in zip(cases, applied["results"], strict=True):
+        rival = output_only_eight_rival(case["input"])
+        case.update({"rival_output": rival,
+                     "rival_matches_racket": rival == result["output"],
+                     "generator_self_check": generator.self_check(case["input"]),
+                     "racket_valid_output": result["valid_output"],
+                     "racket_error": result["error"],
+                     "input_sha256": result["input_sha256"],
+                     "output_sha256": result["output_sha256"]})
+        if "recorded_output" in case:
+            case["recorded_output_matches_racket"] = case["recorded_output"] == result["output"]
+        if result["output"] is not None:
+            case["rival_mismatch_cells"] = sum(a != b for ra, rb in zip(rival, result["output"], strict=True)
+                                                for a, b in zip(ra, rb, strict=True))
+    report = {"schema": "de45-canonical-domain-audit-v1", "task_id": TASK,
+              "generator_sha256": sha(source), "tool_sha256": sha(Path(__file__)),
+              "canonical_file_sha256": sha(canonical_path),
+              "rule_text_sha256": hashlib.sha256(canonical["program_solution"].encode()).hexdigest(),
+              "executed_rule_hash": applied["executed_rule_hash"],
+              "rule_hash_matches_catalog": applied["rule_hash_matches_catalog"],
+              "racket_path": os.environ.get("RACKET_PATH"),
+              "command": [sys.executable, *sys.argv], "cwd": str(Path.cwd()),
+              "cases": cases,
+              "finding": "The rival ignoring input 8 fits both canonical demonstrations and all three generated controls, but fails the canonical query. The current validator rejects that valid query.",
+              "limits": ["Six inputs only; three production draws are controls, not a statistical sample.",
+                         "No production changes, no owner disposition, no native parametric work or battery.",
+                         "No claim of generated-episode ambiguity: this is a generator support gap at the canonical query."]}
+    checks = {
+        "all_reference_outputs_valid": all(c["racket_valid_output"] and c["racket_error"] is None for c in cases),
+        "canonical_labels_match_racket": all(c.get("recorded_output_matches_racket", True) for c in cases),
+        "rival_fits_demonstrations": all(c["rival_matches_racket"] for c in cases if c["role"] == "demonstration"),
+        "rival_fits_generated_controls": all(c["rival_matches_racket"] for c in cases if c["role"] == "generated-control"),
+        "rival_fails_query": any(not c["rival_matches_racket"] for c in cases if c["role"] == "query"),
+        "validator_rejects_valid_query": any(c["generator_self_check"] and c["racket_valid_output"] for c in cases if c["role"] == "query"),
+    }
+    report["checks"] = checks
+    report["reproduced"] = all(checks.values())
+    (args.out / "audit.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"output": str(args.out), "reproduced": report["reproduced"], "checks": checks}, indent=2))
+    return 0 if report["reproduced"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
