+    from reviewer_support import public_challenge_bytes
+
+    adapter = _load(ADAPTER_PATH, "nearest_vertical_adapter")
+    prototype = _load(PROTOTYPE_PATH, "nearest_vertical_prototype")
+    one_query = adapter.generate(23, {"target_scope": "nearest_vertical"}, 3, 1)
