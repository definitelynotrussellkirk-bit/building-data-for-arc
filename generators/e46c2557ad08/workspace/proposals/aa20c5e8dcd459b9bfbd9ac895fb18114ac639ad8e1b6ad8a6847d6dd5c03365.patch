+"""Build bounded author evidence and the source-bound causal witness."""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any, Callable
+
+
+TASK_ID = "e46c2557ad08"
+SETTING_NAME = "target_scope"
+SETTINGS = ("all_horizontal", "nearest_vertical")
+STEP_A = "Locate the unique vertical gray domino in the input."
+INTERMEDIATE = "The absolute cell coordinates of that vertical domino."
+STEP_B = (
+    "Among exact horizontal gray dominoes, select the unique one with minimum "
+    "Manhattan cell distance to the intermediate and recolor it cyan."
+)
+WHY_B_DEPENDS_ON_A = (
+    "Step B consumes the input-specific anchor coordinates produced by step A; "
+    "skipping that intermediate and choosing a fixed top-left target changes the "
+    "final output on every retained witness case."
+)
+
+
+def _load_adjacent(filename: str, label: str):
+    path = Path(__file__).resolve().with_name(filename)
+    digest = hashlib.sha256(path.read_bytes()).hexdigest()[:16]
+    name = f"_arc_{TASK_ID}_{label}_{digest}"
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load adjacent source: {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+_PROTOTYPE = _load_adjacent("prototype.py", "prototype")
+_ADAPTER = _load_adjacent("adapter.py", "adapter")
+
+
+def _sha(value: Any) -> str:
+    raw = json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _inputs(episode: dict[str, Any]) -> list[list[list[int]]]:
+    return [pair["input"] for pair in episode["train"] + episode["test"]]
+
+
+def _near_miss_anchor_transform(grid: list[list[int]]) -> list[list[int]]:
+    analysis = _PROTOTYPE.analyze(grid)
+    if analysis["errors"]:
+        raise ValueError("invalid rival input: " + "; ".join(analysis["errors"]))
+    near = analysis["near_miss"][0]
+    target = min(
+        analysis["horizontal"],
+        key=lambda obj: (_PROTOTYPE.object_distance(near, obj), obj["cells"]),
+    )
+    output = deepcopy(grid)
+    for row, col in target["cells"]:
+        output[row][col] = 8
+    return output
+
+
+def _candidate_outputs(grid: list[list[int]]) -> dict[str, list[list[int]]]:
+    return {
+        "all_horizontal": _PROTOTYPE.transform(grid, "all_horizontal"),
+        "nearest_vertical": _PROTOTYPE.transform(grid, "nearest_vertical"),
+        "fixed_top_left": _PROTOTYPE.counterfactual_transform(grid),
+        "nearest_near_miss": _near_miss_anchor_transform(grid),
+    }
+
+
+def _survivors(
+    demos: list[dict[str, Any]], names: tuple[str, ...]
+) -> list[str]:
+    survivors: list[str] = []
+    for name in names:
+        if all(_candidate_outputs(pair["input"])[name] == pair["output"] for pair in demos):
+            survivors.append(name)
+    return survivors
+
+
+def _bbox(grid: list[list[int]]) -> tuple[int, int, int, int]:
+    cells = [
+        (row, col)
+        for row, values in enumerate(grid)
+        for col, value in enumerate(values)
+        if value != 0
+    ]
+    return (
+        min(row for row, _ in cells),
+        min(col for _, col in cells),
+        max(row for row, _ in cells),
+        max(col for _, col in cells),
+    )
+
+
+def build_static_report() -> dict[str, Any]:
+    episode_rows: list[dict[str, Any]] = []
+    for seed in (0, 17):
+        for selected in SETTINGS:
+            episode = _ADAPTER.generate(seed, {SETTING_NAME: selected}, 3, 4)
+            declared = _survivors(episode["train"], SETTINGS)
+            shortcuts = _survivors(
+                episode["train"], ("fixed_top_left", "nearest_near_miss")
+            )
+            if declared != [selected]:
+                raise ValueError(
+                    f"declared settings are not identified for seed={seed}, setting={selected}: {declared}"
+                )
+            if shortcuts:
+                raise ValueError(
+                    f"shortcut rival survives all demonstrations for seed={seed}, setting={selected}: {shortcuts}"
+                )
+            episode_rows.append(
+                {
+                    "seed": seed,
+                    "selected_setting": selected,
+                    "declared_survivors": declared,
+                    "shortcut_survivors": shortcuts,
+                    "demo_count": len(episode["train"]),
+                    "query_count": len(episode["test"]),
+                    "input_sha256": [_sha(grid) for grid in _inputs(episode)],
+                    "query_output_sha256": [_sha(pair["output"]) for pair in episode["test"]],
+                }
+            )
+
+    minimum = _ADAPTER.generate(5, {SETTING_NAME: "all_horizontal"}, 2, 1)
+    maximum = _ADAPTER.generate(5, {SETTING_NAME: "nearest_vertical"}, 6, 8)
+    prefix_one = _ADAPTER.generate(19, {SETTING_NAME: "nearest_vertical"}, 2, 1)
+    prefix_four = _ADAPTER.generate(19, {SETTING_NAME: "nearest_vertical"}, 6, 4)
+    large = _PROTOTYPE.build_input(0, "test", 3)
+    analysis = _PROTOTYPE.analyze(large)
+    top, left, bottom, right = _bbox(large)
+
+    return {
+        "schema": "arcpuzzles-e46c2557ad08-parametric-review-v1",
+        "task_id": TASK_ID,
+        "seeds": [0, 17],
+        "settings": list(SETTINGS),
+        "episodes": episode_rows,
+        "rivals_tested": [
+            "other declared finite setting",
+            "fixed top-left horizontal domino",
+            "horizontal domino nearest the near-miss object",
+        ],
+        "boundary_checks": {
+            "min_counts": {
+                "demos": len(minimum["train"]),
+                "queries": len(minimum["test"]),
+            },
+            "max_counts": {
+                "demos": len(maximum["train"]),
+                "queries": len(maximum["test"]),
+            },
+            "max_inputs_distinct": len({_sha(grid) for grid in _inputs(maximum)})
+            == 14,
+            "query_prefix_stable": prefix_one["test"] == prefix_four["test"][:1]
+            and prefix_one["train"] == prefix_four["train"][:2],
+            "thirty_by_thirty": {
+                "shape": [len(large), len(large[0])],
+                "horizontal_targets": len(analysis["horizontal"]),
+                "foreground_row_span": bottom - top,
+                "foreground_col_span": right - left,
+            },
+        },
+        "limits": (
+            "Finite audit of two declared settings and two plausible shortcuts on seeds 0 and 17; "
+            "not a proof against arbitrary programs or measured training gain."
+        ),
+    }
+
+
+def build_examples() -> dict[str, Any]:
+    episodes: list[dict[str, Any]] = []
+    for seed in (0, 17):
+        for selected in SETTINGS:
+            episode = _ADAPTER.generate(seed, {SETTING_NAME: selected}, 3, 4)
+            episodes.append(
+                {
+                    "seed": seed,
+                    "selected_setting": selected,
+                    "public": _PROTOTYPE.public_challenge(episode),
+                    "turns": [
+                        _PROTOTYPE.public_turn(episode, index)
+                        for index in range(len(episode["test"]))
+                    ],
+                    "program_sha256": hashlib.sha256(
+                        episode["program_solution"].encode()
+                    ).hexdigest(),
+                    "private_query_output_sha256": [
+                        _sha(pair["output"]) for pair in episode["test"]
+                    ],
+                }
+            )
+    return {
+        "schema": "arcpuzzles-e46c2557ad08-examples-v1",
+        "task_id": TASK_ID,
+        "episodes": episodes,
+        "visibility": (
+            "The public projection contains demonstration labels and masked query inputs only; "
+            "settings, programs, seeds, and query labels remain private metadata."
+        ),
+    }
+
+
+def _write_json(path: Path, value: Any) -> None:
+    path.write_text(
+        json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False)
+        + "\n",
+        encoding="utf-8",
+    )
+
+
+def write_static_evidence(output: Path | str) -> dict[str, Any]:
+    output = Path(output)
+    if output.exists() or output.is_symlink():
+        raise FileExistsError(output)
+    output.mkdir(parents=True)
+    _write_json(output / "review.json", build_static_report())
+    _write_json(output / "examples.json", build_examples())
+    return {
+        "output": str(output),
+        "files": ["examples.json", "review.json"],
+    }
+
+
+def _qualification_program(qualification: dict[str, Any]) -> str:
+    if (
+        not isinstance(qualification, dict)
+        or qualification.get("schema") != "arcpuzzles-parametric-qualification-v1"
+        or qualification.get("status") != "qualified"
+        or qualification.get("task_id") != TASK_ID
+        or not isinstance(qualification.get("source_binding"), dict)
+        or not isinstance(qualification.get("programs"), dict)
+    ):
+        raise ValueError("invalid qualified source receipt")
+    program = _ADAPTER.program({SETTING_NAME: "nearest_vertical"})
+    key = json.dumps(
+        {SETTING_NAME: "nearest_vertical"},
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+    )
+    if qualification["programs"].get(key) != hashlib.sha256(program.encode()).hexdigest():
+        raise ValueError("alternative program is not the qualified setting program")
+    return program
+
+
+def _witness_inputs(case_count: int) -> list[list[list[int]]]:
+    if type(case_count) is not int or not 1 <= case_count <= 16:
+        raise ValueError("case_count must be an exact integer in 1..16")
+    selected: list[list[list[int]]] = []
+    for seed in (0, 17, 41, 73, 101, 313):
+        for role, count in (("train", 6), ("test", 8)):
+            for index in range(count):
+                grid = _PROTOTYPE.build_input(seed, role, index)
+                if _PROTOTYPE.transform(grid, "nearest_vertical") == _PROTOTYPE.counterfactual_transform(grid):
+                    continue
+                selected.append(grid)
+                if len(selected) == case_count:
+                    return selected
+    raise ValueError("could not construct enough non-collapsing witness cases")
+
+
+def build_witness(
+    qualification: dict[str, Any], *, case_count: int = 4
+) -> dict[str, Any]:
+    program = _qualification_program(qualification)
+    counterfactual = _PROTOTYPE.counterfactual_program()
+    cases = []
+    for grid in _witness_inputs(case_count):
+        analysis = _PROTOTYPE.analyze(grid)
+        cases.append(
+            {
+                "input": deepcopy(grid),
+                "settings": {SETTING_NAME: "nearest_vertical"},
+                "intermediate_value": [
+                    list(cell) for cell in analysis["vertical"][0]["cells"]
+                ],
+                "program": program,
+                "output": _PROTOTYPE.transform(grid, "nearest_vertical"),
+                "counterfactual_program": counterfactual,
+                "counterfactual_output": _PROTOTYPE.counterfactual_transform(grid),
+                "ablation": "skip_a",
+            }
+        )
+    return {
+        "schema": "arcpuzzles-sequential-dependency-witness-v1",
+        "source_binding": deepcopy(qualification["source_binding"]),
+        "racket": {"backend": "racket", "protected": True},
+        "step_a": STEP_A,
+        "intermediate": INTERMEDIATE,
+        "step_b": STEP_B,
+        "why_b_depends_on_a": WHY_B_DEPENDS_ON_A,
+        "cases": cases,
+    }
+
+
+def write_witness(
+    qualification_path: Path | str,
+    output: Path | str,
+    *,
+    case_count: int = 4,
+) -> dict[str, Any]:
+    qualification_path = Path(qualification_path)
+    output = Path(output)
+    if output.exists() or output.is_symlink():
+        raise FileExistsError(output)
+    qualification = json.loads(qualification_path.read_text(encoding="utf-8"))
+    witness = build_witness(qualification, case_count=case_count)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    _write_json(output, witness)
+    return {
+        "output": str(output),
+        "cases": len(witness["cases"]),
+        "sha256": hashlib.sha256(output.read_bytes()).hexdigest(),
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    commands = parser.add_subparsers(dest="command", required=True)
+    static = commands.add_parser("static")
+    static.add_argument("--out", type=Path, required=True)
+    witness = commands.add_parser("witness")
+    witness.add_argument("--qualification", type=Path, required=True)
+    witness.add_argument("--out", type=Path, required=True)
+    witness.add_argument("--cases", type=int, default=4)
+    args = parser.parse_args(argv)
+    if args.command == "static":
+        result = write_static_evidence(args.out)
+    else:
+        result = write_witness(
+            args.qualification, args.out, case_count=args.cases
+        )
+    print(json.dumps(result, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
