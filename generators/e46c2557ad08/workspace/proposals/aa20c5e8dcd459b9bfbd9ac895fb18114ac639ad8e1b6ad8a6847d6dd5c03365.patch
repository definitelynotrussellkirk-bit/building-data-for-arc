+"""Native-promotion tests for the nearest-vertical parametric family."""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import types
+from uuid import uuid4
+
+import pytest
+
+from arcpuzzles.parametric_worker import evaluate_contract
+from reviewer_support import find_root
+
+
+ROOT = find_root(__file__)
+TASK_ID = "e46c2557ad08"
+HOME = ROOT / f"generators/{TASK_ID}/workspace/parametric"
+ADAPTER_PATH = HOME / "adapter.py"
+PROTOTYPE_PATH = HOME / "prototype.py"
+CANONICAL_PATH = HOME / "canonical.rkt"
+CONTRACT_PATH = HOME / "promotion.json"
+CANONICAL_SHA256 = "bba257d19e2b9ed977892b09ef1fa837029e8c9a96a819e0d356d2c04f708f44"
+CANONICAL_SOURCE = "(rule! (let ((dummy 0)) (define (norm-cells cells) (sort (normalize-cells cells) cell<)) (define (objs-color grid color) (filter (lambda (obj) (= (obj-color obj) color)) (objects grid 0))) (define (paint-obj grid obj color) (paint-cells grid (obj-cells obj) color)) (for/fold ((out g)) ((obj (in-list (objs-color g 5)))) (if (equal? (norm-cells (obj-cells obj)) (list (list 0 0) (list 0 1))) (paint-obj out obj 8) out))))"
+
+
+def _load(path: Path, prefix: str):
+    assert path.is_file(), f"missing required promotion source: {path.name}"
+    name = f"{prefix}_{uuid4().hex}"
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _contract() -> dict:
+    assert CONTRACT_PATH.is_file(), "missing native promotion contract"
+    return json.loads(CONTRACT_PATH.read_text(encoding="utf-8"))
+
+
+def _pairs(episode: dict) -> list[dict]:
+    return episode["train"] + episode["test"]
+
+
+def _foreground_bbox(grid: list[list[int]]) -> tuple[int, int, int, int]:
+    cells = [
+        (row, col)
+        for row, values in enumerate(grid)
+        for col, value in enumerate(values)
+        if value != 0
+    ]
+    return (
+        min(row for row, _ in cells),
+        min(col for _, col in cells),
+        max(row for row, _ in cells),
+        max(col for _, col in cells),
+    )
+
+
+def test_contract_declares_bounded_native_adapter():
+    assert _contract() == {
+        "schema": "arcpuzzles-parametric-adapter-v1",
+        "adapter": "generators/e46c2557ad08/workspace/parametric/adapter.py",
+        "parameters": {"target_scope": ["all_horizontal", "nearest_vertical"]},
+        "default": {"target_scope": "all_horizontal"},
+        "limits": {"demos": [2, 6], "queries": [1, 8]},
+        "resources": [
+            "generators/e46c2557ad08/workspace/parametric/canonical.rkt",
+            "generators/e46c2557ad08/workspace/parametric/prototype.py",
+        ],
+    }
+
+
+def test_default_program_is_exact_catalog_source_and_variant_is_distinct():
+    adapter = _load(ADAPTER_PATH, "nearest_vertical_adapter")
+    prototype = _load(PROTOTYPE_PATH, "nearest_vertical_prototype")
+
+    canonical = adapter.program({"target_scope": "all_horizontal"})
+    alternative = adapter.program({"target_scope": "nearest_vertical"})
+
+    assert canonical == CANONICAL_SOURCE
+    assert CANONICAL_PATH.read_text(encoding="utf-8") == CANONICAL_SOURCE
+    assert hashlib.sha256(canonical.encode()).hexdigest() == CANONICAL_SHA256
+    assert canonical == prototype.canonical_source()
+    assert alternative == prototype.materialize_rule("nearest_vertical")
+    assert alternative != canonical
+
+
+@pytest.mark.parametrize(
+    ("seed", "settings", "demos", "queries"),
+    [
+        (True, {"target_scope": "all_horizontal"}, 3, 4),
+        (-1, {"target_scope": "all_horizontal"}, 3, 4),
+        (2**63, {"target_scope": "all_horizontal"}, 3, 4),
+        (0, {"target_scope": "all_horizontal"}, True, 4),
+        (0, {"target_scope": "all_horizontal"}, 1, 4),
+        (0, {"target_scope": "all_horizontal"}, 7, 4),
+        (0, {"target_scope": "all_horizontal"}, 3, 0),
+        (0, {"target_scope": "all_horizontal"}, 3, 9),
+        (0, {"target_scope": "nearest"}, 3, 4),
+        (0, {"target_scope": "all_horizontal", "extra": 1}, 3, 4),
+        (0, None, 3, 4),
+    ],
+)
+def test_adapter_rejects_malformed_requests(seed, settings, demos, queries):
+    adapter = _load(ADAPTER_PATH, "nearest_vertical_adapter")
+    with pytest.raises((TypeError, ValueError)):
+        adapter.generate(seed, settings, demos, queries)
+
