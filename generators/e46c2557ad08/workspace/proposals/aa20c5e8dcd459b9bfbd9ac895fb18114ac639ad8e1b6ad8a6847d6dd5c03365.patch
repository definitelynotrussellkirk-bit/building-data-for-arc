+"""Deterministic parametric prototype for e46c2557ad08.
+
+The canonical setting recolors every exact horizontal gray domino.  The
+composed setting first locates the unique vertical gray domino, uses its cells
+as an intermediate, and recolors only the uniquely nearest horizontal domino.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import random
+from typing import Any, Iterable
+
+
+TASK_ID = "e46c2557ad08"
+PARAMETER_NAME = "target_scope"
+PARAMETER_VALUES = ("all_horizontal", "nearest_vertical")
+DEFAULT_PARAMETER = "all_horizontal"
+CANONICAL_SHA256 = "bba257d19e2b9ed977892b09ef1fa837029e8c9a96a819e0d356d2c04f708f44"
+
+Cell = tuple[int, int]
+Grid = list[list[int]]
+Object = dict[str, Any]
+Shape = tuple[Cell, ...]
+
+HORIZONTAL: Shape = ((0, 0), (0, 1))
+VERTICAL: Shape = ((0, 0), (1, 0))
+NEAR_SHAPES: dict[str, Shape] = {
+    "h3": ((0, 0), (0, 1), (0, 2)),
+    "square": ((0, 0), (0, 1), (1, 0), (1, 1)),
+    "h4": ((0, 0), (0, 1), (0, 2), (0, 3)),
+}
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+# Profiles are fixed by role/index, not by requested episode counts.  This
+# makes prefixes stable and keeps query sampling independent of demo count.
+TRAIN_PROFILES = (
+    (8, 10, 3, "h3"),
+    (9, 12, 4, "square"),
+    (12, 14, 5, "h4"),
+    (14, 16, 6, "h3"),
+    (16, 20, 8, "square"),
+    (18, 22, 10, "h4"),
+)
+TEST_PROFILES = (
+    (14, 16, 6, "h4"),
+    (20, 24, 10, "square"),
+    (24, 30, 12, "h3"),
+    (30, 30, 16, "h4"),
+    (18, 30, 10, "square"),
+    (30, 18, 10, "h3"),
+    (22, 26, 12, "h4"),
+    (26, 22, 12, "square"),
+)
+
+NEAREST_VERTICAL_PROGRAM = """(rule! (let ((dummy 0))
+  (define (norm-cells cells) (sort (normalize-cells cells) cell<))
+  (define (objs-color grid color)
+    (filter (lambda (obj) (= (obj-color obj) color)) (objects grid 0)))
+  (define (horizontal? obj)
+    (equal? (norm-cells (obj-cells obj)) (list (list 0 0) (list 0 1))))
+  (define (vertical? obj)
+    (equal? (norm-cells (obj-cells obj)) (list (list 0 0) (list 1 0))))
+  (define (obj-distance a b)
+    (min-list
+      (for*/list ((ca (in-list (obj-cells a)))
+                  (cb (in-list (obj-cells b))))
+        (+ (abs (- (first ca) (first cb)))
+           (abs (- (second ca) (second cb)))))))
+  (define gray (objs-color g 5))
+  (define anchor (find-first vertical? gray))
+  (define targets (filter horizontal? gray))
+  (define chosen
+    (first
+      (sort targets
+        (lambda (a b)
+          (let ((da (obj-distance anchor a))
+                (db (obj-distance anchor b)))
+            (if (= da db)
+                (cell< (first (sort (obj-cells a) cell<))
+                       (first (sort (obj-cells b) cell<)))
+                (< da db)))))))
+  (paint-cells g (obj-cells chosen) 8)))"""
+
+TOP_LEFT_COUNTERFACTUAL_PROGRAM = """(rule! (let ((dummy 0))
+  (define (norm-cells cells) (sort (normalize-cells cells) cell<))
+  (define (objs-color grid color)
+    (filter (lambda (obj) (= (obj-color obj) color)) (objects grid 0)))
+  (define (horizontal? obj)
+    (equal? (norm-cells (obj-cells obj)) (list (list 0 0) (list 0 1))))
+  (define targets (filter horizontal? (objs-color g 5)))
+  (define chosen
+    (first
+      (sort targets
+        (lambda (a b)
+          (cell< (first (sort (obj-cells a) cell<))
+                 (first (sort (obj-cells b) cell<)))))))
+  (paint-cells g (obj-cells chosen) 8)))"""
+
+
+def _sha256(value: str | bytes) -> str:
+    payload = value.encode("utf-8") if isinstance(value, str) else value
+    return hashlib.sha256(payload).hexdigest()
+
+
+def canonical_source() -> str:
+    source = Path(__file__).resolve().with_name("canonical.rkt").read_text(encoding="utf-8")
+    if _sha256(source) != CANONICAL_SHA256:
+        raise ValueError("canonical.rkt differs from the catalog program")
+    return source
+
+
+def validate_parameter(value: Any) -> str:
+    if type(value) is not str or value not in PARAMETER_VALUES:
+        raise ValueError(f"{PARAMETER_NAME} must be one of {PARAMETER_VALUES!r}")
+    return value
+
+
+def materialize_rule(value: Any) -> str:
+    selected = validate_parameter(value)
+    if selected == DEFAULT_PARAMETER:
+        return canonical_source()
+    return NEAREST_VERTICAL_PROGRAM
+
+
+def counterfactual_program() -> str:
+    return TOP_LEFT_COUNTERFACTUAL_PROGRAM
+
+
+def _stable_seed(*parts: Any) -> int:
+    payload = json.dumps(parts, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return int.from_bytes(hashlib.sha256(payload).digest()[:8], "big")
+
+
+def _validate_seed(seed: Any) -> int:
+    if type(seed) is not int:
+        raise TypeError("seed must be an exact integer")
+    if not 0 <= seed < 2**63:
+        raise ValueError("seed must be in 0..2**63-1")
+    return seed
+
+
+def _validate_role_index(role: Any, index: Any) -> tuple[str, int]:
+    if role not in {"train", "test"}:
+        raise ValueError("role must be 'train' or 'test'")
+    if type(index) is not int:
+        raise TypeError("index must be an exact integer")
+    profiles = TRAIN_PROFILES if role == "train" else TEST_PROFILES
+    if not 0 <= index < len(profiles):
+        raise ValueError(f"{role} index must be in 0..{len(profiles) - 1}")
+    return role, index
+
+
+def _translate(shape: Iterable[Cell], top: int, left: int) -> set[Cell]:
+    return {(top + row, left + col) for row, col in shape}
+
+
+def _halo(cells: Iterable[Cell], height: int, width: int) -> set[Cell]:
+    return {
+        (row + dr, col + dc)
+        for row, col in cells
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if 0 <= row + dr < height and 0 <= col + dc < width
+    }
+
+
+def _flip(
+    cells: Iterable[Cell],
+    height: int,
+    width: int,
+    *,
+    vertical: bool,
+    horizontal: bool,
+) -> set[Cell]:
+    result: set[Cell] = set()
+    for row, col in cells:
+        if vertical:
+            row = height - 1 - row
+        if horizontal:
+            col = width - 1 - col
+        result.add((row, col))
+    return result
+
+
+def _component_distance(a: Iterable[Cell], b: Iterable[Cell]) -> int:
+    return min(
+        abs(arow - brow) + abs(acol - bcol)
+        for arow, acol in a
+        for brow, bcol in b
+    )
+
+
+def _candidate_slots(height: int, width: int) -> list[set[Cell]]:
+    rows = sorted(set(range(1, height, 4)) | {height - 2})
+    cols = sorted(set(range(4, width - 1, 4)) | {width - 2})
+    return [
+        {(row, col), (row, col + 1)}
+        for row in rows
+        for col in cols
+        if 0 <= row < height and 0 <= col < width - 1
+    ]
+
+
+def _choose_targets(
+    height: int,
+    width: int,
+    count: int,
+    fixed: list[set[Cell]],
+    rng: random.Random,
+) -> list[set[Cell]]:
+    nearest = fixed[-1]
+    blocked = set().union(*(_halo(cells, height, width) for cells in fixed))
+    candidates: list[set[Cell]] = []
+    seen: set[tuple[Cell, ...]] = set()
+    for cells in _candidate_slots(height, width):
+        key = tuple(sorted(cells))
+        if key in seen or cells & blocked:
+            continue
+        seen.add(key)
+        candidates.append(cells)
+    rng.shuffle(candidates)
+
+    selected = [nearest]
+    while len(selected) < count:
+        feasible = [
+            cells
+            for cells in candidates
+            if all(not cells & _halo(other, height, width) for other in selected)
+        ]
+        if not feasible:
+            raise AssertionError(f"not enough constructive slots for {height}x{width} count={count}")
+
+        def score(cells: set[Cell]) -> tuple[int, int, int]:
+            spread = min(_component_distance(cells, other) for other in selected)
+            edge_span = max(row for row, _ in cells) + max(col for _, col in cells)
+            anchor_distance = _component_distance(cells, fixed[0])
+            return spread, edge_span, anchor_distance
+
+        best_score = max(score(cells) for cells in feasible)
+        tied = [cells for cells in feasible if score(cells) == best_score]
+        chosen = rng.choice(tied)
+        selected.append(chosen)
+        candidates.remove(chosen)
+    return selected
+
+
+def build_input(seed: Any, role: Any, index: Any) -> Grid:
+    seed = _validate_seed(seed)
+    role, index = _validate_role_index(role, index)
+    height, width, target_count, near_kind = (
+        TRAIN_PROFILES[index] if role == "train" else TEST_PROFILES[index]
+    )
+    rng = random.Random(_stable_seed(TASK_ID, seed, role, index))
+
+    anchor = _translate(VERTICAL, 1, 1)
+    nearest = _translate(HORIZONTAL, 1, 4)
+    near_shape = NEAR_SHAPES[near_kind]
+    near_height = max(row for row, _ in near_shape) + 1
+    near_miss = _translate(near_shape, height - near_height - 1, 0)
+    targets = _choose_targets(height, width, target_count, [anchor, near_miss, nearest], rng)
+
+    vertical_flip = bool(rng.randrange(2))
+    horizontal_flip = bool(rng.randrange(2))
+    objects = [anchor, near_miss, *targets]
+    objects = [
+        _flip(
+            cells,
+            height,
+            width,
+            vertical=vertical_flip,
+            horizontal=horizontal_flip,
+        )
+        for cells in objects
+    ]
+
+    grid = [[0 for _ in range(width)] for _ in range(height)]
+    for cells in objects:
+        for row, col in cells:
+            if grid[row][col] != 0:
+                raise AssertionError("constructive placement overlap")
+            grid[row][col] = 5
+
+    result = analyze(grid)
+    if result["errors"]:
+        raise AssertionError("constructed invalid scene: " + "; ".join(result["errors"]))
+    distances = sorted(object_distance(result["vertical"][0], obj) for obj in result["horizontal"])
+    if distances[0] >= distances[1]:
+        raise AssertionError("constructed scene lacks a unique nearest target")
+    return grid
+
+
+def _shape_error(grid: Any) -> str | None:
+    if type(grid) is not list or not grid:
+        return "grid must be a nonempty list"
+    if any(type(row) is not list for row in grid):
+        return "every row must be a list"
+    width = len(grid[0])
+    if width == 0 or any(len(row) != width for row in grid):
+        return "grid must be rectangular and nonempty"
+    if any(type(value) is not int for row in grid for value in row):
+        return "grid cells must be exact integers"
+    return None
+
+
+def _normalize(cells: Iterable[Cell]) -> Shape:
+    values = tuple(cells)
+    top = min(row for row, _ in values)
+    left = min(col for _, col in values)
+    return tuple(sorted((row - top, col - left) for row, col in values))
+
+
+def _components(grid: Grid) -> list[Object]:
+    height, width = len(grid), len(grid[0])
+    seen: set[Cell] = set()
+    result: list[Object] = []
+    for row in range(height):
+        for col in range(width):
+            start = (row, col)
+            color = grid[row][col]
+            if color == 0 or start in seen:
+                continue
+            stack = [start]
+            seen.add(start)
+            cells: set[Cell] = set()
+            while stack:
+                current = stack.pop()
+                cells.add(current)
+                for dr, dc in DIR4:
+                    neighbor = (current[0] + dr, current[1] + dc)
+                    if (
+                        0 <= neighbor[0] < height
+                        and 0 <= neighbor[1] < width
+                        and neighbor not in seen
+                        and grid[neighbor[0]][neighbor[1]] == color
+                    ):
+                        seen.add(neighbor)
+                        stack.append(neighbor)
+            ordered = tuple(sorted(cells))
+            result.append({"color": color, "cells": ordered, "shape": _normalize(ordered)})
+    return result
+
+
+def analyze(grid: Any) -> dict[str, Any]:
+    error = _shape_error(grid)
+    if error:
+        return {"errors": [error]}
+    height, width = len(grid), len(grid[0])
+    errors: list[str] = []
+    if not 8 <= height <= 30 or not 8 <= width <= 30:
+        errors.append("dimensions must be within 8..30")
+    if any(value not in (0, 5) for row in grid for value in row):
+        errors.append("inputs may contain only 0 and 5")
+    components = _components(grid)
+    for index, component in enumerate(components):
+        halo = _halo(component["cells"], height, width)
+        if any(halo & set(other["cells"]) for other in components[index + 1 :]):
+            errors.append("components must be separated by a one-cell halo")
+            break
+    horizontal = [obj for obj in components if obj["color"] == 5 and obj["shape"] == HORIZONTAL]
+    vertical = [obj for obj in components if obj["color"] == 5 and obj["shape"] == VERTICAL]
+    near_miss = [obj for obj in components if obj["color"] == 5 and obj["shape"] in set(NEAR_SHAPES.values())]
+    supported = {HORIZONTAL, VERTICAL, *NEAR_SHAPES.values()}
+    unsupported = [obj for obj in components if obj["shape"] not in supported]
+    if len(horizontal) < 3:
+        errors.append(f"expected at least three horizontal targets, found {len(horizontal)}")
+    if len(vertical) != 1:
+        errors.append(f"expected one vertical anchor, found {len(vertical)}")
+    if len(near_miss) != 1:
+        errors.append(f"expected one near miss, found {len(near_miss)}")
+    if unsupported:
+        errors.append(f"found {len(unsupported)} unsupported object(s)")
+    if len(components) != len(horizontal) + 2:
+        errors.append("expected only targets, one anchor, and one near miss")
+    return {
+        "errors": sorted(set(errors)),
+        "height": height,
+        "width": width,
+        "components": components,
+        "horizontal": horizontal,
+        "vertical": vertical,
+        "near_miss": near_miss,
+    }
+
+
+def object_distance(a: Object | Iterable[Cell], b: Object | Iterable[Cell]) -> int:
+    a_cells = a["cells"] if isinstance(a, dict) else a
+    b_cells = b["cells"] if isinstance(b, dict) else b
+    return _component_distance(a_cells, b_cells)
+
+
+def nearest_horizontal(grid: Grid) -> Object:
+    error = _shape_error(grid)
+    if error:
+        raise ValueError(error)
+    components = _components(grid)
+    anchors = [obj for obj in components if obj["color"] == 5 and obj["shape"] == VERTICAL]
+    targets = [obj for obj in components if obj["color"] == 5 and obj["shape"] == HORIZONTAL]
+    if len(anchors) != 1 or not targets:
+        raise ValueError("nearest_vertical requires one vertical anchor and horizontal targets")
+    ranked = sorted(targets, key=lambda obj: (object_distance(anchors[0], obj), obj["cells"]))
+    if len(ranked) > 1 and object_distance(anchors[0], ranked[0]) == object_distance(anchors[0], ranked[1]):
+        raise ValueError("nearest horizontal target must be unique")
+    return ranked[0]
+
+
+def top_left_horizontal(grid: Grid) -> Object:
+    components = _components(grid)
+    targets = [obj for obj in components if obj["color"] == 5 and obj["shape"] == HORIZONTAL]
+    if not targets:
+        raise ValueError("top-left counterfactual requires a horizontal target")
+    return min(targets, key=lambda obj: obj["cells"])
+
+
+def _paint(grid: Grid, objects: Iterable[Object]) -> Grid:
+    output = deepcopy(grid)
+    for obj in objects:
+        for row, col in obj["cells"]:
+            output[row][col] = 8
+    return output
+
+
+def transform(grid: Grid, value: Any) -> Grid:
+    selected = validate_parameter(value)
+    error = _shape_error(grid)
+    if error:
+        raise ValueError(error)
+    components = _components(grid)
+    targets = [obj for obj in components if obj["color"] == 5 and obj["shape"] == HORIZONTAL]
+    if selected == "all_horizontal":
+        return _paint(grid, targets)
+    return _paint(grid, [nearest_horizontal(grid)])
+
+
+def counterfactual_transform(grid: Grid) -> Grid:
+    return _paint(grid, [top_left_horizontal(grid)])
+
+
+def public_challenge(episode: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "train": [
+            {"input": deepcopy(pair["input"]), "output": deepcopy(pair["output"])}
+            for pair in episode["train"]
+        ],
+        "test": [{"input": deepcopy(pair["input"])} for pair in episode["test"]],
+    }
+
+
+def public_turn(episode: dict[str, Any], query_index: Any) -> dict[str, Any]:
+    """Reveal one query input without future-query or turn-count metadata."""
+    if type(episode) is not dict or type(episode.get("train")) is not list or type(episode.get("test")) is not list:
+        raise TypeError("episode must contain train and test lists")
+    if type(query_index) is not int:
+        raise TypeError("query_index must be an exact integer")
+    if not 0 <= query_index < len(episode["test"]):
+        raise ValueError("query_index must identify an existing query")
+    projected = {
+        "train": episode["train"],
+        "test": [episode["test"][query_index]],
+    }
+    return public_challenge(projected)
