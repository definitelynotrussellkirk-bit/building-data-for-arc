+def test_sampler_has_one_anchor_one_near_miss_and_unique_nearest_target():
+    prototype = _load(PROTOTYPE_PATH, "nearest_vertical_prototype")
+    for seed in (0, 1, 17, 2**31 + 9):
+        for role, indices in (("train", range(6)), ("test", range(8))):
+            for index in indices:
+                grid = prototype.build_input(seed, role, index)
+                analysis = prototype.analyze(grid)
+                assert analysis["errors"] == []
+                assert len(analysis["vertical"]) == 1
+                assert len(analysis["near_miss"]) == 1
+                assert len(analysis["horizontal"]) >= 3
+                distances = sorted(
