+"""Native promotion adapter for the nearest-vertical parametric family."""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+
+TASK_ID = "e46c2557ad08"
+PARAMETER_NAME = "target_scope"
+PARAMETER_VALUES = ("all_horizontal", "nearest_vertical")
+MIN_DEMOS = 2
+MAX_DEMOS = 6
+MIN_QUERIES = 1
+MAX_QUERIES = 8
+
+
+def _load_adjacent_prototype():
+    path = Path(__file__).resolve().with_name("prototype.py")
+    if not path.is_file():
+        raise ImportError(f"missing adjacent prototype: {path}")
+    digest = hashlib.sha256(path.read_bytes()).hexdigest()[:16]
+    name = f"_arc_parametric_{TASK_ID}_prototype_{digest}"
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load adjacent prototype: {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+_PROTOTYPE = _load_adjacent_prototype()
+
+
+def _validate_seed(seed: Any) -> int:
+    if type(seed) is not int:
+        raise TypeError("seed must be an exact integer")
+    if not 0 <= seed < 2**63:
+        raise ValueError("seed must be in 0..2**63-1")
+    return seed
+
+
+def _validate_count(name: str, value: Any, low: int, high: int) -> int:
+    if type(value) is not int:
+        raise TypeError(f"{name} must be an exact integer")
+    if not low <= value <= high:
+        raise ValueError(f"{name} must be in {low}..{high}")
+    return value
+
+
+def _validate_settings(settings: Any) -> dict[str, str]:
+    if type(settings) is not dict:
+        raise TypeError("settings must be an object")
+    if set(settings) != {PARAMETER_NAME}:
+        raise ValueError(f"settings must contain exactly {PARAMETER_NAME!r}")
+    selected = _PROTOTYPE.validate_parameter(settings[PARAMETER_NAME])
+    return {PARAMETER_NAME: selected}
+
+
+def program(settings: dict[str, Any]) -> str:
+    normalized = _validate_settings(settings)
+    return _PROTOTYPE.materialize_rule(normalized[PARAMETER_NAME])
+
+
+def _inputs(seed: int, demos: int, queries: int) -> tuple[list, list]:
+    train = [_PROTOTYPE.build_input(seed, "train", index) for index in range(demos)]
+    test = [_PROTOTYPE.build_input(seed, "test", index) for index in range(queries)]
+    keys = [json.dumps(grid, separators=(",", ":")) for grid in [*train, *test]]
+    if len(keys) != len(set(keys)):
+        raise RuntimeError("deterministic profile schedule produced duplicate inputs")
+    return train, test
+
+
+def generate(
+    seed: int,
+    settings: dict[str, Any],
+    demos: int,
+    queries: int,
+) -> dict[str, Any]:
+    seed = _validate_seed(seed)
+    normalized = _validate_settings(settings)
+    demos = _validate_count("demos", demos, MIN_DEMOS, MAX_DEMOS)
+    queries = _validate_count("queries", queries, MIN_QUERIES, MAX_QUERIES)
+    selected = normalized[PARAMETER_NAME]
+    train_inputs, test_inputs = _inputs(seed, demos, queries)
+
+    def pair(grid):
+        return {
+            "input": deepcopy(grid),
+            "output": _PROTOTYPE.transform(grid, selected),
+        }
+
+    return {
+        "train": [pair(grid) for grid in train_inputs],
+        "test": [pair(grid) for grid in test_inputs],
+        "program_solution": program(normalized),
+    }
