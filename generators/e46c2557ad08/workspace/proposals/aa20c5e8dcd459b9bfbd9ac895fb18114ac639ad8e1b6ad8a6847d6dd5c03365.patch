+    adapter = _load(ADAPTER_PATH, "nearest_vertical_adapter")
+    with pytest.raises((TypeError, ValueError)):
+        adapter.program(settings)
+
+
+def test_generate_is_deterministic_setting_neutral_and_distinct():
+    adapter = _load(ADAPTER_PATH, "nearest_vertical_adapter")
+    all_episode = adapter.generate(41, {"target_scope": "all_horizontal"}, 3, 4)
+    nearest_episode = adapter.generate(41, {"target_scope": "nearest_vertical"}, 3, 4)
+    repeated = adapter.generate(41, {"target_scope": "all_horizontal"}, 3, 4)
+
+    assert all_episode == repeated
+    assert len(all_episode["train"]) == len(nearest_episode["train"]) == 3
+    assert len(all_episode["test"]) == len(nearest_episode["test"]) == 4
+    assert [pair["input"] for pair in _pairs(all_episode)] == [
+        pair["input"] for pair in _pairs(nearest_episode)
+    ]
+    assert all(
+        left["output"] != right["output"]
+        for left, right in zip(_pairs(all_episode), _pairs(nearest_episode))
+    )
+    assert len(
+        {
+            json.dumps(pair["input"], separators=(",", ":"))
+            for pair in _pairs(all_episode)
+        }
+    ) == 7
+
+
+def test_query_prefix_is_stable_and_independent_of_demo_count():
+    adapter = _load(ADAPTER_PATH, "nearest_vertical_adapter")
+    one = adapter.generate(19, {"target_scope": "nearest_vertical"}, 2, 1)
+    four = adapter.generate(19, {"target_scope": "nearest_vertical"}, 6, 4)
