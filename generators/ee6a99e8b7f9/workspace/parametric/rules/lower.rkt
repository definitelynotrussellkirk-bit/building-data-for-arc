(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((shapes-raw (objects g 0))
                  (shapes (filter (lambda (o)
                                    (or (= (obj-color o) 5) (= (obj-color o) 6)))
                                  shapes-raw))
                  (shape-infos (map (lambda (o)
                                      (let ((bb (obj-bbox o)))
                                        (list (obj-color o)
                                              (first bb)
                                              (second bb)
                                              (third bb)
                                              (fourth bb)
                                              (obj-cells o))))
                                    shapes))
                  (dots (for*/list ((r (range 0 h)) (c (range 0 w)) #:when (= (at g r c) 9))
                          (list r c)))
                  (g1 (for/fold ((out g))
                        ((si shape-infos))
                        (cond
                          ((= (first si) 5) (for/fold ((gg out))
                              ((cell (sixth si)))
                              (set-cell gg (first cell) (second cell) 8)))
                          (else out))))
                  (g2 (for/fold ((out g1))
                        ((dot dots))
                        (let ((dr (first dot))
                              (dc (second dot)))
                          (let loop
                               ((ss shape-infos))
                               (cond
                                 ((null? ss) out)
                                 (else (let* ((si (car ss))
                                              (color (first si))
                                              (r1 (second si))
                                              (c1 (third si))
                                              (r2 (fourth si))
                                              (c2 (fifth si))
                                              (in-rows (and (>= dr r1) (<= dr r2)))
                                              (in-cols (and (>= dc c1) (<= dc c2)))
                                              (left? (and in-rows (= dc (- c1 1))))
                                              (right? (and in-rows (= dc (+ c2 1))))
                                              (above? (and in-cols (= dr (- r1 1))))
                                              (below? (and in-cols (= dr (+ r2 1))))
                                              (lr? (or left? right?))
                                              (ud? (or above? below?)))
                                         (cond
                                           ((or lr? ud?) (cond
                                               ((= color 6) (let* ((mid-r (quotient (+ r1 r2) 2))
                                                        (mid-c (quotient (+ c1 c2) 2))
                                                        (nr (if lr? dr mid-r))
                                                        (nc (if lr? mid-c dc)))
                                                   (set-cell (set-cell out dr dc 8)
                                                             nr
                                                             nc
                                                             9)))
                                               (else (let* ((ar (cond
                                                                  (left? dr)
                                                                  (right? dr)
                                                                  (above? r1)
                                                                  (below? r2)))
                                                            (ac (cond
                                                                  (left? c1)
                                                                  (right? c2)
                                                                  (above? dc)
                                                                  (below? dc))))
                                                       (set-cell out ar ac 9)))))
                                           (else (loop (cdr ss))))))))))))
             g2))))
