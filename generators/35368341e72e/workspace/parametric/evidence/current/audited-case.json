  "program": "(rule! (let ((dummy 0))\n  ;; Decode every queried key, compute each prototype's active-cell-count,\n  ;; stably order occurrences from fewest active cells to most, then gallery.\n  (define (e8b-paste grid pat top left)\n    (for*/fold ((out grid)) ((r (in-range (rows pat))) (c (in-range (cols pat))))\n      (let ((v (at pat r c)) (rr (+ top r)) (cc (+ left c)))\n        (if (and (not (= v 0)) (in-bounds? rr cc (rows out) (cols out)))\n            (set-cell out rr cc v)\n            out))))\n  (define (s17b-gallery-row objs (gap 1))\n    (if (empty? objs)\n        (list (list 0))\n        (let* ((h (apply max (map rows objs)))\n               (w (+ (apply + (map cols objs)) (* gap (- (length objs) 1)))))\n          (let loop ((rest-objs objs) (left 0) (out (empty-grid h w 0)))\n            (if (empty? rest-objs)\n                out\n                (let ((obj (first rest-objs)))\n                  (loop (rest rest-objs)\n                        (+ left (cols obj) gap)\n                        (e8b-paste out obj 0 left))))))))\n  (define (t13-prototype-groups grid)\n    (map (lambda (c) (list (- c 1) (+ c 1) (at grid 0 c)))\n         (filter (lambda (c) (not (= (at grid 0 c) 0)))\n                 (range (cols grid)))))\n  (define (active-cell-count pat)\n    (count-if (lambda (p) (not (= (at pat (first p) (second p)) 0)))\n              (grid-positions pat)))\n  (let* ((groups (t13-prototype-groups g))\n         (query (filter (lambda (v) (not (= v 0))) (last g)))\n         (parts (map (lambda (key)\n                       (let ((grp (first (filter (lambda (entry) (= (third entry) key)) groups))))\n                         (subgrid g 1 (first grp) 3 (second grp))))\n                     query))\n         (ranked (sort parts (lambda (a b) (< (active-cell-count a)\n                                              (active-cell-count b))))))\n    (if (empty? query)\n        (list (list 0))\n        (s17b-gallery-row ranked 1)))))\n",
