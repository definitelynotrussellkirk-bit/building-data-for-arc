@@ -0,0 +1,39 @@
+(rule! (let ((dummy 0))
+  ;; Decode every queried key, compute each prototype's active-cell-count,
+  ;; stably order occurrences from fewest active cells to most, then gallery.
+  (define (e8b-paste grid pat top left)
+    (for*/fold ((out grid)) ((r (in-range (rows pat))) (c (in-range (cols pat))))
+      (let ((v (at pat r c)) (rr (+ top r)) (cc (+ left c)))
+        (if (and (not (= v 0)) (in-bounds? rr cc (rows out) (cols out)))
+            (set-cell out rr cc v)
+            out))))
+  (define (s17b-gallery-row objs (gap 1))
+    (if (empty? objs)
+        (list (list 0))
+        (let* ((h (apply max (map rows objs)))
+               (w (+ (apply + (map cols objs)) (* gap (- (length objs) 1)))))
+          (let loop ((rest-objs objs) (left 0) (out (empty-grid h w 0)))
+            (if (empty? rest-objs)
+                out
+                (let ((obj (first rest-objs)))
+                  (loop (rest rest-objs)
+                        (+ left (cols obj) gap)
+                        (e8b-paste out obj 0 left))))))))
+  (define (t13-prototype-groups grid)
+    (map (lambda (c) (list (- c 1) (+ c 1) (at grid 0 c)))
+         (filter (lambda (c) (not (= (at grid 0 c) 0)))
+                 (range (cols grid)))))
+  (define (active-cell-count pat)
+    (count-if (lambda (p) (not (= (at pat (first p) (second p)) 0)))
+              (grid-positions pat)))
+  (let* ((groups (t13-prototype-groups g))
+         (query (filter (lambda (v) (not (= v 0))) (last g)))
+         (parts (map (lambda (key)
+                       (let ((grp (first (filter (lambda (entry) (= (third entry) key)) groups))))
+                         (subgrid g 1 (first grp) 3 (second grp))))
+                     query))
+         (ranked (sort parts (lambda (a b) (< (active-cell-count a)
+                                              (active-cell-count b))))))
+    (if (empty? query)
+        (list (list 0))
+        (s17b-gallery-row ranked 1)))))
