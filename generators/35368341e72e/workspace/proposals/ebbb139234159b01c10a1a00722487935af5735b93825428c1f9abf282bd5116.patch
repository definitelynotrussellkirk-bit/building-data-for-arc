+#!/usr/bin/env python3
+"""Portable semantic/distribution audit for generator 3cdfed241796.
+
+The audit independently normalizes the two colored components, computes the
+uncropped symmetric difference, checks every canonical pair, samples all
+schedule/difficulty bands, and reports exact controls plus named-rival results.
+"""
+from __future__ import annotations
+
+from collections import Counter
+from copy import deepcopy
+import argparse
+import importlib.util
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import canonical_pairs, find_root
+
+TASK = "3cdfed241796"
+HOME = Path(__file__).resolve().parents[1]
+ROOT = find_root(__file__)
+CARD = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _load_generator():
+    path = Path(os.environ.get("GENERATOR_UNDER_TEST", HOME / "generator.py"))
+    spec = importlib.util.spec_from_file_location("audit_3cdfed241796", path)
+    module = importlib.util.module_from_spec(spec)
+    if spec.loader is None:
+        raise RuntimeError(f"cannot load generator from {path}")
+    spec.loader.exec_module(module)
+    return module
+
+
+def _component(grid, color):
+    cells = {
+        (r, c)
+        for r, row in enumerate(grid)
+        for c, value in enumerate(row)
+        if value == color
+    }
+    if not cells:
+        raise ValueError(f"missing color {color}")
+    start = min(cells)
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in CARD:
+            point = (r + dr, c + dc)
+            if point in cells and point not in seen:
+                seen.add(point)
+                stack.append(point)
+    if seen != cells:
+        raise ValueError(f"color {color} is disconnected")
+    return seen
+
+
+def _normalize(cells):
+    top = min(r for r, _ in cells)
+    left = min(c for _, c in cells)
+    return {(r - top, c - left) for r, c in cells}
+
+
+def independent_oracle(grid):
+    red = _normalize(_component(grid, 2))
+    green = _normalize(_component(grid, 3))
+    height = max(max(r for r, _ in red), max(r for r, _ in green)) + 1
+    width = max(max(c for _, c in red), max(c for _, c in green)) + 1
+    xor = red ^ green
+    return [
+        [8 if (r, c) in xor else 0 for c in range(width)]
+        for r in range(height)
+    ]
+
+
+def _freeze(grid):
+    return tuple(tuple(row) for row in grid)
+
+
+def run_audit(*, per_band: int = 100) -> dict[str, Any]:
+    if type(per_band) is not int or per_band <= 0:
+        raise ValueError("per_band must be a positive integer")
+    gen = _load_generator()
+    official = canonical_pairs(TASK, root=ROOT)
+    canonical_profiles = {(len(pair["input"]), len(pair["input"][0])) for pair in official}
+    canonical_failures = []
+    for pair in official:
+        tag = f"v{pair['variant']}-{pair['split']}{pair['pair_index']}"
+        findings = gen.self_check(deepcopy(pair["input"]))
+        if findings:
+            canonical_failures.append({"pair": tag, "kind": "self_check", "detail": findings})
+        if independent_oracle(pair["input"]) != pair["output"]:
+            canonical_failures.append({"pair": tag, "kind": "oracle_mismatch"})
+
+    report: dict[str, Any] = {
+        "task_id": TASK,
+        "generator_version": getattr(gen, "VERSION", None),
+        "rule_hash": getattr(gen, "RULE_HASH", None),
+        "canonical_pairs": len(official),
+        "canonical_profiles": [list(item) for item in sorted(canonical_profiles)],
+        "canonical_failures": canonical_failures,
+        "bands": {},
+        "errors": [],
+    }
+    if canonical_failures:
+        report["errors"].append("canonical contract failure")
+
+    for band_index, band in enumerate(("easy", "medium", "hard")):
+        stats: dict[str, Any] = {
+            "draws": per_band,
+            "invalid": 0,
+            "oracle_mismatches": 0,
+            "exact_canonical_profiles": 0,
+            "distinct_inputs": 0,
+            "distinct_outputs": 0,
+            "axis_counts": {name: Counter() for name in gen.AXES},
+            "schedule_counts": Counter(),
+            "rival_disagreements": Counter(),
+        }
+        inputs = set()
+        outputs = set()
+        for index in range(per_band):
+            seed = 620_000 + band_index * 10_000 + index
+            sample_index = 41_000 + index
+            try:
+                grid = gen.generate(seed, sample_index, difficulty=band)
+            except Exception as exc:
+                stats["invalid"] += 1
+                report["errors"].append(
+                    f"{band} generation crash at {index}: {type(exc).__name__}: {exc}"
+                )
+                continue
+            findings = gen.self_check(deepcopy(grid))
+            if findings:
+                stats["invalid"] += 1
+                report["errors"].append(f"{band} invalid draw {index}: {findings[0]}")
+                continue
+            expected = independent_oracle(grid)
+            if gen.rule_mirror(deepcopy(grid)) != expected:
+                stats["oracle_mismatches"] += 1
+                report["errors"].append(f"{band} oracle mismatch at {index}")
+            if (len(grid), len(grid[0])) in canonical_profiles:
+                stats["exact_canonical_profiles"] += 1
+            inputs.add(_freeze(grid))
+            outputs.add(_freeze(expected))
+            for name, value in gen.observe_overrides(grid).items():
+                stats["axis_counts"][name][str(value)] += 1
+            stats["schedule_counts"][gen.schedule_profile(seed, sample_index, band)] += 1
+            for name, rival in gen.SEMANTIC_RIVALS.items():
+                if rival(deepcopy(grid)) != expected:
+                    stats["rival_disagreements"][name] += 1
+        stats["distinct_inputs"] = len(inputs)
+        stats["distinct_outputs"] = len(outputs)
+        stats["axis_counts"] = {
+            name: dict(sorted(values.items())) for name, values in stats["axis_counts"].items()
+        }
+        stats["schedule_counts"] = dict(sorted(stats["schedule_counts"].items()))
+        stats["rival_disagreements"] = dict(sorted(stats["rival_disagreements"].items()))
+        report["bands"][band] = stats
+        if stats["invalid"]:
+            report["errors"].append(f"{band}: {stats['invalid']} invalid draw(s)")
+        if stats["oracle_mismatches"]:
+            report["errors"].append(f"{band}: {stats['oracle_mismatches']} oracle mismatch(es)")
+        if not stats["exact_canonical_profiles"]:
+            report["errors"].append(f"{band}: no exact canonical-profile support")
+        for name in gen.SEMANTIC_RIVALS:
+            if stats["rival_disagreements"].get(name, 0) != per_band:
+                report["errors"].append(
+                    f"{band}: rival {name} disagreed on "
+                    f"{stats['rival_disagreements'].get(name, 0)}/{per_band} draws"
+                )
+    report["errors"] = list(dict.fromkeys(report["errors"]))
+    return report
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--per-band", type=int, default=100)
+    parser.add_argument("--json-out", type=Path)
+    args = parser.parse_args(argv)
+    report = run_audit(per_band=args.per_band)
+    text = json.dumps(report, indent=2, sort_keys=True)
+    if args.json_out:
+        args.json_out.parent.mkdir(parents=True, exist_ok=True)
+        args.json_out.write_text(text + "\n", encoding="utf-8")
+    print(text)
+    return 1 if report["errors"] else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
