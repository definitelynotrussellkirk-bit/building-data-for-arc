+"""Regression contract for normalized-support XOR task 3cdfed241796.
+
+The canonical Racket program remains the label authority.  Expected outputs in
+this suite come from an independent translation-normalize/XOR oracle rather than
+from the generator's production mirror.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import random
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root
+
+TASK = "3cdfed241796"
+HOME = Path(__file__).resolve().parents[1]
+ROOT = find_root(__file__)
+
+
+def _load_generator():
+    path = Path(os.environ.get("GENERATOR_UNDER_TEST", HOME / "generator.py"))
+    spec = importlib.util.spec_from_file_location("reviewed_3cdfed241796", path)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+gen = _load_generator()
+CARD = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _component(grid, color):
+    cells = {
+        (r, c)
+        for r, row in enumerate(grid)
+        for c, value in enumerate(row)
+        if value == color
+    }
+    assert cells
+    start = min(cells)
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in CARD:
+            point = (r + dr, c + dc)
+            if point in cells and point not in seen:
+                seen.add(point)
+                stack.append(point)
+    assert seen == cells
+    return seen
+
+
+def _normalize(cells):
+    top = min(r for r, _ in cells)
+    left = min(c for _, c in cells)
+    return {(r - top, c - left) for r, c in cells}
+
+
+def oracle(grid):
+    red = _normalize(_component(grid, 2))
+    green = _normalize(_component(grid, 3))
+    height = max(max(r for r, _ in red), max(r for r, _ in green)) + 1
+    width = max(max(c for _, c in red), max(c for _, c in green)) + 1
+    xor = red ^ green
+    return [
+        [8 if (r, c) in xor else 0 for c in range(width)]
+        for r in range(height)
+    ]
+
+
+def _freeze(grid):
+    return tuple(tuple(row) for row in grid)
+
+
+def _profile(grid):
+    return len(grid), len(grid[0])
+
+
+def _color_left_edge(grid, color):
+    return min(c for row in grid for c, value in enumerate(row) if value == color)
+
+
+@pytest.mark.parametrize(
+    "pair",
+    canonical_pairs(TASK, root=ROOT),
+    ids=lambda p: f"v{p['variant']}-{p['split']}{p['pair_index']}",
+)
+def test_canonical_inputs_are_owned_and_independent_oracle_matches(pair):
+    assert gen.self_check(pair["input"]) == []
+    assert oracle(pair["input"]) == pair["output"]
+
+
+def test_rule_hash_is_pinned_to_selected_authority():
+    assert gen.RULE_HASH == "9383a670d8c7"
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+@pytest.mark.parametrize(
+    "options",
+    [
+        {"grid_h": 4, "grid_w": 9, "shape_size": 4},
+        {"grid_h": 6, "grid_w": 12, "shape_size": 5},
+        {"grid_h": 10, "grid_w": 18, "shape_size": 6},
+        {"grid_h": 18, "grid_w": 24, "shape_size": 8},
+    ],
+)
+def test_every_advertised_override_is_exact_and_observable(band, options):
+    grid = gen.generate(317, 29, difficulty=band, **options)
+    assert gen.self_check(grid) == []
+    assert gen.observe_overrides(grid) == options
+    assert gen.rule_mirror(grid) == oracle(grid)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"typo": 1},
+        {"grid_h": True},
+        {"grid_h": 3},
+        {"grid_h": 19},
+        {"grid_w": 8},
+        {"grid_w": 25},
+        {"shape_size": 2},
+        {"shape_size": 9},
+        {"shape_size": 4.0},
+        {"shape_size": "4"},
+    ],
+)
+def test_invalid_overrides_fail_loudly(kwargs):
+    with pytest.raises((TypeError, ValueError)):
+        gen.generate(0, 0, **kwargs)
+
+
+def test_invalid_difficulty_fails_loudly():
+    with pytest.raises(ValueError):
+        gen.generate(0, 0, difficulty="extreme")
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_default_distribution_is_deterministic_lawful_and_canonically_anchored(band):
+    canonical_profiles = {
+        _profile(pair["input"]) for pair in canonical_pairs(TASK, root=ROOT)
+    }
+    inputs = set()
+    outputs = set()
+    sizes = set()
+    role_orders = set()
+    exact_profile_hits = 0
+    for index in range(100):
+        seed = 20_000 + index
+        grid = gen.generate(seed, index, difficulty=band)
+        assert grid == gen.generate(seed, index, difficulty=band)
+        assert gen.self_check(grid) == []
+        assert gen.strict_canonical_like(grid) == []
+        expected = oracle(grid)
+        assert gen.rule_mirror(grid) == expected
+        assert expected != grid
+        values = gen.observe_overrides(grid)
+        sizes.add(values["shape_size"])
+        role_orders.add(_color_left_edge(grid, 2) < _color_left_edge(grid, 3))
+        exact_profile_hits += _profile(grid) in canonical_profiles
+        inputs.add(_freeze(grid))
+        outputs.add(_freeze(expected))
+    assert exact_profile_hits >= 20
+    assert len(inputs) >= 80
+    assert len(outputs) >= 60
+    assert len(sizes) >= 4
+    assert role_orders == {False, True}
+
+
+def test_named_rivals_have_constructive_counterexample():
+    grid = gen.generate(91, 2, difficulty="medium", grid_h=6, grid_w=12, shape_size=6)
+    expected = oracle(grid)
+    assert gen.SEMANTIC_WITNESSES["normalized_overlap"](grid)
+    assert gen.SEMANTIC_WITNESSES["uncropped_xor_extent"](grid)
+    assert gen.SEMANTIC_WITNESSES["absolute_positions_irrelevant"](grid)
+    for name, rival in gen.SEMANTIC_RIVALS.items():
+        assert rival(deepcopy(grid)) != expected, name
+
+
+@pytest.mark.parametrize("band", ["easy", "medium", "hard"])
+def test_every_four_consecutive_schedule_examples_identify_rule_under_all_query_rotations(band):
+    assert len(gen.SCHEDULE_PROFILES) == gen.EXAMPLES_NEEDED == 4
+    for start in range(12):
+        pairs = []
+        profiles = []
+        for offset in range(4):
+            index = start + offset
+            grid = gen.generate(80_000 + start, index, difficulty=band)
+            pairs.append({"input": grid, "output": oracle(grid)})
+            profiles.append(gen.schedule_profile(80_000 + start, index, band))
+        assert set(profiles) == set(gen.SCHEDULE_PROFILES)
+        for query_index in range(4):
+            demos = [pair for i, pair in enumerate(pairs) if i != query_index]
+            assert gen.lesson_identifiable(demos, pairs[query_index]) == []
+
+
+def test_self_check_rejects_malformed_missing_disconnected_equal_and_oversized_cases():
+    valid = gen.generate(88, 4)
+
+    disconnected = deepcopy(valid)
+    red = sorted((r, c) for r, row in enumerate(disconnected) for c, v in enumerate(row) if v == 2)
+    disconnected[red[0][0]][red[0][1]] = 0
+    disconnected[0][-1] = 2
+    assert gen.self_check(disconnected)
+
+    equal = [[0] * 9 for _ in range(4)]
+    for r, c in ((0, 0), (1, 0), (1, 1), (2, 1)):
+        equal[r][c] = 2
+        equal[r][c + 5] = 3
+    assert gen.self_check(equal)
+
+    oversized = [[0] * 12 for _ in range(6)]
+    for c in range(5):
+        oversized[0][c] = 2
+        oversized[3][c + 6] = 3
+    assert gen.self_check(oversized)
+
+    for malformed in (None, [], [[]], [[0], [0, 1]], [[True, 0]], [[0, 10]]):
+        assert gen.self_check(malformed)
+
+
+def test_generation_does_not_mutate_global_random_state():
+    random.seed(418)
+    before = random.getstate()
+    gen.generate(77, 12, difficulty="hard")
+    assert random.getstate() == before
+
+
+def test_workspace_audit_replays_core_contract():
+    path = HOME / "workspace" / "xor_audit.py"
+    spec = importlib.util.spec_from_file_location("xor_audit", path)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    report = module.run_audit(per_band=12)
+    assert report["canonical_pairs"] == 3
+    assert report["canonical_failures"] == []
+    assert report["errors"] == []
+    for stats in report["bands"].values():
+        assert stats["invalid"] == 0
+        assert stats["oracle_mismatches"] == 0
+        assert stats["exact_canonical_profiles"] > 0
+        assert all(value == stats["draws"] for value in stats["rival_disagreements"].values())
+
+
+def test_retained_counterexample_is_source_bound_and_authoritative():
+    home = HOME / "counterexamples" / "normalized-xor-shortcuts"
+    metadata = json.loads((home / "metadata.json").read_text())
+    grid = json.loads((home / "input.json").read_text())
+    expected = json.loads((home / "python-oracle.json").read_text())
+    cropped = json.loads((home / "cropped-xor-rival.json").read_text())
+    racket = json.loads((home / "racket.json").read_text())
+    assert metadata["generator_sha256"] == hashlib.sha256((HOME / "generator.py").read_bytes()).hexdigest()
+    assert metadata["rule_hash"] == gen.RULE_HASH == racket["executed_rule_hash"]
+    assert gen.self_check(grid) == []
+    assert oracle(grid) == expected
+    assert racket["results"][0]["output"] == expected
+    assert cropped != expected
+    assert metadata["difference_cells"]
