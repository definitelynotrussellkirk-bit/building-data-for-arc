+#!/usr/bin/env python3
+"""Regenerate the retained normalized-XOR shortcut counterexample."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+HOME = HERE.parents[1]
+
+spec = importlib.util.spec_from_file_location("counterexample_generator", HOME / "generator.py")
+gen = importlib.util.module_from_spec(spec)
+assert spec.loader is not None
+spec.loader.exec_module(gen)
+
+overrides = {"grid_h": 6, "grid_w": 12, "shape_size": 6}
+grid = gen.generate(91, 2, difficulty="medium", **overrides)
+expected = gen.rule_mirror(grid)
+rival = gen.SEMANTIC_RIVALS["crop_xor_again"](grid)
+assert gen.self_check(grid) == []
+assert expected != rival
+
+for name, value in (
+    ("input.json", grid),
+    ("python-oracle.json", expected),
+    ("cropped-xor-rival.json", rival),
+):
+    (HERE / name).write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
+
+metadata = {
+    "task_id": gen.TASK_ID,
+    "generator_version": gen.VERSION,
+    "generator_sha256": hashlib.sha256((HOME / "generator.py").read_bytes()).hexdigest(),
+    "rule_hash": gen.RULE_HASH,
+    "seed": 91,
+    "sample_index": 2,
+    "difficulty": "medium",
+    "overrides": overrides,
+    "self_check": [],
+    "witnesses": [
+        name for name, witness in gen.SEMANTIC_WITNESSES.items() if witness(grid)
+    ],
+    "rival": "crop_xor_again",
+    "difference_cells": [],
+    "generation_command": [
+        "env", "PYTHONPATH=shared/runtime", "python3",
+        "generators/3cdfed241796/counterexamples/normalized-xor-shortcuts/build.py",
+    ],
+    "racket_command": [
+        "python3", "review.py", "run", "python3", "-m", "arcpuzzles", "apply",
+        "3cdfed241796", "--input",
+        "generators/3cdfed241796/counterexamples/normalized-xor-shortcuts/input.json",
+        "--out",
+        "generators/3cdfed241796/counterexamples/normalized-xor-shortcuts/racket.json",
+    ],
+}
+# Outputs have different shapes, so retain a coordinate-wise union diff.
+height = max(len(expected), len(rival))
+width = max(max(map(len, expected), default=0), max(map(len, rival), default=0))
+for row in range(height):
+    for col in range(width):
+        a = expected[row][col] if row < len(expected) and col < len(expected[row]) else None
+        b = rival[row][col] if row < len(rival) and col < len(rival[row]) else None
+        if a != b:
+            metadata["difference_cells"].append([row, col, a, b])
+(HERE / "metadata.json").write_text(
+    json.dumps(metadata, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+)
