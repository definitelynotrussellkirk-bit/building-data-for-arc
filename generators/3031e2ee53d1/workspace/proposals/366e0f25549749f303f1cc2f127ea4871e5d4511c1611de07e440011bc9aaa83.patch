+"""Bounded source-bound peer audit: one rival, four canonical grids, one bridge."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / "shared/runtime"))
+from reviewer_support import load_selected_generator
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+TASK = "9e11fddfa38a"
+EXPECTED_SOURCE = "ee0cb2856c5099e019a13201318e91bb7b4224229a6a43784ef184432b198c3e"
+EXPECTED_RULE = "9810d4796757ce9e930ae2469bbb6b782355d854029d3961577a7cc12a1702ed"
+EXPECTED_CALLABLE = "67183b3344922d8cf5fec622a78c68304bab50a854e9bc042377efe77bb9d60d"
+
+
+def sha(value):
+    return hashlib.sha256(json.dumps(value, separators=(",", ":")).encode()).hexdigest()
+
+
+def rival(grid):
+    """Echo into empty destinations while preserving occupied originals."""
+    n = len(grid)
+    out = [row[:] for row in grid]
+    for r, row in enumerate(grid):
+        for c, value in enumerate(row):
+            mr, mc = n - 1 - c, n - 1 - r
+            if value and grid[mr][mc] == 0:
+                out[mr][mc] = value
+    return out
+
+
+def main():
+    module, source, source_sha = load_selected_generator(TASK, root=REPO)
+    assert source_sha == EXPECTED_SOURCE, "Selected source changed; review must be rebound"
+    rows = [json.loads(line) for line in (REPO / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()
+            if line.strip() and json.loads(line).get("task_id") == TASK]
+    assert len(rows) == 1
+    canonical = rows[0]
+    rule = canonical["program_solution"]
+    rule_sha = hashlib.sha256(rule.encode()).hexdigest()
+    assert rule_sha == EXPECTED_RULE, "Canonical rule changed; review must be rebound"
+    callable_rule = wrap_rule(rule)
+    callable_sha = hashlib.sha256(callable_rule.encode()).hexdigest()
+    assert callable_sha == EXPECTED_CALLABLE
+    bridge = RacketBridge(timeout=15)
+    try:
+        identity = bridge.runtime_identity
+        assert identity["protected"] is True
+        bridge.eval_text(f"(define peer_rule {callable_rule})")
+        native = []
+        for pair in canonical["train"] + canonical["test"]:
+            bridge.define_grid("peer_input", pair["input"])
+            native.append(bridge.eval_text("(peer_rule peer_input)"))
+    finally:
+        bridge.shutdown()
+    pairs = canonical["train"] + canonical["test"]
+    assert all(output == pair["output"] for pair, output in zip(pairs, native, strict=True))
+    train_fit = [rival(pair["input"]) == output for pair, output in zip(canonical["train"], native[:3], strict=True)]
+    query = canonical["test"][0]["input"]
+    predicted = rival(query)
+    differences = [{"position": [r, c], "native": native[-1][r][c], "rival": predicted[r][c]}
+                   for r in range(len(query)) for c in range(len(query)) if native[-1][r][c] != predicted[r][c]]
+    errors = module.self_check(query)
+    assert train_fit == [True, True, True] and len(differences) == 2 and errors
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == source_sha
+    home = REPO / "generators" / TASK
+    evidence_path = home / "counterexamples/peer-review-current.json"
+    evidence = {
+        "schema": "arcpuzzles-bounded-peer-witness-v1", "task_id": TASK,
+        "status": "unresolved_reproduced", "generator_sha256": source_sha,
+        "canonical_program_text_sha256": rule_sha, "wrapped_callable_sha256": callable_sha, "canonical_rule": rule,
+        "runtime": identity, "native_inputs_executed": 4,
+        "native_matches_all_canonical_labels": True,
+        "rival_name": "echo_only_into_empty_destinations_preserve_occupied",
+        "rival_demonstration_fit": train_fit, "query_input_sha256": sha(query),
+        "query_input": query, "native_query_output": native[-1],
+        "rival_query_output": predicted, "differing_cells": differences,
+        "canonical_query_self_check_errors": errors,
+        "source_changed": False, "approval_changed": False,
+        "scope": "One prior rival, all three canonical demonstrations and one canonical query; no population draw or battery."
+    }
+    evidence_path.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n")
+    report = {
+        "schema": "arcpuzzles-bounded-peer-review-v1", "task_id": TASK,
+        "status": "unresolved_reproduced", "authority": "proposal_requires_owner_checked_integration",
+        "summary": "Existing source-bound collision teaching gap confirmed: preserve-occupied rival fits 3/3 canonical demonstrations and differs on the query in exactly two cells; self_check rejects the authoritative query.",
+        "generator_sha256": source_sha, "canonical_program_text_sha256": rule_sha, "wrapped_callable_sha256": callable_sha,
+        "rule_hash_from_retained_receipt": "e248d283a2c2",
+        "retained_audit_reused": "review-54c3cb91af6294c0:v0001",
+        "fresh_verification": {"protected_racket": True, "canonical_inputs": 4, "native_matches_canonical": 4, "rival_train_fit": 3, "query_difference_count": 2},
+        "evidence_path": str(evidence_path.relative_to(REPO.parent)),
+        "evidence_sha256": hashlib.sha256(evidence_path.read_bytes()).hexdigest(),
+        "probe_path": str(Path(__file__).resolve().relative_to(REPO.parent)),
+        "production_source_changed": False, "approval_changed": False,
+        "recommendation": "Owner follow-up: accept canonical collision cases and teach distinct-color occupied reflection pairs with native overlay replacement labels; do not close the existing audit without a source repair and executable evidence.",
+        "command": "WORK/.venv/bin/python review.py run --receipt checks/peer-9e11fddfa38a/replay-command.json python3 generators/9e11fddfa38a/workspace/peer_probe.py",
+        "initial_probe_limit": "command.json records a failed assertion before bridge creation: the retained rule_text_sha256 field is the wrapped callable hash, not the raw canonical text hash. This probe now binds both separately.",
+        "limits": ["No generator repair, approval, or audit-index disposition change.", "Only one retained plausible rival tested; no universal identifiability claim.", "No population draws, batteries, or parametric qualification.", "Extracted packet contains no .git repository; pre-edit git status reported that limitation."]
+    }
+    out = REPO.parent / "checks/peer-9e11fddfa38a/report.json"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(report["fresh_verification"], sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
