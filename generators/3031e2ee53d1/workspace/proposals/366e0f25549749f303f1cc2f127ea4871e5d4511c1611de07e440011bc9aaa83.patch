+"""Bounded replay of the retained first-match teaching gap; no source repair."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+TASK = "99e7ba062bec"
+REPO = Path(__file__).resolve().parents[3]
+HOME = REPO / "generators" / TASK
+OUT = REPO.parent / "checks" / f"peer-{TASK}"
+SOURCE = HOME / "generator.py"
+PRIOR = "review-e409b7532b6dbf2c:v0001"
+
+
+def save(name, value):
+    (OUT / name).write_text(json.dumps(value, indent=2) + "\n")
+
+
+def normalize(grid):
+    return [[int(value) for value in row] for row in grid]
+
+
+def main():
+    OUT.mkdir(parents=True, exist_ok=True)
+    spec = importlib.util.spec_from_file_location(f"peer_{TASK}", SOURCE)
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    source_sha = hashlib.sha256(SOURCE.read_bytes()).hexdigest()
+    index = json.loads((HOME / "evidence/review_index.json").read_text())
+    prior = next(audit for audit in index["audits"] if audit["return_id"] == PRIOR)
+    assert source_sha == prior["source_sha256"], "Prior audit is not for these bytes"
+    with (REPO / "shared/data/canonical/puzzles.jsonl").open() as stream:
+        row = next(item for line in stream if (item := json.loads(line))["task_id"] == TASK)
+
+    grids = [generator.generate(0, i, difficulty="medium") for i in range(6)]
+    counter = normalize(row["train"][2]["input"])
+    grids.append(counter)
+    analyses = [generator._analyze(grid) for grid in grids]
+    assert all(not analysis["errors"] for analysis in analyses)
+    expected = [generator.rule_mirror(grid) for grid in grids]
+    rival = [generator._apply_grid(a["facts"]["c"], a["facts"]["matches"][-1]) for a in analyses]
+    assert all(rival[i] == expected[i] for i in range(6))
+    assert expected[-1] == normalize(row["train"][2]["output"])
+    assert rival[-1] != expected[-1]
+    save("inputs.json", {"inputs": grids})
+    argv = [sys.executable, "-m", "arcpuzzles", "apply", TASK, "--input",
+            str(OUT / "inputs.json"), "--reference", "canonical", "--timeout", "90",
+            "--out", str(OUT / "racket.json")]
+    completed = subprocess.run(argv, cwd=REPO, capture_output=True, text=True, timeout=110)
+    assert completed.returncode == 0, completed.stdout + completed.stderr
+    receipt = json.loads((OUT / "racket.json").read_text())
+    assert receipt["executed_rule_hash"] == generator.RULE_HASH
+    assert receipt["generator_sha256"] == source_sha
+    results = receipt["results"]
+    assert len(results) == len(grids)
+    assert all(r["valid_output"] and not r["error"] and r["output"] == y for r, y in zip(results, expected))
+    demos = [{"input": x, "output": y} for x, y in zip(grids[:5], expected[:5])]
+    ordinary_query = {"input": grids[5], "output": expected[5]}
+    counter_query = {"input": counter, "output": expected[-1]}
+    assert generator.lesson_identifiable(demos, ordinary_query) == []
+    report = {
+        "schema": "arc-bounded-peer-review-v1",
+        "task_id": TASK,
+        "status": "finding_reconfirmed",
+        "finding": "Ordinary generation does not teach authoritative first-match precedence",
+        "generator_sha256": source_sha,
+        "rule_hash": receipt["executed_rule_hash"],
+        "rule_text_sha256": hashlib.sha256(row["program_solution"].encode()).hexdigest(),
+        "prior_audit_reused": PRIOR,
+        "prior_audit_resolution_unchanged": prior["resolution"],
+        "visible_demonstrations": {"seed": 0, "difficulty": "medium", "sample_indices": list(range(5)),
+            "matching_codes": [list(a["facts"]["matches"]) for a in analyses[:5]],
+            "last_match_rival_fits": 5, "racket_labels_verified": 5},
+        "ordinary_query": {"sample_index": 5, "rival_fits": True,
+            "lesson_identifiable_reasons": []},
+        "counterexample_query": {"origin": "canonical train[2], reused as lawful challenge query",
+            "input_index_in_inputs_json": 6, "self_check_errors": generator.self_check(counter),
+            "matching_codes": list(analyses[-1]["facts"]["matches"]),
+            "racket_output": expected[-1], "last_match_rival_output": rival[-1],
+            "lesson_identifiable_reasons": generator.lesson_identifiable(demos, counter_query)},
+        "source_reason": "_shape_candidates requires seven distinct transform images and generate enforces this for A; every ordinary A->B has a unique match. LESSON_COMPETITORS lacks a last-match rival.",
+        "scope": "Curriculum support gap for lawful canonical ties; not an ordinary generated-query error. The full canonical visible training set already contains the tie witness and refutes this rival.",
+        "suggested_owner_action": "Retain the existing unresolved audit; evaluate scheduled tie witnesses with C distinguishing the first match, plus the last-match rival, before any checked integration.",
+        "production_changes": False,
+        "approval_changes": False,
+        "evidence": ["checks/peer-99e7ba062bec/inputs.json", "checks/peer-99e7ba062bec/racket.json",
+            "checks/peer-99e7ba062bec/command.json", "repo/generators/99e7ba062bec/workspace/peer_probe.py"],
+        "command": "WORK/.venv/bin/python review.py run --receipt checks/peer-99e7ba062bec/command.json python3 generators/99e7ba062bec/workspace/peer_probe.py",
+        "racket_command": argv,
+        "limits": ["One seed, one band, five demos and one ordinary query; one canonical tied query.",
+            "One protected-Racket apply call, seven inputs; no batteries or parametric work.",
+            "The prior 504-draw census was reused as reported history and was not rerun.",
+            "Finite named rival only; no comprehensive correctness claim. Optional peer work requires owner checked integration."]
+    }
+    save("report.json", report)
+    print(json.dumps({"status": report["status"], "source_sha256": source_sha,
+                      "racket_inputs_verified": len(results), "report": str(OUT / "report.json")}))
+
+
+if __name__ == "__main__":
+    main()
