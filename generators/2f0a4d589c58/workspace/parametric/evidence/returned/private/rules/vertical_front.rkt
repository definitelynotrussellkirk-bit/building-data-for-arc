(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((row-dom (map (lambda (r)
                                  (let ((nz (filter (lambda (v) (!= v 0))
                                                    (map (lambda (kc) (at g r kc))
                                                         (range 0 w)))))
                                    (and
                                      (> (length nz) (/ w 2))
                                      (mode (list (list 0) nz) 0))))
                                (range 0 h)))
                  (col-dom (map (lambda (c)
                                  (let ((nz (filter (lambda (v) (!= v 0))
                                                    (map (lambda (kr) (at g kr c))
                                                         (range 0 h)))))
                                    (and
                                      (> (length nz) (/ h 2))
                                      (mode (list (list 0) nz) 0))))
                                (range 0 w))))
             (cellmap g
                      (r c v)
                      (let ((v v)
                            (rd (nth row-dom r))
                            (cd (nth col-dom c)))
                        (if (and rd cd (!= rd cd)) cd v)))))))