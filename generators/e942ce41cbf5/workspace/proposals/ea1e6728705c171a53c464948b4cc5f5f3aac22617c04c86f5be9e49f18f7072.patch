+#!/usr/bin/env python3
+"""Protected-Racket probe for a greedy nearest-checkpoint lesson shortcut."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "df17e660cb8e"
+
+
+def greedy_order(generator, grid: list[list[int]]) -> list[int]:
+    positions = generator._marker_positions(grid)
+    remaining = {color for color in (4, 5, 6) if color in positions}
+    order: list[int] = []
+    current = 2
+    while remaining:
+        nxt = min(
+            remaining,
+            key=lambda color: (
+                abs(positions[color][0] - positions[current][0])
+                + abs(positions[color][1] - positions[current][1]),
+                color,
+            ),
+        )
+        order.append(nxt)
+        remaining.remove(nxt)
+        current = nxt
+    return [2, *order, 3]
+
+
+def greedy_nearest_rival(generator, grid: list[list[int]]) -> list[list[int]]:
+    cells, errors = generator._path_union(grid, greedy_order(generator, grid))
+    if errors:
+        return [row[:] for row in grid]
+    return generator._paint_cells(grid, cells)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.out.exists():
+        raise FileExistsError(args.out)
+
+    root = find_root(__file__)
+    generator, source, generator_sha = load_selected_generator(TASK_ID, root=root)
+    seed = 3
+    grids = [generator.generate(seed, index, difficulty="hard") for index in range(5)]
+    applied = Catalog(root).apply(
+        TASK_ID,
+        grids,
+        reference="canonical",
+        timeout=180,
+        check_generator_domain=True,
+    )
+    labels = [row["output"] for row in applied["results"]]
+    mirrors = [generator.rule_mirror(grid) for grid in grids]
+    rivals = [greedy_nearest_rival(generator, grid) for grid in grids]
+    intended_orders = [generator._visit_colors(grid) for grid in grids]
+    greedy_orders = [greedy_order(generator, grid) for grid in grids]
+    demo_fit = [rivals[index] == labels[index] for index in range(4)]
+    query_difference = sum(
+        left != right
+        for left_row, right_row in zip(rivals[4], labels[4])
+        for left, right in zip(left_row, right_row)
+    )
+    lesson = [
+        {"input": grids[index], "output": labels[index]}
+        for index in range(5)
+    ]
+    lesson_checker = generator.lesson_identifiable(lesson[:4], lesson[4])
+    assertions = {
+        "source_hash_matches_apply": applied["generator_sha256"] == generator_sha,
+        "rule_hash_matches_catalog": applied["rule_hash_matches_catalog"] is True,
+        "protected_outputs_valid": all(
+            row["valid_output"] and row["error"] is None for row in applied["results"]
+        ),
+        "racket_matches_python_mirror": labels == mirrors,
+        "all_inputs_pass_self_check": all(generator.self_check(grid) == [] for grid in grids),
+        "rival_fits_all_four_demonstrations": all(demo_fit),
+        "rival_changes_query": query_difference > 0,
+        "existing_lesson_checker_misses_rival": lesson_checker == [],
+        "query_order_reverses_checkpoints": intended_orders[4] != greedy_orders[4],
+    }
+    if not all(assertions.values()):
+        raise AssertionError(assertions)
+
+    report = {
+        "schema": "arcpuzzles-df17e660cb8e-nearest-checkpoint-shortcut-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "title": "Greedy nearest-checkpoint order survives four demos",
+        "generator_path": str(source.relative_to(root)),
+        "generator_sha256": generator_sha,
+        "executed_rule_hash": applied["executed_rule_hash"],
+        "rule_text_sha256": applied["rule_text_sha256"],
+        "racket": {"backend": "racket", "protected": True},
+        "seed": seed,
+        "difficulty": "hard",
+        "shortcut": (
+            "From the current marker, visit the remaining checkpoint with the "
+            "smallest Manhattan distance, breaking ties by numeric color."
+        ),
+        "why_it_survives": (
+            "For this ordinary four-demo window, the greedy order is exactly "
+            "2-4-5-6-3 in every demonstration. The query has only checkpoints "
+            "4 and 5, where greedy chooses 5 before 4."
+        ),
+        "repair": (
+            "Add the greedy-nearest executable competitor to LESSON_COMPETITORS, "
+            "or require a visible demonstration where greedy and numeric order differ."
+        ),
+        "demonstrations": [
+            {
+                "input": grids[index],
+                "output": labels[index],
+                "rival_output": rivals[index],
+                "intended_order": intended_orders[index],
+                "greedy_order": greedy_orders[index],
+                "orientation": generator.observe_overrides(grids[index])["orientation"],
+            }
+            for index in range(4)
+        ],
+        "query": {
+            "input": grids[4],
+            "output": labels[4],
+            "rival_output": rivals[4],
+            "intended_order": intended_orders[4],
+            "greedy_order": greedy_orders[4],
+            "different_cells": query_difference,
+            "orientation": generator.observe_overrides(grids[4])["orientation"],
+        },
+        "lesson_checker_findings": lesson_checker,
+        "assertions": assertions,
+        "limits": "One ordinary source-bound lesson; not a universal schedule census.",
+        "reproduction": (
+            "python3 review.py run python3 generators/df17e660cb8e/workspace/"
+            "probe_nearest_checkpoint_shortcut.py --out ../checks/df17e660cb8e/"
+            "nearest-checkpoint-shortcut.json"
+        ),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "out": str(args.out),
+                "demo_fit": demo_fit,
+                "query_different_cells": query_difference,
+                "intended_query_order": intended_orders[4],
+                "greedy_query_order": greedy_orders[4],
+                "generator_sha256": generator_sha,
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
