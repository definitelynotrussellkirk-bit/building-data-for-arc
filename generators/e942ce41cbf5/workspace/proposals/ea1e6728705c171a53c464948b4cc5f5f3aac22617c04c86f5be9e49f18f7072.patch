+#!/usr/bin/env python3
+"""Protected-Racket probe for a same-color-panel lesson shortcut.
+
+The current ordinary generator always chooses distinct nonzero colors for the
+two halves, while self_check accepts same-color halves.  The executable rival
+uses OR when panel colors differ but AND when they overlap in color space.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "d7068a5d39a2"
+
+
+def intended_or(grid: list[list[int]]) -> list[list[int]]:
+    half = len(grid[0]) // 2
+    return [
+        [6 if row[col] != 0 or row[col + half] != 0 else 0 for col in range(half)]
+        for row in grid
+    ]
+
+
+def same_color_and_rival(grid: list[list[int]]) -> list[list[int]]:
+    half = len(grid[0]) // 2
+    left_colors = {value for row in grid for value in row[:half] if value}
+    right_colors = {value for row in grid for value in row[half:] if value}
+    use_and = bool(left_colors & right_colors)
+    return [
+        [
+            6
+            if (
+                (row[col] != 0 and row[col + half] != 0)
+                if use_and
+                else (row[col] != 0 or row[col + half] != 0)
+            )
+            else 0
+            for col in range(half)
+        ]
+        for row in grid
+    ]
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.out.exists():
+        raise FileExistsError(args.out)
+
+    root = find_root(__file__)
+    generator, source, generator_sha = load_selected_generator(TASK_ID, root=root)
+    seed = 41
+    demos = [generator.generate(seed, index) for index in range(3)]
+    query = generator.generate(seed, 3)
+    half = len(query[0]) // 2
+    left_color = next(value for row in query for value in row[:half] if value)
+    query = [row[:] for row in query]
+    for row in query:
+        for col in range(half, 2 * half):
+            if row[col] != 0:
+                row[col] = left_color
+
+    grids = [*demos, query]
+    domain_errors = [generator.self_check(grid) for grid in grids]
+    applied = Catalog(root).apply(
+        TASK_ID,
+        grids,
+        reference="canonical",
+        timeout=180,
+        check_generator_domain=True,
+    )
+    labels = [row["output"] for row in applied["results"]]
+    intended = [intended_or(grid) for grid in grids]
+    rival = [same_color_and_rival(grid) for grid in grids]
+    demo_fit = [rival[index] == labels[index] for index in range(3)]
+    query_difference = sum(
+        left != right
+        for left_row, right_row in zip(rival[3], labels[3])
+        for left, right in zip(left_row, right_row)
+    )
+    query_left = {value for row in query for value in row[:half] if value}
+    query_right = {value for row in query for value in row[half:] if value}
+    assertions = {
+        "source_hash_matches_apply": applied["generator_sha256"] == generator_sha,
+        "rule_hash_matches_catalog": applied["rule_hash_matches_catalog"] is True,
+        "protected_outputs_valid": all(
+            row["valid_output"] and row["error"] is None for row in applied["results"]
+        ),
+        "all_inputs_pass_self_check": not any(domain_errors),
+        "racket_matches_independent_or": labels == intended,
+        "rival_fits_all_three_demonstrations": all(demo_fit),
+        "query_uses_same_nonzero_panel_color": query_left == query_right == {left_color},
+        "rival_changes_query": query_difference > 0,
+    }
+    if not all(assertions.values()):
+        raise AssertionError(assertions)
+
+    report = {
+        "schema": "arcpuzzles-d7068a5d39a2-same-color-shortcut-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "title": "Distinct panel colors hide a same-color OR-to-AND shortcut",
+        "generator_path": str(source.relative_to(root)),
+        "generator_sha256": generator_sha,
+        "executed_rule_hash": applied["executed_rule_hash"],
+        "rule_text_sha256": applied["rule_text_sha256"],
+        "racket": {"backend": "racket", "protected": True},
+        "seed": seed,
+        "shortcut": (
+            "Use support OR when the two panels use different nonzero colors, "
+            "but support AND when they share a nonzero color."
+        ),
+        "why_it_survives": (
+            "Ordinary generation always selects distinct left/right colors, so the "
+            "shortcut is exactly OR on every visible demonstration."
+        ),
+        "repair": (
+            "Admit same-color panels into ordinary lessons, or add this executable "
+            "competitor and reject a lesson until a same-color OR witness is visible."
+        ),
+        "demonstrations": [
+            {"input": grid, "output": labels[index], "rival_output": rival[index]}
+            for index, grid in enumerate(demos)
+        ],
+        "query": {
+            "input": query,
+            "output": labels[3],
+            "rival_output": rival[3],
+            "different_cells": query_difference,
+            "left_colors": sorted(query_left),
+            "right_colors": sorted(query_right),
+        },
+        "assertions": assertions,
+        "domain_errors": domain_errors,
+        "limits": "One source-bound lesson and one lawful hand mutation; not a universal census.",
+        "reproduction": (
+            "python3 review.py run python3 generators/d7068a5d39a2/workspace/"
+            "probe_same_color_shortcut.py --out ../checks/d7068a5d39a2/"
+            "same-color-shortcut.json"
+        ),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "out": str(args.out),
+                "demo_fit": demo_fit,
+                "query_different_cells": query_difference,
+                "generator_sha256": generator_sha,
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
