+
+@pytest.mark.parametrize("settings", [None, {}, {"reflection_policy": True},
+    {"reflection_policy": "bad"}, {"reflection_policy": "canonical", "extra": 1}])
+def test_invalid_settings_are_rejected(adapter, settings):
