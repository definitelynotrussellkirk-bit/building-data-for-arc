+"""Bounded, source-bound audit of the eight-neighbor connectivity shortcut.
+
+Reuse the existing task probe for the independent four-neighbor prefilter.
+Only a retained candidate is labelled with protected Racket. No production edit.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+TASK = "59ccf6f5cc65"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+PIN = "62a8a9d56464154cde31ec89c90fb10be582fbc55a70ab0bdaf3a8dea5acf83b"
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def eight_neighbor_rival(grid):
+    out = [row[:] for row in grid]
+    h, w = len(grid), len(grid[0])
+    pending = {(r, c) for r in range(h) for c in range(w) if grid[r][c] == 7}
+    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
+    while pending:
+        start = pending.pop()
+        component, stack = {start}, [start]
+        while stack:
+            r, c = stack.pop()
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    p = r + dr, c + dc
+                    if p in pending:
+                        pending.remove(p)
+                        component.add(p)
+                        stack.append(p)
+        if component & corners:
+            for r, c in component:
+                out[r][c] = 1
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    source = HERE.parent / "generator.py"
+    source_sha = hashlib.sha256(source.read_bytes()).hexdigest()
+    if source_sha != PIN:
+        raise ValueError("Audited source changed; this source-bound probe needs review")
+    old = load(HERE / "shortcut_probe.py", "_existing_corner_probe")
+    gen = old._load_generator()
+    canonical = next(json.loads(line) for line in
+                     (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()
+                     if json.loads(line).get("task_id") == TASK)
+    program = canonical["program_solution"]
+    # A fixed 16-lesson ceiling; the independent Python function is only a
+    # search prefilter, never the retained label authority.
+    checked, candidate = [], None
+    for seed in (0, 17, 91, 20261024):
+        for start in range(4):
+            grids = [gen.generate(seed, start + i, difficulty="easy") for i in range(4)]
+            prefilter = [eight_neighbor_rival(g) == old.independent_output(g) for g in grids]
+            checked.append({"seed": seed, "start": start, "fits_by_pair": prefilter})
+            if all(prefilter[:3]) and not prefilter[3]:
+                candidate = (seed, start, grids)
+                break
+        if candidate:
+            break
+    from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+    report = {
+        "schema": "arc-bounded-connectivity-review-v1", "task_id": TASK,
+        "generator_sha256": source_sha, "rule_hash": gen.RULE_HASH,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "prefilter_scope": {"ceiling_lessons": 16, "demos": 3, "queries": 1,
+                            "difficulty": "easy", "checked": checked},
+        "rival": "same-color orange components using eight-neighbor connectivity",
+        "existing_missing_period_still_present": not hasattr(gen, "LESSON_SCHEDULE_PERIOD"),
+        "status": "finite_no_counterexample" if candidate is None else "candidate",
+        "limits": "One extra rival, one difficulty, at most sixteen consecutive lessons; no battery or approval.",
+    }
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            assert identity["backend"] == "racket" and identity["protected"] is True
+            report["runtime_identity"] = identity
+            original = canonical["train"] + canonical["test"]
+            actual = [apply(program, pair["input"]) for pair in original]
+            assert all(label == pair["output"] for label, pair in zip(actual, original))
+            report["canonical_rival_fit"] = [eight_neighbor_rival(p["input"]) == y
+                                             for p, y in zip(original, actual)]
+            if candidate:
+                seed, start, grids = candidate
+                labels = [apply(program, g) for g in grids]
+                rivals = [eight_neighbor_rival(g) for g in grids]
+                fit = [a == b for a, b in zip(labels, rivals)]
+                assert fit == [True, True, True, False]
+                pairs = [{"input": g, "output": y, "rival_output": r}
+                         for g, y, r in zip(grids, labels, rivals)]
+                report.update(status="generated_lesson_ambiguity", seed=seed, start=start,
+                              demo_indices=list(range(start, start + 3)), query_index=start + 3,
+                              train=pairs[:3], test=pairs[3:], fits_by_pair=fit,
+                              self_check_errors=[gen.self_check(g) for g in grids],
+                              declared_hook_reasons=gen.lesson_identifiable(pairs[:3], pairs[3]),
+                              differing_query_cells=[[r, c, labels[3][r][c], rivals[3][r][c]]
+                                for r in range(len(grids[3])) for c in range(len(grids[3][0]))
+                                if labels[3][r][c] != rivals[3][r][c]])
+        finally:
+            bridge.close()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({k: report[k] for k in ("status", "generator_sha256", "canonical_rival_fit")}))
+    if candidate:
+        print(json.dumps({k: report[k] for k in ("seed", "start", "fits_by_pair", "differing_query_cells")}))
+
+
+if __name__ == "__main__":
+    main()
