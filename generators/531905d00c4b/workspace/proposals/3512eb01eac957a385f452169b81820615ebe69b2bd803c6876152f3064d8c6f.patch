+"""Bounded source-pinned probe of positional versus size-based packing ties."""
+from copy import deepcopy
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+TASK = "579f1e2dcb4a"
+PIN = "3a85cb419ae1fcb64d626cf6961405cbaf432ed757e67e2bdea3e373fe3b17bb"
+ROOT = Path(__file__).resolve().parents[3]
+sys.dont_write_bytecode = True
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
+
+
+def raw(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+def digest(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def run(out, seed=17):
+    from reviewer_support import load_selected_generator
+    from arcpuzzles.catalog import Catalog
+    from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+    out = Path(out)
+    if out.exists() or out.is_symlink():
+        raise FileExistsError("Use a new output folder")
+    gen, source, sha = load_selected_generator(TASK, root=ROOT)
+    if sha != PIN:
+        raise ValueError("Generator differs from the pinned review source")
+    catalog = Catalog(ROOT)
+    row = catalog.describe(TASK)
+    if row["rule_hash"] != "29c3632de610":
+        raise ValueError("Selected rule differs from the pinned authority")
+    programs = {v["program_solution"] for v in catalog._variants()[row.get("rule_task_id", TASK)]}
+    if len(programs) != 1:
+        raise ValueError("Expected one exact canonical program")
+    program = programs.pop()
+    old = "(e8b-list< (list (second ba) (first ba)) (list (second bb) (first bb)))"
+    if program.count(old) != 1:
+        raise ValueError("Expected one exact component comparator")
+    replacements = {
+        "same_left_larger_component_first":
+            "(e8b-list< (list (second ba) (- (length a))) (list (second bb) (- (length b))))",
+        "same_left_bottom_first":
+            "(e8b-list< (list (second ba) (- (first ba))) (list (second bb) (- (first bb))))",
+        "right_edge_then_top":
+            "(e8b-list< (list (fourth ba) (first ba)) (list (fourth bb) (first bb)))",
+    }
+    rivals = {name: program.replace(old, replacement, 1) for name, replacement in replacements.items()}
+    inputs = [gen.generate(seed, i, difficulty="medium") for i in range(8)]
+    if any(gen.self_check(g) for g in inputs):
+        raise ValueError("Generated input did not satisfy its current grammar")
+    authored = deepcopy(inputs[3])
+    components = gen._valid_components(authored)
+    tied = [item for item in components if len(item["colors"]) == 1]
+    large = next(item for item in tied if item["size"] == 3)
+    small = next(item for item in tied if item["size"] == 1)
+    color = next(iter(large["colors"]))
+    for item in tied:
+        for r, c in item["cells"]:
+            authored[r][c] = 0
+    for r, c in large["cells"]:
+        authored[r + 2][c] = color
+    for r, c in small["cells"]:
+        authored[r - 2][c] = color
+    grammar_errors = gen.self_check(authored)
+    if grammar_errors:
+        raise ValueError("Authored reversed-order query outside declared grammar: " + repr(grammar_errors))
+    cache = {}
+    evaluations = 0
+    with _local_imports(ROOT / "shared/runtime", source.parent):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        def execute(p, g):
+            nonlocal evaluations
+            key = (p, raw(g))
+            if key not in cache:
+                cache[key] = _grid(apply(p, deepcopy(g)))
+                evaluations += 1
+            return deepcopy(cache[key])
+        try:
+            labels = [execute(program, g) for g in inputs]
+            evaluated = {name: [execute(p, g) for g in inputs] for name, p in rivals.items()}
+            windows = []
+            for start in range(5):
+                tests = []
+                for name, outputs in evaluated.items():
+                    refuted = [i for i in range(start, start + 3) if outputs[i] != labels[i]]
+                    tests.append({"rival": name, "demo_refutations": refuted,
+                                  "query_differs": outputs[start + 3] != labels[start + 3],
+                                  "ambiguous": not refuted and outputs[start + 3] != labels[start + 3]})
+                windows.append({"demo_indices": list(range(start, start + 3)),
+                                "query_index": start + 3, "rivals": tests})
+            name = "same_left_larger_component_first"
+            truth, alternative = execute(program, authored), execute(rivals[name], authored)
+            if any(evaluated[name][i] != labels[i] for i in range(3)) or truth == alternative:
+                raise ValueError("Authored ambiguity hypothesis was not reproduced")
+        finally:
+            bridge.close()
+    if digest(source.read_bytes()) != PIN:
+        raise ValueError("Generator changed during probe")
+    binding = {"task_id": TASK, "generator_sha256": sha, "canonical_rule_hash": row["rule_hash"],
+               "canonical_program_sha256": digest(program.encode()),
+               "probe_sha256": digest(Path(__file__).read_bytes())}
+    witness = {"schema": "arcpuzzles-peer-teaching-witness-v1", **binding,
+               "seed": seed, "difficulty": "medium", "demo_indices": [0, 1, 2],
+               "train": [{"input": inputs[i], "output": labels[i]} for i in range(3)],
+               "original_generated_query": {"sample_index": 3, "input": inputs[3], "output": labels[3]},
+               "query": {"input": authored, "output": truth}, "rival_output": alternative,
+               "hypotheses": [{"name": "position_tie", "program": program},
+                              {"name": name, "program": rivals[name]}],
+               "authored_query_self_check": [],
+               "query_origin": "Authored: swap the same-left monochrome components' vertical order; not a generator draw.",
+               "racket": identity, "training_admitted": False}
+    report = {"schema": "arcpuzzles-peer-tie-order-audit-v1", **binding,
+              "status": "authored_grammar_ambiguity", "seed": seed, "difficulty": "medium",
+              "generated_inputs": 8, "generated_lesson_windows": windows,
+              "generated_ambiguities": sum(t["ambiguous"] for w in windows for t in w["rivals"]),
+              "racket": identity, "racket_evaluations": evaluations,
+              "rival_programs": rivals, "witness_sha256": digest(raw(witness)),
+              "finding": "Size-based tie ordering fits all eight checked generator draws. It fits the three "
+                         "visible demonstrations but changes an authored reversed-vertical-order query accepted by self_check.",
+              "limits": "One seed, medium difficulty, five overlapping lesson windows, three named rivals only. "
+                        "No ambiguity found on sampled generated queries; the counterexample is authored within the "
+                        "self_check grammar and is not claimed to be sampled by the production generator. "
+                        "No production repair, acceptance, training admission, or universal identifiability claim."}
+    out.mkdir(parents=True, exist_ok=False)
+    (out / "witness.json").write_bytes(raw(witness))
+    (out / "report.json").write_bytes(raw(report))
+    return report
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=17)
+    args = parser.parse_args()
+    result = run(args.out, args.seed)
+    print(json.dumps({key: result[key] for key in ("status", "generated_inputs", "generated_ambiguities", "racket_evaluations")}, sort_keys=True))
