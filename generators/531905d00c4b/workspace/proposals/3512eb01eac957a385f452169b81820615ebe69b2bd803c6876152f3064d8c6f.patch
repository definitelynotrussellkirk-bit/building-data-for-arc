+
+def test_prototype_geometry_varies_beyond_colors_and_reflections(adapter):
+    shapes = set()
+    for seed in range(12):
+        e = adapter.generate(seed, {"reflection_policy": "canonical"}, 2, 1)
+        parts = adapter.prototype.parse(e["train"][0]["input"])
