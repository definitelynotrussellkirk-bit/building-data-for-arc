+
+def test_public_bytes_ignore_private_fields_and_reject_boolean_cells(adapter):
+    from reviewer_support import public_challenge_bytes, public_challenge_id
+    import hashlib
+    e = adapter.generate(3, {"reflection_policy": "canonical"}, 3, 4)
