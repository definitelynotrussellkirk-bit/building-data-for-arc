+
+def test_large_query_is_real_30_by_30_input_and_output(adapter):
+    for policy in POLICIES:
+        pair = adapter.generate(0, {"reflection_policy": policy}, 3, 4)["test"][3]
+        assert (len(pair["input"]), len(pair["input"][0])) == (30, 30)
