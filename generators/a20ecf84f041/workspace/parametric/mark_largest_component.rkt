(rule! (let ((dummy 0))
  (define (full-row grid color)
    (let ((hits (filter (lambda (r) (all? (lambda (v) (= v color)) (row grid r)))
                        (range (rows grid)))))
      (if (empty? hits) #f (first hits))))
  (define (binary-op a b op)
    (grid-from-fn (rows a) (cols a)
      (lambda (r c)
        (let ((aa (not (= (at a r c) 0))) (bb (not (= (at b r c) 0))))
          (if (cond ((equal? op 'union) (or aa bb))
                    ((equal? op 'intersection) (and aa bb))
                    (else (not (equal? aa bb))))
              2 0)))))
  (define (paste-all out obj top left)
    (for*/fold ((acc out)) ((r (in-range (rows obj))) (c (in-range (cols obj))))
      (let ((v (at obj r c)) (rr (+ top r)) (cc (+ left c)))
        (if (and (not (= v 0)) (in-bounds? rr cc (rows acc) (cols acc)))
            (set-cell acc rr cc v) acc))))
  (let* ((sep-r (full-row g 9))
         (sep-cs (filter (lambda (c) (all? (lambda (r) (= (at g r c) 9))
                                            (range (rows g))))
                         (range (cols g)))))
    (if (or (not sep-r) (< (length sep-cs) 2)) g
        (let* ((c1 (first sep-cs)) (c2 (second sep-cs))
               (a (subgrid g 0 0 (- sep-r 1) (- c1 1)))
               (b (subgrid g 0 (+ c1 1) (- sep-r 1) (- c2 1)))
               (c (subgrid g 0 (+ c2 1) (- sep-r 1) (- (cols g) 1)))
               (d (subgrid g (+ sep-r 1) 0 (- (rows g) 1) (- c1 1)))
               (e (subgrid g (+ sep-r 1) (+ c1 1) (- (rows g) 1) (- c2 1)))
               (op (cond ((equal? (binary-op a b 'union) c) 'union)
                         ((equal? (binary-op a b 'intersection) c) 'intersection)
                         ((equal? (binary-op a b 'xor) c) 'xor)
                         (else 'union)))
               (stage (binary-op d e op))
               (pieces (objects stage 0))
               (winner (if (empty? pieces) #f (pick-max pieces obj-size)))
               (marked (if winner (recolor-cells stage (obj-cells winner) 8) stage)))
          (paste-all g marked (+ sep-r 1) (+ c2 1)))))))
