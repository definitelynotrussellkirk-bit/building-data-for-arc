diff --git a/repo/generators/8dd23f285c61/workspace/bounded_peer_probe.py b/repo/generators/8dd23f285c61/workspace/bounded_peer_probe.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/8dd23f285c61/workspace/bounded_peer_probe.py
@@ -0,0 +1,85 @@
+"""Two short lessons against five ray shortcuts; no approval mutation."""
+import argparse
+import copy
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+from reviewer_support import load_selected_generator
+
+HOME = Path(__file__).resolve().parents[1]
+ROOT = HOME.parents[1]
+TASK = HOME.name
+
+
+def partial_rays(grid, directions, first_only=False, ignore_walls=False):
+    out = copy.deepcopy(grid)
+    h, w = len(grid), len(grid[0])
+    seeds = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]
+    for sr, sc in seeds[:1] if first_only else seeds:
+        out[sr][sc] = 8
+        for dr, dc in directions:
+            r, c = sr + dr, sc + dc
+            while 0 <= r < h and 0 <= c < w:
+                if grid[r][c] == 5 and not ignore_walls:
+                    break
+                if grid[r][c] != 5:
+                    out[r][c] = 8
+                r, c = r + dr, c + dc
+    return out
+
+
+def run(output):
+    module, _, source_hash = load_selected_generator(TASK, root=ROOT)
+    spec = importlib.util.spec_from_file_location("_rays_independent_probe", HOME / "workspace/reference_probe.py")
+    probe = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(probe)
+    catalog = Catalog(ROOT)
+    programs = {r["program_solution"] for r in catalog._variants()[TASK]}
+    assert len(programs) == 1
+    program = programs.pop()
+    directions = ((-1, 0), (1, 0), (0, -1), (0, 1))
+    rivals = {
+        "ignore_tiny_walls": lambda g: probe.ray_output(g, ignore_tiny_walls=True),
+        "ignore_all_walls": lambda g: partial_rays(g, directions, ignore_walls=True),
+        "horizontal_only": lambda g: partial_rays(g, ((0, -1), (0, 1))),
+        "vertical_only": lambda g: partial_rays(g, ((-1, 0), (1, 0))),
+        "first_emitter_only": lambda g: partial_rays(g, directions, first_only=True),
+    }
+    apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+    lessons, findings = [], []
+    try:
+        for seed, difficulty in ((0, None), (17, "hard")):
+            inputs = [module.generate(seed, i, difficulty=difficulty) for i in range(7)]
+            pairs = [{"input": g, "output": apply(program, g)} for g in inputs]
+            assert all(p["output"] == probe.ray_output(p["input"]) for p in pairs)
+            checks = {}
+            for name, rival in rivals.items():
+                fits = all(rival(p["input"]) == p["output"] for p in pairs[:3])
+                disagreements = [i for i, p in enumerate(pairs[3:]) if rival(p["input"]) != p["output"]]
+                checks[name] = {"fits_demos": fits, "query_disagreements": disagreements}
+                if fits and disagreements:
+                    findings.append({"seed": seed, "rival": name, "query_indices": disagreements})
+            lessons.append({"seed": seed, "difficulty": difficulty, "train": pairs[:3],
+                            "test": pairs[3:], "rivals": checks})
+    finally:
+        bridge.close()
+    result = {"schema": "arcpuzzles-bounded-peer-probe-v1", "task_id": TASK,
+              "source_sha256": source_hash, "rule_hash": catalog.describe(TASK)["rule_hash"],
+              "program": program, "racket": identity, "verified_pair_labels": 14,
+              "lessons": lessons, "findings": findings,
+              "scope": "Two lessons; five Python diagnostic rivals; canonical labels executed through protected Racket. No universal identifiability or approval claim."}
+    output = Path(output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("x") as handle:
+        json.dump(result, handle, indent=2)
+        handle.write("\n")
+    print(json.dumps({"task_id": TASK, "verified_pair_labels": 14, "findings": findings}))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    run(parser.parse_args().out)
