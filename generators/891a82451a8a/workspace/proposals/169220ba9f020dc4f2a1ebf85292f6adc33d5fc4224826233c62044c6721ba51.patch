+"""Find and execute a bounded missing-gap-direction teaching counterexample."""
+import argparse
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+from reviewer_support import load_selected_generator
+
+HOME = Path(__file__).resolve().parents[1]
+ROOT = HOME.parents[1]
+TASK = HOME.name
+
+
+def run(output):
+    module, _, source_hash = load_selected_generator(TASK, root=ROOT)
+    catalog = Catalog(ROOT)
+    programs = {r["program_solution"] for r in catalog._variants()[TASK]}
+    assert len(programs) == 1
+    program = programs.pop()
+    assert program.count("(begin") == 1
+    examined = []
+    finding = None
+    for seed in (0, 17, 1, 2):
+        for difficulty in (None, "easy"):
+            inputs = [module.generate(seed, i, difficulty=difficulty) for i in range(7)]
+            pairs = [{"input": g, "output": module._apply_intended(g)} for g in inputs]
+            examined.append({"seed": seed, "difficulty": difficulty})
+            for side in ("up", "down", "left", "right"):
+                rival = lambda g: module._apply_intended(g, object_filter=lambda f: f["side"] != side)
+                if all(rival(p["input"]) == p["output"] for p in pairs[:3]):
+                    for index, query in enumerate(pairs[3:]):
+                        if rival(query["input"]) != query["output"]:
+                            finding = {"seed": seed, "difficulty": difficulty,
+                                       "sample_indices": {"train": [0, 1, 2], "query": index + 3},
+                                       "ignored_gap_side": side, "train": pairs[:3], "test": [query],
+                                       "rival_program": program.replace("(begin", f"(when (not (equal? open-dir '{side}))")}
+                            break
+                if finding:
+                    break
+            if finding:
+                break
+        if finding:
+            break
+    apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+    evaluations = 0
+    try:
+        if finding:
+            predictions = []
+            for p in finding["train"] + finding["test"]:
+                assert not module.self_check(p["input"])
+                assert apply(program, p["input"]) == p["output"]
+                predictions.append(apply(finding["rival_program"], p["input"]))
+                evaluations += 2
+            assert predictions[:3] == [p["output"] for p in finding["train"]]
+            assert predictions[3] != finding["test"][0]["output"]
+            finding["rival_query_output"] = predictions[3]
+            finding["existing_lesson_hook"] = module.lesson_identifiable(finding["train"], finding["test"][0])
+        else:
+            for p in pairs:
+                assert apply(program, p["input"]) == p["output"]
+                evaluations += 1
+    finally:
+        bridge.close()
+    result = {"schema": "arcpuzzles-bounded-peer-probe-v1", "task_id": TASK,
+              "source_sha256": source_hash, "rule_hash": catalog.describe(TASK)["rule_hash"],
+              "program": program, "racket": identity, "racket_evaluations": evaluations,
+              "lessons_examined": examined, "finding": finding,
+              "proposed_repair": "Select/strengthen demos to cover gap directions required by queries, or reject unsupported query directions; include omission rivals in the demo-only teaching check.",
+              "status": "verified_finding_proposed_repair" if finding else "bounded_no_finding",
+              "limits": "One bounded peer review. No production patch, audit resolution, approval change or training admission."}
+    output = Path(output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("x") as handle:
+        json.dump(result, handle, indent=2)
+        handle.write("\n")
+    print(json.dumps({"task_id": TASK, "status": result["status"], "lessons_examined": examined,
+                      "finding": {k: finding[k] for k in ("seed", "difficulty", "sample_indices", "ignored_gap_side")} if finding else None,
+                      "racket_evaluations": evaluations}))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    run(parser.parse_args().out)
