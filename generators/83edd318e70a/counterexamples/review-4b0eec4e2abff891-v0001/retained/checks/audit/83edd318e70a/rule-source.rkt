(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g))
                (tmpl (subgrid g 0 0 2 2))
                (positions (filter (lambda (rc)
                                     (and
                                       (<= (first rc) (- h 3))
                                       (<= (second rc) (- w 3))))
                                   (grid-positions g)))
                (hits (filter (lambda (rc)
                                (let ((i (first rc))
                                      (j (second rc)))
                                  (and
                                    (not (and (= i 0) (= j 0)))
                                    (equal? (subgrid g i j (+ i 2) (+ j 2)) tmpl))))
                              positions))
                (hit (first hits))
                (cr (+ (first hit) 1))
                (cc (+ (second hit) 1))
                (offs (filter (lambda (d) (= 2 (max (abs (first d)) (abs (second d)))))
                              (for*/list ((dr (range -2 3)) (dc (range -2 3)))
                                (list dr dc)))))
           (reduce (lambda (acc d) (set-cell acc (+ cr (first d)) (+ cc (second d)) 5))
                   g
                   offs))))
