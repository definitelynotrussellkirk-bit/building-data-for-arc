+"""Protected-Racket audit of odd-pair lessons against length-extreme shortcuts."""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+from reviewer_support import find_root
+
+TASK_ID = "76c3f9d7128a"
+HERE = Path(__file__).resolve().parent
+HOME = HERE.parents[1]
+ROOT = find_root(__file__)
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical() -> str:
+    record = Catalog(ROOT).get(TASK_ID)
+    programs = {
+        variant["program_solution"]
+        for variant in record["variants"]
+        if isinstance(variant.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise AssertionError(f"expected one selected program, got {len(programs)}")
+    return next(iter(programs))
+
+
+def _rivals(canonical: str) -> dict[str, str]:
+    old = "(define odd (first (filter (lambda (entry) (= (count-where (lambda (other) (equal? (sig other) (sig entry))) pairs) 1)) pairs)))"
+    if canonical.count(old) != 1:
+        raise AssertionError("canonical odd-selector fragment changed")
+    return {
+        "longest_pair": canonical.replace(
+            old, "(define odd (pick-max pairs (lambda (entry) (second (sig entry)))))"
+        ),
+        "shortest_pair": canonical.replace(
+            old, "(define odd (pick-min pairs (lambda (entry) (second (sig entry)))))"
+        ),
+    }
+
+
+def _signatures(grid: list[list[int]]) -> list[tuple[int, int]]:
+    positions: dict[int, list[tuple[int, int]]] = {}
+    order: list[int] = []
+    for row, values in enumerate(grid):
+        for col, color in enumerate(values):
+            if color in (0, 8):
+                continue
+            if color not in positions:
+                positions[color] = []
+                order.append(color)
+            positions[color].append((row, col))
+    result = []
+    for color in order:
+        cells = positions[color]
+        if len(cells) != 2:
+            raise AssertionError(f"color {color} has {len(cells)} cells")
+        (r1, c1), (r2, c2) = cells
+        orientation = 0 if r1 == r2 else 1 if c1 == c2 else 2
+        length = max(abs(r2 - r1), abs(c2 - c1)) + 1
+        result.append((orientation, length))
+    return result
+
+
+def _relation(grid: list[list[int]]) -> str:
+    signatures = _signatures(grid)
+    counts = Counter(signatures)
+    odd = [signature for signature in signatures if counts[signature] == 1]
+    repeated = [signature for signature in signatures if counts[signature] > 1]
+    if len(odd) != 1 or not repeated:
+        raise AssertionError(f"expected one odd and a repeated signature: {signatures}")
+    if odd[0][1] == repeated[0][1]:
+        return "equal_length"
+    return "odd_shorter" if odd[0][1] < repeated[0][1] else "odd_longer"
+
+
+def run(out: Path) -> int:
+    current_path = HOME / "generator.py"
+    before_path = HERE / "generator_before_2.2.2.py"
+    current = _load(current_path, "_peer_current_76c3f9d7128a")
+    before = _load(before_path, "_peer_before_76c3f9d7128a")
+    canonical = _canonical()
+    rivals = _rivals(canonical)
+    apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+    evaluations = 0
+
+    def execute(program: str, grid: list[list[int]]) -> list[list[int]]:
+        nonlocal evaluations
+        evaluations += 1
+        value = apply(program, grid)
+        if not isinstance(value, list) or not value or not all(isinstance(row, list) for row in value):
+            raise AssertionError("Racket did not return a grid")
+        return value
+
+    try:
+        # Exact pre-repair lesson: the longest-pair rule fits demos 0,1,3 and
+        # disagrees on query 2, whose odd diagonal is shorter than the repeated pair.
+        old_inputs = [before.generate(0, index) for index in range(4)]
+        old_outputs = [execute(canonical, grid) for grid in old_inputs]
+        longest_outputs = [execute(rivals["longest_pair"], grid) for grid in old_inputs]
+        demo_indices = [0, 1, 3]
+        query_index = 2
+        if not all(longest_outputs[index] == old_outputs[index] for index in demo_indices):
+            raise AssertionError("pre-repair longest-pair rival does not fit the retained demos")
+        if longest_outputs[query_index] == old_outputs[query_index]:
+            raise AssertionError("pre-repair longest-pair rival does not change the retained query")
+        pre_repair = {
+            "seed": 0,
+            "sample_indices": [0, 1, 2, 3],
+            "demo_indices": demo_indices,
+            "query_index": query_index,
+            "relations": [_relation(grid) for grid in old_inputs],
+            "rival": "longest_pair",
+            "rival_program": rivals["longest_pair"],
+            "pairs": [
+                {"role": "query" if index == query_index else "demo",
+                 "input": grid, "canonical_output": output, "rival_output": rival}
+                for index, (grid, output, rival) in enumerate(
+                    zip(old_inputs, old_outputs, longest_outputs)
+                )
+            ],
+        }
+
+        lessons = []
+        survivors = []
+        for seed in (0, 1, 17):
+            for start in range(4):
+                inputs = [current.generate(seed, start + offset) for offset in range(4)]
+                outputs = [execute(canonical, grid) for grid in inputs]
+                relations = [_relation(grid) for grid in inputs]
+                if set(relations) != {"odd_shorter", "odd_longer"}:
+                    raise AssertionError(
+                        f"length-relation schedule failed at seed={seed}, start={start}: {relations}"
+                    )
+                predictions = {
+                    name: [execute(program, grid) for grid in inputs]
+                    for name, program in rivals.items()
+                }
+                rotations = []
+                for query_index in range(4):
+                    demos = [index for index in range(4) if index != query_index]
+                    rows = []
+                    for name, values in predictions.items():
+                        fits = all(values[index] == outputs[index] for index in demos)
+                        disagrees = values[query_index] != outputs[query_index]
+                        status = (
+                            "survives_demos_disagrees_query" if fits and disagrees
+                            else "fits_all_checked" if fits
+                            else "refuted_by_demo"
+                        )
+                        rows.append({"name": name, "status": status})
+                        if fits and disagrees:
+                            survivors.append({"seed": seed, "start": start,
+                                              "query_index": query_index, "rival": name})
+                    rotations.append({"query_index": query_index, "rivals": rows})
+                lessons.append({"seed": seed, "start": start,
+                                "relations": relations, "rotations": rotations})
+    finally:
+        bridge.close()
+
+    result = {
+        "schema": "arcpuzzles-bounded-peer-learnability-audit-v1",
+        "task_id": TASK_ID,
+        "status": "pass" if not survivors else "needs_repair",
+        "source_sha256": _sha(current_path),
+        "pre_repair_source_sha256": _sha(before_path),
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "racket": identity,
+        "protected_racket_evaluations": evaluations,
+        "pre_repair_witness": pre_repair,
+        "post_repair": {
+            "lessons": lessons,
+            "lessons_checked": len(lessons),
+            "query_rotations_checked": len(lessons) * 4,
+            "rivals": sorted(rivals),
+            "survivors": survivors,
+        },
+        "limits": "Finite longest/shortest rivals, three seeds, four starts and four query rotations only; not universal identifiability. Previously reported axis-contract findings remain outside this repair.",
+    }
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": result["status"],
+        "protected_racket_evaluations": evaluations,
+        "lessons_checked": len(lessons),
+        "query_rotations_checked": len(lessons) * 4,
+        "survivors": len(survivors),
+        "pre_repair_relations": pre_repair["relations"],
+    }, sort_keys=True))
+    return 0 if not survivors else 1
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    return run(parser.parse_args().out)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
