@@ -0,0 +1,65 @@
+"""Regression for longest/shortest odd-pair shortcuts."""
+from __future__ import annotations
+
+from collections import Counter
+import importlib.util
+from pathlib import Path
+
+HOME = Path(__file__).resolve().parents[1]
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(
+        "_test_generator_76c3f9d7128a", HOME / "generator.py"
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _signatures(grid: list[list[int]]) -> list[tuple[int, int]]:
+    positions: dict[int, list[tuple[int, int]]] = {}
+    order: list[int] = []
+    for row, values in enumerate(grid):
+        for col, color in enumerate(values):
+            if color in (0, 8):
+                continue
+            if color not in positions:
+                positions[color] = []
+                order.append(color)
+            positions[color].append((row, col))
+    result = []
+    for color in order:
+        cells = positions[color]
+        assert len(cells) == 2
+        (r1, c1), (r2, c2) = cells
+        orientation = 0 if r1 == r2 else 1 if c1 == c2 else 2
+        length = max(abs(r2 - r1), abs(c2 - c1)) + 1
+        result.append((orientation, length))
+    return result
+
+
+def _odd_length_relation(grid: list[list[int]]) -> str:
+    signatures = _signatures(grid)
+    counts = Counter(signatures)
+    odd = [signature for signature in signatures if counts[signature] == 1]
+    common = [signature for signature in signatures if counts[signature] > 1]
+    assert len(odd) == 1 and common
+    odd_length = odd[0][1]
+    common_length = common[0][1]
+    assert odd_length != common_length
+    return "shorter" if odd_length < common_length else "longer"
+
+
+def test_every_four_pair_lesson_refutes_longest_and_shortest_shortcuts():
+    """Any three visible pairs must include both odd-shorter and odd-longer cases."""
+    generator = _load_generator()
+    for seed in (0, 1, 17):
+        for start in range(8):
+            relations = [
+                _odd_length_relation(generator.generate(seed, start + offset))
+                for offset in range(4)
+            ]
+            for query_index in range(4):
+                demos = [value for index, value in enumerate(relations) if index != query_index]
+                assert set(demos) == {"shorter", "longer"}
