+"""Protected-Racket audit of corner-marker teaching against mapping shortcuts."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+from reviewer_support import find_root
+
+TASK_ID = "6d86d867b40b"
+HERE = Path(__file__).resolve().parent
+HOME = HERE.parents[1]
+ROOT = find_root(__file__)
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical() -> str:
+    record = Catalog(ROOT).get(TASK_ID)
+    programs = {
+        variant["program_solution"]
+        for variant in record["variants"]
+        if isinstance(variant.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise AssertionError(f"expected one selected program, got {len(programs)}")
+    return next(iter(programs))
+
+
+def _rival(mapping: tuple[int, int, int, int]) -> str:
+    branches = (
+        "(subgrid body 0 0 (- hh 1) (- hw 1))",
+        "(subgrid body 0 hw (- hh 1) (- bw 1))",
+        "(subgrid body hh 0 (- bh 1) (- hw 1))",
+        "(subgrid body hh hw (- bh 1) (- bw 1))",
+    )
+    selected = [branches[index] for index in mapping]
+    return f'''(rule!
+  (let* ((h (rows g))
+         (w (cols g))
+         (body (subgrid g 1 1 (- h 2) (- w 2)))
+         (bh (rows body))
+         (bw (cols body))
+         (hh (quotient bh 2))
+         (hw (quotient bw 2))
+         (corner (first (filter (lambda (p) (not (= (at g (first p) (second p)) 0)))
+                                (list (list 0 0) (list 0 (- w 1)) (list (- h 1) 0) (list (- h 1) (- w 1)))))))
+    (cond [(and (= (first corner) 0) (= (second corner) 0)) {selected[0]}]
+          [(= (first corner) 0) {selected[1]}]
+          [(= (second corner) 0) {selected[2]}]
+          [else {selected[3]}])))'''
+
+
+RIVALS = {
+    "fixed_tl": (0, 0, 0, 0),
+    "fixed_tr": (1, 1, 1, 1),
+    "fixed_bl": (2, 2, 2, 2),
+    "fixed_br": (3, 3, 3, 3),
+    "row_only_left": (0, 0, 2, 2),
+    "row_only_right": (1, 1, 3, 3),
+    "column_only_top": (0, 1, 0, 1),
+    "column_only_bottom": (2, 3, 2, 3),
+    "opposite_quadrant": (3, 2, 1, 0),
+}
+
+
+def _corner(grid: list[list[int]]) -> int:
+    h, w = len(grid), len(grid[0])
+    values = (grid[0][0], grid[0][w - 1], grid[h - 1][0], grid[h - 1][w - 1])
+    marked = [index for index, value in enumerate(values) if value]
+    if len(marked) != 1:
+        raise AssertionError(f"expected one marked corner, got {marked}")
+    return marked[0]
+
+
+def run(out: Path) -> int:
+    current_path = HOME / "generator.py"
+    before_path = HERE / "generator_before_2.1.1.py"
+    current = _load(current_path, "_peer_current_6d86d867b40b")
+    before = _load(before_path, "_peer_before_6d86d867b40b")
+    canonical = _canonical()
+    programs = {name: _rival(mapping) for name, mapping in RIVALS.items()}
+    apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+    evaluations = 0
+
+    def execute(program: str, grid: list[list[int]]) -> list[list[int]]:
+        nonlocal evaluations
+        evaluations += 1
+        value = apply(program, grid)
+        if not isinstance(value, list) or not value or not all(isinstance(row, list) for row in value):
+            raise AssertionError("Racket did not return a grid")
+        return value
+
+    try:
+        # Exact pre-repair witness: three left-column markers teach only row selection.
+        old_inputs = [before.generate(1, index) for index in range(4)]
+        old_outputs = [execute(canonical, grid) for grid in old_inputs]
+        row_left = programs["row_only_left"]
+        old_rival = [execute(row_left, grid) for grid in old_inputs]
+        if old_rival[:3] != old_outputs[:3] or old_rival[3] == old_outputs[3]:
+            raise AssertionError("pre-repair row-only-left witness no longer reproduces")
+        pre_repair = {
+            "seed": 1,
+            "sample_indices": [0, 1, 2, 3],
+            "demo_corners": [_corner(grid) for grid in old_inputs[:3]],
+            "query_corner": _corner(old_inputs[3]),
+            "rival": "row_only_left",
+            "rival_program": row_left,
+            "pairs": [
+                {"role": "demo" if index < 3 else "query", "input": grid,
+                 "canonical_output": output, "rival_output": rival}
+                for index, (grid, output, rival) in enumerate(zip(old_inputs, old_outputs, old_rival))
+            ],
+        }
+
+        lessons = []
+        survivors = []
+        for seed in (0, 1, 17):
+            for start in range(4):
+                inputs = [current.generate(seed, start + offset) for offset in range(4)]
+                outputs = [execute(canonical, grid) for grid in inputs]
+                corners = [_corner(grid) for grid in inputs]
+                if set(corners) != {0, 1, 2, 3}:
+                    raise AssertionError(f"corner schedule failed at seed={seed}, start={start}: {corners}")
+                rotations = []
+                for query_index in range(4):
+                    demos = [index for index in range(4) if index != query_index]
+                    rows = []
+                    for name, program in programs.items():
+                        predictions = [execute(program, grid) for grid in inputs]
+                        fits = all(predictions[index] == outputs[index] for index in demos)
+                        disagrees = predictions[query_index] != outputs[query_index]
+                        status = (
+                            "survives_demos_disagrees_query" if fits and disagrees
+                            else "fits_all_checked" if fits
+                            else "refuted_by_demo"
+                        )
+                        rows.append({"name": name, "status": status})
+                        if fits and disagrees:
+                            survivors.append({"seed": seed, "start": start,
+                                              "query_index": query_index, "rival": name})
+                    rotations.append({"query_index": query_index, "rivals": rows})
+                lessons.append({"seed": seed, "start": start, "corners": corners,
+                                "rotations": rotations})
+    finally:
+        bridge.close()
+
+    result = {
+        "schema": "arcpuzzles-bounded-peer-learnability-audit-v1",
+        "task_id": TASK_ID,
+        "status": "pass" if not survivors else "needs_repair",
+        "source_sha256": _sha(current_path),
+        "pre_repair_source_sha256": _sha(before_path),
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "racket": identity,
+        "protected_racket_evaluations": evaluations,
+        "pre_repair_witness": pre_repair,
+        "post_repair": {
+            "lessons": lessons,
+            "lessons_checked": len(lessons),
+            "query_rotations_checked": len(lessons) * 4,
+            "rivals": sorted(programs),
+            "survivors": survivors,
+        },
+        "limits": "Finite corner-mapping rivals, three seeds, four starts and four query rotations only; not universal identifiability.",
+    }
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({
+        "status": result["status"],
+        "protected_racket_evaluations": evaluations,
+        "lessons_checked": len(lessons),
+        "query_rotations_checked": len(lessons) * 4,
+        "survivors": len(survivors),
+        "pre_repair_demo_corners": pre_repair["demo_corners"],
+        "pre_repair_query_corner": pre_repair["query_corner"],
+    }, sort_keys=True))
+    return 0 if not survivors else 1
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    return run(parser.parse_args().out)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
