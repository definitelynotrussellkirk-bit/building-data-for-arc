+++ b/repo/generators/6d86d867b40b/tests/test_corner_curriculum.py
@@ -0,0 +1,41 @@
+"""Regression tests for the corner-marker teaching schedule."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+HOME = Path(__file__).resolve().parents[1]
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(
+        "_test_generator_6d86d867b40b", HOME / "generator.py"
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _marked_corner(grid: list[list[int]]) -> int:
+    height, width = len(grid), len(grid[0])
+    values = (
+        grid[0][0],
+        grid[0][width - 1],
+        grid[height - 1][0],
+        grid[height - 1][width - 1],
+    )
+    marked = [index for index, value in enumerate(values) if value != 0]
+    assert len(marked) == 1
+    return marked[0]
+
+
+def test_every_four_consecutive_samples_cover_all_marker_corners():
+    """Catches a return to random schedules that can omit a query corner from demos."""
+    generator = _load_generator()
+    for seed in (0, 1, 17):
+        for start in range(8):
+            corners = {
+                _marked_corner(generator.generate(seed, start + offset))
+                for offset in range(4)
+            }
+            assert corners == {0, 1, 2, 3}
