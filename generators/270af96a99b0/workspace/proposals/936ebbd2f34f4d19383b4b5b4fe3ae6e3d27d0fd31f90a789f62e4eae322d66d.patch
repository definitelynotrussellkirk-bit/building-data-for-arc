@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Source-pinned finite lesson audit for e4cb0224ca42.
+
+The audit checks every held-out position in the four-profile default schedule.
+Besides the generator's declared rivals, it tests the lesson-local shortcut
+"apply the cross rule only to rectangle dimensions observed in demonstrations."
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+HOME = Path(__file__).resolve().parents[1]
+REPO_ROOT = HOME.parents[1]
+RUNTIME_ROOT = REPO_ROOT / "shared" / "runtime"
+if str(RUNTIME_ROOT) not in sys.path:
+    sys.path.insert(0, str(RUNTIME_ROOT))
+GENERATOR_PATH = HOME / "generator.py"
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(
+        "e4cb0224ca42_generator_for_shape_audit", GENERATOR_PATH
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {GENERATOR_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _component_dimensions(grid: list[list[int]]) -> set[tuple[int, int]]:
+    height, width = len(grid), len(grid[0])
+    seen: set[tuple[int, int]] = set()
+    result: set[tuple[int, int]] = set()
+    for row in range(height):
+        for col in range(width):
+            color = grid[row][col]
+            if color == 0 or (row, col) in seen:
+                continue
+            stack = [(row, col)]
+            seen.add((row, col))
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and (nr, nc) not in seen
+                        and grid[nr][nc] == color
+                    ):
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
+            result.add((max(rows) - min(rows) + 1, max(cols) - min(cols) + 1))
+    return result
+
+
+def run_audit(*, seed_count: int = 128) -> dict[str, Any]:
+    if type(seed_count) is not int or seed_count <= 0:
+        raise ValueError("seed_count must be a positive integer")
+
+    gen = _load_generator()
+    findings: list[dict[str, Any]] = []
+    lessons_checked = 0
+    pairs_materialized = 0
+    bands = ("easy", "medium", "hard")
+
+    for seed_offset in range(seed_count):
+        seed = 91_000 + seed_offset
+        for band in bands:
+            pairs: list[dict[str, Any]] = []
+            for sample_index in range(len(gen.SCHEDULE_PROFILES)):
+                grid = gen.generate(seed, sample_index, difficulty=band)
+                pairs.append({"input": grid, "output": gen.rule_mirror(grid)})
+            pairs_materialized += len(pairs)
+
+            for query_index, query in enumerate(pairs):
+                lessons_checked += 1
+                demos = [
+                    pair for index, pair in enumerate(pairs) if index != query_index
+                ]
+                taught_dimensions = set().union(
+                    *(_component_dimensions(pair["input"]) for pair in demos)
+                )
+                query_dimensions = _component_dimensions(query["input"])
+                unseen_dimensions = sorted(query_dimensions - taught_dimensions)
+                surviving_declared = sorted(
+                    name
+                    for name, rival in gen.SEMANTIC_RIVALS.items()
+                    if all(rival(pair["input"]) == pair["output"] for pair in demos)
+                    and rival(query["input"]) != query["output"]
+                )
+                gate_reasons = gen.lesson_identifiable(demos, query)
+                if unseen_dimensions or surviving_declared or gate_reasons:
+                    findings.append(
+                        {
+                            "seed": seed,
+                            "band": band,
+                            "query_index": query_index,
+                            "query_profile": gen.SCHEDULE_PROFILES[query_index],
+                            "taught_dimensions": sorted(taught_dimensions),
+                            "query_dimensions": sorted(query_dimensions),
+                            "unseen_dimensions": unseen_dimensions,
+                            "query_changing_declared_rivals": surviving_declared,
+                            "lesson_gate_reasons": gate_reasons,
+                        }
+                    )
+
+    source_bytes = GENERATOR_PATH.read_bytes()
+    return {
+        "audit": "e4cb0224ca42_shape_lesson_closure_v1",
+        "generator_path": str(GENERATOR_PATH.relative_to(HOME.parents[1])),
+        "generator_sha256": hashlib.sha256(source_bytes).hexdigest(),
+        "generator_version": gen.VERSION,
+        "rule_hash": gen.RULE_HASH,
+        "seed_count": seed_count,
+        "bands": list(bands),
+        "schedule_profiles": list(gen.SCHEDULE_PROFILES),
+        "pairs_materialized": pairs_materialized,
+        "lessons_checked": lessons_checked,
+        "findings": findings,
+        "status": "no_ambiguity_found" if not findings else "ambiguity_found",
+        "scope": (
+            "finite audit of the four-profile default schedule, every held-out "
+            "query position, declared semantic rivals, and the lesson-local "
+            "seen-rectangle-dimensions-only shortcut"
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seed-count", type=int, default=128)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    report = run_audit(seed_count=args.seed_count)
+    payload = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.output is not None:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(payload)
+    print(payload, end="")
+    return 0 if report["status"] == "no_ambiguity_found" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
