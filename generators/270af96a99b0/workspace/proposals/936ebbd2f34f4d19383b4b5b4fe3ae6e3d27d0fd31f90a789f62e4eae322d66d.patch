+def _rectangle_dimensions(grid):
+    """Return the (height, width) of every colored component independently."""
+    height, width = len(grid), len(grid[0])
+    seen = set()
+    dimensions = set()
+    for row in range(height):
+        for col in range(width):
+            color = grid[row][col]
+            if color == 0 or (row, col) in seen:
+                continue
+            stack = [(row, col)]
+            seen.add((row, col))
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and (nr, nc) not in seen
+                        and grid[nr][nc] == color
+                    ):
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
+            dimensions.add((max(rows) - min(rows) + 1, max(cols) - min(cols) + 1))
+    return dimensions
+
+
+def test_every_held_out_profile_uses_only_rectangle_dimensions_taught_by_demos():
+    """Regression for the lesson-local ``seen dimensions only`` shortcut."""
+    gen = _load()
+    for band in ("easy", "medium", "hard"):
+        pairs = [
+            {
+                "input": gen.generate(4242, sample_index, difficulty=band),
+                "output": None,
+            }
+            for sample_index in range(4)
+        ]
+        for pair in pairs:
+            pair["output"] = gen.rule_mirror(pair["input"])
+        for query_index, query in enumerate(pairs):
+            taught = set().union(*(
+                _rectangle_dimensions(pair["input"])
+                for index, pair in enumerate(pairs)
+                if index != query_index
+            ))
+            unseen = _rectangle_dimensions(query["input"]) - taught
+            assert unseen == set(), (band, query_index, taught, unseen)
+
