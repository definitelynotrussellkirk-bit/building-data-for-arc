(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (begin
             (define rects (objects g 0))
             (define b1 (obj-bbox (nth rects 0)))
             (define b2 (obj-bbox (nth rects 1)))
             (define c1a (nth b1 1))
             (define r2a (nth b1 2))
             (define c2a (nth b1 3))
             (define r1b (nth b2 0))
             (define c1b (nth b2 1))
             (define c2b (nth b2 3))
             (define horizontal (or (< c2a c1b) (< c2b c1a)))
             (if horizontal
                 (let* ((left (if (< c2a c1b) b1 b2))
                        (right (if (< c2a c1b) b2 b1))
                        (lr1 (nth left 0))
                        (lr2 (nth left 2))
                        (lc2 (nth left 3))
                        (rr1 (nth right 0))
                        (rr2 (nth right 2))
                        (rc1 (nth right 1))
                        (lo (max lr1 rr1))
                        (hi (min lr2 rr2))
                        (gc1 (+ lc2 1))
                        (gc2 (- rc1 1)))
                   (recolor-cells g
                                  (apply append
                                         (map (lambda (r)
                                                (map (lambda (c) (list r c))
                                                     (range gc1 (+ gc2 1))))
                                              (range lo (+ hi 1))))
                                  8))
                 (let* ((top (if (< r2a r1b) b1 b2))
                        (bot (if (< r2a r1b) b2 b1))
                        (tc1 (nth top 1))
                        (tc2 (nth top 3))
                        (tr2 (nth top 2))
                        (bc1 (nth bot 1))
                        (bc2 (nth bot 3))
                        (br1 (nth bot 0))
                        (lo (max tc1 bc1))
                        (hi (min tc2 bc2))
                        (gr1 (+ tr2 1))
                        (gr2 (- br1 1)))
                   (recolor-cells g
                                  (apply append
                                         (map (lambda (r)
                                                (map (lambda (c) (list r c))
                                                     (range lo (+ hi 1))))
                                              (range gr1 (+ gr2 1))))
                                  8)))))))
