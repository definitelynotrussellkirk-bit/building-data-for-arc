  "program": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g)))\n           (begin\n             (define rects (objects g 0))\n             (define b1 (obj-bbox (nth rects 0)))\n             (define b2 (obj-bbox (nth rects 1)))\n             (define c1a (nth b1 1))\n             (define r2a (nth b1 2))\n             (define c2a (nth b1 3))\n             (define r1b (nth b2 0))\n             (define c1b (nth b2 1))\n             (define c2b (nth b2 3))\n             (define horizontal (or (< c2a c1b) (< c2b c1a)))\n             (if horizontal\n                 (let* ((left (if (< c2a c1b) b1 b2))\n                        (right (if (< c2a c1b) b2 b1))\n                        (lr1 (nth left 0))\n                        (lr2 (nth left 2))\n                        (lc2 (nth left 3))\n                        (rr1 (nth right 0))\n                        (rr2 (nth right 2))\n                        (rc1 (nth right 1))\n                        (lo (+ (max lr1 rr1) 1))\n                        (hi (- (min lr2 rr2) 1))\n                        (gc1 (+ lc2 1))\n                        (gc2 (- rc1 1)))\n                   (recolor-cells g\n                                  (apply append\n                                         (map (lambda (r)\n                                                (map (lambda (c) (list r c))\n                                                     (range gc1 (+ gc2 1))))\n                                              (range lo (+ hi 1))))\n                                  8))\n                 (let* ((top (if (< r2a r1b) b1 b2))\n                        (bot (if (< r2a r1b) b2 b1))\n                        (tc1 (nth top 1))\n                        (tc2 (nth top 3))\n                        (tr2 (nth top 2))\n                        (bc1 (nth bot 1))\n                        (bc2 (nth bot 3))\n                        (br1 (nth bot 0))\n                        (lo (+ (max tc1 bc1) 1))\n                        (hi (- (min tc2 bc2) 1))\n                        (gr1 (+ tr2 1))\n                        (gr2 (- br1 1)))\n                   (recolor-cells g\n                                  (apply append\n                                         (map (lambda (r)\n                                                (map (lambda (c) (list r c))\n                                                     (range lo (+ hi 1))))\n                                              (range gr1 (+ gr2 1))))\n                                  8)))))))",
