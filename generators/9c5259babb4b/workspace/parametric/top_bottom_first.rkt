(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (begin
             (define bg (mode g))
             (define objs (objects-8 g bg))
             (define (sym-color obj)
               (let* ((cells (obj-cells obj))
                      (rs (map first cells))
                      (cs (map second cells))
                      (rmin (min-list rs))
                      (rmax (max-list rs))
                      (cmin (min-list cs))
                      (cmax (max-list cs))
                      (oh (+ (- rmax rmin) 1))
                      (ow (+ (- cmax cmin) 1))
                      (norm (map (lambda (c)
                                   (list (- (first c) rmin) (- (second c) cmin)))
                                 cells))
                      (h-sym (andmap (lambda (c)
                                       (any? (lambda (c2)
                                               (= c2
                                                  (list (- (- oh 1) (first c))
                                                        (second c))))
                                             norm))
                                     norm))
                      (v-sym (andmap (lambda (c)
                                       (any? (lambda (c2)
                                               (= c2
                                                  (list (first c)
                                                        (- (- ow 1) (second c)))))
                                             norm))
                                     norm)))
                 (cond (h-sym 1) (v-sym 3) (else 6))))
             (define base (empty-grid h w bg))
             (reduce (lambda (gg obj)
                       (if (> (obj-size obj) 1)
                           (let ((c (sym-color obj)))
                             (recolor-cells gg (obj-cells obj) c))
                           gg))
                     base
                     objs)))))