@@ -0,0 +1,178 @@
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from puzzle_generators import base
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("peer_8afacf592980_generator", ROOT / "generator.py")
+assert SPEC is not None and SPEC.loader is not None
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+WARM = {2, 3, 4, 6, 7, 9}
+
+
+def _colors(grid):
+    return {value for row in grid for value in row if value != 0}
+
+
+def test_warm_override_is_consumed_and_excludes_gray_regression():
+    observed = []
+    base.set_ctx_observer(observed.append)
+    try:
+        grid = MODULE.generate(0, 0, difficulty="easy", palette_kind="warm")
+    finally:
+        base.set_ctx_observer(None)
+
+    assert _colors(grid) <= WARM
+    assert 5 not in _colors(grid)
+    assert observed[-1].axis_value("palette_kind") == "warm"
+    assert observed[-1].overrides_used()["palette_kind"] == "warm"
+
+import random
+
+import pytest
+
+EXPECTED_PALETTES = {
+    "default": {1, 2, 3, 4, 5, 6, 7, 8, 9},
+    "warm": {2, 3, 4, 6, 7, 9},
+    "cool": {1, 5, 8, 9},
+    "varied": {1, 2, 4, 6, 8, 9},
+}
+
+
+@pytest.mark.parametrize("kind,allowed", EXPECTED_PALETTES.items())
+def test_each_palette_override_is_literal_and_recorded(kind, allowed):
+    for seed in range(12):
+        observed = []
+        base.set_ctx_observer(observed.append)
+        try:
+            grid = MODULE.generate(seed, 3, difficulty="hard", palette_kind=kind)
+        finally:
+            base.set_ctx_observer(None)
+        colors = _colors(grid)
+        assert 2 <= len(colors) <= 4
+        assert colors <= allowed
+        assert observed[-1].axis_value("palette_kind") == kind
+        assert observed[-1].draw_options("palette_kind") == tuple(EXPECTED_PALETTES)
+        assert observed[-1].overrides_used()["palette_kind"] == kind
+
+
+def test_helpful_texture_is_a_true_palette_alias():
+    observed = []
+    base.set_ctx_observer(observed.append)
+    try:
+        via_texture = MODULE.generate(17, 4, difficulty="medium", texture="cool")
+    finally:
+        base.set_ctx_observer(None)
+    via_axis = MODULE.generate(17, 4, difficulty="medium", palette_kind="cool")
+
+    assert via_texture == via_axis
+    assert _colors(via_texture) <= EXPECTED_PALETTES["cool"]
+    assert observed[-1].axis_value("texture") == "cool"
+    assert observed[-1].axis_value("palette_kind") == "cool"
+    assert observed[-1].overrides_used() == {"texture": "cool", "palette_kind": "cool"}
+
+
+def test_conflicting_helpful_texture_and_palette_are_rejected():
+    with pytest.raises(ValueError, match="conflicting"):
+        MODULE.generate(1, 0, texture="warm", palette_kind="cool")
+
+
+@pytest.mark.parametrize("kwargs", [{"palette_kind": "ultraviolet"}, {"texture": "ultraviolet"}])
+def test_unknown_palette_controls_fail_closed(kwargs):
+    with pytest.raises(ValueError):
+        MODULE.generate(1, 0, **kwargs)
+
+
+def test_determinism_and_global_random_state_are_preserved():
+    random.seed(9123)
+    state = random.getstate()
+    first = MODULE.generate(31, 7, difficulty="hard", palette_kind="varied")
+    assert random.getstate() == state
+    second = MODULE.generate(31, 7, difficulty="hard", palette_kind="varied")
+    assert first == second and first is not second and first[0] is not second[0]
+
+
+def test_generated_cases_have_a_unique_majority_and_multiple_colors():
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in range(24):
+            grid = MODULE.generate(seed + 1000, seed, difficulty=difficulty)
+            counts = {}
+            for row in grid:
+                for value in row:
+                    if value:
+                        counts[value] = counts.get(value, 0) + 1
+            assert 2 <= len(counts) <= 4
+            ordered = sorted(counts.values(), reverse=True)
+            assert ordered[0] > ordered[1]
+
+
+def test_reusable_palette_audit_covers_every_band_and_declared_palette(tmp_path):
+    import json
+    import subprocess
+    import sys
+
