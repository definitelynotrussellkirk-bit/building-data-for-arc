+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "workspace" / "border_parity_probe.py"
+
+
+def test_probe_emits_ordinary_demos_and_a_three_border_query(tmp_path):
+    out = tmp_path / "inputs.json"
+    completed = subprocess.run(
+        [sys.executable, str(SCRIPT), "--emit-inputs", str(out)],
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+    assert completed.returncode == 0, completed.stderr
+    payload = json.loads(out.read_text())
+    assert len(payload["inputs"]) == 5
+    assert payload["demo_side_counts"] == [[0, 1, 2]] * 4
+    assert payload["query_side_counts"] == [0, 1, 3]
+    assert payload["rival"] == "recolor odd border-touch counts"
