+++ b/repo/generators/8afacf592980/workspace/palette_contract_audit.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+"""Source-bound audit for 8afacf592980's palette override contract.
+
+The tool checks every declared palette across all difficulty bands and then,
+unless --python-only is used, labels representative generated cases with the
+selected canonical program through the protected Racket bridge.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+TASK_ID = "8afacf592980"
+EXPECTED_GENERATOR_SHA256 = "d0234d5364263fbd27215995620781f0e2f5535444583ffe5d17997798b22e70"
+PALETTES = {
+    "default": {1, 2, 3, 4, 5, 6, 7, 8, 9},
+    "warm": {2, 3, 4, 6, 7, 9},
+    "cool": {1, 5, 8, 9},
+    "varied": {1, 2, 4, 6, 8, 9},
+}
+
+HERE = Path(__file__).resolve()
+TASK_ROOT = HERE.parents[1]
+REPO_ROOT = HERE.parents[3]
+GENERATOR_PATH = TASK_ROOT / "generator.py"
+RUNTIME = REPO_ROOT / "shared" / "runtime"
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load_generator():
+    actual = _sha256(GENERATOR_PATH)
+    if actual != EXPECTED_GENERATOR_SHA256:
+        raise RuntimeError(
+            f"generator source drift: expected {EXPECTED_GENERATOR_SHA256}, got {actual}")
+    spec = importlib.util.spec_from_file_location("audit_8afacf592980_generator", GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load generator")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _colors(grid):
+    return {value for row in grid for value in row if value}
+
+
+def _oracle(grid):
+    values = [value for row in grid for value in row if value]
+    counts = Counter(values)
+    if not counts:
+        raise ValueError("normal audit case unexpectedly contains no foreground")
+    ordered = counts.most_common()
+    if len(ordered) < 2 or ordered[0][1] == ordered[1][1]:
+        raise ValueError(f"normal audit case lacks a unique majority: {counts}")
+    return [[ordered[0][0]] * len(values)]
+
+
+def _canonical_program() -> str:
+    from arcpuzzles.catalog import Catalog
+
+    catalog = Catalog(REPO_ROOT)
+    selected = catalog.describe(TASK_ID)
+    variants = catalog._variants()[selected.get("rule_task_id", TASK_ID)]
+    programs = {row.get("program_solution") for row in variants}
+    programs.discard(None)
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one selected canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def python_audit() -> tuple[dict, list[list[list[int]]]]:
+    from puzzle_generators import base
+
+    generator = _load_generator()
+    findings: list[str] = []
+    representative_inputs = []
+    cases = 0
+    realized = {kind: set() for kind in PALETTES}
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in range(16):
+            for kind, allowed in PALETTES.items():
+                observed = []
+                base.set_ctx_observer(observed.append)
+                try:
+                    grid = generator.generate(seed, 3, difficulty=difficulty, palette_kind=kind)
+                finally:
+                    base.set_ctx_observer(None)
+                cases += 1
+                colors = _colors(grid)
+                realized[kind].update(colors)
+                if not colors <= allowed:
+                    findings.append(f"{difficulty}/{seed}/{kind}: colors {sorted(colors - allowed)} outside palette")
+                counts = Counter(value for row in grid for value in row if value)
+                ordered = sorted(counts.values(), reverse=True)
+                if len(counts) < 2 or len(counts) > 4 or ordered[0] <= ordered[1]:
+                    findings.append(f"{difficulty}/{seed}/{kind}: invalid unique-majority counts {dict(counts)}")
+                if not observed or observed[-1].axis_value("palette_kind") != kind:
+                    findings.append(f"{difficulty}/{seed}/{kind}: palette provenance missing")
+                if observed and observed[-1].overrides_used().get("palette_kind") != kind:
+                    findings.append(f"{difficulty}/{seed}/{kind}: override not consumed")
+                if seed in (0, 15) and difficulty == "medium":
+                    representative_inputs.append(copy.deepcopy(grid))
+                try:
+                    _oracle(grid)
+                except ValueError as exc:
+                    findings.append(f"{difficulty}/{seed}/{kind}: {exc}")
+
+    for kind in PALETTES:
+        direct = generator.generate(77, 5, difficulty="medium", palette_kind=kind)
+        alias = generator.generate(77, 5, difficulty="medium", texture=kind)
+        if direct != alias:
+            findings.append(f"texture alias differs from palette_kind for {kind}")
+
+    warm_seed0 = generator.generate(0, 0, difficulty="easy", palette_kind="warm")
+    report = {
+        "schema": "arcpuzzles-palette-contract-audit-v1",
+        "task_id": TASK_ID,
+        "status": "passed" if not findings else "findings",
+        "source_binding": {
+            "generator_path": str(GENERATOR_PATH.relative_to(REPO_ROOT)),
+            "generator_sha256": EXPECTED_GENERATOR_SHA256,
+        },
+        "python_cases": cases,
+        "palettes": {kind: sorted(colors) for kind, colors in PALETTES.items()},
+        "realized_colors": {kind: sorted(colors) for kind, colors in realized.items()},
+        "warm_seed0_colors": sorted(_colors(warm_seed0)),
+        "texture_aliases_checked": sorted(PALETTES),
+        "findings": findings,
+    }
+    return report, representative_inputs
+
+
+def full_audit() -> dict:
+    report, inputs = python_audit()
+    canonical = _canonical_program()
+    from arcpuzzles.parametric_worker import _real_evaluator
+
+    sys.path.insert(0, str(RUNTIME))
+    apply, identity, bridge = _real_evaluator(RUNTIME)
+    try:
+        outputs = [apply(canonical, copy.deepcopy(grid)) for grid in inputs]
+    finally:
+        bridge.close()
+        try:
+            sys.path.remove(str(RUNTIME))
+        except ValueError:
+            pass
+    mismatches = [index for index, (grid, output) in enumerate(zip(inputs, outputs)) if output != _oracle(grid)]
+    if mismatches:
+        report["findings"].append(f"protected Racket/oracle mismatch at representative indices {mismatches}")
+    report["status"] = "passed" if not report["findings"] else "findings"
+    report["protected_racket"] = {
+        "identity": identity,
+        "evaluations": len(inputs),
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "oracle_mismatches": mismatches,
+    }
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    group = parser.add_mutually_exclusive_group(required=True)
+    group.add_argument("--python-only", type=Path)
+    group.add_argument("--out", type=Path)
+    args = parser.parse_args()
+    if args.python_only:
+        report, _ = python_audit()
+        out = args.python_only
+    else:
+        report = full_audit()
+        out = args.out
+    out.parent.mkdir(parents=True, exist_ok=True)
+    if out.exists():
+        raise FileExistsError(f"refusing to overwrite {out}")
+    out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"out": str(out), "status": report["status"]}, sort_keys=True))
+    return 0 if report["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
