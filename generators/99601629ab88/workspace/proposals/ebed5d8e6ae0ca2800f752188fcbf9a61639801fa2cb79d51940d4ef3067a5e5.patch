@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""Source-bound learnability probe for the unseen K=3 border-touch regime.
+
+The production generator demonstrates components whose bounding boxes touch
+0, 1, or 2 borders.  This probe retains ordinary generated demonstrations and
+adds one legal query with a three-border component.  It executes both the
+selected canonical rule and an explicit odd-border rival through the protected
+Racket bridge, proving that the rival fits every demonstration and fails the
+query.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+TASK_ID = "7aba2cb70bae"
+EXPECTED_GENERATOR_SHA256 = "82e1ed48d3be78210aca77ff841b957de483eb7e1318da59547af75b3f1666a6"
+RIVAL_NAME = "recolor odd border-touch counts"
+RIVAL_PROGRAM = """(rule!
+  (let ((h (rows g)) (w (cols g)))
+    (define (side-count obj)
+      (+ (if (= (obj-r1 obj) 0) 1 0)
+         (if (= (obj-r2 obj) (- h 1)) 1 0)
+         (if (= (obj-c1 obj) 0) 1 0)
+         (if (= (obj-c2 obj) (- w 1)) 1 0)))
+    (for/fold ([out g])
+              ([obj (filter (lambda (o)
+                              (and (= (obj-color o) 7)
+                                   (= (modulo (side-count o) 2) 1)))
+                            (objects g 0))])
+      (paint-cells out (obj-cells obj) 8))))"""
+
+HERE = Path(__file__).resolve()
+TASK_ROOT = HERE.parents[1]
+REPO_ROOT = HERE.parents[3]
+GENERATOR_PATH = TASK_ROOT / "generator.py"
+RUNTIME = REPO_ROOT / "shared" / "runtime"
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load_generator():
+    actual = _sha256(GENERATOR_PATH)
+    if actual != EXPECTED_GENERATOR_SHA256:
+        raise RuntimeError(
+            f"generator source drift: expected {EXPECTED_GENERATOR_SHA256}, got {actual}")
+    spec = importlib.util.spec_from_file_location("probe_7aba2cb70bae_generator", GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load generator")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _components(grid: list[list[int]]) -> list[list[tuple[int, int]]]:
+    h, w = len(grid), len(grid[0])
+    remaining = {(r, c) for r in range(h) for c in range(w) if grid[r][c] == 7}
+    result: list[list[tuple[int, int]]] = []
+    while remaining:
+        start = remaining.pop()
+        stack = [start]
+        cells = [start]
+        while stack:
+            r, c = stack.pop()
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nxt = (r + dr, c + dc)
+                if nxt in remaining:
+                    remaining.remove(nxt)
+                    stack.append(nxt)
+                    cells.append(nxt)
+        result.append(sorted(cells))
+    return sorted(result, key=lambda cells: cells[0])
+
+
+def _side_count(grid: list[list[int]], cells: list[tuple[int, int]]) -> int:
+    h, w = len(grid), len(grid[0])
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return sum((min(rows) == 0, max(rows) == h - 1, min(cols) == 0, max(cols) == w - 1))
+
+
+def side_counts(grid: list[list[int]]) -> list[int]:
+    return sorted(_side_count(grid, cells) for cells in _components(grid))
+
+
+def _query() -> list[list[int]]:
+    grid = [[0] * 8 for _ in range(8)]
+    for row in range(8):
+        grid[row][0] = 7                    # K=3: top + bottom + left
+    grid[0][3] = grid[0][4] = 7             # K=1: top only
+    for row in (3, 4):
+        for col in (5, 6):
+            grid[row][col] = 7              # K=0: interior
+    return grid
+
+
+def build_inputs() -> dict:
+    generator = _load_generator()
+    demos = [generator.generate(2718, index, difficulty="easy") for index in range(4)]
+    query = _query()
+    demo_counts = [side_counts(grid) for grid in demos]
+    query_counts = side_counts(query)
+    if demo_counts != [[0, 1, 2]] * 4:
+        raise RuntimeError(f"ordinary demonstration regime changed: {demo_counts}")
+    if query_counts != [0, 1, 3]:
+        raise RuntimeError(f"counterexample construction changed: {query_counts}")
+    return {
+        "schema": "arcpuzzles-border-parity-probe-inputs-v1",
+        "task_id": TASK_ID,
+        "generator_sha256": EXPECTED_GENERATOR_SHA256,
+        "rival": RIVAL_NAME,
+        "demo_side_counts": demo_counts,
+        "query_side_counts": query_counts,
+        "inputs": demos + [query],
+    }
+
+
+def _canonical_program() -> str:
+    from arcpuzzles.catalog import Catalog
+
+    catalog = Catalog(REPO_ROOT)
+    selected = catalog.describe(TASK_ID)
+    variants = catalog._variants()[selected.get("rule_task_id", TASK_ID)]
+    programs = {row.get("program_solution") for row in variants}
+    programs.discard(None)
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one selected canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def run_probe() -> dict:
+    payload = build_inputs()
+    canonical_program = _canonical_program()
+    from arcpuzzles.parametric_worker import _real_evaluator
+
+    sys.path.insert(0, str(RUNTIME))
+    apply, identity, bridge = _real_evaluator(RUNTIME)
+    try:
+        canonical_outputs = [apply(canonical_program, copy.deepcopy(grid)) for grid in payload["inputs"]]
+        rival_outputs = [apply(RIVAL_PROGRAM, copy.deepcopy(grid)) for grid in payload["inputs"]]
+    finally:
+        bridge.close()
+        try:
+            sys.path.remove(str(RUNTIME))
+        except ValueError:
+            pass
+
+    matches = [canonical == rival for canonical, rival in zip(canonical_outputs, rival_outputs)]
+    if matches != [True, True, True, True, False]:
+        raise RuntimeError(f"unexpected rival match pattern: {matches}")
+    return {
+        "schema": "arcpuzzles-border-parity-probe-v1",
+        "task_id": TASK_ID,
+        "status": "counterexample_retained",
+        "source_binding": {
+            "generator_path": str(GENERATOR_PATH.relative_to(REPO_ROOT)),
+            "generator_sha256": EXPECTED_GENERATOR_SHA256,
+            "canonical_program_sha256": hashlib.sha256(canonical_program.encode()).hexdigest(),
+            "rival_program_sha256": hashlib.sha256(RIVAL_PROGRAM.encode()).hexdigest(),
+        },
+        "racket": identity,
+        "racket_evaluations": len(payload["inputs"]) * 2,
+        "rival": RIVAL_NAME,
+        "demo_side_counts": payload["demo_side_counts"],
+        "query_side_counts": payload["query_side_counts"],
+        "match_pattern": matches,
+        "demonstrations_all_fit": all(matches[:-1]),
+        "query_refuted": matches[-1] is False,
+        "query_input": payload["inputs"][-1],
+        "canonical_query_output": canonical_outputs[-1],
+        "rival_query_output": rival_outputs[-1],
+        "recommendation": (
+            "Whenever a query may contain K=3 or K=4 components, include that border-count regime "
+            "in a demonstration or add odd/even and K<=2-gated rivals to lesson selection."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--emit-inputs", type=Path)
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args()
+    if bool(args.emit_inputs) == bool(args.out):
+        parser.error("choose exactly one of --emit-inputs or --out")
+    if args.emit_inputs:
+        result = build_inputs()
+        path = args.emit_inputs
+    else:
+        result = run_probe()
+        path = args.out
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.exists():
+        raise FileExistsError(f"refusing to overwrite {path}")
+    path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"out": str(path), "status": result.get("status", "inputs_emitted")}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
