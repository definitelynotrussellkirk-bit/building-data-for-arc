(rule! (lambda (g)
  (let* ((objs (objects g 0))
         (o1 (first objs)) (o2 (second objs))
         (left-obj (if (<= (min-list (map snd (obj-cells o1)))
                           (min-list (map snd (obj-cells o2)))) o1 o2))
         (right-obj (if (eq? left-obj o1) o2 o1))
         (tabbed? (lambda (obj)
           (let* ((cells (obj-cells obj))
                  (rs (map fst cells)) (cs (map snd cells))
                  (r0 (min-list rs))
                  (c0 (min-list cs)) (c1 (max-list cs))
                  (top-count (length (filter (lambda (p) (= (fst p) r0)) cells)))
                  (next-count (length (filter (lambda (p) (= (fst p) (+ r0 1))) cells))))
             (and (= top-count 1) (= next-count (+ 1 (- c1 c0)))))))
         (first-obj (if (tabbed? left-obj) left-obj right-obj))
         (second-obj (if (eq? first-obj left-obj) right-obj left-obj))
         (count-holes (lambda (obj)
           (let* ((cells (obj-cells obj))
                  (rs (map fst cells)) (cs (map snd cells))
                  (r0 (min-list rs)) (r1 (max-list rs))
                  (c0 (min-list cs)) (c1 (max-list cs)))
             (length (filter (lambda (p) p)
               (for*/list ((r (range (+ r0 1) r1)) (c (range (+ c0 1) c1)))
                 (if (= (cell-at g r c) 0) #t #f)))))))
         (n1 (count-holes first-obj)) (n2 (count-holes second-obj))
         (c1 (obj-color first-obj)) (c2 (obj-color second-obj))
         (r2-start (if (= 0 (remainder n1 3)) (quotient n1 3) (+ (quotient n1 3) 1))))
    (grid-from-fn 3 3 (lambda (r c)
      (cond ((< (+ (* r 3) c) n1) c1)
            ((and (>= r r2-start) (< (+ (* (- r r2-start) 3) c) n2)) c2)
            (else 0)))))))
