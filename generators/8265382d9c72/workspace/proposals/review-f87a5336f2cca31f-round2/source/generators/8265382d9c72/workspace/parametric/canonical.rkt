(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((objs (objects g 0))
                  (o1 (first objs))
                  (o2 (second objs))
                  (left-obj (if (<= (min-of snd (obj-cells o1))
                                    (min-of snd (obj-cells o2)))
                                o1
                                o2))
                  (right-obj (if (eq? left-obj o1) o2 o1))
                  (count-holes (lambda (obj)
                                 (let* ((cells (obj-cells obj))
                                        (rs (map fst cells))
                                        (cs (map snd cells))
                                        (r0 (min-list rs))
                                        (r1 (max-list rs))
                                        (c0 (min-list cs))
                                        (c1 (max-list cs)))
                                   (count-if (lambda (p) p)
                                             (for*/list ((r (range (+ r0 1) r1)) (c (range (+ c0 1) c1)))
                                               (and (zero? (at g r c)) #t))))))
                  (n1 (count-holes left-obj))
                  (n2 (count-holes right-obj))
                  (c1 (obj-color left-obj))
                  (c2 (obj-color right-obj))
                  (r2-start (if (zero? (remainder n1 3))
                                (quotient n1 3)
                                (+ (quotient n1 3) 1))))
             (build-grid 3
                         3
                         (r c)
                         (cond
                           ((< (+ (* r 3) c) n1) c1)
                           ((and (>= r r2-start) (< (+ (* (- r r2-start) 3) c) n2)) c2)
                           (else 0)))))))