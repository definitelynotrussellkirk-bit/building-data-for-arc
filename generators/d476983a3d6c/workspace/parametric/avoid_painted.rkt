(rule!
 (let ((dummy 0))
  (define (ordered-colors grid)
   (let loop ((ps (grid-positions grid)) (seen (list)))
    (if (empty? ps) seen
     (let* ((p (first ps)) (v (at grid (first p) (second p))))
      (if (or (= v 0) (member? v seen))
       (loop (rest ps) seen)
       (loop (rest ps) (append seen (list v))))))))
  (define (path a b order)
   (let* ((r1 (first a)) (c1 (second a)) (r2 (first b)) (c2 (second b))
          (dr (if (>= r2 r1) 1 -1)) (dc (if (>= c2 c1) 1 -1)))
    (if (= order 1)
     (append
      (for/list ((c (in-range c1 (+ c2 dc) dc))) (list r1 c))
      (for/list ((r (in-range (+ r1 dr) (+ r2 dr) dr))) (list r c2)))
     (append
      (for/list ((r (in-range r1 (+ r2 dr) dr))) (list r c1))
      (for/list ((c (in-range (+ c1 dc) (+ c2 dc) dc))) (list r2 c))))))
  (define (cost canvas color cells)
   (length (filter (lambda (p)
     (let ((v (at canvas (first p) (second p))))
      (and (not (= v 0)) (not (= v color))))) cells)))
  (let ((command (at g 0 0)) (colors (ordered-colors (set-cell g 0 0 0))))
   (for/fold ((out g)) ((color (in-list colors)))
    (let ((points (find-color g color)))
     (if (= (length points) 2)
      (let* ((hv (path (first points) (second points) 1))
             (vh (path (first points) (second points) 2))
             (hc (cost out color hv)) (vc (cost out color vh))
             (chosen (if (< hc vc) hv (if (> hc vc) vh (if (= command 1) hv vh)))))
       (for/fold ((canvas out)) ((p (in-list chosen)))
        (set-cell canvas (first p) (second p) color)))
      out))))))
