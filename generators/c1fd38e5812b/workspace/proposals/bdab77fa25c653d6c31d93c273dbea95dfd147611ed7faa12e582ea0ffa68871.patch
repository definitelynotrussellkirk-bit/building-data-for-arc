+"""Bounded protected replay of retained A13-1; no production modification."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+REPO = Path(__file__).resolve().parents[3]
+RUNTIME = REPO / "shared/runtime"
+sys.path[:0] = [str(REPO / "src"), str(RUNTIME)]
+from reviewer_support import canonical_pairs, canonical_path, load_selected_generator
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+TASK = "13c2bb6fb5a7"
+SOURCE_SHA = "a3b7f791f66cad710cfc521fd643c1dfee4eb7f29f8884435b3681f700d4b5da"
+RULE_HASH = "88475e062f41"
+RIVAL = """(rule!
+  (let* ((stripped (grid-from-fn (rows g) (cols g)
+                    (lambda (r c) (if (or (= r 0) (= c 0)
+                       (= r (- (rows g) 1)) (= c (- (cols g) 1))) 0 (at g r c)))))
+         (bb (bbox-of-cells (filter-cells stripped (lambda (r c v) (!= v 0))))))
+    (if bb (subgrid stripped (first bb) (second bb) (third bb) (fourth bb))
+        (empty-grid 1 1 0))))"""
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def crop(grid):
+    cells = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value]
+    if not cells:
+        return [[0]]
+    return [row[min(c for r, c in cells):max(c for r, c in cells)+1]
+            for row in grid[min(r for r, c in cells):max(r for r, c in cells)+1]]
+
+
+def rival(grid):
+    return crop([[value if 0 < r < len(grid)-1 and 0 < c < len(row)-1 else 0
+                  for c, value in enumerate(row)] for r, row in enumerate(grid)])
+
+
+def run(out):
+    gen, source, source_sha = load_selected_generator(TASK, root=REPO)
+    assert source_sha == SOURCE_SHA
+    rows = [json.loads(line) for line in canonical_path(REPO).read_text().splitlines()
+            if line.strip()]
+    row = next(row for row in rows if row.get("task_id") == TASK)
+    program = row["program_solution"]
+    assert hashlib.sha256(" ".join(program.split()).encode()).hexdigest()[:12] == RULE_HASH
+    retained = source.parent / "counterexamples/review-d360af96dfa100cc-v0001/retained/checks/audit/13c2bb6fb5a7/shortcut"
+    witness = json.loads((retained / "input.json").read_text())
+    old = json.loads((retained / "comparison.json").read_text())["counterexample"]
+    assert witness == old["input"] and gen.self_check(witness) == []
+    pairs = canonical_pairs(TASK, root=REPO, labeled_only=True)
+    train = [pair for pair in pairs if pair["split"] == "train"]
+    query = [pair for pair in pairs if pair["split"] == "test"]
+    programs = {"canonical": program, "erase_border_then_crop": RIVAL}
+    report = {"schema": "13c2bb6fb5a7-bounded-native-replay-v1", "task_id": TASK,
+              "status": "running", "generator_sha256": source_sha, "rule_hash": RULE_HASH,
+              "programs": programs, "train": train, "test": query, "witness": witness,
+              "self_check_errors": [], "native_evaluations": 0, "outputs": {},
+              "training_admitted": False, "visibility": "controller_private"}
+    with _local_imports(RUNTIME, source.parent):
+        apply, identity, bridge = _real_evaluator(RUNTIME)
+        report["racket"] = identity
+        try:
+            def evaluate(code, grid):
+                report["native_evaluations"] += 1
+                return _grid(apply(code, grid))
+            # Complete both demonstration fits before consulting any query label.
+            fits = {}
+            for name, code in programs.items():
+                outputs = [evaluate(code, pair["input"]) for pair in train]
+                assert outputs == [pair["output"] for pair in train]
+                fits[name] = {"fits": True, "outputs": outputs}
+            report["demonstration_fits"] = fits
+            report["fit_frozen_before_query"] = True
+            for name, code in programs.items():
+                outputs = [evaluate(code, pair["input"]) for pair in query]
+                assert outputs == [pair["output"] for pair in query]
+                report["outputs"][name] = {"canonical_queries": outputs,
+                                           "witness": evaluate(code, witness)}
+        finally:
+            bridge.close()
+    assert report["outputs"]["canonical"]["witness"] == crop(witness) == old["true_output"]
+    assert report["outputs"]["erase_border_then_crop"]["witness"] == rival(witness) == old["rival_output"]
+    assert crop(witness) != rival(witness)
+    generated = []
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in (0, 17):
+            for index in (0, 1):
+                grid = gen.generate(seed, index, difficulty=difficulty)
+                assert not gen.self_check(grid, difficulty=difficulty)
+                assert crop(grid) == rival(grid)
+                assert not any(grid[0]+grid[-1]+[r[0] for r in grid]+[r[-1] for r in grid])
+                generated.append({"difficulty": difficulty, "seed": seed, "index": index,
+                                  "input": grid, "rival_matches": True, "touches_outer_edge": False})
+    report["generated_python_census"] = generated
+    paths = [source, Path(__file__).resolve(), source.parent / "evidence/review_index.json",
+             retained / "input.json", retained / "comparison.json"]
+    report["source_files_sha256"] = {p.relative_to(REPO).as_posix(): digest(p) for p in paths}
+    assert digest(source) == SOURCE_SHA
+    report["status"] = "reproduced_unresolved_border_support_shortcut"
+    report["limits"] = "One retained rival, four canonical demonstrations fitted before one canonical query and one retained witness; 12 protected native evaluations. Twelve ordinary generated draws checked in independent Python, not a repeated 6000-draw census or a full battery. Production margin=1 and guarded fallback exclude edge-touching ordinary scenes."
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2, sort_keys=True)+"\n")
+    print(json.dumps({"status": report["status"], "native_evaluations": report["native_evaluations"],
+                      "canonical_train": len(train), "canonical_queries": len(query),
+                      "generated_python_draws": len(generated)}))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    run(parser.parse_args().out)
