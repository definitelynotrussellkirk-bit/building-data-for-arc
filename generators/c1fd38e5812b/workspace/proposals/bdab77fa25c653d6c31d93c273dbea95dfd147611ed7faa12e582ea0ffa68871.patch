+"""Bounded, source-bound peer teaching probe; never changes production.
+
+Run from the review packet through review.py run. The fixed search tests three
+predeclared interpretations against three demos before examining four queries.
+A retained hit is replayed in protected Racket, including every demo and query.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = 'e1ec4585ab53'
+PIN = 'b5ed61da2ca816332d63566e1a0c38c1539a7455e7b39cf00b11c19b33c6ca05'
+RULE_PIN = 'bf0d6b4ad48b'
+HOME = Path(__file__).resolve().parent.parent
+ROOT = HOME.parent.parent
+RIVALS = ('reverse_composition', 'code7_counterclockwise', 'code8_identity')
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def transpose(g):
+    return [list(row) for row in zip(*g)]
+
+
+def transform(g, code, rival=None):
+    if code == 1 or (code == 8 and rival == 'code8_identity'):
+        return [row[:] for row in g]
+    if code == 2:
+        return [row[::-1] for row in transpose(g)]
+    if code == 3:
+        return [row[::-1] for row in g[::-1]]
+    if code == 7 and rival == 'code7_counterclockwise':
+        return transpose(g)[::-1]
+    if code in (4, 7):
+        return transpose(g)
+    if code == 5:
+        return [row[::-1] for row in g]
+    if code == 6:
+        return [row[:] for row in g[::-1]]
+    return [row[::-1] for row in transpose(g)[::-1]]
+
+
+def reference(g, rival=None):
+    src = [row[3:6] for row in g[3:6]]
+    out = [[0] * 7 for _ in range(7)]
+    for rr, rcmd in enumerate((g[3][0], g[5][0])):
+        for cc, ccmd in enumerate((g[0][3], g[0][5])):
+            first, second = (ccmd, rcmd) if rival == 'reverse_composition' else (rcmd, ccmd)
+            tile = transform(transform(src, first, rival), second, rival)
+            for r in range(3):
+                out[rr * 4 + r][cc * 4:cc * 4 + 3] = tile[r]
+    return out
+
+
+def wrong_program(canonical, name):
+    before, after = {
+        'reverse_composition': ('(transform-code (transform-code src rcmd) ccmd)', '(transform-code (transform-code src ccmd) rcmd)'),
+        'code7_counterclockwise': ('[(= code 7) (transpose grid)]', '[(= code 7) (rotate-180 (rotate-cw grid))]'),
+        'code8_identity': ('[else (anti-transpose grid)]', '[else grid]'),
+    }[name]
+    assert canonical.count(before) == 1
+    return canonical.replace(before, after)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    source = (HOME / 'generator.py').read_bytes()
+    assert digest(source) == PIN, 'Source differs from the reviewed snapshot'
+    spec = importlib.util.spec_from_file_location('e1ec_peer_generator', HOME / 'generator.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    record = Catalog(ROOT).get(TASK)
+    programs = {v['program_solution'] for v in record['variants']}
+    assert len(programs) == 1
+    canonical = programs.pop()
+    assert digest(' '.join(canonical.split()).encode())[:12] == RULE_PIN
+    original = [{k: [list(map(int, row)) for row in pair[k]] for k in ('input', 'output')}
+                for pair in record['variants'][0]['train']]
+    original_screen = {
+        'variant': record['variants'][0]['slug'],
+        'train_count': len(original),
+        'reference_matches_all_given_train_outputs': all(reference(x['input']) == x['output'] for x in original),
+        'rival_fit_by_demo': {r: [reference(x['input'], r) == x['output'] for x in original] for r in RIVALS},
+    }
+    assert original_screen['reference_matches_all_given_train_outputs']
+    searched = []
+    found = None
+    for seed in range(32):
+        demos = [module.generate(seed, i) for i in range(3)]
+        assert all(not module.self_check(g) for g in demos)
+        # Freeze all demo fits before generating or inspecting this seed's queries.
+        demo_fit = {name: [reference(g, name) == reference(g) for g in demos] for name in RIVALS}
+        survivors = [name for name in RIVALS if all(demo_fit[name])]
+        item = {'seed': seed, 'demo_fit': demo_fit, 'frozen_survivors': survivors}
+        searched.append(item)
+        if not survivors:
+            continue
+        queries = [module.generate(seed, i) for i in range(3, 7)]
+        assert all(not module.self_check(g) for g in queries)
+        for name in survivors:
+            disagreements = [i for i, g in enumerate(queries) if reference(g, name) != reference(g)]
+            if disagreements:
+                found = {'seed': seed, 'rival': name, 'demos': demos, 'queries': queries,
+                         'query_disagreements': disagreements, 'demo_fit_frozen_before_queries': True}
+                break
+        if found:
+            break
+    report = {
+        'schema': 'arc-bounded-teaching-probe-v1', 'task_id': TASK,
+        'source_sha256': PIN, 'version': module.VERSION,
+        'canonical_rule_prefix': RULE_PIN, 'canonical_program_sha256': digest(canonical.encode()),
+        'probe_sha256': digest(Path(__file__).read_bytes()),
+        'budget': {'seeds': [0, 31], 'demos': 3, 'queries': 4, 'rivals': list(RIVALS)},
+        'search': searched, 'canonical_original_python_screen': original_screen,
+        'scope': 'Default direct draws, sample indices 0..2 demos and 3..6 queries; no native export or full battery.',
+        'canonical_composition': 'Apply row command to source, then column command.',
+        'documentation_mismatch': 'generator.py SUMMARY and task SUMMARY.md reverse the canonical composition order; module opening docstring agrees with canonical.',
+        'limits': ['A bounded concrete teaching ambiguity, not an incorrect canonical label.',
+                   'No whole-generator failure rate or general identifiability claim.',
+                   'No mutation of production, Catalog data, or approval/index records.'],
+    }
+    if not found:
+        report.update(status='no_witness_in_bounded_search', protected_calls=0)
+    else:
+        grids = found['demos'] + found['queries']
+        assert len({json.dumps(g) for g in grids}) == 7
+        bad = wrong_program(canonical, found['rival'])
+        outputs = []
+        runtime = ROOT / 'shared/runtime'
+        with _local_imports(runtime, Path(__file__).parent):
+            apply, identity, bridge = _real_evaluator(runtime)
+            try:
+                for i, g in enumerate(grids):
+                    intended = apply(canonical, g)
+                    other = apply(bad, g)
+                    assert intended == reference(g)
+                    assert other == reference(g, found['rival'])
+                    outputs.append({'role': 'demo' if i < 3 else 'query',
+                                    'sample_index': i, 'input': g, 'canonical_output': intended,
+                                    'rival_output': other, 'equal': intended == other,
+                                    'self_check_errors': module.self_check(g)})
+            finally:
+                bridge.close()
+        assert all(x['equal'] for x in outputs[:3])
+        assert any(not x['equal'] for x in outputs[3:])
+        report.update(status='reproduced_direct_draw_teaching_ambiguity', protected_calls=14,
+                      runtime=identity, seed=found['seed'], rival=found['rival'],
+                      demo_fit_frozen_before_queries=True,
+                      query_disagreements=found['query_disagreements'],
+                      canonical_program=canonical, rival_program=bad,
+                      rival_program_sha256=digest(bad.encode()), pairs=outputs)
+        (args.out.parent / 'canonical.rkt').write_text(canonical)
+        (args.out.parent / 'rival.rkt').write_text(bad)
+    assert digest((HOME / 'generator.py').read_bytes()) == PIN
+    args.out.write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps({k: report[k] for k in ('status', 'source_sha256', 'protected_calls')}
+                     | {'seed': report.get('seed'), 'rival': report.get('rival'),
+                        'query_disagreements': report.get('query_disagreements'),
+                        'report': str(args.out)}))
+
+
+if __name__ == '__main__':
+    main()
