new file mode 100644
--- /dev/null
+++ b/repo/generators/b7be00fa3529/workspace/repair/verify.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+TASK_ID = "b7be00fa3529"
+HERE = Path(__file__).resolve().parent
+HOME = HERE.parents[1]
+GENERATOR_PATH = HOME / "generator.py"
+EVIDENCE = HERE / "evidence"
+PRE_FIX_SHA256 = "f3ca1c22fcf2920c8c71af4ddb8e67780dfdc1024aab6d48aabc9a7850b1ace6"
+RULE_HASH = "7b706ae45d08"
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(f"{TASK_ID}_repair_verify", GENERATOR_PATH)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _loose_count(grid) -> int:
+    return sum(cell not in (0, 5) for row in grid for cell in row)
+
+
+def main() -> None:
+    gen = _load_generator()
+    assert gen.RULE_HASH == RULE_HASH
+    draws = 0
+    dimensions: set[tuple[int, int]] = set()
+    loose_histogram = {n: 0 for n in range(2, 6)}
+
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in range(128):
+            sample_index = seed * 37 + 11
+            for n in range(2, 6):
+                grid = gen.generate(seed, sample_index, difficulty=difficulty, n=n)
+                assert grid == gen.generate(seed, sample_index, difficulty=difficulty, n=n)
+                assert _loose_count(grid) == n
+                assert gen.self_check(grid, difficulty=difficulty) == []
+                dimensions.add((len(grid), len(grid[0])))
+                loose_histogram[n] += 1
+                draws += 1
+
+    exact_two = gen.generate(
+        11, 190, difficulty="medium", grid_h=10, grid_w=10, n=2
+    )
+    exact_five = gen.generate(
+        11, 190, difficulty="medium", grid_h=10, grid_w=10, n=5
+    )
+    assert exact_two != exact_five
+    assert _loose_count(exact_two) == 2
+    assert _loose_count(exact_five) == 5
+
+    for texture in gen.DEGENERATE_TEXTURES:
+        try:
+            gen.generate(0, 0, texture=texture)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"diagnostic texture {texture!r} was accepted")
+
+    for bad_n in (True, 2.0, "2"):
+        try:
+            gen.generate(0, 0, n=bad_n)
+        except TypeError:
+            pass
+        else:
+            raise AssertionError(f"non-integer n override {bad_n!r} was accepted")
+
+    receipt_path = EVIDENCE / "racket.json"
+    receipt = json.loads(receipt_path.read_text())
+    assert receipt["executed_rule_hash"] == RULE_HASH
+    assert receipt["rule_hash_matches_catalog"] is True
+    assert len(receipt["results"]) == 2
+    for expected_input, expected_n, result in zip(
+        (exact_two, exact_five), (2, 5), receipt["results"], strict=True
+    ):
+        assert result["input"] == expected_input
+        assert result["valid_output"] is True
+        assert result["error"] is None
+        assert result["generator_domain"] == {"status": "valid", "errors": []}
+        assert result["output"] != result["input"]
+        assert _loose_count(result["output"]) == expected_n
+
+    report = {
+        "schema": "arc-peer-repair-audit-v1",
+        "task_id": TASK_ID,
+        "status": "passed",
+        "pre_fix_generator_sha256": PRE_FIX_SHA256,
+        "post_fix_generator_sha256": _sha256(GENERATOR_PATH),
+        "rule_hash": RULE_HASH,
+        "draws_checked": draws,
+        "difficulty_bands": ["easy", "medium", "hard"],
+        "loose_count_histogram": loose_histogram,
+        "dimensions_seen": [list(value) for value in sorted(dimensions)],
+        "exact_override_reproducer": {
+            "seed": 11,
+            "sample_index": 190,
+            "difficulty": "medium",
+            "grid_h": 10,
+            "grid_w": 10,
+            "n_values": [2, 5],
+            "inputs_differ": True,
+        },
+        "diagnostic_textures_rejected": list(gen.DEGENERATE_TEXTURES),
+        "racket_inputs": 2,
+        "racket_outputs_valid": 2,
+        "limits": "Finite 1,536-draw exact-axis audit plus two protected-Racket labels; no owner acceptance.",
+    }
+    EVIDENCE.mkdir(parents=True, exist_ok=True)
+    (EVIDENCE / "audit.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(report, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
