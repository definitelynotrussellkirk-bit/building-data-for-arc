+    gen = _load()
+    valid = set(gen.AXES["texture"]["valid"].split("|"))
+    assert valid.isdisjoint(gen.DEGENERATE_TEXTURES)
+    for texture in gen.DEGENERATE_TEXTURES:
+        with pytest.raises(ValueError):
+            gen.generate(0, 0, texture=texture)
+
