+def test_self_check_rejects_empty_and_no_motion_scenes():
+    gen = _load()
+    assert gen.self_check([[0] * 8 for _ in range(8)])
+
+    no_motion = [[0] * 8 for _ in range(8)]
+    for r in range(8):
+        no_motion[r][3] = 5
+    no_motion[7][1] = 4
+    assert gen.self_check(no_motion)
