+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+GENERATOR = Path(__file__).resolve().parents[1] / "generator.py"
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location("b13d8adbb4ed_generator_under_test", GENERATOR)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _normalize(cells):
+    min_r = min(r for r, _ in cells)
+    min_c = min(c for _, c in cells)
+    return tuple(sorted((r - min_r, c - min_c) for r, c in cells))
+
+
+def _control_outputs(cells):
+    operations = (
+        lambda r, c: (r, c),
+        lambda r, c: (c, -r),
+        lambda r, c: (-r, -c),
+        lambda r, c: (-c, r),
+        lambda r, c: (r, -c),
+    )
+    return {_normalize([op(r, c) for r, c in cells]) for op in operations}
+
+
+def _body_cells(gen, grid):
+    body = [row[:] for row in grid]
+    body[0][0] = 0
+    components = gen._sc_components(body)
+    assert len(components) == 1
+    return components[0][1]
+
+
+def test_shape_bank_distinguishes_all_five_control_codes():
+    gen = _load()
+    assert gen._ASYM_SHAPES
+    assert all(len(_control_outputs(shape)) == 5 for shape in gen._ASYM_SHAPES)
+
+
+def test_generated_shapes_are_control_distinguishing_and_self_check_clean():
+    gen = _load()
+    for difficulty in ("easy", None, "hard"):
+        for seed in range(100):
+            grid = gen.generate(seed, seed * 7 + 3, difficulty=difficulty)
+            assert gen.self_check(grid, difficulty=difficulty) == []
+            assert len(_control_outputs(_body_cells(gen, grid))) == 5
+
+
+def test_self_check_rejects_transform_ambiguous_shape():
+    gen = _load()
+    grid = [[0] * 9 for _ in range(8)]
+    grid[0][0] = 3
+    # S tetromino: identity and 180-degree rotation normalize identically.
+    for r, c in ((2, 3), (3, 3), (3, 4), (4, 4)):
+        grid[r][c] = 8
+    errors = gen.self_check(grid)
+    assert any("transform" in error.lower() or "ambiguous" in error.lower() for error in errors)
+
+
+def test_diagnostic_degenerates_are_not_ordinary_textures():
+    import pytest
+
+    gen = _load()
+    valid = set(gen.AXES["texture"]["valid"].split("|"))
+    assert valid.isdisjoint(gen.DEGENERATE_TEXTURES)
+    for texture in gen.DEGENERATE_TEXTURES:
+        with pytest.raises(ValueError):
+            gen.generate(0, 0, texture=texture)
