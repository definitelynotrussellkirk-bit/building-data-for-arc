+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from collections import Counter
+from pathlib import Path
+
+TASK_ID = "b13d8adbb4ed"
+HERE = Path(__file__).resolve().parent
+HOME = HERE.parents[1]
+GENERATOR_PATH = HOME / "generator.py"
+EVIDENCE = HERE / "evidence"
+PRE_FIX_SHA256 = "b0de5c1f0c06cb47f9f7f54111b78c7d75cafaaf420e93b90a27b5d41f48ffa6"
+RULE_HASH = "d896f57785da"
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(f"{TASK_ID}_repair_verify", GENERATOR_PATH)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _crop_body(grid):
+    work = [row[:] for row in grid]
+    work[0][0] = 0
+    cells = [(r, c) for r, row in enumerate(work) for c, v in enumerate(row) if v != 0]
+    r0 = min(r for r, _ in cells)
+    r1 = max(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    c1 = max(c for _, c in cells)
+    return [row[c0 : c1 + 1] for row in work[r0 : r1 + 1]]
+
+
+def _rotate_cw(grid):
+    return [list(row) for row in zip(*grid[::-1])]
+
+
+def _rotate_180(grid):
+    return [row[::-1] for row in grid[::-1]]
+
+
+def _rotate_ccw(grid):
+    return [list(row) for row in zip(*grid)][::-1]
+
+
+def _flip_lr(grid):
+    return [row[::-1] for row in grid]
+
+
+def _expected(grid):
+    code = grid[0][0]
+    crop = _crop_body(grid)
+    return {
+        1: crop,
+        2: _rotate_cw(crop),
+        3: _rotate_180(crop),
+        4: _rotate_ccw(crop),
+        5: _flip_lr(crop),
+    }[code]
+
+
+def main() -> None:
+    gen = _load_generator()
+    assert gen.RULE_HASH == RULE_HASH
+    assert all(gen._control_distinguishing(shape) for shape in gen._ASYM_SHAPES)
+
+    draws = 0
+    code_counts: Counter[int] = Counter()
+    shape_counts: Counter[tuple[tuple[int, int], ...]] = Counter()
+    for difficulty in ("easy", "medium", "hard"):
+        for seed in range(512):
+            sample_index = seed * 7 + 3
+            grid = gen.generate(seed, sample_index, difficulty=difficulty)
+            assert grid == gen.generate(seed, sample_index, difficulty=difficulty)
+            assert gen.self_check(grid, difficulty=difficulty) == []
+            body = [row[:] for row in grid]
+            body[0][0] = 0
+            components = gen._sc_components(body)
+            assert len(components) == 1
+            cells = components[0][1]
+            assert gen._control_distinguishing(cells)
+            code_counts[grid[0][0]] += 1
+            shape_counts[gen._normalize_shape(cells)] += 1
+            draws += 1
+    assert set(code_counts) == {1, 2, 3, 4, 5}
+    assert len(shape_counts) == len(gen._ASYM_SHAPES)
+
+    for texture in gen.DEGENERATE_TEXTURES:
+        try:
+            gen.generate(0, 0, texture=texture)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"diagnostic texture {texture!r} was accepted")
+
+    receipt = json.loads((EVIDENCE / "racket.json").read_text())
+    assert receipt["executed_rule_hash"] == RULE_HASH
+    assert receipt["rule_hash_matches_catalog"] is True
+    assert len(receipt["results"]) == 6
+
+    ambiguous = receipt["results"][0]
+    assert ambiguous["valid_output"] is True
+    assert ambiguous["generator_domain"]["status"] == "invalid"
+    assert any("transform-ambiguous" in error for error in ambiguous["generator_domain"]["errors"])
+    assert ambiguous["output"] == _crop_body(ambiguous["input"])
+    assert ambiguous["output"] == _expected(ambiguous["input"])
+
+    seen_codes = set()
+    for result in receipt["results"][1:]:
+        assert result["valid_output"] is True
+        assert result["error"] is None
+        assert result["generator_domain"] == {"status": "valid", "errors": []}
+        assert result["output"] == _expected(result["input"])
+        seen_codes.add(result["input"][0][0])
+    assert seen_codes == {1, 2, 3, 4, 5}
+
+    report = {
+        "schema": "arc-peer-repair-audit-v1",
+        "task_id": TASK_ID,
+        "status": "passed",
+        "pre_fix_generator_sha256": PRE_FIX_SHA256,
+        "post_fix_generator_sha256": _sha256(GENERATOR_PATH),
+        "rule_hash": RULE_HASH,
+        "draws_checked": draws,
+        "difficulty_bands": ["easy", "medium", "hard"],
+        "code_counts": {str(k): code_counts[k] for k in sorted(code_counts)},
+        "distinct_retained_shapes_seen": len(shape_counts),
+        "retained_shape_bank_size": len(gen._ASYM_SHAPES),
+        "pre_fix_probe": {
+            "draws": 300,
+            "transform_ambiguous": 121,
+            "rate": 121 / 300,
+            "source": "pre-fix regression/probe retained in evidence",
+        },
+        "ambiguous_hand_case": {
+            "code": 3,
+            "shape": "S tetromino",
+            "canonical_output_equals_identity_crop": True,
+            "post_fix_self_check": "invalid",
+        },
+        "racket_inputs": 6,
+        "racket_outputs_valid": 6,
+        "all_five_control_codes_racket_checked": True,
+        "diagnostic_textures_rejected": list(gen.DEGENERATE_TEXTURES),
+        "limits": "Finite 1,536-draw audit plus six protected-Racket labels; no owner acceptance.",
+    }
+    EVIDENCE.mkdir(parents=True, exist_ok=True)
+    (EVIDENCE / "audit.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(report, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
