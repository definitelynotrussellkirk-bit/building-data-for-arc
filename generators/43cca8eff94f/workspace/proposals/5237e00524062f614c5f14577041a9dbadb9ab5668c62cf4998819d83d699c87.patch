+from __future__ import annotations
+
+import random
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+TASK_ID = "4c318aba383e"
+gen, SOURCE_PATH, SOURCE_SHA256 = load_selected_generator(TASK_ID)
+
+
+def _shift(grid, *, marker_only: bool):
+    n = len(grid)
+    m = n - 1
+    if marker_only:
+        p_col = next(c for c in range(1, n) if grid[0][c] == 2)
+        p_row = next(r for r in range(1, n) if grid[r][0] == 2)
+    else:
+        p_col = next(c for c in range(1, n) if grid[0][c] != 0)
+        p_row = next(r for r in range(1, n) if grid[r][0] != 0)
+    col_shift = (n - p_col) % m
+    row_shift = (n - p_row) % m
+    interior = [row[1:] for row in grid[1:]]
+    return [
+        [interior[(r + row_shift) % m][(c + col_shift) % m] for c in range(m)]
+        for r in range(m)
+    ]
+
+
+def test_canonical_inputs_are_in_the_validator_contract():
+    pairs = canonical_pairs(TASK_ID, root=find_root(__file__), labeled_only=True)
+    assert len(pairs) >= 4
+    for pair in pairs:
+        assert gen.self_check(pair["input"]) == []
+        assert _shift(pair["input"], marker_only=True) == pair["output"]
+
+
+def test_generated_borders_contain_role_preserving_distractors():
+    grid = gen.generate(
+        0,
+        0,
+        difficulty="easy",
+        grid_n=6,
+        p_col_position=3,
+        p_row_position=4,
+        border_color=6,
+        corner_color=7,
+        interior_layout="checker",
+        interior_density=0.5,
+    )
+    assert grid[0][0] == 7
+    assert grid[0][1:] == [6, 6, 2, 6, 6]
+    assert [row[0] for row in grid[1:]] == [6, 6, 6, 2, 6]
+    assert gen.self_check(grid) == []
+    assert _shift(grid, marker_only=False) != _shift(grid, marker_only=True)
+
+
+def test_default_samples_cover_distractors_before_true_markers():
+    separating = 0
+    for seed in range(12):
+        for sample_index in range(6):
+            grid = gen.generate(seed, sample_index, difficulty=("easy", None, "hard")[sample_index % 3])
+            assert gen.self_check(grid) == []
+            assert any(v not in (0, 2) for v in grid[0][1:])
+            assert any(row[0] not in (0, 2) for row in grid[1:])
+            if _shift(grid, marker_only=False) != _shift(grid, marker_only=True):
+                separating += 1
+    assert separating >= 48
+
+
+def test_validator_rejects_marker_and_structure_errors():
+    grid = gen.generate(7, 3, grid_n=7, p_col_position=3, p_row_position=4)
+    ragged = [row[:] for row in grid]
+    ragged[-1].pop()
+    assert gen.self_check(ragged)
+
+    extra_top = [row[:] for row in grid]
+    extra_top[0][1 if extra_top[0][1] != 2 else 2] = 2
+    assert any("row 0" in error for error in gen.self_check(extra_top))
+
+    empty_interior = [row[:] for row in grid]
+    for r in range(1, len(grid)):
+        for c in range(1, len(grid)):
+            empty_interior[r][c] = 0
+    assert any("interior" in error for error in gen.self_check(empty_interior))
+
+
+@pytest.mark.parametrize("name,value", [("border_color", 0), ("border_color", 2), ("corner_color", 2)])
+def test_invalid_border_color_overrides_fail_loudly(name, value):
+    with pytest.raises(ValueError):
+        gen.generate(0, 0, **{name: value})
+
+
+def test_generation_is_deterministic_fresh_and_global_rng_pure():
+    random.seed(991)
+    state = random.getstate()
+    first = gen.generate(19, 23, difficulty="hard")
+    assert random.getstate() == state
+    second = gen.generate(19, 23, difficulty="hard")
+    assert first == second and first is not second
+    assert all(a is not b for a, b in zip(first, second))
