+from __future__ import annotations
+
+import random
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+TASK_ID = "56c98fd9e674"
+gen, SOURCE_PATH, SOURCE_SHA256 = load_selected_generator(TASK_ID)
+
+
+def _plus(grid):
+    out = [row[:] for row in grid]
+    h, w = len(grid), len(grid[0])
+    seeds = [(r, c, grid[r][c]) for r in range(h) for c in range(w) if grid[r][c] != 0]
+    for r, c, color in seeds:
+        for rr, cc in ((r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= rr < h and 0 <= cc < w:
+                out[rr][cc] = color
+    return out
+
+
+def _interior_only(grid):
+    out = [row[:] for row in grid]
+    h, w = len(grid), len(grid[0])
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            color = grid[r][c]
+            if color:
+                for rr, cc in ((r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    out[rr][cc] = color
+    return out
+
+
+def _markers(grid):
+    return [(r, c, value) for r, row in enumerate(grid) for c, value in enumerate(row) if value]
+
+
+def test_canonical_inputs_are_valid_and_match_literal_plus_oracle():
+    pairs = canonical_pairs(TASK_ID, root=find_root(__file__), labeled_only=True)
+    assert len(pairs) == 3
+    for pair in pairs:
+        assert gen.self_check(pair["input"]) == []
+        assert _plus(pair["input"]) == pair["output"]
+
+
+def test_exact_cell_count_regression_is_constructive_not_best_effort():
+    grid = gen.generate(3, 0, difficulty="easy", grid_h=5, grid_w=5, n_cells=2,
+                        position_bias="interior", n_distinct_colors=2)
+    assert len(_markers(grid)) == 2
+    assert gen.self_check(grid, meta={"n_cells": 2, "n_distinct_colors": 2}) == []
+    (r1, c1, _), (r2, c2, _) = _markers(grid)
+    assert abs(r1 - r2) + abs(c1 - c2) >= 3
+
+
+def test_distinct_color_axis_and_palette_size_alias_are_exact():
+    one_color = gen.generate(17, 0, difficulty="hard", n_cells=5, n_distinct_colors=1)
+    assert len(_markers(one_color)) == 5
+    assert len({value for _, _, value in _markers(one_color)}) == 1
+    assert gen.self_check(one_color, meta={"n_cells": 5, "n_distinct_colors": 1}) == []
+
+    aliased = gen.generate(17, 0, difficulty="hard", n_cells=5, palette_size=2)
+    assert len(_markers(aliased)) == 5
+    assert len({value for _, _, value in _markers(aliased)}) == 2
+    with pytest.raises(ValueError, match="disagree"):
+        gen.generate(0, 0, n_cells=3, palette_size=2, n_distinct_colors=3)
+
+
+def test_default_three_sample_windows_include_boundary_clipping_and_interior_cases():
+    for seed in range(12):
+        for start in range(6):
+            grids = [gen.generate(seed, start + offset, difficulty="medium") for offset in range(3)]
+            assert all(gen.self_check(grid) == [] for grid in grids)
+            boundary = [
+                grid for grid in grids
+                if any(r in (0, len(grid) - 1) or c in (0, len(grid[0]) - 1)
+                       for r, c, _ in _markers(grid))
+            ]
+            interior = [
+                grid for grid in grids
+                if all(r not in (0, len(grid) - 1) and c not in (0, len(grid[0]) - 1)
+                       for r, c, _ in _markers(grid))
+            ]
+            assert boundary and interior
+            assert any(_interior_only(grid) != _plus(grid) for grid in boundary)
+
+
+def test_corner_fixture_is_lawful_clipped_support():
+    grid = gen.generate(0, 0, texture="cells_at_corner")
+    assert gen.self_check(grid) == []
+    assert _interior_only(grid) != _plus(grid)
+    assert {(r, c) for r, c, _ in _markers(grid)} == {
+        (0, 0), (len(grid) - 1, len(grid[0]) - 1)
+    }
+
+
+def test_impossible_exact_controls_raise_instead_of_returning_a_shortfall():
+    with pytest.raises(ValueError, match="n_cells"):
+        gen.generate(0, 0, grid_h=4, grid_w=4, n_cells=5, position_bias="interior")
+
+
+def test_validator_checks_overlap_and_optional_exact_metadata():
+    overlap = [[0] * 5 for _ in range(5)]
+    overlap[2][1] = 3
+    overlap[2][3] = 4
+    assert any("overlap" in error for error in gen.self_check(overlap))
+
+    grid = gen.generate(9, 4, n_cells=3, n_distinct_colors=2)
+    assert any("n_cells" in error for error in gen.self_check(grid, meta={"n_cells": 4}))
+    assert any("n_distinct_colors" in error for error in gen.self_check(grid, meta={"n_distinct_colors": 3}))
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"n_cells": True},
+        {"n_cells": 0},
+        {"n_distinct_colors": 0},
+        {"position_bias": "unknown"},
+        {"mystery_axis": 1},
+    ],
+)
+def test_invalid_overrides_fail_loudly(overrides):
+    with pytest.raises((TypeError, ValueError)):
+        gen.generate(0, 0, **overrides)
+
+
+def test_generation_is_deterministic_fresh_and_global_rng_pure():
+    random.seed(871)
+    state = random.getstate()
+    first = gen.generate(23, 11, difficulty="hard")
+    assert random.getstate() == state
+    second = gen.generate(23, 11, difficulty="hard")
+    assert first == second and first is not second
+    assert all(a is not b for a, b in zip(first, second))
