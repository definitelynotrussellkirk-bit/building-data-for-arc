@@ -0,0 +1,217 @@
+#!/usr/bin/env python3
+"""Bounded protected-Racket probe for the missing tied-size teaching branch."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root
+
+TASK_ID = "9e21d782f5e6"
+HOME = Path(__file__).resolve().parents[1]
+ROOT = find_root(__file__)
+
+
+def _load_generator():
+    path = HOME / "generator.py"
+    name = "_probe_9e21d782f5e6_" + hashlib.sha256(str(path).encode()).hexdigest()
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_row() -> dict[str, Any]:
+    rows = [
+        json.loads(line)
+        for line in canonical_path(ROOT).open(encoding="utf-8")
+        if json.loads(line).get("task_id") == TASK_ID
+    ]
+    if len(rows) != 1:
+        raise ValueError(f"expected one canonical row, found {len(rows)}")
+    return rows[0]
+
+
+def _components(grid: list[list[int]]) -> list[dict[str, Any]]:
+    height, width = len(grid), len(grid[0])
+    seen: set[tuple[int, int]] = set()
+    records = []
+    for row in range(height):
+        for col in range(width):
+            color = grid[row][col]
+            if color == 0 or (row, col) in seen:
+                continue
+            stack = [(row, col)]
+            seen.add((row, col))
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and (nr, nc) not in seen
+                        and grid[nr][nc] == color
+                    ):
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
+            records.append({
+                "color": color,
+                "size": len(cells),
+                "top": min(rr for rr, _ in cells),
+                "left": min(cc for _, cc in cells),
+            })
+    return records
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _execute(bridge: RacketBridge, wrapped: str, grid: list[list[int]]) -> list[list[int]]:
+    return bridge.eval_text(f"({wrapped} {_literal(grid)})")
+
+
+def _sha_text(value: str) -> str:
+    return hashlib.sha256(value.encode()).hexdigest()
+
+
+def run(out: Path) -> dict[str, Any]:
+    if out.exists():
+        raise FileExistsError(out)
+    generator = _load_generator()
+    canonical = _canonical_row()
+    selected = canonical["program_solution"]
+    old = "(lambda (a b) (cond ((not (= (first a) (first b))) (> (first a) (first b))) ((not (= (second a) (second b))) (< (second a) (second b))) ((not (= (third a) (third b))) (< (third a) (third b))) (else (< (fourth a) (fourth b)))))"
+    new = "(lambda (a b) (cond ((not (= (first a) (first b))) (> (first a) (first b))) (else (> (fourth a) (fourth b)))))"
+    if selected.count(old) != 1:
+        raise ValueError("canonical comparator spelling changed")
+    rival = selected.replace(old, new)
+
+    demo_specs = [(0, 0, "easy"), (1, 1, "medium"), (2, 2, "hard"), (3, 3, "medium")]
+    demos = []
+    generated = []
+    for seed, sample_index, difficulty in demo_specs:
+        grid = generator.generate(seed, sample_index, difficulty=difficulty)
+        errors = generator.self_check(grid, difficulty=difficulty)
+        if errors:
+            raise AssertionError(f"invalid generated demo {seed}/{sample_index}: {errors}")
+        records = _components(grid)
+        sizes = [record["size"] for record in records]
+        if len(set(sizes)) != len(sizes):
+            raise AssertionError("normal sampler unexpectedly emitted a tied-size demo")
+        generated.append((seed, sample_index, difficulty, grid, records))
+
+    query = canonical["test"] if isinstance(canonical["test"], dict) else canonical["test"][0]
+    query_records = _components(query["input"])
+    size_counts: dict[int, int] = {}
+    for record in query_records:
+        size_counts[record["size"]] = size_counts.get(record["size"], 0) + 1
+    tied_sizes = sorted(size for size, count in size_counts.items() if count > 1)
+    if not tied_sizes:
+        raise AssertionError("canonical query no longer exercises an equal-size tie")
+
+    with RacketBridge(timeout=30, startup_timeout=60, max_calls_before_restart=64) as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires protected Racket")
+        selected_wrapped = wrap_rule(selected)
+        rival_wrapped = wrap_rule(rival)
+        for seed, sample_index, difficulty, grid, records in generated:
+            expected = _execute(bridge, selected_wrapped, grid)
+            counterfactual = _execute(bridge, rival_wrapped, grid)
+            if expected != counterfactual:
+                raise AssertionError("descending-color tie rival changed a distinct-size demo")
+            demos.append({
+                "seed": seed,
+                "sample_index": sample_index,
+                "difficulty": difficulty,
+                "components": records,
+                "output_sha256": hashlib.sha256(json.dumps(expected, separators=(",", ":")).encode()).hexdigest(),
+                "rival_matches": True,
+            })
+        query_expected = _execute(bridge, selected_wrapped, query["input"])
+        query_counterfactual = _execute(bridge, rival_wrapped, query["input"])
+        if query_expected != query["output"]:
+            raise AssertionError("protected canonical label differs from stored canonical query")
+        if query_counterfactual == query_expected:
+            raise AssertionError("tie rival did not change the canonical query")
+
+    report = {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "task_id": TASK_ID,
+        "status": "finding",
+        "finding": (
+            "Normal generated demonstrations have strictly distinct blob sizes, so a rule that sorts "
+            "by descending area but breaks equal-size ties by descending color fits them all. The "
+            "official query contains an equal-size tie and the rival changes its protected-Racket label."
+        ),
+        "selected_program_sha256": _sha_text(selected),
+        "rival": {
+            "name": "descending_area_then_descending_color",
+            "program_sha256": _sha_text(rival),
+            "fits_all_generated_demos": True,
+            "changes_query": True,
+        },
+        "generated_demonstrations": demos,
+        "query_case": {
+            "source": "canonical test",
+            "input": query["input"],
+            "components": query_records,
+            "tied_sizes": tied_sizes,
+            "output": query_expected,
+            "counterfactual_output": query_counterfactual,
+        },
+        "racket": {
+            key: identity[key]
+            for key in (
+                "schema", "backend", "protected", "binary_sha256", "prelude_sha256",
+                "bridge_sha256", "boot_script_sha256", "candidate_symbol_policy_sha256",
+            )
+            if key in identity
+        },
+        "next_repair": (
+            "Add a non-degenerate normal profile with at least two equal-area blobs whose color order "
+            "disagrees with top-left order, then teach and test the canonical top/left/color tie chain."
+        ),
+        "limits": "Four generated demonstrations and one canonical query; this is a bounded counterexample, not a full curriculum audit.",
+    }
+    out.mkdir(parents=True, exist_ok=False)
+    (out / "learnability.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    (out / "case.json").write_text(json.dumps({
+        "task_id": TASK_ID,
+        "program": selected,
+        "rival_program": rival,
+        **report["query_case"],
+    }, indent=2, sort_keys=True) + "\n")
+    return report
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = run(args.out)
+    print(json.dumps({
+        "status": report["status"],
+        "task_id": report["task_id"],
+        "rival": report["rival"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
