+#!/usr/bin/env python3
+"""Bounded protected-Racket probe for default lesson branch coverage."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root
+
+TASK_ID = "abee0b4bed48"
+HOME = Path(__file__).resolve().parents[1]
+ROOT = find_root(__file__)
+
+
+def _load_generator():
+    path = HOME / "generator.py"
+    name = "_probe_abee0b4bed48_" + hashlib.sha256(str(path).encode()).hexdigest()
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_program() -> str:
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(ROOT).open(encoding="utf-8")
+        if (row := json.loads(line)).get("task_id") == TASK_ID
+    }
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return next(iter(programs))
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _execute(bridge: RacketBridge, wrapped: str, grid: list[list[int]]) -> list[list[int]]:
+    return bridge.eval_text(f"({wrapped} {_literal(grid)})")
+
+
+def _sha(value: str) -> str:
+    return hashlib.sha256(value.encode()).hexdigest()
+
+
+def run(out: Path) -> dict[str, Any]:
+    if out.exists():
+        raise FileExistsError(out)
+    generator = _load_generator()
+    selected = _canonical_program()
+    old = "((= cnt 8) 3)"
+    new = "((= cnt 8) 4)"
+    if selected.count(old) != 1:
+        raise ValueError("canonical eight-cell branch spelling changed")
+    rival = selected.replace(old, new)
+
+    seed = 22
+    difficulty = "easy"
+    grids = [generator.generate(seed, index, difficulty=difficulty) for index in range(4)]
+    analyses = [generator._analysis(grid) for grid in grids]
+    if any(analysis["errors"] for analysis in analyses):
+        raise AssertionError("generated lesson contains an invalid scene")
+    demo_kinds = sorted({record["kind"] for analysis in analyses[:3] for record in analysis["records"]})
+    query_kinds = sorted({record["kind"] for record in analyses[3]["records"]})
+    if "eight" in demo_kinds or "eight" not in query_kinds:
+        raise AssertionError("selected branch-coverage witness no longer holds")
+
+    with RacketBridge(timeout=30, startup_timeout=60, max_calls_before_restart=64) as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("probe requires protected Racket")
+        selected_wrapped = wrap_rule(selected)
+        rival_wrapped = wrap_rule(rival)
+        demo_rows = []
+        for index, grid in enumerate(grids[:3]):
+            expected = _execute(bridge, selected_wrapped, grid)
+            counterfactual = _execute(bridge, rival_wrapped, grid)
+            if expected != generator.rule_mirror(grid):
+                raise AssertionError(f"canonical Racket/Python mismatch at demo {index}")
+            if counterfactual != expected:
+                raise AssertionError("eight-cell rival changed a demo without an eight-cell zone")
+            demo_rows.append({
+                "sample_index": index,
+                "profile": analyses[index]["profile"],
+                "branch_kinds": sorted({record["kind"] for record in analyses[index]["records"]}),
+                "rival_matches": True,
+            })
+        query_expected = _execute(bridge, selected_wrapped, grids[3])
+        query_counterfactual = _execute(bridge, rival_wrapped, grids[3])
+        if query_expected != generator.rule_mirror(grids[3]):
+            raise AssertionError("canonical Racket/Python mismatch at query")
+        if query_counterfactual == query_expected:
+            raise AssertionError("eight-cell rival did not change the query")
+
+    report = {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "task_id": TASK_ID,
+        "status": "finding",
+        "finding": (
+            "A default three-demonstration easy lesson can omit the eight-cell branch entirely. "
+            "Changing the unseen branch from label 3 to label 4 fits all three demonstrations "
+            "but changes the fourth generated query under protected Racket."
+        ),
+        "lesson": {
+            "seed": seed,
+            "difficulty": difficulty,
+            "demonstrations": demo_rows,
+            "visible_branch_kinds": demo_kinds,
+            "query": {
+                "sample_index": 3,
+                "profile": analyses[3]["profile"],
+                "branch_kinds": query_kinds,
+                "input": grids[3],
+                "output": query_expected,
+                "counterfactual_output": query_counterfactual,
+            },
+        },
+        "selected_program_sha256": _sha(selected),
+        "rival": {
+            "name": "eight_cells_map_to_4",
+            "program_sha256": _sha(rival),
+            "fits_all_demos": True,
+            "changes_query": True,
+        },
+        "racket": {
+            key: identity[key]
+            for key in (
+                "schema", "backend", "protected", "binary_sha256", "prelude_sha256",
+                "bridge_sha256", "boot_script_sha256", "candidate_symbol_policy_sha256",
+            )
+            if key in identity
+        },
+        "next_repair": (
+            "Assemble demonstrations by branch coverage (one, eight, top, bottom, other) or use a "
+            "deterministic profile schedule, rather than taking an unconstrained consecutive default window."
+        ),
+        "limits": "One three-demo/fourth-query default lesson and one branch-local rival; no universal ambiguity claim.",
+    }
+    out.mkdir(parents=True, exist_ok=False)
+    (out / "learnability.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    (out / "case.json").write_text(json.dumps({
+        "task_id": TASK_ID,
+        "program": selected,
+        "rival_program": rival,
+        "seed": seed,
+        "difficulty": difficulty,
+        **report["lesson"]["query"],
+    }, indent=2, sort_keys=True) + "\n")
+    return report
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = run(args.out)
+    print(json.dumps({
+        "status": report["status"],
+        "task_id": report["task_id"],
+        "rival": report["rival"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
