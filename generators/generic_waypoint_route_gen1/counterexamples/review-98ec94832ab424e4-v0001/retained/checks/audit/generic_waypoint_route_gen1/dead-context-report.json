         (list (list r c) (list (+ r 1) (- c 1)) (list (+ r 1) (+ c 1))))\n          ((> (first delta) 0)\n           (list (list r c) (list (- r 1) (- c 1)) (list (- r 1) (+ c 1))))\n          ((< (second delta) 0)\n           (list (list r c) (list (- r 1) (+ c 1)) (list (+ r 1) (+ c 1))))\n          (else\n           (list (list r c) (list (- r 1) (- c 1)) (list (+ r 1) (- c 1))))))\n   (paint-cells (empty-grid h pw bg) arrow (obj-color cursor)))))",
