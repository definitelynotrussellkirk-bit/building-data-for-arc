+    assert report["status"] == "passed"
+    assert report["counts"]["jobs"] == 9
+    assert report["counts"]["rivals"] == 4
+    assert report["counts"]["racket_evaluations"] == 0
+    assert all(report["canonical_profile_hits"][band] >= 1 for band in report["difficulties"])
