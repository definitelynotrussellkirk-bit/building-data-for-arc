+"""Semantic, control, and lesson regressions for b9ba0104b1b6."""
+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib.util
+import json
+import random
+from pathlib import Path
+
+import pytest
+
+from reviewer_support import canonical_pairs, canonical_path, find_root
+
+TASK_ID = "b9ba0104b1b6"
+ROOT = find_root(__file__)
+SOURCE = Path(__file__).resolve().parent.parent / "generator.py"
+SPEC = importlib.util.spec_from_file_location(f"review_{TASK_ID}", SOURCE)
+assert SPEC and SPEC.loader
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
+PAIRS = canonical_pairs(TASK_ID, root=ROOT, labeled_only=True)
+
+
+def _selected_rule_source() -> str:
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID and row.get("program_solution"):
+                return row["program_solution"]
+    raise AssertionError("selected canonical rule source not found")
+
+
+def _bbox(grid: list[list[int]]) -> tuple[int, int, int, int]:
+    cells = [
+        (row, col)
+        for row, values in enumerate(grid)
+        for col, value in enumerate(values)
+        if value != 0
+    ]
+    assert cells
+    return (
+        min(row for row, _ in cells),
+        max(row for row, _ in cells),
+        min(col for _, col in cells),
+        max(col for _, col in cells),
+    )
+
+
+def _bbox_corners(grid: list[list[int]]) -> tuple[int, int, int, int]:
+    r0, r1, c0, c1 = _bbox(grid)
+    return grid[r0][c0], grid[r0][c1], grid[r1][c0], grid[r1][c1]
+
+
+def test_rule_hash_is_pinned_to_selected_canonical_source():
+    expected = hashlib.sha256(
+        " ".join(_selected_rule_source().split()).encode()
+    ).hexdigest()[:12]
+    assert GEN.RULE_HASH == expected == "9de647fc93bf"
+
+
+def test_canonical_pairs_are_accepted_and_mirrored_exactly():
+    assert len(PAIRS) == 4
+    for pair in PAIRS:
+        source = copy.deepcopy(pair["input"])
+        assert GEN.self_check(source) == []
+        assert GEN.strict_canonical_like(source) == []
+        assert GEN.rule_mirror(source) == pair["output"]
+        assert source == pair["input"]
+
+
+def test_default_schedule_matches_canonical_profiles_then_reaches_30_by_30():
+    expected = [
+        (11, 12, 5, 3, 1, "noncorner_cross"),
+        (10, 12, 4, 4, 2, "disconnected_extents"),
+        (12, 12, 3, 5, 8, "dense_hole"),
+        (16, 18, 6, 6, 3, "noncorner_cross"),
+        (22, 24, 6, 5, 6, "disconnected_extents"),
+        (30, 30, 6, 6, 4, "dense_hole"),
+    ]
+    observed = []
+    for sample_index in range(6):
+        grid = GEN.generate(20261024, sample_index)
+        info = GEN.observe_overrides(grid)
+        observed.append((
+            info["grid_h"], info["grid_w"], info["shape_h"],
+            info["shape_w"], info["fg_color"], info["texture"],
+        ))
+        assert GEN.self_check(grid) == []
+    assert observed == expected
+
+
+@pytest.mark.parametrize("difficulty", [None, "easy", "medium", "hard"])
+@pytest.mark.parametrize(
+    "case",
+    [
+        {
+            "grid_h": 10, "grid_w": 10, "shape_h": 3, "shape_w": 3,
+            "fg_color": 1, "texture": "noncorner_cross",
+        },
+        {
+            "grid_h": 30, "grid_w": 30, "shape_h": 6, "shape_w": 6,
+            "fg_color": 9, "texture": "dense_hole",
+        },
+        {
+            "grid_h": 18, "grid_w": 19, "shape_h": 5, "shape_w": 4,
+            "fg_color": 6, "texture": "disconnected_extents",
+        },
+    ],
+)
+def test_exact_declared_overrides_are_observable(difficulty, case):
+    grid = GEN.generate(4101, 23, difficulty=difficulty, **case)
+    assert GEN.observe_overrides(grid) == case
+
+
+def test_invalid_controls_fail_closed_and_without_coercion():
+    with pytest.raises(ValueError, match="unknown override"):
+        GEN.generate(1, 0, bogus_axis="ignored")
+    with pytest.raises(ValueError, match="unknown difficulty"):
+        GEN.generate(1, 0, difficulty="extreme")
+    with pytest.raises((TypeError, ValueError)):
+        GEN.generate(1, 0, grid_h=True)
+    with pytest.raises((TypeError, ValueError)):
+        GEN.generate(1, 0, fg_color=2.5)
+    with pytest.raises(ValueError):
+        GEN.generate(1, 0, shape_h=7)
+    with pytest.raises(ValueError):
+        GEN.generate(1, 0, texture="rectangle")
+
+
+def test_constructive_textures_supply_real_shortcut_counterexamples():
+    scenes = {
+        texture: GEN.generate(
+            9182,
+            index,
+            grid_h=18,
+            grid_w=19,
+            shape_h=6,
+            shape_w=6,
+            fg_color=7,
+            texture=texture,
+        )
+        for index, texture in enumerate(GEN.HELPFUL_TEXTURES)
+    }
+    cross = scenes["noncorner_cross"]
+    disconnected = scenes["disconnected_extents"]
+    dense = scenes["dense_hole"]
+
+    assert _bbox_corners(cross) == (0, 0, 0, 0)
+    assert _bbox_corners(disconnected) == (0, 0, 0, 0)
+    assert GEN.SEMANTIC_WITNESSES["noncorner_extents"](cross)
+    assert GEN.SEMANTIC_WITNESSES["multiple_components_define_bbox"](disconnected)
+    assert GEN.SEMANTIC_WITNESSES["interior_background"](dense)
+
+    assert GEN.SEMANTIC_RIVALS["identity"](cross) != GEN.rule_mirror(cross)
+    assert (
+        GEN.SEMANTIC_RIVALS["first_component_crop"](disconnected)
+        != GEN.rule_mirror(disconnected)
+    )
+    assert GEN.SEMANTIC_RIVALS["solid_bbox"](dense) != GEN.rule_mirror(dense)
+    assert GEN.SEMANTIC_RIVALS["trim_top_left_only"](cross) != GEN.rule_mirror(cross)
+
+
+def test_every_consecutive_three_demo_window_identifies_the_rule():
+    for difficulty in (None, "easy", "medium", "hard"):
+        for seed in (0, 17, 97):
+            for start in range(12):
+                pairs = []
+                for sample_index in range(start, start + GEN.EXAMPLES_NEEDED + 1):
+                    grid = GEN.generate(seed, sample_index, difficulty=difficulty)
+                    pairs.append({"input": grid, "output": GEN.rule_mirror(grid)})
+                demos, query = pairs[:-1], pairs[-1]
+                assert GEN.lesson_identifiable(demos, query) == []
+                for name, rival in GEN.SEMANTIC_RIVALS.items():
+                    assert any(
+                        rival(pair["input"]) != pair["output"] for pair in demos
+                    ), (difficulty, seed, start, name)
+
+
+def test_diagnostic_degenerates_are_explicit_and_not_mixed_with_ordinary_axes():
+    identity = GEN.generate(9, 0, texture="fills_grid")
+    assert GEN.rule_mirror(identity) == identity
+    singleton = GEN.generate(9, 0, texture="single_cell")
+    assert len(GEN.rule_mirror(singleton)) == 1
+    assert len(GEN.rule_mirror(singleton)[0]) == 1
+    with pytest.raises(ValueError, match="degenerate texture cannot be combined"):
+        GEN.generate(9, 0, texture="single_cell", grid_h=10)
+
+
+def test_generation_is_deterministic_fresh_and_process_rng_pure():
+    random.seed(1459)
+    state = random.getstate()
+    first = GEN.generate(42, 17, difficulty="hard")
+    assert random.getstate() == state
+    second = GEN.generate(42, 17, difficulty="hard")
+    assert first == second
+    assert first is not second
+    assert all(left is not right for left, right in zip(first, second, strict=True))
+
+
+def test_cropped_outputs_have_real_seed_level_geometry_diversity():
+    outputs = {
+        json.dumps(
+            GEN.rule_mirror(GEN.generate(seed, sample_index)),
+            separators=(",", ":"),
+        )
+        for seed in range(30)
+        for sample_index in range(6)
+    }
+    assert len(outputs) >= 45
+
+
+def test_difficulty_bands_change_defaults_and_scale_canvas_area():
+    for seed in (0, 17, 97):
+        band_areas = {band: [] for band in ("easy", "medium", "hard")}
+        band_profiles = {band: set() for band in band_areas}
+        for sample_index in range(20):
+            scenes = {
+                band: GEN.generate(seed, sample_index, difficulty=band)
+                for band in ("easy", "medium", "hard")
+            }
+            encoded = {
+                band: json.dumps(scene, separators=(",", ":"))
+                for band, scene in scenes.items()
+            }
+            assert len(set(encoded.values())) == 3
+            for band, scene in scenes.items():
+                band_areas[band].append(len(scene) * len(scene[0]))
+                band_profiles[band].add((len(scene), len(scene[0])))
+        means = {
+            band: sum(values) / len(values)
+            for band, values in band_areas.items()
+        }
+        assert means["easy"] < means["medium"] < means["hard"]
+        canonical_profiles = {(11, 12), (10, 12), (12, 12)}
+        for profiles in band_profiles.values():
+            assert profiles & canonical_profiles
