+#!/usr/bin/env python3
+"""Bounded source-bound learnability audit for b9ba0104b1b6.
+
+The probe checks every consecutive three-demonstration phase requested by the
+caller against the generator's declared rivals, verifies canonical-profile
+support in every difficulty band, and optionally re-executes every distinct
+label through the live protected Racket implementation.  It is a finite audit,
+not a proof of unique identifiability or training admission.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import contextmanager
+from copy import deepcopy
+import hashlib
+import importlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import traceback
+
+TASK_ID = "b9ba0104b1b6"
+PROGRAM = "(rule! crop-to-content)"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+GENERATOR_PATH = HERE.parent / "generator.py"
+CANONICAL_PROFILES = {(11, 12), (10, 12), (12, 12)}
+
+
+def _load_generator():
+    module_name = (
+        f"_{TASK_ID}_audit_generator_"
+        f"{hashlib.sha256(GENERATOR_PATH.read_bytes()).hexdigest()}"
+    )
+    spec = importlib.util.spec_from_file_location(module_name, GENERATOR_PATH)
+    if spec is None or spec.loader is None:
+        raise ImportError(GENERATOR_PATH)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+GEN = _load_generator()
+
+
+def _raw(value) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    ).encode("utf-8")
+
+
+def _sha_file(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join(
+        "(" + " ".join(map(str, row)) + ")" for row in grid
+    ) + ")"
+
+
+@contextmanager
+def _protected_runtime():
+    before_path = list(sys.path)
+    sys.path[:0] = [str(ROOT / "shared" / "runtime")]
+    saved = {
+        key: value
+        for key, value in sys.modules.items()
+        if key.split(".")[0] in {"arc_repl", "puzzle_generators"}
+    }
+    for key in saved:
+        del sys.modules[key]
+    bridge = None
+    try:
+        bridge_module = importlib.import_module("arc_repl.racket_bridge")
+        wrap_module = importlib.import_module("puzzle_generators.rule_wrap")
+        bridge = bridge_module.RacketBridge()
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise ValueError("audit requires the live protected Racket backend")
+        yield bridge, wrap_module.wrap_rule, identity
+    finally:
+        if bridge is not None:
+            bridge.close()
+        for key in list(sys.modules):
+            if key.split(".")[0] in {"arc_repl", "puzzle_generators"}:
+                del sys.modules[key]
+        sys.modules.update(saved)
+        sys.path[:] = before_path
+
+
+def _validate_inputs(seeds, starts, difficulties):
+    seeds = tuple(dict.fromkeys(seeds))
+    starts = tuple(dict.fromkeys(starts))
+    difficulties = tuple(dict.fromkeys(difficulties))
+    if not seeds or any(type(value) is not int or value < 0 for value in seeds):
+        raise ValueError("seeds must be distinct nonnegative integers")
+    if not starts or any(type(value) is not int or value < 0 for value in starts):
+        raise ValueError("starts must be distinct nonnegative integers")
+    legal = {None, "easy", "medium", "hard"}
+    if not difficulties or any(value not in legal for value in difficulties):
+        raise ValueError("difficulty must be None, easy, medium, or hard")
+    return seeds, starts, difficulties
+
+
+def audit(
+    *,
+    seeds=(0, 17, 97),
+    starts=(0, 1, 2),
+    difficulties=(None, "easy", "medium", "hard"),
+    protected=True,
+):
+    seeds, starts, difficulties = _validate_inputs(seeds, starts, difficulties)
+    expected_hash = hashlib.sha256(" ".join(PROGRAM.split()).encode()).hexdigest()[:12]
+    if expected_hash != GEN.RULE_HASH:
+        raise ValueError(
+            f"selected program hash {expected_hash} differs from generator {GEN.RULE_HASH}"
+        )
+
+    failures: list[dict] = []
+    jobs: list[dict] = []
+    unique_pairs: dict[bytes, dict] = {}
+    witnesses: dict[str, dict] = {}
+    profile_hits = {str(value): 0 for value in difficulties}
+    source_hashes = {
+        GENERATOR_PATH.relative_to(ROOT).as_posix(): _sha_file(GENERATOR_PATH),
+        Path(__file__).resolve().relative_to(ROOT).as_posix(): _sha_file(Path(__file__).resolve()),
+    }
+
+    for difficulty in difficulties:
+        difficulty_key = str(difficulty)
+        for seed in seeds:
+            for start in starts:
+                row = {
+                    "difficulty": difficulty,
+                    "seed": seed,
+                    "start": start,
+                    "status": "passed",
+                    "rival_refutations": {},
+                }
+                try:
+                    pairs = []
+                    for sample_index in range(start, start + GEN.EXAMPLES_NEEDED + 1):
+                        source = GEN.generate(
+                            seed, sample_index, difficulty=difficulty
+                        )
+                        errors = GEN.self_check(source, difficulty=difficulty)
+                        if errors:
+                            raise AssertionError(
+                                f"self_check rejected sample {sample_index}: {errors}"
+                            )
+                        pair = {"input": source, "output": GEN.rule_mirror(source)}
+                        pairs.append(pair)
+                        unique_pairs.setdefault(_raw(source), deepcopy(pair))
+                        if (len(source), len(source[0])) in CANONICAL_PROFILES:
+                            profile_hits[difficulty_key] += 1
+                    demos, query = pairs[:-1], pairs[-1]
+                    reasons = GEN.lesson_identifiable(demos, query)
+                    if reasons:
+                        raise AssertionError(f"lesson ambiguity: {reasons}")
+                    for name, rival in GEN.SEMANTIC_RIVALS.items():
+                        refuted = [
+                            index
+                            for index, pair in enumerate(demos)
+                            if rival(pair["input"]) != pair["output"]
+                        ]
+                        row["rival_refutations"][name] = refuted
+                        if not refuted:
+                            raise AssertionError(
+                                f"rival {name!r} fits all visible demonstrations"
+                            )
+                        if name not in witnesses:
+                            pair = demos[refuted[0]]
+                            witnesses[name] = {
+                                "difficulty": difficulty,
+                                "seed": seed,
+                                "start": start,
+                                "demonstration_index": refuted[0],
+                                "input": pair["input"],
+                                "intended_output": pair["output"],
+                                "rival_output": rival(pair["input"]),
+                            }
+                except Exception as exc:
+                    row["status"] = "failed"
+                    failures.append({
+                        "kind": "job_failed",
+                        "difficulty": difficulty,
+                        "seed": seed,
+                        "start": start,
+                        "error": f"{type(exc).__name__}: {exc}",
+                        "traceback": traceback.format_exc(),
+                    })
+                jobs.append(row)
+
+    for difficulty in difficulties:
+        key = str(difficulty)
+        if profile_hits[key] < 1:
+            failures.append({
+                "kind": "missing_canonical_profile",
+                "difficulty": difficulty,
+            })
+
+    runtime_identity = None
+    racket_evaluations = 0
+    if protected and not failures:
+        with _protected_runtime() as (bridge, wrap_rule, identity):
+            runtime_identity = {
+                key: identity[key]
+                for key in (
+                    "schema",
+                    "backend",
+                    "protected",
+                    "binary_sha256",
+                    "prelude_sha256",
+                    "bridge_sha256",
+                    "boot_script_sha256",
+                    "candidate_symbol_policy_sha256",
+                )
+                if key in identity
+            }
+            wrapped = wrap_rule(PROGRAM)
+            for pair in unique_pairs.values():
+                actual = bridge.eval_text(
+                    f"({wrapped} {_literal(pair['input'])})"
+                )
+                racket_evaluations += 1
+                if actual != pair["output"]:
+                    failures.append({
+                        "kind": "racket_label_mismatch",
+                        "input_sha256": hashlib.sha256(_raw(pair["input"])).hexdigest(),
+                        "expected": pair["output"],
+                        "actual": actual,
+                    })
+
+    output_hashes = {
+        hashlib.sha256(_raw(pair["output"])).hexdigest()
+        for pair in unique_pairs.values()
+    }
+    report = {
+        "schema": "b9ba0104b1b6-adversarial-review-v1",
+        "task_id": TASK_ID,
+        "status": "failed" if failures else "passed",
+        "source_hashes": source_hashes,
+        "selected_program": PROGRAM,
+        "selected_program_sha256": hashlib.sha256(PROGRAM.encode()).hexdigest(),
+        "rule_hash": GEN.RULE_HASH,
+        "seeds": list(seeds),
+        "starts": list(starts),
+        "difficulties": list(difficulties),
+        "canonical_profile_hits": profile_hits,
+        "counts": {
+            "jobs": len(jobs),
+            "passed_jobs": sum(row["status"] == "passed" for row in jobs),
+            "unique_inputs": len(unique_pairs),
+            "unique_outputs": len(output_hashes),
+            "rivals": len(GEN.SEMANTIC_RIVALS),
+            "racket_evaluations": racket_evaluations,
+        },
+        "racket": runtime_identity,
+        "jobs": jobs,
+        "witnesses": witnesses,
+        "failures": failures,
+        "limits": (
+            "Finite seeds, starts, three-demo windows and four declared rivals only; "
+            "no universal identifiability, owner approval, or training admission."
+        ),
+        "training_admitted": False,
+    }
+    return report
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, action="append")
+    parser.add_argument("--start", type=int, action="append")
+    parser.add_argument("--difficulty", action="append")
+    parser.add_argument("--no-racket", action="store_true")
+    args = parser.parse_args(argv)
+    difficulties = (
+        (None, "easy", "medium", "hard")
+        if args.difficulty is None
+        else tuple(None if value == "none" else value for value in args.difficulty)
+    )
+    report = audit(
+        seeds=(0, 17, 97) if args.seed is None else tuple(args.seed),
+        starts=(0, 1, 2) if args.start is None else tuple(args.start),
+        difficulties=difficulties,
+        protected=not args.no_racket,
+    )
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_bytes(_raw(report) + b"\n")
+    print(json.dumps({
+        "status": report["status"],
+        "counts": report["counts"],
+        "canonical_profile_hits": report["canonical_profile_hits"],
+        "failures": report["failures"],
+        "out": str(args.out),
+    }, sort_keys=True))
+    return int(report["status"] != "passed")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
