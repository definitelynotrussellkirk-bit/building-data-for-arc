+"""Source-bound reproducer for cyan-count and interacting-control defects."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+
+TASK_ID = "8e5125b84b87"
+HOME = Path(__file__).resolve().parents[1]
+ROOT = HOME.parents[1]
+for candidate in (ROOT / "src", ROOT / "shared/runtime"):
+    if str(candidate) not in sys.path:
+        sys.path.insert(0, str(candidate))
+
+from arc_repl.racket_bridge import RacketBridge
+from arcpuzzles import Catalog
+from puzzle_generators.rule_wrap import wrap_rule
+
+
+def _raw(value: Any) -> bytes:
+    return (
+        json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False)
+        + "\n"
+    ).encode("utf-8")
+
+
+def _hash_bytes(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def _grid_hash(grid: list[list[int]]) -> str:
+    return _hash_bytes(
+        json.dumps(grid, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+    )
+
+
+def _load_generator():
+    path = HOME / "generator.py"
+    name = "_peer_8e5125_" + _hash_bytes(path.read_bytes())
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return path, module
+
+
+def _canonical_program() -> str:
+    record = Catalog(ROOT).get(TASK_ID)
+    programs = {
+        row["program_solution"]
+        for row in record["variants"]
+        if isinstance(row.get("program_solution"), str)
+    }
+    if len(programs) != 1:
+        raise ValueError("expected one selected canonical program")
+    return next(iter(programs))
+
+
+def _literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join(
+        "(" + " ".join(map(str, row)) + ")" for row in grid
+    ) + ")"
+
+
+def _cyan_count(grid: list[list[int]]) -> int:
+    return sum(value == 8 for row in grid for value in row)
+
+
+def build_report(*, include_racket: bool = True) -> dict[str, Any]:
+    source, generator = _load_generator()
+    source_hash = _hash_bytes(source.read_bytes())
+
+    advertised = {
+        "requested": 50,
+        "height": 14,
+        "width": 14,
+        "advertised_upper_bound": (14 * 14) // 2,
+    }
+    try:
+        grid = generator.generate(
+            0,
+            0,
+            difficulty="hard",
+            grid_h=14,
+            grid_w=14,
+            cyan_count=50,
+            cyan_layout="row",
+            cyan_row_bias="spread",
+            decoy_palette_size=0,
+        )
+        advertised.update(
+            {
+                "accepted": True,
+                "actual": _cyan_count(grid),
+                "grid_sha256": _grid_hash(grid),
+            }
+        )
+    except Exception as exc:
+        advertised.update(
+            {
+                "accepted": False,
+                "error": type(exc).__name__,
+                "message": str(exc),
+            }
+        )
+
+    common = {
+        "difficulty": "hard",
+        "grid_h": 14,
+        "grid_w": 14,
+        "cyan_count": 49,
+        "cyan_row_bias": "spread",
+        "decoy_palette_size": 0,
+    }
+    row_grid = generator.generate(0, 0, **common, cyan_layout="row")
+    column_grid = generator.generate(0, 0, **common, cyan_layout="column")
+    truncated = {
+        "requested": 49,
+        "row_actual": _cyan_count(row_grid),
+        "column_actual": _cyan_count(column_grid),
+        "row_grid_sha256": _grid_hash(row_grid),
+        "column_grid_sha256": _grid_hash(column_grid),
+        "row_self_check": generator.self_check(row_grid),
+        "column_self_check": generator.self_check(column_grid),
+    }
+
+    diagonal_common = {
+        "difficulty": "hard",
+        "grid_h": 14,
+        "grid_w": 14,
+        "cyan_count": 6,
+        "cyan_layout": "diagonal",
+        "decoy_palette_size": 0,
+    }
+    top = generator.generate(13, 2, **diagonal_common, cyan_row_bias="top")
+    bottom = generator.generate(13, 2, **diagonal_common, cyan_row_bias="bottom")
+    row_bias = {
+        "requested_values": ["top", "bottom"],
+        "same_grid": top == bottom,
+        "top_sha256": _grid_hash(top),
+        "bottom_sha256": _grid_hash(bottom),
+        "actual_cyan_count": _cyan_count(top),
+    }
+
+    try:
+        unknown_grid = generator.generate(0, 0, difficulty="easy", unknown_control=7)
+        unknown = {
+            "accepted": True,
+            "grid_sha256": _grid_hash(unknown_grid),
+            "dimensions": [len(unknown_grid), len(unknown_grid[0])],
+            "self_check": generator.self_check(unknown_grid),
+        }
+    except Exception as exc:
+        unknown = {
+            "accepted": False,
+            "error": type(exc).__name__,
+            "message": str(exc),
+        }
+
+    racket = None
+    if include_racket:
+        program = _canonical_program()
+        with RacketBridge(max_calls_before_restart=8) as bridge:
+            output = bridge.eval_text(f"({wrap_rule(program)} {_literal(row_grid)})")
+            racket = {
+                "program_sha256": _hash_bytes(program.encode("utf-8")),
+                "input": row_grid,
+                "input_sha256": _grid_hash(row_grid),
+                "output": output,
+                "output_sha256": _grid_hash(output),
+                "runtime": bridge.runtime_identity,
+            }
+
+    test_path = HOME / "tests" / "test_peer_8e5125_control_probe.py"
+    probe_path = HOME / "workspace" / "review_probe.py"
+    return {
+        "schema": "arcpuzzles-peer-control-probe-v1",
+        "task_id": TASK_ID,
+        "status": "finding",
+        "generator_sha256": source_hash,
+        "probe_sha256": _hash_bytes(probe_path.read_bytes()),
+        "test_sha256": _hash_bytes(test_path.read_bytes()),
+        "advertised_count_rejected": advertised,
+        "accepted_count_truncated": truncated,
+        "row_bias_ignored_by_diagonal": row_bias,
+        "unknown_override": unknown,
+        "protected_racket": racket,
+        "finding": (
+            "cyan_count is advertised through h*w/2, but values above h*w/4 are "
+            "rejected; even the maximum accepted request is silently truncated by "
+            "row/column layouts. diagonal also ignores cyan_row_bias, and unknown "
+            "controls are accepted."
+        ),
+        "recommended_repair": (
+            "Define layout-specific feasible count ranges and reject incompatible "
+            "combinations, or constructively realize the exact requested count; "
+            "make diagonal consume row bias or declare that interaction invalid; "
+            "reject unknown controls."
+        ),
+        "scope": "Source-bound bounded reproducer; no generator source was modified or approved.",
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args(argv)
+    if args.out.exists() or args.out.is_symlink():
+        raise FileExistsError(f"choose a new output: {args.out}")
+    report = build_report(include_racket=True)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_bytes(_raw(report))
+    print(json.dumps({
+        "task_id": TASK_ID,
+        "status": report["status"],
+        "generator_sha256": report["generator_sha256"],
+        "output": str(args.out),
+    }, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
