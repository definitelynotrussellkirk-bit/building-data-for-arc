+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+            if (nr, nc) in allowed and (nr, nc) not in chosen
+        })
+        if not frontier:
+            raise RuntimeError("connected placement exhausted a rectangular source region")
+        chosen.add(rng.choice(frontier))
+    return list(chosen)
