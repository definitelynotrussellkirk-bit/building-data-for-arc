+"""Independent geometry oracle and review probes for 9baf979683ef.
+
+This module is test tooling, not production label authority.  The pure-Python
+oracle is intentionally written without importing generator helpers.  The
+optional Racket path executes the repository's selected canonical rule and
+fails loudly rather than falling back.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+TASK = "9baf979683ef"
+sys.path.insert(0, str(ROOT / "shared/runtime"))
+
+
+def load_generator(path=None):
+    path = Path(path or ROOT / f"generators/{TASK}/generator.py").resolve()
+    spec = importlib.util.spec_from_file_location("reviewed_generator", path)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def _grid(value):
+    return [[int(cell) for cell in row] if isinstance(row, str) else list(row)
+            for row in value]
+
+
+def canonical():
+    with (ROOT / "shared/data/canonical/puzzles.jsonl").open() as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK:
+                return row
+    raise ValueError(f"canonical task {TASK} is absent")
+
+
+def canonical_pairs():
+    row = canonical()
+    test = row["test"] if isinstance(row["test"], list) else [row["test"]]
+    return [{"input": _grid(pair["input"]), "output": _grid(pair["output"])}
+            for pair in row["train"] + test]
+
+
+def divider_col(grid):
+    if not grid or not grid[0]:
+        raise ValueError("empty grid")
+    h, w = len(grid), len(grid[0])
+    columns = [c for c in range(w) if all(grid[r][c] == 5 for r in range(h))]
+    if len(columns) != 1:
+        raise ValueError(f"expected one full-height color-5 divider, found {columns}")
+    return columns[0]
+
+
+def geometry_output(grid):
+    """Mirror source cells around the detected divider using original pixels."""
+    div = divider_col(grid)
+    h, w = len(grid), len(grid[0])
+    out = deepcopy(grid)
+    for r in range(h):
+        for c in range(div):
+            value = grid[r][c]
+            target = 2 * div - c
+            if value not in (0, 5) and 0 <= target < w:
+                out[r][target] = value
+    return out
+
+
+def center_shortcut(grid):
+    """Wrong rival: assume the divider is always at floor(width/2)."""
+    center = len(grid[0]) // 2
+    h, w = len(grid), len(grid[0])
+    out = deepcopy(grid)
+    for r in range(h):
+        for c in range(center):
+            value = grid[r][c]
+            target = 2 * center - c
+            if value not in (0, 5) and 0 <= target < w:
+                out[r][target] = value
+    return out
+
+
+def canonical_colors_shortcut(grid):
+    """Wrong rival: mirror only colors seen in the three canonical inputs."""
+    div = divider_col(grid)
+    h, w = len(grid), len(grid[0])
+    out = deepcopy(grid)
+    for r in range(h):
+        for c in range(div):
+            value = grid[r][c]
+            target = 2 * div - c
+            if value in (2, 3, 4) and 0 <= target < w:
+                out[r][target] = value
+    return out
+
+
+def first_two_colors_shortcut(grid):
+    """Wrong rival: process at most the first two source colors."""
+    div = divider_col(grid)
+    h, w = len(grid), len(grid[0])
+    colors = sorted({
+        grid[r][c]
+        for r in range(h)
+        for c in range(div)
+        if grid[r][c] not in (0, 5)
+    })[:2]
+    out = deepcopy(grid)
+    for r in range(h):
+        for c in range(div):
+            value = grid[r][c]
+            target = 2 * div - c
+            if value in colors and 0 <= target < w:
+                out[r][target] = value
+    return out
+
+
+def observed(grid):
+    div = divider_col(grid)
+    cells = [(r, c, value) for r, row in enumerate(grid)
+             for c, value in enumerate(row) if value not in (0, 5)]
+    return {
+        "grid_h": len(grid),
+        "grid_w": len(grid[0]),
+        "left_cell_count": len(cells),
+        "divider_col": div,
+        "centered": div == len(grid[0]) // 2,
+        "object_colors": tuple(sorted({value for _, _, value in cells})),
+    }
+
+
+def racket_outputs(grids):
+    from arc_repl.racket_bridge import racket_runtime_status, RacketUnavailableError
+    status = racket_runtime_status()
+    if not status["available"]:
+        raise RacketUnavailableError(status["reason"])
+    import tempfile
+    sys.path.insert(0, str(ROOT / "src"))
+    from arcpuzzles import Catalog
+    from arcpuzzles.runtime import prepare_runtime, run_process
+
+    program = canonical()["program_solution"]
+    with tempfile.TemporaryDirectory(prefix=f"{TASK}-parity-") as directory:
+        stage = Path(directory)
+        prepare_runtime(Catalog(ROOT), stage, TASK)
+        (stage / "parity-request.json").write_text(
+            json.dumps({"program": program, "grids": grids})
+        )
+        script = """
+import json
+from pathlib import Path
+from puzzle_generators import runner
+request=json.loads(Path('parity-request.json').read_text())
+bridge,name=runner._open_bridge_with_rule(runner.wrap_rule(request['program']))
+try:
+    print(json.dumps([runner._apply_rule(bridge,name,g) for g in request['grids']]))
+finally:
+    bridge.close()
+"""
+        result = run_process([sys.executable, "-B", "-c", script], stage, timeout=180)
+        if result["exit_code"] or result["timed_out"]:
+            raise RuntimeError(f"Racket worker failed: {result['stderr']} {result['stdout']}")
+        return json.loads(result["stdout"])
+
+
+def audit(module, count):
+    report = {
+        "schema": f"{TASK}-independent-audit-v1",
+        "version": module.VERSION,
+        "canonical_matches": 0,
+        "canonical_self_check_errors": [],
+        "by_band": {},
+    }
+    for pair in canonical_pairs():
+        report["canonical_self_check_errors"].append(module.self_check(pair["input"]))
+        report["canonical_matches"] += geometry_output(pair["input"]) == pair["output"]
+
+    all_inputs = set()
+    for band in (None, "easy", "medium", "hard"):
+        counts = Counter()
+        shapes, object_counts, dividers, colors = set(), set(), set(), set()
+        for index in range(count):
+            seed = 1009 + index
+            sample_index = index * 11 + 3
+            grid = module.generate(seed, sample_index, difficulty=band)
+            obs = observed(grid)
+            counts["samples"] += 1
+            counts["self_check_errors"] += bool(module.self_check(grid))
+            counts["nondeterministic"] += grid != module.generate(seed, sample_index, difficulty=band)
+            counts["off_center"] += not obs["centered"]
+            counts["extended_palette"] += any(c not in (2, 3, 4) for c in obs["object_colors"])
+            intended = geometry_output(grid)
+            counts["changed"] += intended != grid
+            counts["center_rival_disagreements"] += center_shortcut(grid) != intended
+            counts["color_rival_disagreements"] += canonical_colors_shortcut(grid) != intended
+            counts["first_two_rival_disagreements"] += first_two_colors_shortcut(grid) != intended
+            shapes.add((obs["grid_h"], obs["grid_w"]))
+            object_counts.add(obs["left_cell_count"])
+            dividers.add(obs["divider_col"])
+            colors.add(obs["object_colors"])
+            all_inputs.add(hashlib.sha256(json.dumps(grid, separators=(",", ":")).encode()).hexdigest())
+        report["by_band"][str(band)] = dict(
+            counts,
+            distinct_shapes=len(shapes),
+            object_counts=sorted(object_counts),
+            divider_columns=sorted(dividers),
+            color_sets=[list(values) for values in sorted(colors)],
+        )
+    report["distinct_inputs"] = len(all_inputs)
+
+    # Source-bound shortcut and cyclic-query audit.  Rival names come from the
+    # generator declaration rather than a duplicated list in this tool.
+    shortcuts = dict(getattr(module, "CANONICAL_SHORTCUTS", {}))
+    report["canonical_shortcut_fit"] = {
+        name: sum(rule(pair["input"]) == pair["output"] for pair in canonical_pairs())
+        for name, rule in shortcuts.items()
+    }
+    cyclic = {name: {"rotations": 0, "demo_refutation_failures": 0}
+              for name in shortcuts}
+    for start in range(64):
+        seed = 7000 + start
+        grids = [module.generate(seed, start + offset) for offset in range(4)]
+        answers = [geometry_output(grid) for grid in grids]
+        for query_index in range(4):
+            demos = [index for index in range(4) if index != query_index]
+            for name, rule in shortcuts.items():
+                cyclic[name]["rotations"] += 1
+                if not any(rule(grids[index]) != answers[index] for index in demos):
+                    cyclic[name]["demo_refutation_failures"] += 1
+    report["cyclic_query_audit"] = cyclic
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--generator", type=Path)
+    parser.add_argument("--count", type=int, default=250)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--racket", action="store_true")
+    args = parser.parse_args()
+    module = load_generator(args.generator)
+    report = audit(module, args.count)
+    path = args.generator or ROOT / f"generators/{TASK}/generator.py"
+    report["generator_sha256"] = hashlib.sha256(path.read_bytes()).hexdigest()
+    report["probe_sha256"] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    report["racket"] = {"status": "not_requested", "checked": 0}
+    exit_code = int(
+        report["canonical_matches"] != len(canonical_pairs())
+        or any(report["canonical_self_check_errors"])
+        or any(v["self_check_errors"] or v["nondeterministic"]
+               for v in report["by_band"].values())
+    )
+    if args.racket:
+        grids = [pair["input"] for pair in canonical_pairs()]
+        grids += [module.generate(319, index) for index in range(32)]
+        try:
+            outputs = racket_outputs(grids)
+            mismatches = [i for i, (grid, out) in enumerate(zip(grids, outputs))
+                          if geometry_output(grid) != out]
+            report["racket"] = {
+                "status": "passed" if not mismatches else "failed",
+                "checked": len(outputs),
+                "mismatches": mismatches,
+            }
+            exit_code = max(exit_code, int(bool(mismatches)))
+        except Exception as exc:
+            report["racket"] = {
+                "status": "unavailable_or_failed",
+                "checked": 0,
+                "error": f"{type(exc).__name__}: {exc}",
+            }
+            exit_code = 2
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps(report, indent=2))
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
