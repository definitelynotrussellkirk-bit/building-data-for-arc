+@pytest.mark.parametrize("start", range(16))
+def test_every_cyclic_query_rotation_keeps_both_shortcuts_refuted_by_demos(start):
+    grids = [gen.generate(701 + index, start + index) for index in range(4)]
+    profiles = {gen.schedule_profile(701 + index, start + index) for index in range(4)}
+    assert profiles == set(gen.SCHEDULE_PROFILES)
+    intended = [geometry_output(grid) for grid in grids]
+    for query_index in range(4):
+        demo_indexes = [index for index in range(4) if index != query_index]
+        assert any(
+            center_shortcut(grids[index]) != intended[index]
+            for index in demo_indexes
+        )
+        assert any(
+            canonical_colors_shortcut(grids[index]) != intended[index]
+            for index in demo_indexes
+        )
+        assert any(
+            first_two_colors_shortcut(grids[index]) != intended[index]
+            for index in demo_indexes
+        )
+
+
+def _nonzero_component_count(grid):
+    height, width = len(grid), len(grid[0])
+    seen = set()
+    count = 0
+    for row in range(height):
+        for col in range(width):
+            if grid[row][col] == 0 or (row, col) in seen:
+                continue
+            count += 1
+            stack = [(row, col)]
+            seen.add((row, col))
+            while stack:
+                r, c = stack.pop()
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and grid[nr][nc] != 0
+                        and (nr, nc) not in seen
+                    ):
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
+    return count
+
+
+def test_morphology_median_stays_within_distribution_gate_ratio():
+    canonical_median = median(
+        _nonzero_component_count(pair["input"]) for pair in canonical_pairs()
+    )
+    generated_median = median(
+        _nonzero_component_count(gen.generate(seed, seed, difficulty=band))
+        for band in ("easy", "medium", "hard")
+        for seed in range(1, 41)
+    )
+    ratio = max(canonical_median, generated_median) / max(
+        1, min(canonical_median, generated_median)
+    )
+    assert ratio <= 3.0, (generated_median, canonical_median)
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_distribution_covers_lawful_broad_branches(band):
+    shapes = set()
+    counts = set()
+    divider_offsets = set()
+    color_pairs = set()
+    for index in range(384):
+        seed = 2100 + index
+        sample_index = index * 7
+        grid = gen.generate(seed, sample_index, difficulty=band)
+        assert gen.self_check(grid) == []
+        assert grid == gen.generate(seed, sample_index, difficulty=band)
+        stats = observed(grid)
+        shapes.add((stats["grid_h"], stats["grid_w"]))
+        counts.add(stats["left_cell_count"])
+        divider_offsets.add(stats["divider_col"] - stats["grid_w"] // 2)
+        color_pairs.add(stats["object_colors"])
+        original = deepcopy(grid)
+        answer = geometry_output(grid)
+        assert grid == original
+        assert answer != grid
+    assert len(shapes) >= 18
+    assert counts == set(range(3, 11))
+    assert 0 in divider_offsets
+    assert any(offset != 0 for offset in divider_offsets)
+    assert any(set(pair) <= {2, 3, 4} for pair in color_pairs)
+    assert any(set(pair).isdisjoint({2, 3, 4}) for pair in color_pairs)
+
+
+def test_schedule_deconfounds_geometry_palette_and_color_count():
+    """The four profiles must cross, rather than correlate, teaching axes."""
+    signatures = set()
+    for sample_index in range(4):
+        grid = gen.generate(4242, sample_index, grid_h=8, grid_w=11, left_cell_count=7)
+        stats = observed(grid)
+        colors = set(stats["object_colors"])
+        signatures.add((
+            stats["divider_col"] == stats["grid_w"] // 2,
+            colors.isdisjoint({2, 3, 4}),
+            len(colors),
+        ))
+    assert signatures == {
+        (True, False, 2),   # centered, canonical palette, two colors
+        (True, True, 3),    # centered, extended palette, three colors
+        (False, False, 3),  # off-center, canonical palette, three colors
+        (False, True, 2),   # off-center, extended palette, two colors
+    }
+
+
+def test_declared_shortcuts_fit_all_canonical_pairs():
