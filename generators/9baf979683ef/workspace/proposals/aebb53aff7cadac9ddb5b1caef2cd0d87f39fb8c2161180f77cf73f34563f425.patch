+import sys
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(HOME / "workspace"))
+from reference_probe import (  # noqa: E402
+    canonical_colors_shortcut,
+    canonical_pairs,
+    center_shortcut,
+    divider_col,
+    first_two_colors_shortcut,
+    geometry_output,
+    load_generator,
+    observed,
+    racket_outputs,
+)
+
+gen = load_generator(os.environ.get("GENERATOR_UNDER_TEST"))
