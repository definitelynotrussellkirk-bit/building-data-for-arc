+
+@pytest.mark.parametrize("pair", canonical_pairs(), ids=["train0", "train1", "test0"])
+def test_accepts_canonical_inputs_and_matches_rule(pair):
+    assert gen.self_check(pair["input"]) == []
+    assert gen.strict_canonical_like(pair["input"]) == []
