+
+@pytest.mark.parametrize("mutation", [
+    "erase_divider", "second_divider", "right_object", "bad_color_mix",
+    "too_few_objects", "out_of_bounds_source",
+])
+def test_validator_rejects_destructive_mutations(mutation):
+    grid = gen.generate(4, 3, grid_h=8, grid_w=11, left_cell_count=6)
+    div = divider_col(grid)
+    if mutation == "erase_divider":
+        grid[0][div] = 0
+    elif mutation == "second_divider":
+        for row in grid:
+            row[0] = 5
+    elif mutation == "right_object":
+        grid[0][div + 1] = 2
+    elif mutation == "bad_color_mix":
+        for r, row in enumerate(grid):
+            for c, value in enumerate(row):
+                if value not in (0, 5):
+                    grid[r][c] = 2 if value not in (2, 3, 4) else 8
+                    break
+            else:
+                continue
+            break
+    elif mutation == "too_few_objects":
+        kept = False
+        for r, row in enumerate(grid):
+            for c, value in enumerate(row):
+                if value not in (0, 5):
+                    if kept:
+                        grid[r][c] = 0
+                    else:
+                        kept = True
+    elif mutation == "out_of_bounds_source":
+        for r, row in enumerate(grid):
+            for c, value in enumerate(row):
+                if value not in (0, 5):
+                    row[c] = 0
+        grid[0][0] = 2
+        grid[1][0] = 3
+    assert gen.self_check(grid)
+
+
+@pytest.mark.parametrize("grid", [
+    None, [], [[]], [[0], [0, 1]], [[True] * 7 for _ in range(5)],
+    [[11] * 7 for _ in range(5)],
+])
+def test_malformed_grid_is_diagnostic_not_exception(grid):
+    assert gen.self_check(grid)
+
+
