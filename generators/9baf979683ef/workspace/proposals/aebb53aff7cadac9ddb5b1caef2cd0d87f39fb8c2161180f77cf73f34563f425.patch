+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+@pytest.mark.parametrize("options", [
+    {"grid_h": 5, "grid_w": 7, "left_cell_count": 10},
+    {"grid_h": 14, "grid_w": 17, "left_cell_count": 3},
+    {"grid_h": 8, "grid_w": 10, "left_cell_count": 6},
+])
+def test_exact_overrides_are_honored_in_every_band(band, options):
+    grid = gen.generate(17, 9, difficulty=band, **options)
+    assert gen.self_check(grid) == []
+    assert gen.observe_overrides(grid) == options
+    stats = observed(grid)
+    assert {name: stats[name] for name in options} == options
+
+
+@pytest.mark.parametrize("key,value", [
+    ("typo", 1),
+    ("grid_h", 4), ("grid_h", 15),
+    ("grid_w", 6), ("grid_w", 18),
+    ("left_cell_count", 2), ("left_cell_count", 11),
+    ("grid_h", True), ("grid_w", 8.0), ("left_cell_count", "5"),
+])
+def test_invalid_overrides_are_rejected(key, value):
+    with pytest.raises(ValueError):
+        gen.generate(0, 0, **{key: value})
