+"""Bounded source-bound audit: smallest bounding-box area versus cell count.
+
+The probe samples ordinary medium draws at fixed seed and sample_index=0..3,
+looking for a three-demo lesson which admits the area rival but whose fourth
+sample separates it. No query label is used to select a rival: the single rival
+is declared here before any draw. Search selection is retrospective and is not
+claimed to be a generator-native lesson schedule or a measured failure rate.
+"""
+from __future__ import annotations
+import argparse
+from collections import deque
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+from arcpuzzles import Catalog
+from arc_repl.isolated_verifier import Limits, verify_candidate
+
+TASK = "947a1d9ca8f5"
+EXPECTED_SOURCE = "a0075ff50825a0f51f3764acb57377f4f0dac024c2fc39b11c34c0c3bb351a7d"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+SOURCE = HERE.parent / "generator.py"
+
+
+def objects(grid):
+    seen = set()
+    result = []
+    for r, row in enumerate(grid):
+        for c, color in enumerate(row):
+            if color in (0, 9) or (r, c) in seen:
+                continue
+            pending = deque([(r, c)])
+            seen.add((r, c))
+            cells = []
+            while pending:
+                p = pending.popleft()
+                cells.append(p)
+                for dr, dc in ((-1,0), (1,0), (0,-1), (0,1)):
+                    nr, nc = p[0]+dr, p[1]+dc
+                    if 0 <= nr < len(grid) and 0 <= nc < len(row) and (nr,nc) not in seen and grid[nr][nc] == color:
+                        seen.add((nr,nc)); pending.append((nr,nc))
+            top, left = min(r for r,c in cells), min(c for r,c in cells)
+            height = max(r for r,c in cells)-top+1
+            width = max(c for r,c in cells)-left+1
+            result.append({"color":color, "size":len(cells), "area":height*width,
+                           "bbox":[top,left,top+height-1,left+width-1],
+                           "offsets":[[r-top,c-left] for r,c in sorted(cells)]})
+    return result
+
+
+def label(grid, area=False):
+    found = objects(grid)
+    chosen = min(found, key=(lambda x:(x["area"],x["size"])) if area else (lambda x:x["size"]))
+    output = [[0]*len(grid[0]) for _ in grid]
+    fits = True
+    for r,row in enumerate(grid):
+        for c,color in enumerate(row):
+            if color == 9:
+                for dr,dc in chosen["offsets"]:
+                    if 0 <= r+dr < len(grid) and 0 <= c+dc < len(row):
+                        output[r+dr][c+dc] = chosen["color"]
+                    else:
+                        fits = False
+    return output, fits
+
+
+def write(path, value):
+    path.write_text(json.dumps(value, indent=2, sort_keys=True)+"\n")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=True)
+    source_hash = hashlib.sha256(SOURCE.read_bytes()).hexdigest()
+    assert source_hash == EXPECTED_SOURCE, "audited production bytes changed"
+    spec = importlib.util.spec_from_file_location("peer_947a1d9ca8f5", SOURCE)
+    gen = importlib.util.module_from_spec(spec); sys.modules[spec.name] = gen; spec.loader.exec_module(gen)
+    catalog = Catalog(ROOT)
+    record = catalog.get(TASK)
+    programs = {v["program_solution"] for v in record["variants"]}
+    assert len(programs) == 1
+    canonical = programs.pop()
+    rule_hash = hashlib.sha256(" ".join(canonical.split()).encode()).hexdigest()[:12]
+    assert rule_hash == "6e780392649f"
+    old = "(< (obj-size a) (obj-size b))"
+    new = "(let* ((ab (bbox-of-cells (obj-cells a))) (bb (bbox-of-cells (obj-cells b))) (aa (* (+ 1 (- (third ab) (first ab))) (+ 1 (- (fourth ab) (second ab))))) (ba (* (+ 1 (- (third bb) (first bb))) (+ 1 (- (fourth bb) (second bb)))))) (if (= aa ba) (< (obj-size a) (obj-size b)) (< aa ba)))"
+    assert canonical.count(old) == 1
+    rival = canonical.replace(old, new)
+    canonical_pairs = [p for v in record["variants"] for split in ("train","test") for p in v.get(split,[]) if "output" in p]
+    canonical_fits = [label(p["input"], True)[0] == p["output"] for p in canonical_pairs]
+    searched = []
+    witness = None
+    for seed in range(128):
+        grids = [gen.generate(seed, i, difficulty="medium") for i in range(4)]
+        assert all(not gen.self_check(grid) for grid in grids)
+        truth = [label(grid)[0] for grid in grids]
+        alternatives = [label(grid, True) for grid in grids]
+        match = [a[0] == b for a,b in zip(alternatives,truth)]
+        searched.append({"seed":seed,"sample_indices":[0,1,2,3],"rival_matches":match,"rival_fits":[a[1] for a in alternatives]})
+        if match[:3] == [True]*3 and not match[3] and all(a[1] for a in alternatives):
+            witness = {"seed":seed,"difficulty":"medium","overrides":{},"sample_indices":[0,1,2,3],
+                       "train":[{"input":g,"output":o} for g,o in zip(grids[:3],truth[:3])],
+                       "test":[{"input":grids[3],"output":truth[3]}],
+                       "rival_outputs":[a[0] for a in alternatives],
+                       "objects":[objects(grid) for grid in grids],
+                       "self_check_errors":[gen.self_check(grid) for grid in grids],
+                       "origin":"actual unmodified generator draws, no overrides or handcrafted input"}
+            break
+    summary = {"task_id":TASK,"source_sha256":source_hash,"rule_hash":rule_hash,"approved_at_read":record.get("approved"),
+               "rival":"minimum bounding-box area, break area ties by cell count; retain normalization/stamping/color",
+               "ordinary_draws_examined":4*len(searched),"seed_range_examined":[0,len(searched)-1],
+               "canonical_pairs":len(canonical_pairs),"canonical_rival_python_matches":canonical_fits,
+               "witness_found":witness is not None,"search":searched,
+               "limits":["One predeclared rival; retrospective three-demo/fourth-query assembly, not a generator-native lesson guarantee or failure-rate estimate.",
+                         "No arbitrary-domain or universal shortcut claim; no handcrafted witness inputs; no production repair, approval change, or parametric work."]}
+    if witness is not None:
+        inputs = [p["input"] for p in canonical_pairs] + [p["input"] for p in witness["train"]+witness["test"]]
+        expected = [p["output"] for p in canonical_pairs] + [p["output"] for p in witness["train"]+witness["test"]]
+        execution_task = {"train":witness["train"],"test":[{"input":g} for g in inputs]}
+        receipts = {}
+        for name, source in (("canonical",canonical),("minimum_bbox_area",rival)):
+            receipt = verify_candidate(execution_task, source, racket_path=os.environ.get("RACKET_PATH",""), limits=Limits(max_pairs=64))
+            receipts[name] = receipt
+            assert receipt["status"] == "pass", receipt
+            predicted = [label(g, name != "canonical")[0] for g in inputs]
+            assert receipt["test_outputs"] == predicted, (name,"Racket/Python disagreement")
+        assert receipts["canonical"]["test_outputs"] == expected
+        assert all(a == b for a,b in zip(receipts["minimum_bbox_area"]["test_outputs"][:-1],expected[:-1]))
+        assert receipts["minimum_bbox_area"]["test_outputs"][-1] != expected[-1]
+        summary["racket_program_sha256"] = {name:hashlib.sha256(source.encode()).hexdigest() for name,source in (("canonical",canonical),("minimum_bbox_area",rival))}
+        summary["racket_evaluations"] = 2*(len(inputs)+len(witness["train"]))
+        summary["query_cell_disagreements"] = sum(a != b for ra,rb in zip(expected[-1],receipts["minimum_bbox_area"]["test_outputs"][-1]) for a,b in zip(ra,rb))
+        write(args.out/"witness.private.json",witness)
+        write(args.out/"racket-receipts.private.json",receipts)
+        (args.out/"canonical.rkt").write_text(canonical)
+        (args.out/"minimum-bbox-area-rival.rkt").write_text(rival)
+    assert hashlib.sha256(SOURCE.read_bytes()).hexdigest() == source_hash
+    write(args.out/"summary.json",summary)
+    print(json.dumps({k:v for k,v in summary.items() if k != "search"},indent=2))
+
+
+if __name__ == "__main__":
+    main()
