+"""Bounded findings-only review: orientation shortcut in direct-draw lessons.
+
+Direct draws are explicitly authored as three demonstrations and one query;
+they are not claimed to be Catalog.generate's episode assembly. No source,
+canonical record, approval, or review index is modified.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = "81e185a45bfa"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+EXPECTED = "05e02448a1d12873e457d5447f0a65eb9531f4d15d9203988aea000174066aa1"
+
+
+def meaning(grid, axis="both"):
+    h, w = len(grid), len(grid[0])
+    out = deepcopy(grid)
+    for r in range(h):
+        for c in range(w):
+            if grid[r][c] != 0:
+                continue
+            horizontal = (axis != "vertical" and 0 < c < w - 1
+                          and grid[r][c-1] != 0 and grid[r][c-1] == grid[r][c+1])
+            vertical = (axis != "horizontal" and 0 < r < h - 1
+                        and grid[r-1][c] != 0 and grid[r-1][c] == grid[r+1][c])
+            if horizontal:
+                out[r][c] = grid[r][c-1]
+            elif vertical:
+                out[r][c] = grid[r-1][c]
+    return out
+
+
+def rival_program(axis):
+    if axis == "horizontal":
+        test = "(and (> c 0) (< c (- (cols g) 1)) (not (= (at g r (- c 1)) 0)) (= (at g r (- c 1)) (at g r (+ c 1))))"
+        value = "(at g r (- c 1))"
+    elif axis == "vertical":
+        test = "(and (> r 0) (< r (- (rows g) 1)) (not (= (at g (- r 1) c) 0)) (= (at g (- r 1) c) (at g (+ r 1) c)))"
+        value = "(at g (- r 1) c)"
+    else:
+        raise ValueError(axis)
+    return f"(rule! (lambda (g) (cellmap g (r c v) (if (and (= v 0) {test}) {value} v))))"
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.out.exists():
+        raise FileExistsError(args.out)
+    source = ROOT / f"generators/{TASK}/generator.py"
+    before = hashlib.sha256(source.read_bytes()).hexdigest()
+    if before != EXPECTED:
+        raise ValueError("audited generator source changed")
+    record = Catalog(ROOT).get(TASK)
+    programs = {v["program_solution"] for v in record["variants"]}
+    if len(programs) != 1:
+        raise ValueError("canonical authority is ambiguous")
+    canonical = next(iter(programs))
+    canonical_pairs = [p for v in record["variants"] for split in ("train", "test")
+                       for p in v[split] if "output" in p]
+    for pair in canonical_pairs:
+        if meaning(pair["input"]) != pair["output"]:
+            raise ValueError("independent semantics disagree with a public canonical pair")
+    checked, witness = 0, None
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        spec = importlib.util.spec_from_file_location("_peer_bridge_review", source)
+        gen = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = gen
+        spec.loader.exec_module(gen)
+        for difficulty in (None, "easy"):
+            if witness is not None:
+                break
+            for seed in range(32):
+                grids = [gen.generate(seed, index, difficulty=difficulty) for index in range(4)]
+                checked += 4
+                errors = [gen.self_check(grid) for grid in grids]
+                if any(errors):
+                    raise ValueError(f"direct-draw validator failures: {errors}")
+                expected = [meaning(grid) for grid in grids]
+                for axis in ("horizontal", "vertical"):
+                    actual = [meaning(grid, axis) for grid in grids]
+                    if actual[:3] == expected[:3] and actual[3] != expected[3]:
+                        witness = {"provenance": "direct generator draws, authored three-demo/one-query lesson",
+                                   "seed": seed, "difficulty": difficulty, "sample_indices": [0,1,2,3],
+                                   "rival": axis + "_only", "train": [
+                                       {"input": g, "output": y} for g,y in zip(grids[:3],expected[:3])],
+                                   "test": [{"input": grids[3], "output": expected[3]}],
+                                   "rival_query_output": actual[3], "self_check": errors,
+                                   "different_query_cells": sum(a != b for ra,rb in zip(actual[3],expected[3])
+                                                                 for a,b in zip(ra,rb))}
+                        break
+                if witness is not None:
+                    break
+        result = {"task_id": TASK, "source_sha256": before, "rule_hash": record["rule_hash"],
+                  "approved": record["approved"], "canonical_pair_count": len(canonical_pairs),
+                  "direct_draw_count": checked, "witness": witness,
+                  "scope": "At most32seeds perdefault/easy band; fourdirectdraws perseed; horizontal-only andvertical-only rivals only."}
+        if witness is None:
+            result.update(status="no_witness_in_bounded_search")
+        else:
+            axis = witness["rival"].removesuffix("_only")
+            candidate = rival_program(axis)
+            apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+            executions = []
+            try:
+                for index,pair in enumerate(canonical_pairs):
+                    out = apply(canonical,pair["input"])
+                    if out != pair["output"]:
+                        raise ValueError("canonical Racket disagrees with published label")
+                    executions.append({"origin":"public_canonical","index":index,"output":out})
+                for index,pair in enumerate(witness["train"] + witness["test"]):
+                    intended = apply(canonical,pair["input"])
+                    rival = apply(candidate,pair["input"])
+                    if intended != pair["output"] or rival != meaning(pair["input"],axis):
+                        raise ValueError("protected execution differs from independent Python meaning")
+                    executions.append({"origin":"direct_draw_witness","sample_index":index,
+                                       "intended_output":intended,"rival_output":rival})
+            finally:
+                bridge.close()
+            result.update(status="reproduced_demo_query_ambiguity",racket=identity,
+                          racket_evaluations=len(canonical_pairs)+8,
+                          canonical_program=canonical,rival_program=candidate,executions=executions)
+    if hashlib.sha256(source.read_bytes()).hexdigest() != before:
+        raise ValueError("generator changed during audit")
+    args.out.parent.mkdir(parents=True,exist_ok=True)
+    args.out.write_text(json.dumps(result,sort_keys=True,indent=2)+"\n")
+    print(json.dumps({k:result[k] for k in ("status","task_id","source_sha256","direct_draw_count")},sort_keys=True))
+    if witness is not None:
+        print(json.dumps({k:witness[k] for k in ("seed","difficulty","rival","different_query_cells")},sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
