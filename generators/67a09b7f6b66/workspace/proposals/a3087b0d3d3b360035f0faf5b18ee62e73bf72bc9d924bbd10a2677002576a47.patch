@@ -0,0 +1,165 @@
+"""Source-bound protected-Racket probe for the square-frame lesson shortcut."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "65084a735199"
+RIVAL = "square_frames_only"
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _canonical_program(root: Path) -> str:
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for raw in handle:
+            row = json.loads(raw)
+            if row.get("task_id") == TASK_ID:
+                return row["program_solution"]
+    raise KeyError(TASK_ID)
+
+
+def _diffs(left: list[list[int]], right: list[list[int]]) -> list[dict[str, int]]:
+    return [
+        {"row": r, "col": c, "canonical": a, "rival": b}
+        for r, (left_row, right_row) in enumerate(zip(left, right, strict=True))
+        for c, (a, b) in enumerate(zip(left_row, right_row, strict=True))
+        if a != b
+    ]
+
+
+def _sha_json(value: Any) -> str:
+    body = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(body).hexdigest()
+
+
+def run(out: Path) -> dict[str, Any]:
+    root = find_root(__file__)
+    generator, source, source_sha = load_selected_generator(TASK_ID, root=root)
+    program = _canonical_program(root)
+    rival = generator.SEMANTIC_RIVALS[RIVAL]
+
+    demos = []
+    for seed in (7, 11, 13):
+        sample_index = seed * 17 + 3
+        grid = generator.generate(seed, sample_index, scene_profile="paired_squares")
+        demos.append({
+            "seed": seed,
+            "sample_index": sample_index,
+            "scene_profile": "paired_squares",
+            "input": grid,
+        })
+    query = {
+        "seed": 29,
+        "sample_index": 31,
+        "scene_profile": "wide_frames",
+        "input": generator.generate(29, 31, scene_profile="wide_frames"),
+    }
+
+    wrapped = wrap_rule(program)
+    evaluations = 0
+    with RacketBridge(timeout=30, startup_timeout=60) as bridge:
+        identity = bridge.runtime_identity
+        if identity.get("backend") != "racket" or identity.get("protected") is not True:
+            raise RuntimeError("protected Racket is required")
+
+        def apply(grid: list[list[int]]) -> list[list[int]]:
+            nonlocal evaluations
+            evaluations += 1
+            return bridge.eval_text(f"({wrapped} {_grid_literal(grid)})")
+
+        for pair in [*demos, query]:
+            if generator.self_check(pair["input"]):
+                raise AssertionError(("invalid generated input", pair))
+            pair["canonical_output"] = apply(pair["input"])
+            if pair["canonical_output"] != generator.rule_mirror(pair["input"]):
+                raise AssertionError("Python mirror disagrees with canonical Racket")
+            pair["rival_output"] = rival(pair["input"])
+
+    lesson_demos = [
+        {"input": pair["input"], "output": pair["canonical_output"]}
+        for pair in demos
+    ]
+    lesson_query = {
+        "input": query["input"],
+        "output": query["canonical_output"],
+    }
+    if not all(pair["rival_output"] == pair["canonical_output"] for pair in demos):
+        raise AssertionError("rival does not survive all demonstrations")
+    if query["rival_output"] == query["canonical_output"]:
+        raise AssertionError("rival does not change the query")
+    reasons = generator.lesson_identifiable(lesson_demos, lesson_query)
+    if not any(RIVAL in reason for reason in reasons):
+        raise AssertionError(("lesson hook missed rival", reasons))
+
+    for pair in [*demos, query]:
+        pair["input_sha256"] = _sha_json(pair["input"])
+        pair["canonical_output_sha256"] = _sha_json(pair["canonical_output"])
+        pair["rival_output_sha256"] = _sha_json(pair["rival_output"])
+    differences = _diffs(query["canonical_output"], query["rival_output"])
+
+    report = {
+        "schema": "arcpuzzles-peer-learnability-probe-v1",
+        "assignment_id": "review-c83611f00afef4d0",
+        "task_id": TASK_ID,
+        "status": "reproduced_and_guarded",
+        "finding": (
+            "Three paired-square demonstrations permit a square-frames-only rule, "
+            "while a wide-frame query requires the general rectangle rule."
+        ),
+        "source": {
+            "path": source.relative_to(root).as_posix(),
+            "sha256": source_sha,
+            "program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+            "program_normalized_sha256": hashlib.sha256(" ".join(program.split()).encode()).hexdigest(),
+        },
+        "racket": {
+            key: identity[key]
+            for key in (
+                "schema", "backend", "protected", "binary_sha256", "prelude_sha256",
+                "bridge_sha256", "boot_script_sha256", "candidate_symbol_policy_sha256",
+            )
+            if key in identity
+        },
+        "racket_evaluations": evaluations,
+        "rival": RIVAL,
+        "demonstrations": demos,
+        "query": query,
+        "query_differences": differences,
+        "lesson_identifiable_reasons": reasons,
+        "repair": (
+            "Declare the rival and reject any lesson where it survives all demonstrations; "
+            "a non-square teaching frame falsifies it without increasing demonstration count."
+        ),
+        "limits": "One constructed three-demo lesson; this is not a frequency estimate or universal rival search.",
+    }
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return report
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = run(args.out)
+    print(json.dumps({
+        "status": report["status"],
+        "racket_evaluations": report["racket_evaluations"],
+        "query_differences": len(report["query_differences"]),
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
