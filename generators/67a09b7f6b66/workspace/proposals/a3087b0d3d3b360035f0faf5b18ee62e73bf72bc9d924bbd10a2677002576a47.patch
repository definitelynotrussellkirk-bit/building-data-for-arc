+        except (KeyError, TypeError, ValueError) as exc:
+            reasons.append(f"demo {index} is outside the count grammar: {exc}")
+            continue
+        if demo.get("output") != expected:
+            reasons.append(f"demo {index} output disagrees with count-and-pack")
+    try:
+        query_answer = rule_mirror(query["input"])
+    except (KeyError, TypeError, ValueError) as exc:
+        reasons.append(f"query is outside the count grammar: {exc}")
+        return reasons
+    if query.get("output") is not None and query.get("output") != query_answer:
+        reasons.append("query output disagrees with count-and-pack")
