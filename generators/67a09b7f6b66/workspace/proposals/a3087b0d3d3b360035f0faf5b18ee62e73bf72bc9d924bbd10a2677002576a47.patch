+def _square_frames_only(grid):
+    """Plausible wrong rule: transform square frames and ignore rectangles."""
+    info = _analysis(grid)
+    if info["errors"]:
+        raise ValueError("; ".join(info["errors"]))
+    output = [list(row) for row in grid]
+    for frame in info["frames"]:
+        r0, c0, r1, c1 = frame["bbox"]
+        if r1 - r0 != c1 - c0:
+            continue
+        color = frame["marker_color"]
+        for r, c in frame["cells"]:
+            output[r][c] = color
+        marker_r, marker_c = frame["marker"]
+        output[marker_r][marker_c] = 0
+    return output
+
+
+SEMANTIC_RIVALS = {"square_frames_only": _square_frames_only}
+LESSON_COMPETITORS = dict(SEMANTIC_RIVALS)
+
+
+def lesson_identifiable(demos, query):
+    """Reject lessons where square-only recoloring survives every demo."""
+    reasons = []
+    for index, demo in enumerate(demos):
+        try:
+            expected = rule_mirror(demo["input"])
+        except (KeyError, TypeError, ValueError) as exc:
+            reasons.append(f"demo {index} is outside the frame grammar: {exc}")
+            continue
+        if demo.get("output") != expected:
+            reasons.append(f"demo {index} output disagrees with the frame rule")
+    try:
+        query_answer = rule_mirror(query["input"])
+    except (KeyError, TypeError, ValueError) as exc:
+        reasons.append(f"query is outside the frame grammar: {exc}")
+        return reasons
+    if query.get("output") is not None and query.get("output") != query_answer:
+        reasons.append("query output disagrees with the frame rule")
+    if reasons:
+        return reasons
+    for name, rival in LESSON_COMPETITORS.items():
+        survives = all(
+            rival(demo["input"]) == demo["output"]
+            for demo in demos
+        )
+        if survives and rival(query["input"]) != query_answer:
+            reasons.append(
+                f"rival {name!r} fits every demo but answers the query differently"
+            )
+    return reasons
+
