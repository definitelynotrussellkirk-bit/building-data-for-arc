+"""Bounded peer audit: can a two-empty-cell minimum survive visible demos?"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, normalize_grid
+
+HOME = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location("peer_short_gap_generator", HOME / "generator.py")
+gen = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(gen)
+
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def rival(grid):
+    out = [row[:] for row in grid]
+    for color, points in gen._positions(grid).items():
+        if len(points) != 2:
+            continue
+        a, b = points
+        cells = gen._segment(a, b)
+        if cells is None or abs(a[0] - b[0]) + abs(a[1] - b[1]) <= 2:
+            continue
+        for r, c in cells:
+            out[r][c] = color
+    return out
+
+
+def main(out):
+    out = Path(out)
+    if out.exists():
+        raise FileExistsError(out)
+    root = find_root(__file__)
+    sources = {row["program_solution"] for line in canonical_path(root).read_text().splitlines()
+               if line.strip() for row in [json.loads(line)] if row.get("task_id") == gen.TASK_ID}
+    assert len(sources) == 1
+    canonical = sources.pop()
+    wrong = canonical.replace("[(= (first a) (first b))", "[(and (= (first a) (first b)) (> (abs (- (second a) (second b))) 2))")
+    wrong = wrong.replace("[(= (second a) (second b))", "[(and (= (second a) (second b)) (> (abs (- (first a) (first b))) 2))")
+    assert wrong != canonical
+    retained_path = HOME / "counterexamples/exact_count_and_alignment.json"
+    retained = json.loads(retained_path.read_text())
+    assert retained["generator_sha256"] == digest(HOME / "generator.py")
+    assert retained["input"] == gen.generate(retained["seed"], retained["sample_index"], difficulty=retained["difficulty"])
+    assert retained["intended_output"] == gen.rule_mirror(retained["input"])
+    for name, fn in gen.SEMANTIC_RIVALS.items():
+        assert fn(retained["input"]) == retained["rival_outputs"][name] != retained["intended_output"]
+    checked = []
+    finding = None
+    for seed in range(8):
+        if finding:
+            break
+        for start in range(3):
+            pairs = [{"input": gen.generate(seed, start + offset, difficulty="medium")} for offset in range(4)]
+            for pair in pairs:
+                pair["output"] = gen.rule_mirror(pair["input"])
+            hook = gen.lesson_identifiable(pairs[:3], pairs[3])
+            assert hook == []
+            survivors = all(rival(p["input"]) == p["output"] for p in pairs[:3])
+            differs = rival(pairs[3]["input"]) != pairs[3]["output"]
+            checked.append({"seed": seed, "start": start, "fits_demos": survivors, "changes_query": differs})
+            if survivors and differs:
+                finding = {"seed": seed, "start": start, "difficulty": "medium", "train": pairs[:3], "test": pairs[3:], "lesson_hook_reasons": hook}
+                break
+    executions = []
+    with RacketBridge() as bridge:
+        identity = bridge.runtime_identity
+        assert identity.get("backend") == "racket" and identity.get("protected") is True
+        def execute(source, grid):
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            result = normalize_grid(bridge.eval_text(f"({wrap_rule(source)} {literal})"))
+            executions.append({"program_sha256": hashlib.sha256(source.encode()).hexdigest(), "input": grid, "output": result})
+            return result
+        assert execute(canonical, retained["input"]) == retained["intended_output"]
+        retained_gap_prediction = execute(wrong, retained["input"])
+        assert retained_gap_prediction == rival(retained["input"])
+        assert retained_gap_prediction != retained["intended_output"]
+        if finding:
+            for split in ("train", "test"):
+                for pair in finding[split]:
+                    assert execute(canonical, pair["input"]) == pair["output"]
+                    pair["rival_output"] = execute(wrong, pair["input"])
+                    assert pair["rival_output"] == rival(pair["input"])
+            assert all(p["rival_output"] == p["output"] for p in finding["train"])
+            assert finding["test"][0]["rival_output"] != finding["test"][0]["output"]
+    report = {"schema": "b8078ba8f836-bounded-learnability-review-v1", "task_id": gen.TASK_ID,
+              "status": "concrete_finding_unrepaired" if finding else "no_finding_in_bounded_probe",
+              "generator_sha256": digest(HOME / "generator.py"), "audit_source_sha256": digest(__file__),
+              "rule_hash": gen.RULE_HASH, "racket": identity, "program": canonical, "rival_program": wrong,
+              "rival": "Complete aligned exact-two colors only when endpoint distance exceeds two (at least two empty gap cells).",
+              "retained_fixture": str(retained_path.relative_to(root)), "retained_fixture_sha256": digest(retained_path),
+              "retained_fixture_replayed": True, "retained_gap_rival_replayed": True,
+              "bounded_search": checked, "finding": finding,
+              "executions": executions, "command_argv": sys.argv,
+              "limits": ["At most 24 ordinary three-demo/one-query lessons; stopped at first new finding.",
+                         "Existing two declared rivals and one additional gap-threshold rival only; no universal uniqueness claim.",
+                         "Production source and canonical authority unchanged. This peer finding is unaccepted and unrepaired."]}
+    out.mkdir(parents=True)
+    (out / "report.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"status": report["status"], "lessons_checked": len(checked), "racket_executions": len(executions), "finding_identity": None if finding is None else {k: finding[k] for k in ("seed", "start", "difficulty")}, "report": str(out / "report.json"), "generator_sha256": report["generator_sha256"]}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    main(parser.parse_args().out)
