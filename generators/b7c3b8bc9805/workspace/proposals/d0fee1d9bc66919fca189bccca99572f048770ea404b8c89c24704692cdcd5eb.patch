+"""Bounded, source-pinned finite-rival review; no acceptance or universal claim."""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge, racket_runtime_status
+from reviewer_support import canonical_path, find_root, load_selected_generator, normalize_grid
+
+
+TASK_ID = "a7a7065ca9b4"
+GENERATOR_SHA256 = "211961f6620c5a9080a6546808bbf6da13afbfd089df06d2db8574e69d5c6806"
+SEED = 20261024
+STARTS = (0, 1, 2, 3, 6)
+BANDS = ("easy", "medium", "hard")
+
+
+def digest(value):
+    if not isinstance(value, bytes):
+        value = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(value).hexdigest()
+
+
+def prefix_width(grid):
+    return next(c for c in range(len(grid[0])) if all(row[c] == 0 for row in grid))
+
+
+def copy_and_fill(grid, widths, fill):
+    result = []
+    for row, pw in zip(grid, widths, strict=True):
+        result.append(row[:pw] + [fill(row, pw)] * (len(row) - 2 * pw) + row[:pw])
+    return result
+
+
+def extra_rivals(grid):
+    pw = prefix_width(grid)
+    fixed = [pw] * len(grid)
+    first = lambda row, width: row[0]
+    return {
+        "row_local_first_zero_divider": copy_and_fill(
+            grid, [row.index(0) for row in grid], first
+        ),
+        "row_local_last_nonzero_width": copy_and_fill(
+            grid, [max(i for i, cell in enumerate(row) if cell) + 1 for row in grid], first
+        ),
+        "fixed_prefix_width_3": copy_and_fill(grid, [3] * len(grid), first),
+        "fixed_prefix_width_4": copy_and_fill(grid, [4] * len(grid), first),
+        "last_source_cell_fill": copy_and_fill(grid, fixed, lambda row, width: row[width - 1]),
+        "row_modal_nonzero_fill": copy_and_fill(
+            grid, fixed,
+            lambda row, width: Counter(cell for cell in row[:width] if cell).most_common(1)[0][0],
+        ),
+        "periodic_prefix_tiling": [[row[c % pw] for c in range(len(row))] for row in grid],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    root = find_root(__file__)
+    generator, source_path, source_sha256 = load_selected_generator(TASK_ID, root=root)
+    assert source_sha256 == GENERATOR_SHA256, "review is bound to the recorded generator source"
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(root).read_text().splitlines()
+        if (row := json.loads(line)).get("task_id") == TASK_ID
+    }
+    assert len(programs) == 1
+    source = programs.pop()
+    assert source.startswith("(rule! ") and source.endswith(")")
+    rule_callable = source[len("(rule! "):-1]
+    (args.out / "reference.rkt").write_text(source)
+    cache = {}
+    lessons = []
+    ambiguous = []
+    first_lesson = None
+
+    with RacketBridge() as bridge:
+        for band in BANDS:
+            for start in STARTS:
+                pairs, predictions = [], []
+                for index in range(start, start + 5):
+                    key = (band, index)
+                    if key not in cache:
+                        grid = generator.generate(SEED, index, difficulty=band)
+                        assert generator.self_check(grid) == []
+                        literal = "'(" + " ".join(
+                            "(" + " ".join(map(str, row)) + ")" for row in grid
+                        ) + ")"
+                        output = normalize_grid(bridge.eval_text(f"({rule_callable} {literal})"))
+                        assert output == generator.rule_mirror(grid)
+                        rivals = {name: fn(grid) for name, fn in generator.SEMANTIC_RIVALS.items()}
+                        rivals.update(extra_rivals(grid))
+                        cache[key] = ({"input": grid, "output": output}, rivals)
+                    pair, rivals = cache[key]
+                    pairs.append(pair)
+                    predictions.append(rivals)
+                rows = []
+                for name in sorted(predictions[0]):
+                    mismatches = [
+                        i for i in range(4) if predictions[i][name] != pairs[i]["output"]
+                    ]
+                    query_differs = predictions[4][name] != pairs[4]["output"]
+                    row = {
+                        "rival": name,
+                        "demo_mismatch_indices": mismatches,
+                        "query_differs": query_differs,
+                    }
+                    rows.append(row)
+                    if not mismatches and query_differs:
+                        ambiguous.append({
+                            "difficulty": band, "start": start, "rival": name,
+                            "train": pairs[:4], "test": pairs[4:],
+                            "rival_query_output": predictions[4][name],
+                        })
+                lessons.append({
+                    "seed": SEED, "difficulty": band, "start": start,
+                    "sample_indices": list(range(start, start + 5)),
+                    "pair_sha256": [digest(pair) for pair in pairs],
+                    "rivals": rows,
+                })
+                if first_lesson is None:
+                    first_lesson = {"seed": SEED, "difficulty": band, "start": start,
+                                    "train": pairs[:4], "test": pairs[4:]}
+
+    assert hashlib.sha256(source_path.read_bytes()).hexdigest() == source_sha256
+    report = {
+        "schema": "arcpuzzles-bounded-finite-rival-review-v1",
+        "task_id": TASK_ID,
+        "status": "counterexample_found" if ambiguous else "bounded_no_finding",
+        "generator_sha256": source_sha256,
+        "canonical_source_sha256": hashlib.sha256(source.encode()).hexdigest(),
+        "review_script_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "runtime": racket_runtime_status(),
+        "scope": {"seed": SEED, "difficulty_bands": list(BANDS),
+                  "starts": list(STARTS), "demos": 4, "queries": 1,
+                  "lessons": len(lessons), "rivals_per_lesson": 13,
+                  "racket_evaluations": len(cache)},
+        "ambiguous_rival_count": len(ambiguous),
+        "all_rivals_refuted_by_demos": all(
+            row["demo_mismatch_indices"] for lesson in lessons for row in lesson["rivals"]
+        ),
+        "lessons": lessons,
+        "limits": [
+            "One fixed seed, fifteen four-demo/one-query sliding lessons, three difficulty bands.",
+            "Six existing generator rivals and seven independently authored rivals only.",
+            "Row-modal ties use first source occurrence; no exhaustive alternative-rule search.",
+            "Labels execute the selected canonical Racket in the packet runtime; this is not protected admission execution.",
+            "No full battery, parametric work, acceptance, training admission, or universal learnability claim.",
+        ],
+    }
+    (args.out / "report.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    (args.out / "example-lesson.json").write_text(json.dumps(first_lesson, indent=2) + "\n")
+    if ambiguous:
+        (args.out / "counterexamples.json").write_text(json.dumps(ambiguous, indent=2) + "\n")
+    print(json.dumps({key: report[key] for key in (
+        "status", "generator_sha256", "canonical_source_sha256", "review_script_sha256",
+        "scope", "ambiguous_rival_count", "all_rivals_refuted_by_demos",
+    )}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
