+from __future__ import annotations
+
+import copy
+import importlib
+import json
+import random
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root
+
+
+TASK = "ea61d17502dd"
+GEN = importlib.import_module(f"puzzle_generators.per_puzzle.{TASK}.generator")
+ROOT = find_root(__file__)
+
+
+def test_every_canonical_input_satisfies_the_generator_contract():
+    pairs = canonical_pairs(TASK, root=ROOT)
+    assert pairs
+    for pair in pairs:
+        assert GEN.self_check(pair["input"]) == [], (
+            pair["variant"],
+            pair["split"],
+            pair["pair_index"],
+            GEN.self_check(pair["input"]),
+        )
+
+
+def test_public_axis_surface_contains_only_literal_observable_choices():
+    assert set(GEN.AXES) == {"grid_h", "grid_w", "primary", "span_mode"}
+    assert GEN.AXES["grid_h"]["valid"] == "10..25"
+    assert GEN.AXES["grid_w"]["valid"] == "10..15"
+    assert set(GEN.AXES["primary"]["valid"].split("|")) == {
+        "horizontal",
+        "vertical",
+    }
+    assert set(GEN.AXES["span_mode"]["valid"].split("|")) == {
+        "full",
+        "partial",
+    }
+    assert GEN.INCOMPATIBLE_OVERRIDE_COMBINATIONS == []
+
+
+@pytest.mark.parametrize("difficulty", ["easy", "medium", "hard"])
+@pytest.mark.parametrize("grid_h", [10, 25])
+@pytest.mark.parametrize("grid_w", [10, 15])
+@pytest.mark.parametrize("primary", ["horizontal", "vertical"])
+@pytest.mark.parametrize("span_mode", ["full", "partial"])
+def test_every_axis_boundary_is_exact_observable_and_band_safe(
+    difficulty, grid_h, grid_w, primary, span_mode
+):
+    requested = {
+        "grid_h": grid_h,
+        "grid_w": grid_w,
+        "primary": primary,
+        "span_mode": span_mode,
+    }
+    grid = GEN.generate(314159, 7, difficulty=difficulty, **requested)
+    assert (len(grid), len(grid[0])) == (grid_h, grid_w)
+    assert GEN.observe_overrides(grid) == requested
+    assert GEN.self_check(grid, difficulty=difficulty, meta={"overrides": requested}) == []
+
+
+def test_unknown_override_keys_are_rejected_loudly():
+    with pytest.raises(TypeError, match="unknown override"):
+        GEN.generate(1, 0, typo_axis=3)
+
+
+def test_python_rule_mirror_matches_every_canonical_output():
+    for pair in canonical_pairs(TASK, root=ROOT):
+        assert GEN.rule_mirror(pair["input"]) == pair["output"], (
+            pair["variant"],
+            pair["split"],
+            pair["pair_index"],
+        )
+
+
+@pytest.mark.parametrize("difficulty", ["easy", "medium", "hard"])
+@pytest.mark.parametrize("start", range(4))
+def test_every_three_example_window_refutes_both_priority_blind_rivals(
+    difficulty, start
+):
+    grids = [
+        GEN.generate(271828, start + offset, difficulty=difficulty)
+        for offset in range(GEN.EXAMPLES_NEEDED + 1)
+    ]
+    demos = [
+        {"input": grid, "output": GEN.rule_mirror(grid)}
+        for grid in grids[: GEN.EXAMPLES_NEEDED]
+    ]
+    query = {"input": grids[-1], "output": GEN.rule_mirror(grids[-1])}
+    assert {
+        GEN.observe_overrides(demo["input"])["primary"] for demo in demos
+    } == {"horizontal", "vertical"}
+    assert GEN.lesson_identifiable(demos, query) == []
+    for demo in demos:
+        primary = GEN.observe_overrides(demo["input"])["primary"]
+        opposite = "vertical" if primary == "horizontal" else "horizontal"
+        assert GEN.rule_mirror(
+            demo["input"], force_primary=opposite
+        ) != demo["output"]
+
+
+def test_selected_authority_texts_are_exactly_synchronized():
+    relative_paths = (
+        "base/solutions/training/f3e14006__ea61d17502dd.json",
+        "base/solutions/augmented/f3e14006__f4eca8c1e3b7.json",
+    )
+    records = []
+    for relative in relative_paths:
+        candidates = (ROOT / "data" / relative, ROOT / "shared" / "data" / relative)
+        path = next(candidate for candidate in candidates if candidate.is_file())
+        records.append(json.loads(path.read_text()))
+    selected = records[0]["racket_target"]["raw_code"]
+    for record in records:
+        assert record["racket_target"]["raw_code"] == selected
+        assert record["racket_target"]["target_code"] == selected
+
+
+def test_self_check_fails_closed_on_a_tiny_single_cell_grid():
+    assert GEN.self_check([[0]])
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"primary": "banana"},
+        {"span_mode": "striped"},
+        {"grid_h": True},
+        {"grid_w": "12"},
+        {"difficulty": "expert"},
+    ],
+)
+def test_invalid_control_values_are_rejected_loudly(kwargs):
+    with pytest.raises((TypeError, ValueError)):
+        GEN.generate(7, 3, **kwargs)
+
+
+def test_generation_is_deterministic_fresh_and_global_rng_pure():
+    random.seed(0xEA61D)
+    state = random.getstate()
+    first = GEN.generate(1234, 17, difficulty="hard")
+    assert random.getstate() == state
+    second = GEN.generate(1234, 17, difficulty="hard")
+    assert first == second
+    assert first is not second
+    assert all(left is not right for left, right in zip(first, second))
+    first[0][0] = 9 if first[0][0] != 9 else 8
+    assert GEN.generate(1234, 17, difficulty="hard") == second
+
+
+def test_self_check_rejects_rule_hiding_mutations():
+    base = GEN.generate(91, 2, difficulty="medium", span_mode="full")
+    facts = GEN._analysis(base)["facts"]
+    row = facts["strand_row"]
+    col = facts["strand_col"]
+
+    off_strand = copy.deepcopy(base)
+    off_strand[0 if row != 0 else 1][0 if col != 0 else 1] = facts[
+        "horizontal_base"
+    ]
+
+    gapped = copy.deepcopy(base)
+    gap_col = next(
+        index
+        for index in range(1, len(gapped[0]) - 1)
+        if index != col and gapped[row][index] == facts["horizontal_base"]
+    )
+    gapped[row][gap_col] = 0
+
+    extra_marker = copy.deepcopy(base)
+    marker_col = next(
+        index
+        for index in range(len(extra_marker[0]))
+        if index != col and extra_marker[row][index] == facts["horizontal_base"]
+    )
+    extra_marker[row][marker_col] = facts["horizontal_special"]
+
+    for mutation in (off_strand, gapped, extra_marker):
+        assert GEN.self_check(mutation)
+        with pytest.raises(ValueError):
+            GEN.rule_mirror(mutation)
