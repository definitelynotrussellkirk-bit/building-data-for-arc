+#!/usr/bin/env python3
+"""Fast source-bound curriculum census for ``ea61d17502dd``.
+
+This probe is intentionally supplementary: outputs come from the reviewed
+Python mirror, not from Racket.  Use the shared ``lesson-census`` command for
+final authority-backed evidence.  This script is for cheap iteration after a
+source edit: it checks determinism, strict validity, exact axis coverage,
+priority-rival disagreement, diversity, and every sampled consecutive lesson
+window.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+TASK = "ea61d17502dd"
+sys.path.insert(0, str(ROOT / "shared/runtime"))
+
+
+def load_generator(path: Path):
+    spec = importlib.util.spec_from_file_location("reviewed_ea61d17502dd", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load generator from {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def frozen(grid):
+    return tuple(tuple(row) for row in grid)
+
+
+def audit(module, *, per_band: int, lesson_starts: int):
+    bands = ("easy", "medium", "hard")
+    report = {
+        "schema": "ea61d17502dd-curriculum-probe-v1",
+        "task_id": TASK,
+        "version": module.VERSION,
+        "per_band": per_band,
+        "lesson_starts_per_band": lesson_starts,
+        "authority": "python_rule_mirror_only",
+        "bands": {},
+    }
+    failures = []
+    for band_index, band in enumerate(bands):
+        axes = Counter()
+        rival_disagreements = Counter()
+        unique_inputs = set()
+        unique_outputs = set()
+        valid = deterministic = 0
+        for index in range(per_band):
+            seed = 100_000 * (band_index + 1) + index
+            grid = module.generate(seed, index, difficulty=band)
+            replay = module.generate(seed, index, difficulty=band)
+            deterministic += grid == replay
+            issues = module.strict_canonical_like(grid)
+            if not issues:
+                valid += 1
+            else:
+                failures.append(
+                    {"kind": "strict", "band": band, "index": index, "issues": issues}
+                )
+            observed = module.observe_overrides(grid)
+            axes[(observed["primary"], observed["span_mode"])] += 1
+            output = module.rule_mirror(grid)
+            unique_inputs.add(frozen(grid))
+            unique_outputs.add(frozen(output))
+            for name, rival in module.LESSON_COMPETITORS.items():
+                rival_disagreements[name] += rival(grid) != output
+
+        identifiable = 0
+        lesson_failures = []
+        for start in range(lesson_starts):
+            seed = 900_000 + 10_000 * band_index + start
+            grids = [
+                module.generate(seed, start + offset, difficulty=band)
+                for offset in range(module.EXAMPLES_NEEDED + 1)
+            ]
+            demos = [
+                {"input": grid, "output": module.rule_mirror(grid)}
+                for grid in grids[: module.EXAMPLES_NEEDED]
+            ]
+            query = {"input": grids[-1], "output": module.rule_mirror(grids[-1])}
+            reasons = module.lesson_identifiable(demos, query)
+            if reasons:
+                lesson_failures.append({"start": start, "reasons": reasons})
+            else:
+                identifiable += 1
+
+        report["bands"][band] = {
+            "valid": valid,
+            "deterministic": deterministic,
+            "distinct_inputs": len(unique_inputs),
+            "distinct_outputs": len(unique_outputs),
+            "axis_pair_counts": {
+                f"{primary}:{span}": count
+                for (primary, span), count in sorted(axes.items())
+            },
+            "rival_disagreements": dict(sorted(rival_disagreements.items())),
+            "identifiable_lessons": identifiable,
+            "lesson_failures": lesson_failures[:5],
+        }
+        if identifiable != lesson_starts:
+            failures.extend(
+                {"kind": "lesson", "band": band, **item}
+                for item in lesson_failures
+            )
+
+    report["failures"] = failures[:20]
+    report["passed"] = not failures and all(
+        row["valid"] == per_band
+        and row["deterministic"] == per_band
+        and row["identifiable_lessons"] == lesson_starts
+        and all(count > 0 for count in row["rival_disagreements"].values())
+        for row in report["bands"].values()
+    )
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--generator",
+        type=Path,
+        default=ROOT / f"generators/{TASK}/generator.py",
+    )
+    parser.add_argument("--per-band", type=int, default=100)
+    parser.add_argument("--lesson-starts", type=int, default=32)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.per_band < 1 or args.lesson_starts < 1:
+        parser.error("counts must be positive")
+
+    generator_path = args.generator.resolve()
+    module = load_generator(generator_path)
+    report = audit(
+        module, per_band=args.per_band, lesson_starts=args.lesson_starts
+    )
+    report["generator_sha256"] = hashlib.sha256(generator_path.read_bytes()).hexdigest()
+    report["probe_sha256"] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps(report, indent=2))
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
