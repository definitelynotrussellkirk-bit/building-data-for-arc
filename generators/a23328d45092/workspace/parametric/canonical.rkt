(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((sep-r (find-first (lambda (r)
                                       (all? (lambda (c) (= 1 (at g r c))) (range 0 w)))
                                     (range 0 h)))
                  (sep-c (find-first (lambda (c)
                                       (all? (lambda (r) (= 1 (at g r c))) (range 0 h)))
                                     (range 0 w)))
                  (qh sep-r)
                  (qw sep-c))
             (build-grid qh
                         qw
                         (r c)
                         (let ((tl (at g r c))
                               (tr (at g r (+ sep-c 1 c)))
                               (bl (at g (+ sep-r 1 r) c))
                               (br (at g (+ sep-r 1 r) (+ sep-c 1 c))))
                           (cond
                             ((!= 0 tl) tl)
                             ((!= 0 tr) tr)
                             ((!= 0 bl) bl)
                             ((!= 0 br) br)
                             (else 0))))))))