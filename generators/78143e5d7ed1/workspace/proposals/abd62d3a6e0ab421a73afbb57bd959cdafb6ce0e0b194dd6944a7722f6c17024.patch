+"""Reusable bounded teaching and sampler audit for the strip-order family."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from strip_stack import DECLARED_RIVALS, SETTINGS, analyze, audit_episode, sample_query
+
+
+def run(seeds=(0, 17, 97), demo_counts=(2, 3, 6)):
+    rows = [audit_episode(seed, setting, demos=demos, queries=4)
+            for seed in seeds for demos in demo_counts for setting in SETTINGS]
+    large = [analyze(sample_query(seed, 3)) for seed in seeds]
+    if any(row["surviving_rivals"] for row in rows):
+        raise AssertionError("a declared rival survived a visible teaching set")
+    if any(row["has_30x30_query"] is not True for row in rows):
+        raise AssertionError("an audited episode omitted the 30x30 query")
+    if any(not facts["touches_all_canvas_sides"] for facts in large):
+        raise AssertionError("the maximum-size query lost structural boundary coverage")
+    return {
+        "schema": "arcpuzzles-parametric-authoring-audit-v1",
+        "task_id": "6b88648ff0e0",
+        "status": "passed",
+        "jobs": len(rows),
+        "seeds": list(seeds),
+        "demo_counts": list(demo_counts),
+        "settings": list(SETTINGS),
+        "declared_rivals": len(DECLARED_RIVALS),
+        "survivor_count": 0,
+        "large_query": large,
+        "rows": rows,
+        "scope": "bounded Python mirror audit; protected Racket labels are supplied by native qualification",
+        "training_admitted": False,
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args(argv)
+    result = run()
+    payload = json.dumps(result, sort_keys=True, indent=2) + "\n"
+    if args.out:
+        if args.out.exists():
+            raise FileExistsError(args.out)
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(payload, encoding="utf-8")
+    print(json.dumps({key: value for key, value in result.items() if key != "rows"}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
