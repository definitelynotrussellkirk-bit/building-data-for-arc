@@ -0,0 +1,25 @@
+"""Native adapter for episode-fixed whole-strip stack order."""
+from __future__ import annotations
+
+from strip_stack import episode_pairs, program_for
+
+
+def _settings(settings) -> str:
+    if (type(settings) is not dict or set(settings) != {"stack_order"}
+            or type(settings["stack_order"]) is not str):
+        raise ValueError("settings must contain exactly stack_order")
+    order = settings["stack_order"]
+    program_for(order)
+    return order
+
+
+def program(settings) -> str:
+    return program_for(_settings(settings))
+
+
+def generate(seed, settings, demos, queries):
+    if type(seed) is not int or not 0 <= seed <= 2**63 - 1:
+        raise ValueError("seed must be an exact nonnegative 63-bit integer")
+    order = _settings(settings)
+    train, test = episode_pairs(seed, order, demos, queries)
+    return {"train": train, "test": test, "program_solution": program_for(order)}
