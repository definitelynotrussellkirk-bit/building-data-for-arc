+"""Focused tests for the native strip-stack-order parametric family."""
+from __future__ import annotations
+
+import importlib
+import json
+from pathlib import Path
+import sys
+
+import pytest
+
+TASK = Path(__file__).resolve().parents[1]
+REPO = TASK.parents[1]
+PARAMETRIC = TASK / "workspace" / "parametric"
+
+
+def _module(name: str):
+    sys.modules.pop(name, None)
+    paths = [str(PARAMETRIC), str(REPO / "shared" / "runtime")]
+    before = list(sys.path)
+    sys.path[:0] = paths
+    try:
+        return importlib.import_module(name)
+    finally:
+        # Restore the exact prior path, including entries another test module
+        # intentionally installed during collection.
+        sys.path[:] = before
+
+
+def _canonical_program() -> str:
+    programs = {
+        json.loads(line)["program_solution"]
+        for line in (REPO / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()
+        if json.loads(line).get("task_id") == "6b88648ff0e0"
+    }
+    assert len(programs) == 1
+    return programs.pop()
+
+
+def test_default_program_is_exact_canonical_bytes():
+    adapter = _module("adapter")
+    assert adapter.program({"stack_order": "top_to_bottom"}) == _canonical_program()
+
+
+def test_generate_supports_two_to_six_demos_and_exactly_four_distinct_queries():
+    adapter = _module("adapter")
+    for demos in range(2, 7):
+        episode = adapter.generate(17, {"stack_order": "top_to_bottom"}, demos, 4)
+        assert len(episode["train"]) == demos
+        assert len(episode["test"]) == 4
+        all_inputs = [pair["input"] for pair in episode["train"] + episode["test"]]
+        assert len({json.dumps(grid, separators=(",", ":")) for grid in all_inputs}) == demos + 4
+        assert (len(episode["test"][-1]["input"]), len(episode["test"][-1]["input"][0])) == (30, 30)
+
+
+def test_settings_share_inputs_and_every_visible_demo_distinguishes_order():
+    adapter = _module("adapter")
+    top = adapter.generate(29, {"stack_order": "top_to_bottom"}, 3, 4)
+    bottom = adapter.generate(29, {"stack_order": "bottom_to_top"}, 3, 4)
+    for split in ("train", "test"):
+        assert [pair["input"] for pair in top[split]] == [pair["input"] for pair in bottom[split]]
+    assert all(a["output"] != b["output"] for a, b in zip(top["train"], bottom["train"]))
+
+
+def test_two_demo_teaching_set_rejects_every_declared_shortcut_for_both_settings():
+    family = _module("strip_stack")
+    for order in family.SETTINGS:
+        report = family.audit_episode(97, order, demos=2, queries=4)
+        assert report["surviving_rivals"] == []
+        assert report["query_count"] == 4
+        assert report["has_30x30_query"] is True
+
+
+def test_large_query_uses_full_canonical_domain_and_nonmonotonic_marker_geometry():
+    family = _module("strip_stack")
+    grid = family.sample_query(5, 3)
+    facts = family.analyze(grid)
+    assert facts["shape"] == [30, 30]
+    assert facts["group_count"] == 4
+    assert facts["content_width"] == 7
+    assert facts["output_shape"] == [8, 7]
+    assert facts["touches_all_canvas_sides"] is True
+    assert facts["nonmarker_cells"] >= 850
+    assert facts["top_row_order"] != facts["left_column_order"]
+
+
+def test_public_projection_excludes_private_program_setting_and_query_answers():
+    adapter = _module("adapter")
+    sys.path.insert(0, str(REPO / "shared" / "runtime"))
+    try:
+        from reviewer_support import public_challenge_bytes
+    finally:
+        sys.path.pop(0)
+
+    episode = adapter.generate(3, {"stack_order": "bottom_to_top"}, 2, 4)
+    visible = public_challenge_bytes(episode)
+    assert b"stack_order" not in visible
+    assert b"program_solution" not in visible
+    public = json.loads(visible)
+    assert all(set(pair) == {"input"} for pair in public["test"])
+
+
+def test_invalid_counts_settings_and_typed_values_fail_closed():
+    adapter = _module("adapter")
+    bad_settings = [None, {}, {"stack_order": "reverse"},
+                    {"stack_order": "top_to_bottom", "extra": 1}]
+    for settings in bad_settings:
+        with pytest.raises(ValueError):
+            adapter.program(settings)
+    for seed, demos, queries in [(True, 2, 4), (0, 1, 4), (0, 7, 4), (0, 2, 0), (0, 2, 5)]:
+        with pytest.raises(ValueError):
+            adapter.generate(seed, {"stack_order": "top_to_bottom"}, demos, queries)
+
+
+def test_intermediate_is_input_derived_and_wrong_left_column_order_changes_result():
+    family = _module("strip_stack")
+    grid = family.sample_query(11, 3)
+    state = family.strip_intermediate(grid, "bottom_to_top")
+    assert len(state["ordered_strips"]) == 4
+    assert [row["top_row"] for row in state["ordered_strips"]] == sorted(
+        (row["top_row"] for row in state["ordered_strips"]), reverse=True
+    )
+    assert family.rival_output(grid, "bottom_to_top", "left_column_order") != family.python_expected(
+        grid, "bottom_to_top"
+    )
