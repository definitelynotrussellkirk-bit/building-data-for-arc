+#!/usr/bin/env python3
+"""Bounded source-bound audit for e3a2ff6ea587.
+
+This tool is intentionally small enough for a future reviewer to rerun after a
+source edit. It checks generated grammar, exact control counts, finite declared
+rivals, and the Python mirror against the protected canonical Racket program.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+from puzzle_generators.rule_wrap import wrap_rule
+
+TASK_ID = "e3a2ff6ea587"
+BANDS = ("easy", "medium", "hard")
+SEEDS = (0, 17, 97)
+SAMPLE_INDICES = (0, 1, 2)
+
+
+def _sha256_bytes(payload: bytes) -> str:
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _canonical_program(root: Path) -> str:
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(root).read_text(encoding="utf-8").splitlines()
+        if line.strip()
+        for row in (json.loads(line),)
+        if row.get("task_id") == TASK_ID
+    }
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one canonical program for {TASK_ID}, got {len(programs)}")
+    return programs.pop()
+
+
+def _callable(source: str) -> str:
+    return wrap_rule(source)
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    rows = " ".join("(" + " ".join(map(str, row)) + ")" for row in grid)
+    return f"'({rows})"
+
+
+def _freeze(grid: list[list[int]]) -> tuple[tuple[int, ...], ...]:
+    return tuple(tuple(row) for row in grid)
+
+
+def _write_json(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def run(out: Path) -> dict[str, Any]:
+    root = find_root(__file__)
+    generator, source_path, source_sha = load_selected_generator(TASK_ID, root=root)
+    canonical = _canonical_program(root)
+    callable_source = _callable(canonical)
+
+    cases: list[dict[str, Any]] = []
+    rival_defeats = {name: 0 for name in generator.SEMANTIC_RIVALS}
+    first_witness: dict[str, dict[str, Any]] = {}
+    seen_inputs: set[tuple[tuple[int, ...], ...]] = set()
+    seen_outputs: set[tuple[tuple[int, ...], ...]] = set()
+    kind_counts = {kind: 0 for kind in generator.DISTRACTOR_KINDS}
+    racket_calls = 0
+
+    bridge = RacketBridge(timeout=30, max_calls_before_restart=128)
+    try:
+        runtime = bridge.runtime_identity
+        for band in BANDS:
+            for seed in SEEDS:
+                for sample_index in SAMPLE_INDICES:
+                    grid = generator.generate(seed, sample_index, difficulty=band)
+                    errors = generator.self_check(grid, difficulty=band)
+                    if errors:
+                        raise AssertionError(
+                            f"generated case {band}/{seed}/{sample_index} invalid: {errors}"
+                        )
+                    observed = generator.observe_overrides(grid)
+                    expected_kind = generator.schedule_profile(seed, sample_index, band)
+                    if expected_kind not in observed["distractor_kinds"]:
+                        raise AssertionError(
+                            f"scheduled {expected_kind} missing from {observed}"
+                        )
+                    for kind in observed["distractor_kinds"]:
+                        kind_counts[kind] += 1
+
+                    expression = f"({callable_source} {_grid_literal(grid)})"
+                    racket_output = bridge.eval_text(expression)
+                    racket_calls += 1
+                    python_output = generator.rule_mirror(grid)
+                    if racket_output != python_output:
+                        raise AssertionError(
+                            f"Racket/Python mismatch at {band}/{seed}/{sample_index}"
+                        )
+                    seen_inputs.add(_freeze(grid))
+                    seen_outputs.add(_freeze(racket_output))
+
+                    defeated = []
+                    for name, rival in generator.SEMANTIC_RIVALS.items():
+                        rival_output = rival(grid)
+                        if rival_output != racket_output:
+                            rival_defeats[name] += 1
+                            defeated.append(name)
+                            first_witness.setdefault(
+                                name,
+                                {
+                                    "band": band,
+                                    "seed": seed,
+                                    "sample_index": sample_index,
+                                    "input": grid,
+                                    "racket_output": racket_output,
+                                    "rival_output": rival_output,
+                                },
+                            )
+                    cases.append(
+                        {
+                            "band": band,
+                            "seed": seed,
+                            "sample_index": sample_index,
+                            "shape": [len(grid), len(grid[0])],
+                            "observed": observed,
+                            "input_sha256": _sha256_bytes(
+                                json.dumps(grid, separators=(",", ":")).encode()
+                            ),
+                            "output_sha256": _sha256_bytes(
+                                json.dumps(racket_output, separators=(",", ":")).encode()
+                            ),
+                            "defeated_rivals": defeated,
+                        }
+                    )
+
+        canonical_checks = []
+        for index, pair in enumerate(canonical_pairs(TASK_ID, root=root)):
+            grid = pair["input"]
+            expression = f"({callable_source} {_grid_literal(grid)})"
+            racket_output = bridge.eval_text(expression)
+            racket_calls += 1
+            if racket_output != pair["output"] or generator.rule_mirror(grid) != pair["output"]:
+                raise AssertionError(f"canonical pair {index} mismatch")
+            canonical_checks.append(
+                {
+                    "index": index,
+                    "input_sha256": _sha256_bytes(
+                        json.dumps(grid, separators=(",", ":")).encode()
+                    ),
+                    "output_sha256": _sha256_bytes(
+                        json.dumps(pair["output"], separators=(",", ":")).encode()
+                    ),
+                }
+            )
+    finally:
+        bridge.shutdown()
+
+    missing = [name for name, count in rival_defeats.items() if count == 0]
+    if missing:
+        raise AssertionError(f"declared rivals never defeated: {missing}")
+
+    control_rejections = {}
+    for axis, value in {
+        "typo_axis": 1,
+        "palette_size": 1,
+        "position_bias": "spread",
+        "n_distinct_colors": 1,
+        "rect_area": "mixed",
+    }.items():
+        try:
+            generator.generate(888, 9, difficulty="medium", **{axis: value})
+        except (KeyError, TypeError, ValueError) as exc:
+            control_rejections[axis] = type(exc).__name__
+        else:
+            raise AssertionError(f"removed/invented control {axis!r} was silently accepted")
+
+    boundary = generator.generate(
+        307,
+        911,
+        difficulty="easy",
+        grid_h=7,
+        grid_w=8,
+        n_rects=3,
+        n_distractors=2,
+        texture="mixed",
+    )
+    boundary_observed = generator.observe_overrides(boundary)
+    if boundary_observed["n_rects"] != 3 or boundary_observed["n_distractors"] != 2:
+        raise AssertionError(f"boundary exact-count failure: {boundary_observed}")
+
+    script_path = Path(__file__).resolve()
+    report = {
+        "schema": "e3a2ff6ea587-adversarial-review-v1",
+        "status": "passed",
+        "scope": "bounded finite audit; proposal remains catalog-unapproved",
+        "task_id": TASK_ID,
+        "generator_source": str(source_path.relative_to(root)),
+        "generator_sha256": source_sha,
+        "audit_source": str(script_path.relative_to(root)),
+        "audit_sha256": _sha256_bytes(script_path.read_bytes()),
+        "canonical_program_sha256": _sha256_bytes(canonical.encode()),
+        "canonical_program_normalized_sha256": _sha256_bytes(
+            " ".join(canonical.split()).encode()
+        ),
+        "racket_runtime": runtime,
+        "counts": {
+            "generated_cases": len(cases),
+            "canonical_pairs": len(canonical_checks),
+            "protected_racket_evaluations": racket_calls,
+            "distinct_generated_inputs": len(seen_inputs),
+            "distinct_generated_outputs": len(seen_outputs),
+        },
+        "coverage": {
+            "bands": list(BANDS),
+            "seeds": list(SEEDS),
+            "sample_indices": list(SAMPLE_INDICES),
+            "distractor_kind_case_counts": kind_counts,
+            "rival_defeat_counts": rival_defeats,
+            "all_declared_rivals_defeated": not missing,
+        },
+        "control_rejections": control_rejections,
+        "constructive_boundary": {
+            "requested": {
+                "grid_h": 7,
+                "grid_w": 8,
+                "n_rects": 3,
+                "n_distractors": 2,
+                "texture": "mixed",
+            },
+            "observed": boundary_observed,
+            "self_check": generator.self_check(boundary),
+            "input": boundary,
+        },
+        "canonical_checks": canonical_checks,
+        "generated_cases": cases,
+        "first_racket_backed_witness_by_rival": first_witness,
+        "limitations": [
+            "finite declared-rival audit, not a proof of unique induction",
+            "peer repair is not owner-accepted or training-admitted",
+        ],
+    }
+    _write_json(out, report)
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    report = run(args.out)
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "generator_sha256": report["generator_sha256"],
+                "counts": report["counts"],
+                "rival_defeat_counts": report["coverage"]["rival_defeat_counts"],
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
