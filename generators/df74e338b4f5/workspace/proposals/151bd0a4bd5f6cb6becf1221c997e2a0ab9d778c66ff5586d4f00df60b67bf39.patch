@@ -0,0 +1,303 @@
+#!/usr/bin/env python3
+"""Protected-Racket audit for the zero-header curriculum split.
+
+Future reviewers can rerun this after edits to verify that core lessons contain
+bare marker-only zero-header rows, rich lessons contain the spectator variant,
+and the canonical rule—not a Python-only oracle—defeats every declared rival.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from copy import deepcopy
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+TASK_ID = "0d5077971eea"
+BANDS = ("easy", "medium", "hard")
+SEEDS = (0, 17, 97)
+SAMPLE_INDICES = (2, 3)  # core, rich
+
+
+def _sha256_bytes(payload: bytes) -> str:
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _grid_digest(grid: list[list[int]]) -> str:
+    return _sha256_bytes(json.dumps(grid, separators=(",", ":")).encode())
+
+
+def _canonical_program(root: Path) -> str:
+    programs = {
+        row["program_solution"]
+        for line in canonical_path(root).read_text(encoding="utf-8").splitlines()
+        if line.strip()
+        for row in (json.loads(line),)
+        if row.get("task_id") == TASK_ID and row.get("program_solution")
+    }
+    if len(programs) != 1:
+        raise RuntimeError(f"expected one canonical program for {TASK_ID}, got {len(programs)}")
+    return programs.pop()
+
+
+def _grid_literal(grid: list[list[int]]) -> str:
+    rows = " ".join("(" + " ".join(map(str, row)) + ")" for row in grid)
+    return f"'({rows})"
+
+
+def _row_oracle(grid: list[list[int]]) -> list[list[int]]:
+    return [
+        [key if column > 0 and value == 8 and key != 0 else value
+         for column, value in enumerate(row)]
+        for row in grid
+        for key in [row[0]]
+    ]
+
+
+def classify_zero_header_rows(grid: list[list[int]]) -> dict[str, list[int]]:
+    """Return zero-header rows with markers, split by foreign spectators."""
+    bare: list[int] = []
+    spectator: list[int] = []
+    for index, row in enumerate(grid):
+        if row[0] != 0 or 8 not in row[1:]:
+            continue
+        if all(value in (0, 8) for value in row[1:]):
+            bare.append(index)
+        elif any(value not in (0, 8) for value in row[1:]):
+            spectator.append(index)
+    return {"bare_marker_rows": bare, "spectator_marker_rows": spectator}
+
+
+def _write_json(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def _assert_rejected(generator: Any, *, seed: Any = 1, sample_index: Any = 0,
+                     difficulty: Any = None) -> str:
+    try:
+        generator.generate(seed, sample_index, difficulty=difficulty)
+    except (TypeError, ValueError) as exc:
+        return type(exc).__name__
+    raise AssertionError(
+        f"invalid scalar accepted: seed={seed!r}, sample_index={sample_index!r}, "
+        f"difficulty={difficulty!r}"
+    )
+
+
+def run(out: Path) -> dict[str, Any]:
+    root = find_root(__file__)
+    generator, source_path, source_sha = load_selected_generator(TASK_ID, root=root)
+    canonical_program = _canonical_program(root)
+    callable_source = wrap_rule(canonical_program)
+
+    rival_names = sorted(generator.SEMANTIC_RIVALS)
+    rival_defeats = {name: 0 for name in rival_names}
+    canonical_fit = {name: 0 for name in rival_names}
+    first_witness: dict[str, dict[str, Any]] = {}
+    generated_rows: list[dict[str, Any]] = []
+    profile_counts = {
+        "core_bare_cases": 0,
+        "core_spectator_cases": 0,
+        "rich_bare_cases": 0,
+        "rich_spectator_cases": 0,
+    }
+    generated_inputs: set[str] = set()
+    generated_outputs: set[str] = set()
+    racket_calls = 0
+
+    bridge = RacketBridge(timeout=30, max_calls_before_restart=128)
+    try:
+        runtime = deepcopy(bridge.runtime_identity)
+        if runtime.get("backend") != "racket" or runtime.get("protected") is not True:
+            raise RuntimeError(f"protected Racket required, got {runtime}")
+
+        for band in BANDS:
+            for seed in SEEDS:
+                for sample_index in SAMPLE_INDICES:
+                    grid = generator.generate(seed, sample_index, difficulty=band)
+                    if generator.generate(seed, sample_index, difficulty=band) != grid:
+                        raise AssertionError(f"nondeterministic draw {band}/{seed}/{sample_index}")
+                    errors = generator.self_check(grid, difficulty=band)
+                    if errors:
+                        raise AssertionError(f"invalid draw {band}/{seed}/{sample_index}: {errors}")
+                    profile = generator.schedule_profile(seed, sample_index, band)
+                    classification = classify_zero_header_rows(grid)
+                    if profile == "core":
+                        if not classification["bare_marker_rows"]:
+                            raise AssertionError(f"core draw lacks bare row: {band}/{seed}/{sample_index}")
+                        if classification["spectator_marker_rows"]:
+                            raise AssertionError(f"core draw unexpectedly has spectator row: {band}/{seed}/{sample_index}")
+                        profile_counts["core_bare_cases"] += 1
+                    elif profile == "rich":
+                        if not classification["spectator_marker_rows"]:
+                            raise AssertionError(f"rich draw lacks spectator row: {band}/{seed}/{sample_index}")
+                        if classification["bare_marker_rows"]:
+                            raise AssertionError(f"rich draw unexpectedly has bare row: {band}/{seed}/{sample_index}")
+                        profile_counts["rich_spectator_cases"] += 1
+                    else:
+                        raise AssertionError(f"unexpected profile {profile!r}")
+
+                    racket_output = bridge.eval_text(f"({callable_source} {_grid_literal(grid)})")
+                    racket_calls += 1
+                    oracle_output = _row_oracle(grid)
+                    if racket_output != oracle_output:
+                        raise AssertionError(f"Racket/oracle mismatch {band}/{seed}/{sample_index}")
+
+                    defeated: list[str] = []
+                    for name in rival_names:
+                        rival_output = generator.SEMANTIC_RIVALS[name](deepcopy(grid))
+                        if rival_output != racket_output:
+                            rival_defeats[name] += 1
+                            defeated.append(name)
+                            first_witness.setdefault(
+                                name,
+                                {
+                                    "band": band,
+                                    "seed": seed,
+                                    "sample_index": sample_index,
+                                    "profile": profile,
+                                    "input": grid,
+                                    "racket_output": racket_output,
+                                    "rival_output": rival_output,
+                                },
+                            )
+
+                    conditional = generator.SEMANTIC_RIVALS[
+                        "nearest_key_for_marker_only_rows"
+                    ](deepcopy(grid))
+                    if profile == "core" and conditional == racket_output:
+                        raise AssertionError("conditional nearest-header rival survived a core draw")
+                    if profile == "rich" and conditional != racket_output:
+                        raise AssertionError("conditional nearest-header rival should fit the spectator branch")
+
+                    input_sha = _grid_digest(grid)
+                    output_sha = _grid_digest(racket_output)
+                    generated_inputs.add(input_sha)
+                    generated_outputs.add(output_sha)
+                    generated_rows.append(
+                        {
+                            "band": band,
+                            "seed": seed,
+                            "sample_index": sample_index,
+                            "profile": profile,
+                            "shape": [len(grid), len(grid[0])],
+                            "zero_header_rows": classification,
+                            "input_sha256": input_sha,
+                            "output_sha256": output_sha,
+                            "defeated_rivals": defeated,
+                        }
+                    )
+
+        canonical_checks: list[dict[str, Any]] = []
+        canonical = canonical_pairs(TASK_ID, root=root)
+        for index, pair in enumerate(canonical):
+            racket_output = bridge.eval_text(
+                f"({callable_source} {_grid_literal(pair['input'])})"
+            )
+            racket_calls += 1
+            if racket_output != pair["output"] or _row_oracle(pair["input"]) != pair["output"]:
+                raise AssertionError(f"canonical pair {index} mismatch")
+            for name in rival_names:
+                if generator.SEMANTIC_RIVALS[name](deepcopy(pair["input"])) == pair["output"]:
+                    canonical_fit[name] += 1
+            canonical_checks.append(
+                {
+                    "index": index,
+                    "input_sha256": _grid_digest(pair["input"]),
+                    "output_sha256": _grid_digest(pair["output"]),
+                }
+            )
+    finally:
+        bridge.shutdown()
+
+    missing = [name for name, count in rival_defeats.items() if count == 0]
+    if missing:
+        raise AssertionError(f"declared rivals never defeated: {missing}")
+    canonical_count = len(canonical_checks)
+    bad_canonical_claims = [name for name, count in canonical_fit.items() if count != canonical_count]
+    if bad_canonical_claims:
+        raise AssertionError(f"declared canonical-compatible rivals do not fit: {bad_canonical_claims}")
+
+    scalar_rejections = {
+        "bad_seed_bool": _assert_rejected(generator, seed=True),
+        "bad_seed_float": _assert_rejected(generator, seed=1.0),
