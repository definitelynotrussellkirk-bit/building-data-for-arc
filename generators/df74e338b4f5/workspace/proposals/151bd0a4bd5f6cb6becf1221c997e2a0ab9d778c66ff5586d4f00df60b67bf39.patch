+"""Focused contract and learnability regressions for e3a2ff6ea587."""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+import random
+
+import pytest
+
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+ROOT = find_root(__file__)
+TASK_ID = "e3a2ff6ea587"
+GEN, SOURCE_PATH, _SOURCE_SHA = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _canonical_row() -> dict:
+    rows = [
+        json.loads(line)
+        for line in canonical_path(ROOT).read_text(encoding="utf-8").splitlines()
+        if line.strip()
+    ]
+    return next(row for row in rows if row.get("task_id") == TASK_ID)
+
+
+def _freeze(grid):
+    return tuple(tuple(row) for row in grid)
+
+
+def _pairs():
+    return [
+        (copy.deepcopy(pair["input"]), copy.deepcopy(pair["output"]))
+        for pair in canonical_pairs(TASK_ID, root=ROOT)
+    ]
+
+
+def _labeled(seed: int, start: int, band: str):
+    return [
+        {
+            "input": (grid := GEN.generate(seed, index, difficulty=band)),
+            "output": GEN.rule_mirror(grid),
+        }
+        for index in range(start, start + 3)
+    ]
+
+
+def test_canonical_authority_hash_pairs_and_python_mirror_are_exact():
+    row = _canonical_row()
+    normalized = " ".join(row["program_solution"].split()).encode()
+    assert hashlib.sha256(normalized).hexdigest()[:12] == GEN.RULE_HASH == "fc212e483f16"
+    pairs = _pairs()
+    assert len(pairs) == 5
+    for grid, expected in pairs:
+        before = copy.deepcopy(grid)
+        assert GEN.self_check(grid) == []
+        assert GEN.rule_mirror(grid) == expected
+        assert grid == before
+
+
+@pytest.mark.parametrize("bad_sample_index", [True, False, 1.0, "1", -1])
+def test_sample_index_rejects_invalid_scalars(bad_sample_index):
+    with pytest.raises((TypeError, ValueError)):
+        GEN.generate(11, bad_sample_index, difficulty="easy")
+
+
+@pytest.mark.parametrize(
+    ("axis", "bad_value"),
+    [
+        ("grid_h", True),
+        ("grid_w", 9.0),
+        ("n_rects", "2"),
+        ("n_distractors", False),
+    ],
+)
+def test_integer_controls_reject_coercible_values(axis, bad_value):
+    with pytest.raises((TypeError, ValueError)):
+        GEN.generate(11, 0, difficulty="medium", **{axis: bad_value})
+
+
+def test_unknown_and_removed_inert_controls_are_rejected_loudly():
+    for kwargs in (
+        {"typo_axis": 1},
+        {"palette_size": 1},
+        {"position_bias": "spread"},
+        {"n_distinct_colors": 1},
+        {"rect_area": "mixed"},
+    ):
+        with pytest.raises((KeyError, TypeError, ValueError)):
+            GEN.generate(17, 2, difficulty="medium", **kwargs)
+
+
+@pytest.mark.parametrize("band", ["easy", "medium", "hard"])
+def test_every_three_sample_lesson_covers_all_negative_predicates(band):
+    expected = set(GEN.DISTRACTOR_KINDS)
+    for start in range(6):
+        seen = set()
+        for index in range(start, start + 3):
+            grid = GEN.generate(20261024, index, difficulty=band)
+            assert GEN.self_check(grid, difficulty=band) == []
+            observed = GEN.observe_overrides(grid)
+            assert observed["n_rects"] >= 1
+            assert observed["n_distractors"] >= 1
+            seen.update(observed["distractor_kinds"])
+        assert expected <= seen
+
+
+@pytest.mark.parametrize("band", ["easy", "medium", "hard"])
+def test_exact_boundary_overrides_are_constructive_without_count_fallback(band):
+    for grid_h in (7, 18):
+        for grid_w in (8, 22):
+            for n_rects in (1, 3):
+                for n_distractors in (1, 2):
+                    requested = {
+                        "grid_h": grid_h,
+                        "grid_w": grid_w,
+                        "n_rects": n_rects,
+                        "n_distractors": n_distractors,
+                        "texture": "mixed",
+                    }
+                    grid = GEN.generate(307, 911, difficulty=band, **requested)
+                    assert (len(grid), len(grid[0])) == (grid_h, grid_w)
+                    observed = GEN.observe_overrides(grid)
+                    assert observed["n_rects"] == n_rects
+                    assert observed["n_distractors"] == n_distractors
+                    assert GEN.self_check(grid, meta={"overrides": requested}) == []
+
+
+@pytest.mark.parametrize("band", ["easy", "medium", "hard"])
+def test_default_distribution_is_exact_diverse_and_has_real_negative_witnesses(band):
+    inputs = set()
+    outputs = set()
+    kinds = set()
+    for seed in range(90):
+        grid = GEN.generate(seed, seed * 13 + 5, difficulty=band)
+        output = GEN.rule_mirror(grid)
+        observed = GEN.observe_overrides(grid)
+        assert GEN.self_check(grid, difficulty=band) == []
+        assert observed["n_rects"] >= 1
+        assert observed["n_distractors"] >= 1
+        assert any(value != 0 for row in output for value in row)
+        assert output != grid
+        kinds.update(observed["distractor_kinds"])
+        inputs.add(_freeze(grid))
+        outputs.add(_freeze(output))
+    assert kinds == set(GEN.DISTRACTOR_KINDS)
+    assert len(inputs) >= 88
+    assert len(outputs) >= 88
+
+
+def test_palette_axis_changes_realized_colors_without_changing_roles():
+    grids = {
+        kind: GEN.generate(
+            431,
+            919,
+            difficulty="medium",
+            grid_h=11,
+            grid_w=15,
+            n_rects=2,
+            n_distractors=2,
+            texture="mixed",
+            palette_kind=kind,
+        )
+        for kind in GEN.PALETTE_KINDS
+    }
+    assert len({_freeze(grid) for grid in grids.values()}) == len(GEN.PALETTE_KINDS)
+    roles = [GEN.observe_overrides(grid) for grid in grids.values()]
+    assert all(item["n_rects"] == 2 for item in roles)
+    assert all(item["n_distractors"] == 2 for item in roles)
+    assert all(set(item["distractor_kinds"]) == {"three_corners", "extra_cell"}
+               for item in roles)
+
+
+def test_semantic_rivals_are_eliminated_by_each_three_example_lesson():
+    for band in ("easy", "medium", "hard"):
+        for start in range(6):
+            demos = _labeled(991, start, band)
+            query_grid = GEN.generate(992, start + 19, difficulty=band)
+            assert GEN.lesson_identifiable(demos, {"input": query_grid}) == []
+            for name, rival in GEN.SEMANTIC_RIVALS.items():
+                assert any(
+                    rival(pair["input"]) != pair["output"]
+                    for pair in demos
+                ), name
+
+
+def test_self_check_rejects_structural_impostors_but_mirror_handles_them():
+    empty = [[0] * 9 for _ in range(7)]
+    one_corner = copy.deepcopy(empty)
+    one_corner[1][1] = 2
+    six_cells = copy.deepcopy(empty)
+    for row, col in ((1, 1), (1, 4), (4, 1), (4, 4), (2, 2), (3, 3)):
+        six_cells[row][col] = 3
+    ragged = [[0, 0], [0]]
+    bad_color = [[0, 10], [0, 0]]
+    for grid in (empty, one_corner, six_cells, ragged, bad_color):
+        assert GEN.self_check(grid)
+    assert GEN.rule_mirror(six_cells) == empty
+
+
+def test_generation_is_deterministic_fresh_and_global_rng_isolated():
+    state = random.getstate()
+    first = GEN.generate(733, 911, difficulty="hard")
+    second = GEN.generate(733, 911, difficulty="hard")
+    assert first == second
+    assert first is not second
+    assert all(left is not right for left, right in zip(first, second))
+    first[0][0] = (first[0][0] + 1) % 10
+    assert GEN.generate(733, 911, difficulty="hard") == second
+    assert random.getstate() == state
+
+
+def test_declared_schedule_and_texture_controls_are_observable():
+    expected_schedule = (
+        "three_corners",
+        "extra_cell",
+        "misplaced_four",
+    )
+    assert tuple(GEN.schedule_profile(1, index) for index in range(3)) == expected_schedule
+    for texture in (*GEN.DISTRACTOR_KINDS, "mixed"):
+        grid = GEN.generate(
+            19,
+            4,
+            difficulty="medium",
+            grid_h=10,
+            grid_w=14,
+            n_rects=1,
+            n_distractors=2 if texture == "mixed" else 1,
+            texture=texture,
+        )
+        kinds = GEN.observe_overrides(grid)["distractor_kinds"]
+        if texture == "mixed":
+            assert kinds == ["three_corners", "extra_cell"]
+        else:
+            assert kinds == [texture]
+
+@pytest.mark.parametrize("band", ["easy", "medium", "hard"])
+def test_every_generated_target_has_a_true_interior_and_refutes_outline_only(band):
+    for seed in range(120):
+        grid = GEN.generate(seed, seed * 29 + 7, difficulty=band)
+        analysis = GEN._analysis(grid)
+        assert analysis["errors"] == []
+        for _color, (top, left, bottom, right) in analysis["targets"]:
+            assert bottom - top + 1 >= 3
+            assert right - left + 1 >= 3
+        assert GEN.SEMANTIC_RIVALS["outline_only"](grid) != GEN.rule_mirror(grid)
