+BBox = tuple[int, int, int, int]
+
+
+def _bbox(cells: Iterable[Cell]) -> BBox:
+    cells = list(cells)
+    rows = [row for row, _ in cells]
+    cols = [col for _, col in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _bbox_area(box: BBox) -> int:
+    top, left, bottom, right = box
+    return (bottom - top + 1) * (right - left + 1)
+
+
+def _bbox_cells(box: BBox) -> set[Cell]:
+    top, left, bottom, right = box
+    return {
+        (row, col)
+        for row in range(top, bottom + 1)
+        for col in range(left, right + 1)
+    }
+
+
+def _corners(box: BBox) -> tuple[Cell, Cell, Cell, Cell]:
+    top, left, bottom, right = box
+    return (
+        (top, left),
+        (top, right),
+        (bottom, left),
+        (bottom, right),
+    )
+
+
+def _bbox_overlap(left: BBox, right: BBox) -> bool:
+    return not (
+        left[2] < right[0]
+        or right[2] < left[0]
+        or left[3] < right[1]
+        or right[3] < left[1]
+    )
+
+
+def _partition_by_minima(
+    length: int,
+    minima: tuple[int, ...],
+    rng,
+) -> list[tuple[int, int]]:
+    """Partition an axis while preserving an exact minimum for every span."""
+    remaining = length - sum(minima)
+    if remaining < 0:
+        raise ValueError(
+            f"cannot partition axis length {length} with minima {minima}"
+        )
+    extras = [0] * len(minima)
+    for _ in range(remaining):  # at most sixteen bounded placements.
+        extras[rng.randrange(len(extras))] += 1
+    sizes = [minimum + extra for minimum, extra in zip(minima, extras)]
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for size in sizes:
+        spans.append((start, start + size - 1))
+        start += size
+    return spans
+
+
+def _zone(row_span: tuple[int, int], col_span: tuple[int, int]) -> BBox:
+    return row_span[0], col_span[0], row_span[1], col_span[1]
+
+
+def _subbox(zone: BBox, min_height: int, min_width: int, rng) -> BBox:
+    top, left, bottom, right = zone
+    zone_h = bottom - top + 1
+    zone_w = right - left + 1
+    if zone_h < min_height or zone_w < min_width:
+        raise ValueError(
+            f"zone {zone} cannot hold a {min_height}x{min_width} box"
+        )
+    rect_h = rng.randint(min_height, zone_h)
+    rect_w = rng.randint(min_width, zone_w)
+    box_top = top + rng.randrange(zone_h - rect_h + 1)
+    box_left = left + rng.randrange(zone_w - rect_w + 1)
+    return box_top, box_left, box_top + rect_h - 1, box_left + rect_w - 1
+
+
+def _choose_object_boxes(
+    height: int,
+    width: int,
+    n_targets: int,
+    n_distractors: int,
+    rng,
+) -> list[BBox]:
+    """Construct role-aware disjoint boxes with no retries or fallback.
+
+    The minimum 7x8 canvas admits three 3x3 target zones and two 2x3
+    distractor zones. Larger canvases distribute their spare rows/columns
+    among those zones, after which each role samples a lawful subbox.
+    """
+    if not 1 <= n_targets <= 3:
+        raise ValueError(f"n_targets outside constructive range: {n_targets}")
+    if not 1 <= n_distractors <= 2:
+        raise ValueError(
+            f"n_distractors outside constructive range: {n_distractors}"
+        )
+
+    left_cols, right_cols = _partition_by_minima(width, (3, 3), rng)
+    left_top, left_bottom = _partition_by_minima(height, (3, 3), rng)
+    right_top, right_middle, right_bottom = _partition_by_minima(
+        height, (3, 2, 2), rng
+    )
+
+    target_zones = [
+        _zone(left_top, left_cols),
+        _zone(right_top, right_cols),
+        _zone(left_bottom, left_cols),
+    ]
+    distractor_zones = [
+        _zone(right_middle, right_cols),
+        _zone(right_bottom, right_cols),
+    ]
+    rng.shuffle(target_zones)
+    rng.shuffle(distractor_zones)
+
+    targets = [
+        _subbox(zone, 3, 3, rng)
+        for zone in target_zones[:n_targets]
+    ]
+    distractors = [
+        _subbox(zone, 2, 3, rng)
+        for zone in distractor_zones[:n_distractors]
+    ]
+    boxes = targets + distractors
+    if any(
+        _bbox_overlap(left, right)
+        for index, left in enumerate(boxes)
+        for right in boxes[index + 1 :]
+    ):
+        raise RuntimeError("constructive role zones produced overlapping boxes")
+    return boxes
+
+
+def _distractor_cells(box: BBox, kind: str, rng) -> set[Cell]:
+    corners = set(_corners(box))
+    noncorners = tuple(sorted(_bbox_cells(box) - corners))
+    if not noncorners:
+        raise ValueError(f"box {box} cannot carry a nontrivial distractor")
+    if kind == "three_corners":
+        removed = rng.choice(tuple(sorted(corners)))
+        return corners - {removed}
+    if kind == "extra_cell":
+        return corners | {rng.choice(noncorners)}
+    if kind == "misplaced_four":
+        removed = rng.choice(tuple(sorted(corners)))
+        return (corners - {removed}) | {rng.choice(noncorners)}
+    raise ValueError(f"unsupported distractor kind: {kind}")
+
+
+def _distractor_sequence(texture: str, count: int) -> list[str]:
+    if texture == "mixed":
+        return [DISTRACTOR_KINDS[index % len(DISTRACTOR_KINDS)] for index in range(count)]
+    if texture not in DISTRACTOR_KINDS:
+        raise ValueError(f"unsupported texture: {texture}")
+    return [texture] * count
+
+
+def schedule_profile(seed: int, sample_index: int, difficulty=None) -> str:
+    del seed, difficulty
+    return SCHEDULE_PROFILES[sample_index % len(SCHEDULE_PROFILES)]
+
+
+def _validate_generate_scalars(sample_index, difficulty, overrides) -> None:
+    unknown = sorted(set(overrides) - set(AXES))
+    if unknown:
+        raise ValueError(f"unknown override axis/axes: {', '.join(unknown)}")
+    if type(sample_index) is not int:
+        raise TypeError("sample_index must be an integer")
+    if sample_index < 0:
+        raise ValueError("sample_index must be non-negative")
+    if difficulty not in (None, "easy", "medium", "hard") and not isinstance(
+        difficulty, (int, float)
+    ):
+        raise ValueError(f"unsupported difficulty: {difficulty!r}")
+    for axis in _INTEGER_AXES:
+        if axis in overrides and overrides[axis] is not None and type(overrides[axis]) is not int:
+            raise TypeError(f"{axis} must be an integer (not bool or a coercible value)")
+    for axis in ("texture", "palette_kind"):
+        if axis in overrides and overrides[axis] is not None and type(overrides[axis]) is not str:
+            raise TypeError(f"{axis} must be a string")
+
+
+def generate(seed, sample_index, *, difficulty=None, **overrides):
