+def _classify_color(cells: list[Cell]) -> tuple[str, BBox] | None:
+    box = _bbox(cells)
+    corners = set(_corners(box))
+    cell_set = set(cells)
+    if len(cells) == 4 and cell_set == corners:
+        return "target", box
+    if len(cells) == 3 and cell_set.issubset(corners):
+        return "three_corners", box
+    if len(cells) == 5 and corners.issubset(cell_set) and len(cell_set - corners) == 1:
+        return "extra_cell", box
+    if (
+        len(cells) == 4
+        and len(cell_set & corners) == 3
+        and len(cell_set - corners) == 1
+    ):
+        return "misplaced_four", box
+    return None
