+    grid = full_grid(height, width, 0)
+    for color, box in zip(colors[:n_rects], boxes[:n_rects]):
+        for row, col in _corners(box):
+            grid[row][col] = color
+    for color, box, kind in zip(colors[n_rects:], boxes[n_rects:], kinds):
+        for row, col in _distractor_cells(box, kind, rng):
