+def rule_mirror(grid):
+    """Pure Python mirror used only for audits; Racket remains authoritative."""
+    return _solve_with_turn_selector(grid, lambda frame_color: frame_color - 1)
+
+
+def _fixed_turn(turns: int):
+    return lambda grid: _solve_with_turn_selector(grid, lambda _color: turns)
+
+
+def _reverse_key_direction(grid):
+    return _solve_with_turn_selector(
+        grid,
+        lambda frame_color: (-(frame_color - 1)) % 4,
+    )
