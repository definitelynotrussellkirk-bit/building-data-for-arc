+def _crop_nonzero(matrix):
+    cells = [
+        (row, col)
+        for row in range(len(matrix))
+        for col in range(len(matrix[0]))
+        if matrix[row][col] != 0
+    ]
+    if not cells:
+        return [[0]]
+    top = min(row for row, _ in cells)
+    bottom = max(row for row, _ in cells)
+    left = min(col for _, col in cells)
+    right = max(col for _, col in cells)
+    return [row[left:right + 1] for row in matrix[top:bottom + 1]]
+
+
+def _rotate_matrix(matrix, turns: int):
+    out = [list(row) for row in matrix]
+    for _ in range(turns % 4):
+        out = [list(row) for row in zip(*out[::-1])]
+    return out
+
+
+def _solve_with_turn_selector(grid, turn_selector):
+    facts = semantic_observables(grid)
+    output = full_grid(facts["grid_h"], facts["grid_w"], 0)
+    for frame in facts["frames"]:
+        top, left = frame["top"], frame["left"]
+        bottom, right = frame["bottom"], frame["right"]
+        color = frame["color"]
+        for col in range(left, right + 1):
+            output[top][col] = color
+            output[bottom][col] = color
+        for row in range(top, bottom + 1):
+            output[row][left] = color
+            output[row][right] = color
+
+        interior_size = frame["side"] - 2
+        interior = [
+            [grid[top + 1 + row][left + 1 + col] for col in range(interior_size)]
+            for row in range(interior_size)
+        ]
+        shape = _crop_nonzero(interior)
+        rotated = _rotate_matrix(shape, turn_selector(color) % 4)
+        paste_top = top + 1 + (interior_size - len(rotated)) // 2
+        paste_left = left + 1 + (interior_size - len(rotated[0])) // 2
+        for row, values in enumerate(rotated):
+            for col, value in enumerate(values):
+                if value != 0:
+                    output[paste_top + row][paste_left + col] = value
+    return output
+
