+"""Bounded peer audit: four palette-rank shortcuts, with protected Racket labels.
+
+Run from the packet root with review.py; see notes.md for the exact command.
+This is a proposed teaching helper, not a production-generator repair.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "src"))
+
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+
+TASK = "7d1e8744229a"
+EXPECTED_SOURCE = "ce15c05fb1f3492ea891996c59fc224d5a42026bc65bfeffec265ced3a089ac7"
+EXPECTED_RULE = "a51754da50c2"
+SEEDS = (0, 1)
+INDICES_PER_SEED = 8
+
+
+def sha256(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def roles(grid):
+    return [grid[0][0], grid[0][1], grid[2][2]]
+
+
+def rival_programs(canonical):
+    """Keep the observed 5x5 seed; use numeric color roles only in expansion."""
+    old = "(list-ref colors (at pat r col))"
+    assert canonical.count(old) == 1
+    copied_seed = canonical.replace(
+        old,
+        "(if (and (< r 5) (< col 5)) (at g r col) " + old + ")",
+    )
+    old_colors = "(colors (list a b c))"
+    assert copied_seed.count(old_colors) == 1
+    low = "(min a (min b c))"
+    high = "(max a (max b c))"
+    middle = f"(- (+ a b c) {low} {high})"
+    replacements = {
+        "corner_min_extension": f"(colors (list {low} b c))",
+        "body_median_extension": f"(colors (list a {middle} c))",
+        "center_max_extension": f"(colors (list a b {high}))",
+        "palette_ascending_extension": f"(colors (list {low} {middle} {high}))",
+    }
+    return {name: copied_seed.replace(old_colors, value)
+            for name, value in replacements.items()}
+
+
+def demo_only_survivors(demos, programs, apply_program):
+    """Proposed finite guard. Only demonstration inputs/outputs are consulted.
+
+    Exceptions deliberately propagate: execution errors are not refutations.
+    A nonempty result asks an author for a distinguishing demonstration; an
+    empty result excludes only these four finite rivals, not every wrong rule.
+    """
+    return [name for name, program in programs.items()
+            if all(_grid(apply_program(program, demo["input"])) == demo["output"]
+                   for demo in demos)]
+
+
+def first_difference(left, right):
+    for row in range(len(left)):
+        for col in range(len(left[row])):
+            if left[row][col] != right[row][col]:
+                return {"row": row, "col": col,
+                        "intended": left[row][col], "rival": right[row][col]}
+    return None
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    ledger = ROOT / "shared/data/canonical/puzzles.jsonl"
+    selected = [json.loads(line) for line in ledger.read_text().splitlines()
+                if json.loads(line).get("task_id") == TASK]
+    assert len(selected) == 1
+    canonical_row = selected[0]
+    canonical = canonical_row["program_solution"]
+    assert sha256(" ".join(canonical.split()).encode())[:12] == EXPECTED_RULE
+    programs = rival_programs(canonical)
+    report = {
+        "schema": "arcpuzzles-bounded-peer-adversarial-probe-v1",
+        "task_id": TASK,
+        "status": "running",
+        "scope": "canonical saved two-demo lesson and two generated three-demo lessons",
+        "production_source_unchanged": True,
+        "source_binding": {
+            "generator_sha256": EXPECTED_SOURCE,
+            "rule_hash": EXPECTED_RULE,
+            "canonical_program_sha256": sha256(canonical.encode()),
+            "canonical_ledger_path": str(ledger.relative_to(ROOT)),
+            "probe_sha256": sha256(Path(__file__).read_bytes()),
+        },
+        "programs": {"intended": canonical, **programs},
+        "execution_errors": [],
+        "sampling": {"seeds": list(SEEDS), "difficulty": None,
+                     "indices_per_seed": INDICES_PER_SEED, "generated_inputs": 16,
+                     "demonstration_indices": [0, 1, 2],
+                     "query_indices": [3, 4, 5, 6], "extra_candidate_index": 7},
+        "limits": [
+            "Only four authored numeric-palette rivals are examined.",
+            "Canonical saved demos are distinct from generated lessons.",
+            "No production source, canonical rule, admission or approval is changed.",
+            "Anchor-only and whole-template rules remain answer-equivalent on this exact lawful grammar.",
+            "The proposed guard requests more teaching data; it proves only finite-rival elimination.",
+        ],
+    }
+    runtime = ROOT / "shared/runtime"
+    try:
+        with _local_imports(runtime, Path(__file__).resolve().parent):
+            from reviewer_support import load_selected_generator
+            gen, source, source_hash = load_selected_generator(TASK, root=ROOT)
+            assert source_hash == EXPECTED_SOURCE
+            report["source_binding"]["generator_path"] = str(source.relative_to(ROOT))
+            apply, identity, bridge = _real_evaluator(runtime)
+            report["racket"] = identity
+            cache = {}
+
+            def execute(program, grid):
+                key = (program, json.dumps(grid, separators=(",", ":")))
+                if key not in cache:
+                    cache[key] = _grid(apply(program, grid))
+                return cache[key]
+
+            def labeled(grid, origin):
+                errors = gen.self_check(grid)
+                assert not errors, errors
+                return {"origin": origin, "input": grid, "roles": roles(grid),
+                        "self_check": errors,
+                        "output": execute(canonical, grid),
+                        "rival_outputs": {name: execute(program, grid)
+                                          for name, program in programs.items()}}
+
+            try:
+                canonical_demos = [labeled(pair["input"], {"kind": "canonical_saved_demo", "index": i})
+                                   for i, pair in enumerate(canonical_row["train"])]
+                for actual, saved in zip(canonical_demos, canonical_row["train"]):
+                    assert actual["output"] == saved["output"]
+                canonical_query = labeled(canonical_row["test"][0]["input"],
+                                          {"kind": "canonical_saved_query", "index": 0})
+                assert canonical_query["output"] == canonical_row["test"][0]["output"]
+                survivors = demo_only_survivors(canonical_demos, programs, execute)
+                mismatches = [name for name in survivors
+                              if canonical_query["rival_outputs"][name] != canonical_query["output"]]
+                assert "body_median_extension" in mismatches
+                report["canonical_saved_lesson"] = {
+                    "demos": canonical_demos, "query": canonical_query,
+                    "survivors_from_demos_only": survivors,
+                    "query_disagreeing_survivors": mismatches,
+                    "existing_lesson_identifiable_errors": gen.lesson_identifiable(canonical_demos, canonical_query),
+                    "first_difference": first_difference(canonical_query["output"],
+                                                         canonical_query["rival_outputs"]["body_median_extension"]),
+                }
+                report["generated_lessons"] = []
+                all_generated = []
+                for seed in SEEDS:
+                    rows = [labeled(gen.generate(seed, index),
+                                    {"kind": "generated", "seed": seed, "sample_index": index})
+                            for index in range(INDICES_PER_SEED)]
+                    all_generated.extend(rows)
+                    demos, queries = rows[:3], rows[3:7]
+                    alive = demo_only_survivors(demos, programs, execute)
+                    report["generated_lessons"].append({
+                        "seed": seed, "samples": rows,
+                        "survivors_from_demos_only": alive,
+                        "query_disagreements": [
+                            {"sample_index": query["origin"]["sample_index"],
+                             "rivals": [name for name in alive
+                                        if query["rival_outputs"][name] != query["output"]]}
+                            for query in queries
+                        ],
+                        "existing_lesson_identifiable_errors": [
+                            gen.lesson_identifiable(demos, query) for query in queries],
+                    })
+                # Choose from the already sampled pool using demo agreement alone.
+                extra = next(row for row in all_generated
+                             if all(row["rival_outputs"][name] != row["output"]
+                                    for name in survivors))
+                remaining = demo_only_survivors(canonical_demos + [extra], programs, execute)
+                assert remaining == []
+                report["proposed_extra_demo"] = {
+                    "selection": "first already sampled input refuting all demo-only surviving rivals; query answers not consulted",
+                    "sample": extra,
+                    "survivors_before": survivors, "survivors_after": remaining,
+                    "first_difference": first_difference(extra["output"],
+                                                         extra["rival_outputs"]["body_median_extension"]),
+                }
+                report["protected_evaluations"] = len(cache)
+                report["status"] = "bounded_probe_complete_canonical_ambiguity_confirmed"
+            finally:
+                bridge.close()
+            assert sha256(source.read_bytes()) == EXPECTED_SOURCE
+    except Exception as error:
+        report["execution_errors"].append({"type": type(error).__name__, "message": str(error)})
+        report["status"] = "execution_error_not_refutation"
+        (args.out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+        raise
+    (args.out / "report.json").write_text(json.dumps(report, separators=(",", ":")) + "\n")
+    summary = {key: report[key] for key in ("schema", "task_id", "status", "source_binding", "racket", "sampling", "execution_errors", "limits")}
+    summary.update({
+        "canonical_saved_lesson_survivors": report["canonical_saved_lesson"]["survivors_from_demos_only"],
+        "canonical_saved_query_first_difference": report["canonical_saved_lesson"]["first_difference"],
+        "generated_lessons": [{"seed": row["seed"], "survivors": row["survivors_from_demos_only"],
+                               "query_disagreements": row["query_disagreements"]}
+                              for row in report["generated_lessons"]],
+        "extra_demo_origin": report["proposed_extra_demo"]["sample"]["origin"],
+        "extra_demo_roles": report["proposed_extra_demo"]["sample"]["roles"],
+        "augmented_demo_survivors": report["proposed_extra_demo"]["survivors_after"],
+        "protected_evaluations": report["protected_evaluations"],
+    })
+    (args.out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
