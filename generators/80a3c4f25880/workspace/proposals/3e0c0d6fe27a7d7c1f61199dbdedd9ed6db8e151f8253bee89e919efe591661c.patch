+"""Bounded exact-one-zero shortcut audit; production source stays unchanged.
+
+Run through the packet wrapper. Both retained labels and rival predictions come
+from the same checkout's protected Racket backend. The prior template-zero
+finding is separate and remains unresolved.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from reviewer_support import load_selected_generator
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = "5553241d87bf"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+SOURCE_PIN = "b5f6ba93ce67123cb4c48e979b323277bdd284e400329a1e4f332a24707fc23d"
+PROGRAM_PIN = "35ab14202f7221cd219d6a60b4189f6e74f7e61c0338b766c39edb3b963eff71"
+
+
+def sha(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def make_rival(program):
+    compact = " ".join(program.split())
+    old = "(for/or ((r (range r1 (+ r2 1)))) (for/or ((c (range c1 (+ c2 1)))) (zero? (at g r c))))"
+    new = "(= 1 (for*/sum ((r (range r1 (+ r2 1))) (c (range c1 (+ c2 1)))) (if (zero? (at g r c)) 1 0)))"
+    assert compact.count(old) == 1, "Canonical target selector changed"
+    return compact.replace(old, new, 1)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    gen, source, digest = load_selected_generator(TASK, root=ROOT)
+    assert digest == SOURCE_PIN, "Source changed; review this pinned probe"
+    rows = [json.loads(line) for line in
+            (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()]
+    selected = [row for row in rows if row.get("task_id") == TASK]
+    assert len({row["program_solution"] for row in selected}) == 1
+    canonical = next(row for row in selected if row.get("source") == "training")
+    program = canonical["program_solution"]
+    assert sha(program) == PROGRAM_PIN
+    rival = make_rival(program)
+    sampled, demos, query = [], [], None
+    # At most fifteen ordinary draws plus one exact profile override. These
+    # form an explicitly assembled lesson, not an assertion about native export.
+    for seed, indices in ((0, range(8)), (17, range(7))):
+        for index in indices:
+            grid = gen.generate(seed, index, difficulty="easy")
+            facts = gen._extract_facts(grid)
+            assert gen.self_check(grid) == []
+            meta = {"seed": seed, "sample_index": index, "difficulty": "easy",
+                    "overrides": {}, "profile": gen.observe_overrides(grid)["scene_profile"],
+                    "maximum_target_zeros": max(facts["dot_counts"].values()),
+                    "template_zero_count": len(facts["pattern_zeros"])}
+            sampled.append(meta)
+            pair = {"input": grid, "generation": meta}
+            if meta["maximum_target_zeros"] == 1 and not meta["template_zero_count"] and len(demos) < 3:
+                if all(grid != p["input"] for p in demos):
+                    demos.append(pair)
+            if meta["maximum_target_zeros"] > 1 and query is None:
+                query = pair
+            if len(demos) == 3 and query is not None:
+                break
+        if len(demos) == 3 and query is not None:
+            break
+    assert len(demos) == 3
+    if query is None:
+        grid = gen.generate(17, 7, difficulty="easy", scene_profile="multiple_dot_shapes")
+        assert gen.self_check(grid) == []
+        facts = gen._extract_facts(grid)
+        meta = {"seed": 17, "sample_index": 7, "difficulty": "easy",
+                "overrides": {"scene_profile": "multiple_dot_shapes"},
+                "profile": gen.observe_overrides(grid)["scene_profile"],
+                "maximum_target_zeros": max(facts["dot_counts"].values()),
+                "template_zero_count": len(facts["pattern_zeros"])}
+        sampled.append(meta)
+        query = {"input": grid, "generation": meta}
+    assert len(sampled) <= 16
+    assert all(not p["generation"]["template_zero_count"] for p in demos + [query])
+    report = {"schema": "arc-bounded-dot-count-review-v1", "task_id": TASK,
+              "status": "finding", "source_sha256": digest,
+              "rule_hash": gen.RULE_HASH, "canonical_program_sha256": sha(program),
+              "rival_program_sha256": sha(rival), "rival_program": rival,
+              "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "rival": "stamp only non-template cells containing exactly one zero",
+              "scope": "assembled lesson from ordinary generated inputs" if not query["generation"]["overrides"]
+                       else "assembled lesson with an exact-override-generated query",
+              "sampled_inputs": sampled, "prior_literal_template_zero_finding": "retained; not duplicated or resolved",
+              "limits": "One rival, seeds0/17, at most16 inputs, easy band; no prevalence estimate, battery, production repair, or approval."}
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            report["runtime_identity"] = identity
+            canonical_pairs = canonical["train"] + canonical["test"]
+            canonical_fit = []
+            for pair in canonical_pairs:
+                intended = apply(program, pair["input"])
+                alternative = apply(rival, pair["input"])
+                assert intended == pair["output"]
+                canonical_fit.append(intended == alternative)
+            assert all(canonical_fit)
+            report["canonical_rival_fit"] = canonical_fit
+            for pair in demos + [query]:
+                pair["output"] = apply(program, pair["input"])
+                pair["rival_output"] = apply(rival, pair["input"])
+                pair["self_check_errors"] = gen.self_check(pair["input"])
+            assert all(pair["output"] == pair["rival_output"] for pair in demos)
+            assert query["output"] != query["rival_output"]
+            report.update(train=demos, test=[query],
+                          rival_fits_all_demos=True, rival_changes_query=True,
+                          adding_query_as_demo_rejects_rival=True,
+                          racket_evaluations=2 * (len(canonical_pairs) + 4),
+                          differing_query_cells=[[r, c, a, b]
+                              for r, (a_row, b_row) in enumerate(zip(query["output"], query["rival_output"]))
+                              for c, (a, b) in enumerate(zip(a_row, b_row)) if a != b])
+        finally:
+            bridge.close()
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == digest
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"status": report["status"], "scope": report["scope"],
+                      "sampled_input_count": len(sampled), "demo_generation": [x["generation"] for x in demos],
+                      "query_generation": query["generation"],
+                      "query_difference_count": len(report["differing_query_cells"]),
+                      "source_sha256": digest, "protected": identity["protected"],
+                      "racket_evaluations": report["racket_evaluations"]}))
+
+
+if __name__ == "__main__":
+    main()
