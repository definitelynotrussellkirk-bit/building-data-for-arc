+def _rng(seed: int, split: str, index: int) -> random.Random:
+    raw = f"{TASK_ID}|row-column-v1|{seed}|{split}|{index}".encode()
+    return random.Random(int.from_bytes(hashlib.sha256(raw).digest()[:16], "big"))
