(rule! (let ((dummy 0))
  (define (beamcast start dr dc blockers)
    (let loop ((r (+ (first start) dr)) (c (+ (second start) dc)) (acc (list)))
      (cond
        ((not (in-bounds? r c (rows g) (cols g))) acc)
        ((member? (list r c) blockers) acc)
        (else (loop (+ r dr) (+ c dc) (append acc (list (list r c))))))))
  (let* ((corner-candidates
           (filter values
             (map (lambda (p)
                    (let ((v (at g (first p) (second p))))
                      (if (member? v (list 1 2 3 4))
                          (list (first p) (second p) v)
                          #f)))
                  (list (list 0 0)
                        (list 0 (- (cols g) 1))
                        (list (- (rows g) 1) 0)
                        (list (- (rows g) 1) (- (cols g) 1))))))
         (marker (first corner-candidates))
         (dir (cond ((= (third marker) 1) (list -1 0))
                    ((= (third marker) 2) (list 0 1))
                    ((= (third marker) 3) (list 1 0))
                    (else (list 0 -1))))
         (blockers (find-color g 5))
         (emitters
           (for*/fold ((acc (list))) ((r (in-range (rows g))) (c (in-range (cols g))))
             (let ((v (at g r c)))
               (if (and (not (= v 0))
                        (not (= v 5))
                        (not (and (= r (first marker)) (= c (second marker)))))
                   (append acc (list (list r c v)))
                   acc))))
         (completed
           (for*/fold ((out g)) ((r (in-range (rows g))) (c (in-range (cols g))))
             (let ((v (at g r c)))
               (if (and (not (= v 0))
                        (not (= v 5))
                        (not (and (= r (first marker)) (= c (second marker)))))
                   (paint-cells out (beamcast (list r c) (first dir) (second dir) blockers) v)
                   out))))
         (segments
           (map (lambda (emitter)
                  (let* ((ray (beamcast (list (first emitter) (second emitter))
                                        (first dir) (second dir) blockers))
                         (fresh (filter (lambda (p) (= (at g (first p) (second p)) 0)) ray)))
                    (list emitter ray fresh)))
                emitters))
         (best
           (foldl (lambda (segment current)
                    (if (> (length (third segment)) (second current))
                        (list (third segment) (length (third segment)))
                        current))
                  (list (list) -1)
                  segments)))
    (paint-cells completed (first best) 8))))
