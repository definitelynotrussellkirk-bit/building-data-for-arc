+            tiny[r][c] = 3
+        lesson = {"train": [{"input": tiny, "output": proto.transform(tiny, ring_stride=1)}],
+                  "test": [{"input": marked_grid()}]}
+        certificate = proto.lesson_certificate(lesson)
