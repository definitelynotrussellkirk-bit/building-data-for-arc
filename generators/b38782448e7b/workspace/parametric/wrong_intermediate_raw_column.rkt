(rule! (lambda (g)
  (let* ((hh (rows g))
         (ww (cols g))
         (bg (mode g -1))
         (result (make-hash)))
    (for* ((r (range 0 hh)) (c (range 0 ww)))
      (hash-set! result (list r c) (at g r c)))
    (for ((c (range 0 ww)))
      (when (and (!= (at g 0 c) bg)
                 (or (< hh 2) (!= (at g 0 c) (at g 1 c))))
        (let ((marker (at g 0 c)))
          (for ((r (range 1 hh)))
            (if (= (hash-ref result (list r c) 0) marker)
                (hash-set! result (list r c) bg)
                (hash-set! result (list r c) marker))))))
    (let* ((active
             (for/fold ((acc (list))) ((c (range 0 ww)))
               (if (and (!= (at g 0 c) bg)
                        (or (< hh 2) (!= (at g 0 c) (at g 1 c))))
                   (append acc (list c))
                   acc)))
           (best
             (foldl
               (lambda (c current)
                 (let* ((marker (at g 0 c))
                        (count
                          (for/fold ((n 0)) ((r (range 0 hh)))
                            (if (= (hash-ref result (list r c) bg) marker)
                                (+ n 1)
                                n))))
                   (if (> count (second current))
                       (list c count)
                       current)))
               (list -1 -1)
               active))
           (source-col (first best))
           (cue-col
             (first
               (filter (lambda (c) (= (at g (- hh 1) c) 9))
                       (range 1 (- ww 1)))))
           (destination (- cue-col 1)))
      (for ((r (range 0 hh)))
        (hash-set! result (list r destination)
                   (at g r source-col)))
      (build-grid hh ww (r c) (hash-ref result (list r c) bg))))))
