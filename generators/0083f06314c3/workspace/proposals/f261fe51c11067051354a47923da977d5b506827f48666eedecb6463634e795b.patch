+@pytest.mark.parametrize("settings", SETTINGS)
+def test_overlapping_matches_use_union_without_erasing_shared_cells(prototype, settings):
+    cells = {(0, 0), (1, 0), (2, 0), (2, 1), (3, 0), (3, 1)}
