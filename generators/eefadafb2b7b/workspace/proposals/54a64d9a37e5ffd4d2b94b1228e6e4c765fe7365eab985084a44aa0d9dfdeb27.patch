+#!/usr/bin/env python3
+"""Source-bound probe for a bbox-area shortcut in 1c781334a4f3."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+from typing import Any
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import find_root
+
+TASK_ID = "1c781334a4f3"
+EXPECTED_SOURCE_SHA256 = "3ad3c7e216047ee46226537df17b56bd4d43e3340a260d361363fe9962fe7d60"
+
+
+def _normalize(grid: list[Any]) -> list[list[int]]:
+    return [([int(value) for value in row] if isinstance(row, str) else list(row)) for row in grid]
+
+
+def _components(grid: list[list[int]]) -> list[list[tuple[int, int]]]:
+    height, width = len(grid), len(grid[0])
+    seen: set[tuple[int, int]] = set()
+    result: list[list[tuple[int, int]]] = []
+    for row in range(height):
+        for column in range(width):
+            start = (row, column)
+            if grid[row][column] == 0 or start in seen:
+                continue
+            stack = [start]
+            seen.add(start)
+            cells: list[tuple[int, int]] = []
+            while stack:
+                current = stack.pop()
+                cells.append(current)
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    neighbor = (current[0] + dr, current[1] + dc)
+                    if (
+                        0 <= neighbor[0] < height
+                        and 0 <= neighbor[1] < width
+                        and grid[neighbor[0]][neighbor[1]] != 0
+                        and neighbor not in seen
+                    ):
+                        seen.add(neighbor)
+                        stack.append(neighbor)
+            result.append(cells)
+    return result
+
+
+def _crop(grid: list[list[int]], cells: list[tuple[int, int]]):
+    r0 = min(row for row, _ in cells)
+    r1 = max(row for row, _ in cells)
+    c0 = min(column for _, column in cells)
+    c1 = max(column for _, column in cells)
+    crop = [row[c0 : c1 + 1] for row in grid[r0 : r1 + 1]]
+    return crop, (r0, c0, r1, c1)
+
+
+def bbox_area_shortcut(grid: list[list[int]]) -> list[list[int]]:
+    """Wrong rule: rank crops by bbox area, then input reading order."""
+    items = []
+    for cells in _components(grid):
+        crop, (r0, c0, r1, c1) = _crop(grid, cells)
+        items.append(((r1 - r0 + 1) * (c1 - c0 + 1), r0, c0, crop))
+    items.sort(key=lambda item: (-item[0], item[1], item[2]))
+    width = max(len(item[3][0]) for item in items)
+    output: list[list[int]] = []
+    for index, (_, _, _, crop) in enumerate(items):
+        output.extend(row + [0] * (width - len(row)) for row in crop)
+        if index + 1 < len(items):
+            output.append([0] * width)
+    return output
+
+
+def _custom_query() -> list[list[int]]:
+    grid = [[0 for _ in range(11)] for _ in range(9)]
+    # Earlier T tetromino: bbox area 6, orthogonal perimeter 10.
+    for row, column in ((1, 1), (1, 2), (1, 3), (2, 2)):
+        grid[row][column] = 2
+    # Later U pentomino: same bbox area 6, larger perimeter 12.
+    for row, column in ((5, 6), (5, 8), (6, 6), (6, 7), (6, 8)):
+        grid[row][column] = 3
+    return grid
+
+
+def _racket_grid(grid: list[list[int]]) -> str:
+    return "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+
+
+def _diff_cells(a: list[list[int]], b: list[list[int]]) -> int:
+    height = max(len(a), len(b))
+    width = max(max(map(len, a), default=0), max(map(len, b), default=0))
+    return sum(
+        (a[row][column] if row < len(a) and column < len(a[row]) else None)
+        != (b[row][column] if row < len(b) and column < len(b[row]) else None)
+        for row in range(height)
+        for column in range(width)
+    )
+
+
+def _load_generator(path: Path):
+    spec = importlib.util.spec_from_file_location("_peer_1c781334a4f3", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+
+    root = find_root(__file__)
+    source = root / "generators" / TASK_ID / "generator.py"
+    source_sha = hashlib.sha256(source.read_bytes()).hexdigest()
+    if source_sha != EXPECTED_SOURCE_SHA256:
+        raise RuntimeError(f"source drift: {source_sha}")
+
+    canonical = None
+    with (root / "shared/data/canonical/puzzles.jsonl").open(encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                canonical = row
+                break
+    if canonical is None:
+        raise RuntimeError("canonical row missing")
+    program = canonical["program_solution"]
+    pairs = canonical["train"] + ([canonical["test"]] if isinstance(canonical["test"], dict) else canonical["test"])
+
+    generator = _load_generator(source)
+    custom = _custom_query()
+    if generator.self_check(custom) != []:
+        raise RuntimeError(f"custom query rejected: {generator.self_check(custom)}")
+
+    with RacketBridge() as bridge:
+        runtime = bridge.runtime_identity
+        if runtime.get("backend") != "racket" or runtime.get("protected") is not True:
+            raise RuntimeError(f"unprotected runtime: {runtime}")
+
+        def execute(grid: list[list[int]]) -> list[list[int]]:
+            return bridge.eval_text(f"({wrap_rule(program)} {_racket_grid(grid)})")
+
+        canonical_checks = []
+        for index, pair in enumerate(pairs):
+            input_grid = _normalize(pair["input"])
+            expected = _normalize(pair["output"])
+            actual = execute(input_grid)
+            wrong = bbox_area_shortcut(input_grid)
+            canonical_checks.append(
+                {
+                    "pair_index": index,
+                    "racket_matches_stored": actual == expected,
+                    "shortcut_matches": wrong == expected,
+                }
+            )
+        if not all(row["racket_matches_stored"] and row["shortcut_matches"] for row in canonical_checks):
+            raise RuntimeError(f"shortcut did not fit canonical examples: {canonical_checks}")
+
+        correct = execute(custom)
+        wrong = bbox_area_shortcut(custom)
+        if correct == wrong:
+            raise RuntimeError("custom query did not separate the shortcut")
+
+    report = {
+        "schema": "arcpuzzles-peer-shortcut-probe-v1",
+        "task_id": TASK_ID,
+        "status": "shortcut_reproduced",
+        "source_sha256": source_sha,
+        "canonical_program_sha256": hashlib.sha256(program.encode()).hexdigest(),
+        "shortcut": "Sort motif crops by bounding-box area descending, breaking ties by input reading order.",
+        "canonical_examples_checked": len(canonical_checks),
+        "visible_pairs_fit": sum(row["shortcut_matches"] for row in canonical_checks),
+        "query_disagrees": correct != wrong,
+        "canonical_checks": canonical_checks,
+        "custom_query": custom,
+        "custom_self_check": [],
+        "correct_output": correct,
+        "shortcut_output": wrong,
+        "changed_cells_padded": _diff_cells(correct, wrong),
+        "reason": "The earlier T tetromino and later U pentomino have equal 2x3 bounding boxes, but orthogonal perimeters 10 and 12. The canonical rule must put the U first; the shortcut keeps input order.",
+        "recommendation": "Add one visible lesson with equal-area crops and unequal orthogonal perimeters, and retain this executable shortcut in lesson checks.",
+        "racket": runtime,
+        "limits": "One constructive query plus the five canonical pairs; no prevalence or production-source change claim.",
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"status": report["status"], "canonical_examples": len(canonical_checks), "changed_cells": report["changed_cells_padded"], "report": str(args.out)}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
