(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((blocks (filter (lambda (b) b)
                                  (flatmap (lambda (r)
                                             (map (lambda (c)
                                                    (and
                                                      (and
                                                        (= (at g r c) 2)
                                                        (= (at g r (+ c 1)) 2)
                                                        (= (at g (+ r 1) c) 2)
                                                        (= (at g (+ r 1) (+ c 1)) 2))
                                                      (list r c)))
                                                  (range 0 (- w 1))))
                                           (range 0 (- h 1)))))
                  (b1r (first (first blocks)))
                  (b1c (second (first blocks)))
                  (b2r (first (second blocks)))
                  (b2c (second (second blocks)))
                  (touches-block (lambda (cr cc br bc)
                                   (and
                                     (>= cr (- br 1))
                                     (<= cr (+ br 2))
                                     (>= cc (- bc 1))
                                     (<= cc (+ bc 2))
                                     (not (and
                                            (>= cr br)
                                            (<= cr (+ br 1))
                                            (>= cc bc)
                                            (<= cc (+ bc 1)))))))
                  (cyan-mask (cellmap g (r c v) (if (= v 8) 1 0)))
                  (cyan-objs (objects cyan-mask 0))
                  (bridge (find (lambda (obj)
                                  (let ((cells (obj-cells obj)))
                                    (and
                                      (find (lambda (p)
                                              (touches-block (first p)
                                                             (second p)
                                                             b1r
                                                             b1c))
                                            cells)
                                      (find (lambda (p)
                                              (touches-block (first p)
                                                             (second p)
                                                             b2r
                                                             b2c))
                                            cells))))
                                cyan-objs)))
             (list (list (if bridge 8 0)))))))