+#!/usr/bin/env python3
+"""Reproduce the semantic-coverage audit for generator 4f6f232c17bc.
+
+The probe is source-bound and cheap: it uses an independent Python oracle,
+checks every declared semantic witness/rival, and rotates each six-pair lesson
+through all possible query positions.  It does not edit or select a generator.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+
+TASK = "4f6f232c17bc"
+HOME = Path(__file__).resolve().parents[1]
+GENERATOR_PATH = HOME / "generator.py"
+BANDS = ("default", "easy", "medium", "hard")
+
+
+def _load_generator():
+    spec = importlib.util.spec_from_file_location(
+        "audited_4f6f232c17bc", GENERATOR_PATH
+    )
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def _oracle(grid):
+    """Independent implementation of the published reflection rule."""
+    height, width = len(grid), len(grid[0])
+    dividers = [
+        column
+        for column in range(width)
+        if all(grid[row][column] == 5 for row in range(height))
+    ]
+    if len(dividers) != 1:
+        raise ValueError(f"expected one full-height gray divider, got {dividers}")
+    divider = dividers[0]
+    output = [[0] * width for _ in range(height)]
+    for row, values in enumerate(grid):
+        for column, value in enumerate(values):
+            if value != 1:
+                continue
+            mirror = 2 * divider - column
+            if 0 <= mirror < width:
+                output[row][mirror] = 8
+    return output
+
+
+def _grid_key(grid):
+    raw = json.dumps(grid, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _canonical_report(gen):
+    from reviewer_support import canonical_pairs, find_root
+
+    pairs = canonical_pairs(TASK, root=find_root(__file__))
+    rejected = 0
+    mismatches = 0
+    for pair in pairs:
+        rejected += bool(gen.self_check(pair["input"]))
+        mismatches += _oracle(pair["input"]) != pair["output"]
+    return {
+        "pairs": len(pairs),
+        "validator_rejections": rejected,
+        "oracle_mismatches": mismatches,
+    }
+
+
+def run(*, samples_per_band=12, seed=20261007):
+    """Return a JSON-serializable source-bound audit report."""
+    if type(samples_per_band) is not int or samples_per_band < 6:
+        raise ValueError("samples_per_band must be an integer >= 6")
+    if type(seed) is not int:
+        raise TypeError("seed must be an integer")
+
+    gen = _load_generator()
+    failures = []
+    unique_inputs = set()
+    witness_counts = Counter({name: 0 for name in gen.SEMANTIC_WITNESSES})
+    rival_survived_demo_counts = Counter({name: 0 for name in gen.LESSON_COMPETITORS})
+    per_band = {}
+
+    for band_index, band_name in enumerate(BANDS):
+        difficulty = None if band_name == "default" else band_name
+        band_seed = seed + 100_003 * band_index
+        layout_counts = Counter()
+        validator_rejections = 0
+        oracle_mismatches = 0
+        pairs = []
+
+        for sample_index in range(samples_per_band):
+            grid = gen.generate(band_seed, sample_index, difficulty=difficulty)
+            intended = _oracle(grid)
+            errors = gen.self_check(grid, difficulty=difficulty)
+            observed = gen.observe_overrides(grid)
+            layout_counts[observed["layout_profile"]] += 1
+            unique_inputs.add(_grid_key(grid))
+            validator_rejections += bool(errors)
+            oracle_mismatches += gen._rule_output(grid) != intended
+            pairs.append({"input": grid, "output": intended})
+
+            if errors and len(failures) < 25:
+                failures.append({
+                    "kind": "validator_rejection",
+                    "band": band_name,
+                    "seed": band_seed,
+                    "sample_index": sample_index,
+                    "errors": errors,
+                })
+            if gen._rule_output(grid) != intended and len(failures) < 25:
+                failures.append({
+                    "kind": "oracle_mismatch",
+                    "band": band_name,
+                    "seed": band_seed,
+                    "sample_index": sample_index,
+                })
+
+            for witness_name, witness in gen.SEMANTIC_WITNESSES.items():
+                if not witness(deepcopy(grid)):
+                    continue
+                witness_counts[witness_name] += 1
+                rivals = gen.WITNESS_RIVALS[witness_name]
+                if not any(
+                    gen.SEMANTIC_RIVALS[name](deepcopy(grid)) != intended
+                    for name in rivals
+                ) and len(failures) < 25:
+                    failures.append({
+                        "kind": "ineffective_witness",
+                        "band": band_name,
+                        "seed": band_seed,
+                        "sample_index": sample_index,
+                        "witness": witness_name,
+                        "rivals": rivals,
+                    })
+
+        missing_layouts = sorted(set(gen.LAYOUT_PROFILES) - set(layout_counts))
+        if missing_layouts and len(failures) < 25:
+            failures.append({
+                "kind": "missing_layouts",
+                "band": band_name,
+                "missing": missing_layouts,
+            })
+
+        rotation_windows = 0
+        unidentifiable_rotations = 0
+        # Each complete six-pair block is a complete semantic schedule.
+        for start in range(0, len(pairs) - 5, 6):
+            lesson = pairs[start : start + 6]
+            for query_index in range(6):
+                demos = [pair for index, pair in enumerate(lesson) if index != query_index]
+                query = lesson[query_index]
+                rotation_windows += 1
+                reasons = gen.lesson_identifiable(demos, query)
+                for name, rival in gen.LESSON_COMPETITORS.items():
+                    if all(
+                        rival(deepcopy(pair["input"])) == pair["output"]
+                        for pair in demos
+                    ):
+                        rival_survived_demo_counts[name] += 1
+                if reasons:
+                    unidentifiable_rotations += 1
+                    if len(failures) < 25:
+                        failures.append({
+                            "kind": "unidentifiable_rotation",
+                            "band": band_name,
+                            "seed": band_seed,
+                            "block_start": start,
+                            "query_index": query_index,
+                            "reasons": reasons,
+                        })
+
+        per_band[band_name] = {
+            "seed": band_seed,
+            "generated": len(pairs),
+            "layout_counts": dict(sorted(layout_counts.items())),
+            "validator_rejections": validator_rejections,
+            "oracle_mismatches": oracle_mismatches,
+            "rotation_windows": rotation_windows,
+            "unidentifiable_rotations": unidentifiable_rotations,
+        }
+
+    for name, count in witness_counts.items():
+        if count == 0 and len(failures) < 25:
+            failures.append({"kind": "missing_semantic_witness", "witness": name})
+
+    canonical = _canonical_report(gen)
+    if canonical["validator_rejections"]:
+        failures.append({"kind": "canonical_validator_rejections", **canonical})
+    if canonical["oracle_mismatches"]:
+        failures.append({"kind": "canonical_oracle_mismatches", **canonical})
+
+    total_generated = sum(row["generated"] for row in per_band.values())
+    report = {
+        "schema": "4f6f232c17bc-distribution-audit-v1",
+        "task_id": TASK,
+        "generator_sha256": hashlib.sha256(GENERATOR_PATH.read_bytes()).hexdigest(),
+        "sample_domain": {
+            "bands": list(BANDS),
+            "base_seed": seed,
+            "samples_per_band": samples_per_band,
+            "lesson_block_size": 6,
+            "demos_per_rotation": 5,
+        },
+        "canonical": canonical,
+        "per_band": per_band,
+        "witness_counts": dict(sorted(witness_counts.items())),
+        "rival_survived_demo_counts": dict(sorted(rival_survived_demo_counts.items())),
+        "totals": {
+            "generated": total_generated,
+            "unique_inputs": len(unique_inputs),
+            "rotation_windows": sum(row["rotation_windows"] for row in per_band.values()),
+            "unidentifiable_rotations": sum(
+                row["unidentifiable_rotations"] for row in per_band.values()
+            ),
+        },
+        "failures": failures,
+    }
+    report["passed"] = (
+        not failures
+        and report["totals"]["unique_inputs"] == total_generated
+        and canonical["pairs"] > 0
+    )
+    return report
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--samples-per-band", type=int, default=12)
+    parser.add_argument("--seed", type=int, default=20261007)
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args(argv)
+
+    report = run(samples_per_band=args.samples_per_band, seed=args.seed)
+    text = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(text)
+    print(text, end="")
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
