+from __future__ import annotations
+
+from reviewer_support import canonical_pairs, find_root, load_selected_generator
+
+
+TASK_ID = "09681a814e86"
+ROOT = find_root(__file__)
+GEN, _GEN_PATH, _GEN_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _pair(seed: int, sample_index: int, band: str):
+    grid = GEN.generate(seed, sample_index, difficulty=band)
+    return {"input": grid, "output": GEN._mirror(grid)}
+
+
+def _motif_shape(grid):
+    background = grid[0][0]
+    cells = [
+        (row, col)
+        for row in range(1, len(grid) - 1)
+        for col in range(1, len(grid[0]) - 1)
+        if grid[row][col] != background
+    ]
+    rows = [row for row, _col in cells]
+    cols = [col for _row, col in cells]
+    return max(rows) - min(rows) + 1, max(cols) - min(cols) + 1
+
+
+def test_python_rule_matches_all_canonical_pairs():
+    for pair in canonical_pairs(TASK_ID, root=ROOT, labeled_only=True):
+        assert GEN._mirror(pair["input"]) == pair["output"]
+
+
+def test_three_consecutive_default_samples_refute_declared_rivals():
+    for band in ("easy", "medium", "hard"):
+        for seed in (0, 17, 91):
+            pairs = [_pair(seed, index, band) for index in range(13)]
+            for start in range(10):
+                demos = pairs[start:start + 3]
+                query = pairs[start + 3]
+                assert GEN.lesson_identifiable(demos, query) == [], (
+                    band,
+                    seed,
+                    start,
+                )
+                assert any(
+                    min(_motif_shape(pair["input"])) < 3
