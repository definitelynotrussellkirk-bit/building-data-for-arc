+from __future__ import annotations
+import hashlib, json, os
+from pathlib import Path
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK='ff76baf6c2d9'
+ROOT=Path(os.environ["ARCPUZZLES_HOME"]).resolve()
+GEN, GEN_PATH, GEN_SHA=load_selected_generator(TASK, root=ROOT)
+OUT=ROOT/'generators'/TASK/'counterexamples'/'review-171e1bc123617614-v0001'/'repaired_teaching_witness.json'
+
+def grid_literal(grid):
+    return "'(" + " ".join("("+" ".join(map(str,row))+")" for row in grid) + ")"
+
+def sha(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',',':')).encode()).hexdigest()
+
+with canonical_path(ROOT).open(encoding='utf-8') as handle:
+    row=next(json.loads(line) for line in handle if json.loads(line).get('task_id')==TASK)
+program=row['program_solution']
+wrapped=wrap_rule(program)
+bridge=RacketBridge()
+identity=bridge.runtime_identity
+if identity.get('backend')!='racket' or identity.get('protected') is not True:
+    raise RuntimeError(identity)
+try:
+    pairs=[]
+    for sample_index in (36,37,38,39):
+        grid=GEN.generate(800009,sample_index,difficulty='easy')
+        racket=bridge.eval_text(f"({wrapped} {grid_literal(grid)})")
+        python=GEN.rule_mirror(grid)
+        if racket != python:
+            raise AssertionError(f'Racket/Python mismatch at {sample_index}')
+        facts=GEN._scene_analysis(grid)[1]
+        rivals={name: rival(grid) for name,rival in GEN.SEMANTIC_RIVALS.items()}
+        pairs.append({
+            'sample_index': sample_index,
+            'input': grid,
+            'output': racket,
+            'input_sha256': sha(grid),
+            'output_sha256': sha(racket),
+            'has_mirror': facts['has_mirror'],
+            'has_preserve': facts['has_preserve'],
+            'anchor_colors': [item['anchor_color'] for item in facts['instructions']],
+            'rivals': {
+                name: {
+                    'matches_authority': output == racket,
+                    'output': output,
+                    'output_sha256': sha(output),
+                }
+                for name,output in rivals.items()
+            },
+        })
+finally:
+    bridge.close()
+
+demos=[{'input':p['input'],'output':p['output']} for p in pairs[:3]]
+query={'input':pairs[3]['input'],'output':pairs[3]['output']}
+reasons=GEN.lesson_identifiable(demos,query)
+if reasons:
+    raise AssertionError(reasons)
+for name in GEN.SEMANTIC_RIVALS:
+    if not any(not pair['rivals'][name]['matches_authority'] for pair in pairs[:3]):
+        raise AssertionError(f'{name} survives retained demos')
+
+census=[]
+for band in ('easy','medium','hard'):
+    windows=0
+    failures=[]
+    for seed in range(100):
+        generated=[]
+        for sample_index in range(13):
+            grid=GEN.generate(seed,sample_index,difficulty=band)
+            generated.append({'input':grid,'output':GEN.rule_mirror(grid)})
+        for start in range(10):
+            windows += 1
+            found=GEN.lesson_identifiable(generated[start:start+3], generated[start+3])
+            if found:
+                failures.append({'seed':seed,'start':start,'reasons':found})
+    census.append({'difficulty':band,'seeds':100,'windows':windows,'failures':failures})
+if any(item['failures'] for item in census):
+    raise AssertionError(census)
+
+report={
+    'schema':'ff76baf6c2d9-mirror-teaching-repair-v1',
+    'task_id':TASK,
+    'assignment_id':'review-171e1bc123617614',
+    'generator_path':str(GEN_PATH.relative_to(ROOT)),
+    'generator_sha256':GEN_SHA,
+    'generator_version':GEN.VERSION,
+    'canonical_rule_sha256':hashlib.sha256(program.encode()).hexdigest(),
+    'normalized_rule_hash':GEN.RULE_HASH,
+    'finding':'The preserve-every-copy rival previously fit samples 36-38 and failed only on query 39.',
+    'repair':'A three-position default schedule constructively cycles mirror_only, preserve_only, and both, while declared semantic rivals reject lessons that omit either branch.',
+    'retained_case':{
+        'seed':800009,
+        'difficulty':'easy',
+        'demonstration_indices':[36,37,38],
+        'query_index':39,
+        'lesson_identifiable':reasons,
+        'pairs':pairs,
+    },
+    'bounded_census':{
+        'scope':'100 seeds x 10 rolling three-demo windows per difficulty; Python oracle and declared rivals',
+        'universal_claim':False,
+        'results':census,
+    },
+    'racket':{k:identity[k] for k in identity if k in {
+        'schema','backend','protected','binary_sha256','prelude_sha256','bridge_sha256','boot_script_sha256','candidate_symbol_policy_sha256'}},
