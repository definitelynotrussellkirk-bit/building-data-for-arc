+
+def grid_literal(grid):
+    return "'(" + " ".join("("+" ".join(map(str,row))+")" for row in grid) + ")"
+
+def sha(value):
+    return hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+
+def motif_shape(grid):
+    bg=grid[0][0]
+    cells=[(r,c) for r in range(1,len(grid)-1) for c in range(1,len(grid[0])-1) if grid[r][c]!=bg]
+    rows=[r for r,_ in cells]; cols=[c for _,c in cells]
+    return [max(rows)-min(rows)+1,max(cols)-min(cols)+1]
+
+with canonical_path(ROOT).open(encoding='utf-8') as handle:
+    row=next(json.loads(line) for line in handle if json.loads(line).get('task_id')==TASK)
+program=row['program_solution']
+wrapped=wrap_rule(program)
+bridge=RacketBridge(); identity=bridge.runtime_identity
+if identity.get('backend')!='racket' or identity.get('protected') is not True:
+    raise RuntimeError(identity)
+try:
+    pairs=[]
+    for sample_index in (4,5,6,7):
