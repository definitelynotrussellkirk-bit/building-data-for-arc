+    'racket':{k:identity[k] for k in identity if k in {'schema','backend','protected','binary_sha256','prelude_sha256','bridge_sha256','boot_script_sha256','candidate_symbol_policy_sha256'}},
+}
+OUT.parent.mkdir(parents=True,exist_ok=True)
+OUT.write_text(json.dumps(report,indent=2,sort_keys=True)+'\n',encoding='utf-8')
+manifest={'schema':'arcpuzzles-audit-assets-v1','task_id':TASK,'assignment_id':'review-171e1bc123617614','files':[{'path':str(OUT.relative_to(ROOT)),'bytes':OUT.stat().st_size,'sha256':hashlib.sha256(OUT.read_bytes()).hexdigest()}]}
+mp=OUT.parent/'audit_assets.json';mp.write_text(json.dumps(manifest,indent=2,sort_keys=True)+'\n',encoding='utf-8')
