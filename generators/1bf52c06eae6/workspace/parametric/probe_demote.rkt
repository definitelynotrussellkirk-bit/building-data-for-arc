(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g))
                (probe (first (find-color g 9)))
                (pr (first probe))
                (pc (second probe))
                (colors (filter (lambda (color) (!= color 9))
                                (grid-colors g 0)))
                (boxes (sort (map (lambda (color)
                                    (let* ((cells (find-color g color))
                                           (bb (bbox-of-cells cells))
                                           (r1 (first bb))
                                           (c1 (second bb))
                                           (r2 (third bb))
                                           (c2 (fourth bb))
                                           (side (max (+ 1 (- r2 r1))
                                                      (+ 1 (- c2 c1))))
                                           (nr2 (min (- h 1) (+ r1 (- side 1))))
                                           (nc2 (min (- w 1) (+ c1 (- side 1)))))
                                      (list (* side side) color r1 c1 nr2 nc2)))
                                  colors)
                             <
                             #:key
                             first))
                (selected (find-first (lambda (b)
                                        (and (>= pr (third b))
                                             (<= pr (fifth b))
                                             (>= pc (fourth b))
                                             (<= pc (sixth b))))
                                      boxes))
                (ordered (append
                           (filter (lambda (b) (!= (second b) (second selected))) boxes)
                           (list selected))))
           (cellmap g
                    (r c v)
                    (let ((hit (find-first (lambda (b)
                                             (and (>= r (third b))
                                                  (<= r (fifth b))
                                                  (>= c (fourth b))
                                                  (<= c (sixth b))))
                                           ordered)))
                      (if hit (second hit) 0))))))
