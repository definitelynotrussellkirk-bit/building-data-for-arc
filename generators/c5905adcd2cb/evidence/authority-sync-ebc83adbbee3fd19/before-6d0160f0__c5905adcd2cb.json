    "negative_constraints": [
      "do not infer the destination from the source macro-cell's global position",
      "do not exclude the yellow marker from the copied source pattern",
      "do not preserve colored distractors outside the source or destination",
      "do not preserve the source at its original location unless source and destination coincide",
      "do not copy zeros or gray-5 cells from the source rectangle as source content",
      "do not clear any gray-5 lattice or other gray-5 cell before writing the source"
    ],
    "puzzle_concepts": [
      "four-period macro-cell lattice",
      "quotient source selection",
      "local-position destination encoding",
      "filtered 3x3 source pattern",
      "global clear preserving gray",
      "same-offset pattern copy"
    ],
    "semantic_primitives": [
      "find-color",
      "quotient",
