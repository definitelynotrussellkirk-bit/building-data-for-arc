    "raw_code": "(rule! (lambda (g)\n  (let* ((four (first (find-color g 4)))\n         (fr (first four)) (fc (second four))\n         (src-r1 (* (quotient fr 4) 4)) (src-c1 (* (quotient fc 4) 4))\n         (dst-r1 (* (- fr src-r1) 4)) (dst-c1 (* (- fc src-c1) 4))\n         (src-cells (filter (lambda (rc)\n                              (let ((v (at g (first rc) (second rc))))\n                                (and (!= v 0) (!= v 5))))\n                            (positions-in-rect src-r1 src-c1 (+ src-r1 2) (+ src-c1 2))))\n         (out-g (cellmap g (r c v) (if (= v 5) 5 0))))\n    (reduce (lambda (gg p)\n              (let* ((r (first p)) (c (second p))\n                     (nr (+ dst-r1 (- r src-r1)))\n                     (nc (+ dst-c1 (- c src-c1))))\n                (set-cell gg nr nc (at g r c))))\n            out-g src-cells))))",
