+def _row_first_cells(start: Cell, goal: Cell) -> list[Cell]:
+    """A common wrong rule: ignore walls, move vertically, then horizontally."""
+    r, c = start
+    cells = [(r, c)]
+    if goal[0] != r:
+        step = 1 if goal[0] > r else -1
+        while r != goal[0]:
+            r += step
+            cells.append((r, c))
+    if goal[1] != c:
+        step = 1 if goal[1] > c else -1
+        while c != goal[1]:
+            c += step
+            cells.append((r, c))
+    return cells
