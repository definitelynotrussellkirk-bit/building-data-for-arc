+#!/usr/bin/env python3
+"""Independent reproducible probe for generator 6a289c5b0897.
+
+The probe deliberately does not use ``generator.rule_mirror`` as its oracle.
+It reimplements the selected Racket BFS semantics, checks all canonical pairs,
+verifies declared canonical shortcuts, samples the actual generator, and tests
+every query rotation over all eight starts of the deterministic shape schedule.
+
+Typical packet-root invocation:
+
+    python3 run_with_racket.py python3 \
+      generators/6a289c5b0897/workspace/reference_probe.py \
+      --seeds 10 --samples-per-band 16 \
+      --out ../checks/reference-probe.json
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import sys
+from collections import Counter, deque
+from pathlib import Path
+from typing import Callable, Iterable
+
+HERE = Path(__file__).resolve()
+
+# Support both the source packet and the portable task-test runtime.
+for parent in HERE.parents:
+    source_runtime = parent / "shared" / "runtime"
+    if (source_runtime / "reviewer_support.py").is_file():
+        sys.path.insert(0, str(source_runtime))
+        break
+    if (parent / "reviewer_support.py").is_file():
+        sys.path.insert(0, str(parent))
+        break
+
+from reviewer_support import canonical_pairs, find_root  # noqa: E402
+
+TASK_ID = "6a289c5b0897"
+AUTHORITY_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BANDS = ("easy", "medium", "hard")
+SCHEDULE_PERIOD = 8
+Cell = tuple[int, int]
+Grid = list[list[int]]
+
+
+def _load_generator():
+    path = HERE.parents[1] / "generator.py"
+    spec = importlib.util.spec_from_file_location(f"probe_generator_{TASK_ID}", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import generator from {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module, path
+
+
+def _neighbors(cell: Cell, h: int, w: int, order: Iterable[Cell]):
+    r, c = cell
+    for dr, dc in order:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _authority_parts(grid: Grid) -> tuple[int, Cell, Cell, set[int]]:
+    """Follow the Racket endpoint selection literally enough for this domain."""
+    values = sorted({value for row in grid for value in row if value != 0})
+    candidates = [
+        color
+        for color in values
+        if sum(value == color for row in grid for value in row) == 2
+    ]
+    if not candidates:
+        raise ValueError("no nonzero color occurs exactly twice")
+    color = min(candidates)
+    points = [
+        (r, c)
+        for r, row in enumerate(grid)
+        for c, value in enumerate(row)
+        if value == color
+    ]
+    return color, points[0], points[1], {0, color}
+
+
+def _ordered_path(
+    grid: Grid,
+    start: Cell,
+    goal: Cell,
+    allowed: set[int],
+    order: Iterable[Cell] = AUTHORITY_DIRS,
+) -> list[Cell]:
+    h, w = len(grid), len(grid[0])
+    parent: dict[Cell, Cell | None] = {start: None}
+    queue = deque([start])
+    while queue:
+        cell = queue.popleft()
+        if cell == goal:
+            break
+        for nxt in _neighbors(cell, h, w, order):
+            if nxt in parent or grid[nxt[0]][nxt[1]] not in allowed:
+                continue
+            parent[nxt] = cell
+            queue.append(nxt)
+    if goal not in parent:
+        return []
+    path: list[Cell] = []
+    current: Cell | None = goal
+    while current is not None:
+        path.append(current)
+        current = parent[current]
+    return list(reversed(path))
+
+
+def independent_oracle(grid: Grid) -> Grid:
+    color, start, goal, allowed = _authority_parts(grid)
+    path = _ordered_path(grid, start, goal, allowed)
+    if not path:
+        raise ValueError("selected endpoints are disconnected")
+    out = [[0 for _ in row] for row in grid]
+    for r, c in path:
+        out[r][c] = color
+    return out
+
+
+def _distances(grid: Grid, start: Cell, allowed: set[int]) -> dict[Cell, int]:
+    h, w = len(grid), len(grid[0])
+    dist = {start: 0}
+    queue = deque([start])
+    while queue:
+        cell = queue.popleft()
+        for nxt in _neighbors(cell, h, w, AUTHORITY_DIRS):
+            if nxt in dist or grid[nxt[0]][nxt[1]] not in allowed:
+                continue
+            dist[nxt] = dist[cell] + 1
+            queue.append(nxt)
+    return dist
+
+
+def shortest_path_count(grid: Grid) -> int:
+    _color, start, goal, allowed = _authority_parts(grid)
+    forward = _distances(grid, start, allowed)
+    if goal not in forward:
+        return 0
+    reverse = _distances(grid, goal, allowed)
+    total = forward[goal]
+    shortest = {
+        cell
+        for cell, distance in forward.items()
+        if cell in reverse and distance + reverse[cell] == total
+    }
+    ways: dict[Cell, int] = {start: 1}
+    h, w = len(grid), len(grid[0])
+    for distance in range(total):
+        for cell in sorted(shortest):
+            if forward[cell] != distance:
+                continue
+            for nxt in _neighbors(cell, h, w, AUTHORITY_DIRS):
+                if nxt in shortest and forward.get(nxt) == distance + 1:
+                    ways[nxt] = min(2, ways.get(nxt, 0) + ways.get(cell, 0))
+    return ways.get(goal, 0)
+
+
+def _grid_hash(grid: Grid) -> str:
+    payload = json.dumps(grid, separators=(",", ":"), sort_keys=False).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _source_hash(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _safe_rule_call(rule: Callable[[Grid], Grid], grid: Grid):
+    try:
+        return rule([row[:] for row in grid]), None
+    except Exception as exc:  # report exact declaration failures, never hide them
+        return None, f"{type(exc).__name__}: {exc}"
+
+
+def run_probe(*, seeds: int, samples_per_band: int) -> dict[str, object]:
+    gen, generator_path = _load_generator()
+    root = find_root(HERE)
+    pairs = canonical_pairs(TASK_ID, root=root)
+    failures: list[dict[str, object]] = []
+
+    canonical_matches = 0
+    for index, pair in enumerate(pairs):
+        try:
+            predicted = independent_oracle(pair["input"])
+        except Exception as exc:
+            failures.append({"kind": "canonical_oracle_error", "index": index, "error": str(exc)})
+            continue
+        if predicted == pair["output"]:
+            canonical_matches += 1
+        else:
+            failures.append({"kind": "canonical_oracle_mismatch", "index": index})
+
+    shortcut_fit: dict[str, int] = {}
+    shortcut_errors: dict[str, list[str]] = {}
+    for name, rival in sorted(getattr(gen, "CANONICAL_SHORTCUTS", {}).items()):
+        fit = 0
+        errors: list[str] = []
+        for index, pair in enumerate(pairs):
+            predicted, error = _safe_rule_call(rival, pair["input"])
+            if error:
+                errors.append(f"pair {index}: {error}")
+            elif predicted == pair["output"]:
+                fit += 1
+        shortcut_fit[name] = fit
+        if errors:
+            shortcut_errors[name] = errors
+        if fit != len(pairs):
+            failures.append({
+                "kind": "declared_shortcut_not_canonical_fitting",
+                "name": name,
+                "fit": fit,
+                "pairs": len(pairs),
+            })
+
+    profiles: Counter[str] = Counter()
+    shapes: Counter[str] = Counter()
+    colors: Counter[str] = Counter()
+    multiplicities: Counter[str] = Counter()
+    rival_disagreements: Counter[str] = Counter()
+    generated_hashes: set[str] = set()
+    generated = 0
+    competitors = dict(getattr(gen, "LESSON_COMPETITORS", {}))
+
+    for band in BANDS:
+        for seed in range(seeds):
+            for sample_index in range(samples_per_band):
+                generated += 1
+                try:
+                    grid = gen.generate(seed, sample_index, difficulty=band)
+                    replay = gen.generate(seed, sample_index, difficulty=band)
+                except Exception as exc:
+                    failures.append({
+                        "kind": "generation_error",
+                        "band": band,
+                        "seed": seed,
+                        "sample_index": sample_index,
+                        "error": f"{type(exc).__name__}: {exc}",
+                    })
+                    continue
+                if replay != grid:
+                    failures.append({
+                        "kind": "nondeterministic_replay",
+                        "band": band,
+                        "seed": seed,
+                        "sample_index": sample_index,
+                    })
+                check_errors = list(gen.self_check(grid))
+                if check_errors:
+                    failures.append({
+                        "kind": "self_check_rejection",
+                        "band": band,
+                        "seed": seed,
+                        "sample_index": sample_index,
+                        "errors": check_errors,
+                    })
+                    continue
+                try:
+                    truth = independent_oracle(grid)
+                except Exception as exc:
+                    failures.append({
+                        "kind": "oracle_error",
+                        "band": band,
+                        "seed": seed,
+                        "sample_index": sample_index,
+                        "error": str(exc),
+                    })
+                    continue
+                if gen.rule_mirror(grid) != truth:
+                    failures.append({
+                        "kind": "python_mirror_mismatch",
+                        "band": band,
+                        "seed": seed,
+                        "sample_index": sample_index,
+                    })
+
+                profile = str(gen.schedule_profile(seed, sample_index, band))
+                count = shortest_path_count(grid)
+                profiles[profile] += 1
+                multiplicities["tied" if count >= 2 else "unique"] += 1
+                if (profile == "tied") != (count >= 2):
+                    failures.append({
+                        "kind": "schedule_profile_mismatch",
+                        "band": band,
+                        "seed": seed,
+                        "sample_index": sample_index,
+                        "profile": profile,
+                        "shortest_path_count": count,
+                    })
+                shapes[f"{len(grid)}x{len(grid[0])}"] += 1
+                color, _start, _goal, _allowed = _authority_parts(grid)
+                colors[str(color)] += 1
+                generated_hashes.add(_grid_hash(grid))
+                for name, rival in sorted(competitors.items()):
+                    prediction, error = _safe_rule_call(rival, grid)
+                    if error:
+                        failures.append({
+                            "kind": "rival_error",
+                            "name": name,
+                            "band": band,
+                            "seed": seed,
+                            "sample_index": sample_index,
+                            "error": error,
+                        })
+                    elif prediction != truth:
+                        rival_disagreements[name] += 1
+
+    for name in sorted(competitors):
+        if rival_disagreements[name] == 0:
+            failures.append({"kind": "rival_never_refuted", "name": name})
+
+    # Exhaust every schedule start and every held-out query position.  Cache the
+    # period plus three look-ahead pairs once per seed/band.
+    total_rotations = 0
+    ambiguous_rotations = 0
+    hook_warning_rotations = 0
+    direct_ambiguity_examples: list[dict[str, object]] = []
+    lesson_hashes: set[str] = set()
+    for band in BANDS:
+        for seed in range(seeds):
+            pairs_by_index: dict[int, dict[str, Grid]] = {}
+            for sample_index in range(SCHEDULE_PERIOD + 3):
+                grid = gen.generate(seed, sample_index, difficulty=band)
+                pairs_by_index[sample_index] = {
+                    "input": grid,
+                    "output": independent_oracle(grid),
+                }
+            for start in range(SCHEDULE_PERIOD):
+                episode = [pairs_by_index[index] for index in range(start, start + 4)]
+                lesson_hashes.update(_grid_hash(pair["input"]) for pair in episode)
+                for query_index in range(4):
+                    total_rotations += 1
+                    query = episode[query_index]
+                    demos = episode[:query_index] + episode[query_index + 1:]
+                    query_truth = query["output"]
+                    surviving = []
+                    for name, rival in sorted(competitors.items()):
+                        if all(rival(pair["input"]) == pair["output"] for pair in demos):
+                            if rival(query["input"]) != query_truth:
+                                surviving.append(name)
+                    hook_reasons = list(gen.lesson_identifiable(demos, query))
+                    if surviving:
+                        ambiguous_rotations += 1
+                        if len(direct_ambiguity_examples) < 8:
+                            direct_ambiguity_examples.append({
+                                "band": band,
+                                "seed": seed,
+                                "start": start,
+                                "query_index": query_index,
+                                "surviving": surviving,
+                            })
+                    if hook_reasons:
+                        hook_warning_rotations += 1
+                    if bool(surviving) != bool(hook_reasons):
+                        failures.append({
+                            "kind": "lesson_hook_disagrees_with_direct_scoring",
+                            "band": band,
+                            "seed": seed,
+                            "start": start,
+                            "query_index": query_index,
+                            "surviving": surviving,
+                            "hook_reasons": hook_reasons,
+                        })
+
+    if ambiguous_rotations:
+        failures.append({
+            "kind": "ambiguous_rotations",
+            "count": ambiguous_rotations,
+            "examples": direct_ambiguity_examples,
+        })
+
+    result = {
+        "schema": "6a289c5b0897-reference-probe-v1",
+        "task_id": TASK_ID,
+        "generator_sha256": _source_hash(generator_path),
+        "parameters": {
+            "seeds": seeds,
+            "samples_per_band": samples_per_band,
+            "bands": list(BANDS),
+            "schedule_period": SCHEDULE_PERIOD,
+            "lesson_pairs": 4,
+            "demo_pairs": 3,
+        },
+        "canonical": {
+            "pairs": len(pairs),
+            "oracle_matches": canonical_matches,
+            "shortcut_fit": dict(sorted(shortcut_fit.items())),
+            "shortcut_errors": shortcut_errors,
+        },
+        "sampled": {
+            "generated": generated,
+            "unique_inputs": len(generated_hashes),
+            "profiles": dict(sorted(profiles.items())),
+            "actual_multiplicity": dict(sorted(multiplicities.items())),
+            "shapes": dict(sorted(shapes.items())),
+            "colors": dict(sorted(colors.items())),
+            "rival_disagreements": dict(sorted(rival_disagreements.items())),
+            "failures": failures,
+        },
+        "cyclic_lessons": {
+            "starts_per_seed_band": SCHEDULE_PERIOD,
+            "rotations": total_rotations,
+            "unique_inputs": len(lesson_hashes),
+            "ambiguous_rotations": ambiguous_rotations,
+            "hook_warning_rotations": hook_warning_rotations,
+            "examples": direct_ambiguity_examples,
+        },
+    }
+    result["status"] = "pass" if not failures else "fail"
+    return result
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seeds", type=int, default=10)
+    parser.add_argument("--samples-per-band", type=int, default=16)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.seeds < 1 or args.samples_per_band < 1:
+        parser.error("--seeds and --samples-per-band must be positive")
+
+    result = run_probe(seeds=args.seeds, samples_per_band=args.samples_per_band)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(
+        f"{result['status'].upper()} {TASK_ID}: "
+        f"canonical={result['canonical']['oracle_matches']}/{result['canonical']['pairs']} "
+        f"generated={result['sampled']['generated']} "
+        f"rotations={result['cyclic_lessons']['rotations']} "
+        f"ambiguous={result['cyclic_lessons']['ambiguous_rotations']}"
+    )
+    return 0 if result["status"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
