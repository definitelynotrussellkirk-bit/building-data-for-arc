@@ -0,0 +1,49 @@
+"""Learnability regression tests for c74cf5eb1b80."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+
+
+def load_generator():
+    path = HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location("tested_c74cf5eb1b80", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def source_distances(grid):
+    height, width = len(grid), len(grid[0])
+    dividers = [c for c in range(width) if all(grid[r][c] == 9 for r in range(height))]
+    assert len(dividers) == 1
+    divider = dividers[0]
+    return {
+        divider - c
+        for row in grid
+        for c, value in enumerate(row)
+        if c < divider and value not in (0, 9) and 2 * divider - c < width
+    }
+
+
+def test_seed_7_three_demo_lesson_rejects_near_only_shortcut():
+    generator = load_generator()
+    demonstrations = [generator.generate(7, i, difficulty="medium") for i in range(3)]
+    assert any(any(distance >= 3 for distance in source_distances(grid))
+               for grid in demonstrations)
+
+
+@pytest.mark.parametrize("difficulty", ["easy", "medium", "hard"])
+def test_normal_generation_always_contains_near_and_far_teaching_sources(difficulty):
+    generator = load_generator()
+    for seed in range(32):
+        for sample_index in range(3):
+            grid = generator.generate(seed, sample_index, difficulty=difficulty)
+            distances = source_distances(grid)
+            assert 1 in distances
+            assert any(distance >= 3 for distance in distances)
+            assert generator.self_check(grid, difficulty=difficulty) == []
