+"""Reproduce the retained length-six teaching gap with protected Racket labels.
+
+This is a bounded optional-peer audit, not a generator repair or acceptance.
+Run through the packet's review.py run wrapper; output remains private evidence.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+
+
+TASK_ID = "0c1bec3fcbdc"
+HOME = Path(__file__).resolve().parents[1]
+REPO = HOME.parents[1]
+
+
+def digest(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    generator_path = HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location("audited_vertical_run_generator", generator_path)
+    gen = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(gen)
+    task = next(json.loads(line) for line in (REPO / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()
+                if json.loads(line).get("task_id") == TASK_ID)
+    canonical = task["program_solution"]
+    original_guard = "(>= (+ 1 (- r1 r0)) 3)"
+    assert canonical.count(original_guard) == 1
+    rival = canonical.replace(original_guard, "(and (>= (+ 1 (- r1 r0)) 3) (<= (+ 1 (- r1 r0)) 5))")
+    canonical_pairs = list(task["train"]) + list(task["test"])
+    generated = [gen.generate(73, index, difficulty="medium") for index in range(8)]
+    query = [[0] * 10 for _ in range(8)]
+    for row in range(6):
+        query[row][1] = 6
+    for row in range(4, 7):
+        query[row][4] = 6
+    for row in (1, 2):
+        query[row][8] = 6
+    grids = [pair["input"] for pair in canonical_pairs] + generated + [query]
+    results = []
+    wrapped = {"canonical": wrap_rule(canonical), "bounded_length_3_through_5": wrap_rule(rival)}
+    with RacketBridge() as bridge:
+        runtime = bridge.runtime_identity
+        assert runtime["backend"] == "racket" and runtime["protected"] is True
+        for grid in grids:
+            literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+            labels = {name: bridge.eval_text(f"({program} {literal})") for name, program in wrapped.items()}
+            for label in labels.values():
+                assert len(label) == len(grid)
+                assert all(type(row) is list and len(row) == len(grid[0])
+                           and all(type(cell) is int and 0 <= cell <= 9 for cell in row) for row in label)
+            results.append(labels)
+    canonical_results = results[:len(canonical_pairs)]
+    generated_results = results[len(canonical_pairs):-1]
+    for pair, labels in zip(canonical_pairs, canonical_results):
+        assert labels["canonical"] == pair["output"] == labels["bounded_length_3_through_5"]
+    for grid, labels in zip(generated, generated_results):
+        assert gen.self_check(grid) == []
+        assert labels["canonical"] == gen.rule_mirror(grid) == labels["bounded_length_3_through_5"]
+    demos = [{"input": grid, "output": labels["canonical"]}
+             for grid, labels in zip(generated[:4], generated_results[:4])]
+    nominal_queries = [{"input": grid, "output": labels["canonical"]}
+                       for grid, labels in zip(generated[4:], generated_results[4:])]
+    witness_labels = results[-1]
+    assert gen.self_check(query) == []
+    assert gen.lesson_identifiable(demos, {"input": query}) == []
+    assert all(gen.lesson_identifiable(demos, pair) == [] for pair in nominal_queries)
+    differences = [[r, c] for r in range(8) for c in range(10)
+                   if witness_labels["canonical"][r][c] != witness_labels["bounded_length_3_through_5"][r][c]]
+    assert differences == [[0, 1], [5, 1]]
+    declared_refuted = {name: any(fn(pair["input"]) != pair["output"] for pair in demos)
+                        for name, fn in gen.SEMANTIC_RIVALS.items()}
+    assert all(declared_refuted.values())
+    report = {
+        "schema": "arcpuzzles-bounded-peer-audit-v1",
+        "task_id": TASK_ID,
+        "finding": "confirmed_existing_length_six_teaching_support_gap",
+        "status": "findings_only_generator_unchanged",
+        "source_binding": {
+            "generator_sha256": hashlib.sha256(generator_path.read_bytes()).hexdigest(),
+            "rule_hash": gen.RULE_HASH,
+            "canonical_program_sha256": digest(canonical),
+            "audit_script_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        },
+        "racket": runtime,
+        "programs": {"canonical": canonical, "bounded_length_3_through_5": rival},
+        "counts": {"canonical_pairs": len(canonical_pairs), "generated_inputs": len(generated),
+                   "demonstrations": len(demos), "nominal_queries": len(nominal_queries),
+                   "hand_authored_accepted_queries": 1, "protected_racket_executions": 2 * len(grids),
+                   "declared_rivals_refuted_by_demos": sum(declared_refuted.values())},
+        "generation": {"seed": 73, "sample_indices": list(range(8)), "difficulty": "medium", "overrides": {},
+                       "scene_profiles": [gen.observe_overrides(grid)["scene_profile"] for grid in generated],
+                       "qualifying_lengths": sorted({run["length"] for grid in generated
+                                                      for run in gen._vertical_runs(grid) if run["color"] == 6 and run["length"] >= 3})},
+        "demos": demos,
+        "nominal_queries": nominal_queries,
+        "declared_rivals_refuted": declared_refuted,
+        "bounded_rival_fits_all_demos": True,
+        "bounded_rival_agrees_all_nominal_queries": True,
+        "witness": {"origin": "hand_authored_current_validator_domain_not_emitted_by_generator",
+                    "input": query, "output": witness_labels["canonical"],
+                    "rival_output": witness_labels["bounded_length_3_through_5"],
+                    "different_cells": differences, "self_check": gen.self_check(query),
+                    "strict_canonical_like": gen.strict_canonical_like(query),
+                    "observed_overrides": gen.observe_overrides(query),
+                    "lesson_identifiable": gen.lesson_identifiable(demos, {"input": query})},
+        "limitations": ["One seed and eight generated inputs; no full battery or corpus claim.",
+                        "The bounded rival agrees on the sampled emitted queries; the failure is on an admitted hand-authored query.",
+                        "Six existing rivals were checked using their Python implementations against Racket-labeled demos.",
+                        "The retained nonlinear-component and query-rotation findings were not re-executed.",
+                        "No generator repair, canonical approval, parametric work, or training admission is claimed."],
+        "recommendation": "Keep existing audit unresolved; include length-six ordinary targets and add the bounded-length rival to the teaching contract.",
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"finding": report["finding"], "source_binding": report["source_binding"],
+                      "counts": report["counts"], "different_cells": differences, "out": str(args.out)}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
