+"""Bounded audit of global-bottom versus per-column-bottom beam starts.
+
+Python finds one ordinary four-demo lesson; protected Racket independently
+executes its five labels and the rival labels. This does not change approval.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.catalog import sha256
+from arcpuzzles.parametric_promotion import _public, _raw
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+
+
+TASK_ID = "18a70820b25b"
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def audit(output):
+    output = Path(output)
+    if output.exists() or output.is_symlink():
+        raise FileExistsError(output)
+    catalog = Catalog(ROOT)
+    selected = catalog.describe(TASK_ID)
+    authority = selected.get("rule_task_id", TASK_ID)
+    sources = {v["program_solution"] for v in catalog._variants()[authority]}
+    if len(sources) != 1:
+        raise ValueError("A unique selected reference is required")
+    canonical = next(iter(sources))
+    needle = "((r (+ bottom 1)) (gg out))"
+    if canonical.count(needle) != 1:
+        raise ValueError("Selected reference changed; review the rival mutation")
+    rival = canonical.replace(needle, "((r (+ (apply max (map first shape-cells)) 1)) (gg out))")
+    generator_path = ROOT / selected["generator"]
+    spec = importlib.util.spec_from_file_location("_peer_beam_generator", generator_path)
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+
+    def global_bottom_mirror(grid):
+        analysis = generator._analyze(grid)
+        result = [row[:] for row in grid]
+        for column in analysis["trigger_columns"]:
+            for row in range(analysis["source_r1"] + 1, analysis["height"]):
+                result[row][column] = analysis["marker_color"]
+        return result
+
+    searched = 0
+    found = None
+    for band in ("easy", "medium", "hard"):
+        for seed in range(48):
+            grids = [generator.generate(seed, index, difficulty=band) for index in range(5)]
+            searched += 1
+            matches = [global_bottom_mirror(grid) == generator.rule_mirror(grid) for grid in grids]
+            if all(matches[:4]) and not matches[4]:
+                found = (band, seed, grids)
+                break
+        if found is not None:
+            break
+    if found is None:
+        raise ValueError("No witness in the declared finite search; do not claim a counterexample")
+    band, seed, grids = found
+    if any(generator.self_check(grid, difficulty=band) for grid in grids):
+        raise ValueError("Candidate input is outside the current generator grammar")
+    pairs = []
+    rival_outputs = []
+    with _local_imports(ROOT / "shared/runtime", generator_path.parent):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            for grid in grids:
+                correct = _grid(apply(canonical, grid))
+                alternative = _grid(apply(rival, grid))
+                if correct != generator.rule_mirror(grid) or alternative != global_bottom_mirror(grid):
+                    raise ValueError("Python candidate reasoning differs from independent Racket execution")
+                pairs.append({"input": grid, "output": correct})
+                rival_outputs.append(alternative)
+        finally:
+            bridge.close()
+    if not all(pair["output"] == answer for pair, answer in zip(pairs[:4], rival_outputs[:4])):
+        raise ValueError("Rival does not fit every visible demonstration")
+    if pairs[4]["output"] == rival_outputs[4]:
+        raise ValueError("Rival does not change the query answer")
+    episode = {"train": pairs[:4], "test": pairs[4:]}
+    native_checker = generator.lesson_identifiable(episode["train"], episode["test"][0])
+    differences = [
+        {"row": r, "column": c, "canonical": correct, "rival": rival_outputs[4][r][c]}
+        for r, row in enumerate(pairs[4]["output"]) for c, correct in enumerate(row)
+        if correct != rival_outputs[4][r][c]
+    ]
+    binding = {
+        "task_id": TASK_ID, "rule_task_id": authority,
+        "generator": selected["generator"], "generator_sha256": selected["generator_sha256"],
+        "rule_hash": selected["rule_hash"],
+        "canonical_program_sha256": hashlib.sha256(canonical.encode()).hexdigest(),
+        "rival_program_sha256": hashlib.sha256(rival.encode()).hexdigest(),
+        "audit_tool": Path(__file__).resolve().relative_to(ROOT).as_posix(),
+        "audit_tool_sha256": sha256(Path(__file__)),
+    }
+    witness = {
+        "task_id": TASK_ID, "source_binding": binding,
+        "rival": "start_beams_below_global_source_bottom",
+        "meaning": "Select columns exactly as the reference does, but begin every beam below the overall source bounding box instead of below that column's last source cell.",
+        "request": {"seed": seed, "difficulty": band, "sample_indices": [0, 1, 2, 3, 4], "demos": 4, "queries": 1},
+        "program": canonical, "counterfactual_program": rival, "racket": identity,
+        "episode": episode, "rival_outputs": {"train": rival_outputs[:4], "test": rival_outputs[4:]},
+        "demonstrations_fit": [True] * 4, "query_disagreements": differences,
+        "current_lesson_identifiable": native_checker,
+        "profiles": [{"shape_id": generator._analyze(grid)["shape_id"],
+                      "source_bottom": generator._analyze(grid)["source_r1"],
+                      "selected_columns": generator._analyze(grid)["trigger_columns"],
+                      "column_bottoms": generator._analyze(grid)["bottoms"]} for grid in grids],
+        "training_admitted": False,
+        "limits": "One ordinary generated lesson proves an ambiguity for this finite rival. No claim about all lessons, all rivals, production safety, or learning benefit.",
+    }
+    payload = _raw(_public(episode))
+    identifier = hashlib.sha256(payload).hexdigest()
+    output.mkdir(parents=True, exist_ok=False)
+    (output / "witness.json").write_bytes(_raw(witness))
+    (output / f"challenge-{identifier}.json").write_bytes(payload)
+    report = {
+        "status": "counterexample_found", "task_id": TASK_ID, "source_binding": binding,
+        "python_discovery_episodes": searched, "python_discovery_inputs": searched * 5,
+        "retained_demonstrations": 4, "retained_queries": 1, "racket_evaluations": 10,
+        "request": witness["request"], "query_disagreements": differences,
+        "current_lesson_identifiable": native_checker,
+        "suggested_followup": "Add the global-bottom shortcut to the finite rival family and guarantee at least one demonstration whose selected source column ends above the source's global bottom; retain the demonstrated episode as a regression.",
+        "production_generator_changed": False, "training_admitted": False,
+        "files": [{"path": p.name, "sha256": sha256(p)} for p in sorted(output.iterdir())],
+        "limits": witness["limits"],
+    }
+    (output / "report.json").write_bytes(_raw(report))
+    if sha256(generator_path) != binding["generator_sha256"]:
+        raise ValueError("Generator changed during audit")
+    return report
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    print(json.dumps(audit(args.out), indent=2))
