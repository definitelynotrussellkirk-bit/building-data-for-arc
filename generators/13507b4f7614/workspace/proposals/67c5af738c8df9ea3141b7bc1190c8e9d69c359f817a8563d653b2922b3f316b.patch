+def test_canonical_setting_preserves_exact_ledger_program():
+    native = load_native()
+    rows = [json.loads(line) for line in (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()]
+    expected = next(row["program_solution"] for row in rows if row["task_id"] == HOME.name)
+    assert native.canonical_source() == expected
+    assert native.program(SETTINGS[0]) == expected
+
