+import sys
+import types
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1]
+ROOT = HOME.parents[1]
+NATIVE = HOME / "workspace/parametric/native.py"
+SETTINGS = ({"selection_rule": "all_odd"}, {"selection_rule": "cross_area_cascade"})
+
+
+def load_native():
+    assert NATIVE.is_file(), "native parametric implementation is missing"
+    spec = importlib.util.spec_from_file_location("rectangle_cross_native_test", NATIVE)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def grid(*rows):
+    return [[int(cell) for cell in row] for row in rows]
+
+
+def rectangle_sizes(scene):
+    """Independent input-grammar check, with no answer transformation."""
+    remaining = {(r, c) for r, row in enumerate(scene) for c, value in enumerate(row) if value == 4}
+    sizes = []
+    while remaining:
+        first = remaining.pop()
+        cells, todo = {first}, [first]
+        while todo:
+            r, c = todo.pop()
+            for point in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if point in remaining:
+                    remaining.remove(point)
+                    cells.add(point)
+                    todo.append(point)
+        rows, cols = zip(*cells)
+        height, width = max(rows) - min(rows) + 1, max(cols) - min(cols) + 1
+        assert len(cells) == height * width, "input component must be a solid rectangle"
+        sizes.append((height, width))
+    return sizes
+
+
+# Largest odd rectangle: 7x9, transformed cross occupies 15 cells.
+# The 3x5 rectangle is B's target; the 3x3 odd decoy and 4x4 even
+# distractor must stay solid in the cascade. Every expected row is literal.
+INPUT = grid(
+    "000000000000000000",
+    "044444444400444000",
+    "044444444400444000",
+    "044444444400444000",
+    "044444444400000000",
+    "044444444400000000",
+    "044444444400444400",
+    "044444444400444400",
+    "000000000000444400",
+    "044444000000444400",
+    "044444000000000000",
+    "044444000000000000",
+    "000000000000000000",
+)
+ALL_ODD = grid(
+    "000000000000000000",
+    "000004000000040000",
+    "000004000000444000",
+    "000004000000040000",
+    "044444444400000000",
+    "000004000000000000",
+    "000004000000444400",
+    "000004000000444400",
+    "000000000000444400",
+    "000400000000444400",
+    "044444000000000000",
+    "000400000000000000",
+    "000000000000000000",
+)
+CASCADE = grid(
+    "000000000000000000",
+    "000004000000444000",
+    "000004000000444000",
+    "000004000000444000",
+    "044444444400000000",
+    "000004000000000000",
+    "000004000000444400",
+    "000004000000444400",
+    "000000000000444400",
+    "000400000000444400",
+    "044444000000000000",
+    "000400000000000000",
+    "000000000000000000",
+)
