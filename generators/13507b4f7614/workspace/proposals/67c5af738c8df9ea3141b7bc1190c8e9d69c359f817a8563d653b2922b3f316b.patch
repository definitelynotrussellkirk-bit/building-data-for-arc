+@pytest.mark.parametrize("setting,expected", [(SETTINGS[0], ALL_ODD), (SETTINGS[1], CASCADE)])
+def test_real_racket_matches_literal_cross_and_causal_selection(setting, expected):
+    native = load_native()
+    before = deepcopy(INPUT)
+    assert native.execute(native.program(setting), INPUT) == expected
+    assert INPUT == before
