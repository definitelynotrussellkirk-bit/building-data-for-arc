+def test_sampler_supports_independent_extremes_and_distinct_inputs():
+    native = load_native()
+    for demos, queries in ((2, 1), (2, 4), (6, 1), (6, 4)):
+        sample = native.sample_inputs(17, demos=demos, queries=queries)
+        assert len(sample["train"]) == demos
+        assert len(sample["test"]) == queries
+        inputs = sample["train"] + sample["test"]
+        assert len({json.dumps(item) for item in inputs}) == demos + queries
+        assert all(1 <= len(item) <= 30 and 1 <= len(item[0]) <= 30 for item in inputs)
+        assert all(type(value) is int and value in (0, 4) for item in inputs for row in item for value in row)
+        for item in inputs:
+            sizes = rectangle_sizes(item)
+            assert 4 <= len(sizes) <= 5
+            assert sum(h % 2 == w % 2 == 1 for h, w in sizes) >= 3
+            assert any(h % 2 == 0 or w % 2 == 0 for h, w in sizes)
+    sample = native.sample_inputs(17, demos=6, queries=4)
+    assert (len(sample["test"][0]), len(sample["test"][0][0])) in ((9, 12), (12, 9))
+    large = [item for item in sample["test"] if len(item) == len(item[0]) == 30]
+    assert large, "four-query curriculum must execute a 30x30 stress case"
+    points = [(r, c) for r, row in enumerate(large[0]) for c, value in enumerate(row) if value]
+    assert max(r for r, _ in points) - min(r for r, _ in points) >= 20
+    assert max(c for _, c in points) - min(c for _, c in points) >= 20
