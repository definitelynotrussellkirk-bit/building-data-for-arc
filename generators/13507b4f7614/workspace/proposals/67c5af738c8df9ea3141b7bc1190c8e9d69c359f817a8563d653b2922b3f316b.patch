+def test_every_scene_has_one_causal_target_after_anchor_becomes_cross():
+    native = load_native()
+    pool = native.sample_inputs(17, demos=6, queries=4)
+    for split, grids in pool.items():
+        for index, scene in enumerate(grids):
+            odd = [(h, w) for h, w in rectangle_sizes(scene) if h % 2 and w % 2]
+            anchor = max(odd, key=lambda hw: hw[0] * hw[1])
+            assert sum(h * w == anchor[0] * anchor[1] for h, w in odd) == 1
+            occupied_cross_cells = anchor[0] + anchor[1] - 1
+            assert sum(h * w == occupied_cross_cells for h, w in odd) == 1, (split, index)
