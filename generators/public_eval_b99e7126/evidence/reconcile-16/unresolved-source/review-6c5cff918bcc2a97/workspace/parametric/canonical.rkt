(rule!
 (lambda (g)
  (let ()
   (define blueprint-mode "identity")
   (define h (rows g))
   (define w (cols g))
   (define colors (remove-duplicates (apply append g)))
   (define (row-all? r color)
    (for/and ((c (in-range w))) (= (at g r c) color)))
   (define (column-all? c color)
    (for/and ((r (in-range h))) (= (at g r c) color)))
   (define separators
    (for/list ((color colors)
               #:when (and (row-all? 0 color) (row-all? (- h 1) color)
                           (column-all? 0 color) (column-all? (- w 1) color)))
     color))
   (define sep (first separators))
   (define row-lines (for/list ((r (in-range h)) #:when (row-all? r sep)) r))
   (define column-lines (for/list ((c (in-range w)) #:when (column-all? c sep)) c))
   (define nr (- (length row-lines) 1))
   (define nc (- (length column-lines) 1))
   (define (tile i j)
    (for/list ((r (in-range (+ 1 (list-ref row-lines i)) (list-ref row-lines (+ i 1)))))
     (for/list ((c (in-range (+ 1 (list-ref column-lines j)) (list-ref column-lines (+ j 1)))))
      (at g r c))))
   (define tile-grid
    (for/list ((i (in-range nr)))
     (for/list ((j (in-range nc))) (tile i j))))
   (define all-tiles (apply append tile-grid))
   (define motifs (remove-duplicates all-tiles equal?))
   (define normal
    (argmax (lambda (motif) (count (lambda (x) (equal? x motif)) all-tiles)) motifs))
   (define anomaly (first (filter (lambda (motif) (not (equal? motif normal))) motifs)))
   (define normal-colors (remove-duplicates (apply append normal)))
   (define novel
    (first (filter (lambda (x) (not (member x normal-colors)))
                   (remove-duplicates (apply append anomaly)))))
   (define base-mask
    (for/list ((row anomaly))
     (for/list ((x row)) (= x novel))))
   (define posed-mask
    (cond ((equal? blueprint-mode "rotate_cw") (rotate-cw base-mask))
          ((equal? blueprint-mode "rotate_180") (rotate-180 base-mask))
          (else base-mask)))
   (define mh (length posed-mask))
   (define mw (length (first posed-mask)))
   (define observed
    (for*/list ((i (in-range nr)) (j (in-range nc))
                #:when (equal? (list-ref (list-ref tile-grid i) j) anomaly))
     (list i j)))
   (define (mask-at? r c)
    (and (<= 0 r) (< r mh) (<= 0 c) (< c mw)
         (list-ref (list-ref posed-mask r) c)))
   (define placements
    (for*/list ((top (in-range (+ 1 (- nr mh))))
                (left (in-range (+ 1 (- nc mw))))
                #:when
                (for/and ((p observed))
                 (mask-at? (- (first p) top) (- (second p) left))))
     (list top left)))
   (define top (first (first placements)))
   (define left (second (first placements)))
   (define mask-points
    (for*/list ((r (in-range mh)) (c (in-range mw))
                #:when (mask-at? r c))
     (list (+ top r) (+ left c))))
   (define target
    (cond
     ((equal? blueprint-mode "no_completion") observed)
     ((equal? blueprint-mode "bounding_box")
      (let* ((rs (map first mask-points))
             (cs (map second mask-points))
             (r0 (apply min rs)) (r1 (apply max rs))
             (c0 (apply min cs)) (c1 (apply max cs)))
       (for*/list ((r (in-range r0 (+ r1 1)))
                   (c (in-range c0 (+ c1 1))))
        (list r c))))
     (else mask-points)))
   (define (interval-index lines x)
    (for/first ((i (in-range (- (length lines) 1)))
                #:when (and (< (list-ref lines i) x)
                            (< x (list-ref lines (+ i 1)))))
     i))
   (for/list ((r (in-range h)))
    (for/list ((c (in-range w)))
     (let ((i (interval-index row-lines r))
           (j (interval-index column-lines c)))
      (if (and i j (member (list i j) target))
          (list-ref (list-ref anomaly (- r (+ 1 (list-ref row-lines i))))
                    (- c (+ 1 (list-ref column-lines j))))
          (at g r c))))))))
