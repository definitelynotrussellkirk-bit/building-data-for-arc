(rule!
 ;; A lattice of equal square tiles contains one common tile and a few copies
 ;; of one rare tile.  The color unique to the rare tile is itself a mask:
 ;; complete the translated macro-arrangement of rare tiles to that mask.
 (lambda (g)
  (let ()
   (define h (rows g))
   (define w (cols g))
   (define sep (at g 0 0))
   (define (separator-row? r)
    (for/and ((c (range w))) (= (at g r c) sep)))
   (define (separator-col? c)
    (for/and ((r (range h))) (= (at g r c) sep)))
   (define row-starts
    (for/list ((r (range h))
               #:when (and (not (separator-row? r))
                           (or (= r 0) (separator-row? (- r 1)))))
     r))
   (define col-starts
    (for/list ((c (range w))
               #:when (and (not (separator-col? c))
                           (or (= c 0) (separator-col? (- c 1)))))
     c))
   (define (run-length start limit separator?)
    (let loop ((i start))
     (if (or (= i limit) (separator? i)) (- i start) (loop (+ i 1)))))
   (unless (and (>= (length row-starts) 3) (>= (length col-starts) 3))
    (error 'nested-mask "expected at least a 3x3 tile lattice"))
   (define tile-h (run-length (first row-starts) h separator-row?))
   (define tile-w (run-length (first col-starts) w separator-col?))
   (unless (and (= tile-h tile-w) (>= tile-h 2)
                (for/and ((r0 row-starts)) (= (run-length r0 h separator-row?) tile-h))
                (for/and ((c0 col-starts)) (= (run-length c0 w separator-col?) tile-w)))
    (error 'nested-mask "expected equal square tiles"))
   (define (tile-at mr mc)
    (let ((r0 (list-ref row-starts mr)) (c0 (list-ref col-starts mc)))
     (for/list ((dr (range tile-h)))
      (for/list ((dc (range tile-w)))
       (at g (+ r0 dr) (+ c0 dc))))))
   (define positions
    (for*/list ((mr (range (length row-starts)))
                (mc (range (length col-starts))))
     (list mr mc)))
   (define patterns
    (remove-duplicates
     (map (lambda (p) (tile-at (first p) (second p))) positions)))
   (unless (= (length patterns) 2)
    (error 'nested-mask "expected exactly two tile patterns"))
   (define p0 (first patterns))
   (define p1 (second patterns))
   (define (pattern-count pattern)
    (for/sum ((p positions))
     (if (equal? (tile-at (first p) (second p)) pattern) 1 0)))
   (define common (if (> (pattern-count p0) (pattern-count p1)) p0 p1))
   (define rare (if (equal? common p0) p1 p0))
   (define common-colors (remove-duplicates (apply append common)))
   (define rare-colors (remove-duplicates (apply append rare)))
   (define unique-colors
    (filter (lambda (color) (not (member color common-colors))) rare-colors))
   (unless (= (length unique-colors) 1)
    (error 'nested-mask "rare tile must have one unique color"))
   (define ink (first unique-colors))
   (define mask
    (for*/list ((dr (range tile-h)) (dc (range tile-w))
                #:when (= (list-ref (list-ref rare dr) dc) ink))
     (list dr dc)))
   (define current
    (filter
     (lambda (p) (equal? (tile-at (first p) (second p)) rare))
     positions))
   (define anchors
    (for*/list ((top (range (+ 1 (- (length row-starts) tile-h))))
                (left (range (+ 1 (- (length col-starts) tile-w))))
                #:when
                (let ((target
                       (map (lambda (p) (list (+ top (first p)) (+ left (second p)))) mask)))
                 (for/and ((p current)) (member p target))))
     (list top left)))
   (unless (= (length anchors) 1)
    (error 'nested-mask "visible rare tiles must identify one mask translation"))
   (define anchor (first anchors))
   (define target
    (map (lambda (p) (list (+ (first anchor) (first p))
                           (+ (second anchor) (second p))))
         mask))
   (define completed
    (for/fold ((out g)) ((p target))
     (let ((r0 (list-ref row-starts (first p)))
           (c0 (list-ref col-starts (second p))))
      (for*/fold ((canvas out)) ((dr (range tile-h)) (dc (range tile-w)))
       (set-cell canvas (+ r0 dr) (+ c0 dc)
                 (list-ref (list-ref rare dr) dc))))))
   (define (row-count r points)
    (for/sum ((p points)) (if (= (first p) r) 1 0)))
   (define candidate-rows (remove-duplicates (map first target)))
   (define selected-row
    (for/fold ((best (first candidate-rows))) ((r (rest candidate-rows)))
     (if (> (row-count r target) (row-count best target)) r best)))
   (unless (= (for/sum ((r candidate-rows))
                (if (= (row-count r target) (row-count selected-row target)) 1 0))
              1)
    (error 'nested-mask "completed mask needs a unique densest row"))
   (for/fold ((out completed)) ((p target))
    (if (= (first p) selected-row)
     (let ((r0 (list-ref row-starts (first p)))
           (c0 (list-ref col-starts (second p))))
      (for/fold ((canvas out)) ((m mask))
       (set-cell canvas (+ r0 (first m)) (+ c0 (second m)) 9)))
     out)))))
