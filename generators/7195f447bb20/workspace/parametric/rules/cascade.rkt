(rule! (lambda (g)
  (let* ((after-a
           (for*/fold ((out g))
                      ((r (in-range (- (rows g) 2)))
                       (c (in-range (- (cols g) 2))))
             (if (and (= (at g r c) 4)
                      (= (at g (+ r 1) (+ c 1)) 0)
                      (= (at g (+ r 2) (+ c 2)) 4)
                      (or (< (- r 1) 0)
                          (< (- c 1) 0)
                          (not (= (at g (- r 1) (- c 1)) 4)))
                      (or (>= (+ r 3) (rows g))
                          (>= (+ c 3) (cols g))
                          (not (= (at g (+ r 3) (+ c 3)) 4))))
                 (set-cell out (+ r 1) (+ c 1) 4)
                 out)))
         (after-b
           (for*/fold ((out after-a))
                      ((r (in-range (rows g)))
                       (c (in-range (- (cols g) 2))))
             (if (and (= (at g r c) 0)
                      (= (at after-a r c) 4)
                      (= (at after-a r (+ c 1)) 0)
                      (= (at after-a r (+ c 2)) 4))
                 (set-cell out r (+ c 1) 4)
                 out))))
    after-b)))
