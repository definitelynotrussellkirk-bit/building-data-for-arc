(rule!
 ;; Recover the tight square of concentric, disjoint color layers.
 ;; Detached straight bars give clockwise quarter turns for their own color;
 ;; absent bars mean zero, and counts wrap modulo four. Crop away instructions.
 (lambda (g)
  (let ()
   (define turn-sign 1)
   (define all-cells (filter (lambda (p) (> (at g (first p) (second p)) 0)) (grid-positions g)))
   (define objs (objects-multicolor g 0))
   (define (inside? p b)
    (and (<= (first b) (first p) (third b)) (<= (second b) (second p) (fourth b))))
   (define (bar? ps)
    (if (null? ps) #t
     (let* ((b (bbox-of-cells ps)) (hh (+ 1 (- (third b) (first b)))) (ww (+ 1 (- (fourth b) (second b)))))
      (and (or (= hh 1) (= ww 1)) (= (length ps) (* hh ww))))))
   (if (null? objs) g
    (let* ((core (pick-max objs obj-size))
           (cr (+ (obj-r1 core) (obj-r2 core))) (cc (+ (obj-c1 core) (obj-c2 core))))
     (define (valid? b)
      (let* ((ins (filter (lambda (p) (inside? p b)) all-cells))
             (outs (filter (lambda (p) (not (inside? p b))) all-cells))
             (colors (unique (map (lambda (p) (at g (first p) (second p))) ins)))
             (bands (for/list ((color colors))
                     (let ((rs (map (lambda (p) (max (abs (- (* 2 (first p)) cr)) (abs (- (* 2 (second p)) cc))))
                                    (filter (lambda (p) (= (at g (first p) (second p)) color)) ins))))
                      (list (apply min rs) (apply max rs))))))
       (and (not (null? ins)) (equal? (bbox-of-cells ins) b) (>= (length colors) 2)
        (for/and ((p outs)) (member (at g (first p) (second p)) colors))
        (for/and ((color colors))
         (bar? (filter (lambda (p) (= (at g (first p) (second p)) color)) outs)))
        (for*/and ((i (range (length bands))) (j (range (+ i 1) (length bands))))
         (let ((a (list-ref bands i)) (b2 (list-ref bands j)))
          (or (< (second a) (first b2)) (< (second b2) (first a))))))))
     (define candidates
      (for/list ((n (range (max (obj-h core) (obj-w core)) (+ 1 (min h w))))
                 #:when (and (= (modulo (- cr (- n 1)) 2) 0) (= (modulo (- cc (- n 1)) 2) 0))
                 #:when (let ((r (/ (- cr (- n 1)) 2)) (c (/ (- cc (- n 1)) 2)))
                          (and (>= r 0) (>= c 0) (< (+ r n -1) h) (< (+ c n -1) w)))
                 #:when (valid? (list (/ (- cr (- n 1)) 2) (/ (- cc (- n 1)) 2)
                                      (/ (+ cr (- n 1)) 2) (/ (+ cc (- n 1)) 2))))
       (list (/ (- cr (- n 1)) 2) (/ (- cc (- n 1)) 2)
             (/ (+ cr (- n 1)) 2) (/ (+ cc (- n 1)) 2))))
     (if (null? candidates) g
      (let* ((b (last candidates)) (n (+ 1 (- (third b) (first b))))
             (ins (filter (lambda (p) (inside? p b)) all-cells))
             (outs (filter (lambda (p) (not (inside? p b))) all-cells))
             (colors (unique (map (lambda (p) (at g (first p) (second p))) ins)))
             (entries (for/list ((color colors))
                       (list color (count-if (lambda (p) (= (at g (first p) (second p)) color)) outs)))))
       (for/fold ((out (empty-grid n n 0))) ((entry entries))
        (define turns (modulo (* turn-sign (second entry)) 4))
        (for/fold ((canvas out)) ((p ins) #:when (= (at g (first p) (second p)) (first entry)))
         (define q
          (for/fold ((q0 (list (- (first p) (first b)) (- (second p) (second b))))) ((k (range turns)))
           (list (second q0) (- n 1 (first q0)))))
         (set-cell canvas (first q) (second q) (first entry)))))))))))
