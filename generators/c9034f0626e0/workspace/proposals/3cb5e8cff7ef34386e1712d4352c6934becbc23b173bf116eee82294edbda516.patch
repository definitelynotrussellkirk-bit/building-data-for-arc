+"""Bounded ordered-lesson probe; does not change the generator or authority."""
+from __future__ import annotations
+
+import argparse
+from functools import reduce
+import hashlib
+import json
+from math import gcd
+import os
+from pathlib import Path
+
+from arc_repl.isolated_verifier import verify_candidate
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK = "8f6a6ec3ae21"
+
+
+def selectors(grid):
+    return ([r for r in range(len(grid)) if grid[r][0] == 1],
+            [c for c in range(len(grid[0])) if grid[0][c] == 2])
+
+
+def paint(grid, rows, cols):
+    return [[8 if r in rows and c in cols else 0 for c in range(len(grid[0]))]
+            for r in range(len(grid))]
+
+
+def predictions(grid):
+    rows, cols = selectors(grid)
+
+    def endpoints(values):
+        return [values[0], values[-1]]
+
+    def progression(values):
+        step = reduce(gcd, (b - a for a, b in zip(values, values[1:])))
+        return list(range(values[0], values[-1] + 1, step))
+
+    pairs = {
+        "filter_left_only": (rows, [c for c, v in enumerate(grid[0]) if v]),
+        "filter_top_only": ([r for r, row in enumerate(grid) if row[0]], cols),
+        "outermost_rows_only": (endpoints(rows), cols),
+        "outermost_columns_only": (rows, endpoints(cols)),
+        "outermost_both_axes": (endpoints(rows), endpoints(cols)),
+        "first_two_rows": (rows[:2], cols),
+        "first_two_columns": (rows, cols[:2]),
+        "last_two_rows": (rows[-2:], cols),
+        "last_two_columns": (rows, cols[-2:]),
+        "first_three_rows": (rows[:3], cols),
+        "first_three_columns": (rows, cols[:3]),
+        "regular_row_progression": (progression(rows), cols),
+        "regular_column_progression": (rows, progression(cols)),
+        "regular_both_progressions": (progression(rows), progression(cols)),
+    }
+    return {name: paint(grid, rs, cs) for name, (rs, cs) in pairs.items()}
+
+
+def dump(path, value):
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    root = find_root(__file__)
+    gen, source, source_sha = load_selected_generator(TASK, root=root)
+    records, findings = [], []
+    for seed in (0, 17, 44):
+        for band in (None, "easy", "medium", "hard"):
+            pairs = []
+            predicted = []
+            for index in range(3):
+                grid = gen.generate(seed, index, difficulty=band)
+                assert gen.self_check(grid) == gen.strict_canonical_like(grid) == []
+                rows, cols = selectors(grid)
+                pair = {"input": grid, "output": paint(grid, rows, cols)}
+                assert pair["output"] == gen.rule_mirror(grid)
+                pairs.append(pair)
+                predicted.append(predictions(grid) | {name: rival(grid) for name, rival in gen.SEMANTIC_RIVALS.items()})
+            ambiguous = [name for name in predicted[0]
+                         if all(predicted[i][name] == pairs[i]["output"] for i in (0, 1))
+                         and predicted[2][name] != pairs[2]["output"]]
+            record = {"seed": seed, "difficulty": band, "sample_indices": [0, 1, 2],
+                      "demo_indices": [0, 1], "query_index": 2,
+                      "selector_counts": [list(map(len, selectors(p["input"]))) for p in pairs],
+                      "ambiguous_rivals": ambiguous,
+                      "declared_lesson_errors": gen.lesson_identifiable(pairs[:2], pairs[2])}
+            records.append(record)
+            for name in ambiguous:
+                findings.append({"record": record, "rival": name, "pairs": pairs,
+                                 "rival_outputs": [p[name] for p in predicted]})
+
+    summary = {"schema": "8f6a6ec3ae21-bounded-ordered-learnability-v1", "task_id": TASK,
+               "source_sha256": source_sha, "rule_hash": gen.RULE_HASH,
+               "scope": {"seeds": [0, 17, 44], "difficulty_bands": [None, "easy", "medium", "hard"],
+                         "lessons": 12, "input_slots": 36, "rivals": len(predicted[0]),
+                         "query_rotations": False, "overrides": {}},
+               "python_findings": len(findings),
+               "ambiguous_lessons": sum(bool(r["ambiguous_rivals"]) for r in records),
+               "records": records, "status": "bounded_no_finding", "limits": [
+                   "Twelve ordinary ordered two-demo/one-query lessons; no broad census or full battery.",
+                   "Only the retained witness is checked through protected Racket; other screening labels are independent Python.",
+                   "Existing one-sided query-rotation audit was read, not repeated; no approval state or production source changed."]}
+    dump(args.out / "screening.json", summary)
+    if findings:
+        # Retain the smallest complete ordinary lesson, preferring a direct
+        # endpoint-selection hypothesis when equally sized.
+        witness = min(findings, key=lambda f: (
+            sum(len(p["input"]) * len(p["input"][0]) for p in f["pairs"]),
+            not f["rival"].startswith("outermost"), f["rival"]))
+        rows = []
+        with canonical_path(root).open(encoding="utf-8") as handle:
+            for line in handle:
+                row = json.loads(line)
+                if row.get("task_id") == TASK:
+                    rows.append(row)
+        sources = {row["program_solution"].strip() for row in rows}
+        assert len(sources) == 1
+        program = sources.pop()
+        task = {"train": [witness["pairs"][0]],
+                "test": [{"input": pair["input"]} for pair in witness["pairs"]]}
+        receipt = verify_candidate(task, program, racket_path=os.environ["RACKET_PATH"])
+        dump(args.out / "racket.json", {"program_solution": program,
+              "program_sha256": hashlib.sha256(program.encode()).hexdigest(), "receipt": receipt})
+        assert receipt.get("status") == "pass" and receipt.get("backend") == "racket", receipt
+        assert receipt["test_outputs"] == [p["output"] for p in witness["pairs"]]
+        assert witness["rival_outputs"][:2] == receipt["test_outputs"][:2]
+        assert witness["rival_outputs"][2] != receipt["test_outputs"][2]
+        witness["output_basis"] = "Fresh protected canonical Racket on all three lesson inputs"
+        witness["source_sha256"] = source_sha
+        witness["rule_hash"] = gen.RULE_HASH
+        witness["query_difference_cells"] = [
+            [r, c, expected, witness["rival_outputs"][2][r][c]]
+            for r, row in enumerate(receipt["test_outputs"][2])
+            for c, expected in enumerate(row) if expected != witness["rival_outputs"][2][r][c]]
+        dump(args.out / "witness.json", witness)
+        summary.update(status="protected_racket_labeled_ordered_lesson_counterexample",
+                       witness={"seed": witness["record"]["seed"],
+                                "difficulty": witness["record"]["difficulty"],
+                                "rival": witness["rival"],
+                                "selector_counts": witness["record"]["selector_counts"],
+                                "changed_query_cells": len(witness["query_difference_cells"])},
+                       protected_rule_applications=4)
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == source_sha
+    dump(args.out / "summary.json", summary)
+    dump(args.out / "manifest.json", {"task_id": TASK, "source_sha256": source_sha,
+         "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+         "files": {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
+                   for p in args.out.iterdir() if p.is_file()}})
+    print(json.dumps({k: summary[k] for k in ("status", "scope", "python_findings", "ambiguous_lessons")} |
+                     {"witness": summary.get("witness"), "out": str(args.out)}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
