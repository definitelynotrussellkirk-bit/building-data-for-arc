+"""One finite protected-Racket probe of canonical demos versus pair-count shortcuts.
+
+From the review packet: WORK/.venv/bin/python review.py run python3
+generators/8f5206e72b74/workspace/learnability_probe.py --out ../checks/8f5206e72b74/learnability
+"""
+from copy import deepcopy
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+TASK = "8f5206e72b74"
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def replace(source, old, new):
+    if source.count(old) != 1:
+        raise ValueError(f"mutation is not unique: {old}")
+    return source.replace(old, new, 1)
+
+
+def run(out):
+    out.mkdir(parents=True, exist_ok=False)
+    (out / "private").mkdir()
+    (out / "public").mkdir()
+    sys.path.insert(0, str(ROOT / "src"))
+    from arcpuzzles.parametric_worker import _local_imports, _real_evaluator, _grid
+    runtime = ROOT / "shared/runtime"
+    source = ROOT / "generators" / TASK / "generator.py"
+    before = source.read_bytes()
+    report = {"schema": "8f5206e72b74-bounded-learnability-v1", "task_id": TASK,
+              "generator_sha256": digest(before), "helper_sha256": digest(Path(__file__).read_bytes()),
+              "racket_calls": 0, "failures": [], "rivals": {}}
+    with (ROOT / "shared/data/canonical/puzzles.jsonl").open() as stream:
+        for line in stream:
+            row = json.loads(line)
+            if row.get("task_id") == TASK:
+                canonical, raw_row = row, line.encode()
+                break
+        else:
+            raise ValueError("exact canonical task is missing")
+    report["canonical_row_sha256"] = digest(raw_row)
+    (out / "private/generator.py").write_bytes(before)
+    (out / "private/canonical-row.json").write_bytes(raw_row)
+    actual = canonical["program_solution"]
+    needle = "(in-list (e8b-colors-reading g))"
+    programs = {"reference": actual}
+    for limit in (1, 2, 3):
+        programs[f"first_{limit}_colors"] = replace(actual, needle,
+            f"(in-list (take (e8b-colors-reading g) (min {limit} (length (e8b-colors-reading g)))))")
+    programs["last_2_colors"] = replace(actual, needle,
+        "(in-list (take-right (e8b-colors-reading g) (min 2 (length (e8b-colors-reading g)))))")
+    programs["whole_active_row"] = replace(actual, "(range a (+ b 1))", "(range 0 (cols g))")
+    programs["extend_to_right_edge"] = replace(actual, "(range a (+ b 1))", "(range a (cols g))")
+    programs["ignore_blank_interior_check"] = replace(actual,
+        "(all? (lambda (c) (= (at g r c) 0)) (range (+ a 1) b))", "#t")
+    programs["allow_more_than_two_same_color_cells"] = replace(actual,
+        "(= (length cells) 2)", "(>= (length cells) 2)")
+    with _local_imports(runtime, source.parent):
+        from reviewer_support import load_selected_generator, public_challenge_bytes, public_challenge_id
+        generator, loaded_path, loaded_hash = load_selected_generator(TASK, root=ROOT)
+        if loaded_path.resolve() != source or loaded_hash != report["generator_sha256"]:
+            raise ValueError("generator source mismatch")
+        query = canonical["test"]
+        if isinstance(query, list):
+            if len(query) != 1:
+                raise ValueError("this bounded probe expects one canonical query")
+            query = query[0]
+        queries = [{"kind": "canonical", "input": query["input"], "claimed_output": query["output"]}]
+        recipes = [(0, 0, {"grid_h": 6, "grid_w": 8, "pairs": 3}), (0, 3, {}), (17, 3, {})]
+        for seed, sample_index, overrides in recipes:
+            grid = generator.generate(seed, sample_index, **overrides)
+            if generator.self_check(grid):
+                raise ValueError("generated query failed the generator self-check")
+            queries.append({"kind": "generated_query", "seed": seed, "sample_index": sample_index,
+                            "overrides": overrides, "input": grid})
+        apply, identity, bridge = _real_evaluator(runtime)
+        report["runtime"] = identity
+        def execute(program, grid):
+            report["racket_calls"] += 1
+            return _grid(apply(program, deepcopy(grid)))
+        try:
+            demo_predictions = {name: [execute(program, pair["input"]) for pair in canonical["train"]]
+                                for name, program in programs.items()}
+            exact_demos = demo_predictions["reference"]
+            if exact_demos != [pair["output"] for pair in canonical["train"]]:
+                raise ValueError("reference disagrees with canonical demonstrations")
+            survivors = [name for name in programs if demo_predictions[name] == exact_demos]
+            outputs = {name: [execute(programs[name], query["input"]) for query in queries]
+                       for name in survivors}
+            if outputs["reference"][0] != query["output"]:
+                raise ValueError("reference disagrees with canonical query")
+            for name in programs:
+                survives = name in survivors
+                mismatch = ([i for i, (left, right) in enumerate(zip(outputs[name], outputs["reference"])) if left != right]
+                            if survives else [])
+                report["rivals"][name] = {"demo_fit": survives,
+                    "demo_mismatch_indices": [i for i, (left, right) in enumerate(zip(demo_predictions[name], exact_demos)) if left != right],
+                    "query_status": "disagrees" if mismatch else "agrees_on_checked_queries" if survives else "not_run_demo_rejected",
+                    "query_mismatch_indices": mismatch}
+            report["queries"] = [{key: value for key, value in item.items() if key not in ("input", "claimed_output")}
+                                 | {"shape": [len(item["input"]), len(item["input"][0])],
+                                    "pair_count": len({value for row in item["input"] for value in row if value})}
+                                 for item in queries]
+            report["canonical_query_ambiguity"] = any(0 in item["query_mismatch_indices"] for name, item in report["rivals"].items() if name != "reference")
+            found = report["rivals"]["first_2_colors"]["query_mismatch_indices"]
+            report["bounded_generated_query_ambiguity"] = bool(found)
+            if found:
+                index = found[0]
+                visible = {"train": canonical["train"], "test": [{"input": queries[index]["input"]}]}
+                content_id = public_challenge_id(visible)
+                public_path = f"public/{content_id}.json"
+                (out / public_path).write_bytes(public_challenge_bytes(visible))
+                witness = {"description": "Original canonical demonstrations plus one lawful generated query; original canonical query is not ambiguous in this finite bank.",
+                    "visible": visible, "query_recipe": report["queries"][index],
+                    "reference_program": actual, "rival_program": programs["first_2_colors"],
+                    "reference_output": outputs["reference"][index], "rival_output": outputs["first_2_colors"][index],
+                    "generator_sha256": report["generator_sha256"], "public_challenge_id": content_id}
+                (out / "private/witness.json").write_text(json.dumps(witness, indent=2) + "\n")
+                report["witness"] = "private/witness.json"
+                report["public_witness"] = public_path
+            (out / "private/execution.json").write_text(json.dumps({"programs": programs,
+                "demonstrations": canonical["train"], "demo_predictions": demo_predictions,
+                "queries": queries, "survivor_query_predictions": outputs}, indent=2) + "\n")
+        finally:
+            bridge.close()
+    report["source_unchanged"] = source.read_bytes() == before
+    if not report["source_unchanged"]:
+        raise ValueError("generator changed during probe")
+    report["status"] = "bounded_demo_coverage_gap" if report["bounded_generated_query_ambiguity"] else "no_observed_finite_rival_disagreement"
+    report["limits"] = ["One canonical lesson, two demonstrations, its original query and three generated queries; eight finite rivals.",
+        "The generated minimum-size query uses documented overrides; it is not the original canonical query.",
+        "No demonstration assembly contract is supplied by this grid generator; this is a lesson-coverage observation, not a production label defect.",
+        "Ignoring interior blockers and allowing more than two same-color cells agree on these inputs because the generator excludes those cases.",
+        "No exhaustive search, full battery, parametric work, production modification or approval change."]
+    (out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"status": report["status"], "report": str(out / "report.json"),
+                      "racket_calls": report["racket_calls"], "canonical_query_ambiguity": report["canonical_query_ambiguity"]}))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    run(parser.parse_args().out.absolute())
