+"""Native lattice lessons: count boundaries, causal selection and exact labels."""
+from copy import deepcopy
+import importlib.util
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+HOME = Path(__file__).resolve().parents[1] / "workspace" / "parametric"
+
+
+def native():
+    path = HOME / "native.py"
+    assert path.is_file(), "native four-query lattice implementation is required"
+    spec = importlib.util.spec_from_file_location("lattice_native_tests", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_native_contract_preserves_the_exact_canonical_default():
+    module = native()
+    from reviewer_support import canonical_path, find_root
+    rows = [json.loads(line) for line in canonical_path(find_root(__file__)).read_text().splitlines()]
+    reference = next(row["program_solution"] for row in rows
+                     if row.get("content_hash") == "c9034f0626e0")
+    assert module.program({"spacing_rule": "period_2"}) == reference
+
+
+def causal_grid():
+    grid = [[0] * 13 for _ in range(13)]
+    grid[4][1] = 8
+    for r, c in [(4, 5), (4, 6), (5, 5), (4, 9), (5, 9), (2, 2), (6, 6)]:
+        grid[r][c] = 5
+    return grid
+
+
+def test_selected_component_controls_spacing_and_uses_four_connectivity():
+    module = native()
+    grid = causal_grid()
+    expected = deepcopy(grid)
+    for r, c in [(0, 1), (0, 5), (0, 9), (8, 1), (8, 5), (8, 9),
+                 (12, 1), (12, 5), (12, 9)]:
+        expected[r][c] = 8
+    intermediate = module.intermediate(grid)
+    assert intermediate["hit"] == [4, 5]
+    assert intermediate["component_size"] == 3
+    assert intermediate["period"] == 4
+    assert module.solve(grid, "ray_component") == expected
+    assert module.solve(grid, "period_2") != expected
+    assert module.solve(grid, "period_3") != expected
+
+
+@pytest.mark.parametrize("demos", [2, 3, 6])
+@pytest.mark.parametrize("queries", [1, 4])
+def test_counts_matched_inputs_distinctness_and_demonstration_identifiability(demos, queries):
+    module = native()
+    episodes = [module.generate(17, {"spacing_rule": name}, demos, queries)
+                for name in module.SETTINGS]
+    assert len({json.dumps([p["input"] for p in e["train"] + e["test"]])
+                for e in episodes}) == 1
+    for episode in episodes:
+        assert len(episode["train"]) == demos
+        assert len(episode["test"]) == queries
+        inputs = [p["input"] for p in episode["train"] + episode["test"]]
+        assert len({json.dumps(g) for g in inputs}) == demos + queries
+        selected = episode["settings"]["spacing_rule"]
+        survivors = [name for name in module.SETTINGS
+                     if all(module.solve(pair["input"], name) == pair["output"]
+                            for pair in episode["train"])]
+        assert survivors == [selected]
+        assert module.teaching_check(episode) == []
+
+
+def test_four_query_export_has_unchanged_first_turn_and_substantive_30_square():
+    module = native()
+    from reviewer_support import public_challenge_bytes
+    one = module.generate(0, {"spacing_rule": "ray_component"}, 3, 1)
+    four = module.generate(0, {"spacing_rule": "ray_component"}, 3, 4)
+    assert public_challenge_bytes(module.public_turn(one, 0)) == public_challenge_bytes(module.public_turn(four, 0))
+    for i in range(4):
+        visible = module.public_turn(four, i)
+        assert set(visible) == {"train", "test"}
+        assert visible["test"] == [{"input": four["test"][i]["input"]}]
+    large = four["test"][3]["input"]
+    assert len(large) == len(large[0]) == 30
+    assert 180 <= sum(v == 5 for row in large for v in row) <= 540
+    assert all(any(v == 5 for row in large[start:start + 10] for v in row) for start in [0, 10, 20])
+    assert all(any(row[c] == 5 for row in large for c in range(start, start + 10)) for start in [0, 10, 20])
+    assert any(pair["input"][0] != pair["output"][0] for pair in four["test"])
+
+
+@pytest.mark.parametrize("field,value", [("seed", True), ("seed", -1), ("demos", 1),
+                                         ("demos", 7), ("demos", True),
+                                         ("queries", 0), ("queries", 5)])
+def test_bad_requests_fail_closed(field, value):
+    module = native()
+    args = dict(seed=0, settings={"spacing_rule": "period_2"}, demos=3, queries=4)
+    args[field] = value
+    with pytest.raises((TypeError, ValueError)):
+        module.generate(**args)
+
+
+def test_invalid_settings_and_missing_ray_hit_fail_closed():
+    module = native()
+    for setting in [None, {}, {"spacing_rule": True}, {"spacing_rule": "wrong"},
+                    {"spacing_rule": "period_2", "unused": 1}]:
+        with pytest.raises((TypeError, ValueError)):
+            module.program(setting)
+    grid = [[0] * 13 for _ in range(13)]
+    grid[4][1] = 8
+    with pytest.raises(ValueError, match="hit"):
+        module.solve(grid, "ray_component")
+
+
+def test_projection_drops_private_pair_metadata_and_teaching_check_rejects_wrong_label():
+    module = native()
+    episode = module.generate(0, {"spacing_rule": "ray_component"}, 2, 4)
+    for pair in episode["train"]:
+        pair["private_parameters"] = {"spacing_rule": "ray_component"}
+    assert all(set(pair) == {"input", "output"} for pair in module.public_turn(episode)["train"])
+    broken = deepcopy(episode)
+    broken["test"][0]["output"][0][0] = (broken["test"][0]["output"][0][0] + 1) % 10
+    assert module.teaching_check(broken) == ["label does not match the selected rule"]
+
+
+def test_racket_rival_programs_match_their_claimed_semantics():
+    module = native()
+    from arcpuzzles.parametric_worker import _real_evaluator
+    from reviewer_support import find_root
+    apply, identity, bridge = _real_evaluator(find_root(__file__) / "shared/runtime")
+    try:
+        assert identity["backend"] == "racket" and identity["protected"] is True
+        grids = [p["input"] for p in module.generate(0, {"spacing_rule": "ray_component"}, 2, 4)["train"]]
+        for grid in grids:
+            for name, expected in module.rivals(grid, "ray_component").items():
+                assert apply(module.rival_program(name, "ray_component"), grid) == expected, name
+    finally:
+        bridge.close()
+
+
+def test_minimum_demo_core_distinguishes_cell_count_from_bbox_semiperimeter():
+    module = native()
+    for seed in (0, 17):
+        episode = module.generate(seed, {"spacing_rule": "ray_component"}, 2, 4)
+        differences = []
+        for pair in episode["train"]:
+            info = module.intermediate(pair["input"])
+            rs, cs = zip(*info["component_cells"])
+            bbox_semiperimeter = max(rs) - min(rs) + max(cs) - min(cs) + 2
+            differences.append(info["period"] != bbox_semiperimeter)
+        assert any(differences), "a bounding-box shortcut must be visible in the minimum teaching core"
+
+
+def test_evidence_writer_rejects_duplicate_visible_lessons(tmp_path, monkeypatch):
+    module = native()
+    spec = importlib.util.spec_from_file_location("lattice_native_audit_test", HOME / "verify_native.py")
+    audit = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(audit)
+    real_generate = module.generate
+
+    # Deliberately faulty adapter fixture: distinct requested seeds collapse to
+    # one real, fully Racket-labelable lesson. The exporter must reject it.
+    def duplicate_generate(seed, settings, demos=3, queries=4):
+        return real_generate(0, settings, demos, queries)
+
+    monkeypatch.setattr(module, "generate", duplicate_generate)
+    monkeypatch.setattr(audit, "_native", lambda: module)
+    report = audit.run(tmp_path / "duplicate")
+    assert report["status"] == "error"
+    assert "duplicate visible" in report["error"]["message"]
+    assert not list((tmp_path / "duplicate" / "public").glob("*.json"))
+
+
+def test_racket_executes_literal_component_witness_and_all_settings():
+    module = native()
+    from arc_repl.isolated_verifier import verify_candidate
+    grid = causal_grid()
+    for name in module.SETTINGS:
+        pairs = module.generate(0, {"spacing_rule": name}, 2, 4)
+        task = {"train": pairs["train"], "test": pairs["test"] + [{"input": grid}]}
+        receipt = verify_candidate(task, module.program({"spacing_rule": name}),
+                                   racket_path=os.environ["RACKET_PATH"])
+        assert receipt["status"] == "pass", receipt
+        assert receipt["backend"] == "racket"
+        assert receipt["test_outputs"] == [p["output"] for p in pairs["test"]] + [module.solve(grid, name)]
