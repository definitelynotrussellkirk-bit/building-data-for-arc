diff --git a/repo/generators/c9034f0626e0/workspace/parametric/verify_native.py b/repo/generators/c9034f0626e0/workspace/parametric/verify_native.py
new file mode 100644
--- /dev/null
+++ b/repo/generators/c9034f0626e0/workspace/parametric/verify_native.py
@@ -0,0 +1,207 @@
+"""Bounded, replayable Racket self-audit and sequential public export example.
+
+Run from the packet wrapper; --out must be new. No acceptance is granted.
+The full four-query records are private. Every public file contains the same
+demonstrations and exactly one input, with its name derived from its own bytes.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+
+def _native():
+    path = Path(__file__).resolve().with_name("native.py")
+    spec = importlib.util.spec_from_file_location("_lattice_audit_native", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _raw(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+def _sha(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def _write(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(_raw(value))
+
+
+def run(out):
+    from arcpuzzles.parametric_worker import _real_evaluator
+    from reviewer_support import find_root, public_challenge_bytes, public_challenge_id
+
+    module = _native()
+    root = find_root(__file__)
+    home = Path(__file__).resolve().parent
+    sources = [home / name for name in ("native.py", "adapter.py", "prototype.py", "promotion.json", "verify_native.py")]
+    bindings = {str(path.relative_to(root)): _sha(path.read_bytes()) for path in sources}
+    out = Path(out).resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    report = {"schema": "c9034f0626e0-native-self-review-v1", "status": "running",
+              "task_id": module.TASK_ID, "source_sha256": bindings,
+              "training_admitted": False, "native_acceptance": "owner_pending"}
+    _write(out / "report.json", report)
+    apply, identity, bridge = _real_evaluator(root / "shared/runtime")
+    cache, programs = {}, {}
+    evaluations = 0
+
+    def execute(program, grid):
+        nonlocal evaluations
+        pid = _sha(program.encode())
+        programs[pid] = program
+        key = (pid, _sha(_raw(grid)))
+        if key not in cache:
+            cache[key] = apply(program, grid)
+            evaluations += 1
+        return deepcopy(cache[key])
+
+    try:
+        report["racket"] = identity
+        episodes, certificates, publications = [], [], {}
+        label_checks, core_rivals, harmful_survivors = 0, 0, 0
+        for seed in (0, 17):
+            for selected in module.SETTINGS:
+                settings = {"spacing_rule": selected}
+                complete = module.generate(seed, settings, 6, 4)
+                program = module.program(settings)
+                # Execute minimum and maximum count surfaces without duplicating
+                # already checked grids; all public labels below use these results.
+                for pair in complete["train"] + complete["test"]:
+                    actual = execute(program, pair["input"])
+                    if actual != pair["output"]:
+                        raise ValueError("Racket/native label disagreement")
+                    pair["output"] = actual
+                    label_checks += 1
+                for count in (2, 3, 6):
+                    episode = module.generate(seed, settings, count, 4)
+                    if episode["train"] != complete["train"][:count] or episode["test"] != complete["test"]:
+                        raise ValueError("demo count changed the input stream")
+                    if module.teaching_check(episode):
+                        raise ValueError("bounded teaching guard failed")
+                episode = deepcopy(complete)
+                episode["train"] = episode["train"][:3]
+                one = module.generate(seed, settings, 3, 1)
+                if public_challenge_bytes(module.public_turn(one)) != public_challenge_bytes(module.public_turn(episode)):
+                    raise ValueError("first turn depends on future query count")
+                private_path = f"private/episodes/{len(episodes):02d}.json"
+                _write(out / private_path, episode)
+                episodes.append({"seed": seed, "settings": settings, "path": private_path,
+                                 "demo_counts_exercised": [2, 3, 6], "query_count": 4,
+                                 "sampling_attempts": complete["sampling_attempts"],
+                                 "query_shapes": [[len(p["input"]), len(p["input"][0])] for p in episode["test"]],
+                                 "intermediates": [module.intermediate(p["input"]) for p in episode["train"] + episode["test"]]})
+                for i in range(4):
+                    visible = module.public_turn(episode, i)
+                    payload = public_challenge_bytes(visible)
+                    pid = public_challenge_id(visible)
+                    # A private mutation must not affect the projection or name.
+                    altered = deepcopy(episode)
+                    altered["seed"] += 1000
+                    altered["settings"] = {"private": "changed"}
+                    altered["program_solution"] = "private"
+                    for pair in altered["test"]:
+                        pair["output"] = [[9]]
+                    if public_challenge_bytes(module.public_turn(altered, i)) != payload:
+                        raise ValueError("private data changed public bytes")
+                    if pid in publications:
+                        raise ValueError("duplicate visible challenge in public batch")
+                    publications[pid] = payload
+
+                # Fit competitors to ONLY the minimum two demonstrations. Execute
+                # every competitor; runtime failure is an error, never refutation.
+                demos = complete["train"][:2]
+                names = module.rivals(demos[0]["input"], selected)
+                rows = []
+                for name in names:
+                    candidate = module.rival_program(name, selected)
+                    mismatches = []
+                    for i, pair in enumerate(demos):
+                        actual = execute(candidate, pair["input"])
+                        if actual != module.rivals(pair["input"], selected)[name]:
+                            raise ValueError("Racket/Python rival mismatch: " + name)
+                        if actual != pair["output"]:
+                            mismatches.append(i)
+                    query_differences = []
+                    if not mismatches:
+                        for i, pair in enumerate(complete["test"]):
+                            actual = execute(candidate, pair["input"])
+                            if actual != pair["output"]:
+                                query_differences.append(i)
+                    if query_differences:
+                        harmful_survivors += 1
+                    rows.append({"name": name, "program_sha256": _sha(candidate.encode()),
+                                 "demonstration_mismatches": mismatches,
+                                 "query_disagreements": query_differences,
+                                 "status": "refuted_by_demonstrations" if mismatches else
+                                           "harmful_survivor" if query_differences else "agrees_on_retained_queries"})
+                    core_rivals += 1
+                certificates.append({"seed": seed, "settings": settings,
+                                     "private_episode_path": private_path,
+                                     "fitted_demonstration_indices": [0, 1], "rivals": rows})
+
+        if harmful_survivors:
+            raise ValueError("a declared rival fits demonstrations and changes a query")
+        # Small success-rate probe, including the largest permitted seed. This is
+        # a finite sample of the bounded sampler, not a guarantee for every seed.
+        sampling = []
+        for seed in (*range(16), 17, 2**63 - 1):
+            try:
+                row = module.generate(seed, {"spacing_rule": "ray_component"}, 6, 4)
+                sampling.append({"seed": seed, "status": "pass", "attempts": row["sampling_attempts"]})
+            except Exception as exc:
+                sampling.append({"seed": seed, "status": "failed", "error": str(exc)})
+        if any(row["status"] != "pass" for row in sampling):
+            raise ValueError("bounded sampler probe failed")
+        for pid in sorted(publications):
+            path = out / "public" / (pid + ".json")
+            path.parent.mkdir(exist_ok=True)
+            path.write_bytes(publications[pid])
+        _write(out / "private/programs.json", programs)
+        _write(out / "private/teaching.json", certificates)
+        _write(out / "private/sampling.json", sampling)
+        if bindings != {str(path.relative_to(root)): _sha(path.read_bytes()) for path in sources}:
+            raise ValueError("sources changed during self-audit")
+        report.update({"status": "pass", "episodes": episodes,
+                       "label_checks": label_checks, "protected_racket_evaluations": evaluations,
+                       "rival_checks": core_rivals, "harmful_survivors": harmful_survivors,
+                       "public_one_query_files": len(publications),
+                       "sampling": {"requests": len(sampling), "successes": len(sampling), "failures": 0,
+                                    "attempt_histogram": dict(sorted(Counter(row["attempts"] for row in sampling).items()))},
+                       "limitations": ["Only the named finite rivals and recorded seeds/counts were exercised.",
+                                        "The ray-derived rule is contextual gating, not iterative state simulation.",
+                                        "Canonical production size/count controls are unchanged; larger inputs are native-family extensions.",
+                                        "Source qualification and owner acceptance are separate from this reviewer evidence."]})
+    except Exception as exc:
+        report.update(status="error", error={"type": type(exc).__name__, "message": str(exc)},
+                      protected_racket_evaluations=evaluations)
+    finally:
+        bridge.close()
+    _write(out / "report.json", report)
+    inventory = [{"path": p.relative_to(out).as_posix(), "sha256": _sha(p.read_bytes()), "bytes": p.stat().st_size}
+                 for p in sorted(out.rglob("*")) if p.is_file() and p.name != "manifest.json"]
+    _write(out / "manifest.json", {"status": report["status"], "source_sha256": bindings, "files": inventory})
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run(args.out)
+    print(json.dumps({key: report[key] for key in ("status", "label_checks", "protected_racket_evaluations",
+                     "rival_checks", "harmful_survivors", "public_one_query_files", "sampling", "error") if key in report}, sort_keys=True))
+    return 0 if report["status"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
