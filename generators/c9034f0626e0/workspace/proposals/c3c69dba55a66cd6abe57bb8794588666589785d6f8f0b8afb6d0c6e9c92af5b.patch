+"""Racket-backed regression for visible-byte identities of prototype exports."""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+
+TASK_HOME = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(TASK_HOME / "workspace" / "parametric"))
+
+import prototype  # noqa: E402
+from reviewer_support import public_challenge_bytes, public_challenge_id  # noqa: E402
+
+
+def test_racket_writer_names_exact_public_bytes_and_ignores_private_identity(tmp_path, monkeypatch):
+    racket_path = os.environ.get("RACKET_PATH")
+    assert racket_path, "RACKET_PATH must be supplied by the packet wrapper"
+    original_sample_episode = prototype.sample_episode
+    original_select_seeds = prototype.select_seeds
+    original_write_bytes = Path.write_bytes
+    public_write_order = []
+
+    def record_public_write(path, payload):
+        if path.parent.name == "public":
+            public_write_order.append(path.name)
+        return original_write_bytes(path, payload)
+
+    def reverse_private_order(base_seed):
+        selection = original_select_seeds(base_seed)
+        selection["seeds"].reverse()
+        return selection
+
+    monkeypatch.setattr(Path, "write_bytes", record_public_write)
+
+    def altered_private_metadata(seed):
+        episode = original_sample_episode(seed)
+        episode["episode_id"] = "private-only-replacement-" + episode["episode_id"]
+        episode["seed"] += 1000000000
+        episode["parameters"]["private_note"] = "private-only-replacement"
+        episode["program"] += "\n; private-only-replacement"
+        return episode
+
+    exported = []
+    for name, sampler in (("original", original_sample_episode), ("altered", altered_private_metadata)):
+        public_write_order.clear()
+        monkeypatch.setattr(prototype, "sample_episode", sampler)
+        if name == "altered":
+            monkeypatch.setattr(prototype, "select_seeds", reverse_private_order)
+        out = tmp_path / name
+        report = prototype.run_evidence(out, base_seed=20261023, racket_path=racket_path)
+        assert report["status"] == "pass", report
+        assert report["summary"]["python_mirror_matches"] == 16
+        public_files = {}
+        for episode in report["episodes"]:
+            path = out / episode["public_path"]
+            payload = path.read_bytes()
+            challenge = json.loads(payload)
+            identity = public_challenge_id(challenge)
+            assert path.name == identity + ".json"
+            assert payload == public_challenge_bytes(challenge)
+            assert hashlib.sha256(payload).hexdigest() == identity
+            assert episode["public_id"] == episode["public_sha256"] == identity
+            assert set(challenge) == {"train", "test"}
+            assert len(challenge["train"]) == 3
+            assert len(challenge["test"]) == 1
+            assert set(challenge["test"][0]) == {"input"}
+            private = json.loads((out / episode["private_path"]).read_text())
+            assert private["public_id"] == identity
+            assert private["public_sha256"] == identity
+            assert private["public_path"] == episode["public_path"]
+            public_files[episode["public_path"]] = payload
+        manifest = json.loads((out / "manifest.json").read_text())
+        assert public_write_order == sorted(path.name for path in (out / "public").iterdir())
+        assert manifest["public_challenges"] == sorted(public_files)
+        assert set(manifest["public_challenges"]) == set(public_files)
+        assert {p.relative_to(out).as_posix() for p in (out / "public").iterdir()} == set(public_files)
+        exported.append(public_files)
+    assert exported[0] == exported[1]
+
+
+def test_private_query_labels_do_not_change_public_bytes_or_identity():
+    inputs = prototype.sample_inputs(20261023)
+    pairs = [{"input": grid, "output": prototype.python_mirror(grid, 2)} for grid in inputs]
+    for query_index in range(prototype.PAIR_COUNT):
+        original = prototype.public_challenge(pairs, query_index)
+        altered = deepcopy(pairs)
+        altered[query_index]["output"] = [[9]]
+        altered[query_index]["seed"] = 987654321
+        altered[query_index]["parameters"] = {"lattice_period": 3}
+        altered[query_index]["program"] = "private-only-replacement"
+        changed = prototype.public_challenge(altered, query_index)
+        assert public_challenge_bytes(original) == public_challenge_bytes(changed)
+        assert public_challenge_id(original) == public_challenge_id(changed)
+        assert len(changed["train"]) == 3
+        assert changed["test"] == [{"input": inputs[query_index]}]
