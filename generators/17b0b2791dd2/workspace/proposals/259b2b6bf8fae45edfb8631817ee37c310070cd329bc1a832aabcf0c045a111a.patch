+#!/usr/bin/env python3
+"""Bounded fixed-transform lesson audit for task 1d2e86233750.
+
+The probe accepts ``--source`` so a frozen baseline and the repaired generator
+can be compared with identical logic.  It uses an independent panel extractor,
+checks consecutive three-demo/one-query windows against four fixed-transform
+rivals, and optionally replays labels through the protected Racket bridge.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import types
+
+TASK_ID = "1d2e86233750"
+REPO = Path(__file__).resolve().parents[3]
+
+
+def _components(grid, color):
+    height, width = len(grid), len(grid[0])
+    seen = set()
+    result = []
+    for row in range(height):
+        for col in range(width):
+            if grid[row][col] != color or (row, col) in seen:
+                continue
+            stack = [(row, col)]
+            seen.add((row, col))
+            cells = []
+            while stack:
+                current = stack.pop()
+                cells.append(current)
+                r, c = current
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    neighbor = r + dr, c + dc
+                    if (0 <= neighbor[0] < height and 0 <= neighbor[1] < width
+                            and neighbor not in seen and grid[neighbor[0]][neighbor[1]] == color):
+                        seen.add(neighbor)
+                        stack.append(neighbor)
+            result.append(cells)
+    return result
+
+
+def frame_boxes(grid):
+    boxes = []
+    for cells in _components(grid, 9):
+        rows = [row for row, _ in cells]
+        cols = [col for _, col in cells]
+        r1, r2, c1, c2 = min(rows), max(rows), min(cols), max(cols)
+        border = {(row, col) for row in range(r1, r2 + 1) for col in range(c1, c2 + 1)
+                  if row in (r1, r2) or col in (c1, c2)}
+        if set(cells) == border and r2 - r1 >= 2 and c2 - c1 >= 2:
+            boxes.append((r1, c1, r2, c2))
+    boxes.sort(key=lambda box: box[1])
+    if len(boxes) != 3:
+        raise ValueError(f"expected three rectangular color-9 frames, got {len(boxes)}")
+    return boxes
+
+
+def panel_inners(grid):
+    return [
+        [row[c1 + 1:c2] for row in grid[r1 + 1:r2]]
+        for r1, c1, r2, c2 in frame_boxes(grid)
+    ]
+
+
+def transform_grid(grid, code):
+    if code == 1:
+        return [list(row) for row in zip(*grid[::-1])]
+    if code == 2:
+        return [row[::-1] for row in grid[::-1]]
+    if code == 3:
+        return [row[::-1] for row in grid]
+    if code == 4:
+        return [row[:] for row in grid[::-1]]
+    raise ValueError("transform code must be 1..4")
+
+
+def infer_transform_code(grid):
+    first, second, _third = panel_inners(grid)
+    matches = [code for code in (1, 2, 3, 4) if transform_grid(first, code) == second]
+    if len(matches) != 1:
+        raise ValueError(f"A->B transform is not unique: {matches}")
+    return matches[0]
+
+
+def fixed_transform_output(grid, code):
+    return transform_grid(panel_inners(grid)[2], code)
+
+
+def oracle(grid):
+    return fixed_transform_output(grid, infer_transform_code(grid))
+
+
+def probe_windows(module, *, seed: int, starts: int):
+    if type(starts) is not int or starts < 1:
+        raise ValueError("starts must be a positive integer")
+    histogram = Counter()
+    ambiguous = []
+    self_check_rejections = 0
+    for difficulty in ("easy", "medium", "hard"):
+        grids = [module.generate(seed, index, difficulty=difficulty) for index in range(starts + 3)]
+        codes = [infer_transform_code(grid) for grid in grids]
+        outputs = [oracle(grid) for grid in grids]
+        self_check_rejections += sum(bool(module.self_check(grid)) for grid in grids)
+        for start in range(starts):
+            window_grids = grids[start:start + 4]
+            window_outputs = outputs[start:start + 4]
+            for code in codes[start:start + 4]:
+                histogram[str(code)] += 1
+            for fixed in (1, 2, 3, 4):
+                rival_outputs = [fixed_transform_output(grid, fixed) for grid in window_grids]
+                demo_refuted = any(rival_outputs[index] != window_outputs[index] for index in range(3))
+                query_disagrees = rival_outputs[3] != window_outputs[3]
+                if query_disagrees and not demo_refuted:
+                    ambiguous.append({
+                        "difficulty": difficulty,
+                        "start": start,
+                        "fixed_transform": fixed,
+                        "demo_codes": codes[start:start + 3],
+                        "query_code": codes[start + 3],
+                    })
+    return {
+        "lesson_windows": 3 * starts,
+        "demos_per_window": 3,
+        "queries_per_window": 1,
+        "transform_histogram": dict(sorted(histogram.items())),
+        "ambiguous_windows": ambiguous,
+        "self_check_rejections": self_check_rejections,
+    }
+
+
+def _load_source(path):
+    spec = importlib.util.spec_from_file_location("lesson_probe_generator_1d2e86233750", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_record():
+    for line in (REPO / "shared/data/canonical/puzzles.jsonl").read_text().splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            return row
+    raise KeyError(TASK_ID)
+
+
+def _normalize_grid(grid):
+    return [[int(value) for value in row] if isinstance(row, str) else list(row) for row in grid]
+
+
+def _canonical_pairs(record):
+    rows = []
+    for split in ("train", "test"):
+        pairs = record.get(split, [])
+        if isinstance(pairs, dict):
+            pairs = [pairs]
+        for pair in pairs:
+            rows.append({"input": _normalize_grid(pair["input"]), "output": _normalize_grid(pair["output"])})
+    return rows
+
+
+def _rule_application(rule, grid):
+    from puzzle_generators.rule_wrap import wrap_rule
+    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+    return f"({wrap_rule(rule)} {literal})"
+
+
+
+def exit_code(passed: bool, *, allow_findings: bool) -> int:
+    """Return success for an evidence-producing baseline when explicitly requested."""
+    return 0 if passed or allow_findings else 1
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=REPO / f"generators/{TASK_ID}/generator.py")
+    parser.add_argument("--seed", type=int, default=731)
+    parser.add_argument("--starts", type=int, default=32)
+    parser.add_argument("--racket-limit", type=int, default=24)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--allow-findings", action="store_true",
+                        help="write a failing baseline report but return exit status 0")
+    args = parser.parse_args()
+    if args.racket_limit < 0:
+        parser.error("--racket-limit must be nonnegative")
+    source = args.source.resolve()
+    module = _load_source(source)
+    report = probe_windows(module, seed=args.seed, starts=args.starts)
+    record = _canonical_record()
+    canonical = _canonical_pairs(record)
+    report.update({
+        "task_id": TASK_ID,
+        "generator_path": str(source),
+        "generator_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+        "generator_version": getattr(module, "VERSION", None),
+        "canonical_pairs": len(canonical),
+        "rule_sha256": hashlib.sha256(record["program_solution"].encode()).hexdigest(),
+        "finite_rivals": [f"fixed_transform_{code}" for code in (1, 2, 3, 4)],
+        "limits": "Consecutive three-demo/one-query windows and four fixed-transform rivals only; not universal induction.",
+    })
+    cases = []
+    if args.racket_limit:
+        sys.path.insert(0, str(REPO / "shared/runtime"))
+        scripts = types.ModuleType("scripts")
+        scripts.__path__ = [str(REPO / "shared/tools")]
+        sys.modules.setdefault("scripts", scripts)
+        from arc_repl.racket_bridge import RacketBridge
+        checked = 0
+        with RacketBridge() as bridge:
+            for pair in canonical:
+                actual = bridge.eval_text(_rule_application(record["program_solution"], pair["input"]))
+                if actual != pair["output"] or actual != oracle(pair["input"]):
+                    raise AssertionError("canonical protected-Racket mismatch")
+                checked += 1
+            for difficulty in ("easy", "medium", "hard"):
+                for index in range(args.racket_limit):
+                    grid = module.generate(args.seed, index, difficulty=difficulty)
+                    actual = bridge.eval_text(_rule_application(record["program_solution"], grid))
+                    expected = oracle(grid)
+                    if actual != expected:
+                        raise AssertionError((difficulty, index, "protected-Racket mismatch"))
+                    if len(cases) < 12:
+                        cases.append({
+                            "difficulty": difficulty,
+                            "sample_index": index,
+                            "transform_code": infer_transform_code(grid),
+                            "input": grid,
+                            "racket_output": actual,
+                        })
+                    checked += 1
+            report["runtime_identity"] = bridge.runtime_identity
+        report["racket_evaluations"] = checked
+    report["passed"] = not report["ambiguous_windows"] and report["self_check_rejections"] == 0
+    args.out.mkdir(parents=True, exist_ok=False)
+    (args.out / "report.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    (args.out / "sample_cases.json").write_text(json.dumps(cases, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({key: value for key, value in report.items() if key != "runtime_identity"}, sort_keys=True))
+    return exit_code(report["passed"], allow_findings=args.allow_findings)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
