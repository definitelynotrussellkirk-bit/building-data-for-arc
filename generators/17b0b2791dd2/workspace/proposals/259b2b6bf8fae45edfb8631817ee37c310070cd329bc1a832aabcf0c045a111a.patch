@@ -0,0 +1,59 @@
+from __future__ import annotations
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "1d2e86233750"
+ROOT = find_root(__file__)
+GENERATOR, _SOURCE, _SHA = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _transform_code(grid) -> int:
+    boxes = GENERATOR._frame_boxes_for_self_check(grid)
+    assert len(boxes) == 3
+    n = boxes[0][2] - boxes[0][0] - 1
+    inners = []
+    for r1, c1, r2, c2, _count in boxes:
+        inners.append(
+            [
+                (row - r1 - 1, col - c1 - 1)
+                for row in range(r1 + 1, r2)
+                for col in range(c1 + 1, c2)
+                if grid[row][col] != 0
+            ]
+        )
+    matches = [
+        code
+        for code in (1, 2, 3, 4)
+        if set(GENERATOR._xform(inners[0], code, n)) == set(inners[1])
+    ]
+    assert len(matches) == 1
+    return matches[0]
+
+
+def test_transform_code_cycles_constructively_across_sample_indices():
+    for difficulty in ("easy", "medium", "hard"):
+        for sample_index in range(16):
+            grid = GENERATOR.generate(20261025, sample_index, difficulty=difficulty)
+            assert _transform_code(grid) == 1 + sample_index % 4
+            assert GENERATOR.self_check(grid) == []
+
+
+def test_no_three_demo_window_admits_a_fixed_transform_query_failure():
+    for difficulty in ("easy", "medium", "hard"):
+        codes = [
+            _transform_code(GENERATOR.generate(731, sample_index, difficulty=difficulty))
+            for sample_index in range(35)
+        ]
+        for start in range(32):
+            demos = codes[start : start + 3]
+            query = codes[start + 3]
+            for fixed_code in (1, 2, 3, 4):
+                demo_refuted = any(code != fixed_code for code in demos)
+                query_agrees = query == fixed_code
+                assert demo_refuted or query_agrees, (
+                    difficulty,
+                    start,
+                    fixed_code,
+                    demos,
+                    query,
+                )
