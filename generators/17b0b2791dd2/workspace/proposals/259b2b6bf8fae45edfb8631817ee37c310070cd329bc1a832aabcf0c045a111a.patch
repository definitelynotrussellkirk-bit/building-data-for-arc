+from __future__ import annotations
+
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "20eea223d645"
+ROOT = find_root(__file__)
+GENERATOR, _SOURCE, _SHA = load_selected_generator(TASK_ID, root=ROOT)
+
+DIRECTIONS = {
+    "horizontal": (0, 1),
+    "vertical": (1, 0),
+    "anti_diagonal": (1, -1),
+}
+
+
+def _exact_runs(grid, dr: int, dc: int) -> list[list[tuple[int, int]]]:
+    height, width = len(grid), len(grid[0])
+    red = {(r, c) for r in range(height) for c in range(width) if grid[r][c] == 2}
+    runs = []
+    for row, col in sorted(red):
+        if (row - dr, col - dc) in red or (row + dr, col + dc) not in red:
+            continue
+        if (row + 2 * dr, col + 2 * dc) in red:
+            continue
+        runs.append([(row, col), (row + dr, col + dc)])
+    return runs
+
+
+def _orientation_decoys(grid) -> dict[str, list[list[tuple[int, int]]]]:
+    return {name: _exact_runs(grid, dr, dc) for name, (dr, dc) in DIRECTIONS.items()}
+
+
+def _canonical_mirror(grid):
+    out = [row[:] for row in grid]
+    for cells in _exact_runs(grid, 1, 1):
+        for row, col in cells:
+            out[row][col] = 8
+    return out
+
+
+def _size_two_component_rival(grid):
+    out = [row[:] for row in grid]
+    height, width = len(grid), len(grid[0])
+    red = {(r, c) for r in range(height) for c in range(width) if grid[r][c] == 2}
+    seen = set()
+    for start in sorted(red):
+        if start in seen:
+            continue
+        stack = [start]
+        seen.add(start)
+        component = []
+        while stack:
+            row, col = stack.pop()
+            component.append((row, col))
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    if dr == dc == 0:
+                        continue
+                    neighbor = row + dr, col + dc
+                    if neighbor in red and neighbor not in seen:
+                        seen.add(neighbor)
+                        stack.append(neighbor)
+        if len(component) == 2:
+            for row, col in component:
+                out[row][col] = 8
+    return out
+
+
+def test_every_ordinary_draw_contains_an_orientation_decoy():
+    expected = ("horizontal", "vertical", "anti_diagonal")
+    for difficulty in ("easy", "medium", "hard"):
+        for sample_index in range(12):
+            grid = GENERATOR.generate(20261025, sample_index, difficulty=difficulty)
+            decoys = _orientation_decoys(grid)
+            assert decoys[expected[sample_index % 3]], (
+                difficulty,
+                sample_index,
+                {name: len(rows) for name, rows in decoys.items()},
+            )
+
+
+def test_component_size_two_shortcut_is_refuted_on_every_draw():
+    for difficulty in ("easy", "medium", "hard"):
+        for sample_index in range(12):
+            grid = GENERATOR.generate(99173, sample_index, difficulty=difficulty)
+            assert _size_two_component_rival(grid) != _canonical_mirror(grid)
+
+
+def test_orientation_decoys_remain_red_under_canonical_rule():
+    for sample_index in range(9):
+        grid = GENERATOR.generate(431, sample_index, difficulty="medium")
