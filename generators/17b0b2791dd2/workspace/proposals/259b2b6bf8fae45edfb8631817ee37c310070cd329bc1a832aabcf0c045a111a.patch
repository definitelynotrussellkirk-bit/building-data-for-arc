+#!/usr/bin/env python3
+"""Source-bound orientation-decoy and size-two-component shortcut probe.
+
+A frozen baseline may be supplied with ``--source``.  The probe checks ordinary
+samples, a lawful self-check-accepted adversarial query, and protected Racket
+labels.  It is intentionally bounded to one named shortcut and three bands.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import types
+
+TASK_ID = "20eea223d645"
+REPO = Path(__file__).resolve().parents[3]
+DIRECTIONS = {
+    "horizontal": (0, 1),
+    "vertical": (1, 0),
+    "anti_diagonal": (1, -1),
+}
+
+
+def exact_runs(grid, dr, dc):
+    height, width = len(grid), len(grid[0])
+    red = {(row, col) for row in range(height) for col in range(width) if grid[row][col] == 2}
+    runs = []
+    for row, col in sorted(red):
+        if (row - dr, col - dc) in red or (row + dr, col + dc) not in red:
+            continue
+        if (row + 2 * dr, col + 2 * dc) in red:
+            continue
+        runs.append([(row, col), (row + dr, col + dc)])
+    return runs
+
+
+def canonical_output(grid):
+    out = [row[:] for row in grid]
+    for run in exact_runs(grid, 1, 1):
+        for row, col in run:
+            out[row][col] = 8
+    return out
+
+
+def component_size_two_output(grid):
+    out = [row[:] for row in grid]
+    height, width = len(grid), len(grid[0])
+    red = {(row, col) for row in range(height) for col in range(width) if grid[row][col] == 2}
+    seen = set()
+    for start in sorted(red):
+        if start in seen:
+            continue
+        stack = [start]
+        seen.add(start)
+        component = []
+        while stack:
+            row, col = stack.pop()
+            component.append((row, col))
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    if dr == dc == 0:
+                        continue
+                    neighbor = row + dr, col + dc
+                    if neighbor in red and neighbor not in seen:
+                        seen.add(neighbor)
+                        stack.append(neighbor)
+        if len(component) == 2:
+            for row, col in component:
+                out[row][col] = 8
+    return out
+
+
+def adversarial_query():
+    grid = [[0] * 9 for _ in range(8)]
+    grid[1][1] = 2
+    grid[2][2] = 2
+    grid[5][4] = 2
+    grid[5][5] = 2
+    grid[1][7] = 2
+    grid[2][7] = 2
+    grid[3][7] = 2
+    return grid
+
+
+def orientation_counts(grid):
+    return {name: len(exact_runs(grid, dr, dc)) for name, (dr, dc) in DIRECTIONS.items()}
+
+
+def census(module, *, seed: int, per_band: int):
+    if type(per_band) is not int or per_band < 1:
+        raise ValueError("per_band must be a positive integer")
+    histogram = Counter()
+    shortcut_matches = 0
+    self_check_rejections = 0
+    draws = 0
+    for difficulty in ("easy", "medium", "hard"):
+        for index in range(per_band):
+            grid = module.generate(seed, index, difficulty=difficulty)
+            draws += 1
+            self_check_rejections += bool(module.self_check(grid))
+            counts = orientation_counts(grid)
+            for name, count in counts.items():
+                histogram[name] += int(count > 0)
+            shortcut_matches += component_size_two_output(grid) == canonical_output(grid)
+    return {
+        "draws": draws,
+        "component_shortcut_matches": shortcut_matches,
+        "self_check_rejections": self_check_rejections,
+        "orientation_decoy_histogram": dict(sorted(histogram.items())),
+    }
+
+
+def _load_source(path):
+    spec = importlib.util.spec_from_file_location("orientation_probe_generator_20eea223d645", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_record():
+    for line in (REPO / "shared/data/canonical/puzzles.jsonl").read_text().splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            return row
+    raise KeyError(TASK_ID)
+
+
+def _normalize_grid(grid):
+    return [[int(value) for value in row] if isinstance(row, str) else list(row) for row in grid]
+
+
+def _canonical_pairs(record):
+    rows = []
+    for split in ("train", "test"):
+        pairs = record.get(split, [])
+        if isinstance(pairs, dict):
+            pairs = [pairs]
+        for pair in pairs:
+            rows.append({"input": _normalize_grid(pair["input"]), "output": _normalize_grid(pair["output"])})
+    return rows
+
+
+def _rule_application(rule, grid):
+    from puzzle_generators.rule_wrap import wrap_rule
+    literal = "'(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+    return f"({wrap_rule(rule)} {literal})"
+
+
+
+def exit_code(passed: bool, *, allow_findings: bool) -> int:
+    """Return success for an evidence-producing baseline when explicitly requested."""
+    return 0 if passed or allow_findings else 1
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=REPO / f"generators/{TASK_ID}/generator.py")
+    parser.add_argument("--seed", type=int, default=518)
+    parser.add_argument("--per-band", type=int, default=40)
+    parser.add_argument("--racket-limit", type=int, default=24)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--allow-findings", action="store_true",
+                        help="write a failing baseline report but return exit status 0")
+    args = parser.parse_args()
+    if args.racket_limit < 0:
+        parser.error("--racket-limit must be nonnegative")
+    source = args.source.resolve()
+    module = _load_source(source)
+    report = census(module, seed=args.seed, per_band=args.per_band)
+    adversary = adversarial_query()
+    if module.self_check(adversary):
+        raise AssertionError("adversarial query is rejected by self_check")
+    report.update({
+        "task_id": TASK_ID,
+        "generator_path": str(source),
+        "generator_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+        "generator_version": getattr(module, "VERSION", None),
+        "adversarial_query_shortcut_disagrees": component_size_two_output(adversary) != canonical_output(adversary),
+        "finite_rival": "recolor every 8-connected red component of size two",
+        "limits": "One named component-size shortcut, one adversarial query, and easy/medium/hard samples only.",
+    })
+    record = _canonical_record()
+    canonical = _canonical_pairs(record)
+    report["canonical_pairs"] = len(canonical)
+    report["canonical_shortcut_matches"] = sum(
+        component_size_two_output(pair["input"]) == pair["output"] for pair in canonical
+    )
+    report["rule_sha256"] = hashlib.sha256(record["program_solution"].encode()).hexdigest()
+    # Treat the lawful adversarial input as the query after every consecutive
+    # three-demo window.  This directly measures whether visible demos refute
+    # the shortcut before it reaches that query.
+    ambiguous = []
+    for difficulty in ("easy", "medium", "hard"):
+        for start in range(args.per_band):
+            demos = [module.generate(args.seed, start + offset, difficulty=difficulty) for offset in range(3)]
+            if (all(component_size_two_output(grid) == canonical_output(grid) for grid in demos)
+                    and component_size_two_output(adversary) != canonical_output(adversary)):
+                ambiguous.append({"difficulty": difficulty, "start": start})
+    report["adversarial_query_ambiguous_windows"] = ambiguous
+    cases = []
+    if args.racket_limit:
+        sys.path.insert(0, str(REPO / "shared/runtime"))
+        scripts = types.ModuleType("scripts")
+        scripts.__path__ = [str(REPO / "shared/tools")]
+        sys.modules.setdefault("scripts", scripts)
+        from arc_repl.racket_bridge import RacketBridge
+        checked = 0
+        with RacketBridge() as bridge:
+            for pair in canonical:
+                actual = bridge.eval_text(_rule_application(record["program_solution"], pair["input"]))
+                if actual != pair["output"] or actual != canonical_output(pair["input"]):
+                    raise AssertionError("canonical protected-Racket mismatch")
+                checked += 1
+            for difficulty in ("easy", "medium", "hard"):
+                for index in range(args.racket_limit):
+                    grid = module.generate(args.seed, index, difficulty=difficulty)
+                    actual = bridge.eval_text(_rule_application(record["program_solution"], grid))
+                    expected = canonical_output(grid)
+                    if actual != expected:
+                        raise AssertionError((difficulty, index, "protected-Racket mismatch"))
+                    if len(cases) < 12:
+                        cases.append({
+                            "difficulty": difficulty,
+                            "sample_index": index,
+                            "orientation_decoys": orientation_counts(grid),
+                            "input": grid,
+                            "racket_output": actual,
+                            "component_shortcut_output": component_size_two_output(grid),
+                        })
+                    checked += 1
+            adversarial_actual = bridge.eval_text(_rule_application(record["program_solution"], adversary))
+            if adversarial_actual != canonical_output(adversary):
+                raise AssertionError("adversarial protected-Racket mismatch")
+            checked += 1
+            report["runtime_identity"] = bridge.runtime_identity
+        report["racket_evaluations"] = checked
+        cases.append({
+            "name": "lawful_orientation_decoy_adversary",
+            "input": adversary,
+            "racket_output": canonical_output(adversary),
+            "component_shortcut_output": component_size_two_output(adversary),
+            "self_check": module.self_check(adversary),
+        })
+    report["passed"] = (
+        report["self_check_rejections"] == 0
+        and report["component_shortcut_matches"] == 0
+        and not report["adversarial_query_ambiguous_windows"]
+        and report["adversarial_query_shortcut_disagrees"]
+    )
+    args.out.mkdir(parents=True, exist_ok=False)
+    (args.out / "report.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    (args.out / "cases.json").write_text(json.dumps(cases, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({key: value for key, value in report.items() if key != "runtime_identity"}, sort_keys=True))
+    return exit_code(report["passed"], allow_findings=args.allow_findings)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
