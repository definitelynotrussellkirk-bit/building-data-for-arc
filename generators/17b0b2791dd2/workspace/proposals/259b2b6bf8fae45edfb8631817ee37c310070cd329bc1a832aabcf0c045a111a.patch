+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "1d2e86233750"
+ROOT = find_root(__file__)
+GENERATOR, _SOURCE, _SHA = load_selected_generator(TASK_ID, root=ROOT)
+PROBE_PATH = ROOT / f"generators/{TASK_ID}/workspace/lesson_probe.py"
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("probe_1d2e86233750", PROBE_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_probe_reports_no_fixed_transform_ambiguity_after_repair():
+    probe = _load_probe()
+    report = probe.probe_windows(GENERATOR, seed=418, starts=16)
+    assert report["lesson_windows"] == 48
+    assert report["ambiguous_windows"] == []
+    assert report["transform_histogram"] == {"1": 48, "2": 48, "3": 48, "4": 48}
+
+
+def test_independent_oracle_applies_inferred_transform_to_c():
+    probe = _load_probe()
+    for sample_index in range(8):
+        grid = GENERATOR.generate(73, sample_index, difficulty="medium")
+        code = probe.infer_transform_code(grid)
+        assert code == 1 + sample_index % 4
+        expected = probe.oracle(grid)
+        fixed = probe.fixed_transform_output(grid, code)
+        assert expected == fixed
+
+
+def test_allow_findings_controls_probe_exit_code():
+    probe = _load_probe()
+    assert probe.exit_code(True, allow_findings=False) == 0
+    assert probe.exit_code(False, allow_findings=True) == 0
+    assert probe.exit_code(False, allow_findings=False) == 1
