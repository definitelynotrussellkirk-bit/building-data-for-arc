+# Semantic-gate declarations.  These do not alter generation or the selected
+# Racket authority; they make the source-bound teaching contract executable.
+EXAMPLES_NEEDED = 3
+MIN_STRICT_FRAC = 1.0
+
+
+def strict_canonical_like(grid):
+    """All canonical and generated inputs share the exact ``self_check`` grammar."""
+    return self_check(grid)
+
+
+def _right_profile_for_columns(grid):
+    """Plausible shortcut: incorrectly reuse the right profile on both axes."""
+    errors = self_check(grid)
+    if errors:
+        raise ValueError("invalid scene: " + "; ".join(errors))
+    scene = _analyze_scene(grid)
+    source = scene["grid"]
+    right = scene["right"]
+    n = scene["n"]
+    return [
+        [
+            source[r][c]
+            if source[r][c] != 0
+            else right[r]
+            if right[r] == right[c]
+            else 0
+            for c in range(n)
+        ]
+        for r in range(n)
+    ]
+
+
+def _bottom_profile_for_rows(grid):
+    """Plausible shortcut: incorrectly reuse the bottom profile on both axes."""
+    errors = self_check(grid)
+    if errors:
+        raise ValueError("invalid scene: " + "; ".join(errors))
+    scene = _analyze_scene(grid)
+    source = scene["grid"]
+    bottom = scene["bottom"]
+    n = scene["n"]
+    return [
+        [
+            source[r][c]
+            if source[r][c] != 0
+            else bottom[r]
+            if bottom[r] == bottom[c]
+            else 0
+            for c in range(n)
+        ]
+        for r in range(n)
+    ]
+
+
+def _fill_every_row_label(grid):
+    """Overgeneralization that ignores the column label entirely."""
+    errors = self_check(grid)
+    if errors:
+        raise ValueError("invalid scene: " + "; ".join(errors))
+    scene = _analyze_scene(grid)
+    source = scene["grid"]
+    right = scene["right"]
+    n = scene["n"]
+    return [
+        [source[r][c] if source[r][c] != 0 else right[r] for c in range(n)]
+        for r in range(n)
+    ]
+
+
+def _fill_every_column_label(grid):
+    """Overgeneralization that ignores the row label entirely."""
+    errors = self_check(grid)
+    if errors:
+        raise ValueError("invalid scene: " + "; ".join(errors))
+    scene = _analyze_scene(grid)
+    source = scene["grid"]
+    bottom = scene["bottom"]
+    n = scene["n"]
+    return [
+        [source[r][c] if source[r][c] != 0 else bottom[c] for c in range(n)]
+        for r in range(n)
+    ]
+
+
+def _diagonal_only(grid):
+    """Position shortcut that paints only the main diagonal."""
+    errors = self_check(grid)
+    if errors:
+        raise ValueError("invalid scene: " + "; ".join(errors))
+    scene = _analyze_scene(grid)
+    source = scene["grid"]
+    right = scene["right"]
+    n = scene["n"]
+    return [
+        [
+            source[r][c]
+            if source[r][c] != 0
+            else right[r]
+            if r == c
+            else 0
+            for c in range(n)
+        ]
+        for r in range(n)
+    ]
+
+
+def _matched_partitions_witness(grid):
+    try:
+        return not self_check(grid) and _analyze_scene(grid)["border_relation"] == "matched"
+    except (TypeError, ValueError, IndexError):
+        return False
+
+
+def _asymmetric_partitions_witness(grid):
+    try:
+        return not self_check(grid) and _analyze_scene(grid)["border_relation"] == "different"
+    except (TypeError, ValueError, IndexError):
+        return False
+
+
+SEMANTIC_RIVALS = {
+    "right_profile_for_columns": _right_profile_for_columns,
+    "bottom_profile_for_rows": _bottom_profile_for_rows,
+}
+SEMANTIC_WITNESSES = {
+    "matched_partitions": _matched_partitions_witness,
+    "asymmetric_partitions": _asymmetric_partitions_witness,
+}
+WITNESS_RIVALS = {
+    "asymmetric_partitions": [
+        "right_profile_for_columns",
+        "bottom_profile_for_rows",
+    ]
+}
+BRANCH_WITNESSES = tuple(SEMANTIC_WITNESSES)
+LESSON_COMPETITORS = {
+    "fill_every_row_label": _fill_every_row_label,
+    "fill_every_column_label": _fill_every_column_label,
+    "diagonal_only": _diagonal_only,
+}
+CANONICAL_SHORTCUTS = {}
+
+
+def _semantic_pair_errors(pair, label):
+    if not isinstance(pair, dict) or "input" not in pair or "output" not in pair:
+        return [f"{label} must contain input and output grids"]
+    errors = strict_canonical_like(pair["input"])
+    if errors:
+        return [f"{label} input is invalid: {errors[0]}"]
+    if pair["output"] != rule_mirror(pair["input"]):
+        return [f"{label} output disagrees with the row-column label rule"]
+    return []
+
+
+def lesson_identifiable(demos, query):
+    """Reject malformed labels and any declared rival that changes the query.
+
+    A rival that fits all demonstrations but gives the same query answer is
+    answer-equivalent for that lesson, not an ambiguity.  The three declared
+    lesson competitors are deliberately refuted by every lawful demonstration;
+    the asymmetric-profile shortcuts are tested separately by their witness.
+    """
+    if not isinstance(demos, (list, tuple)) or len(demos) < EXAMPLES_NEEDED:
+        return [f"lesson needs at least {EXAMPLES_NEEDED} demonstrations"]
+    reasons = []
+    for index, pair in enumerate(demos):
+        reasons.extend(_semantic_pair_errors(pair, f"demonstration {index}"))
+    reasons.extend(_semantic_pair_errors(query, "query"))
+    if reasons:
+        return reasons
+
+    for name, rival in LESSON_COMPETITORS.items():
+        try:
+            fits_demos = all(
+                rival(pair["input"]) == pair["output"] for pair in demos
+            )
+            changes_query = rival(query["input"]) != query["output"]
+        except Exception as exc:
+            reasons.append(
+                f"declared competitor {name} raised {type(exc).__name__}: {exc}"
+            )
+            continue
+        if fits_demos and changes_query:
+            reasons.append(
+                f"declared competitor {name} fits every demonstration and changes the query"
+            )
+    return reasons
