+"""Bounded finite-rival teaching probe; Python screening plus protected Racket witness replay."""
+from pathlib import Path
+import hashlib, json, sys
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT/'shared/runtime'))
+from reviewer_support import load_selected_generator, canonical_path
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+TID='59a7762bc6da'
+m, source, sha = load_selected_generator(TID, root=ROOT)
+OUT=ROOT.parent/'checks'/TID
+OUT.mkdir(parents=True,exist_ok=True)
+
+def rival(g, kind):
+    pts={(r,c) for r,row in enumerate(g) for c,v in enumerate(row) if v==5}
+    out=[row[:] for row in g]
+    threshold=2 if kind=='threshold_two' else 3
+    dirs=((1,1),) if kind=='down_right_only' else ((1,1),(1,-1))
+    qualifying=set()
+    for r,c in pts:
+        for dr,dc in dirs:
+            segment={(r+i*dr,c+i*dc) for i in range(threshold)}
+            if segment <= pts: qualifying.update(segment)
+    if kind!='diagonal_cells_only':
+        remaining=set(pts)
+        while remaining:
+            stack=[remaining.pop()]; comp=set(stack)
+            while stack:
+                r,c=stack.pop()
+                neighbors={(r+dr,c+dc) for dr in (-1,0,1) for dc in (-1,0,1)} & remaining
+                remaining-=neighbors; comp|=neighbors; stack.extend(neighbors)
+            if comp & qualifying: qualifying|=comp
+    for r,c in qualifying: out[r][c]=8
+    return out
+
+names=['diagonal_cells_only','down_right_only','threshold_two']
+counts={name:0 for name in names}; witnesses={}; skipped=0; errors=[]
+for seed in range(20):
+    pairs=[]; seen=set()
+    for idx in range(30):
+        try:
+            g=m.generate(seed,idx,difficulty='medium')
+            out=m.rule_mirror(g)
+        except Exception as exc:
+            errors.append({'seed':seed,'sample_index':idx,'error':repr(exc)}); continue
+        key=json.dumps([g,out])
+        if key in seen: skipped+=1; continue
+        seen.add(key)
+        pairs.append({'sample_index':idx,'profile':m.observe_overrides(g)['scene_profile'],'input':g,'output':out})
+        if len(pairs)==5: break
+    if len(pairs)!=5: raise RuntimeError('too few distinct pairs')
+    for name in names:
+        if all(rival(p['input'],name)==p['output'] for p in pairs[:3]):
+            wrong=[i for i in (3,4) if rival(pairs[i]['input'],name)!=pairs[i]['output']]
+            if wrong:
+                counts[name]+=1
+                if name not in witnesses:
+                    witnesses[name]={'seed':seed,'difficulty':'medium','demos':pairs[:3],'queries':pairs[3:],'wrong_query_indices':[i-3 for i in wrong],'rival_predictions':[rival(p['input'],name) for p in pairs]}
+row=next(json.loads(line) for line in canonical_path(ROOT).read_text().splitlines() if json.loads(line).get('task_id')==TID)
+rule=row['program_solution']; wrapped=wrap_rule(rule)
+selected=next(iter(witnesses.values()),None)
+replay=[]; identity=None
+if selected:
+    with RacketBridge(timeout=20) as bridge:
+        identity=bridge.runtime_identity
+        for pair in selected['demos']+selected['queries']:
+            sexpr="'("+' '.join('('+' '.join(map(str,row))+')' for row in pair['input'])+')'
+            actual=bridge.eval_text(f'({wrapped} {sexpr})')
+            replay.append({'sample_index':pair['sample_index'],'output':actual,'matches_diagnostic':actual==pair['output']})
+    assert all(p['matches_diagnostic'] for p in replay),replay
+report={'task_id':TID,'generator_sha256':sha,'probe_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'canonical_rule':rule,'canonical_rule_sha256':hashlib.sha256(rule.encode()).hexdigest(),'rule_hash':hashlib.sha256(' '.join(rule.split()).encode()).hexdigest()[:12],'scope':{'seeds':list(range(20)),'difficulty':'medium','demos':3,'queries':2,'sampling':'contiguous sample indices from zero, duplicate pair skipped','rivals':names,'screening_labels':'Python rule_mirror, diagnostic only'},'teaching_hole_counts':counts,'skipped_duplicate_pairs':skipped,'generation_errors':errors,'witnesses':witnesses,'racket_verified_rival':next(iter(witnesses),None),'racket_replay':replay,'racket_identity':identity,'limits':'Only the first retained rival witness (five pairs) was executed in Racket. Counts and other witnesses are finite Python screening; no broad qualification or approval is claimed.'}
+(OUT/'peer_probe.json').write_text(json.dumps(report,indent=2)+'\n')
+print(json.dumps({'generator_sha256':sha,'counts':counts,'first_witness_seed':selected['seed'] if selected else None,'racket_pairs':len(replay),'racket_match':all(p['matches_diagnostic'] for p in replay),'errors':errors,'out':str(OUT/'peer_probe.json')}))
