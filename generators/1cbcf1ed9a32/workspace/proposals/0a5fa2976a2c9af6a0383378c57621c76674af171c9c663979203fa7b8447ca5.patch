+++ b/repo/generators/ad0970c37953/workspace/adversarial_tie_colour.py
@@ -0,0 +1,195 @@
+#!/usr/bin/env python3
+"""Bounded lesson audit for colour-based equal-area tie-break shortcuts.
+
+The intended rule breaks equal-area ties by top row and then left column.  A
+three-demonstration lesson currently contains only one tie profile, so one of
+these two fixed rivals can survive that lesson:
+
+* descending area, then ascending colour;
+* descending area, then descending colour.
+
+This probe looks for a later tie query on which the surviving fixed rival
+changes the answer.  It does not claim exhaustive unlearnability.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Iterable, Sequence
+
+from reviewer_support import find_root, load_selected_generator
+
+
+gen, _GENERATOR_SOURCE, _GENERATOR_SHA256 = load_selected_generator(
+    "ad0970c37953", root=find_root(__file__)
+)
+
+
+def colour_tie_break(grid: list[list[int]], *, descending: bool) -> list[list[int]]:
+    """Apply the intended area ordering but use colour for equal-area ties."""
+    analysis = gen._analysis(grid)
+    if analysis.get("errors"):
+        raise ValueError(f"malformed input: {analysis['errors']}")
+
+    def key(component: dict) -> tuple[int, int, int, int]:
+        colour_key = -component["colour"] if descending else component["colour"]
+        return (
+            -component["area"],
+            colour_key,
+            component["bbox"][0],
+            component["bbox"][1],
+        )
+
+    components = sorted(analysis["components"], key=key)
+    return gen._render_bars(
+        [(component["colour"], component["area"]) for component in components]
+    )
+
+
+def _tie_groups(grid: list[list[int]]) -> list[dict]:
+    analysis = gen._analysis(grid)
+    groups: dict[int, list[dict]] = {}
+    for component in analysis["components"]:
+        groups.setdefault(component["area"], []).append(component)
+    result = []
+    for area, components in sorted(groups.items(), reverse=True):
+        if len(components) < 2:
+            continue
+        intended = sorted(components, key=lambda c: (c["bbox"][0], c["bbox"][1]))
+        result.append(
+            {
+                "area": area,
+                "intended_colours": [component["colour"] for component in intended],
+                "ascending_colour_order": sorted(component["colour"] for component in components),
+                "descending_colour_order": sorted(
+                    (component["colour"] for component in components), reverse=True
+                ),
+            }
+        )
+    return result
+
+
+def _source_sha256() -> str:
+    return _GENERATOR_SHA256
+
+
+def scan(
+    *,
+    seeds: Iterable[int],
+    starts: Iterable[int],
+    difficulties: Sequence[str] = ("easy", "medium", "hard"),
+) -> dict:
+    """Return a finite audit report and the first demo-surviving query witness."""
+    seed_values = [int(seed) for seed in seeds]
+    start_values = [int(start) for start in starts]
+    lessons_checked = 0
+    survivor_lessons = 0
+    ambiguous_query_lessons = 0
+    first_witness = None
+    direction_counts = {"ascending_colour": 0, "descending_colour": 0}
+
+    for difficulty in difficulties:
+        for seed in seed_values:
+            for start in start_values:
+                lessons_checked += 1
+                grids = [
+                    gen.generate(seed, start + offset, difficulty=difficulty)
+                    for offset in range(gen.EXAMPLES_NEEDED + 1)
+                ]
+                demos = [
+                    {"input": grid, "output": gen.rule_bar_gallery(grid)}
+                    for grid in grids[: gen.EXAMPLES_NEEDED]
+                ]
+                query_input = grids[-1]
+                intended_query_output = gen.rule_bar_gallery(query_input)
+
+                for name, descending in (
+                    ("ascending_colour", False),
+                    ("descending_colour", True),
+                ):
+                    survives = all(
+                        colour_tie_break(pair["input"], descending=descending)
+                        == pair["output"]
+                        for pair in demos
+                    )
+                    if not survives:
+                        continue
+                    survivor_lessons += 1
+                    direction_counts[name] += 1
+                    rival_query_output = colour_tie_break(
+                        query_input, descending=descending
+                    )
+                    if rival_query_output == intended_query_output:
+                        continue
+                    ambiguous_query_lessons += 1
+                    if first_witness is None:
+                        first_witness = {
+                            "difficulty": difficulty,
+                            "seed": seed,
+                            "start": start,
+                            "rival": name,
+                            "survives_all_demonstrations": True,
+                            "demonstrations": demos,
+                            "demo_tie_groups": [
+                                _tie_groups(pair["input"]) for pair in demos
+                            ],
+                            "query_input": query_input,
+                            "query_tie_groups": _tie_groups(query_input),
+                            "intended_query_output": intended_query_output,
+                            "rival_query_output": rival_query_output,
+                        }
+
+    return {
+        "schema": "arcpuzzles-bounded-tie-colour-audit-v1",
+        "task_id": gen.TASK_ID,
+        "generator_sha256": _source_sha256(),
+        "hypotheses": {
+            "ascending_colour": "sort by descending area, then ascending colour",
+            "descending_colour": "sort by descending area, then descending colour",
+        },
+        "seeds": seed_values,
+        "starts": start_values,
+        "difficulties": list(difficulties),
+        "lessons_checked": lessons_checked,
+        "surviving_hypothesis_lessons": survivor_lessons,
+        "ambiguous_query_lessons": ambiguous_query_lessons,
+        "direction_counts": direction_counts,
+        "first_witness": first_witness,
+        "limits": (
+            "Finite Python-mirror audit of two explicit colour tie-break rivals; "
+            "not an exhaustive hypothesis search and not a protected-Racket replay."
+        ),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seeds", type=int, default=64)
+    parser.add_argument("--max-start", type=int, default=58)
+    args = parser.parse_args()
+    if args.seeds < 1 or args.max_start < 1:
+        parser.error("--seeds and --max-start must be positive")
+    report = scan(
+        seeds=range(args.seeds),
+        starts=range(1, args.max_start + 1, 3),
+    )
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(
+        json.dumps(
+            {
+                "out": str(args.out),
+                "lessons_checked": report["lessons_checked"],
+                "surviving_hypothesis_lessons": report["surviving_hypothesis_lessons"],
+                "ambiguous_query_lessons": report["ambiguous_query_lessons"],
+            },
+            sort_keys=True,
+        )
+    )
+    return 0 if report["first_witness"] is not None else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
