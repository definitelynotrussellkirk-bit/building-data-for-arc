+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from reviewer_support import find_root
+
+
+def _probe_module():
+    path = (
+        find_root(__file__)
+        / "generators/ad0970c37953/workspace/adversarial_tie_colour.py"
+    )
+    spec = importlib.util.spec_from_file_location("ad0970c_tie_colour_probe", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_bounded_scan_finds_a_demo_surviving_colour_tie_break_that_fails_query():
+    probe = _probe_module()
+    report = probe.scan(
+        seeds=range(12),
+        starts=range(1, 20, 3),
+        difficulties=("easy", "medium", "hard"),
+    )
+    assert report["lessons_checked"] == 12 * 7 * 3
+    assert report["ambiguous_query_lessons"] > 0
+    witness = report["first_witness"]
+    assert witness is not None
+    assert witness["survives_all_demonstrations"] is True
+    assert witness["rival_query_output"] != witness["intended_query_output"]
diff --git a/repo/generators/ad0970c37953/workspace/adversarial_tie_colour.py b/repo/generators/ad0970c37953/workspace/adversarial_tie_colour.py
