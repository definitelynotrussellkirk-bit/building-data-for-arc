#lang racket
;; Standalone independent rule for the bounded proposed family. No ARC answers.
(require json racket/list)
(define (label grid paint)
  (define rows (list->vector (map list->vector grid)))
  (define H (vector-length rows))
  (define W (vector-length (vector-ref rows 0)))
  (define (at r c) (vector-ref (vector-ref rows r) c))
  (define visited (make-hash))
  (define components '())
  (for* ([r (in-range H)] [c (in-range W)])
    (unless (hash-has-key? visited (cons r c))
      (define color (at r c))
      (define cells '())
      (hash-set! visited (cons r c) #t)
      (let flood ([pending (list (cons r c))])
        (unless (null? pending)
          (define point (car pending))
          (set! cells (cons point cells))
          (define next (cdr pending))
          (for ([delta '((-1 0) (1 0) (0 -1) (0 1))])
            (define nr (+ (car point) (car delta)))
            (define nc (+ (cdr point) (cadr delta)))
            (define key (cons nr nc))
            (when (and (<= 0 nr) (< nr H) (<= 0 nc) (< nc W)
                       (not (hash-has-key? visited key)) (= (at nr nc) color))
              (hash-set! visited key #t)
              (set! next (cons key next))))
          (flood next)))
      (set! components (cons (cons color cells) components))))
  (define candidates
    (filter values
      (for/list ([component components])
        (define color (car component))
        (define cells (cdr component))
        (define top (apply min (map car cells)))
        (define bottom (apply max (map car cells)))
        (define left (apply min (map cdr cells)))
        (define right (apply max (map cdr cells)))
        (and (>= (- bottom top) 4) (>= (- right left) 4)
          (let ([fill (at (+ top 1) (+ left 1))])
            (and (not (= fill color))
              (for*/and ([r (in-range top (+ bottom 1))]
                         [c (in-range left (+ right 1))])
                (= (at r c) (if (or (= r top) (= r bottom) (= c left) (= c right)) color fill)))
              (list (* (+ 1 (- bottom top)) (+ 1 (- right left))) top left bottom right color fill)))))))
  (when (null? candidates) (error 'label "no qualifying frame"))
  (define sorted (sort candidates > #:key car))
  (when (and (> (length sorted) 1) (= (caar sorted) (caadr sorted)))
    (error 'label "ambiguous frame"))
  (define frame (car sorted))
  (define top (list-ref frame 1))
  (define left (list-ref frame 2))
  (define bottom (list-ref frame 3))
  (define right (list-ref frame 4))
  (define frame-color (list-ref frame 5))
  (define fill (list-ref frame 6))
  (define excluded (list (at 0 0) frame-color fill))
  (define rear (for*/list ([r (in-range H)] [c (in-range W)]
                          #:unless (member (at r c) excluded)) (list r c (at r c))))
  (define colors (remove-duplicates (map caddr rear)))
  (unless (= (length colors) 1) (error 'label "requires one rear palette"))
  (define color (car colors))
  (define rt (apply min (map car rear)))
  (define rb (apply max (map car rear)))
  (define rl (apply min (map cadr rear)))
  (define rr (apply max (map cadr rear)))
  (for/list ([r (in-range (+ top 1) bottom)])
    (for/list ([c (in-range (+ left 1) right)])
      (if (and (<= rt r rb) (<= rl c rr)
               (or (equal? paint "filled") (= r rt) (= r rb) (= c rl) (= c rr))) color fill))))
(module+ main
  (define request (read-json))
  (define paint (hash-ref request 'paint))
  (unless (member paint '("outline" "filled")) (error 'paint "unsupported paint"))
  (write-json (map (lambda (g) (label g paint)) (hash-ref request 'grids)))
  (newline))
