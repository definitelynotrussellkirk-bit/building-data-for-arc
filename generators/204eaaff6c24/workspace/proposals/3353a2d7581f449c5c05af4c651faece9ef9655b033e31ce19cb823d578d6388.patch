+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+TASK_ROOT = Path(__file__).resolve().parents[1]
+
+
+def _load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_absolute_grid_half_shortcut_fits_three_demos_but_fails_query():
+    generator = _load(TASK_ROOT / "generator.py", "g6143_probe_generator")
+    probe = _load(
+        TASK_ROOT / "workspace" / "absolute_half_shortcut_probe.py",
+        "g6143_absolute_half_probe",
+    )
+
+    lesson = probe.build_lesson(generator, seed=0, difficulty=None)
+    assert len(lesson["demonstrations"]) == 3
+    assert all(generator.self_check(pair["input"]) == [] for pair in lesson["demonstrations"])
+    assert generator.self_check(lesson["query"]["input"]) == []
+
+    assert all(
+        probe.absolute_half_output(pair["input"]) == pair["output"]
+        for pair in lesson["demonstrations"]
+    )
+    assert probe.absolute_half_output(lesson["query"]["input"]) != lesson["query"]["output"]
+    assert lesson["query"]["different_cells"]
+    assert lesson["query"]["block_relative_layout"] == "independent"
