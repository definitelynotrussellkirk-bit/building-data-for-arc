+            for pair in episode["train"] + episode["test"]:
+                literal = "'(" + " ".join(
+                    "(" + " ".join(map(str, row)) + ")" for row in pair["input"]
+                ) + ")"
+                actual = bridge.eval_text(f"({wrapped} {literal})")
+                assert actual == _oracle(pair["input"], mode)
