+#!/usr/bin/env python3
+"""Source-bound lesson probe for a fixed diagonal-orientation shortcut.
+
+The canonical rule completes a rectangle border from either diagonal pair.
+This rival completes only northwest-to-southeast pairs.  Seed 252 gives three
+ordinary demonstrations containing only that diagonal orientation and a fourth
+query containing the opposite orientation.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+TASK_ID = "1713e09a3132"
+RIVAL_NAME = "northwest_southeast_pairs_only"
+RIVAL_PROGRAM = r"""(rule! (let ((dummy 0))
+  (define (probe-colors-reading grid)
+    (remove-duplicates
+      (filter (lambda (v) (not (= v 0)))
+              (map (lambda (p) (at grid (first p) (second p)))
+                   (grid-positions grid)))))
+  (define (probe-border-cells r0 c0 r1 c1)
+    (for*/list ((r (in-range r0 (+ r1 1)))
+                (c (in-range c0 (+ c1 1)))
+                #:when (or (= r r0) (= r r1) (= c c0) (= c c1)))
+      (list r c)))
+  (for/fold ((out (empty-grid (rows g) (cols g) 0)))
+            ((color (in-list (probe-colors-reading g))))
+    (let ((cells (find-color g color)))
+      (if (and (= (length cells) 2)
+               (< (second (first cells)) (second (second cells))))
+          (let* ((r0 (min (first (first cells)) (first (second cells))))
+                 (r1 (max (first (first cells)) (first (second cells))))
+                 (c0 (min (second (first cells)) (second (second cells))))
+                 (c1 (max (second (first cells)) (second (second cells)))))
+            (paint-cells out (probe-border-cells r0 c0 r1 c1) color))
+          out)))))"""
+
+
+def _load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _by_color(grid: list[list[int]]) -> dict[int, list[tuple[int, int]]]:
+    result: dict[int, list[tuple[int, int]]] = {}
+    for row, values in enumerate(grid):
+        for col, value in enumerate(values):
+            if value != 0:
+                result.setdefault(value, []).append((row, col))
+    return result
+
+
+def orientations(grid: list[list[int]]) -> dict[str, str]:
+    result: dict[str, str] = {}
+    for color, points in sorted(_by_color(grid).items()):
+        if len(points) != 2:
+            continue
+        top, bottom = sorted(points)
+        result[str(color)] = "nwse" if top[1] < bottom[1] else "nesw"
+    return result
+
+
+def canonical_output(grid: list[list[int]]) -> list[list[int]]:
+    height, width = len(grid), len(grid[0])
+    output = [[0] * width for _ in range(height)]
+    for color, points in _by_color(grid).items():
+        if len(points) != 2:
+            continue
+        (r1, c1), (r2, c2) = points
+        r0, rh = sorted((r1, r2))
+        c0, ch = sorted((c1, c2))
+        for row in range(r0, rh + 1):
+            for col in range(c0, ch + 1):
+                if row in (r0, rh) or col in (c0, ch):
+                    output[row][col] = color
+    return output
+
+
+def nwse_only_output(grid: list[list[int]]) -> list[list[int]]:
+    height, width = len(grid), len(grid[0])
+    output = [[0] * width for _ in range(height)]
+    for color, points in _by_color(grid).items():
+        if len(points) != 2:
+            continue
+        top, bottom = sorted(points)
+        if top[1] >= bottom[1]:
+            continue
+        r0, rh = top[0], bottom[0]
+        c0, ch = top[1], bottom[1]
+        for row in range(r0, rh + 1):
+            for col in range(c0, ch + 1):
+                if row in (r0, rh) or col in (c0, ch):
+                    output[row][col] = color
+    return output
+
+
+def _different_cells(actual: list[list[int]], rival: list[list[int]]) -> list[list[int]]:
+    return [
+        [row, col, actual[row][col], rival[row][col]]
+        for row in range(len(actual))
+        for col in range(len(actual[0]))
+        if actual[row][col] != rival[row][col]
+    ]
+
+
+def build_lesson(generator: Any, *, seed: int = 252, difficulty: str | None = None) -> dict[str, Any]:
+    pairs: list[dict[str, Any]] = []
+    for sample_index in range(4):
+        grid = generator.generate(seed, sample_index, difficulty=difficulty)
+        intended = canonical_output(grid)
+        rival = nwse_only_output(grid)
+        pairs.append(
+            {
+                "sample_index": sample_index,
+                "input": grid,
+                "output": intended,
+                "rival_output": rival,
+                "rival_matches": rival == intended,
+                "different_cells": _different_cells(intended, rival),
+                "orientations": orientations(grid),
+                "grid_shape": [len(grid), len(grid[0])],
+            }
+        )
+    return {
+        "seed": seed,
+        "difficulty": difficulty,
+        "demonstrations": pairs[:3],
+        "query": pairs[3],
+    }
+
+
+def _canonical_program(repo: Path) -> str:
+    path = repo / "shared" / "data" / "canonical" / "puzzles.jsonl"
+    with path.open(encoding="utf-8") as handle:
+        for line in handle:
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                return row["program_solution"]
+    raise KeyError(TASK_ID)
+
+
+def _normalized_sha256(source: str) -> str:
+    return hashlib.sha256(" ".join(source.split()).encode()).hexdigest()
+
+
+def _racket_callable(rule_source: str) -> str:
+    from puzzle_generators.rule_wrap import strip_rule_wrapper
+
+    body = strip_rule_wrapper(rule_source)
+    if body.lstrip().startswith(("(lambda", "(λ")):
+        return f"(lambda (g) (let* ((h (rows g)) (w (cols g))) ({body} g)))"
+    return f"(lambda (g) (let* ((h (rows g)) (w (cols g))) {body}))"
+
+
+def _racket_outputs(program: str, grids: list[list[list[int]]]) -> list[list[list[int]]]:
+    from puzzle_generators.runner import _apply_rule, _open_bridge_with_rule
+
+    bridge, function_name = _open_bridge_with_rule(_racket_callable(program))
+    try:
+        return [_apply_rule(bridge, function_name, grid) for grid in grids]
+    finally:
+        bridge.shutdown()
+
+
+def build_report(repo: Path, *, seed: int = 252, difficulty: str | None = None) -> dict[str, Any]:
+    generator_path = repo / "generators" / TASK_ID / "generator.py"
+    generator = _load(generator_path, "review_1713_diagonal_generator")
+    lesson = build_lesson(generator, seed=seed, difficulty=difficulty)
+    pairs = [*lesson["demonstrations"], lesson["query"]]
+    grids = [pair["input"] for pair in pairs]
+    canonical_program = _canonical_program(repo)
+    canonical_racket = _racket_outputs(canonical_program, grids)
+    rival_racket = _racket_outputs(RIVAL_PROGRAM, grids)
+
+    for pair, actual, rival in zip(pairs, canonical_racket, rival_racket):
+        pair["canonical_racket_output"] = actual
+        pair["rival_racket_output"] = rival
+        pair["canonical_python_matches_racket"] = pair["output"] == actual
+        pair["rival_python_matches_racket"] = pair["rival_output"] == rival
+        pair["racket_outputs_match"] = actual == rival
+
+    demo_fits = [pair["racket_outputs_match"] for pair in lesson["demonstrations"]]
+    query_diff = _different_cells(
+        lesson["query"]["canonical_racket_output"],
+        lesson["query"]["rival_racket_output"],
+    )
+    report = {
+        "schema": "lesson-shortcut-probe-v1",
+        "task_id": TASK_ID,
+        "generator_sha256": hashlib.sha256(generator_path.read_bytes()).hexdigest(),
+        "generator_version": generator.VERSION,
+        "canonical_program_sha256": _normalized_sha256(canonical_program),
+        "rival_program_sha256": _normalized_sha256(RIVAL_PROGRAM),
+        "rival_name": RIVAL_NAME,
+        "rival_description": (
+            "Complete rectangle borders only when the equal-color input cells are "
+            "the northwest and southeast corners; ignore northeast/southwest pairs."
+        ),
+        "seed": seed,
+        "difficulty": difficulty,
+        "demonstration_count": 3,
+        "demo_fits_each": demo_fits,
+        "demo_fits_all": all(demo_fits),
+        "query_disagrees": bool(query_diff),
+        "query_different_cells": query_diff,
+        "protected_racket_evaluations": 8,
+        "lesson": lesson,
+        "alternative_answer_candidate": all(demo_fits) and bool(query_diff),
+        "finding": (
+            "All pairs in the three ordinary demonstrations at seed 252 use the "
+            "northwest/southeast diagonal.  The query contains a lawful opposite-"
+            "diagonal pair, which the shortcut omits."
+        ),
+        "repair": (
+            "Require visible coverage of both diagonal orientations, or reject a "
+            "lesson while this executable fixed-orientation rival survives."
+        ),
+        "production_changed": False,
+        "status": "passed" if all(demo_fits) and query_diff else "failed",
+        "scope_note": "One retained seed and one explicit executable rival; not universal uniqueness evidence.",
+    }
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repo", type=Path, default=Path("."))
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=252)
+    args = parser.parse_args()
+    repo = args.repo.resolve()
+    sys.path.insert(0, str(repo / "shared" / "runtime"))
+    report = build_report(repo, seed=args.seed)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({k: report[k] for k in ("task_id", "status", "demo_fits_all", "query_disagrees")}, sort_keys=True))
+    return 0 if report["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
