+"""Replay a global-versus-column color-count teaching ambiguity.
+
+All retained inputs are ordinary draws selected from a bounded 16-input pool.
+The lesson is reviewer-assembled, not an emitted public-worker episode.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+from reviewer_support import load_selected_generator
+
+
+TASK = "16dfbdc731e1"
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+EXPECTED_GENERATOR_SHA256 = "ac8badb8a61133d893514d168dd1184ad2d2d43bc0ad18c5eaa811ec3bd0202d"
+EXPECTED_PROGRAM_SHA256 = "4e66e5a34649cdf52aa69f1c6681349f387df91450d33171a9daaabfa685dabb"
+DRAW_SPECS = (
+    ("demo_0", 0, 1),
+    ("demo_1", 0, 7),
+    ("demo_2", 17, 0),
+    ("query", 17, 7),
+    ("guard", 17, 5),
+)
+
+
+def _sha(text):
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def _differences(intended, rival):
+    if len(intended) != len(rival) or any(len(a) != len(b) for a, b in zip(intended, rival)):
+        raise AssertionError("the color-count rival must preserve grid dimensions")
+    return [{"row": r, "column": c, "intended": a, "rival": b}
+            for r, (row_a, row_b) in enumerate(zip(intended, rival))
+            for c, (a, b) in enumerate(zip(row_a, row_b)) if a != b]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    generator, generator_path, generator_sha = load_selected_generator(TASK, root=ROOT)
+    if generator_sha != EXPECTED_GENERATOR_SHA256:
+        raise AssertionError("selected generator differs from this retained finding")
+    canonical_path = ROOT / "shared/data/canonical/puzzles.jsonl"
+    record = next(item for item in map(json.loads, canonical_path.read_text().splitlines())
+                  if item.get("task_id") == TASK)
+    intended_program = record["program_solution"]
+    if _sha(intended_program) != EXPECTED_PROGRAM_SHA256:
+        raise AssertionError("canonical program differs from this retained finding")
+    original = "(and (= (length rs) 2)"
+    if intended_program.count(original) != 1:
+        raise AssertionError("expected one per-column color-count condition")
+    rival_program = intended_program.replace(
+        original, "(and (= (length (find-color g color)) 2) (= (length rs) 2)")
+
+    cases = {}
+    for name, seed, sample_index in DRAW_SPECS:
+        grid = generator.generate(seed, sample_index, difficulty="medium")
+        errors = generator.self_check(grid, difficulty="medium")
+        if errors:
+            raise AssertionError(f"retained ordinary input failed self_check: {name}: {errors}")
+        counts = Counter(color for row in grid for color in row if color)
+        cases[name] = {
+            "provenance": {"origin": "ordinary_generator_draw", "seed": seed,
+                           "sample_index": sample_index, "difficulty": "medium", "overrides": {}},
+            "input": grid,
+            "self_check": errors,
+            "whole_grid_color_counts": dict(sorted(counts.items())),
+            "reused_colors": sorted(color for color, count in counts.items() if count > 2),
+        }
+
+    evaluations = 0
+    canonical_checks = []
+    with _local_imports(ROOT / "shared/runtime", HERE):
+        apply, identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+        try:
+            if identity.get("backend") != "racket" or identity.get("protected") is not True:
+                raise AssertionError(f"protected real Racket evaluator required: {identity}")
+            for split in ("train", "test"):
+                pairs = record[split] if isinstance(record[split], list) else [record[split]]
+                for index, pair in enumerate(pairs):
+                    intended = apply(intended_program, pair["input"])
+                    evaluations += 1
+                    rival = apply(rival_program, pair["input"])
+                    evaluations += 1
+                    if intended != pair["output"] or rival != pair["output"]:
+                        raise AssertionError(f"both programs must fit the saved canonical pair: {split}/{index}")
+                    canonical_checks.append({"split": split, "index": index,
+                                             "intended_matches_saved": True, "rival_matches_saved": True})
+            for case in cases.values():
+                case["intended_output"] = apply(intended_program, case["input"])
+                evaluations += 1
+                case["rival_output"] = apply(rival_program, case["input"])
+                evaluations += 1
+                case["changed_cells"] = _differences(case["intended_output"], case["rival_output"])
+                case["outputs_agree"] = not case["changed_cells"]
+        finally:
+            bridge.close()
+
+    demo_names = ("demo_0", "demo_1", "demo_2")
+    if not all(cases[name]["outputs_agree"] for name in demo_names):
+        raise AssertionError("the rival must fit all original visible demonstrations")
+    if len(cases["query"]["changed_cells"]) != 2 or len(cases["guard"]["changed_cells"]) != 3:
+        raise AssertionError("the retained query and guard no longer match the exact witness")
+
+    def pair(name):
+        return {"input": deepcopy(cases[name]["input"]),
+                "output": deepcopy(cases[name]["intended_output"])}
+
+    review_index = json.loads((ROOT / "generators" / TASK / "evidence/review_index.json").read_text())
+    report = {
+        "task_id": TASK,
+        "finding": "global_color_count_fits_distinct_color_demonstrations",
+        "source": {"generator_path": str(generator_path.relative_to(ROOT)),
+                   "generator_sha256": generator_sha,
+                   "canonical_path": str(canonical_path.relative_to(ROOT)),
+                   "canonical_rule_hash": EXPECTED_PROGRAM_SHA256[:12],
+                   "canonical_program_sha256": _sha(intended_program),
+                   "probe_path": str(Path(__file__).resolve().relative_to(ROOT)),
+                   "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()},
+        "scope": {"discovery": "one rival; 16 ordinary medium draws, seeds0/17 and indices0..7",
+                  "replayed_unique_generated_inputs": len(cases), "authored_inputs": 0,
+                  "lesson_origin": "reviewer-assembled subset of ordinary draws from two seeds",
+                  "public_worker_executed": False, "public_worker_admission": "not assessed",
+                  "task_specific_lesson_identifiable_hook_present": hasattr(generator, "lesson_identifiable")},
+        "evaluator": identity,
+        "protected_racket_evaluations": evaluations,
+        "canonical_fixture_checks": canonical_checks,
+        "programs": {
+            "intended": {"sha256": _sha(intended_program), "source": intended_program},
+            "whole_grid_color_count_rival": {
+                "sha256": _sha(rival_program), "source": rival_program,
+                "description": "Require exactly two occurrences of a color in the whole grid before applying the otherwise unchanged per-column bridge rule."}},
+        "cases": cases,
+        "original_ambiguous_lesson": {
+            "train": [pair(name) for name in demo_names], "test": [pair("query")],
+            "rival_fits_all_visible_demonstrations": True,
+            "rival_query_output": deepcopy(cases["query"]["rival_output"])},
+        "guard_proposal": {
+            "description": "Replace demo_0 with the separate ordinary guard; keep demo_1, demo_2 and the original query.",
+            "guard_case": "guard", "rival_refuted": True,
+            "repaired_lesson": {"train": [pair(name) for name in ("guard", "demo_1", "demo_2")],
+                                "test": [pair("query")]},
+            "constructive_condition": "Show one color reused in at least two active columns, with a nonempty zero gap in each column.",
+            "claim_limit": "Refutes the one retained rival; does not prove universal identifiability or resolve the prior mismatch/override findings."},
+        "prior_audits_preserved": [
+            {key: item.get(key) for key in ("return_id", "source_sha256", "resolution", "verification_status")}
+            for item in review_index.get("audits", [])],
+        "retained_prior_findings": "Ignoring endpoint-color equality on an authored outside-support negative, and declared-control defects, remain needs_triage. No production, canonical, approval or historical-disposition change was made.",
+    }
+    out = args.out.resolve()
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"out": str(out), "generator_sha256": generator_sha,
+                      "canonical_program_sha256": _sha(intended_program),
+                      "rival_program_sha256": _sha(rival_program),
+                      "protected_racket_evaluations": evaluations,
+                      "query_changed_cells": cases["query"]["changed_cells"],
+                      "guard_changed_cells": cases["guard"]["changed_cells"]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
