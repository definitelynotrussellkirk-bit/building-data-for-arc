+"""Bounded guide-ownership review with source-pinned protected Racket labels.
+
+At most sixteen ordinary draws, seeds 0/17, and three distance rivals. Lessons
+are reviewer-assembled unique prefixes, not public-worker/export episodes.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+TASK = "f06c6cb68038"
+ROOT = Path(__file__).resolve().parents[3]
+HOME = ROOT / "generators" / TASK
+RUNTIME = ROOT / "shared/runtime"
+SOURCE_SHA = "a47ec055f853084c090069395547fbf31040246d2af0515e9ab09075fe6f9622"
+RULE_SHA = "5ce7f98d87c5cc06e66c6d43b7fe03508be6b0df4275ad5ccd387e610d87f07f"
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def geometry(grid):
+    height, width = len(grid), len(grid[0])
+    guides = []
+    for row in range(height):
+        for col in range(width):
+            if grid[row][col] == 2 and (row == 0 or grid[row - 1][col] != 2):
+                bottom = row
+                while bottom + 1 < height and grid[bottom + 1][col] == 2:
+                    bottom += 1
+                guides.append({"col": col, "r1": row, "r2": bottom})
+    markers = []
+    for row, values in enumerate(grid):
+        for col, color in enumerate(values):
+            if color in (0, 2, 4):
+                continue
+            scores = {name: [] for name in ("intended", "manhattan", "euclidean_squared", "column_only")}
+            for guide in guides:
+                dx = abs(col - guide["col"])
+                dy = max(guide["r1"] - row, row - guide["r2"], 0)
+                scores["intended"].append(dx + 10 * dy)
+                scores["manhattan"].append(dx + dy)
+                scores["euclidean_squared"].append(dx * dx + dy * dy)
+                scores["column_only"].append(dx)
+            markers.append({"row": row, "col": col, "color": color, "scores": scores,
+                            "minimizers": {name: [i for i, value in enumerate(values) if value == min(values)]
+                                           for name, values in scores.items()}})
+    return {"shape": [height, width], "guides": guides, "markers": markers}
+
+
+def changed(a, b):
+    assert len(a) == len(b) and all(len(ar) == len(br) for ar, br in zip(a, b))
+    return sum(x != y for ar, br in zip(a, b) for x, y in zip(ar, br))
+
+
+def demo_only_guard(demonstrations, apply_program, rivals):
+    """Use only demo pairs; execution errors propagate and never refute a rival."""
+    refutations = {name: [i for i, pair in enumerate(demonstrations)
+                          if apply_program(program, pair["input"]) != pair["output"]]
+                   for name, program in rivals.items()}
+    return {"surviving_rivals": [name for name, indices in refutations.items() if not indices],
+            "refutations_by_demo_index": refutations}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=False)
+    source = HOME / "generator.py"
+    assert sha(source.read_bytes()) == SOURCE_SHA
+    variants = [row for line in (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()
+                if (row := json.loads(line))["task_id"] == TASK]
+    assert len({row["program_solution"] for row in variants}) == 1
+    canonical = next(row for row in variants if row["source"] == "training")
+    intended = canonical["program_solution"]
+    assert sha(intended.encode()) == RULE_SHA
+    expression = "(+ (abs (- mc linec)) (* 10 row-gap))"
+    assert intended.count(expression) == 1
+    replacements = {
+        "manhattan": "(+ (abs (- mc linec)) row-gap)",
+        "euclidean_squared": "(+ (* (- mc linec) (- mc linec)) (* row-gap row-gap))",
+        "column_only": "(abs (- mc linec))",
+    }
+    rivals = {name: intended.replace(expression, alternative) for name, alternative in replacements.items()}
+    report = {
+        "schema": "f06c6cb68038-guide-metric-review-v1", "task_id": TASK,
+        "source_sha256": SOURCE_SHA, "rule_sha256": RULE_SHA,
+        "normalized_rule_hash": sha(" ".join(intended.split()).encode())[:12],
+        "probe_sha256": sha(Path(__file__).read_bytes()),
+        "canonical_variants": [{"source": row["source"], "train_count": len(row["train"]),
+                                 "test_count": len(row["test"])} for row in variants],
+        "scope": {"seed_budget": [0, 17], "maximum_ordinary_draws": 16, "rival_count": 3,
+                  "difficulty": None, "overrides": {}, "demo_counts": [3, 2, 4, 5, 6],
+                  "queries": "up to four following unique draws within eight draws per seed",
+                  "assembly": "reviewer-assembled consecutive unique ordinary draws; no public-worker/export invocation"},
+        "rivals": {name: {"program": program, "sha256": sha(program.encode())} for name, program in rivals.items()},
+        "canonical": [], "generated": [], "witness": None,
+    }
+    (args.out / "intended.rkt").write_text(intended)
+    for name, program in rivals.items():
+        (args.out / f"{name}.rkt").write_text(program)
+    calls = 0
+    with _local_imports(RUNTIME, HOME / "workspace"):
+        from reviewer_support import load_selected_generator
+        module, selected, source_sha = load_selected_generator(TASK, root=ROOT)
+        assert Path(selected).resolve() == source.resolve() and source_sha == SOURCE_SHA
+        evaluator, identity, bridge = _real_evaluator(RUNTIME)
+        report["runtime"] = identity
+
+        def apply_program(program, grid):
+            nonlocal calls
+            calls += 1
+            return evaluator(program, grid)
+
+        def label(grid):
+            assert module.self_check(grid) == []
+            actual = apply_program(intended, grid)
+            assert actual == module.rule_mirror(grid)
+            outputs = {name: apply_program(program, grid) for name, program in rivals.items()}
+            return {"input": grid, "output": actual, "geometry": geometry(grid), "rival_outputs": outputs,
+                    "changed_cells": {name: changed(actual, out) for name, out in outputs.items()}}
+
+        try:
+            for split in ("train", "test"):
+                for index, pair in enumerate(canonical[split]):
+                    row = label(pair["input"])
+                    assert row["output"] == pair["output"]
+                    report["canonical"].append({"split": split, "index": index, **row})
+            report["canonical_demo_guard"] = demo_only_guard(canonical["train"], apply_program, rivals)
+            report["canonical_query_disagreements_by_surviving_rival"] = {
+                name: [row["index"] for row in report["canonical"] if row["split"] == "test" and row["changed_cells"][name]]
+                for name in report["canonical_demo_guard"]["surviving_rivals"]}
+            for seed in (0, 17):
+                records, seen = [], {}
+                for index in range(8):
+                    row = {"seed": seed, "sample_index": index, **label(module.generate(seed=seed, sample_index=index))}
+                    key = json.dumps(row["input"])
+                    row["duplicate_of"] = seen.get(key)
+                    report["generated"].append(row)
+                    if key not in seen:
+                        records.append(row)
+                        seen[key] = index
+                for demo_count in (3, 2, 4, 5, 6):
+                    demos, queries = records[:demo_count], records[demo_count:demo_count + 4]
+                    if len(demos) != demo_count or not queries:
+                        continue
+                    for name in rivals:
+                        if not all(row["changed_cells"][name] == 0 for row in demos):
+                            continue
+                        wrong = [row["sample_index"] for row in queries if row["changed_cells"][name]]
+                        if wrong:
+                            visible = [{"input": row["input"], "output": row["output"]} for row in demos]
+                            report["witness"] = {
+                                "scope": report["scope"]["assembly"], "seed": seed, "difficulty": None, "overrides": {},
+                                "demo_indices": [row["sample_index"] for row in demos],
+                                "query_indices": [row["sample_index"] for row in queries],
+                                "rival_name": name, "differing_query_indices": wrong,
+                                "train": visible,
+                                "test": [{"input": row["input"], "output": row["output"]} for row in queries],
+                                "protected_rival_train_outputs": [row["rival_outputs"][name] for row in demos],
+                                "protected_rival_test_outputs": [row["rival_outputs"][name] for row in queries],
+                                "query_changed_cells": [row["changed_cells"][name] for row in queries],
+                                "demo_only_guard": demo_only_guard(visible, apply_program, rivals),
+                            }
+                            assert name in report["witness"]["demo_only_guard"]["surviving_rivals"]
+                            break
+                    if report["witness"]:
+                        break
+                if report["witness"]:
+                    break
+        except Exception as error:
+            report["execution_error"] = {"type": type(error).__name__, "message": str(error)}
+            report["status"] = "execution_failed_not_refutation"
+            raise
+        finally:
+            bridge.close()
+            report["protected_evaluations"] = calls
+            report["ordinary_inputs_drawn"] = len(report["generated"])
+            report.setdefault("status", "finite_guide_metric_ambiguity" if report["witness"] else "bounded_no_finding")
+            (args.out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    assert sha(source.read_bytes()) == SOURCE_SHA
+    assert len(report["generated"]) <= 16
+    if report["witness"]:
+        (args.out / "witness.json").write_text(json.dumps(report["witness"], indent=2) + "\n")
+    print(json.dumps({"status": report["status"], "ordinary_inputs_drawn": report["ordinary_inputs_drawn"],
+                      "protected_evaluations": calls,
+                      "witness": None if not report["witness"] else {key: report["witness"][key] for key in
+                          ("seed", "demo_indices", "query_indices", "rival_name", "query_changed_cells")}}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
