+def test_first_three_demos_refute_a_single_monotone_absolute_area_threshold(family, seed, policy):
+    episode = family.generate(seed, setting(policy), 3, 1)
+    selected, unselected = [], []
+    for pair in episode["train"]:
+        for box in input_boxes(pair["input"]):
