(rule!
  (let ((dummy 0))
    (define dirs4 (list (list -1 0) (list 1 0) (list 0 -1) (list 0 1)))
    (define (regions-without-wall grid wall-color)
      (let loop-pos ((positions (grid-positions grid)) (seen (list)) (acc (list)))
        (cond
          ((empty? positions) (reverse acc))
          ((or (member? (first positions) seen)
               (= (at grid (first (first positions)) (second (first positions))) wall-color))
           (loop-pos (rest positions) seen acc))
          (else
           (let bfs ((queue (list (first positions)))
                     (seen2 (cons (first positions) seen))
                     (cells (list)))
             (if (empty? queue)
                 (loop-pos (rest positions) seen2 (cons (sort cells cell<) acc))
                 (let* ((cur (first queue))
                        (nbrs
                         (filter
                          (lambda (p)
                            (and (in-bounds? (first p) (second p) (rows grid) (cols grid))
                                 (not (member? p seen2))
                                 (not (= (at grid (first p) (second p)) wall-color))))
                          (map (lambda (d)
                                 (list (+ (first cur) (first d))
                                       (+ (second cur) (second d))))
                               dirs4))))
                   (bfs (append (rest queue) nbrs)
                        (append seen2 nbrs)
                        (cons cur cells)))))))))
    (define (room<? a b)
      (let ((ba (bbox-of-cells a)) (bb (bbox-of-cells b)))
        (or (< (first ba) (first bb))
            (and (= (first ba) (first bb)) (< (second ba) (second bb))))))
    (define rooms (sort (regions-without-wall g 5) room<?))
    (define settled
      (for/fold
       ((out (grid-from-fn (rows g) (cols g)
                           (lambda (r c) (if (= (at g r c) 5) 5 0)))))
       ((room (in-list rooms)))
       (let* ((bb (bbox-of-cells room))
              (r0 (first bb)) (c0 (second bb))
              (r1 (third bb)) (c1 (fourth bb)))
         (for/fold ((acc out)) ((c (in-range c0 (+ c1 1))))
           (let* ((col-cells
                   (filter (lambda (r) (member? (list r c) room))
                           (range r0 (+ r1 1))))
                  (vals
                   (filter (lambda (v) (not (= v 0)))
                           (map (lambda (r) (at g r c)) col-cells)))
                  (start (- (length col-cells) (length vals))))
             (for/fold ((acc2 acc)) ((r (in-list col-cells)) (i (in-naturals)))
               (if (>= i start)
                   (set-cell acc2 r c (list-ref vals (- i start)))
                   acc2)))))))
    (define controller (first rooms))
    (define controller-bb (bbox-of-cells controller))
    (define bottom (third controller-bb))
    (define left (second controller-bb))
    (define right (fourth controller-bb))
    (define relay-index
      (length
       (filter (lambda (c) (= (at settled bottom c) 9))
               (range left (+ right 1)))))
    (define selected (list-ref (rest rooms) (- relay-index 1)))
    (for/fold ((out settled)) ((p (in-list selected)))
      (if (= (at out (first p) (second p)) 0)
          out
          (set-cell out (first p) (second p) 8)))))