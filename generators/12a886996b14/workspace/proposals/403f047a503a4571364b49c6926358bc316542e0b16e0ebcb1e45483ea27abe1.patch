+    "interior_preserved": lambda grid: _witness(grid, lambda o: o["interior_components"] > 0),
+    "vertical_border_side": lambda grid: _witness(grid, lambda o: o["vertical_border_component"]),
+    "one_border_count": lambda grid: _witness(grid, lambda o: o["border_components"] == 1),
+    "two_border_count": lambda grid: _witness(grid, lambda o: o["border_components"] == 2),
+}
+SEMANTIC_RIVALS = {
+    "border_cells_only": _rival_border_cells_only,
+    "near_border_recolors": _rival_near_border,
+    "recolor_all_yellow": _rival_recolor_all,
+    "horizontal_edges_only": _rival_horizontal_edges_only,
+    "one_border_component_only": _rival_one_border_component,
+    "exactly_two_border_components": _rival_exactly_two_border_components,
+}
+WITNESS_RIVALS = {
+    "whole_component_recolor": ["border_cells_only"],
+    "near_border_is_not_border": ["near_border_recolors"],
+    "interior_preserved": ["recolor_all_yellow"],
+    "vertical_border_side": ["horizontal_edges_only"],
+    "one_border_count": ["exactly_two_border_components"],
+    "two_border_count": ["one_border_component_only"],
+}
+# None of these rivals fits all four canonical labeled pairs, so they belong
+# only in lesson-level teaching checks rather than CANONICAL_SHORTCUTS.
+CANONICAL_SHORTCUTS: dict[str, Callable] = {}
+LESSON_COMPETITORS = dict(SEMANTIC_RIVALS)
+
+
+def _validate_pair(pair: Any, label: str) -> list[str]:
+    if not isinstance(pair, dict) or "input" not in pair or "output" not in pair:
+        return [f"{label} must contain input and output"]
+    errors = self_check(pair["input"])
+    if errors:
+        return [f"{label} input is unlawful: {errors[0]}"]
+    if pair["output"] != _apply_rule(pair["input"]):
+        return [f"{label} output disagrees with border-component recoloring"]
+    return []
+
+
+def lesson_identifiable(demos, query) -> list[str]:
+    if not isinstance(demos, (list, tuple)) or len(demos) < EXAMPLES_NEEDED:
+        return [f"need at least {EXAMPLES_NEEDED} demonstrations"]
+    reasons: list[str] = []
+    for index, demo in enumerate(demos):
+        reasons.extend(_validate_pair(demo, f"demo {index}"))
+    reasons.extend(_validate_pair(query, "query"))
+    if reasons:
+        return reasons
+    for name, competitor in LESSON_COMPETITORS.items():
+        if all(competitor(demo["input"]) == demo["output"] for demo in demos):
+            if competitor(query["input"]) != query["output"]:
+                reasons.append(
+                    f"demos remain compatible with competitor {name!r}, which changes the query"
+                )
+    return reasons
