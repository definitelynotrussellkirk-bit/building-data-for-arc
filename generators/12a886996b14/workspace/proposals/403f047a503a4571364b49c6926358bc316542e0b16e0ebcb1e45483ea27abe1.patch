+#!/usr/bin/env python3
+"""Bounded source-bound audit for d9829b956366.
+
+The Python phase checks the constructive curriculum against every declared
+plausible rival.  The command-line phase then executes all retained inputs via
+``arcpuzzles apply`` so labels are bound to the selected canonical Racket rule.
+
+From the packet root::
+
+    python3 review.py run python3 \
+      generators/d9829b956366/workspace/adversarial_review.py \
+      --out ../checks/d9829b956366/adversarial/report.json
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+from typing import Any, Iterable, Sequence
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "d9829b956366"
+
+
+def _grid_digest(grid: Sequence[Sequence[int]]) -> str:
+    body = json.dumps(grid, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(body).hexdigest()
+
+
+def _different_cells(left, right) -> list[list[int]]:
+    return [
+        [row, col, left[row][col], right[row][col]]
+        for row in range(len(left))
+        for col in range(len(left[0]))
+        if left[row][col] != right[row][col]
+    ]
+
+
+def python_audit(
+    module: Any,
+    *,
+    seeds: Iterable[int] = (0, 17),
+    sample_indices: Iterable[int] = range(4),
+    difficulties: Iterable[str] = ("easy", "medium", "hard"),
+) -> dict[str, Any]:
+    """Generate a finite curriculum and count exact rival disagreements."""
+    seed_values = tuple(seeds)
+    index_values = tuple(sample_indices)
+    difficulty_values = tuple(difficulties)
+    rivals = dict(module.LESSON_COMPETITORS)
+    rival_rows = {
+        name: {"defeated": 0, "agreements": 0, "first_witness": None}
+        for name in rivals
+    }
+    cases: list[dict[str, Any]] = []
+    invalid: list[dict[str, Any]] = []
+
+    for difficulty in difficulty_values:
+        for seed in seed_values:
+            for sample_index in index_values:
+                grid = module.generate(seed, sample_index, difficulty=difficulty)
+                errors = module.self_check(grid)
+                truth = module._apply_rule(grid)
+                case = {
+                    "difficulty": difficulty,
+                    "seed": seed,
+                    "sample_index": sample_index,
+                    "input": grid,
+                    "python_output": truth,
+                    "input_sha256": _grid_digest(grid),
+                    "observed": module.semantic_observables(grid),
+                }
+                if errors:
+                    invalid.append({**case, "self_check": errors})
+                for name, rival in rivals.items():
+                    candidate = rival(grid)
+                    if candidate == truth:
+                        rival_rows[name]["agreements"] += 1
+                    else:
+                        rival_rows[name]["defeated"] += 1
+                        if rival_rows[name]["first_witness"] is None:
+                            rival_rows[name]["first_witness"] = {
+                                "difficulty": difficulty,
+                                "seed": seed,
+                                "sample_index": sample_index,
+                                "input": grid,
+                                "canonical_output": truth,
+                                "rival_output": candidate,
+                                "different_cells": _different_cells(truth, candidate),
+                            }
+                cases.append(case)
+
+    failures = [
+        f"rival {name!r} survived every retained case"
+        for name, row in rival_rows.items()
+        if row["defeated"] == 0
+    ]
+    if invalid:
+        failures.append(f"{len(invalid)} generated inputs failed self_check")
+    return {
+        "schema": "d9829b956366-adversarial-review-v1",
+        "task_id": TASK_ID,
+        "finite_scope": {
+            "seeds": list(seed_values),
+            "sample_indices": list(index_values),
+            "difficulties": list(difficulty_values),
+        },
+        "case_count": len(cases),
+        "distinct_inputs": len({case["input_sha256"] for case in cases}),
+        "rivals": rival_rows,
+        "invalid": invalid,
+        "failures": failures,
+        "passed": not failures,
+        "cases": cases,
+    }
+
+
+def racket_verify(root: Path, cases: Sequence[dict[str, Any]], directory: Path) -> dict[str, Any]:
+    """Execute exact retained inputs through the packet's public apply command."""
+    directory.mkdir(parents=True, exist_ok=True)
+    inputs_path = (directory / "racket-inputs.json").resolve()
+    outputs_path = (directory / "racket-outputs.json").resolve()
+    if outputs_path.exists():
+        raise FileExistsError(outputs_path)
+    inputs_path.write_text(
+        json.dumps({"inputs": [case["input"] for case in cases]}, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    packet_root = root.parent.parent
+    review_py = packet_root / "review.py"
+    if review_py.is_file():
+        command = [
+            sys.executable,
+            str(review_py),
+            "run",
+            "python3",
+            "-m",
+            "arcpuzzles",
+            "apply",
+            TASK_ID,
+            "--input",
+            str(inputs_path),
+            "--check-generator-domain",
+            "--out",
+            str(outputs_path),
+        ]
+        cwd = packet_root
+    else:
+        command = [
+            sys.executable,
+            "-m",
+            "arcpuzzles",
+            "apply",
+            TASK_ID,
+            "--input",
+            str(inputs_path),
+            "--check-generator-domain",
+            "--out",
+            str(outputs_path),
+        ]
+        cwd = root
+    completed = subprocess.run(
+        command,
+        cwd=cwd,
+        text=True,
+        capture_output=True,
+        timeout=240,
+        check=False,
+    )
+    if completed.returncode != 0 or not outputs_path.is_file():
+        return {
+            "passed": False,
+            "command": command,
+            "returncode": completed.returncode,
+            "stdout": completed.stdout,
+            "stderr": completed.stderr,
+            "evaluations": 0,
+            "inputs_path": str(inputs_path),
+        }
+    payload = json.loads(outputs_path.read_text(encoding="utf-8"))
+    results = payload.get("results", [])
+    mismatches: list[dict[str, Any]] = []
+    for index, case in enumerate(cases):
+        if index >= len(results):
+            mismatches.append({"index": index, "error": "missing Racket result"})
+            continue
+        row = results[index]
+        if row.get("error") or not row.get("valid_output"):
+            mismatches.append({"index": index, "error": row.get("error") or "invalid output"})
+        elif row.get("generator_domain", {}).get("status") != "valid":
+            mismatches.append({"index": index, "error": "generator-domain rejection"})
+        elif row.get("output") != case["python_output"]:
+            mismatches.append({
+                "index": index,
+                "different_cells": _different_cells(case["python_output"], row.get("output")),
+            })
+    if len(results) != len(cases):
+        mismatches.append({"error": f"expected {len(cases)} results, got {len(results)}"})
+    return {
+        "passed": not mismatches,
+        "command": command,
+        "returncode": completed.returncode,
+        "executed_rule_hash": payload.get("executed_rule_hash"),
+        "catalog_rule_hash": payload.get("catalog_rule_hash"),
+        "rule_hash_matches_catalog": payload.get("rule_hash_matches_catalog"),
+        "generator_sha256": payload.get("generator_sha256"),
+        "evaluations": len(results),
+        "mismatches": mismatches,
+        "inputs_path": str(inputs_path),
+        "outputs_path": str(outputs_path),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed-count", type=int, default=2)
+    args = parser.parse_args()
+    if args.seed_count <= 0:
+        parser.error("--seed-count must be positive")
+
+    root = find_root(__file__)
+    module, source, source_sha256 = load_selected_generator(TASK_ID, root=root)
+    report = python_audit(module, seeds=range(args.seed_count))
+    report["generator_path"] = str(source)
+    report["generator_sha256"] = source_sha256
+    report["generator_version"] = module.VERSION
+    report["rule_hash"] = module.RULE_HASH
+    report["racket"] = racket_verify(root, report["cases"], args.out.parent)
+    report["passed"] = bool(report["passed"] and report["racket"]["passed"])
+    if not report["racket"]["passed"]:
+        report["failures"].append("protected canonical Racket verification failed")
+
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "task_id": TASK_ID,
+        "passed": report["passed"],
+        "cases": report["case_count"],
+        "racket_evaluations": report["racket"].get("evaluations", 0),
+        "distinct_inputs": report["distinct_inputs"],
+        "rival_defeats": {name: row["defeated"] for name, row in report["rivals"].items()},
+        "out": str(args.out),
+    }, sort_keys=True))
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
