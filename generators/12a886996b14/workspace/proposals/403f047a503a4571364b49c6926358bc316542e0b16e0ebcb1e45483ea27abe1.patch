+def _components_of_color(grid: Sequence[Sequence[int]], color: int = 4) -> list[Component]:
+    height, width = len(grid), len(grid[0])
+    remaining = {
+        (row, col)
+        for row in range(height)
+        for col in range(width)
+        if grid[row][col] == color
+    }
+    result: list[Component] = []
+    while remaining:
+        start = min(remaining)
+        remaining.remove(start)
+        stack = [start]
+        component = {start}
+        while stack:
+            row, col = stack.pop()
+            for dr, dc in _ORTHOGONAL:
+                nxt = (row + dr, col + dc)
+                if nxt in remaining:
+                    remaining.remove(nxt)
+                    component.add(nxt)
+                    stack.append(nxt)
+        result.append(tuple(sorted(component)))
+    return result
