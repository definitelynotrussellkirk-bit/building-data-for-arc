+def test_rule_hash_and_all_canonical_pairs_are_owned() -> None:
+    assert GEN.RULE_HASH == "f9d83b4de683"
+    pairs = canonical_pairs(TASK_ID, root=ROOT)
+    assert len(pairs) == 4
+    for pair in pairs:
+        assert GEN.self_check(copy.deepcopy(pair["input"])) == []
