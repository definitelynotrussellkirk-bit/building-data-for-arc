(rule! (let ((dummy 0)) (for/fold ((out (empty-grid (rows g) (cols g) 0))) ((obj (in-list (objects g 0)))) (let* ((cells (obj-cells obj)) (top (any? (lambda (p) (= (first p) 0)) cells)) (bottom (any? (lambda (p) (= (first p) (- (rows g) 1))) cells)) (left (any? (lambda (p) (= (second p) 0)) cells)) (right (any? (lambda (p) (= (second p) (- (cols g) 1))) cells))) (if (and (or top bottom) (or left right)) (paint-cells out cells (obj-color obj)) out)))))