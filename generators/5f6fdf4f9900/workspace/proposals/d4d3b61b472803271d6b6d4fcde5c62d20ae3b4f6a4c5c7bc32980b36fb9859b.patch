+++ b/repo/generators/4043070e87c0/workspace/learnability_probe.py
@@ -0,0 +1,126 @@
+"""Replay one bounded, source-bound top-only rival witness through Racket.
+
+From the outer packet directory:
+  WORK/.venv/bin/python review.py run ../.venv/bin/python \
+    generators/4043070e87c0/workspace/learnability_probe.py \
+    --out generators/4043070e87c0/workspace/learnability_witness.json
+
+The three-demo view is deliberately assembled from unmodified generated pairs.
+It is not claimed to be a default sequential three-demo episode.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from puzzle_generators import runner
+from reviewer_support import find_root, load_selected_generator
+
+
+TASK = "4043070e87c0"
+EXPECTED_GENERATOR_SHA256 = "5d7c3ee577d0f7b86d2d09df22d6d32e790fb7ab79fe283c717d62e07ef48b3c"
+RIVAL = """(rule! (lambda (g)
+  (let ((h (/ (rows g) 2)) (w (cols g)))
+    (grid-from-fn h w
+      (lambda (r c) (if (zero? (at g r c)) 2 0))))))"""
+
+
+def sha(text):
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    root = find_root(__file__)
+    module, source_path, source_sha = load_selected_generator(TASK, root=root)
+    if source_sha != EXPECTED_GENERATOR_SHA256:
+        raise ValueError("Audited generator changed; review the new source before replay")
+
+    # This public API creates its own source-bound runtime and derives every
+    # label through protected canonical Racket execution. Two demos is an
+    # explicit supported request; the automatic floor is three for this source.
+    episode = Catalog(root).generate(
+        TASK, count=1, seed=0, sample_index=0, n_train=2, n_test=2,
+        difficulty=None, overrides={}, allow_unapproved=True, timeout=90,
+    )[0]
+    assert episode["provenance"]["generator_sha256"] == source_sha
+    assert episode["sample_indices"] == [0, 1, 2, 3]
+    assert episode["rejections"] == []
+    policy = episode["provenance"]["demonstration_policy"]
+    assert policy["declared_minimum"] is None
+    assert policy["resolved_n_train"] == 2 and policy["default_floor"] == 3
+    pairs = episode["train"] + episode["test"]
+    assert all(module.self_check(pair["input"]) == [] for pair in pairs)
+
+    bridge, name = runner._open_bridge_with_rule(runner.wrap_rule(RIVAL))
+    try:
+        predictions = [runner._apply_rule(bridge, name, pair["input"]) for pair in pairs]
+    finally:
+        bridge.shutdown()
+    matches = [prediction == pair["output"] for prediction, pair in zip(predictions, pairs)]
+    assert matches == [True, True, False, True]
+    disagreements = [
+        {"row": r, "column": c, "canonical": value, "rival": predictions[2][r][c]}
+        for r, row in enumerate(pairs[2]["output"])
+        for c, value in enumerate(row)
+        if predictions[2][r][c] != value
+    ]
+    assert len(disagreements) == 2
+    source_program = episode["program"]
+    result = {
+        "schema": "arcpuzzles-peer-learnability-witness-v1",
+        "task_id": TASK,
+        "status": "source_bound_finding_reproduced; proposed review, not approved",
+        "generator_path": source_path.relative_to(root).as_posix(),
+        "generator_sha256": source_sha,
+        "probe_path": Path(__file__).resolve().relative_to(root).as_posix(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "canonical_program": source_program,
+        "canonical_program_sha256": sha(source_program),
+        "canonical_rule_hash": sha(" ".join(source_program.split()))[:12],
+        "rival_description": "Ignore the bottom panel; mark each zero cell in the top panel red.",
+        "rival_program": RIVAL,
+        "rival_program_sha256": sha(RIVAL),
+        "label_source": "Catalog.generate canonical reference, protected isolated Racket runtime",
+        "rival_source": "Same local Racket bridge and rule wrapper, separate rival execution",
+        "reproduction_command": "WORK/.venv/bin/python review.py run ../.venv/bin/python generators/4043070e87c0/workspace/learnability_probe.py --out generators/4043070e87c0/workspace/learnability_witness.json",
+        "supported_request": {"seed": 0, "sample_index": 0, "n_train": 2,
+                              "n_test": 2, "difficulty": None, "overrides": {}},
+        "demonstration_policy": policy,
+        "supported_episode": episode,
+        "rival_predictions_by_sample_index": predictions,
+        "rival_matches_by_sample_index": matches,
+        "three_demo_view": {
+            "assembly": "Deliberate rearrangement of the four source-bound generated pairs; no grid or label edits.",
+            "train_sample_indices": [0, 1, 3], "query_sample_index": 2,
+            "train": [pairs[i] for i in [0, 1, 3]], "test": [pairs[2]],
+            "rival_fits_every_demo": True, "rival_differs_on_query": True,
+            "query_disagreements_zero_based": disagreements,
+            "default_sequential_episode": False,
+        },
+        "bounded_search": {
+            "rivals": ["top_only"], "seeds": list(range(8)),
+            "sample_indices": "0..4 for seeds 0..3; 0..3 for seeds 4..7",
+            "default_sequential_three_demo_witness_found": False,
+            "scope": "No prevalence estimate or exhaustive identifiability claim.",
+        },
+        "proposed_mitigation": "Ensure demonstrations include top-zero/bottom-nonzero and top-nonzero/bottom-zero positions, or reject materialized lessons where the corresponding panel-only rivals fit every demo but differ on a query.",
+        "approval_changed": False,
+        "generator_changed": False,
+        "source_authorities_changed": False,
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"task_id": TASK, "generator_sha256": source_sha,
+                      "supported_demo_matches": matches[:2],
+                      "assembled_three_demo_matches": [matches[i] for i in [0, 1, 3]],
+                      "query_disagreements": disagreements, "receipt": str(args.out)}))
+
+
+if __name__ == "__main__":
+    main()
