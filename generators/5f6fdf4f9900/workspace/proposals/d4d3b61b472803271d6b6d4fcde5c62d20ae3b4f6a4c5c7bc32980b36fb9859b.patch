@@ -0,0 +1,135 @@
+"""Replay one generated three-demo lesson against a left-right-only rival.
+
+Run from WORK/repo through the packet wrapper:
+  python3 generators/f283b8535697/workspace/bounded_lr_shortcut.py \
+      --out ../checks/f283b8535697/lr-shortcut
+
+This is reviewer evidence only. It changes no generator or selected rule.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles.catalog import Catalog
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from arcpuzzles.runtime import generate
+
+
+TASK = "f283b8535697"
+SEED = 11
+
+
+def digest(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    root = Path.cwd().resolve()
+    target = args.out.resolve()
+    if target.exists():
+        raise ValueError("Choose a fresh evidence output directory")
+    catalog = Catalog(root)
+    selected = catalog.get(TASK)
+    programs = {variant["program_solution"] for variant in selected["variants"]}
+    if len(programs) != 1:
+        raise ValueError("This probe requires one exact selected canonical program")
+    canonical = next(iter(programs))
+    prefix, tail = canonical.split("             (define (get-pixel r c)", 1)
+    _, suffix = tail.split("             (build-grid oh ow", 1)
+    rival = prefix + """             (define (get-pixel r c)
+               (let ((v (at g r (- (- w 1) c))))
+                 (if (= v 1) 0 v)))
+             (build-grid oh ow""" + suffix
+
+    # Omitted n_train exercises the declared automatic three-demo policy.
+    episode = generate(catalog, TASK, count=1, seed=SEED, n_train=None,
+                       n_test=1, timeout=45)[0]
+    if episode["program"] != canonical or episode.get("sample_indices") != [0, 1, 2, 3]:
+        raise ValueError("Native generation differs from the bounded discovery case")
+
+    source = root / selected["generator"]
+    runtime = root / "shared/runtime"
+    with _local_imports(runtime, source.parent):
+        spec = importlib.util.spec_from_file_location("peer_f283_review", source)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        apply, identity, bridge = _real_evaluator(runtime)
+        checks, predictions = [], {"train": [], "test": []}
+        evaluations = 0
+        try:
+            for split in ("train", "test"):
+                for index, pair in enumerate(episode[split]):
+                    grid = _grid(pair["input"])
+                    errors = module.self_check(grid)
+                    if errors:
+                        raise ValueError(f"Unexpected unlawful input: {errors}")
+                    actual = _grid(apply(canonical, grid))
+                    alternate = _grid(apply(rival, grid))
+                    evaluations += 2
+                    if actual != pair["output"]:
+                        raise ValueError("Native label differs from protected replay")
+                    differences = [
+                        {"row": r, "col": c, "canonical": actual[r][c],
+                         "rival": alternate[r][c]}
+                        for r in range(len(actual)) for c in range(len(actual[0]))
+                        if actual[r][c] != alternate[r][c]
+                    ]
+                    predictions[split].append(alternate)
+                    checks.append({"split": split, "pair_index": index,
+                                   "marker_family": module._marker_family(grid),
+                                   "self_check": errors,
+                                   "rival_matches": not differences,
+                                   "different_cells": differences})
+        finally:
+            bridge.close()
+    fits_demos = all(check["rival_matches"] for check in checks if check["split"] == "train")
+    differs_query = any(not check["rival_matches"] for check in checks if check["split"] == "test")
+    if not (fits_demos and differs_query):
+        raise ValueError("The claimed bounded ambiguity did not replay")
+    if catalog.describe(TASK)["generator_sha256"] != selected["generator_sha256"]:
+        raise ValueError("Generator changed during review")
+
+    result = {
+        "schema": "arcpuzzles-bounded-peer-review-v1",
+        "task_id": TASK,
+        "status": "underidentified_generated_lesson",
+        "source_binding": {
+            "generator": selected["generator"],
+            "generator_sha256": selected["generator_sha256"],
+            "rule_hash": selected["rule_hash"],
+            "canonical_program_sha256": digest(canonical),
+            "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        },
+        "request": {"seed": SEED, "sample_index": 0, "n_train": None,
+                    "resolved_train": 3, "n_test": 1, "difficulty": None,
+                    "overrides": {}},
+        "racket": identity,
+        "protected_replay_evaluations": evaluations,
+        "native_generation_labels": 4,
+        "canonical_program": canonical,
+        "rival_program": rival,
+        "rival_program_sha256": digest(rival),
+        "rival_description": "Copy the left-right mirror of each marker cell; replace a still-blue mirror value with zero, without up-down or 180-degree fallback.",
+        "episode": episode,
+        "rival_predictions": predictions,
+        "checks": checks,
+        "finding": "All three native demos fit the left-right-only rival, but the v-band query requires clean vertical/180-degree fallback and disagrees.",
+        "suggested_repair": "Select a v-band demonstration when the query needs fallback beyond the left-right mirror; declare and check this finite rival when assembling lessons. Keep the canonical transformation unchanged.",
+        "limits": "One source-bound native episode and one named rival. This is a generated-lesson teaching finding, not a canonical label error, population-rate estimate, or universal uniqueness claim. No generator repair or owner acceptance performed.",
+    }
+    target.mkdir(parents=True)
+    (target / "review.json").write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps({"status": result["status"], "source_binding": result["source_binding"],
+                      "racket": identity, "protected_replay_evaluations": evaluations,
+                      "checks": checks, "evidence": str(target / "review.json")}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
