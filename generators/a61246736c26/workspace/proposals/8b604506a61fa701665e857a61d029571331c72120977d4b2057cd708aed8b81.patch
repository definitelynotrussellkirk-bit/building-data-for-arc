+def _frame_rival(grid, *, fixed_palette=False, force_same_row_zero=False):
+    parsed = _source_parse(grid)
+    size = parsed["size"]
+    rows = []
+    for col in range(len(parsed["col_bands"])):
+        rows.append(next(row for row in range(3)
+                         if _solid_color(parsed["cores"][row][col], size) not in (None, 2, 8)))
+    out = rule_mirror(grid)
+    same_row = len(set(rows)) == 1
+    for col, solid_row in enumerate(rows):
+        target = (_STANDARD_FRAMES[solid_row] if fixed_palette
+                  else 0 if force_same_row_zero and same_row
+                  else parsed["row_colors"][solid_row])
+        pattern = next(parsed["cores"][row][col] for row in range(3)
+                       if _is_pattern(parsed["cores"][row][col]))
+        for r in range(size):
+            for c in range(size):
+                if pattern[r][c] == 1:
+                    out[r][col * (size + 1) + c] = target
+    return out
+
+
+def _same_row_zero_frame(grid):
+    return _frame_rival(grid, force_same_row_zero=True)
+
+
+def _fixed_row_palette(grid):
+    return _frame_rival(grid, fixed_palette=True)
+
+
+def _strip_only_when_same_row(grid):
+    info = _analysis(grid)
+    if info["errors"]:
+        raise ValueError("; ".join(info["errors"]))
+    return info["output"] if len(set(info["solid_rows"])) == 1 else _fixed_row_palette(grid)
+
+
+def _has_mixed_reassigned_frame(grid):
+    info = _analysis(grid)
+    return (not info["errors"] and len(set(info["solid_rows"])) > 1
+            and any(info["row_colors"][row] != _STANDARD_FRAMES[row]
+                    for row in info["solid_rows"]))
+
+
+def _has_nonzero_same_row(grid):
+    info = _analysis(grid)
+    return (not info["errors"] and len(set(info["solid_rows"])) == 1
+            and info["row_colors"][info["solid_rows"][0]] != 0)
+
+
+def _has_reassigned_frame(grid):
+    info = _analysis(grid)
+    return (not info["errors"] and any(info["row_colors"][row] != _STANDARD_FRAMES[row]
+                                      for row in info["solid_rows"]))
+
+
+def strict_canonical_like(grid):
+    """The validated tile/swatch reasoning manifold, including lawful variants."""
+    return self_check(grid)
+
