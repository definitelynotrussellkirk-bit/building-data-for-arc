+SEMANTIC_RIVALS = {"same_row_zero_frame": _same_row_zero_frame,
+                   "fixed_row_palette": _fixed_row_palette,
+                   "strip_only_when_same_row": _strip_only_when_same_row}
+CANONICAL_SHORTCUTS = dict(SEMANTIC_RIVALS)
+LESSON_COMPETITORS = dict(SEMANTIC_RIVALS)
+SEMANTIC_WITNESSES = {"nonzero_same_row": _has_nonzero_same_row,
+                      "reassigned_frame": _has_reassigned_frame,
+                      "mixed_reassigned_frame": _has_mixed_reassigned_frame}
+WITNESS_RIVALS = {"nonzero_same_row": ["same_row_zero_frame"],
