+"""Source-bound lesson probe for an orientation-gated T-tetromino shortcut.
+
+The wrong rule recolors green T objects only when their three-cell bar is
+horizontal.  A deterministic current lesson (seed 0, medium samples 20..22)
+has horizontal-bar Ts in both visible demonstrations and a side-facing T in
+the query.  Reference labels come only from public ``Catalog.apply``
+(protected Racket).
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Iterable, Sequence
+
+TASK_ID = "4537fc1035d2"
+SEED = 0
+START = 20
+DIFFICULTY = "medium"
+
+ORIENTATION_BY_SHAPE = {
+    ((0, 0), (0, 1), (0, 2), (1, 1)): "horizontal_bar_down",
+    ((0, 1), (1, 0), (1, 1), (2, 1)): "vertical_bar_left",
+    ((0, 1), (1, 0), (1, 1), (1, 2)): "horizontal_bar_up",
+    ((0, 0), (1, 0), (1, 1), (2, 0)): "vertical_bar_right",
+}
+HORIZONTAL_BAR_SHAPES = {
+    shape for shape, name in ORIENTATION_BY_SHAPE.items() if name.startswith("horizontal_bar_")
+}
+
+
+def _validate_grid(grid: Sequence[Sequence[int]]) -> None:
+    if not isinstance(grid, (list, tuple)) or not grid:
+        raise ValueError("expected a nonempty grid")
+    width = len(grid[0]) if isinstance(grid[0], (list, tuple)) else 0
+    if not width or any(not isinstance(row, (list, tuple)) or len(row) != width for row in grid):
+        raise ValueError("expected a rectangular grid")
+    if any(type(cell) is not int or not 0 <= cell <= 9 for row in grid for cell in row):
+        raise ValueError("expected ARC colors 0..9")
+
+
+def green_components(grid: Sequence[Sequence[int]]) -> list[tuple[tuple[int, int], ...]]:
+    """Return row-major four-connected color-3 components."""
+    _validate_grid(grid)
+    height, width = len(grid), len(grid[0])
+    seen: set[tuple[int, int]] = set()
+    components: list[tuple[tuple[int, int], ...]] = []
+    for row in range(height):
+        for col in range(width):
+            if grid[row][col] != 3 or (row, col) in seen:
+                continue
+            queue = [(row, col)]
+            seen.add((row, col))
+            cells: list[tuple[int, int]] = []
+            for current_row, current_col in queue:
+                cells.append((current_row, current_col))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nxt = current_row + dr, current_col + dc
+                    nr, nc = nxt
+                    if (0 <= nr < height and 0 <= nc < width
+                            and nxt not in seen and grid[nr][nc] == 3):
+                        seen.add(nxt)
+                        queue.append(nxt)
+            components.append(tuple(sorted(cells)))
+    return components
+
+
+def normalize(cells: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    cells = tuple(cells)
+    if not cells:
+        raise ValueError("cannot normalize an empty component")
+    min_row = min(row for row, _ in cells)
+    min_col = min(col for _, col in cells)
+    return tuple(sorted((row - min_row, col - min_col) for row, col in cells))
+
+
+def t_orientation_names(grid: Sequence[Sequence[int]]) -> list[str]:
+    return [
+        ORIENTATION_BY_SHAPE[shape]
+        for component in green_components(grid)
+        if (shape := normalize(component)) in ORIENTATION_BY_SHAPE
+    ]
+
+
+def horizontal_bar_t_only(grid: Sequence[Sequence[int]]) -> list[list[int]]:
+    """Wrong rule: recolor only the two T rotations with horizontal bars."""
+    output = [list(row) for row in grid]
+    for component in green_components(grid):
+        if normalize(component) in HORIZONTAL_BAR_SHAPES:
+            for row, col in component:
+                output[row][col] = 6
+    return output
+
+
+def all_t_rotations(grid: Sequence[Sequence[int]]) -> list[list[int]]:
+    """Independent Python mirror of the intended all-rotation rule."""
+    output = [list(row) for row in grid]
+    for component in green_components(grid):
+        if normalize(component) in ORIENTATION_BY_SHAPE:
+            for row, col in component:
+                output[row][col] = 6
+    return output
+
+
+def changed_cells(left: Sequence[Sequence[int]], right: Sequence[Sequence[int]]) -> int:
+    if len(left) != len(right) or any(len(a) != len(b) for a, b in zip(left, right)):
+        raise ValueError("changed_cells requires equal shapes")
+    return sum(a != b for row_a, row_b in zip(left, right) for a, b in zip(row_a, row_b))
+
+
+def run_probe(out: Path) -> dict[str, Any]:
+    from arcpuzzles import Catalog
+    from reviewer_support import find_root, load_selected_generator
+
+    root = find_root(__file__)
+    generator, source, source_sha256 = load_selected_generator(TASK_ID, root=root)
+    inputs = [generator.generate(SEED, START + offset, difficulty=DIFFICULTY) for offset in range(3)]
+    self_checks = [generator.self_check(grid, difficulty=DIFFICULTY) for grid in inputs]
+    applied = Catalog(root).apply(
+        TASK_ID,
+        inputs,
+        reference="canonical",
+        timeout=180,
+        check_generator_domain=True,
+    )
+
+    cases = []
+    wrong_matches: list[bool] = []
+    intended_matches: list[bool] = []
+    orientations: list[list[str]] = []
+    for offset, (grid, result) in enumerate(zip(inputs, applied["results"], strict=True)):
+        label = result.get("output")
+        wrong = horizontal_bar_t_only(grid)
+        intended = all_t_rotations(grid)
+        names = t_orientation_names(grid)
+        orientations.append(names)
+        wrong_matches.append(wrong == label)
+        intended_matches.append(intended == label)
+        cases.append({
+            "role": "demonstration" if offset < 2 else "query",
+            "seed": SEED,
+            "sample_index": START + offset,
+            "difficulty": DIFFICULTY,
+            "t_orientations": names,
+            "self_check": self_checks[offset],
+            "racket_valid_output": bool(result.get("valid_output")),
+            "racket_error": result.get("error"),
+            "input": grid,
+            "racket_output": label,
+            "shortcut_output": wrong,
+            "shortcut_matches_racket": wrong == label,
+            "intended_python_matches_racket": intended == label,
+            "shortcut_disagreement_cells": 0 if wrong == label else changed_cells(wrong, label),
+        })
+
+    demos_horizontal_only = all(
+        names and all(name.startswith("horizontal_bar_") for name in names)
+        for names in orientations[:2]
+    )
+    query_has_vertical = any(name.startswith("vertical_bar_") for name in orientations[2])
+    source_consistent = applied.get("generator_sha256") == source_sha256
+    passed = bool(
+        source_consistent
+        and applied.get("rule_hash_matches_catalog")
+        and all(not errors for errors in self_checks)
+        and all(case["racket_valid_output"] and not case["racket_error"] for case in cases)
+        and intended_matches == [True, True, True]
+        and wrong_matches == [True, True, False]
+        and demos_horizontal_only
+        and query_has_vertical
+        and cases[-1]["shortcut_disagreement_cells"] > 0
+    )
+    report = {
+        "schema": "arcpuzzles-peer-t-orientation-shortcut-v1",
+        "task_id": TASK_ID,
+        "status": "PASS" if passed else "FAIL",
+        "passed": passed,
+        "source_binding": {
+            "generator_path": source.relative_to(root).as_posix(),
+            "generator_sha256": source_sha256,
+            "catalog_generator_sha256": applied.get("generator_sha256"),
+            "source_consistent": source_consistent,
+            "executed_rule_hash": applied.get("executed_rule_hash"),
+            "rule_hash_matches_catalog": applied.get("rule_hash_matches_catalog"),
+            "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        },
+        "lesson": {
+            "sampler": "generate(seed=0, sample_index=20..22, difficulty='medium')",
+            "visible_demonstrations": 2,
+            "query_count": 1,
+            "t_orientations": orientations,
+            "wrong_rule": "Recolor green T tetrominoes only when the three-cell bar is horizontal.",
+            "wrong_rule_matches": wrong_matches,
+            "query_disagreement_cells": cases[-1]["shortcut_disagreement_cells"],
+        },
+        "reference_basis": "Public Catalog.apply canonical reference executed by protected Racket; Python rivals never supply labels.",
+        "reference_receipt": {key: value for key, value in applied.items() if key != "results"},
+        "cases": cases,
+        "recommendation": (
+            "Add the horizontal-bar-only rule to lesson competitors and guarantee that a side-facing T "
+            "appears in the visible demonstrations before any side-facing query."
+        ),
+        "limits": [
+            "This proves one deterministic current lesson is ambiguous against one finite shortcut, not universal unlearnability.",
+            "Production source is unchanged; the evidence is a reviewer proposal for the owner.",
+        ],
+    }
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return report
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = run_probe(args.out)
+    print(json.dumps({
+        "status": report["status"],
+        "t_orientations": report["lesson"]["t_orientations"],
+        "wrong_rule_matches": report["lesson"]["wrong_rule_matches"],
+        "query_disagreement_cells": report["lesson"]["query_disagreement_cells"],
+    }, sort_keys=True))
+    return 0 if report["passed"] else 1
+
+
