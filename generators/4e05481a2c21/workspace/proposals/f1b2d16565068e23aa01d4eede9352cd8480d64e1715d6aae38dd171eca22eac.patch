+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+PROBE = Path(__file__).resolve().parents[1] / "workspace" / "orientation_shortcut_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("orientation_shortcut_probe", PROBE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_horizontal_bar_shortcut_recolors_only_horizontal_bar_t_shapes():
+    probe = load_probe()
+    grid = [[0] * 12 for _ in range(8)]
+    # T with a horizontal three-cell bar.
+    for r, c in ((1, 1), (1, 2), (1, 3), (2, 2)):
+        grid[r][c] = 3
+    # Side-facing T with a vertical three-cell bar.
+    for r, c in ((1, 8), (2, 7), (2, 8), (3, 8)):
+        grid[r][c] = 3
+    # Non-T distractor.
+    for r, c in ((6, 1), (6, 2), (6, 3), (6, 4)):
+        grid[r][c] = 3
+
+    output = probe.horizontal_bar_t_only(grid)
+    assert all(output[r][c] == 6 for r, c in ((1, 1), (1, 2), (1, 3), (2, 2)))
+    assert all(output[r][c] == 3 for r, c in ((1, 8), (2, 7), (2, 8), (3, 8)))
+    assert all(output[r][c] == 3 for r, c in ((6, 1), (6, 2), (6, 3), (6, 4)))
+
+
+def test_orientation_names_distinguish_horizontal_and_vertical_bars():
+    probe = load_probe()
+    grid = [[0] * 12 for _ in range(8)]
+    for r, c in ((1, 1), (1, 2), (1, 3), (2, 2)):
+        grid[r][c] = 3
+    for r, c in ((1, 8), (2, 7), (2, 8), (3, 8)):
+        grid[r][c] = 3
+    names = probe.t_orientation_names(grid)
+    assert names == ["horizontal_bar_down", "vertical_bar_left"]
