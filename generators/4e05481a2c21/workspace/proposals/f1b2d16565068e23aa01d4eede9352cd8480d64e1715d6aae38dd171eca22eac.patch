+"""Source-bound lesson probe for a side-length-gated upscale shortcut.
+
+The wrong rule performs the intended per-cell 2x upscale through side length
+four, then tiles the whole grid for side length five.  A deterministic current
+lesson (seed 0, hard samples 17..19) has two 4x4 demonstrations and a 5x5
+query, so the shortcut fits every visible demonstration and fails the query.
+Reference labels come only from public ``Catalog.apply`` (protected Racket).
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Sequence
+
+TASK_ID = "2dacb90452ce"
+SEED = 0
+START = 17
+DIFFICULTY = "hard"
+
+
+def _validate_grid(grid: Sequence[Sequence[int]]) -> None:
+    if not isinstance(grid, (list, tuple)) or not grid:
+        raise ValueError("expected a nonempty grid")
+    width = len(grid[0]) if isinstance(grid[0], (list, tuple)) else 0
+    if not width or any(not isinstance(row, (list, tuple)) or len(row) != width for row in grid):
+        raise ValueError("expected a rectangular grid")
+    if any(type(cell) is not int or not 0 <= cell <= 9 for row in grid for cell in row):
+        raise ValueError("expected ARC colors 0..9")
+
+
+def upscale2(grid: Sequence[Sequence[int]]) -> list[list[int]]:
+    """The intended cellwise 2x nearest-neighbor upscale."""
+    _validate_grid(grid)
+    output: list[list[int]] = []
+    for row in grid:
+        expanded = [cell for cell in row for _ in range(2)]
+        output.extend((expanded[:], expanded[:]))
+    return output
+
+
+def tile_whole_grid(grid: Sequence[Sequence[int]]) -> list[list[int]]:
+    """Wrong operation: tile the complete input in a 2-by-2 arrangement."""
+    _validate_grid(grid)
+    doubled_rows = [list(row) + list(row) for row in grid]
+    return [row[:] for row in doubled_rows] + [row[:] for row in doubled_rows]
+
+
+def side_le_four_else_grid_tile(grid: Sequence[Sequence[int]]) -> list[list[int]]:
+    """Plausible finite shortcut that memorizes the visible size range."""
+    _validate_grid(grid)
+    return upscale2(grid) if len(grid) <= 4 else tile_whole_grid(grid)
+
+
+def changed_cells(left: Sequence[Sequence[int]], right: Sequence[Sequence[int]]) -> int:
+    if len(left) != len(right) or any(len(a) != len(b) for a, b in zip(left, right)):
+        raise ValueError("changed_cells requires equal shapes")
+    return sum(a != b for row_a, row_b in zip(left, right) for a, b in zip(row_a, row_b))
+
+
+def run_probe(out: Path) -> dict[str, Any]:
+    from arcpuzzles import Catalog
+    from reviewer_support import find_root, load_selected_generator
+
+    root = find_root(__file__)
+    generator, source, source_sha256 = load_selected_generator(TASK_ID, root=root)
+    inputs = [generator.generate(SEED, START + offset, difficulty=DIFFICULTY) for offset in range(3)]
+    self_checks = [generator.self_check(grid, difficulty=DIFFICULTY) for grid in inputs]
+    applied = Catalog(root).apply(
+        TASK_ID,
+        inputs,
+        reference="canonical",
+        timeout=180,
+        check_generator_domain=True,
+    )
+
+    cases = []
+    wrong_matches: list[bool] = []
+    intended_matches: list[bool] = []
+    for offset, (grid, result) in enumerate(zip(inputs, applied["results"], strict=True)):
+        label = result.get("output")
+        wrong = side_le_four_else_grid_tile(grid)
+        intended = upscale2(grid)
+        wrong_matches.append(wrong == label)
+        intended_matches.append(intended == label)
+        cases.append({
+            "role": "demonstration" if offset < 2 else "query",
+            "seed": SEED,
+            "sample_index": START + offset,
+            "difficulty": DIFFICULTY,
+            "input_side": len(grid),
+            "palette_count": len({cell for row in grid for cell in row}),
+            "self_check": self_checks[offset],
+            "racket_valid_output": bool(result.get("valid_output")),
+            "racket_error": result.get("error"),
+            "input": grid,
+            "racket_output": label,
+            "shortcut_output": wrong,
+            "shortcut_matches_racket": wrong == label,
+            "intended_python_matches_racket": intended == label,
+            "shortcut_disagreement_cells": 0 if wrong == label else changed_cells(wrong, label),
+        })
+
+    source_consistent = applied.get("generator_sha256") == source_sha256
+    passed = bool(
+        source_consistent
+        and applied.get("rule_hash_matches_catalog")
+        and all(not errors for errors in self_checks)
+        and all(case["racket_valid_output"] and not case["racket_error"] for case in cases)
+        and intended_matches == [True, True, True]
+        and wrong_matches == [True, True, False]
+        and [len(grid) for grid in inputs] == [4, 4, 5]
+        and cases[-1]["shortcut_disagreement_cells"] > 0
+    )
+    report = {
+        "schema": "arcpuzzles-peer-size-gate-shortcut-v1",
+        "task_id": TASK_ID,
+        "status": "PASS" if passed else "FAIL",
+        "passed": passed,
+        "source_binding": {
+            "generator_path": source.relative_to(root).as_posix(),
+            "generator_sha256": source_sha256,
+            "catalog_generator_sha256": applied.get("generator_sha256"),
+            "source_consistent": source_consistent,
+            "executed_rule_hash": applied.get("executed_rule_hash"),
+            "rule_hash_matches_catalog": applied.get("rule_hash_matches_catalog"),
+            "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        },
+        "lesson": {
+            "sampler": "generate(seed=0, sample_index=17..19, difficulty='hard')",
+            "visible_demonstrations": 2,
+            "query_count": 1,
+            "input_sides": [len(grid) for grid in inputs],
+            "wrong_rule": "Use correct per-cell 2x upscale when side <= 4; otherwise tile the whole grid 2x2.",
+            "wrong_rule_matches": wrong_matches,
+            "query_disagreement_cells": cases[-1]["shortcut_disagreement_cells"],
+        },
+        "reference_basis": "Public Catalog.apply canonical reference executed by protected Racket; Python rivals never supply labels.",
+        "reference_receipt": {key: value for key, value in applied.items() if key != "results"},
+        "cases": cases,
+        "recommendation": (
+            "Add this side-length gate to lesson competitors and require a visible side-5 demonstration "
+            "before any side-5 query, or otherwise constructively refute the gate without increasing the demo count."
+        ),
+        "limits": [
+            "This proves one deterministic current lesson is ambiguous against one finite shortcut, not universal unlearnability.",
+            "Production source is unchanged; the evidence is a reviewer proposal for the owner.",
+        ],
+    }
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return report
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = run_probe(args.out)
+    print(json.dumps({
+        "status": report["status"],
+        "input_sides": report["lesson"]["input_sides"],
+        "wrong_rule_matches": report["lesson"]["wrong_rule_matches"],
+        "query_disagreement_cells": report["lesson"]["query_disagreement_cells"],
+    }, sort_keys=True))
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
