+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+PROBE = Path(__file__).resolve().parents[1] / "workspace" / "size_gate_shortcut_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("size_gate_shortcut_probe", PROBE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_size_gate_uses_cellwise_upscale_through_side_four():
+    probe = load_probe()
+    grid = [[1, 2], [3, 4]]
+    assert probe.side_le_four_else_grid_tile(grid) == probe.upscale2(grid)
+
+
+def test_size_gate_switches_to_wrong_whole_grid_tiling_at_side_five():
+    probe = load_probe()
+    grid = [[(r * 5 + c) % 10 for c in range(5)] for r in range(5)]
+    prediction = probe.side_le_four_else_grid_tile(grid)
+    assert prediction == probe.tile_whole_grid(grid)
+    assert prediction != probe.upscale2(grid)
