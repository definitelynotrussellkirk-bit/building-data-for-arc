new file mode 100644
--- /dev/null
+++ b/repo/generators/758360aea29b/tests/test_generator_contract.py
@@ -0,0 +1,21 @@
+"""Regression for canonical non-rectangular objects and count overrides."""
+import importlib.util
+from pathlib import Path
+
+p=Path(__file__).resolve().parents[1]/'generator.py'
+spec=importlib.util.spec_from_file_location('selected_generator',p)
+mod=importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+
+def test_bbox_width_on_non_solid_canonical_style():
+    g=[[0]*12 for _ in range(8)]
+    for r,c in [(1,1),(1,2),(2,1),(2,2),(3,1)]:g[r][c]=8
+    for r,c in [(5,7),(5,8),(5,9)]:g[r][c]=4
+    assert mod.self_check(g)==[]
+
+def test_controls_and_invariants():
+    for n in (2,3,4,5,6,7):
+        for seed in range(8):
+            g=mod.generate(seed,0,difficulty=('easy' if n <= 4 else 'hard'),n_objects=n)
+            assert mod.self_check(g)==[]
+            assert mod.observe_overrides(g)['n_objects']==n
