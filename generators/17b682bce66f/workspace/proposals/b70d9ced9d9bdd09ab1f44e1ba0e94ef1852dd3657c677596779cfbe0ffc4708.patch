@@ -0,0 +1,269 @@
+#!/usr/bin/env python3
+"""Measure finite-hypothesis lesson identifiability for task 17b682bce66f.
+
+The target generator supplies inputs and its diagnostic ``rule_mirror`` outputs.
+The scorer supplies ``LESSON_COMPETITORS`` and, when available, the contrastive
+witness predicate.  Use ``review_probe.py parity`` separately to bind the mirror
+to the canonical Racket authority.  Reports are deterministic and outputs are
+exclusive so evidence is never overwritten accidentally.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import time
+from types import ModuleType
+from typing import Iterable
+
+
+TASK_ID = "17b682bce66f"
+DEFAULT_BANDS = ("easy", "medium", "hard")
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _load_source(path: Path, name: str) -> ModuleType:
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise ValueError(f"cannot load Python source: {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _score_lesson(demos, query, competitors) -> tuple[list[str], list[str]]:
+    """Return (demo survivors, query-changing survivors), preserving names."""
+    survived_demos: list[str] = []
+    query_changing: list[str] = []
+    for name, competitor in sorted(competitors.items()):
+        fits = all(
+            competitor(pair["input"]) == pair["output"]
+            for pair in demos
+        )
+        if not fits:
+            continue
+        survived_demos.append(name)
+        if competitor(query["input"]) != query["output"]:
+            query_changing.append(name)
+    return survived_demos, query_changing
+
+
+def _summary(rows: list[dict]) -> dict:
+    lessons = len(rows)
+    identifiable = sum(not row["query_changing_survivors"] for row in rows)
+    all_refuted = sum(not row["survived_demos"] for row in rows)
+    contrastive = sum(row["demo_window_has_contrastive_witness"] for row in rows)
+    return {
+        "lessons": lessons,
+        "identifiable": identifiable,
+        "identifiable_fraction": identifiable / lessons if lessons else 0.0,
+        "all_competitors_refuted": all_refuted,
+        "all_competitors_refuted_fraction": all_refuted / lessons if lessons else 0.0,
+        "demo_windows_with_contrastive_witness": contrastive,
+        "demo_windows_with_contrastive_witness_fraction": (
+            contrastive / lessons if lessons else 0.0
+        ),
+        "survived_demo_count_histogram": {
+            str(k): v
+            for k, v in sorted(Counter(len(r["survived_demos"]) for r in rows).items())
+        },
+        "query_changing_survivor_count_histogram": {
+            str(k): v
+            for k, v in sorted(
+                Counter(len(r["query_changing_survivors"]) for r in rows).items()
+            )
+        },
+    }
+
+
+def analyze_modules(
+    *,
+    target: ModuleType,
+    scorer: ModuleType,
+    bands: Iterable[str] = DEFAULT_BANDS,
+    lessons_per_band: int = 100,
+    seed_start: int = 100_000,
+    sample_index_start: int = 0,
+    sample_stride: int = 11,
+    demonstrations: int = 3,
+    max_examples: int = 5,
+) -> dict:
+    """Generate contiguous lessons and score every declared competitor."""
+    if lessons_per_band < 1:
+        raise ValueError("lessons_per_band must be >= 1")
+    if demonstrations < 1:
+        raise ValueError("demonstrations must be >= 1")
+    if sample_stride < 1:
+        raise ValueError("sample_stride must be >= 1")
+    competitors = getattr(scorer, "LESSON_COMPETITORS", None)
+    if not isinstance(competitors, dict) or not competitors:
+        raise ValueError("scorer must declare a non-empty LESSON_COMPETITORS dict")
+    if not all(callable(fn) for fn in competitors.values()):
+        raise ValueError("every LESSON_COMPETITORS value must be callable")
+    generate = getattr(target, "generate", None)
+    mirror = getattr(target, "rule_mirror", None)
+    if not callable(generate) or not callable(mirror):
+        raise ValueError("target must expose callable generate and rule_mirror")
+    witness = getattr(scorer, "_is_contrastive_witness", None)
+
+    all_rows: list[dict] = []
+    per_band: dict[str, dict] = {}
+    ambiguous_examples: list[dict] = []
+    band_names = tuple(bands)
+    for band_index, band in enumerate(band_names):
+        band_rows: list[dict] = []
+        for lesson_index in range(lessons_per_band):
+            seed = seed_start + band_index * lessons_per_band + lesson_index
+            sample_index = sample_index_start + lesson_index * sample_stride
+            grids = [
+                generate(seed, sample_index + offset, difficulty=band)
+                for offset in range(demonstrations + 1)
+            ]
+            demos = [
+                {"input": grid, "output": mirror(grid)}
+                for grid in grids[:demonstrations]
+            ]
+            query = {"input": grids[-1], "output": mirror(grids[-1])}
+            survived, query_changing = _score_lesson(demos, query, competitors)
+            has_witness = bool(callable(witness)) and any(
+                bool(witness(pair["input"])) for pair in demos
+            )
+            row = {
+                "band": band,
+                "lesson_index": lesson_index,
+                "seed": seed,
+                "sample_index": sample_index,
+                "replay": (
+                    f"band={band} seed={seed} sample_index={sample_index} "
+                    f"demos={demonstrations}"
+                ),
+                "demo_window_has_contrastive_witness": has_witness,
+                "survived_demos": survived,
+                "query_changing_survivors": query_changing,
+                "identifiable": not query_changing,
+                "all_competitors_refuted": not survived,
+            }
+            band_rows.append(row)
+            all_rows.append(row)
+            if query_changing and len(ambiguous_examples) < max_examples:
+                ambiguous_examples.append(row)
+        per_band[band] = _summary(band_rows)
+
+    return {
+        "schema": "lesson-identifiability-probe-v1",
+        "task_id": TASK_ID,
+        "competitor_count": len(competitors),
+        "bands": per_band,
+        "overall": _summary(all_rows),
+        "ambiguous_examples": ambiguous_examples,
+        "measurement_note": (
+            "Finite declared-hypothesis audit using the target rule_mirror. "
+            "It is not a proof against every conceivable rule and is not model accuracy."
+        ),
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--runtime", type=Path, required=True)
+    parser.add_argument("--target-file", type=Path)
+    parser.add_argument("--scorer-file", type=Path)
+    parser.add_argument("--label", default="candidate")
+    parser.add_argument("--bands", default=",".join(DEFAULT_BANDS))
+    parser.add_argument("--lessons-per-band", type=int, default=100)
+    parser.add_argument("--seed-start", type=int, default=100_000)
+    parser.add_argument("--sample-index-start", type=int, default=0)
+    parser.add_argument("--sample-stride", type=int, default=11)
+    parser.add_argument("--demonstrations", type=int, default=3)
+    parser.add_argument("--max-examples", type=int, default=5)
+    parser.add_argument("--require-identifiable", action="store_true")
+    parser.add_argument("--require-all-refuted", action="store_true")
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+
+    runtime = args.runtime.resolve()
+    if not (runtime / "RUNTIME_MANIFEST.json").is_file():
+        parser.error("runtime lacks RUNTIME_MANIFEST.json; stage it first")
+    if args.out.exists():
+        parser.error("output already exists; choose a new evidence path")
+    sys.path.insert(0, str(runtime))
+    default_source = (
+        runtime
+        / "puzzle_generators"
+        / "per_puzzle"
+        / TASK_ID
+        / "generator.py"
+    )
+    target_path = (args.target_file or default_source).resolve()
+    scorer_path = (args.scorer_file or default_source).resolve()
+    if not target_path.is_file() or not scorer_path.is_file():
+        parser.error("target/scorer source file is missing")
+
+    start = time.monotonic()
+    target = _load_source(target_path, "lesson_probe_target")
+    scorer = _load_source(scorer_path, "lesson_probe_scorer")
+    bands = tuple(item.strip() for item in args.bands.split(",") if item.strip())
+    if not bands:
+        parser.error("at least one band is required")
+    report = analyze_modules(
+        target=target,
+        scorer=scorer,
+        bands=bands,
+        lessons_per_band=args.lessons_per_band,
+        seed_start=args.seed_start,
+        sample_index_start=args.sample_index_start,
+        sample_stride=args.sample_stride,
+        demonstrations=args.demonstrations,
+        max_examples=args.max_examples,
+    )
+    report.update(
+        {
+            "label": args.label,
+            "runtime": str(runtime),
+            "target": {
+                "path": str(target_path),
+                "sha256": _sha256(target_path),
+                "version": getattr(target, "VERSION", None),
+            },
+            "scorer": {
+                "path": str(scorer_path),
+                "sha256": _sha256(scorer_path),
+                "version": getattr(scorer, "VERSION", None),
+            },
+            "parameters": {
+                "bands": bands,
+                "lessons_per_band": args.lessons_per_band,
+                "seed_start": args.seed_start,
+                "sample_index_start": args.sample_index_start,
+                "sample_stride": args.sample_stride,
+                "demonstrations": args.demonstrations,
+            },
+            "elapsed_seconds": time.monotonic() - start,
+            "command_argv": sys.argv if argv is None else [sys.argv[0], *argv],
+        }
+    )
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(args.out)
+
+    overall = report["overall"]
+    if args.require_identifiable and overall["identifiable"] != overall["lessons"]:
+        return 1
+    if (
+        args.require_all_refuted
+        and overall["all_competitors_refuted"] != overall["lessons"]
+    ):
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
