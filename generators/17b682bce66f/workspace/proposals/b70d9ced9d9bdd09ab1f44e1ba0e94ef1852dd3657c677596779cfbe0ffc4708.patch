+"""Regression tests for the reusable lesson-identifiability probe."""
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+
+TEST_FILE = Path(__file__).resolve()
+SOURCE_ROOT = next(
+    (p for p in TEST_FILE.parents
+     if (p / "shared/runtime/puzzle_generators").is_dir()),
+    None,
+)
+if SOURCE_ROOT is not None:
+    TASK_ROOT = TEST_FILE.parents[1]
+    PROBE_PATH = TASK_ROOT / "workspace/lesson_probe.py"
+    GENERATOR_PATH = TASK_ROOT / "generator.py"
+else:
+    RUNTIME_ROOT = TEST_FILE.parents[1]
+    PROBE_PATH = RUNTIME_ROOT / "workspace/lesson_probe.py"
+    GENERATOR_PATH = (
+        RUNTIME_ROOT
+        / "puzzle_generators"
+        / "per_puzzle"
+        / "17b682bce66f"
+        / "generator.py"
+    )
+
+
+def _load(path: Path, name: str):
+    if SOURCE_ROOT is not None:
+        sys.path.insert(0, str(SOURCE_ROOT / "shared/runtime"))
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_scheduled_windows_refute_every_declared_competitor():
+    probe = _load(PROBE_PATH, "lesson_probe_under_test")
+    generator = _load(GENERATOR_PATH, "lesson_generator_under_test")
+    report = probe.analyze_modules(
+        target=generator,
+        scorer=generator,
+        bands=("medium",),
+        lessons_per_band=5,
+        seed_start=17000,
+        sample_index_start=0,
+        sample_stride=11,
+        demonstrations=3,
+        max_examples=3,
+    )
+    summary = report["overall"]
+    assert summary["lessons"] == 5
+    assert summary["identifiable"] == 5
+    assert summary["all_competitors_refuted"] == 5
+    assert summary["demo_windows_with_contrastive_witness"] == 5
+    assert report["ambiguous_examples"] == []
