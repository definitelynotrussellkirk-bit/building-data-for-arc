+def _basic_grid_errors(grid) -> list[str]:
+    if not isinstance(grid, list) or not grid:
+        return ["grid must be a nonempty list of rows"]
+    if any(not isinstance(row, list) or not row for row in grid):
+        return ["rows must be nonempty lists"]
+    width = len(grid[0])
+    if any(len(row) != width for row in grid):
+        return ["grid must be rectangular"]
+    if any(type(value) is not int or not 0 <= value <= 9 for row in grid for value in row):
+        return ["all cells must be integer colours 0..9 (booleans are not colours)"]
+    return []
+
+
+def _commands(grid: Sequence[Sequence[int]]) -> list[tuple[int, int]]:
+    return [(col, value) for col, value in enumerate(grid[0]) if value != 0]
+
+
+def _body_components(grid: Sequence[Sequence[int]]) -> list[dict[str, object]]:
+    """Return row-major same-colour four-connected body components."""
+    h, w = len(grid), len(grid[0])
+    seen: set[Cell] = set()
+    result: list[dict[str, object]] = []
+    for r in range(1, h):
+        for c in range(w):
+            color = grid[r][c]
+            if color == 0 or (r, c) in seen:
+                continue
+            queue = deque([(r, c)])
+            seen.add((r, c))
+            cells: list[Cell] = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        1 <= nr < h
+                        and 0 <= nc < w
+                        and (nr, nc) not in seen
+                        and grid[nr][nc] == color
+                    ):
+                        seen.add((nr, nc))
+                        queue.append((nr, nc))
+            rows = [p[0] for p in cells]
+            cols = [p[1] for p in cells]
+            result.append(
+                {
+                    "color": color,
+                    "cells": tuple(cells),
+                    "r1": min(rows),
+                    "c1": min(cols),
+                    "r2": max(rows),
+                    "c2": max(cols),
+                }
+            )
+    return result
+
+
+def _crop_component(grid: Sequence[Sequence[int]], obj: dict[str, object]) -> Grid:
+    r1, c1, r2, c2 = (int(obj[key]) for key in ("r1", "c1", "r2", "c2"))
+    color = int(obj["color"])
+    cells = set(obj["cells"])
+    return [
+        [color if (r, c) in cells else 0 for c in range(c1, c2 + 1)]
+        for r in range(r1, r2 + 1)
+    ]
+
+
+def _rotate_cw(grid: Sequence[Sequence[int]]) -> Grid:
+    return [list(row) for row in zip(*grid[::-1])]
+
+
+def _rotate_180(grid: Sequence[Sequence[int]]) -> Grid:
+    return [list(reversed(row)) for row in reversed(grid)]
+
+
+def _flip_lr(grid: Sequence[Sequence[int]]) -> Grid:
+    return [list(reversed(row)) for row in grid]
+
+
+def _flip_ud(grid: Sequence[Sequence[int]]) -> Grid:
+    return [list(row) for row in reversed(grid)]
+
+
+def _transform(crop: Sequence[Sequence[int]], code: int) -> Grid:
+    if code == 1:
+        return _rotate_cw(crop)
+    if code == 2:
+        return _rotate_180(crop)
+    if code == 3:
+        return _flip_lr(crop)
+    return _flip_ud(crop)
+
+
+def _nearest_command_index(obj: dict[str, object], commands: Sequence[tuple[int, int]]) -> int:
+    if not commands:
+        raise ValueError("row 0 contains no commands")
+    doubled_center = int(obj["c1"]) + int(obj["c2"])
+    best_index = 0
+    best_distance = abs(doubled_center - 2 * commands[0][0])
+    for index in range(1, len(commands)):
+        distance = abs(doubled_center - 2 * commands[index][0])
+        if distance < best_distance:  # strict: ties retain the earlier command
+            best_index = index
+            best_distance = distance
+    return best_index
+
+
+def _transformed_crops(grid: Sequence[Sequence[int]]) -> list[Grid]:
+    commands = _commands(grid)
+    crops: list[Grid] = []
+    for obj in _body_components(grid):
+        command_index = _nearest_command_index(obj, commands)
+        crops.append(_transform(_crop_component(grid, obj), commands[command_index][1]))
+    return crops
+
+
+def _nonzero_count(grid: Sequence[Sequence[int]]) -> int:
+    return sum(value != 0 for row in grid for value in row)
+
+
+def _min_nonzero(grid: Sequence[Sequence[int]]) -> int:
+    values = [value for row in grid for value in row if value != 0]
+    if not values:
+        raise ValueError("cannot rank an empty crop")
+    return min(values)
+
+
+def rule_mirror(grid: Sequence[Sequence[int]]) -> Grid:
+    """Pure-Python mirror of the selected protected Racket authority."""
+    errors = _basic_grid_errors(grid)
+    if errors:
+        raise ValueError("; ".join(errors))
+    h, w = len(grid), len(grid[0])
+    commands = _commands(grid)
+    if not commands:
+        raise ValueError("row 0 contains no commands")
+    if any(not 1 <= code <= 4 for _, code in commands):
+        raise ValueError("command values must be in 1..4")
+
+    ordered = sorted(
+        _transformed_crops(grid),
+        key=lambda crop: (-_nonzero_count(crop), _min_nonzero(crop)),
+    )
+    out = full_grid(h, w, 0)
+    left = 0
+    for crop in ordered:
+        for r, row in enumerate(crop):
+            for c, value in enumerate(row):
+                rr, cc = 1 + r, left + c
+                if value != 0 and 0 <= rr < h and 0 <= cc < w:
+                    out[rr][cc] = value
+        left += len(crop[0]) + 1
+    return out
+
+
+def apply_rule(grid: Sequence[Sequence[int]]) -> Grid:
+    """Conventional alias used by repository audit tools."""
+    return rule_mirror(grid)
 
 
