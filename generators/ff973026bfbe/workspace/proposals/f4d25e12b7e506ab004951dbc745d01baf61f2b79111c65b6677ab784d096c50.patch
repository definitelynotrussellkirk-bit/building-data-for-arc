+def _validate_overrides(overrides: dict[str, object]) -> None:
+    unknown = sorted(set(overrides) - set(AXES))
+    if unknown:
+        raise ValueError(f"unknown override(s): {unknown}; valid axes: {sorted(AXES)}")
+    for name, value in overrides.items():
