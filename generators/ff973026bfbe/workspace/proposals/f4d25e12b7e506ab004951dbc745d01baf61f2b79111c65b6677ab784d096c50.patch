+def _slot_lefts(width: int, count: int) -> list[int]:
+    """Evenly spread two-column objects with at least one blank column."""
+    if count == 1:
+        return [(width - 2) // 2]
+    span = width - 2
+    lefts = [(index * span) // (count - 1) for index in range(count)]
+    if any(b - a < 3 for a, b in zip(lefts, lefts[1:])):
+        raise ValueError(f"width {width} cannot isolate {count} two-column objects")
+    return lefts
 
 
