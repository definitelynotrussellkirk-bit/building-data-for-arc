(rule! (let ((dummy 0))
  (define (e8b-list< a b)
    (cond ((empty? a) #f)
          ((< (first a) (first b)) #t)
          ((> (first a) (first b)) #f)
          (else (e8b-list< (rest a) (rest b)))))
  (define (same-area-bbox? a b)
    (let ((ba (obj-bbox a)) (bb (obj-bbox b)))
      (and (= (length (obj-cells a)) (length (obj-cells b)))
           (= (- (third ba) (first ba)) (- (third bb) (first bb)))
           (= (- (fourth ba) (second ba)) (- (fourth bb) (second bb))))))
  (let* ((objs (sort (objects g 0)
                     (lambda (a b)
                       (let ((ba (obj-bbox a)) (bb (obj-bbox b)))
                         (e8b-list< (list (first ba) (second ba))
                                    (list (first bb) (second bb)))))))
         (n (length objs)))
    (grid-from-fn n n
      (lambda (r c)
        (cond ((= r c) 5)
              ((same-area-bbox? (list-ref objs r) (list-ref objs c)) 8)
              (else 0)))))))
