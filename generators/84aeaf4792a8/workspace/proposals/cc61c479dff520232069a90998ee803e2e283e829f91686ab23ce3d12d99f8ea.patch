+#!/usr/bin/env python3
+"""Bounded protected-Racket learnability probe for task 95315dd52287.
+
+The probe labels final generator inputs with the canonical Racket rule, checks
+Python/Racket parity, and rotates each four-pair window through all three-demo
+holdouts against the generator's finite declared rival set.  Its conclusion is
+finite: passing does not prove universal rule uniqueness.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parent
+REPO = HERE.parents[2]
+RUNTIME = REPO / "shared" / "runtime"
+if str(RUNTIME) not in sys.path:
+    sys.path.insert(0, str(RUNTIME))
+
+TASK_ID = "95315dd52287"
+
+
+def _load_generator():
+    path = TASK_HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location("lesson_probe_generator_95315dd52287", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module, path
+
+
+def _program():
+    path = REPO / "shared" / "data" / "canonical" / "puzzles.jsonl"
+    for line in path.read_text().splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            return row["program_solution"]
+    raise KeyError(TASK_ID)
+
+
+def _sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _grid_sha(grid) -> str:
+    return _sha_bytes(json.dumps(grid, separators=(",", ":")).encode())
+
+
+def run(out: Path, *, seeds=(0, 17), starts=range(9)) -> dict:
+    from arcpuzzles.parametric_worker import _real_evaluator
+
+    gen, source = _load_generator()
+    if out.exists():
+        raise FileExistsError(out)
+    out.mkdir(parents=True)
+    apply, identity, bridge = _real_evaluator(RUNTIME)
+    program = _program()
+    labels = {}
+    windows = 0
+    rotations = 0
+    findings = []
+    profiles = {"shapes": set(), "origins": set(), "color_counts": set(), "sizes": set()}
+    rival_matches = {name: 0 for name in gen.SEMANTIC_RIVALS}
+    calls = []
+
+    try:
+        for seed in seeds:
+            for band in (None, "easy", "medium", "hard"):
+                for start in starts:
+                    pairs = []
+                    for offset in range(4):
+                        index = start + offset
+                        grid = gen.generate(seed, index, difficulty=band)
+                        key = json.dumps(grid, separators=(",", ":"))
+                        if key not in labels:
+                            output = apply(program, grid)
+                            expected = gen.intended_output(grid)
+                            if output != expected:
+                                findings.append({"kind": "python_racket_mismatch", "seed": seed,
+                                                 "difficulty": band, "sample_index": index})
+                            labels[key] = output
+                            calls.append({"input_sha256": _grid_sha(grid),
+                                          "output_sha256": _grid_sha(output)})
+                        output = deepcopy(labels[key])
+                        info = gen._analyze(grid)
+                        profiles["shapes"].add(info["shape"])
+                        profiles["origins"].add(info["origin"])
+                        profiles["color_counts"].add(len(info["colors"]))
+                        profiles["sizes"].add(len(info["cells"]))
+                        for name, rival in gen.SEMANTIC_RIVALS.items():
+                            rival_matches[name] += int(rival(grid) == output)
+                        pairs.append({"input": grid, "output": output})
+                    windows += 1
+                    for query_index in range(4):
+                        query = pairs[query_index]
+                        demos = [pair for i, pair in enumerate(pairs) if i != query_index]
+                        reasons = gen.lesson_identifiable(demos, query)
+                        if reasons:
+                            findings.append({"kind": "ambiguous_rotation", "seed": seed,
+                                             "difficulty": band, "start": start,
+                                             "query_index": query_index, "reasons": reasons})
+                        rotations += 1
+    finally:
+        bridge.close()
+
+    report = {
+        "schema": "arcpuzzles-peer-lesson-probe-v1",
+        "task_id": TASK_ID,
+        "status": "pass" if not findings else "fail",
+        "generator_sha256": _sha_bytes(source.read_bytes()),
+        "rule_hash": gen.RULE_HASH,
+        "seeds": list(seeds),
+        "difficulties": [None, "easy", "medium", "hard"],
+        "window_starts": list(starts),
+        "windows": windows,
+        "query_rotations": rotations,
+        "unique_protected_racket_labels": len(labels),
+        "racket_evaluations": len(calls),
+        "racket": identity,
+        "declared_rivals": list(gen.SEMANTIC_RIVALS),
+        "rival_authoritative_matches": rival_matches,
+        "coverage": {
+            "distinct_shapes": len(profiles["shapes"]),
+            "distinct_origins": len(profiles["origins"]),
+            "color_counts": sorted(profiles["color_counts"]),
+            "object_sizes": sorted(profiles["sizes"]),
+        },
+        "findings": findings,
+        "scope": "Finite protected-Racket parity and declared-rival rotation audit; not universal uniqueness.",
+    }
+    (out / "report.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    (out / "execution_calls.json").write_text(json.dumps(calls, indent=2, sort_keys=True) + "\n")
+    return report
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = run(args.out)
+    print(json.dumps({key: report[key] for key in (
+        "status", "windows", "query_rotations", "unique_protected_racket_labels",
+        "racket_evaluations", "rival_authoritative_matches", "coverage")}, sort_keys=True))
+    return 0 if report["status"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
