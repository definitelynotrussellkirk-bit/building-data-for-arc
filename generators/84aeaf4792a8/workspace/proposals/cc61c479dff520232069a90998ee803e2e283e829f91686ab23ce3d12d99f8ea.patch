+def _derived_rng(seed: int, split: str, index: int) -> random.Random:
+    payload = f"{TASK_ID}:equivalence-policy-v1:{seed}:{split}:{index}".encode()
+    return random.Random(int.from_bytes(hashlib.sha256(payload).digest()[:16], "big"))
