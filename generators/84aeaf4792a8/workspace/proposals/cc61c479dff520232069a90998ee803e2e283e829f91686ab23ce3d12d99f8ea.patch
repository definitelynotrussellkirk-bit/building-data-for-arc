+"""Regressions for the repaired move-object-to-anchor generator."""
+from __future__ import annotations
+
+from copy import deepcopy
+from importlib import util
+import json
+from pathlib import Path
+import random
+import sys
+
+import pytest
+
+_REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(_REPO / "shared" / "runtime"))
+
+from reviewer_support import canonical_pairs, find_root
+
+TASK_ID = "95315dd52287"
+ROOT = find_root(__file__)
+HOME = Path(__file__).resolve().parents[1]
+
+
+def _load_generator():
+    path = HOME / "generator.py"
+    spec = util.spec_from_file_location("generator_95315dd52287", path)
+    assert spec and spec.loader
+    module = util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+gen = _load_generator()
+PAIRS = canonical_pairs(TASK_ID, root=ROOT)
+FIXED_L = ((0, 0), (0, 1), (1, 1))
+
+
+def _blob(grid):
+    cells = [(r, c, value) for r, row in enumerate(grid) for c, value in enumerate(row)
+             if value not in (0, 8)]
+    assert cells
+    r0 = min(r for r, _, _ in cells)
+    c0 = min(c for _, c, _ in cells)
+    shape = tuple(sorted((r - r0, c - c0) for r, c, _ in cells))
+    return {
+        "cells": cells,
+        "shape": shape,
+        "origin": (r0, c0),
+        "colors": {value for _, _, value in cells},
+    }
+
+
+def _anchor(grid):
+    anchors = [(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 8]
+    assert len(anchors) == 1
+    return anchors[0]
+
+
+def _oracle(grid):
+    height, width = len(grid), len(grid[0])
+    obj = _blob(grid)
+    r0, c0 = obj["origin"]
+    ar, ac = _anchor(grid)
+    out = [[0 for _ in range(width)] for _ in range(height)]
+    for r, c, value in obj["cells"]:
+        out[ar + r - r0][ac + c - c0] = value
+    return out
+
+
+def _fixed_orientation_rival(grid):
+    height, width = len(grid), len(grid[0])
+    values = [value for _, _, value in sorted(_blob(grid)["cells"])]
+    out = [[0 for _ in range(width)] for _ in range(height)]
+    ar, ac = _anchor(grid)
+    for value, (dr, dc) in zip(values, FIXED_L):
+        if 0 <= ar + dr < height and 0 <= ac + dc < width:
+            out[ar + dr][ac + dc] = value
+    return out
+
+
+def _labeled(grid):
+    return {"input": deepcopy(grid), "output": _oracle(grid)}
+
+
+def test_rule_pin_and_every_canonical_pair_are_accepted():
+    assert gen.RULE_HASH == "14aa51e44193"
+    for pair in PAIRS:
+        original = deepcopy(pair["input"])
+        assert gen.self_check(pair["input"]) == []
+        assert _oracle(pair["input"]) == pair["output"]
+        assert pair["input"] == original
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+@pytest.mark.parametrize("cells,colors", [(3, 1), (4, 2), (7, 3)])
+def test_exact_controls_are_constructive_and_observable(band, cells, colors):
+    requested = dict(grid_h=10, grid_w=11, blob_cells=cells, blob_colors=colors)
+    grid = gen.generate(117, 29, difficulty=band, **requested)
+    assert gen.self_check(grid) == []
+    observed = gen.observe_overrides(grid)
+    assert observed == requested
+    assert _oracle(grid) != grid
+
+
+@pytest.mark.parametrize("key,value", [
+    ("typo", 1),
+    ("grid_h", 5), ("grid_h", 15), ("grid_w", 5), ("grid_w", 15),
+    ("blob_cells", 2), ("blob_cells", 8),
+    ("blob_colors", 0), ("blob_colors", 4),
+    ("grid_h", True), ("grid_w", 9.5), ("blob_cells", "3"),
+])
+def test_invalid_overrides_are_rejected_loudly(key, value):
+    with pytest.raises((TypeError, ValueError)):
+        gen.generate(0, 0, **{key: value})
+
+
+def test_incompatible_color_count_is_rejected_not_clipped():
+    with pytest.raises(ValueError):
+        gen.generate(0, 0, blob_cells=3, blob_colors=4)
+
+
+@pytest.mark.parametrize("grid", [
+    None, [], [[]], [[0], [0, 1]],
+    [[0] * 8 for _ in range(8)],
+    [[8] * 8 for _ in range(8)],
+])
+def test_self_check_rejects_malformed_or_semantically_empty_grids(grid):
+    assert gen.self_check(grid)
+
+
+def test_self_check_rejects_disconnected_blob_and_out_of_bounds_destination():
+    disconnected = [[0] * 8 for _ in range(8)]
+    disconnected[0][0] = 2
+    disconnected[2][2] = 3
+    disconnected[5][5] = 8
+    assert gen.self_check(disconnected)
+
+    clipped = [[0] * 8 for _ in range(8)]
+    clipped[0][0] = 2
+    clipped[0][1] = 3
+    clipped[1][1] = 2
+    clipped[7][7] = 8
+    assert gen.self_check(clipped)
+
+
+def test_default_distribution_varies_shape_position_color_count_and_anchor_relation():
+    shapes = set()
+    origins = set()
+    color_counts = set()
+    anchor_relations = set()
+    sizes = set()
+    for band in (None, "easy", "medium", "hard"):
+        for index in range(48):
+            grid = gen.generate(3100 + index, index, difficulty=band)
+            assert gen.self_check(grid) == []
+            obj = _blob(grid)
+            anchor = _anchor(grid)
+            shapes.add(obj["shape"])
+            origins.add(obj["origin"])
+            color_counts.add(len(obj["colors"]))
+            sizes.add(len(obj["cells"]))
+            anchor_relations.add((anchor[0] > obj["origin"][0], anchor[1] > obj["origin"][1]))
+    assert len(shapes) >= 8
+    assert len(origins) >= 8
+    assert color_counts == {1, 2, 3}
+    assert sizes >= {3, 4, 5, 6, 7}
+    assert len(anchor_relations) >= 3
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_every_three_draw_lesson_refutes_fixed_orientation_and_origin_shortcuts(band):
+    for start in range(18):
+        grids = [gen.generate(700 + start, start + offset, difficulty=band)
+                 for offset in range(gen.EXAMPLES_NEEDED)]
+        assert any(_blob(grid)["shape"] != FIXED_L for grid in grids)
+        assert any(_blob(grid)["origin"] != (0, 0) for grid in grids)
+        assert any(len(_blob(grid)["colors"]) == 1 for grid in grids)
+        assert any(_fixed_orientation_rival(grid) != _oracle(grid) for grid in grids)
+
+
+def test_every_rotation_of_four_draw_window_keeps_a_rival_counterexample():
+    for start in range(18):
+        pairs = [_labeled(gen.generate(1200, start + offset)) for offset in range(4)]
+        for query_index in range(4):
+            query = pairs[query_index]
+            demos = [pair for index, pair in enumerate(pairs) if index != query_index]
+            assert gen.lesson_identifiable(demos, query) == []
+
+
+def test_fixed_orientation_rival_matches_a_canonical_case_but_is_not_the_rule():
+    assert any(_fixed_orientation_rival(pair["input"]) == pair["output"] for pair in PAIRS)
+    witnesses = [gen.generate(91, index) for index in range(6)]
+    assert any(_fixed_orientation_rival(grid) != _oracle(grid) for grid in witnesses)
+    assert all(gen.SEMANTIC_RIVALS["fixed_orientation_L"](grid) == _fixed_orientation_rival(grid)
+               for grid in witnesses)
+
+
+def test_deterministic_without_global_random_or_shared_grid_mutation():
+    random.seed(12345)
+    state = random.getstate()
+    first = gen.generate(61, 4, difficulty="hard")
+    assert random.getstate() == state
+    snapshot = deepcopy(first)
+    first[0][0] = 9 if first[0][0] != 9 else 0
+    assert gen.generate(61, 4, difficulty="hard") == snapshot
+
+
+def test_selected_authority_is_still_the_canonical_program():
+    selected = next(
+        json.loads(line)
+        for line in (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines()
+        if json.loads(line).get("task_id") == TASK_ID
+    )
+    record = json.loads((ROOT / "shared/data/base/solutions/banks/e14e4b5836bc/"
+                         "M92__95315dd52287.json").read_text())
+    assert selected["program_solution"] == record["racket_target"]["target_code"]
+
+@pytest.mark.parametrize("bad", [True, False, 1.0, 1.75, "1"])
+def test_seed_rejects_coercible_nonintegers(bad):
+    with pytest.raises(TypeError):
+        gen.generate(bad, 0)
+
+
+@pytest.mark.parametrize("bad,error", [
+    (True, TypeError), (False, TypeError), (1.0, TypeError),
+    (1.75, TypeError), ("1", TypeError), (-1, ValueError),
+])
+def test_sample_index_is_a_literal_nonnegative_integer(bad, error):
+    with pytest.raises(error):
+        gen.generate(0, bad)
+
+
+def test_unknown_difficulty_is_rejected():
+    with pytest.raises(ValueError):
+        gen.generate(0, 0, difficulty="legendary")
