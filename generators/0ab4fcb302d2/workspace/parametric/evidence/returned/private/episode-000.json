  "racket_source": "(rule! (lambda (g)\n         (let* ((h (rows g))\n                (w (cols g))\n                (zero-row (first (filter (lambda (r)\n                                           (all? (lambda (c) (zero? (at g r c)))\n                                                 (range 0 w)))\n                                         (range 0 h))))\n                (zero-col (first (filter (lambda (c)\n                                           (all? (lambda (r) (zero? (at g r c)))\n                                                 (range 0 h)))\n                                         (range 0 w))))\n                (p2 (first (find-color g 2)))\n                (r2 (fst p2))\n                (c2 (snd p2))\n                (color (first (filter (lambda (v) (and (!= v 0) (!= v 2)))\n                                      (flatmap (lambda (r)\n                                                 (map (lambda (c) (at g r c))\n                                                      (range 0 w)))\n                                               (range 0 h)))))\n                (non-gap-rows (filter (lambda (r) (!= r zero-row)) (range 0 h)))\n                (non-gap-cols (filter (lambda (c) (!= c zero-col)) (range 0 w)))\n                (local-r (if (= r2 (first non-gap-rows)) 0 1))\n                (local-c (if (= c2 (first non-gap-cols)) 0 1))\n                (main-diag (= local-r local-c))\n                (gap-r (* zero-row 4))\n                (gap-c (* zero-col 4))\n                (top-r (if (zero? gap-r) 1 0))\n                (bot-r (if (= gap-r 8) 4 5))\n                (left-c (if (zero? gap-c) 1 0))\n                (right-c (if (= gap-c 8) 4 5))\n                (blocks (if main-diag\n                            (list (list top-r left-c) (list bot-r right-c))\n                            (list (list top-r right-c) (list bot-r left-c)))))\n           (grid-from-fn 9\n                         9\n                         (lambda (r c)\n                           (if (for/or ((b blocks))\n                                       (let* ((br (first b))\n                                              (bc (first (rest b))))\n                                         (and\n                                           (>= r br)\n                                           (< r (+ br 4))\n                                           (>= c bc)\n                                           (< c (+ bc 4)))))\n                               color\n                               0))))))",
