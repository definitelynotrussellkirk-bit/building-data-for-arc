  "programs": {
    "always_horizontal": "(rule!\n  (let* ((cmd (at g 0 0))\n         (colors (filter (lambda (v) (not (= v 0))) (remove-duplicates (map third (grid-cells g)))))\n         (endpoint-colors (filter (lambda (v) (not (= v cmd))) colors)))\n    (define counts (make-hash))\n    (define paints (make-hash))\n    (define (mark! p color)\n      (hash-update! counts (cons (first p) (second p)) add1 0)\n      (hash-set! paints (cons (first p) (second p)) (if (> (hash-ref counts (cons (first p) (second p))) 1) 8 color)))\n    (define (range-between a b)\n      (if (<= a b) (range a (+ b 1)) (reverse (range b (+ a 1)))))\n    (for ([color (in-list endpoint-colors)])\n      (define pts (find-color g color))\n      (when (= (length pts) 2)\n        (define a (first pts))\n        (define b (second pts))\n        (define first-leg\n          (if #t\n              (map (lambda (c) (list (first a) c)) (range-between (second a) (second b)))\n              (map (lambda (r) (list r (second a))) (range-between (first a) (first b)))))\n        (define second-leg\n          (if #t\n              (map (lambda (r) (list r (second b))) (range-between (first a) (first b)))\n              (map (lambda (c) (list (first b) c)) (range-between (second a) (second b)))))\n        (for ([p (in-list (append first-leg (rest second-leg)))])\n          (mark! p color))))\n    (for/fold ([out g]) ([key (in-list (hash-keys paints))])\n      (set-cell out (car key) (cdr key) (hash-ref paints key)))))",
