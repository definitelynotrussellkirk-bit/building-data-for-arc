+"""Replay one private, source-bound learnability witness with protected Racket.
+
+This preserves the original medium lesson at seed 0, sample indices 1..4.
+The weighted metric is a candidate alternative, never another official gold.
+No production source, official authority, or sampler is changed by this probe.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[4]
+TASK_ID = "a4333a244e11"
+EXPECTED_GENERATOR_SHA256 = "a895916472f9f6fef36efafb0fae0edf60f94f65675db17b6adea58bad5ebeb9"
+EXPECTED_RULE_HASH = "d568e0e496cf"
+sys.path[:0] = [str(ROOT / "shared/runtime"), str(ROOT / "src")]
+
+from arcpuzzles import Catalog  # noqa: E402
+from arcpuzzles.parametric_worker import _real_evaluator  # noqa: E402
+from reviewer_support import load_selected_generator, public_challenge_id  # noqa: E402
+
+
+def digest(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def oracle(grid, column_weight=1):
+    """Independent two-seed metric implementation used only for probe parity."""
+    seeds = [(r, c, v) for r, row in enumerate(grid) for c, v in enumerate(row)
+             if v not in (0, 8)]
+    if len(seeds) != 2:
+        raise ValueError("The retained witness must have exactly two seeds")
+    out = deepcopy(grid)
+    for r in range(2, len(grid) - 2):
+        for c in range(2, len(grid[0]) - 2):
+            if grid[r][c] != 0:
+                continue
+            distances = [abs(r - sr) + column_weight * abs(c - sc)
+                         for sr, sc, _ in seeds]
+            out[r][c] = (seeds[0][2] if distances[0] < distances[1]
+                         else seeds[1][2] if distances[1] < distances[0]
+                         else 0)
+    return out
+
+
+def main() -> int:
+    generator, source, source_hash = load_selected_generator(TASK_ID, root=ROOT)
+    if source_hash != EXPECTED_GENERATOR_SHA256:
+        raise RuntimeError("Generator source changed; this witness must be re-reviewed")
+    row = Catalog(ROOT).get(TASK_ID)["variants"][0]
+    gold = row["program_solution"]
+    normalized_hash = digest(" ".join(gold.split()).encode())[:12]
+    if normalized_hash != EXPECTED_RULE_HASH or generator.RULE_HASH != normalized_hash:
+        raise RuntimeError("Selected canonical authority changed")
+
+    # One metric-expression replacement; frame detection, preservation, and
+    # exact-tie handling remain identical to the selected canonical program.
+    original = "(+ (abs (- r (first s))) (abs (- c (second s))))"
+    alternative = "(+ (abs (- r (first s))) (* 2 (abs (- c (second s)))))"
+    if gold.count(original) != 1:
+        raise RuntimeError("Expected exactly one canonical distance expression")
+    rival = gold.replace(original, alternative)
+    indices = [1, 2, 3, 4]
+    grids = [generator.generate(0, index, difficulty="medium") for index in indices]
+    errors = [generator.self_check(grid) for grid in grids]
+    if any(errors):
+        raise RuntimeError(f"The original generated lesson is invalid: {errors}")
+
+    apply, identity, bridge = _real_evaluator((ROOT / "shared/runtime").resolve())
+    try:
+        native_gold = [apply(gold, deepcopy(grid)) for grid in grids]
+        native_rival = [apply(rival, deepcopy(grid)) for grid in grids]
+    finally:
+        bridge.close()
+    if native_gold != [oracle(grid) for grid in grids]:
+        raise RuntimeError("Protected canonical execution disagrees with the independent oracle")
+    if native_rival != [oracle(grid, 2) for grid in grids]:
+        raise RuntimeError("Protected candidate execution disagrees with its independent oracle")
+    if native_gold[:3] != native_rival[:3] or native_gold[3] == native_rival[3]:
+        raise RuntimeError("The candidate no longer fits every demo and changes the query")
+
+    train = [{"input": grid, "output": output}
+             for grid, output in zip(grids[:3], native_gold[:3], strict=True)]
+    query = {"input": grids[3], "output": native_gold[3]}
+    challenge = {"train": train, "test": [{"input": grids[3]}]}
+    differences = [{"row": r, "column": c, "gold": gold_value,
+                    "candidate": native_rival[3][r][c]}
+                   for r, row in enumerate(native_gold[3])
+                   for c, gold_value in enumerate(row)
+                   if gold_value != native_rival[3][r][c]]
+    report = {
+        "schema": "arcpuzzles-private-peer-learnability-witness-v1",
+        "task_id": TASK_ID,
+        "audit_id": "peer_audit_144102",
+        "status": "protected_racket_candidate_ambiguity_reproduced",
+        "source_binding": {
+            "generator_path": source.relative_to(ROOT).as_posix(),
+            "generator_sha256": source_hash,
+            "generator_version": generator.VERSION,
+            "probe_path": Path(__file__).relative_to(ROOT).as_posix(),
+            "probe_sha256": digest(Path(__file__).read_bytes()),
+            "canonical_rule_hash": normalized_hash,
+            "canonical_program_sha256": digest(gold.encode()),
+            "candidate_program_sha256": digest(rival.encode()),
+        },
+        "candidate": {
+            "name": "horizontal_steps_cost_two",
+            "role": "plausible alternative hypothesis; not official gold",
+            "description": "Fill by |row-seed_row| + 2*|column-seed_column|; exact ties stay zero.",
+            "canonical_expression": original,
