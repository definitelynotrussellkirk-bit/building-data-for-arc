+"""Bounded source-bound panel-XOR teaching review; all labels execute in Racket.
+
+Run from the outer packet directory:
+  WORK/.venv/bin/python review.py run python3 \
+    generators/b13481ce1294/workspace/peer_audit_144102/probe.py
+
+An existing output is refused. Use --out /tmp/panel-xor-replay.json to replay.
+This review does not change production approval or admit training data.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+
+
+TASK_ID = "b13481ce1294"
+EXPECTED_SOURCE_SHA256 = "4f966f58a5c4515c53743416e452f287de0d4f12caceccca2eea0156b4f9f4f8"
+EXPECTED_RULE_HASH = "d86f259d9d68"
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parents[1]
+ROOT = HERE.parents[3]
+
+
+def digest(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def rival(expression: str, *, right_r: str = "r", right_c: str = "c") -> str:
+    # On the admitted grammar there is exactly one centered separator. The
+    # rivals differ in the overlay operation or relative panel alignment.
+    return f"""(rule! (lambda (g)
+      (let* ((h (rows g)) (pw (/ (- (cols g) 1) 2))
+             (a (subgrid g 0 0 (- h 1) (- pw 1)))
+             (b (subgrid g 0 (+ pw 1) (- h 1) (- (cols g) 1))))
+        (grid-from-fn h pw
+          (lambda (r c)
+            (let ((av (at a r c)) (bv (at b {right_r} {right_c})))
+              {expression}))))))"""
+
+
+XOR = "(cond ((and (not (= av 0)) (= bv 0)) av) ((and (= av 0) (not (= bv 0))) bv) (else 0))"
+RIVALS = {
+    "union_left_priority": rival("(if (= av 0) bv av)"),
+    "cancel_equal_only": rival("(if (= av bv) 0 (if (= av 0) bv av))"),
+    "left_only": rival("(if (and (not (= av 0)) (= bv 0)) av 0)"),
+    "right_only": rival("(if (and (= av 0) (not (= bv 0))) bv 0)"),
+    "fixed_color_mask": rival("(if (or (and (= av 0) (not (= bv 0))) (and (not (= av 0)) (= bv 0))) 1 0)"),
+    "fill_empty_with_separator": rival(f"(if (and (= av 0) (= bv 0)) 8 {XOR})"),
+    "numeric_absolute_difference": rival("(abs (- av bv))"),
+    "mirror_right_horizontally": rival(XOR, right_c="(- (- pw 1) c)"),
+    "mirror_right_vertically": rival(XOR, right_r="(- (- h 1) r)"),
+    "global_color_cancellation": rival(
+        "(cond ((and (not (= av 0)) (empty? (find-color b av))) av) "
+        "((and (not (= bv 0)) (empty? (find-color a bv))) bv) (else 0))"
+    ),
+}
+
+
+def check_grid(grid):
+    assert isinstance(grid, list) and grid and isinstance(grid[0], list) and grid[0]
+    assert all(isinstance(row, list) and len(row) == len(grid[0]) for row in grid)
+    assert all(type(value) is int and 0 <= value <= 9 for row in grid for value in row)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, default=HERE / "probe.json")
+    args = parser.parse_args()
+    if args.out.exists():
+        raise FileExistsError(f"Refusing to overwrite retained evidence: {args.out}")
+
+    generator_path = TASK_HOME / "generator.py"
+    source_sha = digest(generator_path.read_bytes())
+    assert source_sha == EXPECTED_SOURCE_SHA256, "Assigned production source changed"
+    task = Catalog(root=ROOT).get(TASK_ID)
+    assert task["generator_sha256"] == source_sha
+    assert task["rule_hash"] == EXPECTED_RULE_HASH
+    variant = task["variants"][0]
+    canonical = variant["program_solution"]
+    spec = importlib.util.spec_from_file_location("_peer_b13481ce1294", generator_path)
+    assert spec is not None and spec.loader is not None
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+
+    cases = []
+    tests = variant["test"]
+    if isinstance(tests, dict):
+        tests = [tests]
+    for split, pairs in (("train", variant["train"]), ("test", tests)):
+        for index, pair in enumerate(pairs):
+            cases.append({"id": f"canonical_{split}_{index}", "lesson": "canonical",
+                          "split": split, "input": pair["input"],
+                          "recorded_output": pair["output"]})
+    for seed, split, difficulty in ((0, "train", None), (17, "test", "hard")):
+        for index in range(3):
+            grid = generator.generate(seed, index, difficulty=difficulty)
+            assert generator.self_check(grid) == []
+            cases.append({"id": f"generated_s{seed}_i{index}", "lesson": "generated",
+                          "split": split, "input": grid,
+                          "call": {"seed": seed, "sample_index": index,
+                                   "difficulty": difficulty, "overrides": {}}})
+
+    apply, identity, bridge = _real_evaluator(ROOT / "shared" / "runtime")
+    try:
+        for case in cases:
+            gold = apply(canonical, case["input"])
+            check_grid(gold)
+            case["gold"] = gold
+            if "recorded_output" in case:
+                assert gold == case["recorded_output"], case["id"]
+            outputs = {name: apply(program, case["input"]) for name, program in RIVALS.items()}
+            for output in outputs.values():
+                check_grid(output)
+            case["rival_outputs"] = outputs
+            case["matching_rivals"] = [name for name, output in outputs.items() if output == gold]
+    finally:
+        bridge.close()
+
+    lessons = []
+    for lesson in ("canonical", "generated"):
+        demos = [case for case in cases if case["lesson"] == lesson and case["split"] == "train"]
+        queries = [case for case in cases if case["lesson"] == lesson and case["split"] == "test"]
+        survivors = [name for name in RIVALS if all(name in case["matching_rivals"] for case in demos)]
+        conflicts = {name: [case["id"] for case in queries if name not in case["matching_rivals"]]
+                     for name in survivors}
+        conflicts = {name: ids for name, ids in conflicts.items() if ids}
+        lessons.append({"lesson": lesson, "demo_ids": [case["id"] for case in demos],
+                        "query_ids": [case["id"] for case in queries],
+                        "demo_survivors": survivors, "query_conflicting_survivors": conflicts})
+    assert digest(generator_path.read_bytes()) == source_sha, "Source drifted during probe"
+    result = {
+        "schema": "arcpuzzles-bounded-peer-teaching-probe-v1", "task_id": TASK_ID,
+        "finding": "no_issue_in_checked_finite_rivals" if not any(
+            lesson["query_conflicting_survivors"] for lesson in lessons
+        ) else "query_conflicting_demo_survivor",
+        "source_binding": {"generator_sha256": source_sha, "rule_hash": task["rule_hash"],
+                           "canonical_source_sha256": digest(canonical.encode()),
+                           "probe_sha256": digest(Path(__file__).read_bytes())},
+        "racket": identity, "canonical_program": canonical, "rival_programs": RIVALS,
+        "case_count": len(cases), "rival_count": len(RIVALS),
+        "racket_execution_count": len(cases) * (1 + len(RIVALS)),
+        "canonical_recorded_labels_matched": sum("recorded_output" in case for case in cases),
+        "lessons": lessons, "cases": cases,
+        "limits": "Two bounded lessons and ten explicit rivals; not universal identifiability, approval, or a full battery.",
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps({key: result[key] for key in (
+        "finding", "case_count", "rival_count", "racket_execution_count",
+        "canonical_recorded_labels_matched", "lessons", "source_binding"
+    )}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
