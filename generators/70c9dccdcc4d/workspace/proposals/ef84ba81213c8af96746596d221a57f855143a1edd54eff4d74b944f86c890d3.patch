+"""Task-local regression suite for the 70c9dccdcc4d generator repair."""
+from __future__ import annotations
+
+from copy import deepcopy
+import os
+from pathlib import Path
+import random
+import subprocess
+import sys
+
+import pytest
+
+from reviewer_support import canonical_pairs, find_root
+
+HOME = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(HOME / "workspace"))
+from reference_probe import (  # noqa: E402
+    BASES,
+    changed_cells,
+    frame,
+    geometry_output,
+    load_generator,
+    observed,
+)
+
+TASK_ID = "70c9dccdcc4d"
+gen = load_generator(os.environ.get("GENERATOR_UNDER_TEST"))
+PAIRS = canonical_pairs(TASK_ID, root=find_root(__file__), labeled_only=True)
+
+
+@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: f"{pair['split']}{pair['pair_index']}")
+def test_canonical_pairs_are_accepted_and_match_geometry(pair):
+    before = deepcopy(pair["input"])
+    assert gen.self_check(pair["input"]) == []
+    assert geometry_output(pair["input"]) == pair["output"]
+    assert pair["input"] == before
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_exact_overrides_are_observable_in_every_band(band):
+    requested = {
+        "grid_h": 10,
+        "grid_w": 14,
+        "n_marks": 6,
+        "n_distractors": 4,
+        "source_orientation": 7,
+        "target_orientation": 5,
+    }
+    grid = gen.generate(17, 9, difficulty=band, **requested)
+    assert gen.self_check(grid) == []
+    assert observed(grid) == requested
+    assert gen.observe_overrides(grid) == requested
+    assert len(changed_cells(grid, geometry_output(grid))) == requested["n_marks"]
+
+
+@pytest.mark.parametrize(
+    "key,value",
+    [
+        ("typo_axis", 1),
+        ("grid_h", 9),
+        ("grid_w", 13),
+        ("n_marks", 0),
+        ("n_marks", 7),
+        ("n_distractors", -1),
+        ("n_distractors", 5),
+        ("source_orientation", -1),
+        ("source_orientation", 8),
+        ("target_orientation", 8),
+        ("n_marks", 2.5),
+        ("grid_h", True),
+        ("n_distractors", "2"),
+    ],
+)
+def test_invalid_overrides_reject_loudly(key, value):
+    with pytest.raises((TypeError, ValueError)):
+        gen.generate(0, 0, **{key: value})
+
+
+@pytest.mark.parametrize("index", range(64))
+def test_all_frame_orientation_pairs_are_constructive(index):
+    source_orientation, target_orientation = divmod(index, 8)
+    requested = {
+        "grid_h": 10,
+        "grid_w": 14,
+        "n_marks": 6,
+        "n_distractors": 4,
+        "source_orientation": source_orientation,
+        "target_orientation": target_orientation,
+    }
+    grid = gen.generate(73, index, **requested)
+    assert gen.self_check(grid) == []
+    assert observed(grid) == requested
+    assert frame(grid, (2, 3, 4))[1:] == BASES[source_orientation]
+    assert frame(grid, (5, 6, 7))[1:] == BASES[target_orientation]
+    intended = geometry_output(grid)
+    assert intended != geometry_output(grid, radius_bounded=False)
+    assert intended != geometry_output(grid, swap=False)
+
+
+@pytest.mark.parametrize("band", [None, "easy", "medium", "hard"])
+def test_default_lessons_always_refute_the_two_declared_rivals(band):
+    seen_shapes = set()
+    seen_orientations = set()
+    seen_mark_counts = set()
+    for index in range(128):
+        grid = gen.generate(9100 + index, index * 11, difficulty=band)
+        assert grid == gen.generate(9100 + index, index * 11, difficulty=band)
+        assert gen.self_check(grid) == []
+        stats = observed(grid)
+        intended = geometry_output(grid)
+        assert stats["n_distractors"] >= 1
+        assert intended != geometry_output(grid, radius_bounded=False)
+        assert intended != geometry_output(grid, swap=False)
+        seen_shapes.add((stats["grid_h"], stats["grid_w"]))
+        seen_orientations.add((stats["source_orientation"], stats["target_orientation"]))
+        seen_mark_counts.add(stats["n_marks"])
+    assert len(seen_shapes) >= 20
+    assert len(seen_orientations) >= 55
+    assert seen_mark_counts == set(range(1, 7))
+
+
+def test_semantic_contract_names_the_radius_and_transform_distinctions():
+    assert gen.EXAMPLES_NEEDED == 2
+    assert set(gen.SEMANTIC_WITNESSES) == {"radius_filter", "diagonal_swap"}
+    assert set(gen.SEMANTIC_RIVALS) == {"transpose_all_eights", "copy_without_swap"}
+    assert gen.WITNESS_RIVALS == {
+        "radius_filter": ["transpose_all_eights"],
+        "diagonal_swap": ["copy_without_swap"],
+    }
+    assert "transpose_all_eights" in gen.CANONICAL_SHORTCUTS
+    assert set(gen.LESSON_COMPETITORS) == set(gen.SEMANTIC_RIVALS)
+    for index in range(32):
+        grid = gen.generate(712, index)
+        assert gen.strict_canonical_like(grid) == []
+        assert all(predicate(grid) for predicate in gen.SEMANTIC_WITNESSES.values())
+        assert gen.SEMANTIC_RIVALS["transpose_all_eights"](grid) == geometry_output(
+            grid, radius_bounded=False
+        )
+        assert gen.SEMANTIC_RIVALS["copy_without_swap"](grid) == geometry_output(
+            grid, swap=False
+        )
+
+
+def test_unbounded_radius_shortcut_fits_every_canonical_label():
+    assert all(
+        geometry_output(pair["input"], radius_bounded=False) == pair["output"]
+        for pair in PAIRS
+    )
+
+
+@pytest.mark.parametrize(
+    "grid",
+    [None, [], [[]], [[0], [0, 1]], [[True] * 14 for _ in range(10)]],
+)
+def test_malformed_inputs_are_diagnostic_not_exceptions(grid):
+    assert gen.self_check(grid)
+
+
+def test_determinism_fresh_returns_and_global_rng_state():
+    random.seed(987654)
+    state = random.getstate()
+    first = gen.generate(404, 5, difficulty="hard")
+    assert random.getstate() == state
+    second = gen.generate(404, 5, difficulty="hard")
+    assert first == second
+    assert first is not second
+    assert all(left is not right for left, right in zip(first, second))
+    first[0][0] = 9 if first[0][0] != 9 else 1
+    assert gen.generate(404, 5, difficulty="hard") == second
+
+
+def test_keyed_rng_is_independent_of_python_hash_seed():
+    script = (
+        "import json,sys;sys.path.insert(0,sys.argv[1]);"
+        "from reference_probe import load_generator;"
+        "print(json.dumps(load_generator().generate(31,8,difficulty='hard')))"
+    )
+    outputs = []
+    for hash_seed in ("1", "901"):
+        env = dict(os.environ, PYTHONHASHSEED=hash_seed, PYTHONDONTWRITEBYTECODE="1")
+        outputs.append(
+            subprocess.check_output(
+                [sys.executable, "-B", "-c", script, str(HOME / "workspace")],
+                env=env,
+                text=True,
+            )
+        )
+    assert outputs[0] == outputs[1]
