+             (repeated_slots[1], repeated_size, repeated_color),
+             (small_slot, small_size, small_color)]
+    if repeated_slots == (1, 2):
+        contacts = {1: ((rm - 1, cm + 1), (rm, cm + 1)),
+                    2: ((rm + 1, cm - 1), (rm + 1, cm))}
+    else:
+        contacts = {0: ((rm - 1, cm - 1), (rm - 1, cm)),
+                    3: ((rm + 1, cm + 1), (rm, cm + 1))}
