+#!/usr/bin/env python3
+"""Finite lesson audit plus generalized anti-memorization witness for abee0b4bed48.
+
+The canonical lesson is checked against named shortcuts.  The selected
+production generator is then searched for an exact-pattern counterexample that
+forces the intended structural ``other`` branch rather than memorization of the
+finite public 3-cell motifs.  The CLI replays canonical and witness labels in
+the packet's live protected Racket runtime.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Callable
+
+from reviewer_support import canonical_pairs, canonical_path, find_root, load_selected_generator
+
+TASK_ID = "abee0b4bed48"
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parent
+ROOT = find_root(__file__)
+Grid = list[list[int]]
+Pattern = tuple[tuple[int, int], ...]
+Model = Callable[[Grid], Grid]
+TOP: Pattern = ((0, 0), (0, 1), (0, 2))
+BOTTOM: Pattern = ((2, 0), (2, 1), (2, 2))
+
+
+def _sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _grid_sha(grid: Grid) -> str:
+    return _sha_bytes(json.dumps(grid, separators=(",", ":")).encode("utf-8"))
+
+
+def _canonical_record() -> dict:
+    rows = []
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        for line in handle:
+            if line.strip():
+                row = json.loads(line)
+                if row.get("task_id") == TASK_ID:
+                    rows.append(row)
+    if len(rows) != 1:
+        raise ValueError(f"expected exactly one canonical row for {TASK_ID}, got {len(rows)}")
+    return rows[0]
+
+
+def _pairs() -> list[dict]:
+    return canonical_pairs(TASK_ID, root=ROOT, variant=0, labeled_only=True)
+
+
+def _zone_patterns(grid: Grid) -> list[Pattern]:
+    if len(grid) != 3 or not grid[0] or len(grid[0]) % 3:
+        raise ValueError("expected a 3-row grid split into 3-column zones")
+    width = len(grid[0])
+    if any(len(row) != width for row in grid):
+        raise ValueError("ragged grid")
+    return [
+        tuple(
+            (row, local_col)
+            for row in range(3)
+            for local_col in range(3)
+            if grid[row][3 * zone + local_col] == 5
+        )
+        for zone in range(width // 3)
+    ]
+
+
+def _kind(pattern: Pattern) -> str:
+    if len(pattern) == 1:
+        return "one"
+    if len(pattern) == 8:
+        return "eight"
+    if pattern == TOP:
+        return "top"
+    if pattern == BOTTOM:
+        return "bottom"
+    if len(pattern) == 3:
+        return "other"
+    return "invalid"
+
+
+def _label(pattern: Pattern) -> int:
+    return {"one": 4, "eight": 3, "top": 6, "bottom": 1, "other": 9}.get(_kind(pattern), 0)
+
+
+def _paint_labels(grid: Grid, labels: list[int]) -> Grid:
+    output = [[0 for _ in row] for row in grid]
+    for zone, label in enumerate(labels):
+        for row in range(3):
+            for col in range(3 * zone, 3 * zone + 3):
+                output[row][col] = label
+    return output
+
+
+def canonical_structural(grid: Grid) -> Grid:
+    return _paint_labels(grid, [_label(pattern) for pattern in _zone_patterns(grid)])
+
+
+def count_only_three_to9(grid: Grid) -> Grid:
+    labels = []
+    for pattern in _zone_patterns(grid):
+        labels.append(4 if len(pattern) == 1 else 3 if len(pattern) == 8 else 9 if len(pattern) == 3 else 0)
+    return _paint_labels(grid, labels)
+
+
+def top_bottom_swapped(grid: Grid) -> Grid:
+    labels = []
+    for pattern in _zone_patterns(grid):
+        kind = _kind(pattern)
+        labels.append(1 if kind == "top" else 6 if kind == "bottom" else _label(pattern))
+    return _paint_labels(grid, labels)
+
+
+def fixed_zone_index(grid: Grid) -> Grid:
+    fixed = (6, 3, 1, 9, 4, 9)
+    return _paint_labels(grid, [fixed[index] for index, _ in enumerate(_zone_patterns(grid))])
+
+
+def row_presence_only(grid: Grid) -> Grid:
+    labels = []
+    for pattern in _zone_patterns(grid):
+        if len(pattern) == 1:
+            label = 4
+        elif len(pattern) == 8:
+            label = 3
+        elif len(pattern) == 3 and any(row == 0 for row, _ in pattern):
+            label = 6
+        elif len(pattern) == 3 and any(row == 2 for row, _ in pattern):
+            label = 1
+        elif len(pattern) == 3:
+            label = 9
+        else:
+            label = 0
+        labels.append(label)
+    return _paint_labels(grid, labels)
+
+
+def one_eight_swapped(grid: Grid) -> Grid:
+    labels = []
+    for pattern in _zone_patterns(grid):
+        kind = _kind(pattern)
+        labels.append(3 if kind == "one" else 4 if kind == "eight" else _label(pattern))
+    return _paint_labels(grid, labels)
+
+
+def _training_pattern_lookup() -> dict[Pattern, int]:
+    lookup: dict[Pattern, int] = {}
+    for pair in _pairs():
+        if pair["split"] != "train":
+            continue
+        for zone, pattern in enumerate(_zone_patterns(pair["input"])):
+            label = pair["output"][0][3 * zone]
+            previous = lookup.setdefault(pattern, label)
+            if previous != label:
+                raise ValueError("canonical demonstrations assign one exact pattern two labels")
+    return lookup
+
+
+def exact_pattern_lookup(grid: Grid) -> Grid:
+    lookup = _training_pattern_lookup()
+    return _paint_labels(grid, [lookup.get(pattern, 0) for pattern in _zone_patterns(grid)])
+
+
+MODELS: dict[str, Model] = {
+    "canonical_structural": canonical_structural,
+    "count_only_three_to9": count_only_three_to9,
+    "top_bottom_swapped": top_bottom_swapped,
+    "fixed_zone_index": fixed_zone_index,
+    "row_presence_only": row_presence_only,
+    "one_eight_swapped": one_eight_swapped,
+    "exact_pattern_lookup": exact_pattern_lookup,
+}
+
+
+def audit_canonical() -> dict:
+    pairs = _pairs()
+    train = [pair for pair in pairs if pair["split"] == "train"]
+    queries = [pair for pair in pairs if pair["split"] == "test"]
+    model_rows = []
+    survivors = []
+    harmful_survivors = []
+    for name, model in MODELS.items():
+        train_matches = [model(pair["input"]) == pair["output"] for pair in train]
+        query_matches = [model(pair["input"]) == pair["output"] for pair in queries]
+        survives = all(train_matches)
+        harmful = survives and not all(query_matches)
+        if survives:
+            survivors.append(name)
+        if harmful:
+            harmful_survivors.append(name)
+        model_rows.append(
+            {
+                "name": name,
+                "train_matches": train_matches,
+                "query_matches": query_matches,
+                "survives_lesson": survives,
+                "query_harmful": harmful,
+            }
+        )
+
+    coverage = sorted(
+        {
+            _kind(pattern)
+            for pair in train
+            for pattern in _zone_patterns(pair["input"])
+            if _kind(pattern) != "invalid"
+        }
+    )
+    canonical_survives = "canonical_structural" in survivors
+    failures = []
+    if not canonical_survives:
+        failures.append("canonical structural classifier does not reproduce demonstrations")
+    if harmful_survivors:
+        failures.append("a named demonstration survivor changes the canonical query")
+    if set(coverage) != {"one", "eight", "top", "bottom", "other"}:
+        failures.append("public demonstrations do not expose all five output branches")
+
+    return {
+        "schema": "arcpuzzles-peer-learnability-abee0b4bed48-v1",
+        "task_id": TASK_ID,
+        "status": "pass" if not failures else "fail",
+        "canonical_survives": canonical_survives,
+        "tested_models": list(MODELS),
+        "lesson_survivors": survivors,
+        "harmful_survivors": harmful_survivors,
+        "public_branch_coverage": coverage,
+        "models": model_rows,
+        "failures": failures,
+        "scope": "Finite named-rival audit over the canonical lesson and labeled query; not universal uniqueness or training admission.",
+    }
+
+
+def _json_pattern(pattern: Pattern) -> list[list[int]]:
+    return [[row, col] for row, col in pattern]
+
+
+def find_unseen_other_witness() -> dict:
+    module, source_path, source_sha = load_selected_generator(TASK_ID, root=ROOT)
+    seen_patterns = set(_training_pattern_lookup())
+    seen_other = {pattern for pattern in seen_patterns if _kind(pattern) == "other"}
+    for seed in range(64):
+        for sample_index in range(16):
+            grid = module.generate(
+                seed,
+                sample_index,
+                difficulty="hard",
+                scene_profile="other_shape_pair",
+            )
+            patterns = _zone_patterns(grid)
+            unseen = sorted(
+                (pattern for pattern in patterns if _kind(pattern) == "other" and pattern not in seen_patterns),
+                key=repr,
+            )
+            if not unseen:
+                continue
+            canonical_output = module.rule_mirror(grid)
+            lookup_output = exact_pattern_lookup(grid)
+            if canonical_output == lookup_output:
+                continue
+            return {
+                "schema": "arcpuzzles-abee0b4bed48-unseen-pattern-witness-v1",
+                "task_id": TASK_ID,
+                "found": True,
+                "seed": seed,
+                "sample_index": sample_index,
+                "difficulty": "hard",
+                "scene_profile": "other_shape_pair",
+                "input": grid,
+                "canonical_output": canonical_output,
+                "exact_pattern_lookup_output": lookup_output,
+                "unseen_other_patterns": [_json_pattern(pattern) for pattern in unseen],
+                "public_other_patterns": [_json_pattern(pattern) for pattern in sorted(seen_other, key=repr)],
+                "generator_path": source_path.relative_to(ROOT).as_posix(),
+                "generator_sha256": source_sha,
+                "mechanism": "The generator presents a valid three-cell non-row motif absent from the public lesson; the structural rule emits 9 while exact-pattern memorization emits 0.",
+            }
+    return {
+        "schema": "arcpuzzles-abee0b4bed48-unseen-pattern-witness-v1",
+        "task_id": TASK_ID,
+        "found": False,
+        "searched_seeds": 64,
+        "samples_per_seed": 16,
+    }
+
+
+def _source_inventory() -> list[dict[str, str]]:
+    paths = [
+        Path(__file__).resolve(),
+        TASK_HOME / "generator.py",
+        TASK_HOME / "tests" / "test_learnability_probe_abee0b4bed48.py",
+        canonical_path(ROOT),
+    ]
+    return [
+        {"path": path.relative_to(ROOT).as_posix(), "sha256": _sha_bytes(path.read_bytes())}
+        for path in paths
+    ]
+
+
+def run(output: Path) -> dict:
+    output = Path(output)
+    if output.exists():
+        raise FileExistsError(f"refusing to overwrite evidence: {output}")
+    report = audit_canonical()
+    witness = find_unseen_other_witness()
+    if report["status"] != "pass":
+        raise ValueError("finite lesson audit failed: " + json.dumps(report["failures"]))
+    if not witness.get("found"):
+        raise ValueError("generalized generator did not expose exact-pattern memorization")
+
+    from arcpuzzles.parametric_worker import _real_evaluator
+
+    record = _canonical_record()
+    program = record.get("program_solution")
+    if not isinstance(program, str) or not program.strip():
+        raise ValueError("canonical row has no executable Racket program")
+    apply, identity, bridge = _real_evaluator(ROOT / "shared" / "runtime")
+    executions = []
+    try:
+        for pair in _pairs():
+            actual = apply(program, pair["input"])
+            if actual != pair["output"]:
+                raise ValueError(
+                    f"protected Racket mismatch at {pair['split']}[{pair['pair_index']}]"
+                )
+            executions.append(
+                {
+                    "kind": "canonical_label",
+                    "split": pair["split"],
+                    "pair_index": pair["pair_index"],
+                    "input_sha256": _grid_sha(pair["input"]),
+                    "output_sha256": _grid_sha(actual),
+                }
+            )
+        witness_actual = apply(program, witness["input"])
+        if witness_actual != witness["canonical_output"]:
+            raise ValueError("protected Racket disagrees with selected generator on witness")
+        executions.append(
+            {
+                "kind": "unseen_other_witness",
+                "seed": witness["seed"],
+                "sample_index": witness["sample_index"],
+                "input_sha256": _grid_sha(witness["input"]),
+                "output_sha256": _grid_sha(witness_actual),
+            }
+        )
+    finally:
+        bridge.close()
+
+    evidence = {
+        **report,
+        "anti_memorization_witness": witness,
+        "protected_racket": {
+            "runtime_identity": identity,
+            "program_sha256": _sha_bytes(program.encode("utf-8")),
+            "executions": executions,
+            "labels_checked": len(executions),
+        },
+        "source_inventory": _source_inventory(),
+        "reviewer_status": "reviewer_replayed",
+        "training_admitted": False,
+    }
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return evidence
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True, help="new JSON evidence path")
+    args = parser.parse_args()
+    evidence = run(args.out)
+    witness = evidence["anti_memorization_witness"]
+    print(
+        json.dumps(
+            {
+                "status": evidence["status"],
+                "task_id": TASK_ID,
+                "tested_models": len(evidence["tested_models"]),
+                "harmful_survivors": evidence["harmful_survivors"],
+                "witness_seed": witness["seed"],
+                "unseen_other_patterns": len(witness["unseen_other_patterns"]),
+                "labels_checked": evidence["protected_racket"]["labels_checked"],
+                "output": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
