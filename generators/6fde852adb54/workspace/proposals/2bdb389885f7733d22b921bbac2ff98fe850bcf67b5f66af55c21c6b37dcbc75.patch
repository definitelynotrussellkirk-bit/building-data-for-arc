+"""Finite learnability audit for the zone-label peer."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+
+HOME = Path(__file__).resolve().parents[1]
+PATH = HOME / "workspace" / "learnability_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("_peer_abee_learnability_probe", PATH)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_public_lesson_has_no_query_harmful_named_survivor():
+    report = load_probe().audit_canonical()
+    assert report["status"] == "pass"
+    assert report["harmful_survivors"] == []
+    assert report["canonical_survives"] is True
+    assert set(report["public_branch_coverage"]) == {"one", "eight", "top", "bottom", "other"}
+
+
+def test_generalized_curriculum_exposes_exact_pattern_memorization():
+    witness = load_probe().find_unseen_other_witness()
+    assert witness["found"] is True
+    assert witness["canonical_output"] != witness["exact_pattern_lookup_output"]
+    assert witness["unseen_other_patterns"]
