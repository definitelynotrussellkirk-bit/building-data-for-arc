@@ -0,0 +1,393 @@
+#!/usr/bin/env python3
+"""Finite, source-bound learnability probe for 04de9df58814.
+
+This tool audits the canonical demonstration lesson against a named family of
+plausible shortcuts and, when run as a CLI, replays every public label through
+the packet's live protected Racket runtime.  It is reviewer evidence only: it
+does not alter the generator or claim universal rule uniqueness.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+from typing import Callable, Iterable
+
+from reviewer_support import canonical_pairs, canonical_path, find_root
+
+TASK_ID = "04de9df58814"
+HERE = Path(__file__).resolve().parent
+TASK_HOME = HERE.parent
+ROOT = find_root(__file__)
+Grid = list[list[int]]
+Cell = tuple[int, int]
+Model = Callable[[Grid], Grid]
+
+
+def _sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _grid_sha(grid: Grid) -> str:
+    return _sha_bytes(json.dumps(grid, separators=(",", ":")).encode("utf-8"))
+
+
+def _canonical_record() -> dict:
+    rows = []
+    with canonical_path(ROOT).open(encoding="utf-8") as handle:
+        for line in handle:
+            if line.strip():
+                row = json.loads(line)
+                if row.get("task_id") == TASK_ID:
+                    rows.append(row)
+    if len(rows) != 1:
+        raise ValueError(f"expected exactly one canonical row for {TASK_ID}, got {len(rows)}")
+    return rows[0]
+
+
+def _pairs() -> list[dict]:
+    return canonical_pairs(TASK_ID, root=ROOT, variant=0, labeled_only=True)
+
+
+def _components(grid: Grid, *, colors: Iterable[int]) -> list[tuple[int, list[Cell]]]:
+    allowed = set(colors)
+    height, width = len(grid), len(grid[0])
+    seen: set[Cell] = set()
+    result: list[tuple[int, list[Cell]]] = []
+    for row in range(height):
+        for col in range(width):
+            color = grid[row][col]
+            if color not in allowed or (row, col) in seen:
+                continue
+            seen.add((row, col))
+            stack = [(row, col)]
+            component: list[Cell] = []
+            while stack:
+                current = stack.pop()
+                component.append(current)
+                cr, cc = current
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nxt = (cr + dr, cc + dc)
+                    nr, nc = nxt
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and nxt not in seen
+                        and grid[nr][nc] == color
+                    ):
+                        seen.add(nxt)
+                        stack.append(nxt)
+            result.append((color, sorted(component)))
+    return result
+
+
+def _touches(component: list[Cell], height: int, width: int, edges: set[str]) -> bool:
+    for row, col in component:
+        if "top" in edges and row == 0:
+            return True
+        if "bottom" in edges and row == height - 1:
+            return True
+        if "left" in edges and col == 0:
+            return True
+        if "right" in edges and col == width - 1:
+            return True
+    return False
+
+
+def _paint(grid: Grid, cells: Iterable[Cell], color: int) -> Grid:
+    output = deepcopy(grid)
+    for row, col in cells:
+        output[row][col] = color
+    return output
+
+
+def canonical_border_component(grid: Grid) -> Grid:
+    height, width = len(grid), len(grid[0])
+    cells = [
+        cell
+        for _, component in _components(grid, colors={3})
+        if _touches(component, height, width, {"top", "bottom", "left", "right"})
+        for cell in component
+    ]
+    return _paint(grid, cells, 4)
+
+
+def all_green_components(grid: Grid) -> Grid:
+    return _paint(grid, ((r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 3), 4)
+
+
+def border_cells_only(grid: Grid) -> Grid:
+    height, width = len(grid), len(grid[0])
+    cells = (
+        (row, col)
+        for row in range(height)
+        for col in range(width)
+        if grid[row][col] == 3 and (row in (0, height - 1) or col in (0, width - 1))
+    )
+    return _paint(grid, cells, 4)
+
+
+def _edge_limited(grid: Grid, edges: set[str]) -> Grid:
+    height, width = len(grid), len(grid[0])
+    cells = [
+        cell
+        for _, component in _components(grid, colors={3})
+        if _touches(component, height, width, edges)
+        for cell in component
+    ]
+    return _paint(grid, cells, 4)
+
+
+def top_bottom_edges_only(grid: Grid) -> Grid:
+    return _edge_limited(grid, {"top", "bottom"})
+
+
+def left_right_edges_only(grid: Grid) -> Grid:
+    return _edge_limited(grid, {"left", "right"})
+
+
+def rectangles_only(grid: Grid) -> Grid:
+    height, width = len(grid), len(grid[0])
+    cells: list[Cell] = []
+    for _, component in _components(grid, colors={3}):
+        rows = [row for row, _ in component]
+        cols = [col for _, col in component]
+        rectangle_area = (max(rows) - min(rows) + 1) * (max(cols) - min(cols) + 1)
+        if (
+            len(component) == rectangle_area
+            and _touches(component, height, width, {"top", "bottom", "left", "right"})
+        ):
+            cells.extend(component)
+    return _paint(grid, cells, 4)
+
+
+def small_border_components_only(grid: Grid) -> Grid:
+    height, width = len(grid), len(grid[0])
+    cells = [
+        cell
+        for _, component in _components(grid, colors={3})
+        if len(component) <= 2
+        and _touches(component, height, width, {"top", "bottom", "left", "right"})
+        for cell in component
+    ]
+    return _paint(grid, cells, 4)
+
+
+def all_border_objects(grid: Grid) -> Grid:
+    height, width = len(grid), len(grid[0])
+    colors = {value for row in grid for value in row if value != 0}
+    cells = [
+        cell
+        for _, component in _components(grid, colors=colors)
+        if _touches(component, height, width, {"top", "bottom", "left", "right"})
+        for cell in component
+    ]
+    return _paint(grid, cells, 4)
+
+
+MODELS: dict[str, Model] = {
+    "canonical_border_component": canonical_border_component,
+    "all_green_components": all_green_components,
+    "border_cells_only": border_cells_only,
+    "top_bottom_edges_only": top_bottom_edges_only,
+    "left_right_edges_only": left_right_edges_only,
+    "rectangles_only": rectangles_only,
+    "small_border_components_only": small_border_components_only,
+    "all_border_objects": all_border_objects,
+}
+
+
+def _edge_coverage(train: list[dict]) -> list[str]:
+    covered: set[str] = set()
+    for pair in train:
+        grid = pair["input"]
+        height, width = len(grid), len(grid[0])
+        for _, component in _components(grid, colors={3}):
+            if not any(pair["output"][r][c] == 4 for r, c in component):
+                continue
+            for edge, predicate in (
+                ("top", lambda r, c: r == 0),
+                ("bottom", lambda r, c: r == height - 1),
+                ("left", lambda r, c: c == 0),
+                ("right", lambda r, c: c == width - 1),
+            ):
+                if any(predicate(r, c) for r, c in component):
+                    covered.add(edge)
+    return sorted(covered)
+
+
+def _lesson_facts(train: list[dict]) -> dict[str, bool]:
+    irregular_border = False
+    interior_green_stays = False
+    non_green_border_decoy_stays = False
+    for pair in train:
+        grid, expected = pair["input"], pair["output"]
+        height, width = len(grid), len(grid[0])
+        for _, component in _components(grid, colors={3}):
+            rows = [r for r, _ in component]
+            cols = [c for _, c in component]
+            rectangular = len(component) == (max(rows) - min(rows) + 1) * (max(cols) - min(cols) + 1)
+            border = _touches(component, height, width, {"top", "bottom", "left", "right"})
+            if border and not rectangular:
+                irregular_border = True
+            if not border and all(expected[r][c] == 3 for r, c in component):
+                interior_green_stays = True
+        for row in range(height):
+            for col in range(width):
+                if (
+                    grid[row][col] not in (0, 3)
+                    and (row in (0, height - 1) or col in (0, width - 1))
+                    and expected[row][col] == grid[row][col]
+                ):
+                    non_green_border_decoy_stays = True
+    return {
+        "irregular_border_component": irregular_border,
+        "interior_green_stays": interior_green_stays,
+        "non_green_border_decoy_stays": non_green_border_decoy_stays,
+    }
+
+
+def audit_canonical() -> dict:
+    pairs = _pairs()
+    train = [pair for pair in pairs if pair["split"] == "train"]
+    queries = [pair for pair in pairs if pair["split"] == "test"]
+    model_rows = []
+    harmful_survivors: list[str] = []
+    survivors: list[str] = []
+    for name, model in MODELS.items():
+        train_matches = [model(pair["input"]) == pair["output"] for pair in train]
+        query_matches = [model(pair["input"]) == pair["output"] for pair in queries]
+        survives = all(train_matches)
+        harmful = survives and not all(query_matches)
+        if survives:
+            survivors.append(name)
+        if harmful:
+            harmful_survivors.append(name)
+        model_rows.append(
+            {
+                "name": name,
+                "train_matches": train_matches,
+                "query_matches": query_matches,
+                "survives_lesson": survives,
+                "query_harmful": harmful,
+            }
+        )
+
+    facts = _lesson_facts(train)
+    canonical_survives = "canonical_border_component" in survivors
+    edge_coverage = _edge_coverage(train)
+    failures = []
+    if not canonical_survives:
+        failures.append("canonical model does not reproduce all demonstrations")
+    if harmful_survivors:
+        failures.append("a named demonstration survivor changes a canonical query")
+    if edge_coverage != ["bottom", "left", "right", "top"]:
+        failures.append("demonstrations do not expose all four borders")
+    if not all(facts.values()):
+        failures.append("demonstrations omit a required disambiguating fact")
+
+    return {
+        "schema": "arcpuzzles-peer-learnability-04de9df58814-v1",
+        "task_id": TASK_ID,
+        "status": "pass" if not failures else "fail",
+        "canonical_survives": canonical_survives,
+        "tested_models": list(MODELS),
+        "lesson_survivors": survivors,
+        "harmful_survivors": harmful_survivors,
+        "edge_coverage": edge_coverage,
+        "lesson_facts": facts,
+        "models": model_rows,
+        "failures": failures,
+        "scope": "Finite named-rival audit over the canonical lesson and labeled query; not universal uniqueness or training admission.",
+    }
+
+
+def _source_inventory() -> list[dict[str, str]]:
+    paths = [
+        Path(__file__).resolve(),
+        TASK_HOME / "generator.py",
+        TASK_HOME / "tests" / "test_learnability_probe_04de9df58814.py",
+        canonical_path(ROOT),
+    ]
+    return [
+        {"path": path.relative_to(ROOT).as_posix(), "sha256": _sha_bytes(path.read_bytes())}
+        for path in paths
+    ]
+
+
+def run(output: Path) -> dict:
+    output = Path(output)
+    if output.exists():
+        raise FileExistsError(f"refusing to overwrite evidence: {output}")
+    report = audit_canonical()
+    if report["status"] != "pass":
+        raise ValueError("finite learnability audit failed: " + json.dumps(report["failures"]))
+
+    from arcpuzzles.parametric_worker import _real_evaluator
+
+    record = _canonical_record()
+    program = record.get("program_solution")
+    if not isinstance(program, str) or not program.strip():
+        raise ValueError("canonical row has no executable Racket program")
+    apply, identity, bridge = _real_evaluator(ROOT / "shared" / "runtime")
+    executions = []
+    try:
+        for pair in _pairs():
+            actual = apply(program, pair["input"])
+            if actual != pair["output"]:
+                raise ValueError(
+                    f"protected Racket mismatch at {pair['split']}[{pair['pair_index']}]"
+                )
+            executions.append(
+                {
+                    "split": pair["split"],
+                    "pair_index": pair["pair_index"],
+                    "input_sha256": _grid_sha(pair["input"]),
+                    "output_sha256": _grid_sha(actual),
+                }
+            )
+    finally:
+        bridge.close()
+
+    evidence = {
+        **report,
+        "protected_racket": {
+            "runtime_identity": identity,
+            "program_sha256": _sha_bytes(program.encode("utf-8")),
+            "executions": executions,
+            "labels_checked": len(executions),
+        },
+        "source_inventory": _source_inventory(),
+        "reviewer_status": "reviewer_replayed",
+        "training_admitted": False,
+    }
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return evidence
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True, help="new JSON evidence path")
+    args = parser.parse_args()
+    evidence = run(args.out)
+    print(
+        json.dumps(
+            {
+                "status": evidence["status"],
+                "task_id": TASK_ID,
+                "tested_models": len(evidence["tested_models"]),
+                "harmful_survivors": evidence["harmful_survivors"],
+                "labels_checked": evidence["protected_racket"]["labels_checked"],
+                "output": str(args.out),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
