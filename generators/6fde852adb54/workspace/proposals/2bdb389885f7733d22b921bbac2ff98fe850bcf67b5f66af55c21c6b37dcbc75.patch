+"""Finite learnability audit for the border-component peer."""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+
+HOME = Path(__file__).resolve().parents[1]
+PATH = HOME / "workspace" / "learnability_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("_peer_04_learnability_probe", PATH)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_canonical_lesson_rejects_named_harmful_shortcuts():
+    report = load_probe().audit_canonical()
+    assert report["status"] == "pass"
+    assert report["harmful_survivors"] == []
+    assert report["canonical_survives"] is True
+    assert set(report["tested_models"]) >= {
+        "canonical_border_component",
+        "all_green_components",
+        "border_cells_only",
+        "top_bottom_edges_only",
+        "left_right_edges_only",
+        "rectangles_only",
+        "small_border_components_only",
+        "all_border_objects",
+    }
+    assert report["edge_coverage"] == ["bottom", "left", "right", "top"]
