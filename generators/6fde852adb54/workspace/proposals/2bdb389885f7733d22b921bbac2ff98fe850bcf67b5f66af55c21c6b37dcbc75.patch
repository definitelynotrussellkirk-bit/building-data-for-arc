+++ b/repo/generators/6fde852adb54/workspace/parametric/longest_vertical_run.rkt
@@ -0,0 +1,64 @@
+(rule!
+  (let* ((h (rows g)) (w (cols g)) (bg (mode g -1))
+         (body (mode-list (filter (lambda (v) (!= v bg)) (row g 0))))
+         (cs (filter (lambda (c) (= (at g 0 c) body)) (range w)))
+         (tip (find-first (lambda (v) (and (!= v bg) (!= v body)))
+                          (map (lambda (c) (at g 2 c)) cs)))
+         (gray (find-first
+                (lambda (v) (and (!= v bg) (!= v body) (!= v tip)))
+                (grid-colors g)))
+         (ups (list)))
+    (define (add r c v) (set! ups (cons (list r c v) ups)))
+    (define (gray-rows c)
+      (filter (lambda (r) (and (> r 2) (= (at g r c) gray))) (range h)))
+    (define (longest-run rows*)
+      (let loop ((xs (sort rows* <)) (previous -2) (current 0) (best 0))
+        (if (empty? xs)
+            best
+            (let* ((r (first xs))
+                   (next-current (if (= r (+ previous 1)) (+ current 1) 1)))
+              (loop (rest xs) r next-current (max best next-current))))))
+    (for* ((c cs) (r (range 3))) (add r c bg))
+    (for ((c cs))
+      (let ((v (at g 2 c)) (hits (gray-rows c)))
+        (if (= v tip)
+            (let ((land (if (empty? hits) (- h 1) (- (first hits) 1))))
+              (add (- land 2) c body)
+              (add (- land 1) c body)
+              (add land c tip))
+            (let ((lc c))
+              (when (and (not (empty? hits)) (>= (last hits) (- h 2)))
+                (let* ((blob (connected-region
+                              g (last hits) c
+                              (lambda (r cc value) (= value gray)) 4))
+                       (cnt (make-hash))
+                       (rows-by-col (make-hash)))
+                  (for ((cell blob))
+                    (hash-update! cnt (second cell) add1 0)
+                    (hash-update! rows-by-col (second cell)
+                                  (lambda (old) (cons (first cell) old))
+                                  (list)))
+                  (let ((scores (make-hash)))
+                    (for ((cc (hash-keys rows-by-col)))
+                      (hash-set! scores cc (longest-run (hash-ref rows-by-col cc))))
+                    (let* ((mx (apply max (hash-values scores)))
+                           (cands (filter (lambda (cc) (= (hash-ref scores cc) mx))
+                                          (hash-keys scores))))
+                      (set! lc (argmin
+                                (lambda (cc) (+ (* 1000 (abs (- cc c))) cc))
+                                cands))
+                      (when (all? (lambda (n) (= n 1)) (hash-values cnt))
+                        (let* ((r (first (first blob)))
+                               (cols* (sort (hash-keys cnt) <))
+                               (nl (count-where (lambda (cc) (< cc lc)) cols*))
+                               (nr (count-where (lambda (cc) (> cc lc)) cols*))
+                               (step (if (>= nr nl) 1 -1)))
+                          (for ((k (range 1 (length cs))))
+                            (let ((cc (+ lc (* step k))))
+                              (when (and (in-bounds? r cc h w)
+                                         (= (at g r cc) gray))
+                                (add r cc bg))))))))))
+              (for ((r (range (- h 3) h))) (add r lc body))))))
+    (foldl (lambda (u out)
+             (set-cell out (first u) (second u) (third u)))
+           g (reverse ups))))
