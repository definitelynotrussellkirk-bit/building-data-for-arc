      "source": "(rule!\n ;; alt: compute numeric half ids qr/qc, then compare each cell's half id.\n (lambda (g)\n   (let* ((h (rows g))\n          (w (cols g))\n          (mid-r (/ h 2))\n          (mid-c (/ w 2))\n          (cells (for*/list ((r (range 0 h)) (c (range 0 w))) (cons r c)))\n          (pos (find-first (lambda (p) (= 2 (at g (fst p) (snd p)))) cells))\n          (target-top? (< (fst pos) mid-r))\n          (target-left? (< (snd pos) 3)))\n     (cellmap g (r c _)\n       (if (and (eq? (< r mid-r) target-top?)\n                (eq? (< c mid-c) target-left?))\n           2\n           6)))))"
    },
