+#!/usr/bin/env python3
+"""Bounded default-demo / explicit-override-query mirror-color diagnostic."""
+from __future__ import annotations
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import wrap_rule
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK = "e005c30bc59a"
+EXPECTED_SOURCE = "4cffc894fadae67da8d9102054d64545ed4f4d9e1ba8f11a7d4c42fbc3fb539d"
+RIVAL = """(rule! (lambda (g)
+ (let* ((h (rows g)) (w (cols g))
+        (source (first (filter (lambda (p) (let ((v (at g (first p) (second p))))
+                       (and (not (= v 0)) (not (= v 1)) (not (= v 2)) (not (= v 5))))) (border-positions g))))
+        (color (at g (first source) (second source)))
+        (start (cond ((= (first source) 0) (list 1 0))
+                     ((= (first source) (- h 1)) (list -1 0))
+                     ((= (second source) 0) (list 0 1)) (else (list 0 -1)))))
+  (let loop ((out g) (r (+ (first source) (first start)))
+             (c (+ (second source) (second start))) (dr (first start)) (dc (second start))
+             (expected 0) (fuel (* 5 h w)))
+    (cond ((or (= fuel 0) (not (in-bounds? r c h w))) out)
+          (else (let ((v (at g r c)))
+            (cond ((= v 0) (loop (set-cell out r c color) (+ r dr) (+ c dc) dr dc expected (- fuel 1)))
+                  ((= v 5) out)
+                  ((or (= v 1) (= v 2))
+                   (let* ((kind (if (= expected 0) v expected))
+                          (nr (if (= kind 1) (- dc) dc))
+                          (nc (if (= kind 1) (- dr) dr)))
+                     (loop out (+ r nr) (+ c nc) nr nc (- 3 kind) (- fuel 1))))
+                  (else out)))))))))"""
+
+
+def sha(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def raw(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
+
+
+def rival_python(grid):
+    h, w = len(grid), len(grid[0])
+    sources = [(r, c) for r in range(h) for c in range(w) if grid[r][c] in (3, 4, 6, 7, 8, 9)]
+    if len(sources) != 1:
+        raise ValueError("Need one source")
+    sr, sc = sources[0]
+    dr, dc = (1, 0) if sr == 0 else (-1, 0) if sr == h - 1 else (0, 1) if sc == 0 else (0, -1)
+    r, c = sr + dr, sc + dc
+    out, expected = deepcopy(grid), None
+    for _ in range(5 * h * w):
+        if not (0 <= r < h and 0 <= c < w):
+            break
+        v = grid[r][c]
+        if v == 0:
+            out[r][c] = grid[sr][sc]
+        elif v == 5:
+            break
+        elif v in (1, 2):
+            kind = v if expected is None else expected
+            dr, dc = (-dc, -dr) if kind == 1 else (dc, dr)
+            expected = 3 - kind
+        else:
+            break
+        r, c = r + dr, c + dc
+    return out
+
+
+def run(out):
+    if out.exists():
+        raise FileExistsError(out)
+    root = find_root(__file__)
+    gen, source, source_sha = load_selected_generator(TASK, root=root)
+    if source_sha != EXPECTED_SOURCE:
+        raise ValueError("Assigned generator changed")
+    tracer_path = Path(__file__).with_name("crossing_revisit_probe.py")
+    spec = importlib.util.spec_from_file_location("_alternating_independent_tracer", tracer_path)
+    tracer = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(tracer)
+    rows = [json.loads(line) for line in canonical_path(root).read_text().splitlines()]
+    canonical = [row for row in rows if row.get("task_id") == TASK and row.get("content_hash") == TASK]
+    if len(canonical) != 1:
+        raise ValueError("Expected original canonical row")
+    intended = canonical[0]["program_solution"]
+    demos, requests, facts = [], [], []
+    for index in range(4):
+        grid = gen.generate(0, index, difficulty="medium")
+        if gen.self_check(grid):
+            raise ValueError("Invalid ordinary draw")
+        output, trace = tracer.trace(grid, stop_on_revisited_cell=False)
+        if output != gen.rule_mirror(grid) or rival_python(grid) != output:
+            raise ValueError("Default demonstration does not fit the rival")
+        demos.append({"input": grid, "output": output})
+        requests.append({"seed": 0, "sample_index": index, "difficulty": "medium", "overrides": {}})
+        facts.append({"trace": trace, "reached_mirror_kinds": [x[2] for x in gen._analysis(grid)["hit_mirrors"]]})
+    # Freeze demonstration fit before generating or inspecting any query.
+    frozen_demo_sha = sha(raw(demos))
+    query = None
+    search = []
+    overrides = {"source_edge": "top", "source_color": 6, "mirror_profile": "two_hit",
+                 "wall_profile": "boundary_none", "grid_h": 12, "grid_w": 12}
+    for index in range(4, 8):
+        grid = gen.generate(0, index, difficulty="medium", **overrides)
+        if gen.self_check(grid):
+            raise ValueError("Invalid explicit-override query")
+        output, trace = tracer.trace(grid, stop_on_revisited_cell=False)
+        alternative = rival_python(grid)
+        request = {"seed": 0, "sample_index": index, "difficulty": "medium", "overrides": overrides}
+        kinds = [x[2] for x in gen._analysis(grid)["hit_mirrors"]]
+        search.append({"request": request, "input_sha256": sha(raw(grid)), "reached_mirror_kinds": kinds,
+                       "rival_differs": alternative != output})
+        if alternative != output:
+            query = {"input": grid, "output": output}
+            query_request, query_facts = request, {"trace": trace, "reached_mirror_kinds": kinds}
+            break
+    if query is None:
+        raise ValueError("No divergent query in the four-request diagnostic budget")
+    if sha(raw(demos)) != frozen_demo_sha:
+        raise ValueError("Query access mutated the demonstrations")
+    evaluations = []
+    with RacketBridge(timeout=30, max_calls_before_restart=32) as bridge:
+        runtime = bridge.runtime_identity
+        for split, index, pair in [("train", i, p) for i, p in enumerate(demos)] + [("test", 0, query)]:
+            for name, program in [("intended", intended), ("alternating_mirrors", RIVAL)]:
+                grid = pair["input"]
+                literal = "(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+                actual = bridge.eval_text(f"({wrap_rule(program)} '{literal})")
+                expected = pair["output"] if name == "intended" else rival_python(grid)
+                if actual != expected:
+                    raise ValueError("Protected/Python parity failed")
+                evaluations.append({"split": split, "index": index, "program": name,
+                                    "program_sha256": sha(program.encode()), "input_sha256": sha(raw(grid)),
+                                    "output": actual, "output_sha256": sha(raw(actual))})
+    differing = [[r, c] for r in range(len(query["input"])) for c in range(len(query["input"][0]))
+                 if query["output"][r][c] != rival_python(query["input"])[r][c]]
+    out.mkdir(parents=True)
+    def save(name, value):
+        (out / name).write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+    (out / "intended.rkt").write_text(intended)
+    (out / "alternating-mirrors.rkt").write_text(RIVAL)
+    save("lesson.json", {"train": demos, "test": [query], "rival_query_output": rival_python(query["input"]),
+                         "demo_requests": requests, "query_request": query_request,
+                         "demo_facts": facts, "query_facts": query_facts, "changed_cells": differing})
+    save("execution.json", {"racket": runtime, "evaluations": evaluations, "racket_evaluations": len(evaluations)})
+    save("search.json", {"max_query_draws": 4, "actual_query_draws": len(search), "queries": search})
+    artifacts = {p.name: sha(p.read_bytes()) for p in out.iterdir()}
+    report = {"schema": "arcpuzzles-alternating-mirror-lesson-v1", "task_id": TASK,
+              "status": "finding", "generator_sha256": source_sha, "rule_hash": gen.RULE_HASH,
+              "canonical_program_sha256": sha(intended.encode()), "rival_program_sha256": sha(RIVAL.encode()),
+              "probe_sha256": sha(Path(__file__).read_bytes()), "independent_tracer_sha256": sha(tracer_path.read_bytes()),
+              "demo_fit": [True] * 4, "demonstrations_sha256": frozen_demo_sha,
+              "query_changed_cells": len(differing), "racket_evaluations": len(evaluations),
+              "draws": 4 + len(search), "self_check_failures": 0, "artifacts": artifacts,
+              "finding": "Four ordinary default demonstrations fit a rule that reads the first reached mirror then alternates mirror kinds while ignoring later colors; a lawful explicitly overridden two-mirror query disagrees.",
+              "limits": ["Reviewer-authored actual-draw lesson mixing ordinary demos with an explicit-override query, not a native-issued episode or a default-only query failure.",
+                         "One novel rival and at most four predeclared query attempts; no failure-frequency estimate or universal learnability claim.",
+                         "Existing four-demo crossing guarantees and full override/battery evidence were not rerun.",
+                         "No production, canonical, approval or review-index edits; no owner acceptance or training admission."],
+              "training_admitted": False}
+    save("report.json", report)
+    print(json.dumps({"status": "finding", "draws": report["draws"], "racket_evaluations": len(evaluations),
+                      "query_changed_cells": len(differing), "query_mirror_kinds": query_facts["reached_mirror_kinds"]}))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, type=Path)
+    run(parser.parse_args().out)
