+#!/usr/bin/env python3
+"""Bounded 4/8-background-connectivity lesson diagnostic; no approval changes.
+
+Four demonstrations are actual ordinary seed-0 medium draws. A fifth ordinary
+draw is checked separately. The contrasting query is hand-authored and accepted
+by the production validator; it is not claimed to come from the sampler.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles import Catalog
+from arc_repl.racket_bridge import RacketBridge
+from puzzle_generators.rule_wrap import strip_rule_wrapper
+from reviewer_support import find_root, load_selected_generator
+
+TASK = "14dacb3b518f"
+SOURCE = "60d817465de0aa5552e054895a50a584f2f4f4aaac5a99057dea7bb50b929121"
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8 = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
+
+
+def encoded(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def regions(cells, directions):
+    remaining = set(cells)
+    result = []
+    while remaining:
+        start = min(remaining)
+        remaining.remove(start)
+        found, todo = {start}, [start]
+        while todo:
+            r, c = todo.pop()
+            for dr, dc in directions:
+                neighbor = (r + dr, c + dc)
+                if neighbor in remaining:
+                    remaining.remove(neighbor)
+                    found.add(neighbor)
+                    todo.append(neighbor)
+        result.append(found)
+    return result
+
+
+def independent(grid, background_connectivity):
+    answer = deepcopy(grid)
+    foreground = {(r, c) for r, row in enumerate(grid) for c, value in enumerate(row) if value == 6}
+    for obj in regions(foreground, DIR4):
+        lo_r, hi_r = min(r for r, c in obj), max(r for r, c in obj)
+        lo_c, hi_c = min(c for r, c in obj), max(c for r, c in obj)
+        empty = {(r, c) for r in range(lo_r, hi_r + 1) for c in range(lo_c, hi_c + 1)} - obj
+        holes = [part for part in regions(empty, DIR4 if background_connectivity == 4 else DIR8)
+                 if not any(r in (lo_r, hi_r) or c in (lo_c, hi_c) for r, c in part)]
+        for r, c in obj:
+            answer[r][c] = 8 if holes else 2
+    return answer
+
+
+def corner_query():
+    grid = [[0] * 12 for _ in range(10)]
+    for r in range(3):
+        for c in range(3):
+            if (r in (0, 2) or c in (0, 2)) and (r, c) != (0, 0):
+                grid[r + 1][c + 1] = 6
+    for r in (6, 7):
+        for c in (7, 8):
+            grid[r][c] = 6
+    return grid
+
+
+def run(out):
+    root = find_root(__file__)
+    gen, source_path, source_sha = load_selected_generator(TASK, root=root)
+    assert source_sha == SOURCE
+    record = Catalog(root).get(TASK)
+    programs = {v["program_solution"] for v in record["variants"]}
+    assert len(programs) == 1
+    intended = next(iter(programs))
+    anchor = "(find-0-regions binary 0)"
+    assert intended.count(anchor) == 1
+    rival = intended.replace(anchor, "(map obj-cells (objects-8 binary 1))")
+    draws = [gen.generate(0, i, difficulty="medium") for i in range(5)]
+    query = corner_query()
+    grids = draws + [query]
+    assert all(gen.self_check(g, difficulty="medium") == [] for g in grids)
+    out = Path(out)
+    if out.exists():
+        raise FileExistsError(out)
+    out.mkdir(parents=True)
+    executions, outputs = [], {4: [], 8: []}
+    with RacketBridge(timeout=30, max_calls_before_restart=128) as bridge:
+        runtime = bridge.runtime_identity
+        for connectivity, program in [(4, intended), (8, rival)]:
+            body = strip_rule_wrapper(program)
+            for index, grid in enumerate(grids):
+                literal = "(" + " ".join("(" + " ".join(map(str, row)) + ")" for row in grid) + ")"
+                actual = bridge.eval_text(f"(let ((g '{literal})) {body})")
+                assert actual == independent(grid, connectivity)
+                outputs[connectivity].append(actual)
+                executions.append({"case": index, "background_connectivity": connectivity,
+                                   "program_sha256": sha(program.encode()), "input_sha256": sha(encoded(grid)),
+                                   "output": actual})
+    assert outputs[4][:5] == outputs[8][:5]
+    differences = [[r, c] for r, row in enumerate(outputs[4][5]) for c, value in enumerate(row)
+                   if value != outputs[8][5][r][c]]
+    assert len(differences) == 7
+    lesson = {"train": [{"input": g, "output": y} for g, y in zip(draws[:4], outputs[4][:4], strict=True)],
+              "test": [{"input": query, "output": outputs[4][5]}],
+              "rival_query_output": outputs[8][5],
+              "query_origin": "hand_authored_validator_domain_not_sampler_draw",
+              "demonstration_origin": {"seed": 0, "sample_indices": [0, 1, 2, 3], "difficulty": "medium", "overrides": {}}}
+    extra = {"seed": 0, "sample_index": 4, "difficulty": "medium", "input": draws[4],
+             "intended_output": outputs[4][4], "rival_output": outputs[8][4]}
+    for name, value in [("lesson.json", lesson), ("ordinary-query.json", extra), ("execution.json", executions)]:
+        (out / name).write_bytes(encoded(value))
+    (out / "intended.rkt").write_text(intended)
+    (out / "background-eight.rkt").write_text(rival)
+    report = {"schema": "arcpuzzles-background-connectivity-peer-v1", "task_id": TASK,
+              "status": "validator_domain_teaching_gap", "generator_sha256": source_sha,
+              "rule_hash": gen.RULE_HASH, "canonical_program_sha256": sha(intended.encode()),
+              "probe_sha256": sha(Path(__file__).read_bytes()), "racket": runtime,
+              "protected_evaluations": len(executions), "ordinary_draws": 5,
+              "ordinary_draw_self_check_failures": 0, "ordinary_draw_label_disagreements": 0,
+              "demonstration_rival_disagreements": [], "hand_authored_query_changed_cells": differences,
+              "hand_authored_query_self_check": [],
+              "artifact_sha256": {p.name: sha(p.read_bytes()) for p in out.iterdir() if p.is_file()},
+              "limits": ["Four demonstrations and a separate fifth check are actual ordinary draws from one seed; the contrasting query is manually authored and validator-admitted.",
+                         "No generated-query ambiguity, native-issued lesson, accepted parametric-family defect, failure frequency, or universal learnability claim.",
+                         "One additional rival is tested. Existing broader lesson, override, battery, and accepted-family checks were not rerun.",
+                         "No production, canonical authority, approval, audit-index or training-admission changes."]}
+    (out / "report.json").write_bytes(encoded(report))
+    print(json.dumps({"status": report["status"], "protected_evaluations": len(executions),
+                      "ordinary_draw_label_disagreements": 0, "authored_query_changed_cells": len(differences)}, sort_keys=True))
+    return report
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    run(parser.parse_args().out)
