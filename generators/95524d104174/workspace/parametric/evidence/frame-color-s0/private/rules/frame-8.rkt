(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((vert-col (find-first (lambda (c)
                                          (let* ((vals (map (lambda (r) (at g r c))
                                                            (range 0 h)))
                                                 (nz (filter (lambda (v) (!= v 0)) vals)))
                                            (for/or ((v nz))
                                                    (>= (count-if (lambda (x) (= x v))
                                                                  vals)
                                                        (- h 1)))))
                                        (range 0 w)))
                  (vert-color (first (sort-by (unique (filter (lambda (v) (!= v 0))
                                                              (map (lambda (r)
                                                                     (at g r vert-col))
                                                                   (range 0 h))))
                                              (lambda (v)
                                                (* -1
                                                   (count-if (lambda (x) (= x v))
                                                             (map (lambda (r)
                                                                    (at g r vert-col))
                                                                  (range 0 h))))))))
                  (horiz-row (find-first (lambda (r)
                                           (let* ((vals (map (lambda (c) (at g r c))
                                                             (range 0 w)))
                                                  (nz (filter (lambda (v)
                                                                (and
                                                                  (!= v 0)
                                                                  (!= v vert-color)))
                                                              vals)))
                                             (and
                                               (> (length nz) 0)
                                               (for/or ((v nz))
                                                       (>= (count-if (lambda (x)
                                                                       (= x v))
                                                                     vals)
                                                           (- w 1))))))
                                         (range 0 h))))
             (cellmap g
                      (r c v)
                      (if (and
                            (<= (abs (- r horiz-row)) 1)
                            (<= (abs (- c vert-col)) 1)
                            (not (and (= r horiz-row) (= c vert-col))))
                          8
                          v))))))