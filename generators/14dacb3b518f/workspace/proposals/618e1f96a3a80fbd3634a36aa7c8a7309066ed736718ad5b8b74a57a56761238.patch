+        expected = _mirror(pair["input"])
+        if pair["output"] != expected:
+            reasons.append(f"{role} output disagrees with the unique-zero-count rule")
+    if reasons:
+        return reasons
+
+    for name, competitor in LESSON_COMPETITORS.items():
+        survives = all(
