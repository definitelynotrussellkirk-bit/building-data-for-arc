+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+
+TASK_HOME = Path(__file__).resolve().parents[1]
+
+
+def _load_generator():
+    path = TASK_HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location("test_generator_07ae7be573fc", path)
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _pairs(generator, seed: int = 0):
+    return [
+        {"input": grid, "output": generator._mirror(grid)}
+        for index in range(5)
+        for grid in [generator.generate(seed, index)]
+    ]
+
+
+def test_seed_zero_rotation_rejects_most_enclosed_holes_shortcut():
+    generator = _load_generator()
+    pairs = _pairs(generator)
+    query = pairs[3]
+    demos = [pair for index, pair in enumerate(pairs) if index != 3]
+
+    rival = generator.LESSON_COMPETITORS["most_enclosed_holes"]
+    assert all(rival(pair["input"]) == pair["output"] for pair in demos)
+    assert rival(query["input"]) != query["output"]
+    assert generator.lesson_identifiable(demos, query) == [
+        "competitor 'most_enclosed_holes' matches every demo but changes the query answer"
+    ]
+
+
+def test_rotation_with_refuting_demo_is_accepted_by_declared_checker():
+    generator = _load_generator()
+    pairs = _pairs(generator)
+    query = pairs[0]
+    demos = [pair for index, pair in enumerate(pairs) if index != 0]
