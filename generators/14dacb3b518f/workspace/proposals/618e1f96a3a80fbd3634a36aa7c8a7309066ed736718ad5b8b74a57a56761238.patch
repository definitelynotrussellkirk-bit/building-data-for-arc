+def _component_crops_with_enclosed_holes(grid):
+    """Return row-major same-color component crops and enclosed-hole counts."""
+    if not grid or not grid[0]:
+        return []
+    h, w = len(grid), len(grid[0])
+    color = next((value for row in grid for value in row if value != 0), None)
+    if color is None:
+        return []
+
+    seen = set()
+    records = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if grid[r0][c0] != color or (r0, c0) in seen:
+                continue
+            stack = [(r0, c0)]
+            seen.add((r0, c0))
+            cells = set()
+            while stack:
+                row, col = stack.pop()
+                cells.add((row, col))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nxt = (row + dr, col + dc)
+                    if (0 <= nxt[0] < h and 0 <= nxt[1] < w
+                            and nxt not in seen
+                            and grid[nxt[0]][nxt[1]] == color):
+                        seen.add(nxt)
+                        stack.append(nxt)
+
+            top = min(row for row, _ in cells)
+            bottom = max(row for row, _ in cells)
+            left = min(col for _, col in cells)
+            right = max(col for _, col in cells)
+            crop = [list(row[left:right + 1]) for row in grid[top:bottom + 1]]
+
+            background = {
+                (row, col)
+                for row, values in enumerate(crop)
+                for col, value in enumerate(values)
+                if value == 0
+            }
+            visited = set()
+            enclosed_holes = 0
+            for start in sorted(background):
+                if start in visited:
+                    continue
+                region = [start]
+                visited.add(start)
+                touches_edge = False
+                while region:
+                    row, col = region.pop()
+                    if row in (0, len(crop) - 1) or col in (0, len(crop[0]) - 1):
+                        touches_edge = True
+                    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                        nxt = (row + dr, col + dc)
+                        if nxt in background and nxt not in visited:
+                            visited.add(nxt)
+                            region.append(nxt)
+                if not touches_edge:
+                    enclosed_holes += 1
+
+            records.append({
+                "top": top,
+                "left": left,
+                "crop": crop,
+                "enclosed_holes": enclosed_holes,
+            })
+    return records
+
+
+def _most_enclosed_holes(grid):
+    """Wrong but plausible rival: crop the row-major max-hole object."""
+    records = _component_crops_with_enclosed_holes(grid)
+    if not records:
+        return [list(row) for row in grid]
+    selected = max(
+        records,
+        key=lambda record: (
+            record["enclosed_holes"],
+            -record["top"],
+            -record["left"],
+        ),
+    )
+    return [list(row) for row in selected["crop"]]
+
+
+SEMANTIC_RIVALS = {"most_enclosed_holes": _most_enclosed_holes}
+LESSON_COMPETITORS = dict(SEMANTIC_RIVALS)
+
