@@ -0,0 +1,206 @@
+"""Build a compact, reproducible evidence bundle for the hole-threshold family."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import tempfile
+from typing import Any, Iterable
+
+_THIS_DIR = Path(__file__).resolve().parent
+_PROTOTYPE_PATH = _THIS_DIR / "prototype.py"
+_SPEC = importlib.util.spec_from_file_location(
+    "_arc_14dacb3b518f_hole_threshold_evidence_prototype", _PROTOTYPE_PATH
+)
+if _SPEC is None or _SPEC.loader is None:
+    raise ImportError(f"cannot load adjacent prototype at {_PROTOTYPE_PATH}")
+_PROTOTYPE = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(_PROTOTYPE)
+
+_COUNTS = ((2, 1), (2, 4), (3, 4), (6, 1), (6, 4))
+_SETTINGS = ({"min_holes": 1}, {"min_holes": 2})
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _validate_seeds(seeds: Iterable[Any]) -> tuple[int, ...]:
+    values = tuple(seeds)
+    if not values or len(values) > 8:
+        raise ValueError("seeds must contain 1..8 values")
+    if len(set(values)) != len(values):
+        raise ValueError("seeds must be distinct")
+    return tuple(_PROTOTYPE._validate_seed(seed) for seed in values)
+
+
+def _stress_summary(episode: dict[str, Any]) -> dict[str, Any]:
+    grid = episode["test"][-1]["input"]
+    facts = _PROTOTYPE.analyze_grid(grid)
+    if facts["errors"]:
+        raise AssertionError(f"stress query is invalid: {facts['errors']}")
+    border_contacts = {
+        "top": any(value == 6 for value in grid[0]),
+        "bottom": any(value == 6 for value in grid[-1]),
+        "left": any(row[0] == 6 for row in grid),
+        "right": any(row[-1] == 6 for row in grid),
+    }
+    if (len(grid), len(grid[0])) != (30, 30) or not all(border_contacts.values()):
+        raise AssertionError("four-query episode must end with a 30x30 all-border stress case")
+    return {
+        "shape": [30, 30],
+        "border_contacts": border_contacts,
+        "foreground_cells": sum(component["size"] for component in facts["components"]),
+        "hole_counts": sorted(component["hole_count"] for component in facts["components"]),
+    }
+
+
+def build(output: Path | str, *, seeds: Iterable[Any] = (0, 17)) -> dict[str, Any]:
+    destination = Path(output)
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError(destination)
+    selected_seeds = _validate_seeds(seeds)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    stage = Path(tempfile.mkdtemp(prefix=f".{destination.name}-", dir=destination.parent))
+    try:
+        public_dir = stage / "public"
+        public_dir.mkdir()
+        episodes: list[dict[str, Any]] = []
+        boundary_checks: list[dict[str, Any]] = []
+        public_ids: set[str] = set()
+
+        for seed in selected_seeds:
+            for settings in _SETTINGS:
+                threshold = settings["min_holes"]
+                for demos, queries in _COUNTS:
+                    episode = _PROTOTYPE.generate_episode(
+                        seed, min_holes=threshold, demos=demos, queries=queries
+                    )
+                    audit = _PROTOTYPE.audit_episode(episode)
+                    if audit["surviving_settings"] != [settings]:
+                        raise AssertionError(
+                            f"setting not uniquely identified for seed={seed}, counts={(demos, queries)}"
+                        )
+                    if audit["harmful_ambiguities"]:
+                        raise AssertionError(
+                            f"harmful finite ambiguity for seed={seed}: {audit['harmful_ambiguities']}"
+                        )
+                    if any(row["fits_demonstrations"] for row in audit["rivals"].values()):
+                        raise AssertionError(f"named shortcut survived for seed={seed}, threshold={threshold}")
+                    all_inputs = [pair["input"] for pair in episode["train"] + episode["test"]]
+                    serialized = [json.dumps(grid, separators=(",", ":")) for grid in all_inputs]
+                    if len(serialized) != len(set(serialized)):
+                        raise AssertionError("episode inputs are not distinct")
+                    boundary_checks.append(
+                        {
+                            "seed": seed,
+                            "settings": settings,
+                            "demos": demos,
+                            "queries": queries,
+                            "unique_inputs": len(serialized),
+                            "sole_survivor": audit["surviving_settings"],
+                            "rivals_refuted": sorted(audit["rivals"]),
+                        }
+                    )
+
+                episode = _PROTOTYPE.generate_episode(
+                    seed, min_holes=threshold, demos=3, queries=4
+                )
+                identifier = _PROTOTYPE.public_id(episode)
+                if identifier in public_ids:
+                    raise ValueError("duplicate visible public payload")
+                public_ids.add(identifier)
+                payload = _PROTOTYPE.public_bytes(episode)
+                (public_dir / f"{identifier}.json").write_bytes(payload)
+                episodes.append(
+                    {
+                        "seed": seed,
+                        "settings": settings,
+                        "public_id": identifier,
+                        "public_sha256": hashlib.sha256(payload).hexdigest(),
+                        "program_sha256": hashlib.sha256(
+                            episode["program_solution"].encode()
+                        ).hexdigest(),
+                        "audit": _PROTOTYPE.audit_episode(episode),
+                        "stress": _stress_summary(episode),
+                    }
+                )
+
+        # Explicitly prove demo/query prefix invariance at both request extremes.
+        prefix_checks = []
+        for seed in selected_seeds:
+            small = _PROTOTYPE.episode_inputs(seed, demos=2, queries=1)
+            large = _PROTOTYPE.episode_inputs(seed, demos=6, queries=4)
+            row = {
+                "seed": seed,
+                "train_prefix_equal": small["train"] == large["train"][:2],
+                "test_prefix_equal": small["test"] == large["test"][:1],
+            }
+            if not all(value for key, value in row.items() if key != "seed"):
+                raise AssertionError(f"count-prefix invariance failed: {row}")
+            prefix_checks.append(row)
+
+        generator_path = _THIS_DIR.parents[1] / "generator.py"
+        report = {
+            "schema": "arcpuzzles-hole-threshold-evidence-v1",
+            "status": "passed",
+            "task_id": _PROTOTYPE.TASK_ID,
+            "prototype_version": _PROTOTYPE.VERSION,
+            "generator_sha256": _sha256(generator_path),
+            "prototype_sha256": _sha256(_PROTOTYPE_PATH),
+            "adapter_sha256": _sha256(_THIS_DIR / "adapter.py"),
+            "promotion_sha256": _sha256(_THIS_DIR / "promotion.json"),
+            "settings": list(_SETTINGS),
+            "seeds": list(selected_seeds),
+            "counts_checked": [list(item) for item in _COUNTS],
+            "episodes": episodes,
+            "boundary_checks": boundary_checks,
+            "prefix_checks": prefix_checks,
+            "sequential_dependency": {
+                "step_a": "Extract each 4-connected color-6 component and count enclosed background regions in its bounding box.",
+                "intermediate": "The input-dependent integer hole_count for each component.",
+                "step_b": "Compare hole_count with the episode-fixed min_holes threshold and paint the component 8 or 2.",
+                "why_b_depends_on_a": "The output color cannot be selected until the component-specific hole count is known.",
+            },
+            "limits": [
+                "Finite seeds, declared settings, count boundaries, and three named shortcut rivals only.",
+                "Python labels are independently replayed through protected Racket during native qualification.",
+                "No training admission or measured learning gain is claimed.",
+            ],
+        }
+        (stage / "report.json").write_text(
+            json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+        )
+        os.replace(stage, destination)
+        return report
+    except Exception:
+        shutil.rmtree(stage, ignore_errors=True)
+        raise
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed", type=int, action="append", dest="seeds")
+    args = parser.parse_args()
+    report = build(args.out, seeds=tuple(args.seeds) if args.seeds else (0, 17))
+    print(
+        json.dumps(
+            {
+                "out": str(args.out.resolve()),
+                "status": report["status"],
+                "episodes": len(report["episodes"]),
+                "boundary_checks": len(report["boundary_checks"]),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
