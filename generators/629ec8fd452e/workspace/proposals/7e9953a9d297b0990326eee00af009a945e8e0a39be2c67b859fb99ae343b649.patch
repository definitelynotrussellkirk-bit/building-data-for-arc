+REPO_ROOT = Path(__file__).resolve().parents[3]
+PROBE_PATH = TASK_ROOT / "workspace" / "control_contract_probe.py"
+EXPECTED_SHA256 = "745bd0c501d3aaf8c347089d75715d46626a64bcb21e9374626a0b3922a2f081"
+
+
+def _load_probe():
+    assert PROBE_PATH.exists(), "control-contract probe has not been built"
