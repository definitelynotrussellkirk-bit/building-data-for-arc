+"""Replay dead-control and isolation-contract findings for peer 5ec08fa47c08.
+
+This is an optional, read-only peer probe.  It pins the exact generator source,
+uses current public loading helpers, and writes one compact JSON artifact that a
+future owner can rerun before choosing whether to repair the controls or narrow
+the declared contract.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "5ec08fa47c08"
+EXPECTED_SOURCE_SHA256 = "745bd0c501d3aaf8c347089d75715d46626a64bcb21e9374626a0b3922a2f081"
+CONTROL_PAIRS = (
+    ("n_colors", 2, 5),
+    ("palette_size", 2, 5),
+    ("n_distinct_colors", 2, 5),
+    ("palette_kind", "warm", "cool"),
+    ("texture", "warm", "cool"),
+)
+
+
+def _grid_bytes(grid: list[list[int]]) -> bytes:
+    return (json.dumps(grid, separators=(",", ":")) + "\n").encode("utf-8")
+
+
+def _has_orthogonal_contact(grid: list[list[int]]) -> bool:
+    cells = {
+        (r, c)
+        for r, row in enumerate(grid)
+        for c, value in enumerate(row)
+        if value != 0
+    }
+    return any(
+        (r + dr, c + dc) in cells
+        for r, c in cells
+        for dr, dc in ((1, 0), (0, 1))
+    )
+
+
+def _manual_adjacent_grid() -> list[list[int]]:
+    grid = [[0] * 5 for _ in range(5)]
+    grid[1][1] = 2
+    grid[1][2] = 3  # Direct orthogonal contact contradicts the declared isolation invariant.
+    grid[3][3] = 2
+    grid[4][4] = 3
+    return grid
+
+
+def run(output: Path, *, root: Path | None = None, seeds: int = 64) -> dict[str, Any]:
+    if type(seeds) is not int or seeds < 1:
+        raise ValueError("seeds must be a positive exact integer")
+    resolved_root = Path(root).resolve() if root is not None else find_root(__file__)
+    generator, source_path, source_sha256 = load_selected_generator(TASK_ID, root=resolved_root)
+    if source_sha256 != EXPECTED_SOURCE_SHA256:
+        raise ValueError(
+            f"peer source differs from assigned source: {source_sha256}"
+        )
+
+    control_rows = []
+    for axis, left_value, right_value in CONTROL_PAIRS:
+        left = generator.generate(
+            123,
+            7,
+            difficulty="medium",
+            **{axis: left_value},
+        )
+        right = generator.generate(
+            123,
+            7,
+            difficulty="medium",
+            **{axis: right_value},
+        )
+        left_bytes = _grid_bytes(left)
+        right_bytes = _grid_bytes(right)
+        control_rows.append(
+            {
+                "axis": axis,
+                "left_request": left_value,
+                "right_request": right_value,
+                "byte_identical": left_bytes == right_bytes,
+                "left_sha256": hashlib.sha256(left_bytes).hexdigest(),
+                "right_sha256": hashlib.sha256(right_bytes).hexdigest(),
+                "left_self_check_errors": generator.self_check(left),
+                "right_self_check_errors": generator.self_check(right),
+            }
+        )
+
+    adjacent_seeds = []
+    generated_errors = []
+    for seed in range(seeds):
+        grid = generator.generate(seed, 0, difficulty="medium")
+        errors = generator.self_check(grid)
+        if errors:
+            generated_errors.append({"seed": seed, "errors": errors})
+        if _has_orthogonal_contact(grid):
+            adjacent_seeds.append(seed)
+
+    manual = _manual_adjacent_grid()
+    report: dict[str, Any] = {
+        "schema": "arcpuzzles-optional-peer-control-contract-probe-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "source": {
+            "path": str(source_path.relative_to(resolved_root)),
+            "sha256": source_sha256,
+        },
+        "control_pairs": control_rows,
+        "manual_adjacent_grid": {
+            "input": manual,
+            "has_orthogonal_contact": _has_orthogonal_contact(manual),
+            "self_check_errors": generator.self_check(manual),
+        },
+        "generated_adjacency_census": {
+            "difficulty": "medium",
+            "sample_index": 0,
+            "checked": seeds,
+            "with_orthogonal_contact": len(adjacent_seeds),
+            "seeds_with_contact": adjacent_seeds,
+            "generated_self_check_failures": generated_errors,
+        },
+        "finding": (
+            "Five advertised semantic control pairs produce byte-identical grids at the "
+            "same seed/sample, because the current generator reads none of those controls. "
+            "The declared all-isolated invariant is also neither constructed nor checked: "
+            "ordinary draws frequently contain orthogonally touching foreground cells, and "
+            "a hand-built touching grid passes self_check."
+        ),
+        "suggested_repair": (
+            "Choose one owner-level contract: either honor a single canonical color-count "
+            "axis plus a real palette axis through gen_ctx and place cells from an independent "
+            "set, or remove the redundant dead axes. In either case, strengthen self_check to "
+            "validate rectangular integer grids, the supported palette/count envelope, and "
+            "orthogonal isolation."
+        ),
+        "limits": (
+            "This is a finite source-bound control/invariant probe, not a production repair, "
+            "approval decision, distribution battery, or training-admission claim."
+        ),
+    }
+    if not all(row["byte_identical"] for row in control_rows):
+        raise AssertionError("a retained dead-control witness changed")
+    if report["manual_adjacent_grid"]["self_check_errors"]:
+        raise AssertionError("manual isolation counterexample is no longer accepted")
+    if not adjacent_seeds:
+        raise AssertionError("bounded generated adjacency witness disappeared")
+    if generated_errors:
+        raise AssertionError("current generated examples unexpectedly fail self_check")
+
+    output = Path(output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seeds", type=int, default=64)
+    args = parser.parse_args()
+    report = run(args.out, seeds=args.seeds)
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "task_id": TASK_ID,
+                "dead_control_pairs": sum(
+                    row["byte_identical"] for row in report["control_pairs"]
+                ),
+                "generated_with_orthogonal_contact": report[
+                    "generated_adjacency_census"
+                ]["with_orthogonal_contact"],
+                "generated_checked": report["generated_adjacency_census"]["checked"],
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
