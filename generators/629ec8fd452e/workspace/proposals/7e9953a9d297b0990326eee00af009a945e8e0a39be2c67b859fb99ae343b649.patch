+"""Replay the whole-component shortcut surviving peer 6237039401ed lessons.
+
+The executable rule is cell-local: only gray cells participating in at least one
+complete 2x2 window recolor.  The current ordinary grammar makes every target
+component a solid 2x2/2x3/3x2/3x3 rectangle, so a plausible component-level
+rival is observationally equivalent on generated lessons.  This probe binds the
+source, checks the full declared profile cross-product plus a seed census, then
+uses a one-cell tail as a canonical-executable disagreement witness.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+TASK_ID = "6237039401ed"
+EXPECTED_SOURCE_SHA256 = "02d946ee455d49b46f946479fdcf22139b6c0720d90f4d9ae37edb1ebe9a5b93"
+
+
+def whole_component_rival(generator, grid: list[list[int]]) -> list[list[int]]:
+    """Recolor an entire color-5 component when any of it belongs to a 2x2."""
+    output = [row[:] for row in grid]
+    target_cells = generator._target_cells(grid)
+    for component in generator._color5_components(grid):
+        if component & target_cells:
+            for row, col in component:
+                output[row][col] = 1
+    return output
+
+
+def _canonical_program(root: Path) -> str:
+    programs = set()
+    with canonical_path(root).open(encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("task_id") == TASK_ID:
+                programs.add(row["program_solution"])
+    if len(programs) != 1:
+        raise ValueError(f"expected one canonical program, found {len(programs)}")
+    return programs.pop()
+
+
+def _tailed_query() -> list[list[int]]:
+    grid = [[0] * 8 for _ in range(8)]
+    for row, col in (
+        (0, 0), (0, 1), (1, 0), (1, 1),
+        (6, 6), (6, 7), (7, 6), (7, 7),
+    ):
+        grid[row][col] = 5
+    grid[0][2] = 5
+    return grid
+
+
+def _diff(reference: list[list[int]], rival: list[list[int]]) -> list[dict[str, int]]:
+    return [
+        {"row": row, "col": col, "reference": left, "rival": right}
+        for row, (left_row, right_row) in enumerate(zip(reference, rival))
+        for col, (left, right) in enumerate(zip(left_row, right_row))
+        if left != right
+    ]
+
+
+def _racket_label(
+    root: Path, program: str, grid: list[list[int]]
+) -> tuple[list[list[int]], dict[str, Any]]:
+    # Use the packet's portable protected evaluator rather than the legacy
+    # repository-only scripts namespace.
+    from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+    runtime = root / "shared/runtime"
+    with _local_imports(runtime, runtime):
+        apply_program, identity, bridge = _real_evaluator(runtime)
+        try:
+            result = apply_program(program, grid)
+        finally:
+            bridge.close()
+    return result, identity
+
+
+def run(
+    output: Path,
+    *,
+    root: Path | None = None,
+    seed_count: int = 32,
+    evaluate_racket: bool = True,
+) -> dict[str, Any]:
+    if type(seed_count) is not int or seed_count < 1:
+        raise ValueError("seed_count must be a positive exact integer")
+    resolved_root = Path(root).resolve() if root is not None else find_root(__file__)
+    generator, source_path, source_sha256 = load_selected_generator(TASK_ID, root=resolved_root)
+    if source_sha256 != EXPECTED_SOURCE_SHA256:
+        raise ValueError(
+            f"peer source differs from assigned source: {source_sha256}"
+        )
+
+    mismatches = []
+    checked = 0
+    # Bounded seed census across every scheduled target/distractor profile.
+    for seed in range(seed_count):
+        for sample_index in range(4):
+            grid = generator.generate(seed, sample_index, difficulty="medium")
+            reference = generator.rule_mirror(grid)
+            rival = whole_component_rival(generator, grid)
+            checked += 1
+            if rival != reference:
+                mismatches.append(
+                    {"kind": "seed_census", "seed": seed, "sample_index": sample_index}
+                )
+
+    # Exhaust the declared target x distractor x target-count cross-product.
+    for target_shape in generator.TARGET_SHAPES:
+        for distractor_shape in generator.DISTRACTOR_SHAPES:
+            for n_targets in (2, 3):
+                grid = generator.generate(
+                    991,
+                    17,
+                    difficulty="medium",
+                    grid_h=12,
+                    grid_w=12,
+                    n_targets=n_targets,
+                    target_shape=target_shape,
+                    distractor_shape=distractor_shape,
+                )
+                reference = generator.rule_mirror(grid)
+                rival = whole_component_rival(generator, grid)
+                checked += 1
+                if rival != reference:
+                    mismatches.append(
+                        {
+                            "kind": "profile_cross_product",
+                            "target_shape": target_shape,
+                            "distractor_shape": distractor_shape,
+                            "n_targets": n_targets,
+                        }
+                    )
+
+    query = _tailed_query()
+    reference = generator.rule_mirror(query)
+    rival = whole_component_rival(generator, query)
+    different_cells = _diff(reference, rival)
+    program = _canonical_program(resolved_root)
+    racket_result = None
+    racket_identity = None
+    if evaluate_racket:
+        racket_result, racket_identity = _racket_label(resolved_root, program, query)
+        if racket_result != reference:
+            raise AssertionError("task-local mirror differs from protected Racket on tailed query")
+
+    report: dict[str, Any] = {
+        "schema": "arcpuzzles-optional-peer-learnability-probe-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "source": {
+            "path": str(source_path.relative_to(resolved_root)),
+            "sha256": source_sha256,
+        },
+        "reference_program_sha256": hashlib.sha256(program.encode("utf-8")).hexdigest(),
+        "rival": {
+            "name": "recolor_whole_component_if_it_contains_any_complete_2x2",
+            "mechanism": (
+                "Find every 4-connected gray component; if any cell participates in a "
+                "complete gray 2x2, recolor the entire component."
+            ),
+        },
+        "ordinary_generated_cases": {
+            "checked": checked,
+            "seed_count": seed_count,
+            "scheduled_samples_per_seed": 4,
+            "declared_profile_cross_product": 32,
+            "mismatches": mismatches,
+        },
+        "tailed_query": {
+            "input": query,
+            "self_check_errors": generator.self_check(query),
+            "reference_output": reference,
+            "rival_output": rival,
+            "different_cells": different_cells,
+            "protected_racket_output": racket_result,
+            "protected_racket_identity": racket_identity,
+        },
+        "finding": (
+            "The whole-component rival matches every checked ordinary generated example. "
+            "This is structural, not merely a seed accident: all declared target profiles are "
+            "solid rectangles whose every cell participates in a complete 2x2. On a component "
+            "with one nonparticipating tail, the exact canonical rule preserves the tail while "
+            "the rival recolors it; current self_check excludes that decisive witness."
+        ),
+        "suggested_repair": (
+            "Add at least one lawful target profile containing both participating and "
+            "nonparticipating cells (for example, a 2x2 with a one-cell tail) to every visible "
+            "lesson prefix, and update the declared grammar/self_check accordingly. Keep the "
+            "existing near-miss distractor so the all-gray shortcut remains refuted."
+        ),
+        "limits": (
+            "Finite source-bound seed/profile audit plus one executable rival. No production "
+            "source was changed; owner review is required before broadening this accepted grammar."
+        ),
+    }
+    if mismatches:
+        raise AssertionError(f"whole-component rival no longer fits ordinary grammar: {mismatches[:3]}")
+    if not report["tailed_query"]["self_check_errors"]:
+        raise AssertionError("decisive tailed query unexpectedly entered the ordinary grammar")
+    if different_cells != [{"row": 0, "col": 2, "reference": 5, "rival": 1}]:
+        raise AssertionError(f"retained tail disagreement changed: {different_cells}")
+
+    output = Path(output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seed-count", type=int, default=32)
+    parser.add_argument("--skip-racket", action="store_true")
+    args = parser.parse_args()
+    report = run(
+        args.out,
+        seed_count=args.seed_count,
+        evaluate_racket=not args.skip_racket,
+    )
+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "task_id": TASK_ID,
+                "ordinary_checked": report["ordinary_generated_cases"]["checked"],
+                "ordinary_mismatches": len(report["ordinary_generated_cases"]["mismatches"]),
+                "tailed_query_differences": len(report["tailed_query"]["different_cells"]),
+                "protected_racket": report["tailed_query"]["protected_racket_output"] is not None,
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
