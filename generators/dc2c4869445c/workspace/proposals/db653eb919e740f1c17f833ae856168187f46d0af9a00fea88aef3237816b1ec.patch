+++ b/repo/generators/dc59d4c62234/workspace/learnability_probe.py
@@ -0,0 +1,190 @@
+"""Bounded source-pinned probe for the fixed-slot square shortcut.
+
+The canonical rule detects solid squares anywhere inside each separator-bounded
+band.  The current generator always places them at columns 1 + k*(N+3), so a
+wrong rule can sample those slots instead of detecting squares.  This probe
+shows that shortcut fitting ordinary demonstrations and then constructs a
+lawful shifted-square query on which it fails.  Run through ``review.py run``.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "dc59d4c62234"
+HERE = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+GEN, GENERATOR_PATH, GENERATOR_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _raw(value: Any) -> bytes:
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+def _sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _canonical_program() -> str:
+    path = ROOT / "shared/data/canonical/puzzles.jsonl"
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if not line.strip():
+            continue
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID and row.get("program_solution"):
+            return str(row["program_solution"])
+    raise FileNotFoundError(f"canonical program missing for {TASK_ID}")
+
+
+def _bands(grid: list[list[int]]) -> list[tuple[int, int]]:
+    h, w = len(grid), len(grid[0])
+    separators = [r for r in range(h) if len(set(grid[r])) == 1]
+    bands: list[tuple[int, int]] = []
+    start = 0
+    for sep in separators:
+        if start < sep:
+            bands.append((start, sep - 1))
+        start = sep + 1
+    if start < h:
+        bands.append((start, h - 1))
+    return bands
+
+
+def fixed_slot_output(grid: list[list[int]]) -> list[list[int]]:
+    """Wrong rule: infer N, then sample generator-fixed square slots."""
+    w = len(grid[0])
+    out: list[list[int]] = []
+    for r0, r1 in _bands(grid):
+        n = r1 - r0 + 1
+        cols = []
+        c = 1
+        while c + n < w:
+            cols.append(c)
+            c += n + 3
+        out.append([grid[r0][c0] for c0 in cols])
+    return out
+
+
+def _shift_first_square(grid: list[list[int]]) -> list[list[int]]:
+    """Move the first solid square one column right, preserving all semantics."""
+    moved = copy.deepcopy(grid)
+    bands = _bands(moved)
+    if not bands:
+        raise ValueError("no bands")
+    r0, r1 = bands[0]
+    n = r1 - r0 + 1
+    old_col = 1
+    new_col = 2
+    w = len(moved[0])
+    if new_col + n >= w:
+        raise ValueError("no room for shifted square")
+    sep_color = moved[0][0]
+    filler = [color for color in range(10) if color != sep_color]
+    square_color = moved[r0][old_col]
+    for r in range(n):
+        for c in range(old_col, old_col + n):
+            moved[r0 + r][c] = filler[(r * 2 + c * 3 + 0) % len(filler)]
+    for r in range(n):
+        for c in range(new_col, new_col + n):
+            moved[r0 + r][c] = square_color
+    return moved
+
+
+def run(destination: Path) -> dict[str, Any]:
+    from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+    destination = Path(destination)
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError(f"choose a new output path: {destination}")
+    program = _canonical_program()
+    runtime = ROOT / "shared/runtime"
+    evaluations = 0
+    with _local_imports(runtime, HERE):
+        apply, backend, bridge = _real_evaluator(runtime)
+        try:
+            def label(grid: list[list[int]]) -> list[list[int]]:
+                nonlocal evaluations
+                evaluations += 1
+                return apply(program, grid)
+
+            # Ordinary generated demonstrations all preserve the fixed-slot shortcut.
+            demos = []
+            for sample_index in range(3):
+                grid = GEN.generate(0, sample_index, difficulty="medium")
+                output = label(grid)
+                shortcut = fixed_slot_output(grid)
+                if shortcut != output:
+                    raise AssertionError("fixed-slot shortcut did not fit ordinary demo")
+                demos.append({"input": grid, "output": output})
+
+            witness = None
+            for seed in range(64):
+                base = GEN.generate(seed, 3, difficulty="medium")
+                shifted = _shift_first_square(base)
+                canonical_base = label(base)
+                canonical_shifted = label(shifted)
+                wrong = fixed_slot_output(shifted)
+                if canonical_shifted == canonical_base and wrong != canonical_shifted:
+                    witness = {
+                        "seed": seed,
+                        "input": shifted,
+                        "canonical_output": canonical_shifted,
+                        "wrong_output": wrong,
+                        "changed_output_cells": sum(
+                            a != b
+                            for row_a, row_b in zip(canonical_shifted, wrong)
+                            for a, b in zip(row_a, row_b)
+                        ),
+                        "construction": "move the first N×N square from column 1 to column 2 in band 0",
+                    }
+                    break
+            if witness is None:
+                raise AssertionError("no shifted-square witness found")
+        finally:
+            bridge.close()
+
+    result = {
+        "schema": "dc59d4c62234-fixed-slot-probe-v1",
+        "status": "finding",
+        "task_id": TASK_ID,
+        "finding": (
+            "The current generator always places squares at columns 1+k*(N+3). "
+            "A fixed-slot sampler fits all three ordinary demonstrations but fails "
+            "when a square is lawfully shifted inside its band."
+        ),
+        "canonical_program_sha256": _sha(program.encode()),
+        "generator_path": GENERATOR_PATH.relative_to(ROOT).as_posix(),
+        "generator_sha256": GENERATOR_SHA256,
+        "protected_racket": True,
+        "racket_evaluations": evaluations,
+        "backend": backend,
+        "ordinary_demonstrations": demos,
+        "wrong_rule": "infer band height N and sample cells at columns 1+k*(N+3), without detecting solid squares",
+        "witness": witness,
+        "suggested_repair": (
+            "Vary square columns constructively across visible demonstrations while "
+            "preserving left-to-right order and non-overlap."
+        ),
+        "limits": "One declared shortcut and one constructive counterexample; not a universal learnability proof.",
+    }
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_bytes(_raw(result))
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    result = run(args.out)
+    print(json.dumps({k: result[k] for k in ("status", "task_id", "racket_evaluations", "finding")}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
