+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from puzzle_generators.per_puzzle.dc59d4c62234 import generator as gen
+
+
+def _probe_module():
+    path = Path(__file__).resolve().parents[1] / "workspace/learnability_probe.py"
+    spec = importlib.util.spec_from_file_location("_dc59d4c62234_probe_test", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_generated_inputs_are_deterministic_valid_and_arc_sized() -> None:
+    for difficulty in ("easy", "medium", "hard"):
+        first = gen.generate(17, 3, difficulty=difficulty)
+        second = gen.generate(17, 3, difficulty=difficulty)
+        assert first == second
+        assert first is not second
+        assert gen.self_check(first) == []
+        assert 1 <= len(first) <= 30
+        assert 1 <= len(first[0]) <= 30
+
+
+def test_source_pinned_probe_builds_a_fixed_slot_counterexample(tmp_path: Path) -> None:
+    probe = _probe_module()
+    result = probe.run(tmp_path / "probe.json")
+    assert result["status"] == "finding"
+    assert result["protected_racket"] is True
+    assert result["racket_evaluations"] == 5
+    assert result["witness"]["changed_output_cells"] == 1
+    assert result["ordinary_demonstrations"]
diff --git a/repo/generators/dc59d4c62234/workspace/learnability_probe.py b/repo/generators/dc59d4c62234/workspace/learnability_probe.py
new file mode 100644
