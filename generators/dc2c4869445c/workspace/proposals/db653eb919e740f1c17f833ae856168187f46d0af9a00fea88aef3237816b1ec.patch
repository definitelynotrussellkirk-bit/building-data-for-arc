+"""Bounded protected-Racket lesson audit against the task's named rivals."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from reviewer_support import find_root, load_selected_generator
+
+TASK_ID = "d65971416c2d"
+HERE = Path(__file__).resolve().parent
+ROOT = find_root(__file__)
+GEN, GENERATOR_PATH, GENERATOR_SHA256 = load_selected_generator(TASK_ID, root=ROOT)
+
+
+def _raw(value: Any) -> bytes:
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+def _sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _canonical_program() -> str:
+    for line in (ROOT / "shared/data/canonical/puzzles.jsonl").read_text(encoding="utf-8").splitlines():
+        if not line.strip():
+            continue
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID and row.get("program_solution"):
+            return str(row["program_solution"])
+    raise FileNotFoundError(f"canonical program missing for {TASK_ID}")
+
+
+def run(destination: Path) -> dict[str, Any]:
+    from arcpuzzles.parametric_worker import _local_imports, _real_evaluator
+
+    destination = Path(destination)
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError(f"choose a new output path: {destination}")
+    program = _canonical_program()
+    runtime = ROOT / "shared/runtime"
+    evaluations = 0
+    ambiguous: list[dict[str, Any]] = []
+    coverage = {name: 0 for name in GEN.SEMANTIC_RIVALS}
+    with _local_imports(runtime, HERE):
+        apply, backend, bridge = _real_evaluator(runtime)
+        try:
+            for seed in range(16):
+                demos = []
+                queries = []
+                for sample_index in range(8):
+                    grid = GEN.generate(seed, sample_index, difficulty="medium")
+                    output = apply(program, grid)
+                    evaluations += 1
+                    if output != GEN.rule_mirror(grid):
+                        raise AssertionError((seed, sample_index, "Racket/Python mirror mismatch"))
+                    pair = {"input": grid, "output": output}
+                    (demos if sample_index < 4 else queries).append(pair)
+                for name, rival in GEN.SEMANTIC_RIVALS.items():
+                    if all(rival(pair["input"]) == pair["output"] for pair in demos):
+                        changed = [
+                            index for index, pair in enumerate(queries)
+                            if rival(pair["input"]) != pair["output"]
+                        ]
+                        if changed:
+                            ambiguous.append({
+                                "seed": seed,
+                                "rival": name,
+                                "changed_query_indices": changed,
+                                "demos": demos,
+                                "query": queries[changed[0]],
+                                "rival_output": rival(queries[changed[0]]["input"]),
+                            })
+                    else:
+                        coverage[name] += 1
+        finally:
+            bridge.close()
+
+    result = {
+        "schema": "d65971416c2d-rival-probe-v1",
+        "status": "finding" if ambiguous else "no_finding",
+        "task_id": TASK_ID,
+        "canonical_program_sha256": _sha(program.encode()),
+        "generator_path": GENERATOR_PATH.relative_to(ROOT).as_posix(),
+        "generator_sha256": GENERATOR_SHA256,
+        "protected_racket": True,
+        "racket_evaluations": evaluations,
+        "backend": backend,
+        "lessons": 16,
+        "demonstrations_per_lesson": 4,
+        "queries_per_lesson": 4,
+        "rivals": sorted(GEN.SEMANTIC_RIVALS),
+        "demo_refutation_counts": coverage,
+        "ambiguous_cases": ambiguous,
+        "finding": (
+            "A named rival fits every demonstration and changes a query."
+            if ambiguous else
+            "No named rival fit all four scheduled demonstrations while changing any of four later queries."
+        ),
+        "limits": "Finite 16-seed audit of five declared rivals; not a universal uniqueness claim.",
+    }
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_bytes(_raw(result))
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    result = run(args.out)
+    print(json.dumps({k: result[k] for k in ("status", "task_id", "racket_evaluations", "finding")}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
