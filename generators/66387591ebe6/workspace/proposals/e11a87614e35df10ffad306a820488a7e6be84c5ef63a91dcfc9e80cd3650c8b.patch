+"""Bounded peer probe: do default demos identify all colors as crop anchors?
+
+Run from the packet root:
+  WORK/.venv/bin/python review.py run python3 \
+    generators/6737eb62cf42/workspace/frequency_extremes_probe.py
+
+The five canonical labels and two four-pair lessons share ten unique inputs.
+All labels and the alternative are executed with the protected local Racket
+backend. This is a source-bound counterexample, not a qualification or approval.
+"""
+from __future__ import annotations
+
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+TASK = "6737eb62cf42"
+HOME = ROOT / "generators" / TASK
+sys.dont_write_bytecode = True
+sys.path[:0] = [str(ROOT / "src"), str(ROOT / "shared/runtime")]
+
+from arcpuzzles import Catalog
+from arcpuzzles.parametric_worker import _real_evaluator
+
+
+def sha(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def frequency_extreme_crop(grid):
+    """Keep color groups of minimum or maximum nonzero frequency as anchors."""
+    counts = Counter(v for row in grid for v in row if v != 0)
+    if not counts:
+        return [[0]]
+    low, high = min(counts.values()), max(counts.values())
+    cells = [(r, c) for r, row in enumerate(grid) for c, v in enumerate(row)
+             if v and counts[v] in (low, high)]
+    r0, r1 = min(r for r, _ in cells), max(r for r, _ in cells)
+    c0, c1 = min(c for _, c in cells), max(c for _, c in cells)
+    return [row[c0:c1 + 1] for row in grid[r0:r1 + 1]]
+
+
+def main():
+    catalog = Catalog(ROOT)
+    selected = catalog.describe(TASK)
+    rule_task_id = selected.get("rule_task_id", TASK)
+    rows = catalog._variants()[rule_task_id]
+    programs = {row["program_solution"] for row in rows
+                if isinstance(row.get("program_solution"), str)}
+    assert len(programs) == 1, "selected canonical program must be unambiguous"
+    program = programs.pop()
+    rule_hash = sha(" ".join(program.split()))[:12]
+    assert rule_hash == selected["rule_hash"]
+    source = HOME / "generator.py"
+    spec = importlib.util.spec_from_file_location("peer_crop_generator", source)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    assert module.RULE_HASH == rule_hash
+
+    candidate_file = HOME / "workspace/frequency_extremes.rkt"
+    candidate = candidate_file.read_text()
+    evaluate, runtime_identity, bridge = _real_evaluator(ROOT / "shared/runtime")
+    executions = 0
+    cache = {}
+
+    def pair(grid, origin):
+        nonlocal executions
+        key = json.dumps(grid, separators=(",", ":"))
+        if key not in cache:
+            output = evaluate(program, grid)
+            alternative = evaluate(candidate, grid)
+            executions += 2
+            assert alternative == frequency_extreme_crop(grid)
+            assert output == module.rule_mirror(grid)
+            cache[key] = (output, alternative)
+        output, alternative = cache[key]
+        return {"input": grid, "output": output, "alternative_output": alternative,
+                "alternative_fits": alternative == output, "origin": origin}
+
+    try:
+        canonical = []
+        for row_index, row in enumerate(rows):
+            for split in ("train", "test"):
+                for index, original in enumerate(row.get(split, [])):
+                    if "output" not in original:
+                        continue
+                    result = pair(original["input"],
+                                  {"canonical_row": row_index, "split": split, "index": index})
+                    assert result["output"] == original["output"]
+                    canonical.append(result)
+        seed = 6737
+        demos = [pair(module.generate(seed, index), {"seed": seed, "sample_index": index,
+                       "difficulty": None, "overrides": {}}) for index in range(3)]
+        lessons = []
+        for name, overrides in (
+            ("default_control", {}),
+            ("lawful_paired_three_color_query", {"texture": "paired_objects", "palette_size": 3}),
+        ):
+            query = pair(module.generate(seed, 3, **overrides),
+                         {"seed": seed, "sample_index": 3, "difficulty": None,
+                          "overrides": overrides})
+            query["self_check"] = module.self_check(query["input"])
+            query["observed_axes"] = module.observe_overrides(query["input"])
+            lessons.append({"name": name, "train": demos, "test": [query],
+                "alternative_fits_all_demos": all(p["alternative_fits"] for p in demos),
+                "alternative_changes_query": not query["alternative_fits"],
+                "declared_lesson_identifiable_findings": module.lesson_identifiable(demos, query)})
+    finally:
+        bridge.close()
+
+    assert len(canonical) == 5 and all(p["alternative_fits"] for p in canonical)
+    assert all(lesson["alternative_fits_all_demos"] for lesson in lessons)
+    assert not lessons[0]["alternative_changes_query"]
+    assert lessons[1]["alternative_changes_query"]
+    assert all(not lesson["declared_lesson_identifiable_findings"] for lesson in lessons)
+    assert all(not lesson["test"][0]["self_check"] for lesson in lessons)
+    assert len(cache) == 10 and executions == 20
+    result = {
+        "schema": "6737eb62cf42-frequency-extremes-peer-probe-v1", "task_id": TASK,
+        "generator_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "rule_task_id": rule_task_id, "rule_hash": rule_hash,
+        "canonical_program": program, "canonical_program_sha256": sha(program),
+        "candidate_program_path": str(candidate_file.relative_to(ROOT)),
+        "candidate_program_sha256": sha(candidate), "runtime_identity": runtime_identity,
+        "canonical_pairs": canonical, "lessons": lessons,
+        "racket_evaluations": executions, "unique_inputs": len(cache),
+        "command": "WORK/.venv/bin/python review.py run python3 generators/6737eb62cf42/workspace/frequency_extremes_probe.py",
+        "payload_cwd": str(ROOT), "exit_code": 0,
+        "limits": [
+            "Two four-pair lessons sharing three demos; five canonical pairs; no seed search or full battery.",
+            "The divergent query uses public exact overrides; this is not evidence of an ordinary default-lesson failure.",
+            "All default scenes anchor the box with maximum- and minimum-frequency colors; the rival may agree throughout that support.",
+            "Finite evidence does not establish unique induction or change source approval or training admission.",
+        ],
+    }
+    output = ROOT.parent / "checks" / TASK / "frequency-extremes-probe.json"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"report": str(output), "generator_sha256": result["generator_sha256"],
+        "canonical_pairs": len(canonical), "racket_evaluations": executions,
+        "lessons": [{key: lesson[key] for key in ("name", "alternative_fits_all_demos",
+                    "alternative_changes_query", "declared_lesson_identifiable_findings")}
+                    for lesson in lessons]}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
