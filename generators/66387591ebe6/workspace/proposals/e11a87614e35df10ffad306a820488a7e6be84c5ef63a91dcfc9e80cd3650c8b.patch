+#!/usr/bin/env python3
+"""Bounded, source-bound lesson pair for an unobserved template-extent effect.
+
+Run from the packet root:
+  WORK/.venv/bin/python review.py run python3 \
+    generators/e9be57a9c56d/workspace/extent_learnability_probe.py \
+    --out ../checks/e9be57a9c56d/extent-learnability-final
+
+This is a research witness, not a production repair or an admission request.
+The thin-template query passes the task grammar but is outside this generator's
+shape support. No claim is made that ordinary generated queries are ambiguous.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shlex
+import sys
+
+from arcpuzzles import Catalog
+from arcpuzzles.alternative_solutions import CANDIDATE, certify, examples, raw
+from arcpuzzles.parametric_worker import _grid, _real_evaluator
+from reviewer_support import (
+    load_selected_generator,
+    public_challenge_bytes,
+    public_challenge_id,
+)
+
+
+TASK = "e9be57a9c56d"
+ROOT = Path(__file__).resolve().parents[3]
+EXPECTED_GENERATOR = "b966566b12ca836cb93220215f1487130b6cecea073928ef94df5c5dd12d7273"
+COMMAND = (
+    "WORK/.venv/bin/python review.py run python3 "
+    "generators/e9be57a9c56d/workspace/extent_learnability_probe.py"
+)
+
+
+def sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def thin_template(*, vertical: bool = False) -> list[list[int]]:
+    """A 3-cell L template, extent 2, with a unique same-color anchor."""
+    grid = [[0] * 18 for _ in range(9)]
+    colors = (3, 8, 2) if vertical else (2, 6, 4)
+    for column, color in zip((2, 5, 9), colors):
+        grid[1][column] = color
+    for dr, dc in ((0, 0), (1, 0), (1, 1)):
+        grid[5 + dr][7 + dc] = colors[1]
+    return [list(row) for row in zip(*grid)] if vertical else grid
+
+
+def fixed_extent_rule(program: str) -> str:
+    """Use marker distance + 2 for every chain step, regardless of extent."""
+    for axis in ("h", "w"):
+        old = f"(define t-{axis} (obj-{axis} template))"
+        if program.count(old) != 1:
+            raise ValueError("Canonical template-extent definition drifted")
+        program = program.replace(old, f"(define t-{axis} 3)", 1)
+    return program
+
+
+def differences(left, right):
+    return [[r, c, a, b] for r, (ar, br) in enumerate(zip(left, right))
+            for c, (a, b) in enumerate(zip(ar, br)) if a != b]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", default=f"../checks/{TASK}/extent-learnability-final")
+    args = parser.parse_args()
+    output = Path(args.out).resolve()
+    check_root = ROOT.parent / "checks" / TASK
+    if not output.is_relative_to(check_root) or output == check_root:
+        raise ValueError("Evidence output must stay below this task's checks directory")
+    if output.exists():
+        raise FileExistsError(f"Evidence output already exists: {output}")
+
+    catalog = Catalog(ROOT)
+    selected = catalog.describe(TASK)
+    rule_task = selected.get("rule_task_id", selected["id"])
+    programs = {row["program_solution"] for row in catalog._variants()[rule_task]}
+    if len(programs) != 1:
+        raise ValueError("Selected canonical authority is not unique")
+    canonical = programs.pop()
+    normalized_rule_hash = sha(" ".join(canonical.split()).encode())[:12]
+    if normalized_rule_hash != "f8100feef807":
+        raise ValueError("Selected canonical rule drifted")
+    generator, source_path, generator_hash = load_selected_generator(TASK, root=ROOT)
+    if generator_hash != EXPECTED_GENERATOR:
+        raise ValueError("Generator changed; review the probe assumptions first")
+    rival = fixed_extent_rule(canonical)
+
+    # Finite: four scheduled production inputs, two exact handmade inputs,
+    # two programs. Native certification replays the 3-demo candidate once.
+    inputs = [generator.generate(1701, index, difficulty="medium") for index in range(4)]
+    inputs += [thin_template(), thin_template(vertical=True)]
+    for grid in inputs:
+        if generator.self_check(grid) or generator.strict_canonical_like(grid):
+            raise ValueError("Probe input fails the selected task grammar")
+    extents = [max(c for _, c in shape) + 1
+               for shapes in generator._SHAPES.values() for shape in shapes]
+    if set(extents) != {3}:
+        raise ValueError("Generator now includes other chain extents; reassess support")
+    scenes = [generator._analyze(grid) for grid in inputs]
+
+    apply, runtime, bridge = _real_evaluator(ROOT / "shared/runtime")
+    try:
+        gold = [_grid(apply(canonical, grid)) for grid in inputs]
+        wrong = [_grid(apply(rival, grid)) for grid in inputs]
+    finally:
+        bridge.close()
+    if gold[:4] != wrong[:4] or any(gold[i] == wrong[i] for i in (4, 5)):
+        raise ValueError("Expected demonstration fit / thin-template divergence changed")
+
+    demos = [{"input": grid, "output": output} for grid, output in zip(inputs[:3], gold[:3])]
+    query = {"input": inputs[4]}
+    ambiguous = {"train": demos, "test": [query]}
+    repaired = {"train": demos + [{"input": inputs[5], "output": gold[5]}], "test": [query]}
+    evidence_paths = [source_path, Path(__file__).resolve(), ROOT / "shared/data/canonical/puzzles.jsonl"]
+    candidate = {
+        "schema": CANDIDATE,
+        "generator_id": TASK,
+        "train": demos,
+        "query": query,
+        "hypotheses": [
+            {"name": "canonical_template_extent", "program": canonical,
+             "description": "Copy the template for every marker, using marker distance plus template extent minus one for each chain step away from the same-color anchor."},
+            {"name": "constant_two_cell_spacing", "program": rival,
+             "description": "Copy the template for every marker, using marker distance plus two for each chain step away from the same-color anchor, regardless of template extent."},
+        ],
+        "source_evidence": [{"path": str(p.relative_to(ROOT)), "sha256": sha(p.read_bytes())}
+                            for p in evidence_paths],
+        "lineage": {"rule_task_id": rule_task, "canonical_rule_hash": normalized_rule_hash,
+                    "generator_sha256": generator_hash, "purpose": "deliberate ambiguity research",
+                    "query_scope": "lawful task grammar; outside current generator shape support",
+                    "training_admitted": False},
+    }
+    certificate = certify(ROOT, candidate)
+    alternative_rows = examples(candidate, certificate)
+    if len(alternative_rows) != 2:
+        raise ValueError("Expected exactly two directed alternative-answer tasks")
+    for index, result in enumerate(certificate["hypotheses"]):
+        if result["query_output"] != (gold[4] if index == 0 else wrong[4]):
+            raise ValueError("Native replay disagrees with direct protected execution")
+
+    output.mkdir(parents=True)
+    (output / "public").mkdir()
+    lesson_roles = {
+        "ambiguous": f"public/{public_challenge_id(ambiguous)}.json",
+        "distinguished": f"public/{public_challenge_id(repaired)}.json",
+    }
+    payloads = {
+        lesson_roles["ambiguous"]: public_challenge_bytes(ambiguous),
+        lesson_roles["distinguished"]: public_challenge_bytes(repaired),
+        "candidate-private.json": raw(candidate),
+        "native-certificate-private.json": raw(certificate),
+        "canonical.rkt": canonical.encode(),
+        "constant-two-cell-spacing.rkt": rival.encode(),
+        "predictions-private.json": raw({
+            "query": {"input": inputs[4], "canonical": gold[4], "rival": wrong[4],
+                      "differing_cells": differences(gold[4], wrong[4])},
+            "distinguishing_demo": {"input": inputs[5], "canonical": gold[5], "rival": wrong[5],
+                                    "differing_cells": differences(gold[5], wrong[5])},
+            "production_control": {"input": inputs[3], "canonical": gold[3], "rival": wrong[3]},
+        }),
+    }
+    for name, payload in payloads.items():
+        (output / name).write_bytes(payload)
+    native_candidate = (
+        ROOT / "generators" / TASK / "workspace/parametric/evidence/alternative-solutions/extent-original.json"
+    )
+    native_candidate.parent.mkdir(parents=True, exist_ok=True)
+    native_candidate.write_bytes(raw(candidate))
+    report = {
+        "schema": "arcpuzzles-task-local-extent-learnability-v1", "status": "verified",
+        "task_id": TASK, "command": COMMAND + " " + shlex.join(sys.argv[1:]),
+        "command_cwd": "packet root", "exit_code": 0,
+        "rule_task_id": rule_task, "canonical_rule_hash": normalized_rule_hash,
+        "canonical_program_sha256": sha(canonical.encode()), "rival_program_sha256": sha(rival.encode()),
+        "source_evidence": candidate["source_evidence"], "runtime": runtime,
+        "limits": {"production_inputs": 4, "handmade_inputs": 2, "rules": 2,
+                   "direct_racket_evaluations": 12, "native_replay_evaluations": certificate["evaluations"],
+                   "native_timeout_seconds": 60, "full_battery_run": False},
+        "production_support": {"base_shape_count": len(extents), "chain_extents": sorted(set(extents)),
+                               "sampled_seed": 1701, "sampled_indices": [0, 1, 2, 3], "difficulty": "medium"},
+        "observations": [{"index": i, "origin": "generated" if i < 4 else "handmade",
+                          "orientation": s["orientation"], "template_size": s["template_size"],
+                          "chain_extent": s["template_w"] if s["orientation"] == "horizontal" else s["template_h"],
+                          "self_check": [], "strict_canonical_like": [], "rival_agrees": gold[i] == wrong[i]}
+                         for i, s in enumerate(scenes)],
+        "lesson_role_map": lesson_roles,
+        "lessons": {"ambiguous": {"demos": 3, "both_rules_fit": True,
+                                  "query_difference_cells": len(differences(gold[4], wrong[4]))},
+                    "distinguished": {"demos": 4, "same_query": True,
+                                      "added_demo_difference_cells": len(differences(gold[5], wrong[5]))}},
+        "native_alternative": {"certificate_status": certificate["status"],
+                               "candidate_sha256": certificate["candidate_sha256"],
+                               "candidate_path": str(native_candidate.relative_to(ROOT)),
+                               "directed_examples_validated": len(alternative_rows),
+                               "stream_published": False, "training_admitted": False},
+        "finding_scope": "Template extent is unobservable over current generated shape support. The query lies inside validated grammar but outside generated support; this does not demonstrate ambiguity of ordinary generated queries.",
+        "files": [{"path": name, "bytes": len(data), "sha256": sha(data)} for name, data in payloads.items()],
+    }
+    (output / "result.json").write_bytes(raw(report))
+    print(json.dumps({"status": report["status"], "output": str(output),
+                      "source_sha256": generator_hash, "racket_evaluations": 12 + certificate["evaluations"],
+                      "probe_sha256": sha(Path(__file__).read_bytes()),
+                      "native_candidate_path": str(native_candidate.relative_to(ROOT)),
+                      "query_difference_cells": report["lessons"]["ambiguous"]["query_difference_cells"],
+                      "native_alternative_candidate": "verified", "ordinary_generated_query_failure": False}))
+
+
+if __name__ == "__main__":
+    main()
