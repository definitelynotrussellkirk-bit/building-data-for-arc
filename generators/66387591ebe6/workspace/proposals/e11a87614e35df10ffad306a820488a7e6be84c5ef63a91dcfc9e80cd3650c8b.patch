+   (let ((cells (colored-cells grid)))
+    (if (empty? cells)
+        (list (list 0))
+        (let* ((counts (map (lambda (p) (color-count grid cells (at grid (first p) (second p)))) cells))
+               (low (apply min counts))
+               (high (apply max counts))
+               (keep (filter
