+"""One source-bound learnability probe: three generated demos, one authored query.
+
+From the outer packet folder:
+WORK/.venv/bin/python review.py run ../.venv/bin/python \
+  generators/36018a11f283/workspace/learnability_probe.py \
+  --out ../checks/36018a11f283/learnability-witness.json
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+from arcpuzzles.parametric_worker import _grid, _local_imports, _real_evaluator
+from reviewer_support import canonical_path, find_root, load_selected_generator
+
+
+TASK = "36018a11f283"
+EXPECTED_SOURCE = "420f5018466d88716f29ba8c7280e03d59dcd8f7b8645bc486261248f5081fea"
+MAJORITY_COMPARATOR = "(lambda (a b) (if (= (second a) (second b)) (< (first a) (first b)) (> (second a) (second b))))"
+MIN_PRESENT_COMPARATOR = "(lambda (a b) (if (= (second a) 0) #f (if (= (second b) 0) #t (< (first a) (first b)))))"
+
+
+def sha(value):
+    text = value if isinstance(value, str) else json.dumps(value, separators=(",", ":"))
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    root = find_root(__file__)
+    module, source, source_hash = load_selected_generator(TASK, root=root)
+    if source_hash != EXPECTED_SOURCE:
+        raise ValueError("Audited generator changed; review the new source before replay")
+    programs = {row["program_solution"]
+                for line in canonical_path(root).read_text().splitlines()
+                if (row := json.loads(line)).get("task_id") == TASK}
+    assert len(programs) == 1
+    canonical = programs.pop()
+    assert canonical.count(MAJORITY_COMPARATOR) == 1
+    rival = canonical.replace(MAJORITY_COMPARATOR, MIN_PRESENT_COMPARATOR)
+
+    # Exactly three generator calls. The fourth grid is explicitly authored.
+    inputs = [module.generate(0, index) for index in range(3)]
+    query = deepcopy(inputs[0])
+    compartment = next(sorted(cells) for cells in module._regions_not_wall(query)
+                       if any(query[r][c] in (2, 3, 4) for r, c in cells))
+    assert len(compartment) >= 4
+    for r, c in compartment:
+        query[r][c] = 0
+    for color, (r, c) in zip((2, 4, 4), compartment):
+        query[r][c] = color
+    inputs.append(query)
+    assert all(module.self_check(grid) == [] for grid in inputs)
+    assert len({sha(grid) for grid in inputs}) == 4
+    with _local_imports(root / "shared/runtime", Path(__file__).resolve().parent):
+        apply, runtime, bridge = _real_evaluator(root / "shared/runtime")
+        try:
+            labels = [_grid(apply(canonical, deepcopy(grid))) for grid in inputs]
+            predictions = [_grid(apply(rival, deepcopy(grid))) for grid in inputs]
+        finally:
+            bridge.close()
+    matches = [actual == predicted for actual, predicted in zip(labels, predictions)]
+    assert matches == [True, True, True, False]
+    differences = [{"row": r, "column": c, "canonical": value,
+                    "rival": predictions[-1][r][c]}
+                   for r, row in enumerate(labels[-1]) for c, value in enumerate(row)
+                   if value != predictions[-1][r][c]]
+    assert len(differences) == len(compartment)
+    assert all(cell["canonical"] == 4 and cell["rival"] == 2 for cell in differences)
+    assert hashlib.sha256(source.read_bytes()).hexdigest() == source_hash
+    result = {
+        "schema": "arcpuzzles-bounded-peer-learnability-v1", "task_id": TASK,
+        "status": "source_bound_finding_reproduced; proposed review only",
+        "generator_path": source.relative_to(root).as_posix(),
+        "generator_sha256": source_hash,
+        "probe_path": Path(__file__).resolve().relative_to(root).as_posix(),
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "canonical_program": canonical, "canonical_program_sha256": sha(canonical),
+        "canonical_rule_hash": sha(" ".join(canonical.split()))[:12],
+        "rival_program": rival, "rival_program_sha256": sha(rival),
+        "rival_description": "Fill each marked non-wall region with its smallest present marker color, ignoring marker counts.",
+        "rival_construction": "Reuse canonical compartment traversal; replace only the majority-vote comparator with smallest-present-color ordering.",
+        "command": "WORK/.venv/bin/python review.py run ../.venv/bin/python generators/36018a11f283/workspace/learnability_probe.py --out ../checks/36018a11f283/learnability-witness.json",
+        "generated_calls": [{"seed": 0, "sample_index": i, "overrides": {}} for i in range(3)],
+        "train": [{"input": grid, "output": label, "rival_output": prediction}
+                  for grid, label, prediction in zip(inputs[:3], labels[:3], predictions[:3])],
+        "authored_query": {"input": query, "output": labels[-1], "rival_output": predictions[-1],
+                           "self_check_errors": [], "base_generated_sample_index": 0,
+                           "construction": "Keep walls, moat and all other compartments from demo 0. Clear the first marked region and place one color-2 marker followed by two color-4 markers in row-major order.",
+                           "modified_compartment": compartment,
+                           "marker_counts": {"2": 1, "3": 0, "4": 2},
+                           "query_differences_zero_based": differences},
+        "all_four_inputs_pass_self_check": True,
+        "rival_matches_demos": matches[:3], "rival_differs_on_query": True,
+        "racket": runtime, "racket_evaluations": 8,
+        "scope": "One rival, three generated seed-0 demonstrations, and one authored validator-lawful mixed-marker query. No generated-default-query failure or population frequency is claimed.",
+        "proposed_mitigation": "Teach strict-majority comparisons using mixed marker colors within a compartment, including a smaller-valued minority; retain matched minority/majority contrasts in lessons.",
+        "generator_changed": False, "rule_changed": False, "approval_changed": False,
+        "prior_audit_disposition_changed": False,
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, separators=(",", ":")) + "\n")
+    print(json.dumps({"task_id": TASK, "status": result["status"], "demo_matches": matches[:3],
+                      "query_differences": len(differences), "racket_evaluations": 8,
+                      "receipt": str(args.out)}))
+
+
+if __name__ == "__main__":
+    main()
