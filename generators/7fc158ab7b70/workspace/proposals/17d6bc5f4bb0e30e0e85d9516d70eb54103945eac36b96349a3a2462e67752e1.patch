+"""Native promotion contract for the aggregate-count replication family."""
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import json
+import sys
+from pathlib import Path
+
+import pytest
+from reviewer_support import find_root
+
+
+TASK_ID = "7fc158ab7b70"
+ROOT = find_root(__file__)
+HOME = ROOT / "generators" / TASK_ID / "workspace" / "parametric"
+ADAPTER_PATH = HOME / "adapter.py"
+PROMOTION_PATH = HOME / "promotion.json"
+
+
+def _load(path: Path, stem: str):
+    assert path.is_file(), f"missing native artifact: {path.relative_to(ROOT)}"
+    name = f"_{stem}_{TASK_ID}_{path.stat().st_mtime_ns}"
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _canonical_program() -> str:
+    for line in (ROOT / "shared/data/canonical/puzzles.jsonl").read_text().splitlines():
+        row = json.loads(line)
+        if row.get("task_id") == TASK_ID:
+            return row["program_solution"]
+    raise AssertionError("canonical task row missing")
+
+
+def _settings(contract: dict) -> list[dict]:
+    names = sorted(contract["parameters"])
+    return [
+        dict(zip(names, values))
+        for values in itertools.product(*(contract["parameters"][name] for name in names))
+    ]
+
+
+def _shape(grid: list[list[int]]) -> tuple[int, int]:
+    return len(grid), len(grid[0])
+
+
+def test_native_contract_exposes_exact_six_setting_family_and_canonical_default():
+    assert PROMOTION_PATH.is_file(), "native promotion contract is missing"
+    contract = json.loads(PROMOTION_PATH.read_text())
+    assert contract == {
+        "schema": "arcpuzzles-parametric-adapter-v1",
+        "adapter": f"generators/{TASK_ID}/workspace/parametric/adapter.py",
+        "parameters": {
+            "count_basis": ["cells", "colors"],
+            "scale_axes": ["both", "rows", "columns"],
+        },
+        "default": {"count_basis": "cells", "scale_axes": "both"},
+        "limits": {"demos": [2, 6], "queries": [1, 4]},
+    }
+
+    adapter = _load(ADAPTER_PATH, "native_adapter")
+    settings = _settings(contract)
+    programs = [adapter.program(setting) for setting in settings]
+    assert len(settings) == len(set(programs)) == 6
+    assert adapter.program(contract["default"]) == _canonical_program()
+    assert all(program.startswith("(rule! ") for program in programs)
+
+
+def test_native_generate_honors_minimum_counts_and_reaches_real_30x30_stress():
+    adapter = _load(ADAPTER_PATH, "native_adapter_min")
+    settings = {"count_basis": "cells", "scale_axes": "both"}
+    episode = adapter.generate(17, settings, 2, 4)
+
+    assert set(episode) == {"train", "test", "program_solution"}
+    assert len(episode["train"]) == 2
+    assert len(episode["test"]) == 4
+    pairs = episode["train"] + episode["test"]
+    inputs = [json.dumps(pair["input"], separators=(",", ":")) for pair in pairs]
+    assert len(inputs) == len(set(inputs)) == 6
+    assert [_shape(pair["output"]) for pair in pairs] == [
+        (6, 6),
+        (16, 16),
+        (9, 9),
+        (30, 30),
+        (20, 20),
+        (6, 6),
+    ]
+    assert episode["program_solution"] == adapter.program(settings)
+
+
+def test_native_generate_supports_six_demos_and_rejects_out_of_contract_counts():
+    adapter = _load(ADAPTER_PATH, "native_adapter_bounds")
+    settings = {"count_basis": "colors", "scale_axes": "columns"}
+    episode = adapter.generate(41, settings, 6, 4)
+    pairs = episode["train"] + episode["test"]
+    assert len(episode["train"]) == 6
+    assert len(episode["test"]) == 4
+    assert len({json.dumps(pair["input"], separators=(",", ":")) for pair in pairs}) == 10
+    assert all(1 <= len(pair["output"]) <= 30 for pair in pairs)
+    assert all(1 <= len(pair["output"][0]) <= 30 for pair in pairs)
+
+    for demos, queries in ((1, 4), (7, 4), (2, 0), (2, 5), (True, 4), (2, False)):
+        with pytest.raises((TypeError, ValueError)):
+            adapter.generate(17, settings, demos, queries)
+
+
+def test_native_settings_are_exact_typed_values_not_silent_defaults():
+    adapter = _load(ADAPTER_PATH, "native_adapter_settings")
+    invalid = (
+        {},
+        {"count_basis": "cells"},
+        {"count_basis": "cells", "scale_axes": "both", "extra": 1},
+        {"count_basis": "", "scale_axes": "both"},
+        {"count_basis": False, "scale_axes": "both"},
+        {"count_basis": "cells", "scale_axes": "diagonal"},
+    )
+    for settings in invalid:
+        with pytest.raises((TypeError, ValueError)):
+            adapter.program(settings)
+        with pytest.raises((TypeError, ValueError)):
+            adapter.generate(17, settings, 2, 4)
