(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((n (rows g))
                  (nz (for/sum ((r (range 0 n)))
                        (for/sum ((c (range 0 n))) (if (!= (at g r c) 0) 1 0)))))
             (build-grid (* n nz)
                         (* n nz)
                         (r c)
                         (let* ((br (/ r nz))
                                (bc (/ c nz))
                                (v (at g br bc)))
                           (if (!= v 0) v 0)))))))