(rule! (lambda (g)
         (let* ((h (rows g))
                (w (cols g)))
           (let* ((inverted (cellmap g (r c v) (if (zero? v) 1 0)))
                  (comps (objects inverted 0))
                  (min-size (min-of obj-size comps)))
             (for/fold ((gg g))
               ((comp comps))
               (let ((color (if (= (obj-size comp) min-size) 3 4)))
                 (for/fold ((ggg gg))
                   ((cell (obj-cells comp)))
                   (set-cell ggg (first cell) (second cell) color))))))))